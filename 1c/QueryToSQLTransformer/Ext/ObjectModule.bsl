#If Server Or ThickClientOrdinaryApplication Or ExternalConnection Then

Var StorageCache;
Var RussianMessages;

#Region Public

// Registration for the BSP additional reports and data processors subsystem.
Function ExternalDataProcessorInfo() Export

	Registration = New Structure;
	Registration.Insert("Name", ?(SessionLanguage() = "ru", "Транслятор запросов 1С в SQL",
		"Query to SQL transformer"));
	Registration.Insert("Version", "0.3.0");
	Registration.Insert("SafeMode", False);
	Registration.Insert("Information", ?(SessionLanguage() = "ru",
		"Переводит запрос 1С в T-SQL или PostgreSQL для прямого доступа к базе. Скачать бесплатно можно на GitHub "
			+ "(github.com/AleChief/QueryToSQLTransformer), статья и файл есть и на Инфостарте; новые версии выходят только на GitHub.",
		"Translates a 1C query into T-SQL or PostgreSQL for direct access to the database. "
			+ "Free download on GitHub (github.com/AleChief/QueryToSQLTransformer), the article and the file are also on Infostart; new versions only on GitHub."));
	Return Registration;

EndFunction

// Default transformation options. Callers change what they need and pass the structure to Transform.
//
// Returns:
//   Structure:
//    * Dialect - String - "MSSQL" or "PostgreSQL".
//    * DateOffset - Number - year offset used by the platform when storing dates.
//    * SchemaName - String - database schema for MS SQL, ignored for PostgreSQL.
//    * ParameterValues - Map - query parameter name -> value, used when SubstituteParameters is set.
//    * SubstituteParameters - Boolean - inline parameter values as literals instead of emitting placeholders.
//    * Prologue - String - queries that create the temporary tables the text relies on but does not
//                          create itself. They are prepended to the batch, and a table passed as a
//                          parameter (ИЗ &Имя) is taken from a temporary table with the same name.
//    * Language - String - "en" or "ru": the language of ErrorDescription and Warnings. The form passes the
//                          language of the session (SessionLanguage).
//
Function DefaultOptions() Export

	Options = New Structure;
	Options.Insert("Dialect", "MSSQL");
	Options.Insert("DateOffset", 2000);
	Options.Insert("SchemaName", "dbo");
	Options.Insert("ParameterValues", New Map);
	Options.Insert("SubstituteParameters", False);
	Options.Insert("Prologue", "");
	Options.Insert("Language", "en");
	Return Options;

EndFunction

// Main entry point. Same code path for the form, a COM session and a scheduled run.
//
// Parameters:
//   QueryText - String - query in the 1C query language, any language variant, any case.
//   Options - Structure - see DefaultOptions. Undefined means defaults.
//
// Returns:
//   Structure:
//    * Success - Boolean
//    * SQL - String
//    * ErrorDescription - String - parse or translation error, empty when Success
//    * Warnings - Array of String - things the caller has to check by hand
//
Function Transform(QueryText, Options = Undefined) Export

	Result = TransformInEnglish(QueryText, Options);
	Language = "en";
	If Options <> Undefined And Options.Property("Language") Then
		Language = Options.Language;
	EndIf;
	If Language = "ru" Then
		Result.ErrorDescription = LocalizedText(Result.ErrorDescription, Language);
		Warnings = New Array;
		For Each Warning In Result.Warnings Do
			Warnings.Add(LocalizedText(Warning, Language));
		EndDo;
		Result.Warnings = Warnings;
	EndIf;
	Return Result;

EndFunction

// "ru" when the session speaks Russian, otherwise "en" - the two languages of the messages.
Function SessionLanguage() Export

	Code = "";
	Try
		Code = CurrentLanguage().LanguageCode;
	Except
		Code = "";
	EndTry;
	Return ?(Lower(Left(Code, 2)) = "ru", "ru", "en");

EndFunction

// Messages are composed in English everywhere - the code checks some of them by their text - and are
// translated once, on the way out: every template of the table is found in the text by its fixed
// parts, the variable parts between them are carried into the Russian text in place of {1}, {2}...
Function LocalizedText(Val Text, Language)

	If Language <> "ru" Or IsBlankString(Text) Then
		Return Text;
	EndIf;
	For Each Entry In RussianMessageTable() Do
		Parts = Entry.Parts;
		Start = 1;
		While Start <= StrLen(Text) Do
			Position = StrFind(Text, Parts[0], SearchDirection.FromBegin, Start);
			If Position = 0 Then
				Break;
			EndIf;
			Cursor = Position + StrLen(Parts[0]);
			Captured = New Array;
			Matched = True;
			For Index = 1 To Parts.UBound() Do
				Found = ?(Cursor > StrLen(Text), 0, StrFind(Text, Parts[Index], SearchDirection.FromBegin, Cursor));
				If Found = 0 Then
					Matched = False;
					Break;
				EndIf;
				Captured.Add(Mid(Text, Cursor, Found - Cursor));
				Cursor = Found + StrLen(Parts[Index]);
			EndDo;
			If Not Matched Then
				Break;
			EndIf;
			Russian = Entry.Russian;
			For Index = 0 To Captured.UBound() Do
				Russian = StrReplace(Russian, "{" + Format(Index + 1, "NG=0") + "}", Captured[Index]);
			EndDo;
			Text = Left(Text, Position - 1) + Russian + Mid(Text, Cursor);
			Start = Position + StrLen(Russian);
		EndDo;
	EndDo;
	Return Text;

EndFunction

Procedure AddRussianMessage(Table, Russian, Part1, Part2 = Undefined, Part3 = Undefined, Part4 = Undefined,
	Part5 = Undefined, Part6 = Undefined, Part7 = Undefined)

	Parts = New Array;
	Parts.Add(Part1);
	If Part2 <> Undefined Then Parts.Add(Part2); EndIf;
	If Part3 <> Undefined Then Parts.Add(Part3); EndIf;
	If Part4 <> Undefined Then Parts.Add(Part4); EndIf;
	If Part5 <> Undefined Then Parts.Add(Part5); EndIf;
	If Part6 <> Undefined Then Parts.Add(Part6); EndIf;
	If Part7 <> Undefined Then Parts.Add(Part7); EndIf;
	Table.Add(New Structure("Parts, Russian", Parts, Russian));

EndProcedure

