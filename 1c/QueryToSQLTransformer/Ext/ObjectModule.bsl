// Часть даты от литерала, который DateLiteralFromArguments поднял до 1753 года. Сравнения
// литерал ведёт как платформа, а часть даты от константы платформа считает сама, по дате как
// написано (polish27b datediff, ERP WE, смещение 0: «ГОД(ДАТАВРЕМЯ(1, 1, 1))» - 1С 1, SQL 1753;
// от поля с пустой датой 1С и СУБД обе видят 1753: 113 = 113). Undefined - не такой литерал.
Function ConstantDatePart(Text, UpperName, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return Undefined;
	EndIf;
	Tokens = Tokenize(TrimAll(Text));
	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name"
		Or (Upper(Tokens[0].Value) <> "DATETIME" And Upper(Tokens[0].Value) <> Upper("ДатаВремя"))
		Or Tokens[1].Value <> "(" Or Tokens[Tokens.Count() - 1].Value <> ")" Then
		Return Undefined;
	EndIf;
	Numbers = New Array;
	For Position = 2 To Tokens.Count() - 2 Do
		If Tokens[Position].Kind = "Number" Then
			Numbers.Add(Number(Tokens[Position].Value));
		ElsIf Tokens[Position].Value <> "," Then
			Return Undefined;
		EndIf;
	EndDo;
	If (Numbers.Count() <> 3 And Numbers.Count() <> 6)
		Or Numbers[0] + Context.Options.DateOffset >= 1753 Then
		Return Undefined;
	EndIf;
	While Numbers.Count() < 6 Do
		Numbers.Add(0);
	EndDo;
	Try
		Moment = Date(Numbers[0], Numbers[1], Numbers[2], Numbers[3], Numbers[4], Numbers[5]);
	Except
		Return Undefined;
	EndTry;

	Name = Upper(UpperName);
	If Name = "YEAR" Or Name = Upper("Год") Then
		Result = Year(Moment);
	ElsIf Name = "QUARTER" Or Name = Upper("Квартал") Then
		Result = Int((Month(Moment) - 1) / 3) + 1;
	ElsIf Name = "MONTH" Or Name = Upper("Месяц") Then
		Result = Month(Moment);
	ElsIf Name = "DAY" Or Name = Upper("День") Then
		Result = Day(Moment);
	ElsIf Name = "DAYOFYEAR" Or Name = Upper("ДеньГода") Then
		Result = DayOfYear(Moment);
	ElsIf Name = "WEEKDAY" Or Name = Upper("ДеньНедели") Then
		Result = WeekDay(Moment);
	ElsIf Name = "HOUR" Or Name = Upper("Час") Then
		Result = Hour(Moment);
	ElsIf Name = "MINUTE" Or Name = Upper("Минута") Then
		Result = Minute(Moment);
	ElsIf Name = "SECOND" Or Name = Upper("Секунда") Then
		Result = Second(Moment);
	Else
		Return Undefined;
	EndIf;
	Return Format(Result, "NG=0; NZ=0");

EndFunction

Function DatePartFunction(UpperName, Arguments, Context)

	Units = New Map;
	Units.Insert("QUARTER", "quarter");
	Units.Insert(Upper("КВАРТАЛ"), "quarter");
	Units.Insert("MONTH", "month");
	Units.Insert(Upper("МЕСЯЦ"), "month");
	Units.Insert("DAY", "day");
	Units.Insert(Upper("ДЕНЬ"), "day");
	Units.Insert("DAYOFYEAR", "dayofyear");
	Units.Insert(Upper("ДЕНЬГОДА"), "dayofyear");
	Units.Insert("HOUR", "hour");
	Units.Insert(Upper("ЧАС"), "hour");
	Units.Insert("MINUTE", "minute");
	Units.Insert(Upper("МИНУТА"), "minute");
	Units.Insert("SECOND", "second");
	Units.Insert(Upper("СЕКУНДА"), "second");

	Folded = ConstantDatePart(RawArgument(Arguments, 0), UpperName, Context);
	If Folded <> Undefined Then
		Return Folded;
	EndIf;
	Value = Translated(Arguments, 0, Context);
	PostgreSQL = Context.Options.Dialect = "PostgreSQL";

	If UpperName = "WEEKDAY" Or UpperName = Upper("ДеньНедели") Then
		// 1С нумерует дни с понедельника: 1 - понедельник, 7 - воскресенье.
		// В PostgreSQL это ISODOW. В MS SQL DATEPART(weekday) зависит от настройки
		// DATEFIRST, поэтому её приходится вычитать, чтобы результат не плавал.
		If PostgreSQL Then
			Return "EXTRACT(ISODOW FROM " + Value + ")";
		EndIf;
		Return "CAST(((DATEPART(weekday, " + Value + ") + @@DATEFIRST - 2) % 7 + 1) AS NUMERIC(4))";
	EndIf;

	If UpperName = "WEEK" Or UpperName = Upper("Неделя") Then
		// Замер 18.11.2026 (УХ, fn2_uh w1): CAST((DATEPART(DAYOFYEAR, d) - 1 + (6 + DATEPART(WEEKDAY,
		// CONVERT(DATETIME, CONVERT(VARCHAR(4), d, 120) + '-01-01'))) % 7) / 7 + 1 AS NUMERIC(4, 0)) -
		// неделя с понедельника, первая - та, где 1 января. День недели 1 января платформа берёт при
		// своём DATEFIRST 1; здесь он вычитается, как у ДЕНЬНЕДЕЛИ.
		If PostgreSQL Then
			Return "CAST(FLOOR((EXTRACT(DOY FROM " + Value + ") - 1 + (6 + EXTRACT(ISODOW FROM DATE_TRUNC('year', "
				+ Value + "))) % 7) / 7) + 1 AS NUMERIC(4, 0))";
		EndIf;
		NewYear = "CONVERT(DATETIME, CONVERT(VARCHAR(4), " + Value + ", 120) + '-01-01')";
		Return "CAST((DATEPART(dayofyear, " + Value + ") - 1 + (6 + ((DATEPART(weekday, " + NewYear
			+ ") + @@DATEFIRST - 2) % 7 + 1)) % 7) / 7 + 1 AS NUMERIC(4, 0))";
	EndIf;

	Unit = Units.Get(UpperName);
	If Unit = Undefined Then
		Raise StrTemplate("Date part %1 is not supported yet.", UpperName);
	EndIf;
	If PostgreSQL Then
		// DATEPART - функция MS SQL, в PostgreSQL её нет.
		Return "EXTRACT(" + ?(Unit = "dayofyear", "DOY", Upper(Unit)) + " FROM " + Value + ")";
	EndIf;
	// Часть даты платформа пишет как CAST(DATEPART(...) AS NUMERIC(4)) - и колонкой, и в
	// арифметике (замеры 841100-841112, сверка типов 16.11.2026); голый DATEPART - int.
	Return "CAST(DATEPART(" + Unit + ", " + Value + ") AS NUMERIC(4))";

EndFunction

// Начало и конец периода считаются через DATEDIFF/DATEADD - это есть с SQL Server 2005.
Function PeriodBoundary(Kind, Arguments, Context)

	Periodicity = RawArgument(Arguments, 1);
	Value = Translated(Arguments, 0, Context);
	Start = PeriodTruncation(Periodicity, Value, Context);

	If Kind = "BEGINOFPERIOD" Then
		Return Start;
	EndIf;

	// Конец периода в 1С - последняя секунда периода.
	Step = PeriodStep(Periodicity, Start, Context);
	If IsBlankString(Step) Then
		// У декады шага нет: конец - последняя секунда перед началом следующей.
		Step = PeriodTruncation(Periodicity, ShiftedDate(Start, "11", "day", Context), Context);
	EndIf;
	Return ShiftedDate(Step, "-1", "second", Context);

EndFunction

// Периодичность виртуальной таблицы: платформа группирует по началу периода.
// Бакет считается через DATEADD/DATEDIFF - это есть с SQL Server 2005, в отличие
// от DATETIME2FROMPARTS, которым пользуется сама платформа.
Function IsRecorderPeriodicity(RawPeriodicity)

	Normalized = Upper(TrimAll(RawPeriodicity));
	Return Normalized = "RECORD" Or Normalized = "RECORDER"
		Or Normalized = Upper("Регистратор") Or Normalized = Upper("Запись");

EndFunction

Function RecorderColumn(Base)

	Column = Base.Fields.Get("RECORDER");
	If Column = Undefined Then
		Column = Base.Fields.Get(Upper("Регистратор"));
	EndIf;
	Return Column;

EndFunction

// Какие поля периода отдаёт виртуальная таблица. Замерено на платформе 16.09.2026
// запросом ВЫБРАТЬ * по каждой периодичности:
//   не указана   - полей периода нет вовсе;
//   Период       - одно поле Период, равное периоду записи;
//   <единица>    - одно поле Период, округлённое до начала единицы;
//   Регистратор  - Период и Регистратор;
//   Авто         - Регистратор и все СекундаПериод … ГодПериод, но поля Период нет.
// Авто и Регистратор - это одна и та же детализация, до записи регистра; отличаются
// только именами полей.
// Округление вниз до начала единицы. Для секунды, минуты и часа DATEDIFF от нулевой
// даты переполняет int: с хранимым смещением +2000 лет разница в секундах не влезает
// в четыре байта. Поэтому мелкие единицы срезаются через DATEPART, а не через DATEDIFF.
Function TruncateToUnit(Unit, Text, Context)

	If Unit = "second" Then
		// 1С хранит дату с точностью до секунды, срезать нечего.
		Return Text;
	EndIf;

	If Context.Options.Dialect = "PostgreSQL" Then
		// В PostgreSQL усечение периода - штатная функция, городить вычитание не нужно.
		Return "date_trunc('" + Unit + "', " + Text + ")";
	EndIf;

	If Unit = "minute" Then
		Return "DATEADD(second, -DATEPART(second, " + Text + "), " + Text + ")";
	ElsIf Unit = "hour" Then
		Return "DATEADD(minute, -DATEPART(minute, DATEADD(second, -DATEPART(second, " + Text + "), "
			+ Text + ")), DATEADD(second, -DATEPART(second, " + Text + "), " + Text + "))";
	EndIf;
	Return "DATEADD(" + Unit + ", DATEDIFF(" + Unit + ", 0, " + Text + "), 0)";

EndFunction

// Начало периода для всех периодичностей 1С. Неделя, декада и полугодие раньше
// отвергались как «зависящие от настроек сервера» - это оказалось неверно: платформа
// пользуется DATEPART(weekday), но результат от DATEFIRST не зависит, если поправку
// внести самим. Сверено с НАЧАЛОПЕРИОДА платформы на 30 датах, расхождений нет.
Function PeriodTruncation(RawPeriodicity, Text, Context)

	Normalized = Upper(TrimAll(RawPeriodicity));
	PostgreSQL = Context.Options.Dialect = "PostgreSQL";
	Day = ?(PostgreSQL, "date_trunc('day', " + Text + ")",
		"DATEADD(day, DATEDIFF(day, 0, " + Text + "), 0)");

	If Normalized = "WEEK" Or Normalized = Upper("Неделя") Then
		If PostgreSQL Then
			// Неделя в PostgreSQL и так начинается с понедельника, как в 1С.
			Return "date_trunc('week', " + Text + ")";
		EndIf;
		Return "DATEADD(day, -((DATEPART(weekday, " + Text + ") + @@DATEFIRST - 2) % 7), " + Day + ")";
	ElsIf Normalized = "TENDAYS" Or Normalized = Upper("Декада") Then
		If PostgreSQL Then
			Return "(date_trunc('month', " + Text + ") + (CASE"
				+ " WHEN EXTRACT(DAY FROM " + Text + ") <= 10 THEN 0"
				+ " WHEN EXTRACT(DAY FROM " + Text + ") <= 20 THEN 10 ELSE 20 END)"
				+ " * INTERVAL '1 day')";
		EndIf;
		Return "DATEADD(day, CASE WHEN DATEPART(day, " + Text + ") <= 10 THEN 0"
			+ " WHEN DATEPART(day, " + Text + ") <= 20 THEN 10 ELSE 20 END, "
			+ "DATEADD(month, DATEDIFF(month, 0, " + Text + "), 0))";
	ElsIf Normalized = "HALFYEAR" Or Normalized = Upper("Полугодие") Then
		If PostgreSQL Then
			Return "(date_trunc('year', " + Text + ") + (CASE"
				+ " WHEN EXTRACT(MONTH FROM " + Text + ") <= 6 THEN 0 ELSE 6 END)"
				+ " * INTERVAL '1 month')";
		EndIf;
		Return "DATEADD(month, CASE WHEN DATEPART(month, " + Text + ") <= 6 THEN 0 ELSE 6 END, "
			+ "DATEADD(year, DATEDIFF(year, 0, " + Text + "), 0))";
	EndIf;

	Return TruncateToUnit(PeriodUnit(Normalized), Text, Context);

EndFunction

// Шаг сетки периодов. У декады шага нет - в месяце декады по 10, 10 и 8-11 дней.
Function PeriodStep(RawPeriodicity, Text, Context)

	Normalized = Upper(TrimAll(RawPeriodicity));
	If Normalized = "TENDAYS" Or Normalized = Upper("Декада") Then
		Return "";
	ElsIf Normalized = "WEEK" Or Normalized = Upper("Неделя") Then
		Return ShiftedDate(Text, "1", "week", Context);
	ElsIf Normalized = "HALFYEAR" Or Normalized = Upper("Полугодие") Then
		Return ShiftedDate(Text, "6", "month", Context);
	EndIf;

	Kind = PeriodicityKind(Normalized);
	If Kind <> "UNIT" Then
		Return "";
	EndIf;
	Return ShiftedDate(Text, "1", PeriodUnit(Normalized), Context);

EndFunction

// Сдвиг даты на заданное число единиц. В MS SQL это DATEADD, в PostgreSQL -
// прибавление интервала: DATEADD там не существует.
Function ShiftedDate(Value, Amount, Unit, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return "(" + Value + " + (" + Amount + ") * INTERVAL '1 " + Unit + "')";
	EndIf;
	Return "DATEADD(" + Unit + ", " + Amount + ", " + Value + ")";

EndFunction

// Метод дополнения периодов у ОстаткиИОбороты. По умолчанию платформа добавляет
// к периодам с движениями границы интервала, поэтому пустое значение - это границы.
Function PeriodCompletion(RawArgument)

	Text = Upper(TrimAll(RawArgument));
	// Английское имя метода дополнения «Движения» - RegisterRecords (battery35 на ERP WE: без него
	// перевод молча дополнял границами).
	If Text = Upper("Движения") Or Text = "MOVEMENTS" Or Text = "REGISTERRECORDS" Then
		Return "MOVEMENTS";
	EndIf;
	// В корпусах встречаются только Движения / RegisterRecords / Movements и
	// ДвиженияИГраницыПериода / RegisterRecordsAndPeriodBoundaries; незнакомое слово границами
	// молча не считается.
	If IsBlankString(Text) Or Text = Upper("ДвиженияИГраницыПериода")
		Or Text = "MOVEMENTSANDPERIODBOUNDARIES" Or Text = "REGISTERRECORDSANDPERIODBOUNDARIES" Then
		Return "BOUNDARIES";
	EndIf;
	Raise StrTemplate(
		"Period completion method %1 of BalanceAndTurnovers is not known: expected an empty value,"
		+ " RegisterRecords or RegisterRecordsAndPeriodBoundaries.", TrimAll(RawArgument));

EndFunction

Function PeriodicityKind(RawPeriodicity)

	Normalized = Upper(TrimAll(RawPeriodicity));
	If IsBlankString(Normalized) Then
		Return "NONE";
	ElsIf Normalized = "AUTO" Or Normalized = Upper("Авто") Then
		Return "AUTO";
	ElsIf Normalized = "RECORD" Or Normalized = Upper("Запись") Then
		Return "RECORD";
	ElsIf IsRecorderPeriodicity(Normalized) Then
		Return "RECORDER";
	ElsIf Normalized = "PERIOD" Or Normalized = Upper("Период") Then
		Return "PERIOD";
	EndIf;
	Return "UNIT";

EndFunction

Function PeriodDetail(RawPeriodicity, Base, Context)

	Detail = New Structure;
	Detail.Insert("Kind", PeriodicityKind(RawPeriodicity));
	Detail.Insert("Columns", New Array);
	Detail.Insert("Aliases", New Map);
	Detail.Insert("Parts", New Map);
	Detail.Insert("SortAlias", "");

	If Detail.Kind = "NONE" Then
		Return Detail;
	EndIf;

	// Периодичность Период - итог за весь интервал одной строкой, поля Период у таблицы нет
	// вовсе. Замер 15.11.2026 (УХ): у оборотов и остатков с оборотами регистра накопления, у
	// Обороты, ОборотыДтКт и ОстаткиИОбороты бухрегистра строки те же, что без параметра.
	// Группировка по самой дате движения давала по строке на каждый момент (полная сверка
	// УХ: 1С 1 строка, SQL 0).
	If Detail.Kind = "PERIOD" Then
		Detail.Kind = "NONE";
		Return Detail;
	EndIf;

	PeriodText = VirtualColumn(PeriodColumn(Base), Context);

	If Detail.Kind = "UNIT" Then
		AddDetailColumn(Detail, "Period", PeriodTruncation(RawPeriodicity, PeriodText, Context), "Период");
		Detail.SortAlias = "Period";
		Return Detail;
	EndIf;

	Recorder = RecorderColumn(Base);
	If Recorder = Undefined Then
		Raise "Register has no recorder, periodicity down to a record is meaningless.";
	EndIf;

	If Detail.Kind = "RECORDER" Or Detail.Kind = "RECORD" Then
		AddDetailColumn(Detail, "Period", PeriodText, "Период");
		Detail.SortAlias = "Period";
	Else
		AddUnitColumns(Detail, PeriodText, Context);
		Detail.SortAlias = "SortKey";
		AddDetailColumn(Detail, "SortKey", PeriodText, "");
	EndIf;

	AddDetailColumn(Detail, "Recorder", VirtualColumn(Recorder, Context), "Регистратор");

	// Номер строки даёт только периодичность Запись и Авто. У периодичности Регистратор
	// платформа показывает лишь Период и Регистратор - замерено на обоих видах регистров.
	If Detail.Kind <> "RECORDER" Then
		LineNumber = Base.Fields.Get("LINENUMBER");
		If LineNumber = Undefined Then
			LineNumber = Base.Fields.Get(Upper("НомерСтроки"));
		EndIf;
		If LineNumber <> Undefined Then
			AddDetailColumn(Detail, "LineNumber", VirtualColumn(LineNumber, Context), "НомерСтроки");
		EndIf;
	EndIf;

	// Уточнение периода платформа показывает там же, где регистратор: замерено, что у
	// периодичности Регистратор и Запись поле есть, а у Месяца его нет вовсе.
	Adjustment = Base.Fields.Get("PERIODADJUSTMENT");
	If Adjustment = Undefined Then
		Adjustment = Base.Fields.Get(Upper("УточнениеПериода"));
	EndIf;
	If Adjustment <> Undefined Then
		AddDetailColumn(Detail, "PeriodAdjustment", VirtualColumn(Adjustment, Context),
			"УточнениеПериода");
	EndIf;

	// Регистратор составной: без его подколонки типа ни ССЫЛКА, ни ТИПЗНАЧЕНИЯ не работают.
	ColumnList = Base.Columns.Get("RECORDER");
	If ColumnList = Undefined Then
		ColumnList = Base.Columns.Get(Upper("Регистратор"));
	EndIf;
	If ColumnList <> Undefined And ColumnList.Count() > 1 Then
		Names = New Array;
		For Each Part In ColumnList Do
			Alias = PartAlias("Recorder", Part);
			AddDetailColumn(Detail, Alias, VirtualColumn(Part, Context), "");
			Names.Add(Alias);
		EndDo;
		Detail.Parts.Insert("RECORDER", Names);
		Detail.Parts.Insert(Upper("Регистратор"), Names);
	EndIf;

	Return Detail;

EndFunction

// Авто без единого выбранного поля периода платформа строит как таблицу без периодичности:
// замер 15.11.2026 на тех же пяти таблицах, что и у периодичности Период, - строки те же, что
// без параметра (УХ, ОстаткиИОбороты регистра накопления: 1С 1 строка, SQL по записям 5).
// Used = Undefined - проход за составом полей: там поля Авто нужны все.
Function DetailForUsedFields(Detail, Used, Base, Context)

	If Detail.Kind <> "AUTO" Or Used = Undefined Then
		Return Detail;
	EndIf;
	For Each Item In Detail.Aliases Do
		If Used.Get(Item.Key) <> Undefined Then
			Return Detail;
		EndIf;
	EndDo;
	Return PeriodDetail("", Base, Context);

EndFunction

Procedure AddDetailColumn(Detail, Alias, Expression, RussianName)

	Column = New Structure;
	Column.Insert("Alias", Alias);
	Column.Insert("Expression", Expression);
	Detail.Columns.Add(Column);

	Detail.Aliases.Insert(Upper(Alias), Alias);
	If Not IsBlankString(RussianName) Then
		Detail.Aliases.Insert(Upper(RussianName), Alias);
	EndIf;

EndProcedure

// При Авто платформа отдаёт начало каждого вида периода. Неделя, декада и полугодие
// зависят от настроек сервера и сознательно не выводятся.
Procedure AddUnitColumns(Detail, PeriodText, Context)

	Kinds = New Array;
	Kinds.Add("Second");
	Kinds.Add("Minute");
	Kinds.Add("Hour");
	Kinds.Add("Day");
	Kinds.Add("Week");
	Kinds.Add("TenDays");
	Kinds.Add("Month");
	Kinds.Add("Quarter");
	Kinds.Add("HalfYear");
	Kinds.Add("Year");

	Russian = New Map;
	Russian.Insert("Second", "Секунда");
	Russian.Insert("Minute", "Минута");
	Russian.Insert("Hour", "Час");
	Russian.Insert("Day", "День");
	Russian.Insert("Week", "Неделя");
	Russian.Insert("TenDays", "Декада");
	Russian.Insert("Month", "Месяц");
	Russian.Insert("Quarter", "Квартал");
	Russian.Insert("HalfYear", "Полугодие");
	Russian.Insert("Year", "Год");

	For Each Kind In Kinds Do
		AddDetailColumn(Detail, Kind + "Period", PeriodTruncation(Kind, PeriodText, Context),
			"Период" + Russian.Get(Kind));
	EndDo;

EndProcedure

// Детализация до записи регистра: строки до начала периода нужны для остатка, но в
// результат не идут, поэтому их отсекают уже после накопления.
Function IsRecordDetail(Detail)
	Return Detail.Kind = "AUTO" Or Detail.Kind = "RECORDER" Or Detail.Kind = "RECORD";
EndFunction

// Неделя, декада и полугодие не являются единицами DATEADD: неделя в T-SQL есть,
// декада - это десять дней, полугодие - шесть месяцев.
Function DateAddFunction(RawPeriodicity, Amount, Value, Context)

	Normalized = Upper(TrimAll(RawPeriodicity));
	If Normalized = "WEEK" Or Normalized = Upper("Неделя") Then
		Return ShiftedDate(Value, Amount, "week", Context);
	ElsIf Normalized = "TENDAYS" Or Normalized = Upper("Декада") Then
		Return ShiftedDate(Value, "10 * (" + Amount + ")", "day", Context);
	ElsIf Normalized = "HALFYEAR" Or Normalized = Upper("Полугодие") Then
		Return ShiftedDate(Value, "6 * (" + Amount + ")", "month", Context);
	EndIf;
	Return ShiftedDate(Value, Amount, PeriodUnit(Normalized), Context);

EndFunction

Function PeriodUnit(Name)

	Normalized = Upper(TrimAll(Name));
	Units = New Map;
	Units.Insert("SECOND", "second");
	Units.Insert(Upper("Секунда"), "second");
	Units.Insert("MINUTE", "minute");
	Units.Insert(Upper("Минута"), "minute");
	Units.Insert("HOUR", "hour");
	Units.Insert(Upper("Час"), "hour");
	Units.Insert("DAY", "day");
	Units.Insert(Upper("День"), "day");
	Units.Insert("MONTH", "month");
	Units.Insert(Upper("Месяц"), "month");
	Units.Insert("QUARTER", "quarter");
	Units.Insert(Upper("Квартал"), "quarter");
	Units.Insert("YEAR", "year");
	Units.Insert(Upper("Год"), "year");

	Unit = Units.Get(Normalized);
	If Unit = Undefined Then
		// Неделю, декаду и полугодие НАЧАЛОПЕРИОДА, ДОБАВИТЬКДАТЕ и сетка периодов разбирают до вызова;
		// сюда они доходят только из РАЗНОСТЬДАТ, а там их платформа отвергает сама (замер sm_dd1-sm_dd3,
		// 21.11.2026, УХ: «Wrong parameters "РАЗНОСТЬДАТ"»).
		Raise StrTemplate(
			"Period %1 is not a unit here: DATEDIFF takes SECOND, MINUTE, HOUR, DAY, MONTH, QUARTER and YEAR,"
			+ " and the platform itself rejects WEEK, TENDAYS and HALFYEAR in it (measured).", Name);
	EndIf;
	Return Unit;

EndFunction

Function DateLiteralFromArguments(Arguments, Context)

	While Arguments.Count() < 6 Do
		Arguments.Add(?(Arguments.Count() < 3, "1", "0"));
	EndDo;

	Year = Number(Arguments[0]) + Context.Options.DateOffset;
	// Нижняя граница хранимой даты. Измерено на базе со смещением 0: пустую дату
	// 01.01.0001 платформа кладёт в столбец как 1753-01-01, хотя столбец DATETIME2
	// и год 1 в него влезает. Перевод "как написано" даёт условие, которое молча
	// не находит ничего, тогда как платформа находит строки.
	// При смещении 2000 пустая дата это 2001 год, и граница не достигается.
	// Только MS SQL: 1753 - минимум его типа DATETIME, и именно его платформа
	// повторяет. Как хранится пустая дата в PostgreSQL, не замерено, а без замера
	// переносить правило туда нельзя.
	If Year < 1753 And Context.Options.Dialect <> "PostgreSQL" Then
		Year = 1753;
		Arguments[1] = "1";
		Arguments[2] = "1";
		Arguments[3] = "0";
		Arguments[4] = "0";
		Arguments[5] = "0";
	EndIf;
	Stamp = Format(Year, "ND=4; NLZ=; NG=0")
		+ "-" + PadLeft(Arguments[1]) + "-" + PadLeft(Arguments[2])
		+ " " + PadLeft(Arguments[3]) + ":" + PadLeft(Arguments[4]) + ":" + PadLeft(Arguments[5]);

	If Context.Options.Dialect = "PostgreSQL" Then
		Return "TIMESTAMP '" + Stamp + "'";
	EndIf;
	Return "CAST('" + Stamp + "' AS DATETIME2)";

EndFunction

Function PadLeft(Value)
	// Format(0, "NG=0; NZ=0") gives an empty string, so zero arrives here as nothing at all.
	Text = TrimAll(String(Value));
	While StrLen(Text) < 2 Do
		Text = "0" + Text;
	EndDo;
	Return Text;
EndFunction

// VALUE(Enum.X.Y) and VALUE(Catalog.X.Predefined) become the physical reference bytes.
// The path is written in query language terms, so it is mapped onto the manager first.
Function PredefinedValueLiteral(Path, Context)

	Parts = StrSplit(TrimAll(Path), ".", False);
	If Parts.Count() < 2 Then
		Raise StrTemplate("Cannot resolve VALUE(%1).", Path);
	EndIf;

	SystemValue = SystemEnumLiteral(Parts);
	If SystemValue <> Undefined Then
		Return SystemValue;
	EndIf;

	Collection = ManagerCollection(Parts[0]);
	If Collection = Undefined Then
		Raise StrTemplate("VALUE(%1): unsupported metadata kind.", Path);
	EndIf;

	Expression = Collection + "." + Parts[1];
	// Точка маршрута: БизнесПроцесс.X.ТочкаМаршрута.Y - это BusinessProcesses.X.RoutePoints.Y. Замер sm_rp1,
	// sm_rp5 (21.11.2026, УХ): `_Point_TYPE = 0x08 AND _Point_RTRef = <таблица точек X> AND _Point_RRRef = @P`.
	// Прежде имя точки терялось: «Object field not found (ТочкаМаршрута)».
	RoutePoint = Collection = "BusinessProcesses" And Parts.Count() = 4 And IsRoutePointSegment(Parts[2]);
	If RoutePoint Then
		Expression = Expression + ".RoutePoints." + TrimAll(Parts[3]);
	ElsIf Parts.Count() < 3 Or IsEmptyRefName(Parts[2]) Then
		Expression = Expression + ".EmptyRef()";
	Else
		Expression = Expression + "." + Parts[2];
	EndIf;

	Reference = Undefined;
	Try
		Reference = Eval(Expression);
	Except
		Raise StrTemplate("Cannot resolve VALUE(%1) in this infobase: %2", Path, ErrorDescription());
	EndTry;

	Return ReferenceLiteral(Reference, Context);

EndFunction

// System enumerations are not metadata: their values are stored as small numbers.
Function SystemEnumLiteral(Parts)

	If Parts.Count() < 2 Then
		Return Undefined;
	EndIf;

	Kind = Upper(TrimAll(Parts[0]));
	Value = Upper(TrimAll(Parts[1]));

	If Kind = "ACCUMULATIONRECORDTYPE" Or Kind = Upper("ВидДвиженияНакопления") Then
		If Value = "RECEIPT" Or Value = Upper("Приход") Then
			Return "0";
		ElsIf Value = "EXPENSE" Or Value = Upper("Расход") Then
			Return "1";
		EndIf;
	ElsIf Kind = "ACCOUNTINGRECORDTYPE" Or Kind = Upper("ВидДвиженияБухгалтерии") Then
		If Value = "DEBIT" Or Value = Upper("Дебет") Then
			Return "0";
		ElsIf Value = "CREDIT" Or Value = Upper("Кредит") Then
			Return "1";
		EndIf;
	ElsIf Kind = "ACCOUNTTYPE" Or Kind = Upper("ВидСчета") Or Kind = Upper("ВидСчёта") Then
		// Вид счёта лежит в колонке _Kind плана счетов. Значения замерены на данных:
		// активный 0, пассивный 1, активно-пассивный 2.
		If Value = "ACTIVE" Or Value = Upper("Активный") Then
			Return "0";
		ElsIf Value = "PASSIVE" Or Value = Upper("Пассивный") Then
			Return "1";
		ElsIf Value = "ACTIVEPASSIVE" Or Value = Upper("АктивноПассивный") Then
			Return "2";
		EndIf;
	EndIf;

	Return Undefined;

EndFunction

Function IsEmptyRefName(Name)
	Normalized = Upper(TrimAll(Name));
	Return Normalized = "EMPTYREF" Or Normalized = Upper("ПустаяСсылка");
EndFunction

