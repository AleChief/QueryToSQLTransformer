Function ReferenceLiteral(Reference, Context)

	Internal = ValueToStringInternal(Reference);
	Hex = Left(Right(Internal, 33), 32);
	If StrLen(Hex) <> 32 Then
		Raise "Cannot take the internal representation of the reference.";
	EndIf;

	Return BinaryLiteral(Hex, Context);

EndFunction

Function ParameterReference(Name, Context)

	If Context.Options.Property("OuterPointsInTime") And Context.Options.OuterPointsInTime <> Undefined
		And Context.Options.OuterPointsInTime.Get(Name) <> Undefined Then
		Raise StrTemplate(
			"The subquery uses %1, a point in time of the outer query, as one value. A point in time is a pair - the"
			+ " date and the reference - and it is translated in a subquery only in a comparison with another point in"
			+ " time. Compare it, or use the date and the reference explicitly.",
			Context.Options.OuterColumnSources.Get(Name).Path);
	EndIf;
	// Заглушка вместо обращения к внешнему запросу - это не параметр, а колонка.
	If Context.Options.Property("OuterColumns") And Context.Options.OuterColumns <> Undefined Then
		Outer = Context.Options.OuterColumns.Get(Name);
		If Outer <> Undefined Then
			Return Outer;
		EndIf;
	EndIf;

	If Context.Options.SubstituteParameters Then
		If Context.Options.ParameterValues.Get(Name) <> Undefined Then
			// В (&Список): элементы - литералами через запятую. Пустой список у платформы -
			// (0x00) = 0x01, у НЕ В условия нет вовсе (замеры a3, a5, a10): IN от пустого
			// подзапроса ложно и при NULL слева, NOT IN - истинно.
			Items = ParameterListItems(Context.Options.ParameterValues.Get(Name));
			If Items <> Undefined Then
				Literals = New Array;
				For Each Item In Items Do
					Literals.Add(ValueLiteral(Item, Context));
				EndDo;
				Return ?(Literals.Count() = 0, EmptyListSql(Context), StrConcat(Literals, ", "));
			EndIf;
			Return ValueLiteral(Context.Options.ParameterValues.Get(Name), Context);
		EndIf;
		Context.Warnings.Add(StrTemplate(
			"No value supplied for parameter %1, a placeholder is emitted.", Name));
	EndIf;

	SafeName = TransliterateName(Name);
	Return ?(Context.Options.Dialect = "PostgreSQL", ":" + SafeName, "@" + SafeName);

EndFunction

// Элементы значения-списка: массива, фиксированного массива, списка значений. Undefined - не список.
Function ParameterListItems(Value)

	Items = New Array;
	If TypeOf(Value) = Type("Array") Or TypeOf(Value) = Type("FixedArray") Then
		For Each Item In Value Do
			Items.Add(Item);
		EndDo;
	ElsIf TypeOf(Value) = Type("ValueList") Then
		For Each Item In Value Do
			Items.Add(Item.Value);
		EndDo;
	Else
		Return Undefined;
	EndIf;
	Return Items;

EndFunction

// Пустой список значений как содержимое скобок IN (...).
Function EmptyListSql(Context)
	Return "SELECT NULL WHERE 1 = 0";
EndFunction

Function ValueLiteral(Value, Context)

	ValueType = TypeOf(Value);
	// Параметр со значением NULL у 1С - NULL: `5/&П`, НАЧАЛОПЕРИОДА(&П, МЕСЯЦ) дают NULL,
	// В ИЕРАРХИИ (&П) - ни одной строки (негативная батарея 13.11.2026: dz26, dt15, p12g).
	If Value = Null Then
		Return "NULL";
	ElsIf ValueType = Type("Structure") Then
		Return ReferenceLiteralFromUuid(Value.Uuid, Context);
	ElsIf ValueType = Type("UUID") Then
		// Уникальный идентификатор хранится в том же порядке байт, что и ссылка (замер 23.11.2026, ERP WE:
		// Пользователи.ИдентификаторПользователяИБ 51d756eb-0d8a-4445-ac4e-4ded76a72089 - 0xAC4E4DED76A7208944450D8A51D756EB).
		// Прежде значение шло в ReferenceLiteral и выходило текстом `0x56EB-0D8A-…` - SQL падал (8115).
		Return ReferenceLiteralFromUuid(String(Value), Context);
	ElsIf ValueType = Type("String") Then
		Return StringLiteral("""" + StrReplace(Value, """", """""") + """", Context);
	ElsIf ValueType = Type("Number") Then
		// NZ: без него Format отдаёт для нуля пустую строку, и литерала нет вовсе.
		// NN=1: минус вплотную перед числом («-1.5»), а не по региональной настройке.
		Return Format(Value, "NG=0; NDS=.; NZ=0; NN=1");
	ElsIf ValueType = Type("Boolean") Then
		Return BooleanLiteral(Value, Context);
	ElsIf ValueType = Type("PointInTime") Or ValueType = Type("Boundary") Then
		// Пара даты и ссылки (у границы ещё и вид): одним литералом не выражается, а ReferenceLiteral ниже взял бы
		// хвост её внутреннего представления за ссылку.
		Raise StrTemplate(
			"A parameter value of type %1 cannot stand in SQL as one literal: it is a date together with a reference"
			+ " (and, for a boundary, its kind). It is translated in a comparison with a point in time and as the period"
			+ " of a balance virtual table; this place is neither, or its form is not measured.", String(ValueType));
	ElsIf ValueType = Type("Date") Then
		Arguments = New Array;
		Arguments.Add(Format(Year(Value), "NG=0; NZ=0"));
		Arguments.Add(Format(Month(Value), "NG=0; NZ=0"));
		Arguments.Add(Format(Day(Value), "NG=0; NZ=0"));
		Arguments.Add(Format(Hour(Value), "NG=0; NZ=0"));
		Arguments.Add(Format(Minute(Value), "NG=0; NZ=0"));
		Arguments.Add(Format(Second(Value), "NG=0; NZ=0"));
		Return DateLiteralFromArguments(Arguments, Context);
	EndIf;

	Return ReferenceLiteral(Value, Context);

EndFunction

Function BooleanLiteral(Value, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return ?(Value, "TRUE", "FALSE");
	EndIf;
	Return ?(Value, "0x01", "0x00");

EndFunction

Function StringLiteral(Token, Context)

	Body = Mid(Token, 2, StrLen(Token) - 2);
	Body = StrReplace(Body, """""", """");
	Return TextLiteral(Body, Context);

EndFunction

// Литерал из готового текста: в отличие от StringLiteral кавычек вокруг него нет.
Function TextLiteral(Text, Context)

	Body = StrReplace(Text, "'", "''");
	Return ?(Context.Options.Dialect = "PostgreSQL", "'" + Body + "'", "N'" + Body + "'");

EndFunction

