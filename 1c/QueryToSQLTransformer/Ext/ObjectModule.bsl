Function TransformInEnglish(QueryText, Options)

	Result = New Structure;
	Result.Insert("Success", False);
	Result.Insert("SQL", "");
	Result.Insert("ErrorDescription", "");
	Result.Insert("Warnings", New Array);

	Opt = ?(Options = Undefined, DefaultOptions(), Options);

	If IsBlankString(QueryText) Then
		Result.ErrorDescription = "The query is empty.";
		Return Result;
	EndIf;

	Text = QueryText;
	If Opt.Property("Prologue") And Not IsBlankString(Opt.Prologue) Then
		Text = CombinedQueryText(QueryText, Opt.Prologue);
	EndIf;

	Schema = New QuerySchema;
	Try
		Schema.SetQueryText(Text);
	Except
		Description = ErrorDescription();
		Result.ErrorDescription = "The platform could not parse the query:" + Chars.LF + Description;
		Hint = "";
		Try
			Hint = PlatformParseHint(Text, Description);
		Except
			Hint = "";
		EndTry;
		If Not IsBlankString(Hint) Then
			Result.ErrorDescription = Hint + Chars.LF + Result.ErrorDescription;
		EndIf;
		Return Result;
	EndTry;

	If MentionsFilterCriterion(Text) Then
		Try
			Text = WithFilterCriteriaExpanded(Text, Opt, Schema);
		Except
			Result.ErrorDescription = ErrorDescription();
			Return Result;
		EndTry;
	EndIf;

	WarnAboutPlatformOnlyParts(Schema, Result.Warnings);

	// Состояние одного перевода живёт в настройках, а их вызывающий вправе передать
	// снова: без сброса тип параметра, выведенный для прошлого запроса, достаётся
	// следующему.
	Opt.Insert("ParameterSqlTypes", Undefined);
	Opt.Insert("ParameterTypeLinks", Undefined);
	Opt.Insert("ParameterColumnsSeen", False);
	Opt.Insert("BatchTrimmed", False);
	Opt.Insert("BranchingGroups", BranchingGroups(Text, Result.Warnings));
	Opt.Insert("GroupingSets", GroupingSetsOfText(Text));
	Opt.Insert("SchemaParameterTypes", SchemaParameterTypes(Schema));

	Opt.Insert("PartsOnlyRefs", New Map);
	Opt.Insert("PartsOnlyStubs", New Map);
	Opt.Insert("PartsOnlyBranchRefusal", "");
	Opt.Insert("PartsOnlyStubQueries", New Map);
	Opt.Insert("PartsOnlyAliasReads", New Map);

	Try
		// Чтение колонок из одних частей проверяет SqlFromSchema - по тексту каждого запроса пакета.
		Result.SQL = SqlFromSchema(Schema, Opt, Result.Warnings);
		CheckBranchingGroups(Opt);
		Result.SQL = WithParameterPrologue(Result.SQL, Schema, Opt, Result.Warnings);
		// Ограничения доступа на уровне записей платформа достраивает в запрос сама; перевод их не несёт ни при
		// РАЗРЕШЕННЫЕ, ни без него (решение владельца 23.11.2026: об этом - в каждом переводе).
		AddOnce(Result.Warnings, "Record level security (RLS) is not applied, even where access restrictions are"
			+ " configured: the SQL returns every row the DBMS account can read.");
		Result.Success = True;
	Except
		Result.ErrorDescription = ErrorDescription();
	EndTry;

	Return Result;

EndFunction

// СГРУППИРОВАТЬ ПО ГРУППИРУЮЩИМ НАБОРАМ. Модель запроса наборов не хранит: у оператора Group -
// Неопределено (справка 8.3.27: у ОператорВыбратьСхемыЗапроса другого свойства для них нет).
// Поэтому наборы берутся из текста - поиском одного образца по токенам, как в BranchingGroups.
// Возвращает массив предложений в порядке текста; предложение - массив наборов, набор - массив
// текстов выражений. Запись НАБОРАМ (А, Б) - два набора по одному выражению, ((А, Б)) - один из
// двух, () - пустой набор (справка, раздел «Предложение СГРУППИРОВАТЬ ПО»).
Function GroupingSetsOfText(Text)

	Clauses = New Array;
	Raised = Upper(Text);
	If StrFind(Raised, "GROUPING") = 0 And StrFind(Raised, Upper("Группирующим")) = 0 Then
		Return Clauses;
	EndIf;
	Tokens = Tokenize(WithoutLineComments(Text));
	Index = 0;
	While Index < Tokens.Count() - 2 Do
		Word = Upper(Tokens[Index].Value);
		Next = Upper(Tokens[Index + 1].Value);
		If Not ((Word = "GROUPING" And Next = "SETS")
			Or (Word = Upper("Группирующим") And Next = Upper("Наборам")))
			Or Tokens[Index + 2].Value <> "(" Then
			Index = Index + 1;
			Continue;
		EndIf;
		Sets = New Array;
		Position = Index + 3;
		Start = Position;
		Depth = 0;
		While Position < Tokens.Count() Do
			Value = Tokens[Position].Value;
			If Value = "(" Then
				Depth = Depth + 1;
			ElsIf Value = ")" And Depth > 0 Then
				Depth = Depth - 1;
			ElsIf (Value = "," Or Value = ")") And Depth = 0 Then
				If Position > Start Then
					Sets.Add(GroupingSetItems(Tokens, Start, Position - 1));
				EndIf;
				If Value = ")" Then
					Break;
				EndIf;
				Start = Position + 1;
			EndIf;
			Position = Position + 1;
		EndDo;
		Clauses.Add(Sets);
		Index = Position + 1;
	EndDo;
	Return Clauses;

EndFunction

// Набор: элемент в своих скобках - список выражений через запятую, иначе одно выражение.
Function GroupingSetItems(Tokens, From, Till)

	Items = New Array;
	Wrapped = Tokens[From].Value = "(" And Tokens[Till].Value = ")";
	If Wrapped Then
		Depth = 0;
		For Position = From To Till Do
			If Tokens[Position].Value = "(" Then
				Depth = Depth + 1;
			ElsIf Tokens[Position].Value = ")" Then
				Depth = Depth - 1;
				If Depth = 0 And Position < Till Then
					Wrapped = False;
					Break;
				EndIf;
			EndIf;
		EndDo;
	EndIf;
	If Not Wrapped Then
		Items.Add(TokensText(Tokens, From, Till));
		Return Items;
	EndIf;
	Start = From + 1;
	Depth = 0;
	For Position = From + 1 To Till Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" And Depth > 0 Then
			Depth = Depth - 1;
		ElsIf (Value = "," And Depth = 0) Or Position = Till Then
			If Position > Start Then
				Items.Add(TokensText(Tokens, Start, Position - 1));
			EndIf;
			Start = Position + 1;
		EndIf;
	EndDo;
	Return Items;

EndFunction

// Число группировок оператора; у группировки по наборам модель держит Неопределено - такой
// оператор сгруппирован.
Function GroupCount(Operator)

	If Operator.Group = Undefined Then
		Return 1;
	EndIf;
	Return Operator.Group.Count();

EndFunction

// Тексты выражений группировки оператора: из модели либо, у группировки по наборам, - все
// выражения всех наборов.
Function GroupTexts(Operator, Context)

	Texts = New Array;
	If Operator.Group <> Undefined Then
		For Each Expression In Operator.Group Do
			Texts.Add(String(Expression));
		EndDo;
		Return Texts;
	EndIf;
	For Each Set In OperatorGroupingSets(Operator, Context) Do
		For Each Item In Set Do
			If Texts.Find(Item) = Undefined Then
				Texts.Add(Item);
			EndIf;
		EndDo;
	EndDo;
	Return Texts;

EndFunction

// GROUP BY GROUPING SETS ((а), (б, в), ()) - как пишет платформа; один набор - обычный GROUP BY.
// Колонку, которую правила добора внесли в группировку сверх наборов (часть составного поля,
// колонка разыменования), отнести к набору нечем: такой запрос - отказ.
Function GroupingSetsSql(Sets, Grouping)

	Covered = New Array;
	For Each Set In Sets Do
		For Each Column In Set Do
			Covered.Add(Column);
		EndDo;
	EndDo;
	For Each Column In Grouping Do
		If Covered.Find(Column) = Undefined Then
			Raise StrTemplate("GROUP BY GROUPING SETS needs the column %1 in the grouping besides the"
				+ " expressions of the sets (a part of a composite field or a column reached through a"
				+ " reference), and which set it belongs to is not known. Group by plain fields, or split"
				+ " the query by sets.", Column);
		EndIf;
	EndDo;
	If Sets.Count() = 1 Then
		Return ?(Sets[0].Count() = 0, "", "GROUP BY " + StrConcat(Sets[0], ", "));
	EndIf;
	Parts = New Array;
	For Each Set In Sets Do
		Parts.Add("(" + StrConcat(Set, ", ") + ")");
	EndDo;
	Return "GROUP BY GROUPING SETS (" + StrConcat(Parts, ", ") + ")";

EndFunction

// СГРУППИРОВАНОПО(Выражение) - получена ли строка группировкой по этому выражению. Замер
// 18.11.2026 (УХ, gs_uh gs1): CASE WHEN NOT ((GROUPING(x) = 1.0)) THEN 0x01 ELSE 0x00 END.
Function GroupedByFunction(Arguments, Context)

	If Arguments.Count() <> 1 Then
		Raise "GROUPEDBY takes one argument: an expression of the GROUP BY clause.";
	EndIf;
	Saved = Context.BooleanContext;
	Context.BooleanContext = False;
	Value = Translated(Arguments, 0, Context);
	Context.BooleanContext = Saved;
	If Context.BooleanContext Then
		Return "(GROUPING(" + Value + ") = 0)";
	EndIf;
	Return "CASE WHEN NOT ((GROUPING(" + Value + ") = 1.0)) THEN " + BooleanLiteral(True, Context)
		+ " ELSE " + BooleanLiteral(False, Context) + " END";

EndFunction

// Наборы этого оператора. Предложений с наборами в тексте бывает несколько (по справке - только у
// таблиц верхнего уровня, у вложенного запроса их нет), а модель их не хранит. Оператору достаётся
// предложение, все псевдонимы выражений которого - его источники; одинаковые по тексту предложения
// (ветви объединения) взаимозаменяемы.
// Условия отбора оператора: текст и признак агрегата. Обращение к табличной части через точку
// (Т.ТабличнаяЧасть.Поле) переписано в подзапрос по её строкам. Замер 18.11.2026 (УХ, ts_uh t2,
// ts2_uh t4-t8): платформа пишет EXISTS(SELECT 1 FROM <ТЧ> T2 WHERE <владелец = T1> AND <условие>);
// слагаемые И по одной табличной части - один EXISTS (условия на одной строке), под НЕ - НЕ EXISTS
// своего сравнения, при ИЛИ - EXISTS у своего слагаемого. Т.Ссылка В (ВЫБРАТЬ Стр.Ссылка ИЗ ТЧ ...)
// отбирает те же строки, что EXISTS: ссылка не бывает NULL.
Function FilterConditions(Operator, Context)

	// Условия отбора - плоской цепочкой И: условие с табличной частью через точку раскрывается и по И в скобках.
	Conjuncts = New Array;
	For Each Expression In Operator.Filter Do
		Text = CastSectionPaths(String(Expression), Context);
		If Expression.ContainsAggregateFunction() Then
			Conjuncts.Add(New Structure("Text, Aggregate", Text, True));
			Continue;
		EndIf;
		For Each Part In TabularConjuncts(Text, Operator, Context) Do
			Conjuncts.Add(New Structure("Text, Aggregate", Part, False));
		EndDo;
	EndDo;
	// Хвост цепочки из условий одной табличной части - один EXISTS (замер v9-v16).
	TrailKey = Undefined;
	TrailFrom = Conjuncts.Count();
	For Position = -(Conjuncts.Count() - 1) To 0 Do
		Item = Conjuncts[-Position];
		Info = ?(Item.Aggregate, Undefined, MergeableTabularInfo(Item.Text, Operator, Context));
		If Info = Undefined Or (TrailKey <> Undefined And Info.Key <> TrailKey) Then
			Break;
		EndIf;
		TrailKey = Info.Key;
		TrailFrom = -Position;
	EndDo;

	Result = New Array;
	Merged = New Map;
	For Index = 0 To Conjuncts.Count() - 1 Do
		Text = Conjuncts[Index].Text;
		If Conjuncts[Index].Aggregate Then
			Tokens = Tokenize(Text);
			Refs = TabularReferences(Tokens, 0, Tokens.Count() - 1, Operator, Context);
			If Refs.Count() = 1 Then
				For Each Pair In Refs Do
					Info = Pair.Value;
				EndDo;
				Result.Add(New Structure("Text, Aggregate, Sql", Text, False,
					TabularAggregateExists(Info, Text, Context)));
				Continue;
			EndIf;
			Result.Add(New Structure("Text, Aggregate", Text, True));
			Continue;
		EndIf;
		Tokens = WithoutOuterParentheses(Tokenize(Text));
		Refs = TabularReferences(Tokens, 0, Tokens.Count() - 1, Operator, Context);
		If Refs.Count() = 0 Then
			Result.Add(New Structure("Text, Aggregate", Text, False));
			Continue;
		EndIf;
		If TopLevelSplits(Tokens, "OR,ИЛИ").Count() > 1 Then
			Operands = New Array;
			For Each Span In TopLevelSplits(Tokens, "OR,ИЛИ") Do
				Operands.Add("(" + TabularOperandText(Tokens, Span.From, Span.Till, Operator, Context) + ")");
			EndDo;
			// Скобки вокруг всего ИЛИ: условия отбора соединяются через И, и без них И забирало бы только
			// последнее слагаемое (полная сверка 22.11.2026, УХ: ПолучитьДляЛотаПротокол, лишний документ).
			Result.Add(New Structure("Text, Aggregate", "(" + StrConcat(Operands, " OR ") + ")", False));
			Continue;
		EndIf;
		Word = ?(Tokens[0].Kind = "Name", Upper(Tokens[0].Value), "");
		If Refs.Count() > 1 Or Word = "NOT" Or Word = Upper("Не") Then
			Result.Add(New Structure("Text, Aggregate",
				TabularOperandText(Tokens, 0, Tokens.Count() - 1, Operator, Context), False));
			Continue;
		EndIf;
		For Each Pair In Refs Do
			Info = Pair.Value;
		EndDo;
		If Index < TrailFrom Then
			Single = New Array;
			Single.Add(Text);
			Result.Add(New Structure("Text, Aggregate", TabularSubqueryText(Info, Single), False));
			Continue;
		EndIf;
		Entry = Merged.Get(Info.Key);
		If Entry = Undefined Then
			Entry = New Structure("Index, Parts, Info", Result.Count(), New Array, Info);
			Merged.Insert(Info.Key, Entry);
			Result.Add(New Structure("Text, Aggregate", "", False));
		EndIf;
		Entry.Parts.Add(Text);
	EndDo;
	For Each Pair In Merged Do
		Entry = Pair.Value;
		Result[Entry.Index].Text = TabularSubqueryText(Entry.Info, Entry.Parts);
	EndDo;
	Return Result;

EndFunction

// Условие отбора с табличной частью через точку - слагаемыми И верхнего уровня, И в скобках раскрывается; без
// табличной части и с МЕЖДУ (его И - не связка) - как есть.
Function TabularConjuncts(Text, Operator, Context)

	Result = New Array;
	Tokens = WithoutOuterParentheses(Tokenize(Text));
	If TabularReferences(Tokens, 0, Tokens.Count() - 1, Operator, Context).Count() = 0 Then
		Result.Add(Text);
		Return Result;
	EndIf;
	Splits = ConjunctSplits(Tokens);
	If Splits.Count() = 1 Then
		Result.Add(Text);
		Return Result;
	EndIf;
	For Each Span In Splits Do
		For Each Part In TabularConjuncts(TokensText(Tokens, Span.From, Span.Till), Operator, Context) Do
			Result.Add(Part);
		EndDo;
	EndDo;
	Return Result;

EndFunction

// Слагаемые И верхнего уровня; И внутри МЕЖДУ ... И ... - не связка, его отрезки склеиваются.
Function ConjunctSplits(Tokens)

	Result = New Array;
	If TopLevelSplits(Tokens, "OR,ИЛИ").Count() > 1 Then
		// И связывает сильнее ИЛИ: `А ИЛИ Б И В` - одно слагаемое.
		Result.Add(New Structure("From, Till", 0, Tokens.Count() - 1));
		Return Result;
	EndIf;
	Pending = False;
	For Each Span In TopLevelSplits(Tokens, "AND,И") Do
		If Pending Then
			Result[Result.Count() - 1].Till = Span.Till;
		Else
			Result.Add(New Structure("From, Till", Span.From, Span.Till));
		EndIf;
		Pending = False;
		Depth = 0;
		For Position = Span.From To Span.Till Do
			Value = Upper(Tokens[Position].Value);
			If Value = "(" Then
				Depth = Depth + 1;
			ElsIf Value = ")" Then
				Depth = Depth - 1;
			ElsIf Depth = 0 And Tokens[Position].Kind = "Name" And (Value = "BETWEEN" Or Value = Upper("Между")) Then
				Pending = True;
			EndIf;
		EndDo;
	EndDo;
	Return Result;

EndFunction

// Описание табличной части у слагаемого, которое сливается с соседними в один EXISTS: одно обращение к табличной части,
// без ИЛИ и НЕ на верхнем уровне. Undefined - иначе.
Function MergeableTabularInfo(Text, Operator, Context)

	Tokens = WithoutOuterParentheses(Tokenize(Text));
	Refs = TabularReferences(Tokens, 0, Tokens.Count() - 1, Operator, Context);
	If Refs.Count() <> 1 Or TopLevelSplits(Tokens, "OR,ИЛИ").Count() > 1 Then
		Return Undefined;
	EndIf;
	Word = ?(Tokens[0].Kind = "Name", Upper(Tokens[0].Value), "");
	If Word = "NOT" Or Word = Upper("Не") Then
		Return Undefined;
	EndIf;
	For Each Pair In Refs Do
		Return Pair.Value;
	EndDo;

EndFunction

// Условие ИМЕЮЩИЕ над полями табличной части: платформа пишет EXISTS(SELECT 1 FROM <ТЧ> T2 WHERE <владелец =
// T1> HAVING <условие>) в отборе, без группировки внутри - и владелец без строк даёт КОЛИЧЕСТВО 0 (замер
// 18.11.2026, УХ, tsagg_uh a2). Подзапрос собирается текстом запроса со ссылкой на владельца снаружи.
Function TabularAggregateExists(Info, Text, Context)

	Russian = StrFind("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ", Upper(Left(Info.Table, 1))) > 0;
	RefName = ?(Russian, "Ссылка", "Ref");
	RowAlias = "Q2SSectionRow";
	Prefix = Upper(Info.Alias + "." + Info.Section + ".");
	Pieces = New Array;
	For Each Token In Tokenize(Text) Do
		If Token.Kind = "Name" And StrStartsWith(Upper(Token.Value), Prefix) Then
			Pieces.Add(RowAlias + "." + Mid(Token.Value, StrLen(Prefix) + 1));
		ElsIf Token.Kind = "Parameter" Then
			Pieces.Add("&" + Token.Value);
		Else
			Pieces.Add(Token.Value);
		EndIf;
	EndDo;
	Condition = StrConcat(Pieces, " ");
	If Russian Then
		Query = "ВЫБРАТЬ 1 ИЗ " + Info.Table + "." + Info.Section + " КАК " + RowAlias + " ГДЕ " + RowAlias + "."
			+ RefName + " = " + Info.Alias + "." + RefName + " ИМЕЮЩИЕ " + Condition;
	Else
		Query = "SELECT 1 FROM " + Info.Table + "." + Info.Section + " AS " + RowAlias + " WHERE " + RowAlias + "."
			+ RefName + " = " + Info.Alias + "." + RefName + " HAVING " + Condition;
	EndIf;
	Return "EXISTS (" + SubquerySql(Query, Context) + ")";

EndFunction

// Слагаемое условия: обращение к одной табличной части - подзапрос по её строкам, НЕ остаётся
// снаружи; без обращений - как есть; к двум табличным частям сразу - отказ.
Function TabularOperandText(Tokens, From, Till, Operator, Context)

	Refs = TabularReferences(Tokens, From, Till, Operator, Context);
	Text = TokensText(Tokens, From, Till);
	If Refs.Count() = 0 Then
		Return Text;
	EndIf;
	// Скобки и ИЛИ раскрываются на каждом уровне: EXISTS(А ИЛИ <строка>) у владельца без строк ложно, а
	// А ИЛИ EXISTS(<строка>) - нет. Платформа ставит EXISTS у слагаемого, и под НЕ (...) тоже (замер to04,
	// 22.11.2026, УХ). И внутри слагаемого остаётся в одном подзапросе: условие шапки от строки не зависит.
	If Till > From And Tokens[From].Value = "(" And MatchingParen(Tokens, From) = Till Then
		Return "(" + TabularOperandText(Tokens, From + 1, Till - 1, Operator, Context) + ")";
	EndIf;
	Slice = New Array;
	For Position = From To Till Do
		Slice.Add(Tokens[Position]);
	EndDo;
	Splits = TopLevelSplits(Slice, "OR,ИЛИ");
	If Splits.Count() > 1 Then
		Operands = New Array;
		For Each Span In Splits Do
			Operands.Add("(" + TabularOperandText(Slice, Span.From, Span.Till, Operator, Context) + ")");
		EndDo;
		Return "(" + StrConcat(Operands, " OR ") + ")";
	EndIf;
	If Refs.Count() > 1 Then
		Raise StrTemplate("The condition %1 refers to two tabular sections through a dot at once; the"
			+ " platform checks each with its own EXISTS, and how it splits such a condition has not been"
			+ " measured. Join the tabular sections explicitly.", Text);
	EndIf;
	For Each Pair In Refs Do
		Info = Pair.Value;
	EndDo;
	Word = ?(Tokens[From].Kind = "Name", Upper(Tokens[From].Value), "");
	If (Word = "NOT" Or Word = Upper("Не")) And From < Till Then
		If Info.Through Then
			Raise StrTemplate("NOT over a tabular section reached through a reference (%1) is not translated yet:"
				+ " for a NULL reference the platform's NOT EXISTS is true, and NOT ... IN is unknown.", Text);
		EndIf;
		Return "NOT (" + TabularOperandText(Tokens, From + 1, Till, Operator, Context) + ")";
	EndIf;
	Parts = New Array;
	Parts.Add(Text);
	Return TabularSubqueryText(Info, Parts);

EndFunction

// Обращения к табличной части через точку в токенах From..Till: ключ "ПСЕВДОНИМ.ТЧ" - описание
// (Key, Alias, Section, Table). Только к табличной части таблицы-источника этого оператора.
Function TabularReferences(Tokens, From, Till, Operator, Context = Undefined)

	Tables = New Map;
	If Operator = Undefined Then
		// Условие виртуальной таблицы (VirtualTabularCondition): источник один - регистр под псевдонимом условия.
		If Context = Undefined Or Not Context.Property("BareAlias") Or IsBlankString(Context.BareAlias)
			Or Context.BareDescriptor = Undefined Then
			Return New Map;
		EndIf;
		Tables.Insert(Upper(Context.BareAlias), Context.BareDescriptor.LogicalName);
	Else
		For Each Source In Operator.Sources Do
			For Each Table In AliasedSourceTables(Source) Do
				If Not IsNestedQuery(Table) Then
					Tables.Insert(SourceAlias(Table), TrimAll(Table.TableName));
				EndIf;
			EndDo;
		EndDo;
	EndIf;
	Refs = New Map;
	For Position = From To Till Do
		Token = Tokens[Position];
		If Token.Kind <> "Name" Then
			Continue;
		EndIf;
		Segments = StrSplit(Token.Value, ".");
		If Segments.Count() < 3 Then
			Continue;
		EndIf;
		TableName = Tables.Get(Upper(Segments[0]));
		If TableName = Undefined Then
			Continue;
		EndIf;
		// Табличная часть источника (Т.ТЧ.Поле) или объекта по ссылке (Т.Ссылка1.ТЧ.Поле - замер tsref_uh:
		// платформа соединяет таблицу ссылки и проверяет EXISTS по её табличной части).
		Path = Segments[0];
		Target = TableName;
		Composite = False;
		For Level = 1 To Segments.Count() - 2 Do
			Owner = MetadataOf(Target);
			Section = OwnedTabularSection(Owner, Segments[Level]);
			If Section <> Undefined Then
				Key_ = Upper(Path + "." + Segments[Level]);
				If Refs.Get(Key_) = Undefined Then
					Refs.Insert(Key_, New Structure("Key, Alias, Section, Table, Through, Composite", Key_, Path,
						Segments[Level], Target, Level > 1, Composite));
				EndIf;
				Break;
			EndIf;
			Path = Path + "." + Segments[Level];
			Target = "";
			Try
				Target = SingleReferenceTarget(Path, Context);
			Except
				Target = "";
			EndTry;
			If IsBlankString(Target) And Level + 1 <= Segments.Count() - 2 Then
				// Составное поле: таблица того единственного типа, у которого есть эта табличная часть (замер ct01-ct03).
				Target = CompositeSectionOwner(Path, Segments[Level + 1], Context);
				Composite = Not IsBlankString(Target);
			Else
				Composite = False;
			EndIf;
			If IsBlankString(Target) Then
				Break;
			EndIf;
		EndDo;
	EndDo;
	Return Refs;

EndFunction

// Условие с `ВЫРАЗИТЬ(Поле КАК Тип).ТЧ.Реквизит` - текстом `Поле.ТЧ.Реквизит`, владелец табличной части Тип запомнен в
// Context.CastSectionOwners (CompositeSectionOwner). Платформа пишет здесь соединение с таблицей типа под проверкой тега и
// EXISTS по табличной части (замер ctc1-ctc3, 23.11.2026, УХ). Поле одного другого типа и прочее - текст как есть.
Function CastSectionPaths(Text, Context)

	If Context = Undefined Or (StrFind(Upper(Text), "ВЫРАЗИТЬ") = 0 And StrFind(Upper(Text), "CAST") = 0) Then
		Return Text;
	EndIf;
	Tokens = Undefined;
	Try
		Tokens = Tokenize(Text);
	Except
		Return Text;
	EndTry;
	Changed = False;
	Pieces = New Array;
	Index = 0;
	While Index < Tokens.Count() Do
		Folded = CastSectionPath(Tokens, Index, Context);
		If Folded = Undefined Then
			Pieces.Add(TokensText(Tokens, Index, Index));
			Index = Index + 1;
			Continue;
		EndIf;
		Pieces.Add(Folded.Text);
		Index = Index + Folded.Consumed;
		Changed = True;
	EndDo;
	Return ?(Changed, StrConcat(Pieces, " "), Text);

EndFunction

// Одна свёртка CastSectionPaths с позиции Index: Structure(Text, Consumed) или Undefined.
Function CastSectionPath(Tokens, Index, Context)

	If Index + 7 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index].Value);
	If (Word <> "CAST" And Word <> Upper("Выразить")) Or Tokens[Index + 1].Value <> "("
		Or Tokens[Index + 2].Kind <> "Name" Or Tokens[Index + 3].Kind <> "Name"
		Or (Upper(Tokens[Index + 3].Value) <> "AS" And Upper(Tokens[Index + 3].Value) <> Upper("Как"))
		Or Tokens[Index + 4].Kind <> "Name" Or Tokens[Index + 5].Value <> ")" Or Tokens[Index + 6].Value <> "."
		Or Tokens[Index + 7].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Tail = StrSplit(Tokens[Index + 7].Value, ".");
	If Tail.Count() < 2 Then
		Return Undefined;
	EndIf;
	TypeName = Tokens[Index + 4].Value;
	Owner = MetadataOf(TypeName);
	If OwnedTabularSection(Owner, Tail[0]) = Undefined Then
		Return Undefined;
	EndIf;
	Path = Tokens[Index + 2].Value;
	Single = "";
	Try
		Single = SingleReferenceTarget(Path, Context);
	Except
		Single = "";
	EndTry;
	If Not IsBlankString(Single) And MetadataOf(Single) <> Owner Then
		Return Undefined;
	EndIf;
	If Not Context.Property("CastSectionOwners") Then
		Context.Insert("CastSectionOwners", New Map);
	EndIf;
	Context.CastSectionOwners.Insert(Upper(Path + "." + Tail[0]), Owner.FullName());
	Return New Structure("Text, Consumed", Path + "." + Tokens[Index + 7].Value, 8);

EndFunction

// Табличная часть объекта метаданных по имени - своя или стандартная (ВидыСубконто плана счетов, виды расчёта: замер
// vs1-vs3, 23.11.2026, УХ - условие через точку платформа переводит тем же EXISTS). Undefined - нет такой.
Function OwnedTabularSection(Owner, Name)

	If Owner = Undefined Then
		Return Undefined;
	EndIf;
	Found = Undefined;
	Try
		Found = Owner.TabularSections.Find(TrimAll(Name));
	Except
		Found = Undefined;
	EndTry;
	If Found <> Undefined Then
		Return Found;
	EndIf;
	Try
		For Each Standard In Owner.StandardTabularSections Do
			If Upper(Standard.Name) = Upper(TrimAll(Name)) Then
				Return Standard;
			EndIf;
		EndDo;
	Except
		Return Undefined;
	EndTry;
	Return Undefined;

EndFunction

// Таблица единственного ссылочного типа составного поля Path, у которого есть табличная часть Section; пустая
// строка - такого типа нет, их несколько (платформа проверяет каждый своим EXISTS - не замерено) или путь не поле.
Function CompositeSectionOwner(Path, Section, Context)

	If Context = Undefined Then
		Return "";
	EndIf;
	If Context.Property("CastSectionOwners") Then
		// Владелец задан приведением (CastSectionPaths); путь условия виртуальной таблицы - с псевдонимом.
		Segments = StrSplit(Path, ".");
		Bare = Path;
		If Segments.Count() > 1 Then
			Segments.Delete(0);
			Bare = StrConcat(Segments, ".");
		EndIf;
		For Each Candidate In StrSplit(Path + "|" + Bare, "|") Do
			Owner = Context.CastSectionOwners.Get(Upper(Candidate + "." + Section));
			If Owner <> Undefined Then
				Return Owner;
			EndIf;
		EndDo;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return "";
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;
	Description = ResolvedTypeDescription(Resolved);
	If Description = Undefined Then
		Return "";
	EndIf;
	Found = "";
	For Each Item In Description.Types() Do
		Meta = Metadata.FindByType(Item);
		If Meta = Undefined Then
			Continue;
		EndIf;
		Owned = OwnedTabularSection(Meta, Section);
		If Owned = Undefined Then
			Continue;
		EndIf;
		If Not IsBlankString(Found) Then
			Return "";
		EndIf;
		Found = Meta.FullName();
	EndDo;
	Return Found;

EndFunction

// Т.Ссылка В (ВЫБРАТЬ Стр.Ссылка ИЗ <Таблица>.<ТЧ> КАК Стр ГДЕ (часть 1) И (часть 2) ...), где в
// частях Т.ТЧ.Поле стало Стр.Поле. Язык слов - по имени таблицы.
Function TabularSubqueryText(Info, Parts)

	Russian = StrFind("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ", Upper(Left(Info.Table, 1))) > 0;
	RefName = ?(Russian, "Ссылка", "Ref");
	RowAlias = "Q2SSectionRow";
	Prefix = Upper(Info.Alias + "." + Info.Section + ".");
	Conditions = New Array;
	For Each Part In Parts Do
		Pieces = New Array;
		For Each Token In Tokenize(Part) Do
			If Token.Kind = "Name" And StrStartsWith(Upper(Token.Value), Prefix) Then
				Pieces.Add(RowAlias + "." + Mid(Token.Value, StrLen(Prefix) + 1));
			ElsIf Token.Kind = "Parameter" Then
				Pieces.Add("&" + Token.Value);
			Else
				Pieces.Add(Token.Value);
			EndIf;
		EndDo;
		Conditions.Add("(" + StrConcat(Pieces, " ") + ")");
	EndDo;
	// Составное поле сравнивается само: значение другого типа ни одной ссылке подзапроса не равно (ct02). Переход
	// .Ссылка через составное сравнивал бы одни 16 байт ссылки.
	Left_ = ?(Info.Property("Composite") And Info.Composite, Info.Alias, Info.Alias + "." + RefName);
	If Russian Then
		Return Left_ + " В (ВЫБРАТЬ " + RowAlias + "." + RefName + " ИЗ " + Info.Table + "."
			+ Info.Section + " КАК " + RowAlias + " ГДЕ " + StrConcat(Conditions, " И ") + ")";
	EndIf;
	Return Left_ + " IN (SELECT " + RowAlias + "." + RefName + " FROM " + Info.Table + "."
		+ Info.Section + " AS " + RowAlias + " WHERE " + StrConcat(Conditions, " AND ") + ")";

EndFunction

// Токены без скобок, охватывающих выражение целиком.
Function WithoutOuterParentheses(Tokens)

	Result = Tokens;
	While Result.Count() > 2 And Result[0].Value = "(" And Result[Result.Count() - 1].Value = ")" Do
		Depth = 0;
		Whole = True;
		For Position = 0 To Result.Count() - 1 Do
			If Result[Position].Value = "(" Then
				Depth = Depth + 1;
			ElsIf Result[Position].Value = ")" Then
				Depth = Depth - 1;
				If Depth = 0 And Position < Result.Count() - 1 Then
					Whole = False;
					Break;
				EndIf;
			EndIf;
		EndDo;
		If Not Whole Then
			Break;
		EndIf;
		Inner = New Array;
		For Position = 1 To Result.Count() - 2 Do
			Inner.Add(Result[Position]);
		EndDo;
		Result = Inner;
	EndDo;
	Return Result;

EndFunction

// Отрезки токенов между словами-разделителями верхнего уровня (вне скобок и ВЫБОР ... КОНЕЦ).
Function TopLevelSplits(Tokens, WordsList)

	Words = StrSplit(Upper(WordsList), ",");
	Spans = New Array;
	Depth = 0;
	Nesting = 0;
	Start = 0;
	For Position = 0 To Tokens.Count() - 1 Do
		Token = Tokens[Position];
		Value = Upper(Token.Value);
		If Token.Kind = "Symbol" And Value = "(" Then
			Depth = Depth + 1;
		ElsIf Token.Kind = "Symbol" And Value = ")" Then
			Depth = Depth - 1;
		ElsIf Token.Kind = "Name" And (Value = "CASE" Or Value = Upper("Выбор")) Then
			Nesting = Nesting + 1;
		ElsIf Token.Kind = "Name" And (Value = "END" Or Value = Upper("Конец")) Then
			Nesting = Nesting - 1;
		ElsIf Token.Kind = "Name" And Depth = 0 And Nesting = 0 And Words.Find(Value) <> Undefined Then
			Spans.Add(New Structure("From, Till", Start, Position - 1));
			Start = Position + 1;
		EndIf;
	EndDo;
	Spans.Add(New Structure("From, Till", Start, Tokens.Count() - 1));
	Return Spans;

EndFunction

Function OperatorGroupingSets(Operator, Context)

	Clauses = Undefined;
	If Context.Options.Property("GroupingSets") Then
		Clauses = Context.Options.GroupingSets;
	EndIf;
	If Clauses = Undefined Or Clauses.Count() = 0 Then
		Raise "GROUP BY GROUPING SETS was not found in the query text, while the query schema reports a"
			+ " grouping it does not describe.";
	EndIf;
	If Clauses.Count() = 1 Then
		Return Clauses[0];
	EndIf;
	Own = New Array;
	For Each Source In Operator.Sources Do
		For Each Table In AliasedSourceTables(Source) Do
			Own.Add(SourceAlias(Table));
		EndDo;
	EndDo;
	Matched = Undefined;
	MatchedKey = "";
	For Each Sets In Clauses Do
		Found = 0;
		Foreign = False;
		For Each Set In Sets Do
			For Each Item In Set Do
				For Each Token In Tokenize(Item) Do
					If Token.Kind = "Name" And StrFind(Token.Value, ".") > 0 Then
						If Own.Find(Upper(StrSplit(Token.Value, ".")[0])) = Undefined Then
							Foreign = True;
						Else
							Found = Found + 1;
						EndIf;
					EndIf;
				EndDo;
			EndDo;
		EndDo;
		If Foreign Or Found = 0 Then
			Continue;
		EndIf;
		SetsKey = GroupingSetsKey(Sets);
		If Matched <> Undefined And SetsKey <> MatchedKey Then
			Raise "GROUP BY GROUPING SETS: several clauses of the text fit this SELECT by their aliases,"
				+ " and which one it owns is not known - the query schema does not keep the sets. Give the"
				+ " SELECTs different aliases.";
		EndIf;
		Matched = Sets;
		MatchedKey = SetsKey;
	EndDo;
	If Matched = Undefined Then
		Raise "GROUP BY GROUPING SETS: no clause of the text refers only to the sources of this SELECT, and"
			+ " the query schema does not keep the sets.";
	EndIf;
	Return Matched;

EndFunction

Function GroupingSetsKey(Sets)

	Parts = New Array;
	For Each Set In Sets Do
		Parts.Add(Upper(StrConcat(Set, ",")));
	EndDo;
	Return StrConcat(Parts, ";");

EndFunction

// Группировки, которых в модели запроса нет. Замерено: коллекция Group у оператора
// пуста для СГРУППИРОВАТЬ ПО ВЫБОР ... КОНЕЦ и для СГРУППИРОВАТЬ ПО &Параметр, и
// GetQueryText такую группировку теряет. Узнать о ней можно только из текста, поэтому
// текст просматривается по токенам: это не разбор запроса, а поиск одного образца.
//
// То же с ПРЕДСТАВЛЕНИЕМ: модель его из группировок выбрасывает, а группирует платформа
// по самой ссылке.
//
// Возвращает соответствие «ключ выражения - счёт по тексту и операторы, которые его
// востребовали»: ключ - токены выражения через пробел, в верхнем регистре. Счёт:
//   Count    - сколько раз выражение сгруппировано;
//   Paired   - в скольких из этих случаев оно стоит полем в выборке того же ВЫБРАТЬ;
//   Bare     - в скольких у оператора нет ни других группировок, ни агрегата, то есть
//              в модели он ничем не отличается от несгруппированного;
//   Selected - сколько ВЫБРАТЬ во всём тексте выбирают это выражение полем;
//   Loose    - вхождения, которых нет в выборке своего ВЫБРАТЬ (LooseGrouping): их оператор
//              узнаёт себя по тексту, а не по полю выборки (LooseGroupings).
// О группировке по параметру сразу предупреждает.
Function BranchingGroups(Text, Warnings)

	Found = New Map;
	// Посимвольный разбор дорог, а группировка есть не в каждом запросе.
	Raised = Upper(Text);
	If StrFind(Raised, "GROUP") = 0 And StrFind(Raised, Upper("Сгруппировать")) = 0 Then
		Return Found;
	EndIf;
	Tokens = Tokenize(WithoutLineComments(Text));
	Stoppers = Upper("HAVING,ИМЕЮЩИЕ,ORDER,УПОРЯДОЧИТЬ,UNION,ОБЪЕДИНИТЬ,TOTALS,ИТОГИ,"
		+ "AUTOORDER,АВТОУПОРЯДОЧИВАНИЕ,FOR,ДЛЯ,INDEX,ИНДЕКСИРОВАТЬ,SELECT,ВЫБРАТЬ,"
		+ "DROP,УНИЧТОЖИТЬ");
	Stoppers = StrSplit(Stoppers, ",", False);

	Selects = Undefined;
	Index = 0;
	While Index < Tokens.Count() - 1 Do
		Word = ?(Tokens[Index].Kind = "Name", Upper(Tokens[Index].Value), "");
		Next = ?(Tokens[Index + 1].Kind = "Name", Upper(Tokens[Index + 1].Value), "");
		If Not ((Word = "GROUP" And Next = "BY")
			Or (Word = Upper("Сгруппировать") And Next = Upper("По"))) Then
			Index = Index + 1;
			Continue;
		EndIf;

		GroupIndex = Index;
		Index = Index + 2;
		Start = Index;
		Depth = 0;
		Nesting = 0;
		Selection = Undefined;
		Solid = False;
		Hit = New Array;
		Place = Undefined;
		Leading = True;
		While Index <= Tokens.Count() Do
			Closed = (Index = Tokens.Count());
			Split = False;
			If Not Closed Then
				Token = Tokens[Index];
				Value = Upper(Token.Value);
				If Token.Kind = "Symbol" Then
					If Value = "(" Then
						Depth = Depth + 1;
					ElsIf Value = ")" Then
						If Depth = 0 Then
							Closed = True;
						Else
							Depth = Depth - 1;
						EndIf;
					ElsIf Value = ";" Or Value = "{" Or Value = "}" Then
						Closed = True;
					ElsIf Value = "," And Depth = 0 And Nesting = 0 Then
						Split = True;
					EndIf;
				ElsIf Token.Kind = "Name" Then
					If Value = "CASE" Or Value = Upper("Выбор") Then
						Nesting = Nesting + 1;
					ElsIf Value = "END" Or Value = Upper("Конец") Then
						Nesting = Nesting - 1;
					ElsIf Depth = 0 And Nesting = 0 And Stoppers.Find(Value) <> Undefined Then
						Closed = True;
					EndIf;
				EndIf;
			EndIf;

			If Closed Or Split Then
				If Index - Start = 1 And Tokens[Start].Kind = "Parameter" Then
					AddOnce(Warnings, "GROUP BY &" + Tokens[Start].Value + " is dropped: a variable"
						+ " cannot be a grouping expression in SQL. Over a non-empty source the"
						+ " result is the same; over an empty one the SQL may return a single row"
						+ " where 1C returns none. If the code substitutes this parameter as a"
						+ " piece of query text, translate the query after the substitution.");
				ElsIf Index > Start And Tokens[Start].Kind = "Name"
					And Not IsBlankString(LostGroupingKind(Tokens[Start].Value)) Then
					ItemKey = TokensKey(Tokens, Start, Index - 1);
					Entry = Found.Get(ItemKey);
					If Entry = Undefined Then
						Entry = New Structure("Kind, Count, Paired, Bare, Selected, Operators, Loose",
							LostGroupingKind(Tokens[Start].Value), 0, 0, 0, 0, New Array, New Array);
						Found.Insert(ItemKey, Entry);
					EndIf;
					Entry.Count = Entry.Count + 1;
					If Selection = Undefined Then
						Selection = OwnSelection(Tokens, GroupIndex);
					EndIf;
					If SelectionHolds(Selection, ItemKey) Then
						Entry.Paired = Entry.Paired + 1;
						Leading = False;
					Else
						If Place = Undefined Then
							Place = OwnBranch(Tokens, GroupIndex);
						EndIf;
						Loose = LooseGrouping(Tokens, Start, Index - 1, Entry.Kind, Place, Leading);
						If Loose.Usable Then
							If Selects = Undefined Then
								Selects = SelectPlaces(Tokens);
							EndIf;
							Loose.Rivals = TextRivals(Selects, Loose);
						EndIf;
						Entry.Loose.Add(Loose);
					EndIf;
					Hit.Add(Entry);
				ElsIf Index > Start And Tokens[Start].Kind = "Name" Then
					// Группировка, которую модель хранит: по ней оператор виден как
					// сгруппированный. Число и строку она выбрасывает как константу.
					Solid = True;
					Leading = False;
				EndIf;
				Start = Index + 1;
			EndIf;
			If Closed Then
				If Hit.Count() > 0 And Not Solid And Not Selection.Aggregate Then
					For Each Entry In Hit Do
						Entry.Bare = Entry.Bare + 1;
					EndDo;
				EndIf;
				Break;
			EndIf;
			Index = Index + 1;
		EndDo;
	EndDo;

	// Сколько ВЫБРАТЬ во всём тексте выбирают выражение полем. Если столько же, сколько
	// раз оно сгруппировано, то выбирают его только сгруппированные операторы.
	If Found.Count() > 0 Then
		For Index = 0 To Tokens.Count() - 1 Do
			If Tokens[Index].Kind <> "Name" Or Not IsSelectWord(Tokens[Index].Value) Then
				Continue;
			EndIf;
			Selection = SelectionAt(Tokens, Index);
			For Each Item In Found Do
				If SelectionHolds(Selection, Item.Key) Then
					Item.Value.Selected = Item.Value.Selected + 1;
				EndIf;
			EndDo;
		EndDo;
	EndIf;

	Return Found;

EndFunction

// ЕСТЬNULL по ключу выражения (токены через пробел) с первым аргументом - полем типа УникальныйИдентификатор.
Function IsNullOverUuid(ItemKey, Context)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(ItemKey);
	Except
		Return False;
	EndTry;
	// Ключ выражения (TokensKey) - без скобок: первый аргумент идёт сразу за ЕСТЬNULL; текст со скобками - за «(».
	First = ?(Tokens.Count() > 1 And Tokens[1].Value = "(", 2, 1);
	If Tokens.Count() < First + 2 Or Tokens[First].Kind <> "Name" Or StrFind(Tokens[First].Value, ".") = 0 Then
		Return False;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Tokens[First].Value, Context);
	Except
		Return False;
	EndTry;
	Description = ResolvedTypeDescription(Resolved);
	Return Description <> Undefined And Description.ContainsType(Type("UUID"));

EndFunction

// Вид группировки, которую модель запроса не хранит, по первому слову выражения.
Function LostGroupingKind(Word)

	Raised = Upper(TrimAll(Word));
	If Raised = "CASE" Or Raised = Upper("Выбор") Then
		Return "Case";
	ElsIf Raised = "PRESENTATION" Or Raised = "REFPRESENTATION"
		Or Raised = Upper("Представление") Or Raised = Upper("ПредставлениеСсылки") Then
		Return "Presentation";
	ElsIf Raised = "ISNULL" Or Raised = Upper("ЕстьNull") Then
		// ЕСТЬNULL модель хранит не всегда: над ссылками - да, над уникальными идентификаторами - нет (замер
		// gb01-gb03, 22.11.2026, УХ). Возвращается только поле выборки; сохранённое моделью стоит в списке тем же
		// текстом и второй раз не добавляется. Проверка CheckBranchingGroups этот вид не касается.
		Return "IsNull";
	EndIf;
	Return "";

EndFunction

Function IsSelectWord(Word)

	Raised = Upper(Word);
	Return Raised = "SELECT" Or Raised = Upper("Выбрать");

EndFunction

// Список выборки того ВЫБРАТЬ, которому принадлежит группировка: ближайшего слева на
// том же уровне скобок. Фигурные скобки компоновки считаются наравне с круглыми.
Function OwnSelection(Tokens, GroupIndex)

	Depth = 0;
	Position = GroupIndex - 1;
	While Position >= 0 Do
		Token = Tokens[Position];
		If Token.Kind = "Symbol" Then
			If Token.Value = ")" Or Token.Value = "}" Then
				Depth = Depth + 1;
			ElsIf Token.Value = "(" Or Token.Value = "{" Then
				If Depth = 0 Then
					Break;
				EndIf;
				Depth = Depth - 1;
			ElsIf Token.Value = ";" And Depth = 0 Then
				Break;
			EndIf;
		ElsIf Depth = 0 And Token.Kind = "Name" And IsSelectWord(Token.Value) Then
			Return SelectionAt(Tokens, Position);
		EndIf;
		Position = Position - 1;
	EndDo;
	Return New Structure("Items, Aggregate", New Array, False);

EndFunction

// Поля выборки одного ВЫБРАТЬ - ключами выражений, вместе с псевдонимами, - и признак
// того, что среди них есть агрегат.
Function SelectionAt(Tokens, SelectIndex)

	Result = New Structure("Items, Aggregate", New Array, False);
	Stoppers = StrSplit(Upper("FROM,ИЗ,INTO,ПОМЕСТИТЬ,WHERE,ГДЕ,GROUP,СГРУППИРОВАТЬ,HAVING,"
		+ "ИМЕЮЩИЕ,ORDER,УПОРЯДОЧИТЬ,UNION,ОБЪЕДИНИТЬ,TOTALS,ИТОГИ,FOR,ДЛЯ,INDEX,"
		+ "ИНДЕКСИРОВАТЬ,SELECT,ВЫБРАТЬ,AUTOORDER,АВТОУПОРЯДОЧИВАНИЕ,DROP,УНИЧТОЖИТЬ"),
		",", False);
	Aggregates = StrSplit(Upper("SUM,СУММА,COUNT,КОЛИЧЕСТВО,MIN,МИНИМУМ,MAX,МАКСИМУМ,"
		+ "AVG,СРЕДНЕЕ"), ",", False);

	// Слова перед первым полем к нему не относятся.
	Index = SelectIndex + 1;
	While Index < Tokens.Count() And Tokens[Index].Kind = "Name" Do
		Word = Upper(Tokens[Index].Value);
		If Word = "DISTINCT" Or Word = Upper("Различные")
			Or Word = "ALLOWED" Or Word = Upper("Разрешенные") Then
			Index = Index + 1;
		ElsIf Word = "TOP" Or Word = Upper("Первые") Then
			Index = Index + 2;
		Else
			Break;
		EndIf;
	EndDo;

	Start = Index;
	Depth = 0;
	While Index <= Tokens.Count() Do
		Closed = (Index >= Tokens.Count());
		Split = False;
		If Not Closed Then
			Token = Tokens[Index];
			If Token.Kind = "Symbol" Then
				If Token.Value = "(" Or Token.Value = "{" Then
					Depth = Depth + 1;
				ElsIf Token.Value = ")" Or Token.Value = "}" Then
					If Depth = 0 Then
						Closed = True;
					Else
						Depth = Depth - 1;
					EndIf;
				ElsIf Token.Value = ";" Then
					Closed = True;
				ElsIf Token.Value = "," And Depth = 0 Then
					Split = True;
				EndIf;
			ElsIf Token.Kind = "Name" Then
				Word = Upper(Token.Value);
				Previous = ?(Index > Start And Tokens[Index - 1].Kind = "Name",
					Upper(Tokens[Index - 1].Value), "");
				If Depth = 0 And Stoppers.Find(Word) <> Undefined
					And Previous <> "AS" And Previous <> Upper("Как") Then
					Closed = True;
				ElsIf Aggregates.Find(Word) <> Undefined And Index + 1 < Tokens.Count()
					And Tokens[Index + 1].Value = "(" Then
					Result.Aggregate = True;
				EndIf;
			EndIf;
		EndIf;
		If Closed Or Split Then
			If Index > Start Then
				Result.Items.Add(TokensKey(Tokens, Start, Index - 1));
			EndIf;
			Start = Index + 1;
		EndIf;
		If Closed Then
			Break;
		EndIf;
		Index = Index + 1;
	EndDo;
	Return Result;

EndFunction

// Стоит ли выражение полем выборки целиком - с псевдонимом или без него. Вхождение
// внутрь другого выражения не считается: МИНИМУМ(ВЫБОР ...) группировки не требует.
Function SelectionHolds(Selection, ItemKey)

	For Each Item In Selection.Items Do
		If Item = ItemKey Then
			Return True;
		EndIf;
		If Not StrStartsWith(Item, ItemKey + " ") Then
			Continue;
		EndIf;
		Rest = StrSplit(Mid(Item, StrLen(ItemKey) + 2), " ", False);
		If Rest.Count() = 1
			Or (Rest.Count() = 2 And (Rest[0] = "AS" Or Rest[0] = Upper("Как"))) Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Место группировки в тексте: номер ветви объединения её ВЫБРАТЬ (сколько ОБЪЕДИНИТЬ стоит
// перед ним на том же уровне скобок) и стоит ли она в скобках - во вложенном запросе или
// подзапросе условия. Known = Ложь - группировка внутри фигурных скобок компоновки: чей это
// оператор, по тексту не сказать.
Function OwnBranch(Tokens, GroupIndex)

	Result = New Structure("Branch, Nested, Known", 0, False, True);
	Depth = 0;
	Position = GroupIndex - 1;
	While Position >= 0 Do
		Token = Tokens[Position];
		If Token.Kind = "Symbol" Then
			If Token.Value = ")" Or Token.Value = "}" Then
				Depth = Depth + 1;
			ElsIf Token.Value = "(" Or Token.Value = "{" Then
				If Depth = 0 Then
					Result.Nested = True;
					Result.Known = (Token.Value = "(");
					Return Result;
				EndIf;
				Depth = Depth - 1;
			ElsIf Token.Value = ";" And Depth = 0 Then
				Return Result;
			EndIf;
		ElsIf Depth = 0 And Token.Kind = "Name"
			And (Upper(Token.Value) = "UNION" Or Upper(Token.Value) = Upper("Объединить")) Then
			Result.Branch = Result.Branch + 1;
		EndIf;
		Position = Position - 1;
	EndDo;
	Return Result;

EndFunction

// Вхождение группировки, которого нет в выборке её ВЫБРАТЬ. Модель такую группировку то
// хранит, то теряет (замеры 20.11.2026, УХ: рядом с агрегатом - gc1 - в GROUP BY она есть, рядом
// с константой и ИМЕЮЩИЕ - gc2b - её нет), а пересобранный схемой текст подзапроса теряет её
// всегда. Поэтому выражение берётся из исходного текста, а оператор узнаётся по месту и по
// псевдонимам: Aliases - первые части имён с точкой, кроме имён в ЗНАЧЕНИЕ(...) и ТИП(...) и
// типа после КАК и ССЫЛКА. Rivals - сколько ВЫБРАТЬ текста стоят на том же месте и объявляют
// эти псевдонимы (TextRivals); Owners пополняет LooseGroupings подписями операторов, которым
// вхождение подходит; Failure - отказ перевода выражения у такого оператора.
Function LooseGrouping(Tokens, First, Last, Kind, Place, Leading)

	Result = New Structure("Text, Aliases, Branch, Nested, Leading, Usable, Rivals, Owners, Failure");
	Result.Rivals = 0;
	Result.Text = TokensText(Tokens, First, Last);
	Result.Aliases = New Array;
	Result.Branch = Place.Branch;
	Result.Nested = Place.Nested;
	Result.Leading = Leading;
	Result.Usable = Place.Known And Kind = "Case";
	Result.Owners = New Array;
	Result.Failure = "";

	Index = First;
	While Index <= Last Do
		Token = Tokens[Index];
		If Token.Kind <> "Name" Then
			Index = Index + 1;
			Continue;
		EndIf;
		Word = Upper(Token.Value);
		If IsSelectWord(Word) Or LostGroupingKind(Word) = "Presentation" Then
			// Подзапрос внутри выражения приносит псевдонимы чужого оператора; представление
			// платформа группирует по ссылке - переводить его как значение нельзя.
			Result.Usable = False;
		EndIf;
		If (Word = "VALUE" Or Word = Upper("Значение") Or Word = "TYPE" Or Word = Upper("Тип"))
			And Index < Last And Tokens[Index + 1].Value = "(" Then
			Index = MatchingParen(Tokens, Index + 1) + 1;
			Continue;
		EndIf;
		Previous = ?(Index > First And Tokens[Index - 1].Kind = "Name", Upper(Tokens[Index - 1].Value), "");
		If StrFind(Token.Value, ".") > 0 And Previous <> "AS" And Previous <> Upper("Как")
			And Previous <> "REFS" And Previous <> Upper("Ссылка") Then
			Alias = Upper(StrSplit(Token.Value, ".")[0]);
			If Result.Aliases.Find(Alias) = Undefined Then
				Result.Aliases.Add(Alias);
			EndIf;
		EndIf;
		Index = Index + 1;
	EndDo;
	If Result.Aliases.Count() = 0 Then
		Result.Usable = False;
	EndIf;
	Return Result;

EndFunction

// Место каждого ВЫБРАТЬ текста (OwnBranch) и псевдонимы, которые объявляет его ИЗ: имя после
// КАК на уровне самого ВЫБРАТЬ, от ИЗ до ГДЕ и прочих частей после источников.
Function SelectPlaces(Tokens)

	Ends = StrSplit(Upper("WHERE,ГДЕ,GROUP,СГРУППИРОВАТЬ,HAVING,ИМЕЮЩИЕ,ORDER,УПОРЯДОЧИТЬ,UNION,"
		+ "ОБЪЕДИНИТЬ,TOTALS,ИТОГИ,FOR,ДЛЯ,INDEX,ИНДЕКСИРОВАТЬ,SELECT,ВЫБРАТЬ"), ",", False);
	Result = New Array;
	For SelectIndex = 0 To Tokens.Count() - 1 Do
		If Tokens[SelectIndex].Kind <> "Name" Or Not IsSelectWord(Tokens[SelectIndex].Value) Then
			Continue;
		EndIf;
		Place = OwnBranch(Tokens, SelectIndex);
		Aliases = New Array;
		Depth = 0;
		InFrom = False;
		Position = SelectIndex + 1;
		While Position < Tokens.Count() Do
			Token = Tokens[Position];
			If Token.Kind = "Symbol" Then
				If Token.Value = "(" Or Token.Value = "{" Then
					Depth = Depth + 1;
				ElsIf Token.Value = ")" Or Token.Value = "}" Then
					If Depth = 0 Then
						Break;
					EndIf;
					Depth = Depth - 1;
				ElsIf Token.Value = ";" And Depth = 0 Then
					Break;
				EndIf;
			ElsIf Token.Kind = "Name" And Depth = 0 Then
				Word = Upper(Token.Value);
				If Word = "FROM" Or Word = Upper("Из") Then
					InFrom = True;
				ElsIf Ends.Find(Word) <> Undefined Then
					Break;
				ElsIf InFrom And (Word = "AS" Or Word = Upper("Как")) And Position + 1 < Tokens.Count()
					And Tokens[Position + 1].Kind = "Name" Then
					Aliases.Add(Upper(Tokens[Position + 1].Value));
				EndIf;
			EndIf;
			Position = Position + 1;
		EndDo;
		Place.Insert("Aliases", Aliases);
		Result.Add(Place);
	EndDo;
	Return Result;

EndFunction

// Сколько ВЫБРАТЬ текста могли бы владеть вхождением: то же место и все его псевдонимы объявлены.
// Сам владелец среди них всегда; ВЫБРАТЬ в фигурных скобках компоновки считается на любом месте.
Function TextRivals(Selects, Loose)

	Count = 0;
	For Each Place In Selects Do
		If Place.Known And (Place.Branch <> Loose.Branch Or Place.Nested <> Loose.Nested) Then
			Continue;
		EndIf;
		Declared = True;
		For Each Alias In Loose.Aliases Do
			If Place.Aliases.Find(Alias) = Undefined Then
				Declared = False;
				Break;
			EndIf;
		EndDo;
		If Declared Then
			Count = Count + 1;
		EndIf;
	EndDo;
	Return Count;

EndFunction

// Ключ выражения для сравнения текста запроса с текстом из модели: пробелы, переносы
// и регистр различать нельзя. Скобки тоже: модель снимает те, что не меняют порядка
// действий (замер: «А = (Б + В - Г)» она отдаёт как «А = Б + В - Г»).
Function TokensKey(Tokens, First, Last)

	Parts = New Array;
	For Index = First To Last Do
		If Tokens[Index].Kind = "Symbol"
			And (Tokens[Index].Value = "(" Or Tokens[Index].Value = ")") Then
			Continue;
		EndIf;
		Parts.Add(?(Tokens[Index].Kind = "Parameter", "&", "") + Upper(Tokens[Index].Value));
	EndDo;
	Return StrConcat(Parts, " ");

EndFunction

Function ExpressionKey(Text)

	Tokens = Tokenize(WithoutLineComments(Text));
	Return ?(Tokens.Count() = 0, "", TokensKey(Tokens, 0, Tokens.Count() - 1));

EndFunction

// Текст без строчных комментариев: лексер их не знает, а в тексте из модуля они есть.
// Два слэша внутри строкового литерала комментарием не являются.
Function WithoutLineComments(Text)

	If StrFind(Text, "//") = 0 Then
		Return Text;
	EndIf;

	Lines = StrSplit(Text, Chars.LF, True);
	InString = False;
	For LineIndex = 0 To Lines.Count() - 1 Do
		Line = Lines[LineIndex];
		Cut = 0;
		Position = 1;
		Length = StrLen(Line);
		While Position <= Length Do
			Char = Mid(Line, Position, 1);
			If Char = """" Then
				InString = Not InString;
			ElsIf Not InString And Char = "/" And Mid(Line, Position + 1, 1) = "/" Then
				Cut = Position;
				Break;
			EndIf;
			Position = Position + 1;
		EndDo;
		If Cut > 0 Then
			Lines[LineIndex] = Left(Line, Cut - 1);
		EndIf;
	EndDo;
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Группировка, которую модель не хранит и которую не удалось вернуть её оператору.
// Перевести её нельзя - модель не говорит, какому оператору она принадлежит, - а без неё
// число строк другое, и СУБД такой запрос исполнит без замечаний. Потерять её молча
// можно тремя способами, и все три видны по счёту:
// - выражения нет полем в выборке её собственного ВЫБРАТЬ, и по тексту её оператор не
//   находится однозначно (LooseGroupings) - а счёт сошёлся бы за счёт соседнего оператора,
//   выбирающего то же выражение;
// - операторов, узнавших выражение, меньше, чем группировок;
// - выражение выбирает ещё и несгруппированный оператор, а сгруппированный в модели от
//   него неотличим: нет ни агрегата, ни других группировок.
Procedure CheckBranchingGroups(Opt)

	If Opt.BranchingGroups = Undefined Or Opt.BatchTrimmed = True Then
		Return;
	EndIf;
	For Each Item In Opt.BranchingGroups Do
		Entry = Item.Value;
		If Entry.Kind = "IsNull" Then
			Continue;
		EndIf;
		// Вхождение вне выборки восстановлено, если ему подходит ровно один ВЫБРАТЬ текста и ровно
		// один оператор модели (по подписи: пробный перевод того же оператора её не меняет).
		// Настоящий владелец подходит всегда, поэтому второй претендент - сомнение, и тогда отказ.
		Restored = 0;
		For Each Loose In Entry.Loose Do
			If Not Loose.Usable Or Loose.Rivals <> 1 Or Loose.Owners.Count() <> 1 Then
				Continue;
			EndIf;
			If Not IsBlankString(Loose.Failure) Then
				Raise Loose.Failure;
			EndIf;
			Restored = Restored + 1;
		EndDo;
		If Entry.Paired + Restored < Entry.Count Or Entry.Operators.Count() < Entry.Count
			Or (Entry.Selected > Entry.Count And Entry.Bare > 0) Then
			Raise "GROUP BY holds a CASE or PRESENTATION expression that could not be attached"
				+ " to its SELECT: " + Left(Item.Key, 120) + ". The query model of the"
				+ " platform does not keep such a grouping; it is restored only where the"
				+ " same expression is a field of the same SELECT, or where the aliases and"
				+ " the union branch of the expression fit exactly one SELECT of the text."
				+ " Without it the query returns a different number of rows. Add the"
				+ " expression to the select list, or group by its fields.";
		EndIf;
	EndDo;

EndProcedure

// Запрос, написанный внутри обработки или отчёта, часто опирается на временные таблицы,
// созданные в другом вызове Запрос.Выполнить(), а иногда получает таблицу параметром.
// Сам по себе такой текст не является выполнимым запросом: недостающую часть даёт аналитик.
// Часть работы платформа делает не в СУБД: что-то достраивает в запросе перед
// отправкой, что-то считает уже над полученными строками. В сгенерированный SQL
// ничего из этого не попадает, и молчать об этом нельзя - запрос переводится успешно,
// а расхождение с результатом в 1С обнаружится уже в отчёте.
//
// Коллекций с этими частями у схемы запроса не видно, поэтому смотрим канонический
// текст, который отдаёт сама платформа: в нём ключевые слова приведены к единому виду.
Procedure WarnAboutPlatformOnlyParts(Schema, Warnings)

	Text = Upper(Schema.GetQueryText());

	For Each Line In StrSplit(Text, Chars.LF, False) Do
		Start = TrimAll(Line);
		If StrStartsWith(Start, "TOTALS") Or StrStartsWith(Start, Upper("ИТОГИ")) Then
			AddOnce(Warnings, "TOTALS is ignored: totals are post-processing done by the"
				+ " platform, there is no SQL counterpart."
				+ " The SQL returns the detailed rows only.");
		ElsIf StrStartsWith(Start, "FOR UPDATE") Or StrStartsWith(Start, Upper("ДЛЯ ИЗМЕНЕНИЯ")) Then
			// Замер sm_fu1, sm_fu2 (21.11.2026, УХ): вне транзакции платформа ничего для ДЛЯ ИЗМЕНЕНИЯ в SQL
			// не пишет - тот же SELECT без подсказок блокировки.
			AddOnce(Warnings, "FOR UPDATE is dropped: outside a transaction the platform writes nothing for it in"
				+ " the SQL either (measured), and the lock it takes inside a 1C transaction is not carried into"
				+ " this SQL.");
		ElsIf StrStartsWith(Start, "INDEX BY") Or StrStartsWith(Start, Upper("ИНДЕКСИРОВАТЬ ПО")) Then
			AddOnce(Warnings, "INDEX BY is ignored: a common table expression has no indexes."
				+ " The index the query counted on is not created, so check the plan"
				+ " if the temporary table is large.");
		EndIf;
	EndDo;

	If StrFind(Text, "AUTOORDER") > 0 Or StrFind(Text, Upper("АВТОУПОРЯДОЧИВАНИЕ")) > 0 Then
		AddOnce(Warnings, "AUTOORDER is ignored: the platform adds ordering by reference"
			+ " presentation there, and that happens outside the DBMS query."
			+ " The rows come back in a different order.");
	EndIf;

	// Блок в фигурных скобках - объявление пользовательских настроек динамического
	// списка: какие отборы и порядок разрешено задавать пользователю. Условие из него
	// платформа строит в тот момент, когда пользователь настроил отбор, поэтому в самом
	// запросе его нет и в SQL не будет. Тому, кто переносит запрос в отчётную систему,
	// отбор придётся задать там заново.
	If StrFind(Text, "{") > 0 Then
		AddOnce(Warnings, "User settings blocks in curly braces are ignored: they declare which"
			+ " filters and ordering a user may set in a dynamic list, and the platform builds"
			+ " the condition from them only when the user does. The SQL has no such condition.");
	EndIf;

	WarnAboutDataSeparation(Warnings);

EndProcedure

// Разделители данных платформа подставляет в запрос сама, по значению в сеансе.
// Здесь их нет: SQL обращается к таблице целиком. В разделённой конфигурации это
// означает строки всех областей данных, а не только своей.
Procedure WarnAboutDataSeparation(Warnings)

	Separators = New Array;
	Try
		Separate = Metadata.ObjectProperties.CommonAttributeDataSeparation.Separate;
		For Each Attribute In Metadata.CommonAttributes Do
			If Attribute.DataSeparation = Separate Then
				Separators.Add(Attribute.Name);
			EndIf;
		EndDo;
	Except
		// Состав свойств метаданных разнится по версиям платформы: если прочитать
		// не удалось, молчать всё равно нельзя.
		AddOnce(Warnings, "Could not check data separators of this configuration."
			+ " If it is separated, the SQL ignores the separators and returns rows"
			+ " of every data area.");
		Return;
	EndTry;

	If Separators.Count() > 0 Then
		AddOnce(Warnings, "Data separators are not applied: the configuration separates data by "
			+ StrConcat(Separators, ", ")
			+ ", the platform substitutes the session values itself, and the SQL does not."
			+ " It returns rows of every data area.");
	EndIf;

EndProcedure

// Подсказка к ошибке разбора, когда её причина - вход, которого в тексте нет. Схема
// запроса принимает неизвестную временную таблицу как источник без колонок и спотыкается
// уже на её поле («Field not found "ТТ.Поле"») - так отвергнута примерно треть текстов
// УХ и половина ERP WE, которые платформа «не разобрала» (перепись 49q, 19.11.2026).
// Пустая строка - ошибка не такая.
Function PlatformParseHint(Text, Description)

	Name = QuotedAfter(Description, "Field not found """);
	If IsBlankString(Name) Then
		Name = QuotedAfter(Description, "Поле не найдено """);
	EndIf;
	Table = "";
	If Not IsBlankString(Name) And StrFind(Name, ".") > 0 Then
		Table = SourceOfAlias(Text, StrSplit(Name, ".")[0]);
		If Table = ")" Then
			// Псевдоним вложенного запроса: его колонок платформа не знает, если он читает временную таблицу, которой
			// этот текст не создаёт.
			Table = UncreatedSourceTable(Text);
		EndIf;
	EndIf;
	If IsBlankString(Table) Then
		Table = QuotedAfter(Description, "Table not found """);
		If IsBlankString(Table) Then
			Table = QuotedAfter(Description, "Таблица не найдена """);
		EndIf;
	EndIf;
	If IsBlankString(Table) Then
		Return "";
	EndIf;
	If Left(Table, 1) = "&" Then
		Return StrTemplate("The query reads %1, a table passed as a parameter: it lives in the memory of 1C, and"
			+ " the DBMS cannot read it. Select from a table of the infobase instead.", Table);
	EndIf;
	If StrFind(Table, ".") > 0 Or CreatesTable(Text, Table) Then
		Return "";
	EndIf;
	Return StrTemplate("%1 is a temporary table that some other query creates - this text does not create it"
		+ " itself. Paste the query that fills %1 into the ""Missing queries"" field above and translate again.",
		Table);

EndFunction

// Первая таблица-источник без точки в имени (временная), которую текст читает, но не создаёт; пустая строка - нет такой.
Function UncreatedSourceTable(Text)

	Tokens = Tokenize(Text);
	For Index = 1 To Tokens.Count() - 1 Do
		Word = Upper(Tokens[Index - 1].Value);
		If Tokens[Index - 1].Kind <> "Name" Or (Word <> "FROM" And Word <> Upper("Из") And Word <> "JOIN"
			And Word <> Upper("Соединение")) Then
			Continue;
		EndIf;
		Token = Tokens[Index];
		If Token.Kind = "Name" And StrFind(Token.Value, ".") = 0 And Not CreatesTable(Text, Token.Value) Then
			Return Token.Value;
		EndIf;
	EndDo;
	Return "";

EndFunction

// Текст в кавычках сразу за Marker; пустая строка - маркера нет.
Function QuotedAfter(Text, Marker)

	Position = StrFind(Text, Marker);
	If Position = 0 Then
		Return "";
	EndIf;
	Rest = Mid(Text, Position + StrLen(Marker));
	Close = StrFind(Rest, """");
	Return ?(Close = 0, "", TrimAll(Left(Rest, Close - 1)));

EndFunction

// Источник, за которым в тексте объявлен псевдоним Alias: `Таблица КАК Alias`.
Function SourceOfAlias(Text, Alias)

	Tokens = Tokenize(Text);
	Wanted = Upper(TrimAll(Alias));
	For Index = 2 To Tokens.Count() - 1 Do
		Word = Upper(Tokens[Index - 1].Value);
		If (Word = "AS" Or Word = Upper("Как")) And Upper(Tokens[Index].Value) = Wanted Then
			Source = Tokens[Index - 2];
			Return ?(Source.Kind = "Parameter", "&" + Source.Value, Source.Value);
		EndIf;
	EndDo;
	Return "";

EndFunction

// В тексте есть `ПОМЕСТИТЬ Table` / `INTO Table`.
Function CreatesTable(Text, Table)

	Tokens = Tokenize(Text);
	Wanted = Upper(TrimAll(Table));
	For Index = 1 To Tokens.Count() - 1 Do
		Word = Upper(Tokens[Index - 1].Value);
		If (Word = "INTO" Or Word = Upper("Поместить")) And Upper(Tokens[Index].Value) = Wanted Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

Function CombinedQueryText(QueryText, Prologue)

	Names = PlacementNames(Prologue);
	Text = SubstituteTableParameters(QueryText, Names);

	Head = TrimAll(Prologue);
	If Not StrEndsWith(Head, ";") Then
		Head = Head + ";";
	EndIf;
	Return Head + Chars.LF + Text;

EndFunction

// Имена временных таблиц, которые создаёт дополненный текст.
Function PlacementNames(Prologue)

	Names = New Map;
	Tokens = Tokenize(Prologue);
	For Index = 0 To Tokens.Count() - 2 Do
		If Tokens[Index].Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Index].Value);
		If Word <> "INTO" And Word <> Upper("Поместить") Then
			Continue;
		EndIf;
		If Tokens[Index + 1].Kind = "Name" Then
			Names.Insert(Upper(TrimAll(Tokens[Index + 1].Value)), TrimAll(Tokens[Index + 1].Value));
		EndIf;
	EndDo;
	Return Names;

EndFunction

// Таблица, переданная параметром, заменяется одноимённой временной таблицей. Подмена
// делается только там, где стоит источник, чтобы не задеть параметр-значение с тем же именем.
Function SubstituteTableParameters(QueryText, Names)

	If Names.Count() = 0 Then
		Return QueryText;
	EndIf;

	Tokens = Tokenize(QueryText);
	Changed = False;
	For Index = 1 To Tokens.Count() - 1 Do
		Token = Tokens[Index];
		If Token.Kind <> "Parameter" Then
			Continue;
		EndIf;
		Name = Names.Get(Upper(TrimAll(Token.Value)));
		If Name = Undefined Or Not IsSourceKeyword(Tokens[Index - 1]) Then
			Continue;
		EndIf;
		Token.Kind = "Name";
		Token.Value = Name;
		Changed = True;
	EndDo;

	If Not Changed Then
		Return QueryText;
	EndIf;
	Return TokensText(Tokens, 0, Tokens.Count() - 1);

EndFunction

Function IsSourceKeyword(Token)

	If Token.Kind <> "Name" Then
		Return False;
	EndIf;
	Word = Upper(TrimAll(Token.Value));
	Return Word = "FROM" Or Word = Upper("Из")
		Or Word = "JOIN" Or Word = Upper("Соединение");

EndFunction

// Пакетный прогон конфигурации. Обходит отчёты и обработки, достаёт запросы из схем
// компоновки данных и переводит каждый. Нужен, когда в Power BI переносят не один
// запрос, а сотни отчётов: вставлять их на форму по одному нереально.
//
// Parameters:
//   Options - Structure - см. DefaultOptions. Undefined означает значения по умолчанию.
//   Kinds - String - "Reports", "DataProcessors" или "All".
//   NameFilter - String - подстрока имени объекта; пустая строка означает «все».
//
// Returns:
//   ValueTable - Object, Template, DataSet, Success, SQL, ErrorDescription, Warnings
//
Function TransformConfiguration(Options = Undefined, Kinds = "Reports", NameFilter = "") Export

	Result = New ValueTable;
	Result.Columns.Add("Object");
	Result.Columns.Add("Template");
	Result.Columns.Add("DataSet");
	Result.Columns.Add("Success");
	Result.Columns.Add("SQL");
	Result.Columns.Add("ErrorDescription");
	Result.Columns.Add("Warnings");

	Opt = ?(Options = Undefined, DefaultOptions(), Options);
	Wanted = Upper(TrimAll(NameFilter));

	Collections = New Array;
	If Kinds = "All" Or Kinds = "Reports" Then
		Collections.Add(Metadata.Reports);
	EndIf;
	If Kinds = "All" Or Kinds = "DataProcessors" Then
		Collections.Add(Metadata.DataProcessors);
	EndIf;

	For Each Collection In Collections Do
		For Each Owner In Collection Do
			If Not IsBlankString(Wanted) And StrFind(Upper(Owner.Name), Wanted) = 0 Then
				Continue;
			EndIf;
			CollectSchemaQueries(Result, Owner, Opt);
		EndDo;
	EndDo;

	Return Result;

EndFunction

// Запросы одного объекта: у него бывает несколько макетов со схемой компоновки.
Procedure CollectSchemaQueries(Result, Owner, Opt)

	For Each Template In Owner.Templates Do
		Schema = Undefined;
		Try
			Schema = SchemaOfTemplate(Owner, Template.Name);
		Except
			Continue;
		EndTry;
		If TypeOf(Schema) <> Type("DataCompositionSchema") Then
			Continue;
		EndIf;

		// Значение параметра бывает частью условия задачи: от видов субконто зависит
		// сам состав колонок виртуальной таблицы. Отчёт объявляет эти значения сам.
		Local = New Structure;
		For Each Item In Opt Do
			Local.Insert(Item.Key, Item.Value);
		EndDo;
		Local.Insert("ParameterValues", SchemaParameterValues(Schema, Opt));

		For Each DataSet In Schema.DataSets Do
			AddDataSetQueries(Result, Owner, Template, DataSet, Local);
		EndDo;
	EndDo;

EndProcedure

// Значения параметров, объявленные самой схемой компоновки. Заданное вызывающим
// кодом имеет приоритет: схема лишь дополняет то, чего он не задал.
Function SchemaParameterValues(Schema, Opt)

	Values = New Map;
	If Opt.Property("ParameterValues") And TypeOf(Opt.ParameterValues) = Type("Map") Then
		For Each Item In Opt.ParameterValues Do
			Values.Insert(Item.Key, Item.Value);
		EndDo;
	EndIf;

	For Each Parameter In Schema.Parameters Do
		Name = String(Parameter.Name);
		If Values.Get(Name) <> Undefined Then
			Continue;
		EndIf;
		Value = Undefined;
		Try
			Value = Parameter.Value;
		Except
			Continue;
		EndTry;
		If Value = Undefined Then
			Continue;
		EndIf;
		Values.Insert(Name, Value);
	EndDo;
	Return Values;

EndFunction

// Наборы данных бывают вложенными: объединение содержит внутри себя другие наборы.
Procedure AddDataSetQueries(Result, Owner, Template, DataSet, Opt)

	Nested = Undefined;
	Try
		Nested = DataSet.Items;
	Except
		Nested = Undefined;
	EndTry;
	If Nested <> Undefined Then
		For Each Item In Nested Do
			AddDataSetQueries(Result, Owner, Template, Item, Opt);
		EndDo;
		Return;
	EndIf;

	QueryText = "";
	Try
		QueryText = DataSet.Query;
	Except
		QueryText = "";
	EndTry;
	If IsBlankString(QueryText) Then
		Return;
	EndIf;

	Outcome = Transform(QueryText, Opt);

	Row = Result.Add();
	Row.Object = Owner.FullName();
	Row.Template = Template.Name;
	Row.DataSet = DataSet.Name;
	Row.Success = Outcome.Success;
	Row.SQL = Outcome.SQL;
	Row.ErrorDescription = Outcome.ErrorDescription;

	Warnings = New Array;
	For Each Item In Outcome.Warnings Do
		Warnings.Add(Item);
	EndDo;
	Declared = SchemaValuesUsed(QueryText, Opt);
	If Not IsBlankString(Declared) Then
		Warnings.Add(StrTemplate(
			"Values of these parameters are taken from the data composition schema: %1."
			+ " If the report sets them in code, the SQL follows the declared default, not what the"
			+ " report actually runs with - and for the list of extra dimension types the value decides"
			+ " the very set of columns.", Declared));
	EndIf;
	Row.Warnings = StrConcat(Warnings, Chars.LF);

EndProcedure

// Какие из объявленных схемой значений запрос действительно использует.
Function SchemaValuesUsed(QueryText, Opt)

	Names = New Array;
	If Not Opt.Property("ParameterValues") Or TypeOf(Opt.ParameterValues) <> Type("Map") Then
		Return "";
	EndIf;
	For Each Item In Opt.ParameterValues Do
		If StrFind(QueryText, "&" + Item.Key) > 0 Then
			Names.Add(Item.Key);
		EndIf;
	EndDo;
	Return StrConcat(Names, ", ");

EndFunction

// Макет берётся у объекта метаданных, а не у менеджера: имени менеджера по метаданным
// не построить, а вот у отчёта и обработки есть общий способ через ПолучитьМакет.
Function SchemaOfTemplate(Owner, TemplateName)

	Parts = StrSplit(Owner.FullName(), ".", False);
	Collection = ?(Upper(Parts[0]) = "REPORT" Or Upper(Parts[0]) = Upper("Отчет"),
		"Reports", "DataProcessors");
	Manager = Eval(Collection + "." + Parts[1]);
	Return Manager.GetTemplate(TemplateName);

EndFunction

// A query with placeholders does not run on its own: T-SQL wants the variables declared.
// The prologue makes the text self-contained, the analyst only fills in the values.
Function WithParameterPrologue(Sql, Schema, Opt, Warnings)

	If Opt.Dialect <> "MSSQL" Then
		Return Sql;
	EndIf;

	Values = New Map;
	If Opt.Property("ParameterValues") And TypeOf(Opt.ParameterValues) = Type("Map") Then
		Values = Opt.ParameterValues;
	EndIf;
	Context = NewContext(Opt, Warnings);

	// Тип, который схема знает сама, тоже участвует в переносе по связям: иначе параметр
	// с известным типом не может отдать его связанному. Замерено: у
	// `ВЫБОР КОГДА &Период < &ДатаНачалаУчета …` схема объявляет `&Период` датой, а
	// `&ДатаНачалаУчета` оставался BINARY(16) - перенос видел оба типа неизвестными.
	// BINARY(16) не засевается: это значение означает «схема не знает», и затирать им
	// выведенный тип нельзя.
	For Each Parameter In Schema.FindParameters() Do
		Known = SqlTypeOf(Parameter);
		If Known <> "BINARY(16)" Then
			RememberParameterType(String(Parameter.Name), Known, Context);
		EndIf;
	EndDo;

	ResolveParameterTypeLinks(Context);

	Declarations = New Array;
	Missing = 0;
	For Each Parameter In Schema.FindParameters() Do
		Name = TransliterateName(Parameter.Name);
		If StrFind(Sql, "@" + Name) = 0 Then
			Continue;
		EndIf;
		// Значение, заданное аналитиком или объявленное самой схемой компоновки, попадает
		// прямо в шапку: тогда запрос выполняется как есть, а править его надо в одном месте.
		Literal = "NULL";
		Value = Values.Get(String(Parameter.Name));
		Items = ParameterListItems(Value);
		If Items <> Undefined And Items.Count() = 1 Then
			Value = Items[0];
		ElsIf Items <> Undefined Then
			// Переменная держит одно значение, а список - несколько: шапка остаётся NULL.
			Value = Undefined;
			Warnings.Add(StrTemplate("Parameter %1 is a list of %2 values; a DECLARE variable holds one value, so the"
				+ " prologue leaves it NULL. Use SubstituteParameters to put the list into the SQL.", Parameter.Name,
				Format(Items.Count(), "NG=0; NZ=0")));
		EndIf;
		If Value <> Undefined Then
			Try
				Literal = ValueLiteral(Value, Context);
			Except
				Literal = "NULL";
			EndTry;
		EndIf;
		If Literal = "NULL" Then
			Missing = Missing + 1;
		EndIf;
		SqlType = SqlTypeOf(Parameter);
		If SqlType = "BINARY(16)" And Context.Options.Property("ParameterSqlTypes")
			And Context.Options.ParameterSqlTypes <> Undefined Then
			// Схема типа не знает - берём выведенный из сравнения, если он есть.
			Inferred = Context.Options.ParameterSqlTypes.Get(Upper(TrimAll(Parameter.Name)));
			If Inferred <> Undefined Then
				SqlType = Inferred;
			EndIf;
		EndIf;
		// Заданное значение решает вид объявления: выведенный тип - предположение. Было
		// `DECLARE @S DATETIME2 = N'none'` - ошибка 241, а пустая строка молча становилась
		// датой 1900-01-01. Вид совпал - остаётся выведенный тип, он точнее по длине.
		ValueType = ParameterValueSqlType(String(Parameter.Name), Context);
		If Not IsBlankString(ValueType) And SqlTypeKind(ValueType) <> SqlTypeKind(SqlType) Then
			SqlType = ValueType;
		EndIf;
		// Число платформа передаёт в типе по значению (замеры 7714, 7750, 7880-7883): NUMERIC(10)
		// у целого до десяти цифр, точный тип у дробного с девятью знаками и больше, иначе
		// NUMERIC(38, 8). Деление приводит переменную к нему само, шапка лишь не спорит с ним.
		If TypeOf(Value) = Type("Number") Then
			SqlType = OperandSqlType(ConstantOperand(Value, Context));
		EndIf;
		Declarations.Add("DECLARE @" + Name + " " + SqlType + " = " + Literal
			+ "; -- " + Parameter.Name);
	EndDo;

	If Declarations.Count() = 0 Then
		Return Sql;
	EndIf;

	If Missing > 0 Then
		Warnings.Add("Values are missing for " + Format(Missing, "NG=0; NZ=0")
			+ " parameter(s): the query carries a DECLARE header with NULL, fill it in or set the values above.");
	EndIf;
	Return StrConcat(Declarations, Chars.LF) + Chars.LF + Chars.LF + Sql;

EndFunction

Function SqlTypeOf(Parameter)

	Types = Undefined;
	Try
		Types = Parameter.ValueType.Types();
	Except
		Types = Undefined;
	EndTry;

	If Types = Undefined Or Types.Count() <> 1 Then
		Return "BINARY(16)";
	EndIf;

	Kind = Types[0];
	If Kind = Type("Date") Then
		Return "DATETIME2";
	ElsIf Kind = Type("Number") Then
		Return "NUMERIC(20, 8)";
	ElsIf Kind = Type("String") Then
		Return "NVARCHAR(500)";
	ElsIf Kind = Type("Boolean") Then
		Return "BINARY(1)";
	EndIf;
	Return "BINARY(16)";

EndFunction

// Типы параметров, которые схема знает сама, - те же, что шапка объявит первыми.
// BINARY(16) не входит: так SqlTypeOf говорит «не знаю».
Function SchemaParameterTypes(Schema)

	Types = New Map;
	For Each Parameter In Schema.FindParameters() Do
		Known = SqlTypeOf(Parameter);
		If Known <> "BINARY(16)" Then
			Types.Insert(Upper(TrimAll(Parameter.Name)), Known);
		EndIf;
	EndDo;
	Return Types;

EndFunction

// Diagnostic dump of what the platform made of the query. Used to investigate
// unsupported constructs without guessing.
Function DescribeSchema(QueryText) Export

	Report = New Array;
	Schema = New QuerySchema;
	Try
		Schema.SetQueryText(QueryText);
	Except
		Return ErrorDescription();
	EndTry;

	Report.Add("batch items: " + Schema.QueryBatch.Count());
	For BatchIndex = 0 To Schema.QueryBatch.Count() - 1 Do
		Query = Schema.QueryBatch[BatchIndex];
		Report.Add("[" + BatchIndex + "] " + TypeOf(Query));
		If Not IsSelectQuery(Query) Then
			Continue;
		EndIf;
		Report.Add("    columns: " + Query.Columns.Count() + ", operators: " + Query.Operators.Count()
			+ ", order: " + Query.Order.Count());
		For Each Operator In Query.Operators Do
			Report.Add("    operator: distinct=" + Operator.SelectDistinct
				+ " first=" + Operator.RetrievedRecordsCount
				+ " sources=" + Operator.Sources.Count()
				+ " fields=" + Operator.SelectedFields.Count()
				+ " filter=" + Operator.Filter.Count()
				+ " group=" + GroupCount(Operator));
			For Each Source In Operator.Sources Do
				Report.Add("        source: " + TypeOf(Source.Source) + " joins=" + Source.Joins.Count());
			EndDo;
		EndDo;
	EndDo;

	Return StrConcat(Report, Chars.LF);

EndFunction

#EndRegion

#Region Private

#Region StorageStructure

// Builds and caches the logical -> physical name map of the current infobase.
// Column names of the returned table follow the configuration script variant,
// so they are resolved by trying both variants.
Function StorageStructure()

	If StorageCache <> Undefined Then
		Return StorageCache;
	EndIf;

	Info = GetDBStorageStructureInfo(New Array, True);

	PhysicalColumn = ColumnIndex(Info.Columns, "StorageTableName", "ИмяТаблицыХранения");
	LogicalColumn = ColumnIndex(Info.Columns, "TableName", "ИмяТаблицы");
	PurposeColumn = ColumnIndex(Info.Columns, "Purpose", "Назначение");
	FieldsColumn = ColumnIndex(Info.Columns, "Fields", "Поля");
	MetadataColumn = -1;
	Try
		MetadataColumn = ColumnIndex(Info.Columns, "Metadata", "Метаданные");
	Except
		MetadataColumn = -1;
	EndTry;

	Tables = New Map;
	For Each Row In Info Do
		LogicalName = TrimAll(Row[LogicalColumn]);
		// Таблицы итогов по счетам и настроек итогов регистра бухгалтерии: владельца называет колонка
		// «Метаданные», имя таблицы у них своё или пустое.
		TotalsRole = AccountingTotalsRole(TrimAll(Row[PhysicalColumn]));
		If Not IsBlankString(TotalsRole) And MetadataColumn >= 0
			And Not IsBlankString(TrimAll(String(Row[MetadataColumn]))) Then
			LogicalName = TrimAll(String(Row[MetadataColumn]));
		EndIf;
		If IsBlankString(LogicalName) Then
			// Таблица фактических периодов действия регистра расчёта логического имени не
			// имеет, а принадлежит регистру по колонке «Метаданные» (УХ: _CRgActP1901 у
			// РегистрРасчета.Начисления, назначение «ПериодыДействия»).
			Purpose = Upper(TrimAll(String(Row[PurposeColumn])));
			If MetadataColumn >= 0 And (Purpose = "ACTIONPERIODS" Or Purpose = Upper("ПериодыДействия")) Then
				Physicals = New Array;
				FieldsTable = Row[FieldsColumn];
				PhysicalFieldColumn = ColumnIndex(FieldsTable.Columns, "StorageFieldName", "ИмяПоляХранения");
				For Each FieldRow In FieldsTable Do
					Physicals.Add(TrimAll(FieldRow[PhysicalFieldColumn]));
				EndDo;
				// Полный описатель: карту таблиц перебирают и другие места, и у каждой записи
				// они ждут все свойства (ворота 79: «Object field not found (Purpose)»).
				Periods = New Structure;
				Periods.Insert("LogicalName", ActionPeriodsKey(TrimAll(String(Row[MetadataColumn]))));
				Periods.Insert("PhysicalName", TrimAll(Row[PhysicalColumn]));
				Periods.Insert("Purpose", TrimAll(String(Row[PurposeColumn])));
				Periods.Insert("Fields", New Map);
				Periods.Insert("Columns", New Map);
				Periods.Insert("Names", New Map);
				Periods.Insert("Unnamed", New Array);
				Periods.Insert("IsDerived", False);
				Periods.Insert("Subquery", "");
				Periods.Insert("Physicals", Physicals);
				Tables.Insert(Periods.LogicalName, Periods);
			EndIf;
			Continue;
		EndIf;

		Purpose = TrimAll(String(Row[PurposeColumn]));
		TableKey = Upper(LogicalName);
		// Таблица точек маршрута бизнес-процесса (_BPrPoints<N>) приходит под именем самого процесса и
		// уступала ему ключ, а номер типа точки - её собственный (замер sm_rp5: _Point_RTRef = 0x1F при
		// _BusinessProcess30). Отдельный ключ, как у таблицы периодов действия.
		// Своё имя таблицы (БизнесПроцесс.X.Точки, ворота 89: cv11 - «has no physical storage») остаётся её ключом,
		// ключ точек маршрута добавляется вторым; под одним именем процесса - только ключ точек.
		RouteKey = "";
		If StrStartsWith(Upper(TrimAll(Row[PhysicalColumn])), "_BPRPOINTS") Then
			NameParts = StrSplit(LogicalName, ".", False);
			If NameParts.Count() >= 2 Then
				RouteKey = RoutePointsKey(NameParts[1]);
				If NameParts.Count() = 2 Then
					TableKey = RouteKey;
					LogicalName = TableKey;
				EndIf;
			EndIf;
		EndIf;
		// Итоги по счетам (_AccRgAT<N>…) и настройки итогов (_AccRgOpt…) приходят под именем самого
		// регистра и уступали ему ключ. По строкам итогов платформа отдаёт свёрнутый остаток одной
		// стороны (OneSidedBalanceUnion) - отдельный ключ, как у таблицы периодов действия.
		If Not IsBlankString(TotalsRole) Then
			TableKey = AccountingTotalsKey(LogicalName, TotalsRole);
			LogicalName = TableKey;
		EndIf;
		Existing = Tables.Get(TableKey);
		If Existing <> Undefined And Not IsMainPurpose(Purpose) Then
			Continue;
		EndIf;

		FieldsTable = Row[FieldsColumn];
		PhysicalFieldColumn = ColumnIndex(FieldsTable.Columns, "StorageFieldName", "ИмяПоляХранения");
		LogicalFieldColumn = ColumnIndex(FieldsTable.Columns, "FieldName", "ИмяПоля");

		Fields = New Map;
		Columns = New Map;
		Names = New Map;
		Unnamed = New Array;
		For Each FieldRow In FieldsTable Do
			FieldName = TrimAll(FieldRow[LogicalFieldColumn]);
			If IsBlankString(FieldName) Then
				// Слоты субконто регистра бухгалтерии приходят без логических имён,
				// а обращаться к ним надо - держим их отдельным списком.
				Unnamed.Add(TrimAll(FieldRow[PhysicalFieldColumn]));
				Continue;
			EndIf;
			Physical = TrimAll(FieldRow[PhysicalFieldColumn]);
			Fields.Insert(Upper(FieldName), Physical);
			Names.Insert(Upper(FieldName), FieldName);
			ColumnList = Columns.Get(Upper(FieldName));
			If ColumnList = Undefined Then
				ColumnList = New Array;
				Columns.Insert(Upper(FieldName), ColumnList);
			EndIf;
			ColumnList.Add(Physical);
		EndDo;

		Descriptor = New Structure;
		Descriptor.Insert("LogicalName", LogicalName);
		Descriptor.Insert("PhysicalName", TrimAll(Row[PhysicalColumn]));
		Descriptor.Insert("Purpose", Purpose);
		Descriptor.Insert("Fields", Fields);
		Descriptor.Insert("Columns", Columns);
		Descriptor.Insert("Names", Names);
		Descriptor.Insert("Unnamed", Unnamed);
		Descriptor.Insert("IsDerived", False);
		Descriptor.Insert("Subquery", "");
		If Not IsBlankString(TotalsRole) Then
			// Колонки по порядку хранения: оборот ресурса стоит следом за самим ресурсом.
			Physicals = New Array;
			For Each FieldRow In FieldsTable Do
				Physicals.Add(TrimAll(FieldRow[PhysicalFieldColumn]));
			EndDo;
			Descriptor.Insert("Physicals", Physicals);
		EndIf;
		Tables.Insert(TableKey, Descriptor);
		If Not IsBlankString(RouteKey) And RouteKey <> TableKey And Tables.Get(RouteKey) = Undefined Then
			Tables.Insert(RouteKey, Descriptor);
		EndIf;
	EndDo;

	StorageCache = Tables;
	Return StorageCache;

EndFunction

// Ключ таблицы точек маршрута бизнес-процесса в StorageStructure (по имени процесса).
Function RoutePointsKey(ProcessName)
	Return "#ROUTEPOINTS:" + Upper(TrimAll(ProcessName));
EndFunction

Function IsRoutePointSegment(Segment)
	Normalized = Upper(TrimAll(Segment));
	Return Normalized = "ROUTEPOINT" Or Normalized = Upper("ТочкаМаршрута");
EndFunction

// Роль таблицы регистра бухгалтерии по физическому имени: "AT0".."AT3" - итоги по счетам без
// субконто и с N субконто, "OPT" - настройки итогов, пустая строка - прочие таблицы.
Function AccountingTotalsRole(Physical)

	Normalized = Upper(TrimAll(Physical));
	If StrStartsWith(Normalized, "_ACCRGOPT") Then
		Return "OPT";
	EndIf;
	If StrStartsWith(Normalized, "_ACCRGAT") And StrLen(Normalized) > 9
		And StrFind("0123", Mid(Normalized, 9, 1)) > 0 Then
		Return "AT" + Mid(Normalized, 9, 1);
	EndIf;
	Return "";

EndFunction

// Ключ таблицы итогов или настроек итогов регистра бухгалтерии в StorageStructure.
Function AccountingTotalsKey(RegisterName, Role)
	Return "#ACCOUNTINGTOTALS:" + Role + ":" + Upper(TrimAll(RegisterName));
EndFunction

// Ключ таблицы периодов действия регистра расчёта в StorageStructure: у неё нет логического
// имени, и ключ не пересекается с именами таблиц.
Function ActionPeriodsKey(RegisterName)
	Return "#ACTIONPERIODS:" + Upper(TrimAll(RegisterName));
EndFunction

Function IsMainPurpose(Purpose)
	Normalized = Upper(TrimAll(Purpose));
	Return Normalized = "MAIN" Or Normalized = Upper("Основная");
EndFunction

Function ColumnIndex(Columns, EnglishName, RussianName)

	Column = Columns.Find(EnglishName);
	If Column = Undefined Then
		Column = Columns.Find(RussianName);
	EndIf;
	If Column = Undefined Then
		Raise StrTemplate("Column %1 is missing in the database storage structure.", EnglishName);
	EndIf;
	Return Columns.IndexOf(Column);

EndFunction

// Имена коллекций метаданных двуязычны: Справочник и Catalog - одно и то же.
// Карта хранения отдаёт их на языке конфигурации, а в запросе может стоять любой
// вариант, поэтому перед поиском имя приводится ко второму языку, если первый
// не нашёлся. Замерено: ТИП(Справочник.X) в англоязычной конфигурации падал,
// а ТИП(Catalog.X) работал - то же самое зеркально в русской.
Function CollectionSynonyms()

	Map = New Map;
	Pairs = New Array;
	Pairs.Add("CATALOG|СПРАВОЧНИК");
	Pairs.Add("DOCUMENT|ДОКУМЕНТ");
	Pairs.Add("ENUM|ПЕРЕЧИСЛЕНИЕ");
	Pairs.Add("CONSTANT|КОНСТАНТА");
	Pairs.Add("INFORMATIONREGISTER|РЕГИСТРСВЕДЕНИЙ");
	Pairs.Add("ACCUMULATIONREGISTER|РЕГИСТРНАКОПЛЕНИЯ");
	Pairs.Add("ACCOUNTINGREGISTER|РЕГИСТРБУХГАЛТЕРИИ");
	Pairs.Add("CALCULATIONREGISTER|РЕГИСТРРАСЧЕТА");
	Pairs.Add("CHARTOFACCOUNTS|ПЛАНСЧЕТОВ");
	Pairs.Add("CHARTOFCHARACTERISTICTYPES|ПЛАНВИДОВХАРАКТЕРИСТИК");
	Pairs.Add("CHARTOFCALCULATIONTYPES|ПЛАНВИДОВРАСЧЕТА");
	Pairs.Add("BUSINESSPROCESS|БИЗНЕСПРОЦЕСС");
	Pairs.Add("TASK|ЗАДАЧА");
	Pairs.Add("EXCHANGEPLAN|ПЛАНОБМЕНА");
	Pairs.Add("DOCUMENTJOURNAL|ЖУРНАЛДОКУМЕНТОВ");
	Pairs.Add("SEQUENCE|ПОСЛЕДОВАТЕЛЬНОСТЬ");
	Pairs.Add("EXTERNALDATASOURCE|ВНЕШНИЙИСТОЧНИКДАННЫХ");

	For Each Pair In Pairs Do
		Parts = StrSplit(Pair, "|", False);
		Map.Insert(Parts[0], Parts[1]);
		Map.Insert(Parts[1], Parts[0]);
	EndDo;
	Return Map;

EndFunction

// Критерий отбора в запросе - таблица КритерийОтбора.Имя(<значение>) с одним полем Ссылка.
// Замерено (fk, 8.3.24): платформа строит производную таблицу - объединение выборок ссылки
// из объектов состава критерия, где поле равно значению. Ветвь входит в объединение, только
// если тип поля допускает тип значения, поэтому текст SQL зависит от значения параметра.
// Реквизит табличной части проверяется через EXISTS по её строкам; ветви одного объекта
// соединены UNION, разных - UNION ALL, так что каждая ссылка в результате одна.
// Перевод подставляет вместо критерия такой же вложенный запрос и разбирает текст заново.
Function MentionsFilterCriterion(Text)

	Raised = Upper(Text);
	Return StrFind(Raised, "FILTERCRITERION.") > 0 Or StrFind(Raised, Upper("КритерийОтбора.")) > 0;

EndFunction

Function WithFilterCriteriaExpanded(Text, Opt, Schema)

	Expanded = FilterCriteriaExpansion(Text, Opt, False, False);
	If Expanded = Text Then
		Return Text;
	EndIf;

	// Псевдоним колонки вложенного запроса - имя, которым внешний запрос читает поле
	// Ссылка: сначала на языке имени критерия, при неудаче разбора - на другом. Тип ссылки
	// у платформы - все объекты состава, а у вложенного запроса - только выбранные ветви;
	// если внешний запрос читает через точку поле, которого у выбранных объектов нет,
	// остальные объекты добавляются пустыми ветвями (ГДЕ ЛОЖЬ) - строк они не дают.
	Problem = "";
	Flags = New Array;
	Flags.Add(False);
	Flags.Add(True);
	For Each Full In Flags Do
		For Each Flip In Flags Do
			Attempt = FilterCriteriaExpansion(Text, Opt, Flip, Full);
			Candidate = New QuerySchema;
			Try
				Candidate.SetQueryText(Attempt);
			Except
				If IsBlankString(Problem) Then
					Problem = ErrorDescription();
				EndIf;
				Continue;
			EndTry;
			Schema = Candidate;
			Return Attempt;
		EndDo;
	EndDo;
	Raise "The filter criterion was replaced by the union over its content, the way the platform"
		+ " builds it, and the platform could not parse the result:" + Chars.LF + Problem;

EndFunction

// Текст, где каждое вхождение КритерийОтбора.Имя(...) заменено вложенным запросом.
// Строковые литералы и строчные комментарии пропускаются. FlipAlias - имя колонки
// на другом языке, чем имя критерия; Full - с пустыми ветвями объектов вне отбора.
Function FilterCriteriaExpansion(Text, Opt, FlipAlias, Full)

	Parts = New Array;
	Length = StrLen(Text);
	Position = 1;
	Copied = 1;
	While Position <= Length Do
		Char = Mid(Text, Position, 1);
		If Char = """" Then
			Position = Position + 1;
			While Position <= Length Do
				If Mid(Text, Position, 1) = """" Then
					If Mid(Text, Position + 1, 1) = """" Then
						Position = Position + 2;
						Continue;
					EndIf;
					Break;
				EndIf;
				Position = Position + 1;
			EndDo;
			Position = Position + 1;
			Continue;
		EndIf;
		If Char = "/" And Mid(Text, Position + 1, 1) = "/" Then
			While Position <= Length And Mid(Text, Position, 1) <> Chars.LF Do
				Position = Position + 1;
			EndDo;
			Continue;
		EndIf;
		If Not IsNameChar(Char) Then
			Position = Position + 1;
			Continue;
		EndIf;

		Start = Position;
		While Position <= Length Do
			NextChar = Mid(Text, Position, 1);
			If IsNameChar(NextChar) Or IsDigit(NextChar) Or NextChar = "." Then
				Position = Position + 1;
			Else
				Break;
			EndIf;
		EndDo;
		Before = ?(Start = 1, "", Mid(Text, Start - 1, 1));
		If Before = "&" Or Before = "." Or IsDigit(Before) Then
			Continue;
		EndIf;
		Word = Mid(Text, Start, Position - Start);
		Segments = StrSplit(Word, ".", True);
		If Segments.Count() <> 2 Then
			Continue;
		EndIf;
		Head = Upper(Segments[0]);
		If Head <> "FILTERCRITERION" And Head <> Upper("КритерийОтбора") Then
			Continue;
		EndIf;

		Open = Position;
		While Open <= Length And StrFind(" " + Chars.Tab + Chars.CR + Chars.LF, Mid(Text, Open, 1)) > 0 Do
			Open = Open + 1;
		EndDo;
		If Mid(Text, Open, 1) <> "(" Then
			Continue;
		EndIf;
		Close = FilterCriterionArgumentEnd(Text, Open);
		If Close = 0 Then
			Continue;
		EndIf;

		English = (Head = "FILTERCRITERION");
		If FlipAlias Then
			English = Not English;
		EndIf;
		Argument = TrimAll(Mid(Text, Open + 1, Close - Open - 1));
		Parts.Add(Mid(Text, Copied, Start - Copied));
		Parts.Add("(" + FilterCriterionQueryText(Segments[1], Argument, Word, English, Full, Opt) + ")");
		Copied = Close + 1;
		Position = Close + 1;
	EndDo;
	Parts.Add(Mid(Text, Copied));
	Return StrConcat(Parts, "");

EndFunction

// Позиция скобки, закрывающей открытую в Open; 0 - не закрыта.
Function FilterCriterionArgumentEnd(Text, Open)

	Depth = 0;
	Length = StrLen(Text);
	Position = Open;
	InString = False;
	While Position <= Length Do
		Char = Mid(Text, Position, 1);
		If Char = """" Then
			InString = Not InString;
		ElsIf Not InString And Char = "(" Then
			Depth = Depth + 1;
		ElsIf Not InString And Char = ")" Then
			Depth = Depth - 1;
			If Depth = 0 Then
				Return Position;
			EndIf;
		EndIf;
		Position = Position + 1;
	EndDo;
	Return 0;

EndFunction

Function FilterCriterionQueryText(Name, Argument, Written, English, Full, Opt)

	Criterion = Metadata.FilterCriteria.Find(Name);
	If Criterion = Undefined Then
		Raise StrTemplate("Filter criterion %1 is not found in the metadata of this infobase.", Written);
	EndIf;

	ParameterName = "";
	If StrLen(Argument) > 1 And Left(Argument, 1) = "&" Then
		ParameterName = Mid(Argument, 2);
		For Index = 1 To StrLen(ParameterName) Do
			Char = Mid(ParameterName, Index, 1);
			If Not IsNameChar(Char) And Not IsDigit(Char) Then
				ParameterName = "";
				Break;
			EndIf;
		EndDo;
	EndIf;
	If IsBlankString(ParameterName) Then
		Raise StrTemplate("%1(%2): the value of a filter criterion is translated only when it is a"
			+ " parameter, %1(&Value): which fields of the criterion content go into the union depends"
			+ " on the type of the value, and the value is read from ParameterValues.", Written, Argument);
	EndIf;

	Value = FilterCriterionParameterValue(ParameterName, Opt);
	If Value = Undefined Then
		Raise StrTemplate("%1(&%2): the platform builds the filter criterion as a union over its"
			+ " content and puts in only the fields whose type admits the type of the value of"
			+ " parameter &%2, so the SQL depends on that value. Pass the value of &%2 in"
			+ " ParameterValues and translate again.", Written, ParameterName);
	EndIf;
	ValueType = TypeOf(Value);
	If ValueType = Type("Array") Or ValueType = Type("FixedArray") Or ValueType = Type("ValueList")
		Or ValueType = Type("Null") Then
		Raise StrTemplate("%1(&%2): the value of &%2 is %3, and how the platform selects a filter"
			+ " criterion by such a value is not measured. Pass a single value.", Written, ParameterName,
			String(ValueType));
	EndIf;
	RefName = ?(English, "Ref", "Ссылка");
	// Ветви одного объекта платформа соединяет UNION, разных объектов - UNION ALL (замер fk):
	// объект, где значение стоит в двух полях состава, попадает в результат один раз.
	Owners = New Array;
	OwnerNames = New Map;
	BranchesOf = New Map;
	For Each Item In Criterion.Content Do
		FullName = Item.FullName();
		Segments = StrSplit(FullName, ".", True);
		If Segments.Count() = 4 Then
			Owner = Segments[0] + "." + Segments[1];
			Field = Segments[3];
			Rows = "";
		ElsIf Segments.Count() = 6 Then
			Owner = Segments[0] + "." + Segments[1];
			Field = Segments[5];
			Rows = Owner + "." + Segments[3];
		Else
			Raise StrTemplate("Filter criterion %1 holds %2 in its content, and a content item of this"
				+ " kind is not measured. Select from the objects of the content directly.", Written, FullName);
		EndIf;
		If OwnerNames.Get(Upper(Owner)) = Undefined Then
			OwnerNames.Insert(Upper(Owner), Owner);
			Owners.Add(Upper(Owner));
		EndIf;
		If Not Item.Type.ContainsType(ValueType) Then
			Continue;
		EndIf;
		If IsBlankString(Rows) Then
			Condition = StrTemplate("FilterCriterionContent.%1 = &%2", Field, ParameterName);
		Else
			Condition = StrTemplate("FilterCriterionContent.Ref IN (SELECT FilterCriterionRows.Ref"
				+ " FROM %1 AS FilterCriterionRows WHERE FilterCriterionRows.%2 = &%3)", Rows, Field,
				ParameterName);
		EndIf;
		Same = BranchesOf.Get(Upper(Owner));
		If Same = Undefined Then
			Same = New Array;
			BranchesOf.Insert(Upper(Owner), Same);
		EndIf;
		Same.Add(StrTemplate("SELECT FilterCriterionContent.Ref AS %1 FROM %2 AS FilterCriterionContent"
			+ " WHERE %3", RefName, Owner, Condition));
	EndDo;
	If Owners.Count() = 0 Then
		Raise StrTemplate("Filter criterion %1 has an empty content.", Written);
	EndIf;
	// Замерено (fk): значение, которого не допускает ни одно поле состава (ссылка другого
	// справочника, число), платформа не сравнивает, а отказывает: «Type mismatch (parameter
	// number "1")». Решает тип полей состава: ссылку на приобретение допускают только поля
	// табличных частей ДокументыВНАПоОснованию, и платформа строит ветви по ним.
	If BranchesOf.Count() = 0 Then
		Raise StrTemplate("%1(&%2): no field of the content of filter criterion %3 admits the value of"
			+ " &%2 (%4), and the platform refuses such a query: ""Type mismatch (parameter number ""1"")"".",
			Written, ParameterName, Criterion.Name, String(ValueType));
	EndIf;

	Branches = New Array;
	For Each OwnerKey In Owners Do
		Same = BranchesOf.Get(OwnerKey);
		If Same <> Undefined Then
			Branches.Add(StrConcat(Same, Chars.LF + "UNION" + Chars.LF));
		EndIf;
	EndDo;
	If Full Then
		For Each OwnerKey In Owners Do
			If BranchesOf.Get(OwnerKey) = Undefined Then
				Branches.Add(StrTemplate("SELECT FilterCriterionContent.Ref AS %1 FROM %2 AS FilterCriterionContent"
					+ " WHERE FALSE", RefName, OwnerNames.Get(OwnerKey)));
			EndIf;
		EndDo;
	EndIf;
	Return StrConcat(Branches, Chars.LF + "UNION ALL" + Chars.LF);

EndFunction

// Значение параметра из ParameterValues; имя параметра в запросе к регистру нечувствительно.
Function FilterCriterionParameterValue(Name, Opt)

	If Not Opt.Property("ParameterValues") Or TypeOf(Opt.ParameterValues) <> Type("Map") Then
		Return Undefined;
	EndIf;
	Value = Opt.ParameterValues.Get(Name);
	If Value <> Undefined Then
		Return Value;
	EndIf;
	For Each Item In Opt.ParameterValues Do
		If Upper(TrimAll(String(Item.Key))) = Upper(Name) Then
			Return Item.Value;
		EndIf;
	EndDo;
	Return Undefined;

EndFunction

Function TableDescriptor(LogicalName)

	Upper_ = Upper(TrimAll(LogicalName));
	Descriptor = StorageStructure().Get(Upper_);

	If Descriptor = Undefined And StrFind(Upper_, ".") > 0 Then
		Parts = StrSplit(Upper_, ".", True);
		Other = CollectionSynonyms().Get(Parts[0]);
		If Other <> Undefined Then
			Parts[0] = Other;
			Descriptor = StorageStructure().Get(StrConcat(Parts, "."));
		EndIf;
	EndIf;

	If Descriptor = Undefined Then
		// Имя без точки объектом метаданных быть не может: это временная таблица,
		// которую создаёт другой запрос отчёта. Подсказка тут другая, и она важнее
		// всех прочих - на этот случай приходится треть всех отказов.
		If StrFind(LogicalName, ".") = 0 Then
			Raise StrTemplate(
				"%1 is a temporary table that some other query creates - this text does not create it itself."
				+ " Paste the query that fills %1 into the ""Missing queries"" field above and translate again.",
				TrimAll(LogicalName));
		EndIf;
		Head = Upper(StrSplit(LogicalName, ".", False)[0]);
		If Head = "FILTERCRITERION" Or Head = Upper("КритерийОтбора") Then
			Raise StrTemplate("%1 is a filter criterion without a value: such a table is the list form of the"
				+ " criterion, and the form substitutes the value it was opened with. Which fields of the"
				+ " criterion content go into the union depends on the type of that value; without a value"
				+ " the platform returns an empty table for some criteria and refuses with ""Type mismatch"""
				+ " for others (measured). Write %1(&Value) and pass the value in ParameterValues.", LogicalName);
		EndIf;
		If StrFind(Upper(LogicalName), Upper(".ЗадачиПоИсполнителю")) > 0
			Or StrFind(Upper(LogicalName), ".TASKBYPERFORMER") > 0
			Or StrFind(Upper(LogicalName), ".TASKSBYEXECUTIVE") > 0 Then
			Raise StrTemplate("%1 is a virtual table that the platform builds from task addressing, and this"
				+ " translation does not build it yet. Select from the task table directly.", LogicalName);
		EndIf;
		If Head = "EXTERNALDATASOURCE" Or Head = Upper("ВнешнийИсточникДанных") Then
			Raise StrTemplate("%1 is a table of an external data source: its rows live in another DBMS that the"
				+ " platform reaches over the connection of the source, not in this database, so SQL for this"
				+ " database cannot read them. Query that DBMS directly.", LogicalName);
		EndIf;
		Raise StrTemplate(
			"Table %1 has no physical storage in this infobase. Run the data processor in the database the SQL is meant for.",
			LogicalName);
	EndIf;
	Return Descriptor;

EndFunction

#EndRegion

#Region Generator

// A batch becomes one statement: every query that places its result into a temporary
// table turns into a common table expression, and the last query without a placement
// table becomes the main SELECT. Power BI accepts one statement, not a script.
Function SqlFromSchema(Schema, Opt, Warnings)

	TempTables = New Map;
	Definitions = New Array;
	Final = Undefined;
	Dropped = 0;
	// УНИЧТОЖИТЬ несуществующей таблицы и чтение уничтоженной платформа отвергает (негативная
	// батарея 13.11.2026: p09h «Temporary table does not exist», p09g «Table not found»).
	// Обобщённое табличное выражение живёт весь оператор, поэтому за живыми таблицами пакета
	// следит перевод: Alive - созданные и не уничтоженные, Drops - уничтожения по порядку.
	// Отказ откладывается до конца перевода: если запрос читает таблицу, которой в тексте нет,
	// подсказка про недостающие запросы важнее и звучит первой.
	Refusal = "";
	Alive = New Map;
	Drops = New Array;
	Positions = New Array;
	Position = 0;
	FinalPosition = 0;

	For Each Item In Schema.QueryBatch Do
		Position = Position + 1;
		If Not IsSelectQuery(Item) Then
			DropName = TrimAll(Item.TableName);
			If Alive.Get(Upper(DropName)) = Undefined Then
				If IsBlankString(Refusal) Then
					Refusal = StrTemplate("DROP %1 destroys a temporary table that this batch has not"
						+ " created or has already destroyed. The platform refuses it (""Temporary table"
						+ " does not exist""). If %1 comes from a temporary tables manager, paste the query"
						+ " that fills it into the ""Missing queries"" field above.", DropName);
				EndIf;
				Continue;
			EndIf;
			Alive.Delete(Upper(DropName));
			Drops.Add(New Structure("Position, Name, Applied", Position, DropName, False));
			Continue;
		EndIf;
		// ДОБАВИТЬ ИмяВТ дописывает строки в существующую таблицу. Платформа пишет INSERT INTO #tt
		// (колонки) SELECT ... - колонки по позиции, совпадение типов она проверяет сама (замер
		// 18.11.2026, УХ, add_probe). Перевод - новая версия той же таблицы: прежние строки UNION
		// ALL добавленные (см. цикл определений ниже).
		Appended = TableToAdd(Item);
		If Not IsBlankString(Appended) Then
			If Alive.Get(Upper(Appended)) = Undefined Then
				If IsBlankString(Refusal) Then
					Refusal = StrTemplate("ADD %1 appends rows to a temporary table that this batch has not"
						+ " created or has already destroyed. If %1 comes from a temporary tables manager,"
						+ " paste the query that fills it into the ""Missing queries"" field above.", Appended);
				EndIf;
				Continue;
			EndIf;
			Definitions.Add(Item);
			Positions.Add(Position);
			Continue;
		EndIf;
		If IsBlankString(Item.PlacementTable) Then
			// A batch may hold several queries that return a result. Query.Execute() gives
			// back only the last one, and so do we - but dropping the others silently would
			// hide whole result sets, so they are counted and reported below.
			If Final <> Undefined Then
				Dropped = Dropped + 1;
			EndIf;
			Final = Item;
			FinalPosition = Position;
			Continue;
		EndIf;
		Alive.Insert(Upper(TrimAll(Item.PlacementTable)), True);
		Definitions.Add(Item);
		Positions.Add(Position);
	EndDo;

	If Dropped > 0 Then
		// Непереведённые запросы своих группировок не востребуют: сверять не с чем.
		Opt.Insert("BatchTrimmed", True);
		Warnings.Add("The batch has " + Format(Dropped + 1, "NG=") + " queries returning a result."
			+ " Only the last one is translated, the way Query.Execute() behaves;"
			+ " the earlier result sets are not in the SQL."
			+ " Translate such queries separately if you need them.");
	EndIf;

	If Final = Undefined Then
		// В модулях пакет часто целиком состоит из ПОМЕСТИТЬ: результат забирают позже
		// из последней временной таблицы. Её и отдаём как итог.
		If Definitions.Count() = 0 Then
			// Пакет из одного ДОБАВИТЬ в чужую таблицу: причина - та таблица, а не пустой пакет.
			If Not IsBlankString(Refusal) Then
				Raise Refusal;
			EndIf;
			Raise "The batch has no query to translate.";
		EndIf;
		Final = Definitions[Definitions.Count() - 1];
		Definitions.Delete(Definitions.Count() - 1);
		FinalPosition = Positions[Positions.Count() - 1];
		Positions.Delete(Positions.Count() - 1);
		Warnings.Add("The batch has no final query; the result of the last temporary table """
			+ TrimAll(Final.PlacementTable) + """ is returned.");
	EndIf;

	Naming = NewContext(Opt, Warnings, TempTables);
	Expressions = New Array;
	SqlNames = New Array;
	Refusals = New Array;
	Taken = New Map;
	For Each Definition In Definitions Do
		Taken.Insert(Upper(DefinitionTableName(Definition)), 0);
	EndDo;
	DefinitionIndex = 0;
	For Each Definition In Definitions Do
		ApplyDrops(Drops, Min(Positions[DefinitionIndex], FinalPosition), TempTables);
		DefinitionIndex = DefinitionIndex + 1;
		Name = DefinitionTableName(Definition);
		Appended = TableToAdd(Definition);
		// Пакет может уничтожить временную таблицу и создать её заново под тем же именем;
		// выражения одного WITH живут вместе, и второе с тем же именем СУБД отвергает.
		// Повторное создание получает своё имя, и читают его запросы, стоящие после него.
		SqlName = Name;
		Count = Taken.Get(Upper(Name)) + 1;
		Taken.Insert(Upper(Name), Count);
		If Count > 1 Then
			Suffix = Count;
			While Taken.Get(Upper(Name + "_" + Format(Suffix, "NG=0"))) <> Undefined Do
				Suffix = Suffix + 1;
			EndDo;
			SqlName = Name + "_" + Format(Suffix, "NG=0");
			Taken.Insert(Upper(SqlName), 1);
			// Состав частей составных колонок запомнен по имени таблицы - у новой он свой.
			// У ДОБАВИТЬ таблица та же, и состав её частей прежний.
			If IsBlankString(Appended) Then
				TempTables.Delete("#PARTS:" + Upper(Name));
			EndIf;
		EndIf;
		ResetPartsOnlyReads(Opt);
		If IsBlankString(Appended) Then
			Body = QuerySql(Definition, Opt, Warnings, TempTables);
		Else
			Previous = TempTables.Get(Upper(Name));
			Body = "SELECT * FROM " + QuoteIdentifier(Previous.PhysicalName, Naming) + Chars.LF + "UNION ALL"
				+ Chars.LF + AppendedRowsSql(Definition, Name, Opt, Warnings, TempTables);
		EndIf;
		// Псевдонимы источников (T1, T2 …) в каждом запросе пакета свои, поэтому чтение колонки из
		// одних частей проверяется по тексту своего запроса.
		Refusals.Add(PartsOnlyRefusal(Body, Opt, True));
		Expressions.Add(QuoteIdentifier(SqlName, Naming) + " AS (" + Chars.LF + Body + Chars.LF + ")");
		SqlNames.Add(SqlName);
		If IsBlankString(Appended) Then
			Descriptor = TempTableDescriptor(Name, Definition, Naming);
			NotePresentationCompanions(Descriptor, Definition, Opt);
		Else
			Descriptor = TempTables.Get(Upper(Name));
			If Not SamePresentationCompanions(Descriptor, Definition, Opt) Then
				Raise StrTemplate("ADD to temporary table %1: a column holds the presentation of a reference in the"
					+ " table and something else in the added rows, or the other way round. The platform keeps the"
					+ " reference beside such a column (measured), and the two sets of columns do not match here."
					+ " Select the same kind of value in both queries.", Name);
			EndIf;
		EndIf;
		Descriptor.PhysicalName = SqlName;
		TempTables.Insert(Upper(Name), Descriptor);
	EndDo;

	// Итоговый запрос выводит составное поле всеми колонками хранения. Замерено на
	// платформе: у поля из ссылок это тег типа, идентификатор таблицы и ссылка, у поля
	// с примитивами ещё и примитивные части, в порядке хранения. Одной колонкой ссылки
	// значение не описывается - ссылки разных таблиц с одним RRRef неразличимы, а
	// примитив теряется целиком. Подзапросы части не выводят: там число колонок связано.
	ApplyDrops(Drops, FinalPosition, TempTables);
	ResetPartsOnlyReads(Opt);
	FinalBody = QuerySql(Final, Opt, Warnings, TempTables, "T", True, True);
	PartsRefusal = PartsOnlyRefusal(FinalBody, Opt, True);

	// Вспомогательные выражения - иерархия, виртуальные таблицы - собраны при переводе
	// условий. Временную таблицу они тоже читают: условие виртуальной таблицы и
	// В ИЕРАРХИИ берут её подзапросом. Поэтому они участвуют и в счёте прочитанного, и
	// в порядке объявления.
	Recursive = TempTables.Get(HierarchyRegistryKey());
	Pending = New Array;
	Used = FinalBody;
	If Recursive <> Undefined Then
		For Each Item In Recursive Do
			Pending.Add(New Structure("Name, Text", Item.Name,
				Item.Name + " AS (" + Chars.LF + Item.Body + Chars.LF + ")"));
			Used = Used + Chars.LF + Item.Body;
			If IsBlankString(PartsRefusal) Then
				PartsRefusal = PartsOnlyRefusal(Item.Body, Opt, False);
			EndIf;
		EndDo;
	EndIf;

	// Пакет 1С может заполнить временную таблицу и не воспользоваться ею; в T-SQL
	// объявленное и неиспользованное обобщённое табличное выражение - ошибка.
	Index = Expressions.Count() - 1;
	Kept = New Array;
	While Index >= 0 Do
		Name = QuoteIdentifier(SqlNames[Index], Naming);
		If StrFind(Used, Name) > 0 Then
			If IsBlankString(PartsRefusal) Then
				PartsRefusal = Refusals[Index];
			EndIf;
			Kept.Insert(0, New Structure("Name, Text", Name, Expressions[Index]));
			Used = Used + Chars.LF + Expressions[Index];
		Else
			Warnings.Add("Temporary table " + DefinitionTableName(Definitions[Index])
				+ " is filled but never read, so it is left out of the SQL.");
			WarnAboutSkippedFailure(Definitions[Index], Warnings);
		EndIf;
		Index = Index - 1;
	EndDo;
	For Each Item In Kept Do
		Pending.Add(Item);
	EndDo;

	// Объявляется выражение после всех, кого читает. Прежний порядок сохраняется везде,
	// где зависимостей нет.
	Ordered = New Array;
	While Pending.Count() > 0 Do
		Chosen = 0;
		For Index = 0 To Pending.Count() - 1 Do
			Waits = False;
			For Each Other In Pending Do
				If Other <> Pending[Index] And MentionsWholeColumn(Pending[Index].Text, Other.Name) Then
					Waits = True;
					Break;
				EndIf;
			EndDo;
			If Not Waits Then
				Chosen = Index;
				Break;
			EndIf;
		EndDo;
		Ordered.Add(Pending[Chosen].Text);
		Pending.Delete(Chosen);
	EndDo;

	Parts = New Array;
	For Index = 0 To Ordered.Count() - 1 Do
		Header = ?(Index > 0, "   , ",
			?(Recursive <> Undefined And Recursive.Count() > 0 And Opt.Dialect = "PostgreSQL",
				"WITH RECURSIVE ", "WITH "));
		Parts.Add(Header + Ordered[Index]);
	EndDo;

	Parts.Add(FinalBody);

	// Ряд дат бывает длиннее ста шагов, а это предел рекурсии MS SQL по умолчанию.
	If Recursive <> Undefined And Recursive.Count() > 0 And Opt.Dialect = "MSSQL" Then
		Parts.Add("OPTION (MAXRECURSION 0)");
	EndIf;

	If Not IsBlankString(Refusal) Then
		Raise Refusal;
	EndIf;
	If Not IsBlankString(PartsRefusal) Then
		Raise PartsRefusal;
	EndIf;
	Return StrConcat(Parts, Chars.LF);

EndFunction

// Уничтожения пакета, стоящие раньше позиции Limit: таблица пропадает из видимых, а метка
// #DROPPED: даёт RegisterSource сказать о чтении уничтоженной точно.
Procedure ApplyDrops(Drops, Limit, TempTables)

	For Each Drop In Drops Do
		If Drop.Applied Or Drop.Position >= Limit Then
			Continue;
		EndIf;
		Drop.Applied = True;
		TempTables.Delete(Upper(Drop.Name));
		TempTables.Delete("#PARTS:" + Upper(Drop.Name));
		TempTables.Insert("#DROPPED:" + Upper(Drop.Name), True);
	EndDo;

EndProcedure

// Имя временной таблицы, которую запрос пакета создаёт (ПОМЕСТИТЬ) или дополняет (ДОБАВИТЬ).
Function DefinitionTableName(Definition)

	Appended = TableToAdd(Definition);
	Return ?(IsBlankString(Appended), TrimAll(Definition.PlacementTable), Appended);

EndFunction

// Строки, которые ДОБАВИТЬ дописывает в таблицу. Платформа вставляет их в колонки #tt, поэтому
// выборка переводится как помещение в ту же таблицу - с теми же приведениями, что у ПОМЕСТИТЬ.
Function AppendedRowsSql(Definition, Name, Opt, Warnings, TempTables)

	Definition.TableToAdd = "";
	Definition.PlacementTable = Name;
	Try
		Body = QuerySql(Definition, Opt, Warnings, TempTables);
	Except
		Definition.PlacementTable = "";
		Definition.TableToAdd = Name;
		Raise;
	EndTry;
	Definition.PlacementTable = "";
	Definition.TableToAdd = Name;
	Return Body;

EndFunction

// Имя таблицы после ДОБАВИТЬ. Свойство появилось в 8.3.25 вместе с самой конструкцией; на
// более старой платформе его нет - тогда пустая строка.
Function TableToAdd(Query)

	Try
		Return TrimAll(Query.TableToAdd);
	Except
		Return "";
	EndTry;

EndFunction

// Временная таблица, которую никто не читает, в SQL не попадает и не вычисляется. Платформа
// же вычисляет каждую таблицу пакета, и деление на ноль или переполнение ВЫРАЗИТЬ в ней роняет
// весь запрос (негативная батарея 13.11.2026: p09q `1/Т.Наценка` в непрочитанной ВТ - 8134 у
// 1С, значение у SQL). Защиты нет - только предупреждение о том, что ошибка 1С здесь не видна.
Procedure WarnAboutSkippedFailure(Definition, Warnings)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(Definition.GetQueryText());
	Except
		Return;
	EndTry;
	Risky = False;
	For Index = 0 To Tokens.Count() - 1 Do
		Word = Upper(Tokens[Index].Value);
		If Tokens[Index].Kind = "Symbol" And Word = "/" Then
			Risky = True;
		ElsIf (Word = "AS" Or Word = Upper("Как")) And Index + 2 < Tokens.Count()
			And (Upper(Tokens[Index + 1].Value) = "NUMBER" Or Upper(Tokens[Index + 1].Value) = Upper("Число"))
			And Tokens[Index + 2].Value = "(" Then
			Risky = True;
		EndIf;
		If Risky Then
			Break;
		EndIf;
	EndDo;
	If Not Risky Then
		Return;
	EndIf;
	Warnings.Add("Temporary table " + TrimAll(Definition.PlacementTable) + " divides or casts to a"
		+ " number of limited precision, and the SQL does not compute it because nothing reads it."
		+ " The platform computes every temporary table of the batch: a division by zero or an"
		+ " overflow there fails the whole query in 1C, while the SQL returns the result.");

EndProcedure

// Набор типов каждой колонки по модели запроса, который наполняет таблицу: имя колонки в
// верхнем регистре - описание типов. Нужен там, где происхождения у колонки нет
// (вычисляемое выражение), а вид значения знать надо - SourceColumnArmParts.
Function DeclaredColumnTypes(Definition)

	Result = New Map;
	Try
		For Each Column In Definition.Columns Do
			Alias = TrimAll(Column.Alias);
			If Not IsBlankString(Alias) Then
				Result.Insert(Upper(Alias), Column.ValueType);
			EndIf;
		EndDo;
	Except
		Return New Map;
	EndTry;
	Return Result;

EndFunction

// Columns of a temporary table are the output columns of the query that fills it.
Function TempTableDescriptor(Name, Definition, Context = Undefined)

	Fields = New Map;
	For Each Column In Definition.Columns Do
		Alias = TrimAll(Column.Alias);
		If Not IsBlankString(Alias) Then
			Fields.Insert(Upper(Alias), Alias);
		EndIf;
	EndDo;

	Descriptor = New Structure;
	Descriptor.Insert("LogicalName", Name);
	Descriptor.Insert("PhysicalName", Name);
	Descriptor.Insert("Purpose", "TemporaryTable");
	Descriptor.Insert("Fields", Fields);
	Descriptor.Insert("Columns", New Map);
	Descriptor.Insert("Names", New Map);
	Descriptor.Insert("Unnamed", New Array);
	Descriptor.Insert("IsDerived", True);
	Descriptor.Insert("Subquery", "");
	Columns = New Map;
	Descriptor.Insert("TagOnly", UndefinedOnlyColumns(Definition));
	Descriptor.Insert("DeclaredTypes", DeclaredColumnTypes(Definition));
	Descriptor.Insert("ColumnSources", ?(Context = Undefined, New Map,
		TempTableColumnSources(Definition, Context, Columns)));
	Descriptor.Columns = Columns;
	Descriptor.Insert("ParameterColumns", ParameterColumns(Definition));
	// Разрядность вычисляемых числовых колонок модель не объявляет (Число без длины); её
	// выводит деление, когда колонку делят, - лениво, по запросу, см. ComputedColumnOperand.
	Descriptor.Insert("NumericColumns", New Map);
	// Временные таблицы - какими они были, когда эту создавали: тип колонки выводится лениво,
	// и к тому времени таблица, из которой её заполнили, бывает уже уничтожена (ворота 55, УХ).
	Visible = Undefined;
	If Context <> Undefined Then
		Visible = New Map;
		For Each Item In Context.TempTables Do
			Visible.Insert(Item.Key, Item.Value);
		EndDo;
	EndIf;
	Descriptor.Insert("NumericSource", ?(Context = Undefined, Undefined,
		New Structure("Definition, Context, TempTables", Definition, Context, Visible)));
	If Context <> Undefined And Descriptor.ParameterColumns.Count() > 0 Then
		Context.Options.Insert("ParameterColumnsSeen", True);
	EndIf;
	Return Descriptor;

EndFunction

// Колонки временной таблицы, заполненные голым параметром: `&Дата КАК Период`. Своего
// типа у такой колонки нет - он тот же, что у параметра, а тип параметра выясняется
// там, где колонку с чем-нибудь сравнивают. Ключ - псевдоним колонки, значение -
// имена параметров (в ветвях объединения они могут быть разными).
Function ParameterColumns(Definition)

	Result = New Map;
	For Each Operator In Definition.Operators Do
		For Index = 0 To BranchFieldCount(Definition, Operator) - 1 Do
			If Index > Definition.Columns.Count() - 1 Then
				Break;
			EndIf;
			Text = TrimAll(ColumnFieldText(Definition, Operator, Index));
			If StrLen(Text) < 2 Or Left(Text, 1) <> "&" Or StrFind(Text, " ") > 0
				Or StrFind(Text, "(") > 0 Then
				Continue;
			EndIf;
			Alias = Upper(TrimAll(Definition.Columns[Index].Alias));
			Names = Result.Get(Alias);
			If Names = Undefined Then
				Names = New Array;
				Result.Insert(Alias, Names);
			EndIf;
			Names.Add(Mid(Text, 2));
		EndDo;
	EndDo;
	Return Result;

EndFunction

// Параметры, которыми заполнена колонка временной таблицы, либо Undefined.
Function ParametersBehindColumn(Path, Context)

	If StrFind(Path, ".") = 0 Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	If Resolved.Descriptor = Undefined Or Not Resolved.Descriptor.IsDerived
		Or Not IsBlankString(Resolved.CompositeSegment)
		Or Not Resolved.Descriptor.Property("ParameterColumns") Then
		Return Undefined;
	EndIf;
	Return Resolved.Descriptor.ParameterColumns.Get(Upper(TrimAll(Resolved.FieldName)));

EndFunction

// Колонка-параметр временной таблицы напротив типизированного поля: тип поля и есть
// тип параметра. Порядок операндов не важен.
Procedure NoteColumnParameterTypes(First, Second, Context)

	If Not Context.Options.Property("ParameterColumnsSeen")
		Or Context.Options.ParameterColumnsSeen <> True Then
		Return;
	EndIf;

	Typed = Second;
	Names = ParametersBehindColumn(First, Context);
	If Names = Undefined Then
		Typed = First;
		Names = ParametersBehindColumn(Second, Context);
	EndIf;
	If Names = Undefined Then
		Return;
	EndIf;

	SqlType = SqlTypeOfPath(Typed, Context);
	If IsBlankString(SqlType) Then
		Return;
	EndIf;
	For Each Name In Names Do
		RememberParameterType(Name, SqlType, Context);
	EndDo;

EndProcedure

// Откуда у колонки тип. Простой путь - от поля источника; ЕСТЬNULL и ВЫБОР - от своей
// первой ветви; ЗНАЧЕНИЕ и ВЫРАЗИТЬ называют тип прямо. Всё остальное типа не несёт.
// Происхождение колонки, заполненной через составную ссылку. Поля метаданных за таким
// значением нет: тип складывается из тех ветвей составной ссылки, у которых такой путь
// есть, - ровно из тех же, по которым платформа строит ВЫБОР.
Function CompositeTailOrigin(Resolved)

	FieldType = CompositeFieldType(Resolved.Descriptor, Resolved.CompositeSegment);
	If FieldType = Undefined Then
		Return Undefined;
	EndIf;

	Tail = New Array;
	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined Then
		For Each Item In Resolved.CompositeTail Do
			Tail.Add(Item);
		EndDo;
	EndIf;
	Tail.Add(Resolved.FieldName);

	Types = New Array;
	For Each ItemType In FieldType.Types() Do
		Target = Metadata.FindByType(ItemType);
		If Target = Undefined Then
			Continue;
		EndIf;
		Branch = BranchFieldType(Target.FullName(), Tail);
		If Branch = Undefined Then
			Continue;
		EndIf;
		For Each Item In Branch.Types() Do
			If Types.Find(Item) = Undefined Then
				Types.Add(Item);
			EndIf;
		EndDo;
	EndDo;
	If Types.Count() = 0 Then
		Return Undefined;
	EndIf;

	Origin = New Structure;
	Origin.Insert("LogicalName", Resolved.Descriptor.LogicalName);
	Origin.Insert("FieldName", Resolved.FieldName);
	Origin.Insert("Type", New TypeDescription(Types));
	Return Origin;

EndFunction

// Состав типов поля таблицы: у производной он лежит в происхождении колонки,
// у таблицы базы - в метаданных.
Function CompositeFieldType(Descriptor, FieldName)

	If Not Descriptor.IsDerived Then
		Owner = MetadataOf(Descriptor.LogicalName);
		Return ?(Owner = Undefined, Undefined, FieldTypeDescription(Owner, FieldName));
	EndIf;

	Origin = Undefined;
	If Descriptor.Property("ColumnSources") And Descriptor.ColumnSources <> Undefined Then
		Origin = Descriptor.ColumnSources.Get(Upper(TrimAll(FieldName)));
	EndIf;
	If Origin = Undefined Then
		Return Undefined;
	EndIf;
	If Origin.Property("Type") And Origin.Type <> Undefined Then
		Return Origin.Type;
	EndIf;
	Owner = MetadataOf(Origin.LogicalName);
	Return ?(Owner = Undefined, Undefined, FieldTypeDescription(Owner, Origin.FieldName));

EndFunction

// Тип поля в конце цепочки ссылок от конкретной таблицы. Undefined означает, что такого
// пути у этой таблицы нет - её ветвь платформа тоже не строит.
Function BranchFieldType(TableName, Tail)

	Current = TableName;
	For Index = 0 To Tail.Count() - 1 Do
		Owner = MetadataOf(Current);
		If Owner = Undefined Then
			Return Undefined;
		EndIf;
		FieldType = FieldTypeDescription(Owner, Tail[Index]);
		If FieldType = Undefined Then
			Return Undefined;
		EndIf;
		If Index = Tail.Count() - 1 Then
			Return FieldType;
		EndIf;
		Types = FieldType.Types();
		If Types.Count() <> 1 Then
			// Промежуточная составная ссылка: тип - объединение по её ветвям (замер p6a, p6b - платформа строит
			// вложенный ВЫБОР по типам каждого звена).
			Rest = New Array;
			For Position = Index + 1 To Tail.Count() - 1 Do
				Rest.Add(Tail[Position]);
			EndDo;
			Union = New Array;
			For Each Item In Types Do
				Next = Metadata.FindByType(Item);
				If Next = Undefined Then
					Continue;
				EndIf;
				For Each Found In BranchFieldTypes(Next.FullName(), Rest) Do
					For Each FoundType In Found.Types() Do
						If Union.Find(FoundType) = Undefined Then
							Union.Add(FoundType);
						EndIf;
					EndDo;
				EndDo;
			EndDo;
			Return ?(Union.Count() = 0, Undefined, New TypeDescription(Union));
		EndIf;
		Next = Metadata.FindByType(Types[0]);
		If Next = Undefined Then
			Return Undefined;
		EndIf;
		Current = Next.FullName();
	EndDo;
	Return Undefined;

EndFunction

// Типы поля в конце цепочки ссылок от таблицы - по всем ветвям промежуточных составных ссылок (замер p6a, p6b:
// ПредметГрафика.ВерсияСоглашения.ИндикативнаяСтавка). Пустой массив - пути нет ни у одной ветви.
Function BranchFieldTypes(TableName, Tail, Depth = 0)

	Result = New Array;
	Owner = MetadataOf(TableName);
	If Owner = Undefined Or Tail.Count() = 0 Or Depth > 5 Then
		Return Result;
	EndIf;
	FieldType = Undefined;
	Try
		FieldType = FieldTypeDescription(Owner, Tail[0]);
	Except
		FieldType = Undefined;
	EndTry;
	If FieldType = Undefined Then
		Return Result;
	EndIf;
	If Tail.Count() = 1 Then
		Result.Add(FieldType);
		Return Result;
	EndIf;
	Rest = New Array;
	For Index = 1 To Tail.Count() - 1 Do
		Rest.Add(Tail[Index]);
	EndDo;
	For Each Item In FieldType.Types() Do
		Next = Metadata.FindByType(Item);
		If Next = Undefined Then
			Continue;
		EndIf;
		For Each Found In BranchFieldTypes(Next.FullName(), Rest, Depth + 1) Do
			Result.Add(Found);
		EndDo;
	EndDo;
	Return Result;

EndFunction

Function ColumnOrigin(Text, Probe)

	Trimmed = TrimAll(Text);
	If IsBlankString(Trimmed) Then
		Return Undefined;
	EndIf;

	// Поле-источник: путь с точкой или голое имя без псевдонима.
	If StrFind(Trimmed, "(") = 0 And StrFind(Trimmed, " ") = 0 Then
		Resolved = Undefined;
		Try
			Resolved = ResolveField(Trimmed, Probe);
		Except
			Return Undefined;
		EndTry;
		If Not IsBlankString(Resolved.CompositeSegment) Then
			// Путь прошёл через составную ссылку: состав типов собирается по её ветвям.
			Return CompositeTailOrigin(Resolved);
		EndIf;
		If Resolved.Descriptor.IsDerived Then
			// Цепочка временных таблиц: тип наследуется от предыдущей.
			If Not Resolved.Descriptor.Property("ColumnSources") Then
				Return Undefined;
			EndIf;
			Return Resolved.Descriptor.ColumnSources.Get(Upper(Resolved.FieldName));
		EndIf;
		Origin = New Structure;
		Origin.Insert("LogicalName", Resolved.Descriptor.LogicalName);
		Origin.Insert("FieldName", Resolved.FieldName);
		Return Origin;
	EndIf;

	Tokens = Tokenize(Trimmed);
	If Tokens.Count() < 2 Or Tokens[0].Kind <> "Name" Then
		Return Undefined;
	EndIf;

	Word = Upper(Tokens[0].Value);

	If Word = "CASE" Or Word = Upper("Выбор") Then
		Return CaseBranchOrigin(Tokens, Probe);
	EndIf;

	If Tokens[1].Value <> "(" Then
		Return Undefined;
	EndIf;

	Consumed = 0;
	Arguments = CollectArguments(Tokens, 0, Consumed);
	If Arguments.Count() = 0 Then
		Return Undefined;
	EndIf;

	If Word = "ISNULL" Or Word = Upper("ЕстьNULL") Then
		Return ColumnOrigin(Arguments[0], Probe);
	EndIf;

	// Максимум и минимум возвращают тип своего аргумента - это самый частый способ
	// потерять тип временной колонки: МАКСИМУМ(ЕСТЬNULL(а.Поле, б.Поле)).
	// Сумма, количество и среднее дают число, по нему навигация бессмысленна.
	If Word = "MAX" Or Word = Upper("Максимум")
		Or Word = "MIN" Or Word = Upper("Минимум") Then
		Return ColumnOrigin(Arguments[0], Probe);
	EndIf;

	If Word = "VALUE" Or Word = Upper("Значение") Then
		// ЗНАЧЕНИЕ(Справочник.X.ПустаяСсылка) - тип назван прямо.
		Return TypeOrigin(StrReplace(StrConcat(Arguments, ""), " ", ""), True);
	EndIf;

	If Word = "CAST" Or Word = Upper("Выразить") Then
		Split = Undefined;
		Try
			Split = SplitCast(Arguments[0]);
		Except
			Return Undefined;
		EndTry;
		Return TypeOrigin(Split.TypeText, False);
	EndIf;

	Return Undefined;

EndFunction

// Тип, названный именем таблицы. У ЗНАЧЕНИЕ последний сегмент - имя предопределённого
// значения или ПустаяСсылка, его надо отбросить.
Function TypeOrigin(TypeText, DropLastSegment)

	Parts = StrSplit(TrimAll(TypeText), ".", False);
	If DropLastSegment And Parts.Count() > 2 Then
		Parts.Delete(Parts.Count() - 1);
	EndIf;
	If Parts.Count() < 2 Then
		Return Undefined;
	EndIf;

	// ЗНАЧЕНИЕ(БизнесПроцесс.X.ТочкаМаршрута.Y): тип значения - таблица точек маршрута X (_BPrPoints<N>), а не
	// сам бизнес-процесс. Замер sm_rp5 (21.11.2026, УХ): _Point_RTRef = 0x1F у СогласованиеПродажи, чья таблица -
	// _BusinessProcess30. Своего имени в структуре хранения у таблицы точек нет (см. StorageStructure).
	If Parts.Count() = 3 And IsRoutePointSegment(Parts[2]) Then
		Key_ = RoutePointsKey(Parts[1]);
		If StorageStructure().Get(Key_) = Undefined Then
			Return Undefined;
		EndIf;
		Origin = New Structure;
		Origin.Insert("LogicalName", Key_);
		Origin.Insert("FieldName", "Ref");
		Return Origin;
	EndIf;

	Name = StrConcat(Parts, ".");
	If StorageStructure().Get(Upper(Name)) = Undefined Then
		// Префикс вида таблицы бывает на другом языке - ЗНАЧЕНИЕ(Справочник.X.ПустаяСсылка)
		// на англоязычной базе и наоборот. Ключи структуры хранения логические, поэтому
		// префикс приводится так же, как это делает TableDescriptor. Без этого шага ветвь
		// объединения с ЗНАЧЕНИЕ(...) теряла ссылочную часть.
		Pieces = StrSplit(Upper(Name), ".", True);
		Other = CollectionSynonyms().Get(Pieces[0]);
		If Other = Undefined Then
			Return Undefined;
		EndIf;
		Pieces[0] = Other;
		If StorageStructure().Get(StrConcat(Pieces, ".")) = Undefined Then
			Return Undefined;
		EndIf;
		Name = StrConcat(Pieces, ".");
	EndIf;

	Origin = New Structure;
	Origin.Insert("LogicalName", Name);
	Origin.Insert("FieldName", "Ref");
	Return Origin;

EndFunction

// Уже выведенный тип параметра. Пустая строка означает «ещё не знаем».
Function InferredParameterType(Name, Context)

	If Not Context.Options.Property("ParameterSqlTypes")
		Or Context.Options.ParameterSqlTypes = Undefined Then
		Return "";
	EndIf;
	Found = Context.Options.ParameterSqlTypes.Get(Upper(TrimAll(Name)));
	Return ?(Found = Undefined, "", Found);

EndFunction

// SQL-тип выражения. У пути тип берётся из метаданных (SqlTypeOfPath), у литерала и у
// функции - по самой функции. ЕСТЬNULL, МАКСИМУМ и МИНИМУМ отдают тип своего первого
// аргумента: именно они чаще всего стоят вокруг поля и прячут его тип.
Function SqlTypeOfExpression(Text, Context, ThroughSources = True)

	Trimmed = TrimAll(Text);
	If IsBlankString(Trimmed) Then
		Return "";
	EndIf;

	If StrFind(Trimmed, "(") = 0 And StrFind(Trimmed, " ") = 0 Then
		If Left(Trimmed, 1) = "&" Then
			Return InferredParameterType(Mid(Trimmed, 2), Context);
		EndIf;
		Return SqlTypeOfPath(Trimmed, Context, ThroughSources);
	EndIf;

	Tokens = Tokenize(Trimmed);
	If Tokens.Count() = 0 Then
		Return "";
	EndIf;

	If Tokens[0].Kind = "String" Then
		Return "NVARCHAR(500)";
	EndIf;
	If Tokens[0].Kind = "Number" Then
		Return "NUMERIC(20, 8)";
	EndIf;
	If Tokens[0].Kind <> "Name" Then
		Return "";
	EndIf;

	Word = Upper(Tokens[0].Value);

	If Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь") Then
		Return "BINARY(1)";
	EndIf;
	If Word = "DATETIME" Or Word = Upper("ДатаВремя")
		Or Word = "BEGINOFPERIOD" Or Word = Upper("НачалоПериода")
		Or Word = "ENDOFPERIOD" Or Word = Upper("КонецПериода")
		Or Word = "DATEADD" Or Word = Upper("ДобавитьКДате") Then
		Return "DATETIME2";
	EndIf;
	If Word = "DATEDIFF" Or Word = Upper("РазностьДат")
		Or Word = "INT" Or Word = Upper("Цел")
		Or Word = "STRFIND" Or Word = Upper("СтрНайти")
		Or Word = "STOREDDATASIZE" Or Word = Upper("РазмерХранимыхДанных")
		Or StrSplit("SIN,COS,TAN,ASIN,ACOS,ATAN,EXP,LOG,LOG10,SQRT", ",").Find(Word) <> Undefined
		Or Word = "SUM" Or Word = Upper("Сумма")
		Or Word = "COUNT" Or Word = Upper("Количество")
		Or Word = "AVG" Or Word = Upper("Среднее") Then
		Return "NUMERIC(20, 8)";
	EndIf;
	If Word = "CASE" Or Word = Upper("Выбор") Then
		For Each Span In CaseArmSpans(Tokens, 0) Do
			SqlType = SqlTypeOfExpression(TokensText(Tokens, Span.From, Span.Till), Context,
				ThroughSources);
			If Not IsBlankString(SqlType) Then
				Return SqlType;
			EndIf;
		EndDo;
		Return "";
	EndIf;

	If Tokens.Count() < 2 Or Tokens[1].Value <> "(" Then
		Return "";
	EndIf;

	Consumed = 0;
	Arguments = CollectArguments(Tokens, 0, Consumed);
	If Arguments.Count() = 0 Then
		Return "";
	EndIf;

	If Word = "ISNULL" Or Word = Upper("ЕстьNULL")
		Or Word = "MAX" Or Word = Upper("Максимум")
		Or Word = "MIN" Or Word = Upper("Минимум") Then
		Return SqlTypeOfExpression(Arguments[0], Context, ThroughSources);
	EndIf;

	Return "";

EndFunction

// Ветви одного ВЫБОРа: границы каждой ТОГДА и ИНАЧЕ. Вложенный ВЫБОР пропускается
// целиком - его ветви принадлежат ему, а не внешнему.
Function CaseArmSpans(Tokens, CaseIndex)

	Arms = New Array;
	Depth = 0;
	Nested = 0;
	Position = CaseIndex + 1;

	While Position < Tokens.Count() Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			If Depth = 0 Then
				Break;
			EndIf;
			Depth = Depth - 1;
		ElsIf Depth = 0 And Tokens[Position].Kind = "Name" Then
			Word = Upper(Value);
			If Word = "CASE" Or Word = Upper("Выбор") Then
				Nested = Nested + 1;
			ElsIf Word = "END" Or Word = Upper("Конец") Then
				If Nested = 0 Then
					Break;
				EndIf;
				Nested = Nested - 1;
			ElsIf Nested = 0 And (Word = "THEN" Or Word = Upper("Тогда")
				Or Word = "ELSE" Or Word = Upper("Иначе")) Then
				Finish = BranchEnd(Tokens, Position + 1);
				If Finish >= Position + 1 Then
					Span = New Structure("From, Till", Position + 1, Finish);
					Arms.Add(Span);
				EndIf;
			EndIf;
		EndIf;
		Position = Position + 1;
	EndDo;

	Return Arms;

EndFunction

// Тип параметра по соседней ветви ВЫБОРа. Ветвь из одного параметра типа не несёт, а
// любая другая ветвь того же ВЫБОРа несёт: у ВЫБОРа тип один на все ветви. Наблюдатель,
// потока не меняет.
Procedure NoteCaseBranchParameterTypes(Tokens, Context)

	For Index = 0 To Tokens.Count() - 1 Do
		If Tokens[Index].Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Index].Value);
		If Word <> "CASE" And Word <> Upper("Выбор") Then
			Continue;
		EndIf;

		SqlType = "";
		Names = New Array;
		For Each Span In CaseArmSpans(Tokens, Index) Do
			If Span.From = Span.Till And Tokens[Span.From].Kind = "Parameter" Then
				Names.Add(Tokens[Span.From].Value);
				Continue;
			EndIf;
			If IsBlankString(SqlType) Then
				SqlType = SqlTypeOfExpression(TokensText(Tokens, Span.From, Span.Till), Context);
			EndIf;
		EndDo;

		If IsBlankString(SqlType) Then
			// Все ветви - параметры: тип неизвестен, но он у них общий. Связь разберётся
			// при выдаче шапки, когда тип одного из них станет известен из другого места.
			For Position = 1 To Names.Count() - 1 Do
				LinkParameterTypes(Names[0], Names[Position], Context);
			EndDo;
			Continue;
		EndIf;
		For Each Name In Names Do
			// Заданное значение другого вида соседнего типа не получает: тип у ВЫБОРа один на
			// ветви только в модели, а платформа строит колонку по значению (сверка 13.11.2026:
			// строка рядом с датой у 1С строка, а объявленная датой давала 1900-01-01 и ошибку
			// 241). Значения нет - тип соседа остаётся предположением, и об этом надо сказать.
			ValueType = ParameterValueSqlType(Name, Context);
			If Not IsBlankString(ValueType) Then
				If SqlTypeKind(ValueType) = SqlTypeKind(SqlType) Then
					RememberParameterType(Name, SqlType, Context);
				EndIf;
				Continue;
			EndIf;
			RememberParameterType(Name, SqlType, Context);
			If IsOuterColumnStub(Name, Context) Then
				Continue;
			EndIf;
			AddOnce(Context.Warnings, StrTemplate(
				"Parameter &%1 stands as a whole branch of CASE, and no value is supplied for it: the SQL"
				+ " takes it to be of the type of another branch (%2) and returns the value in one column."
				+ " The platform types the value at execution: a value of another kind - a string beside a"
				+ " date, a reference, UNDEFINED - comes back as a composite value with a type tag, and this"
				+ " SQL either converts it silently or fails. Supply the parameter value to get the parts.",
				Name, SqlType));
		EndDo;
	EndDo;

EndProcedure

// Первая ветвь ТОГДА, у которой тип определяется, задаёт тип всего ВЫБОРа.
Function CaseBranchOrigin(Tokens, Probe)

	// Происхождение - по всем ветвям. Ветви со ссылками на разные таблицы происхождения не
	// дают: прежде бралась первая, и переход через точку от такой колонки соединял одну
	// таблицу, а строки другой получали NULL (сверка battery25: 1С 116 строк, SQL 12).
	First = Undefined;
	FirstTarget = "";
	ParameterTarget = "";
	Unions = New Map;
	For Index = 0 To Tokens.Count() - 1 Do
		If Tokens[Index].Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Index].Value);
		If Word <> "THEN" And Word <> Upper("Тогда") And Word <> "ELSE" And Word <> Upper("Иначе") Then
			Continue;
		EndIf;
		Finish = BranchEnd(Tokens, Index + 1);
		If Finish < Index + 1 Then
			Continue;
		EndIf;
		If Finish = Index + 1 And Tokens[Finish].Kind = "Parameter" Then
			// Ветвь - параметр со значением: его тип входит в состав типов колонки. Замер dc16, dc16i (21.11.2026,
			// УХ, `ВЫБОР … ТОГДА Д.Контрагент ИНАЧЕ &П КОНЕЦ КАК К ПОМЕСТИТЬ ВТ` при &П - организация): в таблице
			// идентификатор таблицы и ссылка (`CASE … THEN 0x000000BC ELSE 0x000000E6 END, CASE … THEN
			// T1._Fld24009RRef ELSE @P1 END`), и `ВТ.К.Наименование` выбирает по типу из двух таблиц. Происхождение
			// первой ветви соединяло одну таблицу, и строки ветви параметра получали NULL - молча.
			Supplied = SuppliedParameterTable(Tokens[Finish].Value, Probe);
			If Not IsBlankString(Supplied) Then
				If IsBlankString(ParameterTarget) Then
					ParameterTarget = Supplied;
				ElsIf Upper(ParameterTarget) <> Upper(Supplied) Then
					Return Undefined;
				EndIf;
			EndIf;
		EndIf;
		Origin = ColumnOrigin(TokensText(Tokens, Index + 1, Finish), Probe);
		If Origin = Undefined Then
			Continue;
		EndIf;
		AddOriginTypes(Unions, "CASE", Origin);
		Target = OriginReferenceTarget(Origin);
		If First = Undefined Then
			First = Origin;
			FirstTarget = Target;
		ElsIf Not IsBlankString(Target) And Not IsBlankString(FirstTarget)
			And Upper(Target) <> Upper(FirstTarget) Then
			Return Undefined;
		EndIf;
	EndDo;
	If Not IsBlankString(ParameterTarget) And Not IsBlankString(FirstTarget)
		And Upper(ParameterTarget) <> Upper(FirstTarget) Then
		Return Undefined;
	EndIf;
	Return CaseUnionOrigin(First, Unions.Get("CASE"));

EndFunction

// Таблица ссылки, которой задан параметр. Пустая строка - значения нет либо оно не ссылка.
Function SuppliedParameterTable(Name, Context)

	If Not Context.Options.Property("ParameterValues") Or TypeOf(Context.Options.ParameterValues) <> Type("Map") Then
		Return "";
	EndIf;
	Value = Context.Options.ParameterValues.Get(TrimAll(Name));
	If Value = Undefined Or Value = Null Then
		Return "";
	EndIf;
	Target = Metadata.FindByType(TypeOf(Value));
	Return ?(Target = Undefined, "", Target.FullName());

EndFunction

// Ветви ВЫБОРа с разным составом ссылок: для разбора по типам составной ссылки (CompositeNavigation) происхождение
// несёт состав всех ветвей отдельным ключом UnionType, как у колонки объединения; одиночная навигация по-прежнему
// смотрит на состав первой ветви. Замер ppr9 (21.11.2026, УХ): у колонки ВТ `ВЫБОР … ТОГДА
// Н.НачислениеУдержание.ОсновнойВидРасчета ИНАЧЕ Н.НачислениеУдержание КОНЕЦ` поле `.Порядок` платформа берёт у
// перечислений из ветви ИНАЧЕ - `CASE WHEN <перечисление 1> THEN T2._EnumOrder WHEN <перечисление 2> THEN
// T3._EnumOrder ELSE NULL END`.
Function CaseUnionOrigin(First, Types)

	If First = Undefined Or Types = Undefined Then
		Return First;
	EndIf;
	Own = New Map;
	AddOriginTypes(Own, "CASE", First);
	Mine = Own.Get("CASE");
	If Mine <> Undefined And Mine.Count() >= Types.Count() Then
		Return First;
	EndIf;
	Copy = New Structure;
	For Each Item In First Do
		Copy.Insert(Item.Key, Item.Value);
	EndDo;
	Copy.Insert("UnionType", New TypeDescription(Types));
	Return Copy;

EndFunction

// Таблица ссылки, которую даёт происхождение колонки. Пустая строка - не ссылка или не
// выводится; тогда сравнивать ветви не по чему.
Function OriginReferenceTarget(Origin)

	If Origin.Property("FieldName") And Origin.Property("LogicalName") Then
		Try
			Return ReferencedTableName(Origin.LogicalName, Origin.FieldName);
		Except
			Return "";
		EndTry;
	EndIf;
	If Origin.Property("LogicalName") And Not Origin.Property("Type") Then
		Return Origin.LogicalName;
	EndIf;
	Return "";

EndFunction

// Откуда взялась колонка временной таблицы. В метаданных её типа нет, но есть запрос,
// который таблицу заполняет: если колонка - это просто поле источника, то и тип у неё
// тот же. Без этого обращение через точку от колонки ВТ невозможно, а в отчётах
// такой приём встречается чаще всего.
// Типы, которые даёт эта ветвь объединения, - в накопитель по псевдониму колонки.
Procedure AddOriginTypes(Unions, Key, Origin)

	If Origin = Undefined Then
		Return;
	EndIf;

	Description = Undefined;
	If Origin.Property("Type") And Origin.Type <> Undefined Then
		Description = Origin.Type;
	ElsIf Origin.Property("LogicalName") And Origin.Property("FieldName") Then
		Owner = MetadataOf(Origin.LogicalName);
		If Owner <> Undefined Then
			Description = FieldTypeDescription(Owner, Origin.FieldName);
		EndIf;
	EndIf;
	If Description = Undefined Then
		Return;
	EndIf;

	Bucket = Unions.Get(Key);
	If Bucket = Undefined Then
		Bucket = New Array;
		Unions.Insert(Key, Bucket);
	EndIf;
	For Each Item In Description.Types() Do
		If Bucket.Find(Item) = Undefined Then
			Bucket.Add(Item);
		EndIf;
	EndDo;

EndProcedure

Function TempTableColumnSources(Definition, Context, Columns)

	Sources = New Map;
	If Definition.Operators.Count() = 0 Then
		Return Sources;
	EndIf;

	// Состав типов колонки - объединение по всем ветвям. Прежде брался состав первой
	// ветви, где он вообще есть, и там, где поле есть у типа первой ветви, это давало не
	// отказ, а молча неверный SQL: одно соединение и одна ветвь ВЫБОРа вместо нескольких,
	// и строки остальных типов получали NULL вместо значения.
	Unions = New Map;

	// Ветвей у объединения несколько, и первая сплошь и рядом заглушка: НЕОПРЕДЕЛЕНО
	// или пустая ссылка. Тип колонки берётся из первой ветви, где он вообще есть.
	For Each Operator In Definition.Operators Do
		// Контекст одноразовый: соединения, которые попутно зарегистрируются, никуда не идут.
		Probe = NewContext(Context.Options, New Array, Context.TempTables, "TT");
		Try
			CollectSources(Operator, Probe);
		Except
			Continue;
		EndTry;

		For Index = 0 To BranchFieldCount(Definition, Operator) - 1 Do
			If Index >= Definition.Columns.Count() Then
				Break;
			EndIf;
			Alias = TrimAll(Definition.Columns[Index].Alias);
			If IsBlankString(Alias) Then
				Continue;
			EndIf;

			Text = ColumnFieldText(Definition, Operator, Index);

			BranchOrigin = ColumnOrigin(Text, Probe);
			If Sources.Get(Upper(Alias)) = Undefined And BranchOrigin <> Undefined Then
				Sources.Insert(Upper(Alias), BranchOrigin);
			EndIf;
			AddOriginTypes(Unions, Upper(Alias), BranchOrigin);

			If Columns.Get(Upper(Alias)) = Undefined Then
				Composite = CompositePartsOfExpression(Text, Probe);
				If Composite.Parts.Count() > 0 Then
					Names = New Array;
					For Each Part In Composite.Parts Do
						Names.Add(PartAlias(Alias, Part));
					EndDo;
					Columns.Insert(Upper(Alias), Names);
				EndIf;
			EndIf;
		EndDo;
	EndDo;

	// Объединение прикрепляется отдельным ключом: его читает только разбор по ветвям.
	// Одиночная навигация продолжает смотреть на Type - иначе широкий состав превратил бы
	// работающие переводы в отказы «колонка держит N типов, переход невозможен».
	For Each Entry In Unions Do
		Origin = Sources.Get(Entry.Key);
		If Origin = Undefined Or Entry.Value.Count() < 2 Then
			Continue;
		EndIf;
		Own = 0;
		If Origin.Property("Type") And Origin.Type <> Undefined Then
			Own = Origin.Type.Types().Count();
		EndIf;
		If Own >= Entry.Value.Count() Then
			Continue;
		EndIf;
		Origin.Insert("UnionType", New TypeDescription(Entry.Value));
	EndDo;

	// Какие части таблица действительно несёт, знает PlacementPartSuffixes - он же решает
	// это при выводе. У вычисляемой колонки (ВЫБОР, ЕСТЬNULL, ветвь объединения)
	// CompositePartsOfExpression частей не находит, а в таблице они лежат: читающий запрос
	// видел одну колонку, хотя рядом стояли C_TYPE и C_RRRef. Объявляем по одному правилу.
	Named = New Map;
	For Each Column In Definition.Columns Do
		Alias = TrimAll(Column.Alias);
		If Not IsBlankString(Alias) Then
			Named.Insert(Upper(Alias), Alias);
		EndIf;
	EndDo;

	For Each Entry In PlacementPartSuffixes(Definition, Context) Do
		Alias = Named.Get(Entry.Key);
		If Alias = Undefined Then
			Continue;
		EndIf;
		Existing = Columns.Get(Entry.Key);
		If Existing <> Undefined Then
			// Колонку уже описала первая ветвь с хранимым составным полем, но таблица несёт
			// части всех ветвей: у регистратора рядом с НЕОПРЕДЕЛЕНО есть и тег. Без него
			// «ТТ.Док = НЕОПРЕДЕЛЕНО» сворачивалось в ложь (сверка battery25: 1С 46, SQL 0).
			For Each Suffix In Entry.Value Do
				If Existing.Find(Alias + Suffix) = Undefined Then
					Existing.Add(Alias + Suffix);
				EndIf;
			EndDo;
			Continue;
		EndIf;
		Names = New Array;
		For Each Suffix In Entry.Value Do
			Names.Add(Alias + Suffix);
		EndDo;
		If Names.Count() > 1 Then
			Columns.Insert(Entry.Key, Names);
		EndIf;
	EndDo;

	Return Sources;

EndFunction

Function QuerySql(Query, Opt, Warnings, TempTables, AliasPrefix = "T", ExposeParts = False, FinalResult = False,
	InOperand = False)

	If Query.SelectAllowed Then
		AddOnce(Warnings, "ALLOWED is ignored: record level security is not applied, the SQL returns every row.");
	EndIf;

	If Query.Order.Count() > 0 And Query.Operators.Count() > 1 Then
		Warnings.Add("ORDER BY applies to the whole union.");
	EndIf;

	// Everything except FROM is translated first: navigation through a dot adds joins
	// while expressions are being rewritten, and FROM has to know about them.
	NoteUnionColumnParameterTypes(Query, Opt, TempTables);
	// Какие колонки запроса остались без базовой колонки, записывает выборка (PartsOnlyPlacement).
	// Запись есть - решение по таблице этого запроса известно (PlacedStubs).
	If Opt.Property("PartsOnlyStubQueries") And Opt.PartsOnlyStubQueries.Get(Query) = Undefined Then
		Opt.PartsOnlyStubQueries.Insert(Query, New Map);
	EndIf;
	If Not FinalResult Then
		CheckUnionLiteralKinds(Query);
	EndIf;

	SharedSuffixes = Undefined;
	If Not IsBlankString(Query.PlacementTable) Or ExposeParts Then
		SharedSuffixes = PlacementPartSuffixes(Query,
			NewContext(Opt, Warnings, TempTables, AliasPrefix));
	EndIf;

	Blocks = New Array;
	For OperatorIndex = 0 To Query.Operators.Count() - 1 Do
		Operator = Query.Operators[OperatorIndex];
		Context = NewContext(Opt, Warnings, TempTables, AliasPrefix);
		Context.Query = Query;
		Context.ExposeCompositeParts = ExposeParts;
		Context.FinalResult = FinalResult;
		Context.PartSuffixes = SharedSuffixes;
		ByBranch = Query.Operators.Count() > 1 And Opt.Property("PartsOnlyAliasReads")
			And Opt.Property("PartsOnlyRefs") And Opt.Property("PartsOnlyBranchRefusal");
		If ByBranch Then
			ReadsBefore = New Map;
			For Each Pair In Opt.PartsOnlyAliasReads Do
				ReadsBefore.Insert(Pair.Key, Pair.Value);
			EndDo;
			RefsBefore = New Map;
			For Each Pair In Opt.PartsOnlyRefs Do
				RefsBefore.Insert(Pair.Key, Pair.Value);
			EndDo;
		EndIf;
		CollectSources(Operator, Context);
		Block = OperatorBlock(Operator, Query, Context, OperatorIndex = 0);
		Blocks.Add(Block);
		If ByBranch Then
			// Ветвь объединения проверена по своему тексту - со своими псевдонимами. Дальше её
			// псевдонимы считаются прочитанными законно, а обращения, записанные в ней, снимаются:
			// у следующей ветви те же T1, T2 … - уже другие источники.
			If IsBlankString(Opt.PartsOnlyBranchRefusal) Then
				Opt.PartsOnlyBranchRefusal = PartsOnlyScan(Block, Opt, True);
			EndIf;
			Checked = New Array;
			For Each Pair In Opt.PartsOnlyAliasReads Do
				If Pair.Value = False And ReadsBefore.Get(Pair.Key) <> False Then
					Checked.Add(Pair.Key);
				EndIf;
			EndDo;
			For Each ReadKey In Checked Do
				Opt.PartsOnlyAliasReads.Insert(ReadKey, True);
			EndDo;
			Opt.Insert("PartsOnlyRefs", RefsBefore);
		EndIf;
	EndDo;

	Hidden = Undefined;
	If Query.Order.Count() > 0 And HierarchyInSelection(Query)
		And (FinalResult Or Not IsBlankString(Query.PlacementTable)) Then
		Hidden = HierarchyHiddenColumns(Query, Blocks, FinalResult);
		Blocks[0].Context.Insert("HierarchyHidden", Hidden);
	EndIf;
	RefuseDistinctOverCarried(Blocks);
	If Not FinalResult And Not InOperand And (Not IsBlankString(Query.PlacementTable) Or ExposeParts) Then
		CarryPresentationReferences(Query, Blocks, Opt);
	ElsIf FinalResult Then
		Hidden = UnionPresentationKeys(Query, Blocks, Hidden);
	EndIf;
	// РАЗЛИЧНЫЕ с представлением ссылки (замер op6, op7) и порядок по Представлению в нём (op1-op3).
	Hidden = DistinctPresentationColumns(Query, Blocks, FinalResult, Hidden, InOperand);
	If Query.Order.Count() > 0 And (Blocks.Count() > 1 Or Query.Operators[0].SelectDistinct) Then
		Hidden = PresentationHiddenColumns(Query, Blocks, FinalResult, Hidden);
	EndIf;
	If Hidden <> Undefined Then
		Blocks[0].Context.Insert("HierarchyHidden", Hidden);
	EndIf;

	OrderPart = "";
	If Query.Order.Count() > 0 Then
		// УПОРЯДОЧИТЬ ПО переводится после сборки блоков: его точки регистрируют свои
		// соединения, и присоединённые колонки обязаны попасть в GROUP BY так же, как
		// колонки списка выборки. Текст блока ещё не собран, группировку можно дополнить.
		OrderContext = Blocks[0].Context;
		NavigationMark = OrderContext.NavigationColumns.Count();
		CompositeMark = OrderContext.CompositeColumns.Count();
		OrderPart = OrderSql(Query, OrderContext);

		// Если РАЗЛИЧНЫЕ заменено группировкой по списку выборки (fix_order_distinct),
		// группировка там и есть весь список выборки: добор в неё измельчил бы результат.
		GroupIsSelection = False;
		If Not OrderContext.Property("GroupInsteadOfDistinct", GroupIsSelection) Then
			// Правка про РАЗЛИЧНЫЕ не применена - признака в контексте нет.
			GroupIsSelection = False;
		EndIf;

		If Blocks[0].Group.Count() > 0 And Not GroupIsSelection Then
			OrderColumns = New Array;
			For Index = NavigationMark To OrderContext.NavigationColumns.Count() - 1 Do
				OrderColumns.Add(OrderContext.NavigationColumns[Index]);
			EndDo;
			For Index = CompositeMark To OrderContext.CompositeColumns.Count() - 1 Do
				OrderColumns.Add(OrderContext.CompositeColumns[Index]);
			EndDo;

			// Аргумент агрегата в порядке группировки не требует: УПОРЯДОЧИТЬ ПО
			// МАКСИМУМ(Т.Ссылка.Дата) уводил дату в GROUP BY (сверка battery27: 1С 9, SQL 98).
			OrderBare = WithoutGroupedExpressions(WithoutAggregateCalls(OrderPart), Blocks[0].Group);
			Candidates = New Array;
			For Each Column In OrderColumns Do
				If MentionsWholeColumn(OrderBare, Column)
					And Blocks[0].Group.Find(Column) = Undefined
					And Candidates.Find(Column) = Undefined Then
					Candidates.Add(Column);
				EndIf;
			EndDo;
			AddDeterminedColumns(Blocks[0].Group, Candidates, OrderContext);
		EndIf;
	EndIf;

	ConstantFalseOperators(Blocks, Query);

	Parts = New Array;
	PartsWrapped = False;
	For OperatorIndex = 0 To Blocks.Count() - 1 Do
		If OperatorIndex > 0 Then
			UnionType = Query.Operators[OperatorIndex].UnionType;
			Parts.Add(?(UnionType = QuerySchemaUnionType.UnionAll, "UNION ALL", "UNION"));
		EndIf;
		PartText = AssembleOperator(Blocks[OperatorIndex]);
		If Not IsBlankString(OrderPart) And Blocks.Count() > 1 And Opt.Dialect = "MSSQL"
			And Query.Operators[OperatorIndex].RetrievedRecordsCount <> Undefined Then
			PartName = AliasPrefix + "U" + Format(OperatorIndex + 1, "NG=0");
			PartText = "SELECT " + PartName + ".* FROM (" + Chars.LF + PartText + Chars.LF
				+ OrderPart + Chars.LF + ") AS " + PartName;
			PartsWrapped = True;
		EndIf;
		Parts.Add(PartText);
	EndDo;

	// Во временной таблице общий порядок после обёртки частей не нужен и не допустим:
	// внешний SELECT выражения WITH остался без TOP, а отбор строк уже сделан в частях.
	If Hidden <> Undefined Then
		// Скрытые колонки порядка остаются внутри: результат - колонки запроса, порядок - снаружи.
		// У одиночного РАЗЛИЧНЫЕ ПЕРВЫЕ порядок нужен и внутри - он решает, какие строки отобраны.
		If Blocks.Count() = 1 And Query.Operators[0].RetrievedRecordsCount <> Undefined
			And Opt.Dialect = "MSSQL" Then
			Parts.Add(OrderPart);
		EndIf;
		Inner = StrConcat(Parts, Chars.LF);
		Parts = New Array;
		Parts.Add("SELECT " + StrConcat(Blocks[0].Context.OutputNames, ", ") + Chars.LF + "FROM (" + Chars.LF
			+ Inner + Chars.LF + ") AS " + AliasPrefix + "H");
		// Во временной таблице порядок бывает только с ПЕРВЫЕ (без них платформа запрос отвергает, замер p8e), и он
		// уже стоит внутри: снаружи общее табличное выражение без TOP его не примет.
		If IsBlankString(Query.PlacementTable) Then
			Parts.Add(OrderPart);
		EndIf;
	ElsIf Not IsBlankString(OrderPart)
		And Not (PartsWrapped And Not IsBlankString(Query.PlacementTable)) Then
		Parts.Add(OrderPart);
	EndIf;

	FirstOperator = Query.Operators[0];
	If FirstOperator.RetrievedRecordsCount <> Undefined And Opt.Dialect = "PostgreSQL" Then
		Parts.Add("LIMIT " + Format(FirstOperator.RetrievedRecordsCount, "NG=0; NZ=0"));
	EndIf;

	Return StrConcat(Parts, Chars.LF);

EndFunction

// Оператор, у которого условие отбора без колонок ложно, платформа из запроса выбрасывает:
// условие из параметров и литералов она вычисляет сама, до СУБД. Заметно это только у
// оператора с агрегатом без группировки - на пустом отборе СУБД отдаёт ему строку с NULL,
// а выброшенный оператор строки не даёт. Если выброшены все операторы, у итогового и
// вложенного запроса остаётся первый, у ПОМЕСТИТЬ - ни одного. Замер 15.11.2026 (УХ,
// probe51..54): СУММА(1) ГДЕ &УсловиеОтбора = Ложь во второй ветви ОБЪЕДИНИТЬ ВСЕ строки не
// даёт, а одна такая ветвь в итоговом запросе даёт NULL. Значение параметра при переводе
// неизвестно, поэтому решение переносится в СУБД: оператору с агрегатом без группировки
// условие ставится ещё и в HAVING, а первому - вместе с «выброшены все остальные».
Procedure ConstantFalseOperators(Blocks, Query)

	Temporary = Not IsBlankString(Query.PlacementTable);
	First = Blocks[0];
	Matters = False;
	For Each Block In Blocks Do
		Matters = Matters Or (AggregateRow(Block) And Block.FieldFree.Count() > 0);
	EndDo;
	If Not Matters Then
		Return;
	EndIf;
	// Первый оператор остаётся при выброшенных остальных: тогда нужно, есть ли каждый из них.
	Fallback = Not Temporary And Blocks.Count() > 1 And AggregateRow(First) And First.FieldFree.Count() > 0;

	Present = New Array;
	For Each Block In Blocks Do
		Needed = AggregateRow(Block) Or Fallback;
		Present.Add(?(Needed, PresenceCondition(Block), ""));
	EndDo;

	For Index = 0 To Blocks.Count() - 1 Do
		Block = Blocks[Index];
		If Not AggregateRow(Block) Or IsBlankString(Present[Index]) Then
			Continue;
		EndIf;
		If Index > 0 Or Temporary Then
			Block.Having.Add(Present[Index]);
		ElsIf Blocks.Count() > 1 Then
			Others = New Array;
			For Other = 1 To Blocks.Count() - 1 Do
				If IsBlankString(Present[Other]) Then
					// Этот оператор есть всегда, и первый без своего условия не остаётся.
					Others = Undefined;
					Break;
				EndIf;
				Others.Add(Present[Other]);
			EndDo;
			Block.Having.Add(?(Others = Undefined, Present[Index],
				"(" + Present[Index] + " OR NOT (" + StrConcat(Others, " OR ") + "))"));
		EndIf;
	EndDo;

EndProcedure

// Оператор с агрегатом без группировки: на пустом отборе СУБД отдаёт ему одну строку.
Function AggregateRow(Block)
	Return Block.Group.Count() = 0 And SelectionHasAggregate(Block.Operator);
EndFunction

// Условие SQL, при котором оператор у платформы остаётся в запросе: его условия без колонок
// вместе; "" - оператор есть всегда. Формы, вычисление которых платформой не замерено,
// дают отказ: строки она сравнивает то сама, то нет (&S <> "" выбросила, &S = "а" - нет), В
// не вычисляет, а у сравнения двух параметров тип при переводе неизвестен.
Function PresenceCondition(Block)

	Parts = New Array;
	For Each Condition In Block.FieldFree Do
		If Not FoldedByPlatform(Condition.Text) Then
			Raise StrTemplate("The condition ""%1"" holds no column, and the platform drops an operator whose such"
				+ " condition is false, which changes the rows of an aggregate without grouping. Whether the platform"
				+ " computes a condition of this form itself is not measured. Move the condition out of the query or"
				+ " write it with a Boolean parameter.", TrimAll(Condition.Text));
		EndIf;
		Parts.Add(Condition.Sql);
	EndDo;
	Return StrConcat(Parts, " AND ");

EndFunction

// Вычисляет ли платформа условие Text (без колонок) сама. Замерено: булев параметр, литерал
// ИСТИНА/ЛОЖЬ, И/ИЛИ/НЕ над ними; сравнение параметра или числа с числом, датой,
// ЗНАЧЕНИЕ(...), ИСТИНА/ЛОЖЬ; параметр ЕСТЬ NULL.
Function FoldedByPlatform(Text)

	Rest = " " + Upper(Text) + " ";
	If StrFind(Rest, """") > 0 Then
		Return False;
	EndIf;
	// Литералы с аргументами - одним словом.
	For Each Head In StrSplit("ДАТАВРЕМЯ(,DATETIME(,ЗНАЧЕНИЕ(,VALUE(", ",") Do
		Position = StrFind(Rest, Head);
		While Position > 0 Do
			Close = StrFind(Rest, ")", , Position);
			If Close = 0 Then
				Return False;
			EndIf;
			Rest = Left(Rest, Position - 1) + " #LIT " + Mid(Rest, Close + 1);
			Position = StrFind(Rest, Head);
		EndDo;
	EndDo;
	Rest = StrReplace(StrReplace(Rest, "(", " "), ")", " ");
	Signs = StrSplit("<>,<=,>=,=,<,>", ",");
	Tokens = StrSplit("#NE,#LE,#GE,#EQ,#LT,#GT", ",");
	For Position = 0 To Signs.UBound() Do
		Rest = StrReplace(Rest, Signs[Position], " " + Tokens[Position] + " ");
	EndDo;
	Words = StrSplit(Rest, " " + Chars.Tab + Chars.LF + Chars.CR, False);
	Joints = StrSplit("И,ИЛИ,AND,OR", ",");
	Atom = New Array;
	Index = 0;
	While Index <= Words.Count() Do
		Word = ?(Index < Words.Count(), Words[Index], "И");
		Index = Index + 1;
		If Joints.Find(Word) <> Undefined Then
			If Not FoldedAtom(Atom) Then
				Return False;
			EndIf;
			Atom = New Array;
		ElsIf Word <> "НЕ" And Word <> "NOT" Then
			Atom.Add(Word);
		EndIf;
	EndDo;
	Return True;

EndFunction

// Слова одного сравнения FoldedByPlatform: вычисляет ли его платформа.
Function FoldedAtom(Words)

	Booleans = StrSplit("ИСТИНА,ЛОЖЬ,TRUE,FALSE", ",");
	If Words.Count() = 1 Then
		Return StrStartsWith(Words[0], "&") Or Booleans.Find(Words[0]) <> Undefined;
	ElsIf Words.Count() = 3 And StrStartsWith(Words[0], "&")
		And (Words[1] = "ЕСТЬ" Or Words[1] = "IS") And Words[2] = "NULL" Then
		Return True;
	ElsIf Words.Count() <> 3 Or StrSplit("#NE,#LE,#GE,#EQ,#LT,#GT", ",").Find(Words[1]) = Undefined Then
		Return False;
	EndIf;
	// Одна сторона - параметр или число, другая - литерал не строки: тип известен.
	Operand = Words[0];
	Literal = Words[2];
	If Not (StrStartsWith(Operand, "&") Or IsNumberWord(Operand)) Then
		Operand = Words[2];
		Literal = Words[0];
	EndIf;
	Return (StrStartsWith(Operand, "&") Or IsNumberWord(Operand))
		And (IsNumberWord(Literal) Or Literal = "#LIT" Or Booleans.Find(Literal) <> Undefined);

EndFunction

Function IsNumberWord(Word)
	Digits = ?(StrStartsWith(Word, "-"), Mid(Word, 2), Word);
	Digits = StrReplace(Digits, ".", "");
	If IsBlankString(Digits) Then
		Return False;
	EndIf;
	For Position = 1 To StrLen(Digits) Do
		If Not IsDigit(Mid(Digits, Position, 1)) Then
			Return False;
		EndIf;
	EndDo;
	Return True;
EndFunction

// Тип параметра, который стоит колонкой в ветви объединения. Своего типа у него нет, а
// у парной колонки другой ветви он есть: у объединения колонки позиционно парные, и тип
// у пары обязан быть один. Считается один раз на запрос, до перевода операторов.
Procedure NoteUnionColumnParameterTypes(Query, Opt, TempTables)

	If Query.Operators.Count() < 2 Then
		Return;
	EndIf;

	Writer = NewContext(Opt, New Array, TempTables, "TT");
	Names = New Map;
	Types = New Map;

	For Each Operator In Query.Operators Do
		// Контекст одноразовый: соединения, которые попутно зарегистрируются, никуда не идут.
		Probe = NewContext(Opt, New Array, TempTables, "TT");
		Try
			CollectSources(Operator, Probe);
		Except
			Continue;
		EndTry;

		For Index = 0 To BranchFieldCount(Query, Operator) - 1 Do
			Text = TrimAll(ColumnFieldText(Query, Operator, Index));
			If StrLen(Text) > 1 And Left(Text, 1) = "&" And StrFind(Text, " ") = 0 Then
				List = Names.Get(Index);
				If List = Undefined Then
					List = New Array;
					Names.Insert(Index, List);
				EndIf;
				List.Add(Mid(Text, 2));
				Continue;
			EndIf;
			If Types.Get(Index) <> Undefined Then
				Continue;
			EndIf;
			SqlType = SqlTypeOfExpression(Text, Probe);
			If Not IsBlankString(SqlType) Then
				Types.Insert(Index, SqlType);
			EndIf;
		EndDo;
	EndDo;

	For Each Item In Names Do
		// Два параметра в одной колонке объединения: тип у пары один, и тип, выведенный
		// для одного из них в другом месте запроса, достаётся и второму (УХ 47081:
		// &НачалоПериода КАК Период ... ОБЪЕДИНИТЬ ВСЕ ... &КонецПериода).
		For Position = 1 To Item.Value.Count() - 1 Do
			LinkParameterTypes(Item.Value[0], Item.Value[Position], Writer);
		EndDo;
		SqlType = Types.Get(Item.Key);
		If SqlType = Undefined Then
			Continue;
		EndIf;
		For Each Name In Item.Value Do
			RememberParameterType(Name, SqlType, Writer);
		EndDo;
	EndDo;

EndProcedure

// Translates everything of one SELECT operator except FROM, which is built later:
// by then the expressions have registered the joins that reference navigation needs.
Function OperatorBlock(Operator, Query, Context, IsFirstOperator)

	Context.GroupInsteadOfDistinct = DistinctOrderNeedsGrouping(Operator, Query);

	Header = "SELECT";
	If Operator.SelectDistinct And Not Context.GroupInsteadOfDistinct Then
		Header = Header + " DISTINCT";
	EndIf;
	If Operator.RetrievedRecordsCount <> Undefined And Context.Options.Dialect = "MSSQL" Then
		Header = Header + " TOP " + Format(Operator.RetrievedRecordsCount, "NG=0; NZ=0");
	EndIf;

	Where = New Array;
	Having = New Array;
	// Условия отбора без колонок (одни параметры и литералы): по ним платформа решает, есть ли
	// оператор вообще - см. ConstantFalseOperators.
	FieldFree = New Array;
	Context.HavingInfo = New Array;
	Context.BooleanContext = True;
	Grouping = GroupCount(Operator) > 0 Or SelectionHasAggregate(Operator);
	// Группировка по ВЫБОР вне выборки, которую модель потеряла: оператор всё равно
	// сгруппирован - литералы ИМЕЮЩИЕ и выборки платформа пишет в тексте (gc2b: `> 0.0`).
	Loose = LooseGroupings(Operator, Query, Context);
	Grouping = Grouping Or Loose.Count() > 0;
	SavedInline = Context.LiteralsInline;
	For Each Condition In FilterConditions(Operator, Context) Do
		Mark = Context.CompositeColumns.Count();
		Context.LiteralsInline = Grouping And Condition.Aggregate;
		If Condition.Property("Sql") Then
			Translated = Condition.Sql;
		Else
			Translated = TranslateExpression(Condition.Text, Context);
		EndIf;
		Context.LiteralsInline = SavedInline;
		If Not Condition.Aggregate And Not MentionsColumn(Translated) Then
			FieldFree.Add(New Structure("Text, Sql", Condition.Text, GroupedCondition(Translated)));
		EndIf;
		// Список условий склеивается через AND, поэтому условие с ИЛИ верхнего уровня
		// обязано прийти в скобках - иначе оно распадётся.
		If Condition.Aggregate Then
			Having.Add(GroupedCondition(Translated));
			// Колонки этого условия нужны дальше: неагрегированные из них обязаны
			// стоять в GROUP BY, как их ставит платформа (эталон 9504).
			Info = New Structure;
			Info.Insert("Expression", Translated);
			Info.Insert("Columns", ColumnsOfExpression(Context, Mark, Translated));
			Context.HavingInfo.Add(Info);
		Else
			Where.Add(GroupedCondition(Translated));
		EndIf;
	EndDo;

	Context.BooleanContext = False;

	// Группировку платформа пишет тем же текстом, что и поле выборки, - с литералами в тексте
	// (`THEN 35.0`); с параметром NUMERIC(10) ВЫБОР в выборке не совпадал с группировкой, и СУБД
	// отвергала запрос (ворота 55, УХ: 5 запросов).
	Group = New Array;
	SetGroups = Undefined;
	Context.LiteralsInline = Grouping;
	If Operator.Group = Undefined Then
		// Группирующие наборы (GroupingSetsOfText): общий список - для правил добора ниже, наборы -
		// для вывода GROUP BY GROUPING SETS (замер 18.11.2026, УХ, gs_uh gs1-gs5).
		SetGroups = New Array;
		For Each Set In OperatorGroupingSets(Operator, Context) Do
			SetGroup = New Array;
			For Each Item In Set Do
				AddGroupExpressions(SetGroup, Item, Context);
			EndDo;
			DropConstantGroups(SetGroup);
			SetGroups.Add(SetGroup);
			For Each Column In SetGroup Do
				If Group.Find(Column) = Undefined Then
					Group.Add(Column);
				EndIf;
			EndDo;
		EndDo;
	Else
		For Each Expression In Operator.Group Do
			AddGroupExpressions(Group, String(Expression), Context);
		EndDo;
	EndIf;
	Context.LiteralsInline = SavedInline;
	DropConstantGroups(Group);

	Block = New Structure;
	Block.Insert("Operator", Operator);
	Block.Insert("Context", Context);
	Block.Insert("Header", Header);
	Context.LiteralsInline = Grouping;
	Block.Insert("Fields", SelectedFieldsSql(Operator, Query, Context, IsFirstOperator));
	Context.LiteralsInline = SavedInline;

	// Представление ссылки платформа выбрасывает из группировок модели: она считает его
	// после чтения, а группирует по самой ссылке. В модели такой группировки не видно,
	// и восстанавливается она по колонкам ссылки - но только у того поля, выражения
	// которого в группировках нет. Сгруппированное целиком выражение трогать нельзя.
	// Сгруппированный ВЫБОР модель в группировках не хранит (замер: Group пуст). Он
	// возвращается сюда из списка выборки - целым выражением, как его пишет платформа
	// (замер 9603), оператору с агрегатом или с другими группировками: там поле вне
	// агрегата обязано быть сгруппировано. Оператору без того и другого - только когда
	// по тексту видно, что выражение выбирают одни сгруппированные операторы. Кто
	// востребовал выражение, запоминается - по этому счёту в конце видно, осталась ли
	// группировка без своего оператора.
	Aggregating = Group.Count() > 0 Or SelectionHasAggregate(Operator);
	Named = ?(Context.Options.Property("BranchingGroups"), Context.Options.BranchingGroups, Undefined);
	For Each Info In Context.SelectedInfo Do
		If Info.Aggregate Or IsBlankString(Info.Branching) Then
			Continue;
		EndIf;
		Entry = ?(Named = Undefined, Undefined, Named.Get(Info.Branching));
		If Entry = Undefined Then
			// Текст запроса это выражение не группирует: значит, его определяют другие
			// группировки, и колонки добирает общий путь ниже - по доказательству.
			Continue;
		EndIf;
		If Not Aggregating And Entry.Selected <> Entry.Count Then
			// То же выражение просто выбирает ещё и несгруппированный оператор: без
			// агрегата и без других группировок отличить один от другого нечем.
			Continue;
		EndIf;
		If Entry.Kind = "IsNull" And Not IsNullOverUuid(Info.Branching, Context) Then
			// ЕСТЬNULL модель хранит, кроме ЕСТЬNULL над уникальным идентификатором (gb01-gb03); составное значение
			// она группирует частями, и базовой колонки в GROUP BY быть не должно (mv92).
			Continue;
		EndIf;
		Claimed = Info.Expression;
		If Entry.Kind = "Presentation" Then
			// Группирует платформа по самой ссылке, а представление считает после.
			Claimed = Context.PresentationGrouping.Get(Info.Expression);
			If Claimed = Undefined Then
				Continue;
			EndIf;
		ElsIf Not MentionsColumn(Info.Expression) Then
			// Выражение без колонок - константа. Рядом с агрегатом группировка по ней
			// ничего не меняет, а без агрегата сворачивает все строки в одну, и
			// выразить это группировкой SQL нельзя.
			If Not Aggregating Then
				Continue;
			EndIf;
			Claimed = Undefined;
		EndIf;
		If Entry.Operators.Find(Operator) = Undefined Then
			Entry.Operators.Add(Operator);
		EndIf;
		If Claimed <> Undefined And Group.Find(Claimed) = Undefined Then
			Group.Add(Claimed);
		EndIf;
	EndDo;

	// Группировка по ВЫБОР, которого нет в выборке: выражение - из текста оператора, место - как
	// в тексте (gc3: `GROUP BY T1._Fld24004RRef, CASE … END`). Если модель её сохранила, перевод
	// тот же и второй раз не добавляется (gc1).
	Front = 0;
	For Each Claim In Loose Do
		If Context.GroupInsteadOfDistinct Then
			// Группировка ниже собирается заново из списка выборки, и эта бы пропала.
			Claim.Hit.Failure = "GROUP BY holds a CASE that is not a field of its SELECT, and the SELECT"
				+ " is DISTINCT with an ORDER BY that the translation turns into a grouping over the select"
				+ " list: the two groupings cannot be combined. Remove DISTINCT, or add the expression to"
				+ " the select list.";
			Continue;
		EndIf;
		Single = "";
		Columns = LooseGroupColumns(Claim.Hit, Context, Single);
		If Columns = Undefined Then
			Continue;
		EndIf;
		If Claim.Entry.Operators.Find(Operator) = Undefined Then
			Claim.Entry.Operators.Add(Operator);
		EndIf;
		// Модель группировку сохранила, и общий путь перевёл её одной колонкой ссылки: части
		// встают на её место (gc2b - таблица и ссылка).
		Position = ?(IsBlankString(Single), Undefined, Group.Find(Single));
		If Position <> Undefined Then
			Group.Delete(Position);
			For Each Column In Columns Do
				If Group.Find(Column) = Undefined Then
					Group.Insert(Position, Column);
					Position = Position + 1;
				EndIf;
			EndDo;
			Continue;
		EndIf;
		For Each Column In Columns Do
			If Group.Find(Column) <> Undefined Then
				Continue;
			EndIf;
			If Claim.Hit.Leading Then
				Group.Insert(Front, Column);
				Front = Front + 1;
			Else
				Group.Add(Column);
			EndIf;
		EndDo;
	EndDo;

	// Добор стоит после возврата потерянных группировок: у запроса, где сгруппировано
	// одно ПРЕДСТАВЛЕНИЕ, список до этого места пуст, а наименование группировки требует.
	If Group.Count() > 0 Then
		For Each Column In Context.NavigationColumns Do
			If Group.Find(Column) <> Undefined Then
				Continue;
			EndIf;
			// Проверять вхождение во весь список выборки нельзя: аргумент агрегата в нём
			// тоже встречается, и колонка уезжала в GROUP BY, убивая сам агрегат -
			// вместо одной строки на ключ выходила строка на каждую пару «ключ -
			// значение». Замерено: 1С 0 строк, обработка 39. Группировки требует только
			// колонка, стоящая в выборке сама по себе, вне агрегата.
			If UsedOutsideAggregate(Column, Context, Group) Then
				Group.Add(Column);
			EndIf;
		EndDo;
	EndIf;

	If Group.Count() > 0 Or SelectionHasAggregate(Operator) Then
		// Решение принимается не по одной колонке за раз: определителем бывает колонка
		// из другого поля выборки, поэтому сначала собирается весь список кандидатов.
		Pending = New Array;
		For Each Info In Context.SelectedInfo Do
			If Info.Columns.Count() = 0 Or Group.Find(Info.Expression) <> Undefined Then
				Continue;
			EndIf;
			// У выражения с агрегатом кандидаты - только колонки, стоящие вне агрегатных
			// вызовов: ВЫБОР КОГДА Док.Проведен ТОГДА СУММА(...) требует Проведен в
			// группировке, и платформа его туда дописывает (замер 9601). Аргумент агрегата
			// добирать нельзя - он убил бы сам агрегат.
			Bare = ?(Info.Aggregate, WithoutAggregateCalls(Info.Expression), "");
			For Each Column In Info.Columns Do
				If Info.Aggregate And StrFind(Bare, Column) = 0 Then
					Continue;
				EndIf;
				If Group.Find(Column) = Undefined And Pending.Find(Column) = Undefined Then
					Pending.Add(Column);
				EndIf;
			EndDo;
		EndDo;
		// Колонка, упомянутая только в ИМЕЮЩИЕ, кандидат на тех же правах: условие
		// целиком осталось в HAVING из-за агрегата рядом, а сама колонка не агрегирована.
		For Each Info In Context.HavingInfo Do
			Bare = WithoutAggregateCalls(Info.Expression);
			For Each Column In Info.Columns Do
				If StrFind(Bare, Column) > 0 And Group.Find(Column) = Undefined
					And Pending.Find(Column) = Undefined Then
					Pending.Add(Column);
				EndIf;
			EndDo;
		EndDo;
		AddDeterminedColumns(Group, Pending, Context);
	EndIf;
	// Подколонки составного поля, вынесенные в выборку, тоже обязаны быть в GROUP BY:
	// само поле сгруппировано, но функциональной зависимости T-SQL не знает. Часть,
	// собранная из агрегатов (ВЫБОР КОГДА КОЛИЧЕСТВО(...) = 0 ... МАКСИМУМ(...)), сама
	// агрегат: в группировке T-SQL её отвергает (замер: три запроса ERP, ворота 44).
	If Group.Count() > 0 Then
		For Each Column In Context.PlacementParts Do
			If Group.Find(Column) = Undefined And WithoutAggregateCalls(Column) = Column Then
				Group.Add(Column);
			EndIf;
		EndDo;
	EndIf;

	// Список выборки становится группировкой: строки те же, что у РАЗЛИЧНЫЕ, но элемент
	// порядка T-SQL теперь принимает - под агрегатной функцией.
	If Context.GroupInsteadOfDistinct Then
		Group.Clear();
		For Each Info In Context.SelectedInfo Do
			// Колонки разнотипного составного значения в выборке нет - группировать по ней
			// нельзя: замерено, СУБД отвечает «Invalid column name VATRate» (три запроса
			// ERP, пойманы прогоном связывания). Части этого значения добавляются ниже,
			// из PlacementParts, и различают строки так же, как платформа.
			If Context.OmittedBase.Find(Info.Expression) <> Undefined Then
				Continue;
			EndIf;
			If Group.Find(Info.Expression) = Undefined Then
				Group.Add(Info.Expression);
			EndIf;
		EndDo;
		DropConstantGroups(Group);
		// Подколонки составного значения в SelectedInfo не попадают - их выводит список
		// выборки отдельными колонками, - а группировкой здесь становится весь список
		// выборки. Без них T-SQL отвергает запрос. И по существу так же: РАЗЛИЧНЫЕ у
		// платформы различает по всем частям сразу, а группировка по одной колонке
		// ссылки грубее - значения разных типов с одним uuid слились бы в одну строку.
		For Each Column In Context.PlacementParts Do
			If Group.Find(Column) = Undefined Then
				Group.Add(Column);
			EndIf;
		EndDo;
	EndIf;

	// Выражение представления смотрит на саму колонку ссылки - оно различает пустую
	// ссылку и NULL. В сгруппированном блоке такая колонка обязана быть в группировке:
	// этого требует и СУБД, и платформа - группировка по представлению у неё есть
	// группировка по ссылке. Под агрегатом добирать нельзя: МАКСИМУМ(ПРЕДСТАВЛЕНИЕ(X))
	// группировки по X не требует, а добор расщепил бы группы.
	If Group.Count() > 0 Then
		For Each Pair In Context.PresentationGrouping Do
			If Not UsedOutsideAggregate(Pair.Key, Context) Then
				Continue;
			EndIf;
			If Group.Find(Pair.Value) = Undefined Then
				Group.Add(Pair.Value);
			EndIf;
		EndDo;
		// Колонка-представление временной таблицы: группировка по ней - по всем её спутникам (замеры da2, da20,
		// db7, de7: `GROUP BY T1.…_00RRef, T1.…_01[, T1.…_02]`).
		For Each Pair In Context.MixedPresentations Do
			If Group.Find(Pair.Key) <> Undefined Then
				Raise MixedPresentationRefusal(Pair.Value, "groups");
			EndIf;
		EndDo;
		For Each Pair In Context.CarriedPresentations Do
			If Group.Find(Pair.Key) = Undefined And Not UsedOutsideAggregate(Pair.Key, Context) Then
				Continue;
			EndIf;
			For Each Role In CarriedPresentationRoles() Do
				Companion = Pair.Value.Roles.Get(Role);
				If Companion <> Undefined And Group.Find(Companion) = Undefined Then
					Group.Add(Companion);
				EndIf;
			EndDo;
		EndDo;
	EndIf;

	Block.Insert("Where", Where);
	Block.Insert("Group", Group);
	Block.Insert("GroupingSets", SetGroups);
	Block.Insert("Having", Having);
	Block.Insert("FieldFree", FieldFree);
	Return Block;

EndFunction

// Вхождения группировки вне выборки (LooseGrouping), которые подходят этому оператору: та же
// ветвь объединения, та же вложенность (вложенный запрос и подзапрос условия переводятся с
// другим префиксом псевдонимов, чем запрос пакета), и все псевдонимы выражения - его
// источники. Настоящему владельцу это подходит всегда; каждый подошедший записывается в
// Owners, и CheckBranchingGroups принимает вхождение только с одним претендентом.
Function LooseGroupings(Operator, Query, Context)

	Result = New Array;
	Named = ?(Context.Options.Property("BranchingGroups"), Context.Options.BranchingGroups, Undefined);
	If Named = Undefined Or Named.Count() = 0 Then
		Return Result;
	EndIf;
	Branch = Query.Operators.IndexOf(Operator);
	Nested = (Context.AliasPrefix <> "T");
	Own = Undefined;
	For Each Item In Named Do
		For Each Hit In Item.Value.Loose Do
			If Not Hit.Usable Or Hit.Branch <> Branch Or Hit.Nested <> Nested Then
				Continue;
			EndIf;
			If Own = Undefined Then
				Own = New Array;
				For Each Source In Operator.Sources Do
					For Each Table In AliasedSourceTables(Source) Do
						Try
							Own.Add(SourceAlias(Table));
						Except
							// Вложенный запрос без псевдонима: на его поля выражение сослаться не может.
						EndTry;
					EndDo;
				EndDo;
			EndIf;
			Fits = True;
			For Each Alias In Hit.Aliases Do
				If Own.Find(Alias) = Undefined Then
					Fits = False;
					Break;
				EndIf;
			EndDo;
			If Not Fits Then
				Continue;
			EndIf;
			// Один и тот же вложенный запрос переводится не раз (пробные контексты CollectSources), и
			// объект оператора у переводов разный: претендент считается по подписи.
			Signature = Format(Branch, "NZ=0; NG=0") + ":" + StrConcat(Own, ",") + ":"
				+ Format(Operator.SelectedFields.Count(), "NZ=0; NG=0");
			If Hit.Owners.Find(Signature) = Undefined Then
				Hit.Owners.Add(Signature);
			EndIf;
			Result.Add(New Structure("Entry, Hit", Item.Value, Hit));
		EndDo;
	EndDo;
	Return Result;

EndFunction

// Колонки GROUP BY вхождения вне выборки - перевод его текста с литералами в тексте, как пишет
// группировку платформа (gc1: `THEN 1.0 ELSE 2.0`, gc3: `ELSE 0x00…0`). Undefined - перевести не
// удалось или выражение без колонок: вхождение остаётся невосстановленным. Single - перевод
// выражения одной колонкой, когда колонок несколько: так его переводит общий путь группировок.
Function LooseGroupColumns(Hit, Context, Single)

	Saved = Context.LiteralsInline;
	Context.LiteralsInline = True;
	Columns = New Array;
	Try
		Source = Hit.Text;
		Parts = GroupBranchedParts(Source, Context);
		If Parts = Undefined Then
			Source = Hit.Text;
			Columns.Add(ValueExpression(Source, Context));
		Else
			Columns = Parts;
			Try
				Source = Hit.Text;
				Single = ValueExpression(Source, Context);
			Except
				Single = "";
			EndTry;
		EndIf;
	Except
		Context.LiteralsInline = Saved;
		If IsBlankString(Hit.Failure) Then
			Hit.Failure = BriefErrorDescription(ErrorInfo());
		EndIf;
		Return Undefined;
	EndTry;
	Context.LiteralsInline = Saved;

	Result = New Array;
	For Each Column In Columns Do
		If MentionsColumn(Column) Then
			Result.Add(Column);
		EndIf;
	EndDo;
	If Result.Count() = 0 Then
		// Константа: без агрегата группировка по ней свернула бы строки в одну.
		Hit.Usable = False;
		Return Undefined;
	EndIf;
	Return Result;

EndFunction

// ВЫБОР, значение которого собрано по ветвям из разных таблиц или видов, платформа группирует по
// частям - по CASE на часть (замеры 20.11-21.11.2026, УХ): ссылки двух таблиц - таблица и ссылка
// (gc2b); хранимое составное поле в ветви - тег, таблица и ссылка (gkp1, gkp2); ссылка и
// НЕОПРЕДЕЛЕНО - тег и ссылка (gkp3); ссылка и число - тег, число и ссылка (gkp4). Части здесь те
// же, что у колонки выборки (BranchedCompositeParts), без постоянных; там, где платформа таблицу не
// пишет (gkp3, gkp4), лишняя часть групп не дробит - она тоже функция значения. Ссылки одной
// таблицы - одной колонкой, как в выборке (gc3): Undefined.
Function GroupBranchedParts(Text, Context)

	Parts = Undefined;
	Try
		Parts = BranchedCompositeParts(Text, Context);
	Except
		Parts = Undefined;
	EndTry;
	If Parts = Undefined Then
		Return Undefined;
	EndIf;
	Varies = False;
	For Each Suffix In StrSplit("_TYPE,_RTRef", ",", False) Do
		Part = Parts.Get(Suffix);
		If Part <> Undefined And MentionsColumn(Part) Then
			Varies = True;
		EndIf;
	EndDo;
	If Not Varies Then
		Return Undefined;
	EndIf;
	Pieces = New Array;
	For Each Suffix In PartRoleOrder() Do
		Part = Parts.Get(Suffix);
		If Part = Undefined Or Not MentionsColumn(Part) Then
			Continue;
		EndIf;
		// Внешние скобки собранной части платформа в GROUP BY не пишет.
		If StrStartsWith(Part, "(CASE ") And StrEndsWith(Part, " END)") Then
			Part = Mid(Part, 2, StrLen(Part) - 2);
		EndIf;
		Pieces.Add(Part);
	EndDo;
	Return Pieces;

EndFunction

// Колонки, которые читает выражение: зарегистрированные при его переводе и те из
// зарегистрированных раньше, что стоят в его тексте. Вторых не видно по отметке: ГДЕ и
// СГРУППИРОВАТЬ ПО переводятся до списка выборки и регистрируют колонку первыми, а
// повторно она не регистрируется.
Function ColumnsOfExpression(Context, Mark, Expression)

	Own = New Array;
	For Index = Mark To Context.CompositeColumns.Count() - 1 Do
		Own.Add(Context.CompositeColumns[Index]);
	EndDo;
	For Index = 0 To Mark - 1 Do
		Column = Context.CompositeColumns[Index];
		If Own.Find(Column) = Undefined And MentionsWholeColumn(Expression, Column) Then
			Own.Add(Column);
		EndIf;
	EndDo;
	Return Own;

EndFunction

// Колонка стоит в тексте целиком, а не началом более длинного имени: T1._Fld66 не
// должна находиться в T1._Fld6646.
Function MentionsWholeColumn(Text, Column)

	Start = 1;
	While True Do
		Position = StrFind(Text, Column, , Start);
		If Position = 0 Then
			Return False;
		EndIf;
		Before = ?(Position = 1, "", Mid(Text, Position - 1, 1));
		After = Mid(Text, Position + StrLen(Column), 1);
		If Not IsNameChar(Before) And Before <> "." And Not IsNameChar(After)
			And (IsBlankString(After) Or StrFind("0123456789", After) = 0) Then
			Return True;
		EndIf;
		Start = Position + 1;
	EndDo;
	Return False;

EndFunction

// Встречается ли колонка в списке выборки вне агрегатной функции.
//
// Смотреть на флаг «поле - агрегат» нельзя: поле бывает смешанным, `MAX(a) + b` считается
// агрегатом целиком, а `b` группировки требует. Поэтому из каждого выражения вырезаются
// агрегатные вызовы вместе со скобками, и колонка ищется в остатке.
Function UsedOutsideAggregate(Column, Context, Group = Undefined)

	For Each Info In Context.SelectedInfo Do
		If MentionsWholeColumn(WithoutGroupedExpressions(WithoutAggregateCalls(Info.Expression), Group),
			Column) Then
			Return True;
		EndIf;
	EndDo;
	// Реквизит через точку, упомянутый только в ИМЕЮЩИЕ, группировки требует так же.
	For Each Info In Context.HavingInfo Do
		If MentionsWholeColumn(WithoutGroupedExpressions(WithoutAggregateCalls(Info.Expression), Group),
			Column) Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Текст без вхождений уже сгруппированных выражений. Колонка внутри них группировки не
// требует: «СГРУППИРОВАТЬ ПО НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ)» с колонкой даты в GROUP BY
// давал строку на каждую дату вместо строки на месяц (сверка battery27: 1С 8, SQL 98).
Function WithoutGroupedExpressions(Text, Group)

	If Group = Undefined Then
		Return Text;
	EndIf;
	Result = Text;
	For Each Grouped In Group Do
		If StrLen(Grouped) > 0 And StrFind(Result, Grouped) > 0 Then
			Result = StrReplace(Result, Grouped, "0");
		EndIf;
	EndDo;
	Return Result;

EndFunction

// Выражение без агрегатных вызовов: тело каждого заменяется пробелами, чтобы позиции
// остального не сдвинулись и поиск колонки остался честным.
Function WithoutAggregateCalls(Text)

	// COUNT_BIG - то, во что КОЛИЧЕСТВО переводится для MS SQL.
	Names = StrSplit("SUM,MAX,MIN,AVG,COUNT_BIG,COUNT", ",", False);
	Result = Text;
	Upper_ = Upper(Result);
	Position = 1;
	While Position <= StrLen(Upper_) Do
		Found = 0;
		Length = 0;
		For Each Name In Names Do
			If Mid(Upper_, Position, StrLen(Name) + 1) = Name + "(" Then
				Found = Position;
				Length = StrLen(Name) + 1;
				Break;
			EndIf;
		EndDo;
		If Found = 0 Then
			Position = Position + 1;
			Continue;
		EndIf;
		// Найти парную закрывающую скобку.
		Depth = 1;
		Index = Found + Length;
		While Index <= StrLen(Upper_) And Depth > 0 Do
			Char = Mid(Upper_, Index, 1);
			If Char = "(" Then
				Depth = Depth + 1;
			ElsIf Char = ")" Then
				Depth = Depth - 1;
			EndIf;
			Index = Index + 1;
		EndDo;
		Blank = "";
		For Step = Found To Index - 1 Do
			Blank = Blank + " ";
		EndDo;
		Result = Left(Result, Found - 1) + Blank + Mid(Result, Index);
		Upper_ = Upper(Result);
		Position = Index;
	EndDo;
	Return Result;

EndFunction

// Элемент СГРУППИРОВАТЬ ПО в терминах группировки SQL. У составного поля это все
// колонки его значения, а не одна ссылка: замерено, что платформа на «СГРУППИРОВАТЬ ПО
// A.Contract» выдаёт GROUP BY по _TYPE, _RTRef и _RRRef сразу (composite-reference.json,
// замер 9906). Группировка по одной ссылке мельче: значения разных типов с одним и тем
// же uuid сливаются в одну строку, которую 1С не отдаёт.
//
// Список выборки при этом не меняется - колонка ссылки в группировке есть, и T-SQL
// такой запрос принимает. Вывод частей отдельными колонками - отдельный шаг.
Procedure AddGroupExpressions(Group, Source, Context)

	// МоментВремени (замер ptp3, 20.11.2026, УХ): `GROUP BY T1._Date_Time, T1._IDRRef`.
	PitText = Source;
	PitParts = PointInTimeParts(PitText, Context);
	If PitParts <> Undefined Then
		For Each PitKey In PointInTimeKeyColumns(PitParts) Do
			If Group.Find(PitKey) = Undefined Then
				Group.Add(PitKey);
			EndIf;
		EndDo;
		Return;
	EndIf;

	// Реквизит разного вида за составной ссылкой: группировка по каждой части (замер d4,
	// 21.11.2026, УХ: GROUP BY тег, число, строка - теми же ВЫБОРами, что в выборке).
	Navigated = NavigatedMixedParts(Source, Context);
	If Navigated <> Undefined Then
		For Each Suffix In PartRoleOrder() Do
			Piece = Navigated.Get(Suffix);
			If Piece <> Undefined And Group.Find(Piece) = Undefined Then
				Group.Add(Piece);
			EndIf;
		EndDo;
		Return;
	EndIf;

	Value = CompositeGroupValue(Source, Context);
	If Value = Undefined Then
		If BranchReadsPartsOnly(Source, Context) Then
			// Ветвь выражения - колонка из одних частей: базовой колонки у значения нет (в выборке на
			// её месте заглушка), и группировать по ней нечем - `COALESCE(T.[заглушка], …)` читало бы
			// заглушку. Части значения в GROUP BY ставит список выборки (AddGroupColumn), по ним
			// группирует и платформа (gkp1-gkp4).
			Return;
		EndIf;
		Try
			Group.Add(ValueExpression(Source, Context));
		Except
			// ЕСТЬNULL или ВЫБОР над реквизитом разного вида: одной колонки нет, группировка - по
			// частям, собранным по ветвям (как у колонки выборки).
			Refusal = BriefErrorDescription(ErrorInfo());
			If StrFind(Refusal, "is of different kinds in its types") = 0 Then
				Raise;
			EndIf;
			Pieces = GroupBranchedParts(Source, Context);
			If Pieces = Undefined Then
				Raise Refusal;
			EndIf;
			For Each Piece In Pieces Do
				If Group.Find(Piece) = Undefined Then
					Group.Add(Piece);
				EndIf;
			EndDo;
		EndTry;
		Return;
	EndIf;

	For Each Part In Value.Parts Do
		If Group.Find(Part.Text) = Undefined Then
			Group.Add(Part.Text);
		EndIf;
	EndDo;

EndProcedure

// ЕСТЬNULL или ВЫБОР, у которого ветвь - колонка из одних частей, и значение собирается частями.
Function BranchReadsPartsOnly(Source, Context)

	Branches = Undefined;
	Try
		Branches = ExpressionBranches(TrimAll(Source));
	Except
		Return False;
	EndTry;
	If Branches = Undefined Then
		Return False;
	EndIf;
	Found = Not IsBlankString(Branches.Else_) And HoldsOnlyPartsPath(Branches.Else_, Context);
	For Each Arm In Branches.Arms Do
		If HoldsOnlyPartsPath(Arm, Context) Then
			Found = True;
		EndIf;
	EndDo;
	If Not Found Then
		Return False;
	EndIf;
	Parts = Undefined;
	Try
		Parts = BranchedCompositeParts(Source, Context);
	Except
		Parts = Undefined;
	EndTry;
	Return Parts <> Undefined;

EndFunction

// Значение поля, по которому группируют, - и только поля. Образец тот же, по которому
// подколонки разбирает CompositePartsOfExpression: путь с точкой, без скобок и
// пробелов. Выражение полем не считается - у ЕСТЬNULL и ВЫБОРа платформа собирает
// каждую часть своим ВЫБОРом (замеры 9900..9905), и это отдельная работа.
Function CompositeGroupValue(Source, Context)

	Trimmed = TrimAll(Source);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return Undefined;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		// Группировать можно и по тому, что полем не является: общий путь разберёт сам
		// и отвергнет сам, с прежним сообщением.
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment)
		Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) = Undefined Then
		Return Undefined;
	EndIf;
	If HoldsOnlyParts(Resolved.Descriptor, Resolved.FieldName, Context) Then
		// Колонка из одних частей: базовой колонки нет, группировка - по каждой части. Замер
		// mk_ptgrp_1, 20.11.2026, УХ: GROUP BY _TYPE, _N, _RRRef колонки подзапроса.
		Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
		Value = NewValue(False);
		For Each Stored In Resolved.Descriptor.Columns.Get(Upper(TrimAll(Resolved.FieldName))) Do
			AddValuePart(Value, ValueRole(Info, Stored),
				FieldColumn(Resolved.Descriptor, Resolved.Alias, Stored, Context));
		EndDo;
		Return Value;
	EndIf;

	// Разрешение пути повторяется внутри воронки, и это безошибочно: переход по ссылке
	// запоминается по префиксу и второй раз соединение не добавляет.
	Value = FieldValue(Trimmed, Context);
	Return ?(Value.IsSingle, Undefined, Value);

EndFunction

Function SelectionHasAggregate(Operator)

	For Each Field In Operator.SelectedFields Do
		Try
			If Field.ContainsAggregateFunction() Then
				Return True;
			EndIf;
		Except
			// Полем выборки бывает не выражение, а звёздочка или описание таблицы.
		EndTry;
	EndDo;
	Return False;

EndFunction

// Колонки, из которых собрано значение: в T-SQL они обязаны попасть в GROUP BY вместе
// с ним. Группировка по ним - это и есть группировка по ссылке, как у платформы.
Procedure AddGroupColumn(Context, Column)

	If IsBlankString(Column) Then
		Return;
	EndIf;
	// Пометка нужна, чтобы доказуемый добор не ужесточал поведение уже написанных
	// механизмов: колонку, названную здесь, добирают без проверки, как и раньше.
	If Context.ProvenColumns.Find(Column) = Undefined Then
		Context.ProvenColumns.Add(Column);
	EndIf;
	If Context.CompositeColumns.Find(Column) <> Undefined Then
		Return;
	EndIf;
	Context.CompositeColumns.Add(Column);

EndProcedure

// Колонка, которую можно добрать в GROUP BY только при доказуемом определителе. В отличие
// от AddGroupColumn проверенной она не считается: решение принимает OperatorBlock, когда
// список группировок уже известен.
Procedure RegisterDeterminedColumn(Context, Column, Determinant)

	If IsBlankString(Column) Or IsBlankString(Determinant) Or Column = Determinant Then
		Return;
	EndIf;

	Determinants = Context.ColumnDeterminants.Get(Column);
	If Determinants = Undefined Then
		Determinants = New Array;
		Context.ColumnDeterminants.Insert(Column, Determinants);
	EndIf;
	If Determinants.Find(Determinant) = Undefined Then
		Determinants.Add(Determinant);
	EndIf;

	If Context.CompositeColumns.Find(Column) = Undefined Then
		Context.CompositeColumns.Add(Column);
	EndIf;

EndProcedure

// То же для набора определителей: достаточно, чтобы в группировке оказался любой.
Procedure RegisterDeterminedColumns(Context, Column, Determinants)

	For Each Determinant In Determinants Do
		RegisterDeterminedColumn(Context, Column, Determinant);
	EndDo;

EndProcedure

// Значение колонки однозначно определено тем, что уже сгруппировано?
Function ColumnIsDetermined(Group, Column, Context)

	If Context.ProvenColumns.Find(Column) <> Undefined Then
		Return True;
	EndIf;
	Determinants = Context.ColumnDeterminants.Get(Column);
	If Determinants = Undefined Then
		// Колонку зарегистрировал не доказуемый добор: поведение прежнее.
		Return True;
	EndIf;

	For Each Determinant In Determinants Do
		If Group.Find(Determinant) <> Undefined Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Добор идёт до неподвижной точки: определителем бывает колонка, добранная на этом же
// проходе (у частей составного поля определители взаимные). Что не добралось - то и не
// добирается: об этом пишется предупреждение, а запрос останется отвергнутым СУБД.
Procedure AddDeterminedColumns(Group, Pending, Context)

	Added = True;
	While Added Do
		Added = False;
		Index = 0;
		While Index < Pending.Count() Do
			Column = Pending[Index];
			If ColumnIsDetermined(Group, Column, Context) Then
				Group.Add(Column);
				Pending.Delete(Index);
				Added = True;
			Else
				Index = Index + 1;
			EndIf;
		EndDo;
	EndDo;

	For Each Column In Pending Do
		AddOnce(Context.Warnings, StrTemplate(
			"Column %1 is left out of GROUP BY: nothing in the grouping determines its"
			+ " value, and adding it could return more rows than the platform does."
			+ " The DBMS will reject this query - group by that column explicitly, or"
			+ " aggregate it.", Column));
	EndDo;

EndProcedure

Function AssembleOperator(Block)

	Lines = New Array;
	Lines.Add(Block.Header);
	Lines.Add(Block.Fields);
	Lines.Add(FromSql(Block.Operator, Block.Context));

	If Block.Where.Count() > 0 Then
		Lines.Add("WHERE " + StrConcat(Block.Where, Chars.LF + "  AND "));
	EndIf;
	// Колонки, которых в списке выборки нет, в группировку попасть не должны, откуда бы
	// их туда ни добавили: у разнотипного составного значения главной колонки не
	// существует, и СУБД отвечает «Invalid column name». Части этого значения в
	// группировке остаются и различают строки так же, как платформа. Отсев здесь, на
	// сборке, а не в каждом месте добора: путей добора несколько, и замер показал, что
	// после правки одного из них колонка приезжала другим (три запроса ERP).
	Grouping = New Array;
	For Each Column In Block.Group Do
		// У хранимого составного поля главная колонка и её часть _RRRef - это один и тот
		// же текст SQL: выражением поля выступает сама колонка ссылки. Выкинуть его из
		// группировки нельзя, если он же стоит частью, - замерено, три запроса ERP
		// получили «Column _Fld..._RRRef is invalid in the select list».
		If Block.Context.OmittedBase.Find(Column) = Undefined
			Or Block.Context.PlacementParts.Find(Column) <> Undefined Then
			Grouping.Add(Column);
		EndIf;
	EndDo;
	// У производной таблицы колонка [X] и её часть [X_RRRef] - одно значение под двумя
	// именами. Группировка по X называет [X] и части типа, а ВЫРАЗИТЬ в списке выборки
	// читает [X_RRRef]: СУБД имён не сопоставляет. Группировку это не измельчает.
	For Each Column In Block.Group Do
		Closing = Right(Column, 1);
		If Closing <> "]" And Closing <> """" Then
			Continue;
		EndIf;
		Stem = Left(Column, StrLen(Column) - 1);
		Sibling = Stem + "_RRRef" + Closing;
		If Grouping.Find(Stem + "_TYPE" + Closing) <> Undefined
			And Grouping.Find(Sibling) = Undefined
			And MentionsWholeColumn(Block.Fields, Sibling) Then
			Grouping.Add(Sibling);
		EndIf;
	EndDo;
	If Block.Property("GroupingSets") And Block.GroupingSets <> Undefined Then
		Lines.Add(GroupingSetsSql(Block.GroupingSets, Grouping));
	ElsIf Grouping.Count() > 0 Then
		Lines.Add("GROUP BY " + StrConcat(Grouping, ", "));
	EndIf;
	If Block.Having.Count() > 0 Then
		Lines.Add("HAVING " + StrConcat(Block.Having, Chars.LF + "  AND "));
	EndIf;

	Return StrConcat(Lines, Chars.LF);

EndFunction

Procedure CollectSources(Operator, Context)

	// Состав полей оператора решает тип итогов виртуальной таблицы (VirtualFieldsReferenced).
	Context.Insert("Operator", Operator);
	For Each Source In Operator.Sources Do
		RegisterSource(Source, Context);
		For Each Join In Source.Joins Do
			RegisterSource(Join.Source, Context);
		EndDo;
	EndDo;

EndProcedure

Function IsConstantsTable(TableName)

	Normalized = Upper(TrimAll(TableName));
	Return Normalized = "CONSTANTS" Or Normalized = Upper("Константы");

EndFunction

// Каждая константа лежит в своей однострочной таблице. Источник «Константы» платформа
// собирает соединением по 1=1 только тех констант, к которым обратился запрос, поэтому
// текст подзапроса достраивается позже, когда известен состав использованных полей.
Function ConstantsDescriptor(Context)

	Fields = New Map;
	Places = New Map;

	For Each Item In StorageStructure() Do
		Descriptor = Item.Value;
		Purpose = Upper(TrimAll(Descriptor.Purpose));
		If Purpose <> "CONSTANT" And Purpose <> Upper("Константа") Then
			Continue;
		EndIf;
		Parts = StrSplit(Descriptor.LogicalName, ".", False);
		If Parts.Count() < 2 Then
			Continue;
		EndIf;
		Name = Parts[Parts.Count() - 1];

		Column = "";
		For Each Field In Descriptor.Fields Do
			Column = Field.Value;
		EndDo;
		If IsBlankString(Column) Then
			Continue;
		EndIf;

		Fields.Insert(Upper(Name), Name);
		Place = New Structure;
		Place.Insert("Table", Descriptor.PhysicalName);
		Place.Insert("Column", Column);
		Place.Insert("LogicalName", Descriptor.LogicalName);
		Places.Insert(Upper(Name), Place);
	EndDo;

	If Fields.Count() = 0 Then
		Raise "There are no constants in this infobase.";
	EndIf;

	Result = DerivedDescriptor("Constants", Fields, "");
	Result.Insert("ConstantPlaces", Places);
	For Each Item In Places Do
		Origin = New Structure;
		Origin.Insert("LogicalName", Item.Value.LogicalName);
		Origin.Insert("FieldName", "Value");
		Result.ColumnSources.Insert(Item.Key, Origin);
	EndDo;
	Return Result;

EndFunction

// Соединение однострочных таблиц: по одной на каждую затребованную константу.
Function ConstantsSubquery(Descriptor, Context)

	Select = New Array;
	From = New Array;
	Number = 0;

	For Each Item In Descriptor.ConstantPlaces Do
		If Descriptor.Used.Get(Item.Key) = Undefined Then
			Continue;
		EndIf;
		Number = Number + 1;
		Alias = "C" + Format(Number, "NG=0; NZ=0");
		Select.Add("      " + Alias + "." + PhysicalName(Item.Value.Column, Context)
			+ " AS " + QuoteIdentifier(Descriptor.Fields.Get(Item.Key), Context));
		From.Add(?(From.Count() = 0, "    FROM ", "    INNER JOIN ")
			+ QualifiedTableName(Item.Value.Table, Context) + " AS " + Alias
			+ ?(From.Count() = 0, "", " ON 1 = 1"));
	EndDo;

	If Select.Count() = 0 Then
		Return "    SELECT 1 AS " + QuoteIdentifier("Constants", Context);
	EndIf;

	Lines = New Array;
	Lines.Add("    SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add(StrConcat(From, Chars.LF));
	Return StrConcat(Lines, Chars.LF);

EndFunction

Procedure RegisterSource(Source, Context)

	Table = TableOfSource(Source);
	Alias = TrimAll(Table.Alias);
	If IsBlankString(Alias) And Not IsNestedQuery(Table) Then
		Alias = Table.TableName;
	EndIf;
	If IsBlankString(Alias) Then
		Raise "A nested query used as a source has no alias, so its fields cannot be referenced.";
	EndIf;

	AliasKey = Upper(Alias);
	If Context.Aliases.Get(AliasKey) <> Undefined Then
		Return;
	EndIf;
	Keys = New Array;
	Keys.Add(AliasKey);
	If IsBlankString(TrimAll(Table.Alias)) And Not IsNestedQuery(Table) Then
		// Без псевдонима 1С обращается к полям и по полному имени таблицы, и по короткому.
		Segments = StrSplit(Alias, ".", False);
		Keys.Add(Upper(Segments[Segments.Count() - 1]));
	EndIf;

	If IsNestedQuery(Table) Then
		// Вложенный запрос переносится производной таблицей: своя область видимости,
		// собственные псевдонимы, наружу видны только его колонки.
		Descriptor = TempTableDescriptor(Alias, Table.Query, Context);
		Descriptor.Subquery = QuerySql(Table.Query, Context.Options, Context.Warnings,
			Context.TempTables, NextAliasPrefix(Context.AliasPrefix), True);
		NotePresentationCompanions(Descriptor, Table.Query, Context.Options);
	ElsIf IsConstantsTable(Table.TableName) Then
		Descriptor = ConstantsDescriptor(Context);
	Else
		// Temporary table of the batch is already known as a common table expression.
		Descriptor = Context.TempTables.Get(Upper(TrimAll(Table.TableName)));
		If Descriptor = Undefined
			And Context.TempTables.Get("#DROPPED:" + Upper(TrimAll(Table.TableName))) <> Undefined Then
			Raise StrTemplate("Temporary table %1 is read after DROP has destroyed it. The platform"
				+ " refuses such a batch (""Table not found"").", TrimAll(Table.TableName));
		EndIf;
		If Descriptor = Undefined Then
			Descriptor = VirtualTableDescriptor(Table, Context);
		EndIf;
		If Descriptor = Undefined Then
			Descriptor = TableDescriptor(Table.TableName);
		EndIf;
	EndIf;
	Context.AliasCounter = Context.AliasCounter + 1;

	Entry = New Structure;
	Entry.Insert("SafeAlias", Context.AliasPrefix + Format(Context.AliasCounter, "NG=0"));
	Entry.Insert("Descriptor", Descriptor);
	For Each AliasName In Keys Do
		Context.Aliases.Insert(AliasName, Entry);
	EndDo;
	NotePartsOnlyAliasReads(Entry.SafeAlias, Descriptor, Context);

EndProcedure

// The schema lists every source of the operator flat, and a joined source appears both
// inside the join and as a source of its own. Only the sources nothing joins to start a
// FROM entry, the rest are emitted by the join that pulls them in.
Function FromSql(Operator, Context)

	SourceByAlias = New Map;
	JoinTargets = New Map;
	For Each Source In Operator.Sources Do
		SourceByAlias.Insert(SourceAlias(TableOfSource(Source)), Source);
		For Each Join In Source.Joins Do
			JoinTargets.Insert(SourceAlias(TableOfSource(Join.Source)), True);
		EndDo;
	EndDo;

	// Тело виртуальной таблицы пересобирается в тот момент, когда её источник выводится
	// в FROM, а состав её измерений известен только из того, что спросили снаружи -
	// условие ON в том числе. Поэтому условия переводятся до вывода, все сразу.
	PrepareJoinConditions(Operator, Context);

	// Соединения, возникшие при обращении через точку, раскладываются по зависимостям:
	// условие ON в T-SQL видит только те таблицы, что объявлены выше него.
	Pending = New Map;
	For Each Navigation In Context.NavigationJoins Do
		Pending.Insert(Navigation.Alias, Navigation);
	EndDo;
	Done = New Map;

	Lines = New Array;
	Emitted = New Map;
	For Each Source In Operator.Sources Do
		If JoinTargets.Get(SourceAlias(TableOfSource(Source))) <> Undefined Then
			Continue;
		EndIf;
		EmitSource(Source, SourceByAlias, Context, Lines, Emitted, Pending, Done);
	EndDo;

	// Источника нет вовсе, а соединения есть: так выглядит запрос вида
	// ВЫБРАТЬ ВЫРАЗИТЬ(&Параметр КАК Справочник.Х).Поле. Платформа подставляет
	// фиктивный источник из одной строки; имена взяты её же, замерено на 8.3.24.
	If Lines.Count() = 0 And Context.NavigationJoins.Count() > 0 Then
		Lines.Add("FROM (SELECT 1 AS " + QuoteIdentifier("SDBL_DUMMY", Context) + ") AS "
			+ QuoteIdentifier("SDBL_DUAL", Context));
	EndIf;

	// Остальные - те, на которые не ссылается ни одно соединение: они нужны выборке,
	// условию или упорядочиванию.
	For Each Navigation In Context.NavigationJoins Do
		If Done.Get(Navigation.Alias) <> Undefined Then
			Continue;
		EndIf;
		Done.Insert(Navigation.Alias, True);
		Lines.Add("  LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias);
		Lines.Add("    ON " + JoinCondition(Navigation));
	EndDo;

	Return StrConcat(Lines, Chars.LF);

EndFunction

Procedure EmitSource(Source, SourceByAlias, Context, Lines, Emitted, Pending, Done)

	Table = TableOfSource(Source);
	Alias = SourceAlias(Table);
	If Emitted.Get(Alias) <> Undefined Then
		Return;
	EndIf;

	Emitted.Insert(Alias, True);
	Lines.Add(?(Lines.Count() = 0, "FROM ", SourceSeparator(Source, SourceByAlias))
		+ SourceReference(Table, Context));
	AppendJoins(Source, SourceByAlias, Context, Lines, Emitted, Pending, Done);

EndProcedure

// Запятая начинает в FROM отдельное дерево соединений, и условие ON внутри второго
// операнда псевдонимов первого не видит. CROSS JOIN даёт то же декартово произведение
// одной левой цепочкой, где видно всё объявленное выше.
Function SourceSeparator(Source, SourceByAlias)

	If KeepsRowsOutsideJoin(Source, SourceByAlias, New Map) Then
		Return "   , ";
	EndIf;
	Return "  CROSS JOIN ";

EndFunction

// У ПРАВОГО и ПОЛНОГО соединения состав строк зависит от того, что стоит левее, поэтому
// такому операнду группировка запятой нужна: с CROSS JOIN он сохранил бы другие строки.
Function KeepsRowsOutsideJoin(Source, SourceByAlias, Seen)

	For Each Join In Source.Joins Do
		Keyword = JoinKeyword(Join.JoinType);
		If Keyword = "RIGHT JOIN" Or Keyword = "FULL JOIN" Then
			Return True;
		EndIf;
		Alias = SourceAlias(TableOfSource(Join.Source));
		If Seen.Get(Alias) <> Undefined Then
			Continue;
		EndIf;
		Seen.Insert(Alias, True);
		Deeper = SourceByAlias.Get(Alias);
		If Deeper <> Undefined And KeepsRowsOutsideJoin(Deeper, SourceByAlias, Seen) Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Соединение через точку опирается на присоединяемый источник, если его условие
// называет псевдоним этого источника - прямо или через другое такое же соединение.
// Такое соединение видит источник только внутри его скобок: ON соседнего соединения
// объявлено выше и самого источника ещё не знает.
Function NavigationOnSource(JoinedAlias, Context)

	Result = New Map;
	Entry = Context.Aliases.Get(JoinedAlias);
	If Entry = Undefined Then
		Return Result;
	EndIf;

	Added = True;
	While Added Do
		Added = False;
		For Each Navigation In Context.NavigationJoins Do
			If Result.Get(Navigation.Alias) <> Undefined Then
				Continue;
			EndIf;
			Condition = JoinCondition(Navigation);
			If StrFind(Condition, Entry.SafeAlias + ".") = 0
				And Not NamesAnyAlias(Condition, Result) Then
				Continue;
			EndIf;
			Result.Insert(Navigation.Alias, True);
			Added = True;
		EndDo;
	EndDo;
	Return Result;

EndFunction

Function NamesAnyAlias(Condition, Aliases)

	For Each Item In Aliases Do
		If StrFind(Condition, Item.Key + ".") > 0 Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Соединения по ссылке, на которые опирается условие. Выводятся до него и в своём
// порядке зависимостей: цепочка через точку - это цепочка соединений. Те, что опираются
// на сам присоединяемый источник, отбираются в Inside: их место внутри его скобок.
Procedure EmitNavigationBefore(Condition, Pending, Done, Lines, Context,
	Bound = Undefined, Inside = Undefined)

	For Each Navigation In Context.NavigationJoins Do
		Alias = Navigation.Alias;
		If Done.Get(Alias) <> Undefined Or StrFind(Condition, Alias + ".") = 0 Then
			Continue;
		EndIf;
		// Пометка ставится до обхода зависимостей: так цикл в ссылках не зациклит вывод.
		Done.Insert(Alias, True);
		EmitNavigationBefore(JoinCondition(Navigation), Pending, Done, Lines, Context,
			Bound, Inside);
		If Bound <> Undefined And Bound.Get(Alias) <> Undefined Then
			Inside.Add(Navigation);
			Continue;
		EndIf;
		Lines.Add("  LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias);
		Lines.Add("    ON " + JoinCondition(Navigation));
	EndDo;

EndProcedure

// Условия соединений переводятся раньше вывода FROM: иначе виртуальная таблица,
// стоящая источником, собирается до того, как стало известно, какие её измерения
// спрашивает условие соединения с ней.
Procedure PrepareJoinConditions(Operator, Context)

	For Each Source In Operator.Sources Do
		For Each Join In Source.Joins Do
			TranslatedJoinCondition(JoinConditionText(Join), Context);
		EndDo;
	EndDo;

EndProcedure

// Текст условия соединения. Модель запроса читает Join.Condition, разбирая текст заново, и на имени, где первый
// сегмент - и псевдоним, и реквизит другого источника, падает с «Ambiguous field» (УХ 49778, 37659), хотя платформа запрос
// выполняет. Текст условия при этом стоит в описании ошибки после перевода строки, с маркером <<?>> места ошибки.
Function JoinConditionText(Join)

	Description = "";
	Try
		Return String(Join.Condition);
	Except
		Description = ErrorDescription();
	EndTry;
	Break_ = StrFind(Description, Chars.LF);
	Marker = StrFind(Description, "<<?>>");
	If Break_ = 0 Or Marker = 0 Or Marker < Break_ Then
		Raise Description;
	EndIf;
	Return TrimAll(StrReplace(Mid(Description, Break_ + 1), "<<?>>", ""));

EndFunction

// Перевод условия соединения - один на текст условия. Повторный перевод того же текста
// добавил бы те же навигационные соединения и те же колонки группировки второй раз.
Function TranslatedJoinCondition(Condition, Context)

	Text = String(Condition);
	Ready = Context.JoinConditions.Get(Text);
	If Ready <> Undefined Then
		Return Ready;
	EndIf;

	Context.BooleanContext = True;
	Ready = TranslateExpression(Text, Context);
	Context.BooleanContext = False;
	Context.JoinConditions.Insert(Text, Ready);
	Return Ready;

EndFunction

// One source can be joined by several conditions at once; they all belong to a single
// JOIN, otherwise the same alias would be declared twice.
// Нужны ли скобки вокруг присоединённого источника и его соединений.
//
// Нужны только под ВНЕШНИМ соединением: под ВНУТРЕННИМ плоская цепочка равносильна
// группе. И только если условия внутри группы не ссылаются на псевдонимы, объявленные
// выше неё: скобочная группа их не видит, и T-SQL такой запрос не свяжет. Этот случай -
// тот же, что отдельный класс «псевдоним вперёд в условии ПО», и здесь он оставляется
// как был, а не превращается в отказ.
//
// Навигационные соединения источника (Inside) группе не мешают: вызывающий выводит их
// внутри той же скобки, перед соединениями самого источника.
Function JoinGroupNeeded(Keyword, Inside, NestedLines, Reference, Lines, Condition)

	If NestedLines.Count() = 0 Then
		Return False;
	EndIf;

	If Keyword = "INNER JOIN" Then
		// Под внутренним соединением плоская цепочка равносильна группе, пока внутри
		// группы нет ПРАВОГО или ПОЛНОГО: «A INNER JOIN (B FULL JOIN C)» отсекает строки C
		// без B, а плоское «(A INNER JOIN B) FULL JOIN C» их оставляет (сверка battery25:
		// 1С 195 строк, SQL 220; с ПРАВЫМ - 91 и 116). И скобки нужны, когда условие
		// называет источник из правой части: в плоской цепочке он объявлен ниже условия.
		Nested = StrConcat(NestedLines, Chars.LF);
		Forward = StrFind(Nested, "RIGHT JOIN") > 0 Or StrFind(Nested, "FULL JOIN") > 0;
		For Each Alias In AliasesOf(Nested) Do
			If Forward Then
				Break;
			EndIf;
			If MentionsWholeColumn(Condition, Alias) Then
				Forward = True;
			EndIf;
		EndDo;
		If Not Forward Then
			Return False;
		EndIf;
	EndIf;

	Outside = AliasesOf(StrConcat(Lines, Chars.LF));
	InsideGroup = AliasesOf(Reference + Chars.LF + StrConcat(NestedLines, Chars.LF));
	For Each Alias In InsideGroup Do
		If Outside.Find(Alias) <> Undefined Then
			Outside.Delete(Outside.Find(Alias));
		EndIf;
	EndDo;

	// Целым псевдонимом, а не подстрокой: «T1.» находится и внутри «T10.», и тогда группа
	// ошибочно считалась ссылающейся наружу и выводилась плоско.
	Text = StrConcat(NestedLines, Chars.LF);
	For Each Alias In Outside Do
		If MentionsWholeColumn(Text, Alias) Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Псевдонимы, объявленные в тексте: всё, что стоит после AS.
Function AliasesOf(Text)

	Result = New Array;
	Tokens = StrSplit(StrReplace(StrReplace(Text, Chars.LF, " "), Chars.Tab, " "), " ", False);
	Take = False;
	For Each Token In Tokens Do
		Word = TrimAll(Token);
		If IsBlankString(Word) Then
			Continue;
		EndIf;
		If Take Then
			Name = StrReplace(StrReplace(Word, "(", ""), ")", "");
			If Not IsBlankString(Name) And Result.Find(Name) = Undefined Then
				Result.Add(Name);
			EndIf;
			Take = False;
			Continue;
		EndIf;
		Take = (Upper(Word) = "AS");
	EndDo;
	Return Result;

EndFunction

Procedure AppendJoins(Source, SourceByAlias, Context, Lines, Emitted, Pending, Done)

	Order = New Array;
	Conditions = New Map;
	Kinds = New Map;
	Tables = New Map;

	For Each Join In Source.Joins Do
		JoinedTable = TableOfSource(Join.Source);
		JoinedAlias = SourceAlias(JoinedTable);
		If Conditions.Get(JoinedAlias) = Undefined Then
			Order.Add(JoinedAlias);
			Conditions.Insert(JoinedAlias, New Array);
			Kinds.Insert(JoinedAlias, Join.JoinType);
			Tables.Insert(JoinedAlias, JoinedTable);
		EndIf;
		Conditions.Get(JoinedAlias).Add(
			GroupedCondition(TranslatedJoinCondition(JoinConditionText(Join), Context)));
	EndDo;

	For Each JoinedAlias In Order Do
		If Emitted.Get(JoinedAlias) <> Undefined Then
			Continue;
		EndIf;
		Condition = StrConcat(Conditions.Get(JoinedAlias), Chars.LF + "   AND ");
		Inside = New Array;
		EmitNavigationBefore(Condition, Pending, Done, Lines, Context,
			NavigationOnSource(JoinedAlias, Context), Inside);
		Reference = SourceReference(Tables.Get(JoinedAlias), Context);
		Keyword = JoinKeyword(Kinds.Get(JoinedAlias));
		Emitted.Insert(JoinedAlias, True);

		// Соединения присоединённого источника - это правая часть этого соединения, а не
		// продолжение общей цепочки. Собираем их отдельно, чтобы решить, нужны ли скобки.
		NestedLines = New Array;
		Nested = SourceByAlias.Get(JoinedAlias);
		If Nested <> Undefined Then
			AppendJoins(Nested, SourceByAlias, Context, NestedLines, Emitted, Pending, Done);
		EndIf;

		Grouped = JoinGroupNeeded(Keyword, Inside, NestedLines, Reference, Lines, Condition);
		If Grouped Then
			// Внешнее соединение с группой: без скобок завершающее внутреннее соединение
			// отфильтрует строки, у которых правая часть пуста, и внешнее соединение молча
			// станет внутренним. Замерено: 1С отдаёт 89 строк, плоская цепочка - 34.
			Lines.Add("  " + Keyword + " (" + Reference);
			// Переходы через точку от присоединённого источника - внутри той же группы, до
			// его собственных соединений: иначе завершающее внутреннее соединение группы
			// отсекло бы строки внешнего (сверка battery25: 1С 116 строк, SQL 0).
			For Each Navigation In Inside Do
				Lines.Add("      LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias);
				Lines.Add("        ON " + JoinCondition(Navigation));
			EndDo;
			For Each Line In NestedLines Do
				Lines.Add("    " + Line);
			EndDo;
			Lines.Add("    )");
			Lines.Add("    ON " + Condition);
		Else
			If Inside.Count() = 0 Then
				Lines.Add("  " + Keyword + " " + Reference);
			Else
				Lines.Add("  " + Keyword + " (" + Reference);
				For Index = 0 To Inside.Count() - 1 Do
					Navigation = Inside[Index];
					Lines.Add("      LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias);
					Lines.Add("        ON " + JoinCondition(Navigation)
						+ ?(Index = Inside.Count() - 1, ")", ""));
				EndDo;
			EndIf;
			Lines.Add("    ON " + Condition);
			For Each Line In NestedLines Do
				Lines.Add(Line);
			EndDo;
		EndIf;
	EndDo;

EndProcedure

// Условие навигационного соединения. У составной ссылки к равенству по ключу
// добавляется предикат типа - платформа пишет его тоже в ON, а не в ГДЕ.
Function JoinCondition(Navigation)

	Condition = Navigation.Alias + "." + Navigation.KeyColumn + " = " + Navigation.Source;
	If Not IsBlankString(Navigation.Extra) Then
		Condition = Navigation.Extra + " AND " + Condition;
	EndIf;
	Return Condition;

EndFunction

Function SourceAlias(Table)

	Alias = TrimAll(Table.Alias);
	If Not IsBlankString(Alias) Then
		Return Upper(Alias);
	EndIf;
	If IsNestedQuery(Table) Then
		Raise "A nested query used as a source has no alias, so its fields cannot be referenced.";
	EndIf;
	Return Upper(Table.TableName);

EndFunction

// Вид источника распознаётся по тому, что он предоставляет: имена типов схемы
// запроса различаются между языковыми вариантами платформы.
Function IsNestedQuery(Table)

	Try
		Return Table.Query <> Undefined;
	Except
		Return False;
	EndTry;

EndFunction

Function SourceReference(Table, Context)

	Alias = TrimAll(Table.Alias);
	If IsBlankString(Alias) Then
		Alias = Table.TableName;
	EndIf;
	Alias = TrimAll(Alias);
	Entry = Context.Aliases.Get(Upper(Alias));
	If Entry.Descriptor.IsDerived Then
		If Entry.Descriptor.Property("AccountingPlan") Then
			Entry.Descriptor.Subquery = AccountingSubquery(Entry.Descriptor, Context);
			Return "(" + Chars.LF + ZeroFiltered(Entry.Descriptor, Context) + Chars.LF
				+ "  ) AS " + Entry.SafeAlias;
		EndIf;
		If Entry.Descriptor.Property("RegisterPlan") Then
			Plan = Entry.Descriptor.RegisterPlan;
			Rebuilt = RegisterVirtualBody(Plan.BaseName, Plan.Base, Plan.Register,
				Plan.Kind, Plan.Arguments, Entry.Descriptor.Used, Context);
			Entry.Descriptor.Subquery = Rebuilt.Subquery;
			Entry.Descriptor.ZeroFilter = Rebuilt.ZeroFilter;
			// Пересборка знает, спросили ли снаружи хоть один разрез, а описатель,
			// заведённый при разборе источников, этого ещё не знал. Без переноса флага
			// отсев нулей оставался включённым всегда, и итоговая строка нулевого
			// остатка пропадала.
			Entry.Descriptor.ZeroGrouped = Rebuilt.ZeroGrouped;
			Entry.Descriptor.Insert("ZeroTotals", Rebuilt.Property("ZeroTotals") And Rebuilt.ZeroTotals);
			Return "(" + Chars.LF + ZeroFiltered(Entry.Descriptor, Context) + Chars.LF
				+ "  ) AS " + Entry.SafeAlias;
		EndIf;
		If Entry.Descriptor.Property("ConstantPlaces") Then
			Return "(" + Chars.LF + ConstantsSubquery(Entry.Descriptor, Context) + Chars.LF
				+ "  ) AS " + Entry.SafeAlias;
		EndIf;
		If Entry.Descriptor.Property("SchedulePlan") Then
			// Значения графика читаются, только если их спросили снаружи, а это известно здесь.
			Entry.Descriptor.Subquery = ScheduleDataSubquery(Entry.Descriptor, Context);
			Return "(" + Chars.LF + Entry.Descriptor.Subquery + Chars.LF
				+ "  ) AS " + Entry.SafeAlias;
		EndIf;
		If Not IsBlankString(Entry.Descriptor.Subquery) Then
			Return "(" + Chars.LF + ZeroFiltered(Entry.Descriptor, Context) + Chars.LF
				+ "  ) AS " + Entry.SafeAlias;
		EndIf;
		Return QuoteIdentifier(Entry.Descriptor.PhysicalName, Context) + " AS " + Entry.SafeAlias;
	EndIf;
	Return QualifiedTableName(Entry.Descriptor.PhysicalName, Context) + " AS " + Entry.SafeAlias;

EndFunction

// Строка виртуальной таблицы попадает в результат, если ненулевой хотя бы один из
// ресурсов, выбранных внешним запросом. Ресурсы, которых снаружи не спрашивали,
// в отборе не участвуют - это и определяет состав строк.
Function ZeroFiltered(Descriptor, Context)

	If Not Descriptor.Property("ZeroFilter") Or Descriptor.ZeroFilter = Undefined
		Or Descriptor.ZeroFilter.Count() = 0 Then
		Return Descriptor.Subquery;
	EndIf;

	If Descriptor.Property("ZeroGrouped") And Not Descriptor.ZeroGrouped Then
		Return ZeroTotalsRow(Descriptor, Context);
	EndIf;

	Conditions = New Array;
	Tested = New Map;
	For Each Name In Descriptor.ZeroFilter Do
		If Descriptor.Used.Get(Upper(Name)) = Undefined Then
			Continue;
		EndIf;
		Target = Name;
		If Tested.Get(Upper(Target)) <> Undefined Then
			Continue;
		EndIf;
		Tested.Insert(Upper(Target), True);
		Conditions.Add("Z." + QuoteIdentifier(Target, Context) + " <> 0");
	EndDo;

	If Conditions.Count() = 0 Then
		Return Descriptor.Subquery;
	EndIf;

	Lines = New Array;
	Lines.Add("    SELECT Z.* FROM (");
	Lines.Add(Descriptor.Subquery);
	Lines.Add("    ) AS Z");
	Lines.Add("    WHERE " + StrConcat(Conditions, Chars.LF + "       OR "));
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Итоговая строка без разрезов там, где платформа отдаёт ноль (ZeroTotals): сумма по пустому
// набору у СУБД NULL. Ноль ставится только выбранным снаружи ресурсам; если снаружи читают
// что-то кроме ресурсов, строка остаётся как была.
Function ZeroTotalsRow(Descriptor, Context)

	If Not Descriptor.Property("ZeroTotals") Or Not Descriptor.ZeroTotals
		Or Not Descriptor.Property("ZeroFilter") Or Descriptor.ZeroFilter = Undefined Then
		Return Descriptor.Subquery;
	EndIf;
	Resources = New Map;
	For Each Name In Descriptor.ZeroFilter Do
		Resources.Insert(Upper(Name), Name);
	EndDo;
	Columns = New Array;
	For Each Item In Descriptor.Used Do
		Name = Resources.Get(Item.Key);
		If Name = Undefined Then
			Return Descriptor.Subquery;
		EndIf;
		Columns.Add("COALESCE(Z." + QuoteIdentifier(Name, Context) + ", 0) AS " + QuoteIdentifier(Name, Context));
	EndDo;
	If Columns.Count() = 0 Then
		Return Descriptor.Subquery;
	EndIf;
	Return "    SELECT " + StrConcat(Columns, ", ") + " FROM (" + Chars.LF + Descriptor.Subquery + Chars.LF
		+ "    ) AS Z";

EndFunction

// Type names of the query schema differ between platform language variants,
// so the kind of an object is recognised by what it exposes, not by TypeOf.
Function IsSelectQuery(Query)

	Try
		Return Query.Operators.Count() >= 0;
	Except
		Return False;
	EndTry;

EndFunction

Function TableOfSource(Source)

	Table = Source.Source;
	Try
		Probe = Table.TableName;
		Return Table;
	Except
	EndTry;

	// Вложенный запрос: имени таблицы у него нет, есть сам запрос.
	If IsNestedQuery(Table) Then
		Return Table;
	EndIf;

	Raise StrTemplate(
		"Source of kind %1 is not supported yet.", String(TypeOf(Table)));

EndFunction

// Условие в скобках, если в нём есть ИЛИ верхнего уровня. Нужно перед склейкой списка
// условий через AND: в SQL AND связывает крепче OR, и без скобок условие распадается -
// часть ограничений отваливается, соединение начинает соединять лишнее, и это видно не
// в отказе, а только в числах.
Function GroupedCondition(Text)

	Trimmed = TrimAll(Text);
	If Not HasTopLevelOr(Trimmed) Then
		Return Text;
	EndIf;
	Return "(" + Trimmed + ")";

EndFunction

// Есть ли в выражении OR на нулевой глубине скобок. Строковые литералы пропускаются:
// слово OR внутри строки условием не является.
Function HasTopLevelOr(Text)

	Upper_ = Upper(Text);
	Depth = 0;
	Position = 1;
	Size = StrLen(Upper_);
	While Position <= Size Do
		Char = Mid(Upper_, Position, 1);
		If Char = "'" Or Char = """" Then
			Quote = Char;
			Position = Position + 1;
			While Position <= Size And Mid(Upper_, Position, 1) <> Quote Do
				Position = Position + 1;
			EndDo;
			Position = Position + 1;
			Continue;
		EndIf;
		If Char = "[" Then
			While Position <= Size And Mid(Upper_, Position, 1) <> "]" Do
				Position = Position + 1;
			EndDo;
			Position = Position + 1;
			Continue;
		EndIf;
		If Char = "(" Then
			Depth = Depth + 1;
		ElsIf Char = ")" Then
			Depth = Depth - 1;
		ElsIf Depth = 0 And Mid(Upper_, Position, 4) = " OR " Then
			Return True;
		EndIf;
		Position = Position + 1;
	EndDo;
	Return False;

EndFunction

Function JoinKeyword(JoinType)

	If JoinType = QuerySchemaJoinType.Inner Then
		Return "INNER JOIN";
	ElsIf JoinType = QuerySchemaJoinType.LeftOuter Then
		Return "LEFT JOIN";
	ElsIf JoinType = QuerySchemaJoinType.RightOuter Then
		Return "RIGHT JOIN";
	EndIf;
	Return "FULL JOIN";

EndFunction

// Выражение верхнего уровня является условием, если на нулевой глубине скобок у него
// есть сравнение или логическая связка. Внутрь скобок и вызовов смотреть не надо:
// там условие уже обслуживает ВЫБОР или сама функция.
// Условие как значение. В 1С сравнение - значение типа Булево, в T-SQL булева типа
// нет, поэтому условие оборачивается в ВЫБОР. Форма замерена у платформы и одинакова
// в списке выборки, группировке и упорядочивании - выражение группировки обязано
// совпасть с выражением списка выборки текстом, иначе SQL Server его не признает.
// У аргумента агрегатной функции форма другая, с двумя WHEN: см. AggregateOfCondition.
Function ValueExpression(Source, Context)

	If Not IsConditionExpression(Source) Then
		// Контекст снимается намеренно: внутри ГДЕ самостоятельное ИСТИНА - это условие
		// (`1 = 1`), а здесь ждут значение (`0x01`).
		Saved = Context.BooleanContext;
		Context.BooleanContext = False;
		Value = TranslateExpression(Source, Context);
		Context.BooleanContext = Saved;
		Return Value;
	EndIf;

	Saved = Context.BooleanContext;
	Context.BooleanContext = True;
	Condition = TranslateExpression(Source, Context);
	Context.BooleanContext = Saved;

	Return ConditionAsValue(Condition, Context);

EndFunction

// Элементы списка `В` текстом. Undefined - это не список значений: подзапрос или
// пустые скобки, и разбирать их здесь нечего.
Function ListItems(Tokens, OpenIndex, CloseIndex)

	If CloseIndex <= OpenIndex + 1 Then
		Return Undefined;
	EndIf;
	First = Upper(TrimAll(Tokens[OpenIndex + 1].Value));
	If First = "SELECT" Or First = Upper("Выбрать") Then
		Return Undefined;
	EndIf;

	Items = New Array;
	Depth = 0;
	From = OpenIndex + 1;
	For Index = OpenIndex + 1 To CloseIndex - 1 Do
		Value = Tokens[Index].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
		ElsIf Value = "," And Depth = 0 Then
			Items.Add(TokensText(Tokens, From, Index - 1));
			From = Index + 1;
		EndIf;
	EndDo;
	Items.Add(TokensText(Tokens, From, CloseIndex - 1));

	For Each Item In Items Do
		If IsBlankString(Item) Then
			Return Undefined;
		EndIf;
	EndDo;
	Return Items;

EndFunction

Function ListHasCondition(Items)

	For Each Item In Items Do
		If IsConditionExpression(Item) Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Условие, стоящее там, где ждут значение. Форма снята замером (эталоны 9401-9417):
// у платформы их две, короткая с ИНАЧЕ и длинная с двумя ВЫБОР, и выбирает она по
// NULL-ности операнда. Длинная верна в обоих случаях - при не-NULL операнде `NOT c`
// покрывает весь остаток, - поэтому здесь она одна. Короткая форма превращала бы NULL
// в Ложь, а это другое значение.
Function ConditionAsValue(Condition, Context)

	Return "CASE WHEN (" + Condition + ") THEN " + BooleanLiteral(True, Context)
		+ " WHEN NOT (" + Condition + ") THEN " + BooleanLiteral(False, Context)
		+ " END";

EndFunction

Function IsConditionExpression(Text)

	Tokens = Tokenize(Text);
	Depth = 0;

	For Index = 0 To Tokens.Count() - 1 Do
		Value = Tokens[Index].Value;
		If Value = "(" Then
			Depth = Depth + 1;
			Continue;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
			Continue;
		EndIf;

		Word = Upper(Value);
		If Tokens[Index].Kind = "Name" Then
			// ВЫБОР ... КОНЕЦ - самостоятельный уровень: сравнения внутри него
			// относятся к его же условиям, а не к выражению целиком.
			If Word = "CASE" Or Word = Upper("Выбор") Then
				Depth = Depth + 1;
				Continue;
			ElsIf Word = "END" Or Word = Upper("Конец") Then
				Depth = Depth - 1;
				Continue;
			EndIf;
		EndIf;

		If Depth <> 0 Then
			Continue;
		EndIf;

		If Tokens[Index].Kind = "Symbol" And IsComparison(Value) Then
			Return True;
		EndIf;
		If Tokens[Index].Kind <> "Name" Then
			Continue;
		EndIf;
		// Имя за точкой - поле, а не оператор: «ВЫРАЗИТЬ(…).Ссылка» - значение ссылки, а не
		// ССЫЛКА (УХ, ЖурналДокументовЗакупки: ветвь ВЫБОР уходила условием «_IDRRef = 0x01»).
		If Index > 0 And Tokens[Index - 1].Kind = "Symbol" And Tokens[Index - 1].Value = "." Then
			Continue;
		EndIf;

		If Word = "AND" Or Word = Upper("И") Or Word = "OR" Or Word = Upper("ИЛИ")
			Or Word = "NOT" Or Word = Upper("НЕ")
			Or Word = "LIKE" Or Word = Upper("Подобно")
			Or Word = "BETWEEN" Or Word = Upper("Между")
			Or Word = "IS" Or Word = Upper("Есть")
			Or Word = "REFS" Or Word = Upper("Ссылка")
			Or ((Word = "IN" Or Word = Upper("В")) And Index > 0) Then
			Return True;
		EndIf;
	EndDo;

	Return False;

EndFunction

// Составное поле, вынесенное во временную таблицу, теряет признак типа, если взять
// только колонку ссылки. Здесь считается, какие подколонки надо вынести вместе с ним:
// одно и то же вычисление используют и генератор списка выборки, и описание таблицы.
Function CompositePartsOfExpression(Text, Context)

	Result = New Structure;
	Result.Insert("Alias", "");
	Result.Insert("Parts", New Array);

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return Result;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Result;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return Result;
	EndIf;

	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Then
		Return Result;
	EndIf;

	ColumnList = Resolved.Descriptor.Columns.Get(Upper(TrimAll(Resolved.FieldName)));
	If ColumnList = Undefined Then
		Return Result;
	EndIf;

	Result.Alias = Resolved.Alias;
	Result.Insert("Descriptor", Resolved.Descriptor);
	For Each Column In ColumnList Do
		Result.Parts.Add(Column);
	EndDo;
	Return Result;

EndFunction

// Какие подколонки составных полей выводит запрос, наполняющий временную таблицу.
// Считается один раз на запрос: состав обязан совпасть у всех ветвей объединения.
// Поле колонки ColumnIndex в ветви Operator. Голый NULL ветви объединения модель в полях выборки не
// хранит - у ветви полей меньше, чем колонок, и индексы съезжают, - а в Columns[i].Fields на его месте
// Неопределено (отладочный замер 18.11.2026). Без такой ветви - поле выборки по индексу, как было.
Function ColumnField(Query, Operator, ColumnIndex)

	If Operator.SelectedFields.Count() >= Query.Columns.Count() Or ColumnIndex >= Query.Columns.Count() Then
		Return ?(ColumnIndex < Operator.SelectedFields.Count(), Operator.SelectedFields[ColumnIndex], Undefined);
	EndIf;
	Return Query.Columns[ColumnIndex].Fields.Get(Query.Operators.IndexOf(Operator));

EndFunction

// Текст поля колонки в ветви; потерянный моделью голый NULL - "NULL" (платформа пишет его
// CAST(NULL AS <тип колонки>), по части хранения на часть, замер 18.11.2026, УХ, null_uh n1-n5).
Function ColumnFieldText(Query, Operator, ColumnIndex)

	Field = ColumnField(Query, Operator, ColumnIndex);
	Return ?(Field = Undefined, "NULL", String(Field));

EndFunction

// Сколько полей у ветви с учётом потерянных голых NULL - по числу колонок запроса.
Function BranchFieldCount(Query, Operator)

	Return Max(Operator.SelectedFields.Count(), Query.Columns.Count());

EndFunction

// Текст - литерал НЕОПРЕДЕЛЕНО и ничего больше.
Function IsUndefinedLiteralText(Text)

	Word = Upper(TrimAll(Text));
	Return Word = "UNDEFINED" Or Word = Upper("Неопределено");

EndFunction

// Есть ли среди ветвей выражения заглушка НЕОПРЕДЕЛЕНО. Разбор тот же, которым ветви
// переводятся, а не поиск по тексту: слово встречается и в условии, и в строке.
Function BranchCarriesUndefined(Source)

	Branches = Undefined;
	Try
		Branches = ExpressionBranches(Source);
	Except
		Return False;
	EndTry;
	If Branches = Undefined Then
		Return False;
	EndIf;
	For Each Arm In Branches.Arms Do
		If IsUndefinedLiteralText(Arm) Then
			Return True;
		EndIf;
	EndDo;
	Return IsUndefinedLiteralText(Branches.Else_);

EndFunction

// Колонки, в которых НЕОПРЕДЕЛЕНО стоит рядом с другим видом значения. Считается по
// всему запросу: в объединении литерал стоит в одной ветви, а значение в другой, и по
// одной ветви такую колонку не узнать.
//
// Колонка без объявленных типов сюда не попадает - в ней нет ничего, кроме литерала,
// и её закрыл шаг 1. Составная по модели тоже: там состав частей объявляет набор типов,
// и прежний путь верен.
Function UndefinedStubColumns(Query)

	Result = New Map;
	Columns = Undefined;
	Operators = Undefined;
	Try
		Columns = Query.Columns;
		Operators = Query.Operators;
	Except
		Return Result;
	EndTry;

	For Index = 0 To Columns.Count() - 1 Do
		Name = TrimAll(Columns[Index].Alias);
		If IsBlankString(Name) Then
			Continue;
		EndIf;
		Mixed = DeclaredTypeMix(Columns[Index]);
		If Mixed.References + Mixed.Primitives = 0
			Or IsCompositeDeclaredType(Columns[Index]) Then
			Continue;
		EndIf;
		For Each Operator In Operators Do
			If Index >= BranchFieldCount(Query, Operator) Then
				Continue;
			EndIf;
			Source = ColumnFieldText(Query, Operator, Index);
			If IsUndefinedLiteralText(Source) Or BranchCarriesUndefined(Source) Then
				Result.Insert(Upper(Name), True);
				Break;
			EndIf;
		EndDo;
	EndDo;
	Return Result;

EndFunction

// Стоит ли литерал НЕОПРЕДЕЛЕНО в этой колонке у другого оператора объединения. НЕОПРЕДЕЛЕНО
// внутри самого выражения (ЕСТЬNULL(п, НЕОПРЕДЕЛЕНО) <> х в условии) - не то: значение колонки
// остаётся булевым (ворота 86, ERP WE MergeOfFixedAssets.DifferentLocation).
Function UndefinedLiteralInOtherBranch(Query, Current, Index)

	For Each Operator In Query.Operators Do
		If Operator = Current Or Index >= BranchFieldCount(Query, Operator) Then
			Continue;
		EndIf;
		If IsUndefinedLiteralText(ColumnFieldText(Query, Operator, Index)) Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Состав частей колонки-заглушки: роли берутся по соседу - по тому, что стоит в колонке
// рядом с литералом. Разбор ветвей умеет это сам, целую ветвь объединения разбирает
// ArmCompositeParts.
Function StubPartRoles(Source, Context, Mixed)

	Roles = New Array;
	If IsUndefinedLiteralText(Source) Then
		// Ветвь объединения - сам литерал: от неё только тег, части значения дают соседние ветви.
		// Пустая ссылка от неё выходила и рядом с одними примитивами, а платформа её там не
		// выводит (замер un.json n1, n2: хранилище рядом с НЕОПРЕДЕЛЕНО - тег, _B, номер вида).
		Roles.Add("_TYPE");
		Return Roles;
	EndIf;
	Found = Undefined;
	Try
		Found = BranchedCompositeParts(Source, Context, True);
	Except
		Found = Undefined;
	EndTry;
	If Found = Undefined Then
		Try
			Found = ArmCompositeParts(Source, Context, True);
		Except
			Found = Undefined;
		EndTry;
	EndIf;
	If Found = Undefined Then
		Return Roles;
	EndIf;

	For Each Suffix In PartRoleOrder() Do
		If Found.Get(Suffix) = Undefined Then
			Continue;
		EndIf;
		// Один ссылочный тип - идентификатор таблицы однозначен, и платформа части
		// _RTRef не выводит вовсе: замеры 9223 (один тип) против 9231 (два).
		If Suffix = "_RTRef" And Mixed.References <= 1 Then
			Continue;
		EndIf;
		Roles.Add(Suffix);
	EndDo;
	Return Roles;

EndFunction

Function PlacementPartSuffixes(Query, Context)

	Cacheable = Not IsBlankString(TrimAll(Query.PlacementTable));
	Marker = "#PARTS:" + Upper(TrimAll(Query.PlacementTable));
	If Cacheable Then
		Cached = Context.TempTables.Get(Marker);
		If Cached <> Undefined Then
			Return Cached;
		EndIf;
	EndIf;

	Result = New Map;
	// Состав частей - объединение по всем ветвям, а не состав первой. Замерено: ветвь
	// с составным только из ссылок против ветви с примитивами выводит семь колонок,
	// а не три, - узкая ветвь дополняет широкую. Брали состав первой ветви, и
	// примитивные значения второй пропадали молча.
	Collected = New Map;
	// Колонки, где литерал НЕОПРЕДЕЛЕНО стоит рядом с другим видом значения: состав их
	// частей набор типов модели не объявляет, потому что литерала в нём нет.
	Stubs = UndefinedStubColumns(Query);
	LiteralRoles = New Map;
	For Each Operator In Query.Operators Do
		Probe = NewContext(Context.Options, New Array, Context.TempTables, "TT");
		// Запрос пробы - тот же: от него зависит, различают ли ветви по частям (PresentationFunctionArmParts).
		Probe.Query = Query;
		Try
			CollectSources(Operator, Probe);
		Except
			Continue;
		EndTry;

		For Index = 0 To BranchFieldCount(Query, Operator) - 1 Do
			If Index >= Query.Columns.Count() Then
				Break;
			EndIf;
			Name = TrimAll(Query.Columns[Index].Alias);
			If IsBlankString(Name) Then
				Continue;
			EndIf;

			Source = ColumnFieldText(Query, Operator, Index);
			// Колонка-условие - булево значение, частей у неё нет (ResultIsNotComposite).
			Condition = False;
			Try
				Condition = IsConditionExpression(Source);
			Except
				Condition = False;
			EndTry;
			If Condition Then
				If Stubs.Get(Upper(Name)) <> Undefined And UndefinedLiteralInOtherBranch(Query, Operator, Index) Then
					// Условие рядом с НЕОПРЕДЕЛЕНО другой ветви: булево значение выходит тегом 0x02 и
					// частью _L (замер mk_casebool_1). Без объявления часть _L ветви-условия не
					// выводилась, и значение держала одна базовая колонка (ворота 85, УХ
					// ВводОстатковВнеоборотныхАктивов.ТекстЗапросаТаблицаПорядокУчетаОСБУ).
					Known = Collected.Get(Upper(Name));
					If Known = Undefined Then
						Known = New Map;
						Collected.Insert(Upper(Name), Known);
					EndIf;
					Known.Insert("_TYPE", True);
					Known.Insert("_L", True);
				EndIf;
				Continue;
			EndIf;
			Composite = CompositePartsOfExpression(Source, Probe);
			If Composite.Parts.Count() = 0 And MixedLiteralColumn(Query, Index) Then
				// Колонка объединения из литералов разных видов (замер lit_uh s2): части - по литералу ветви.
				LiteralParts = Undefined;
				Try
					LiteralParts = ArmCompositeParts(Source, Probe, True);
				Except
					LiteralParts = Undefined;
				EndTry;
				If LiteralParts <> Undefined Then
					Known = Collected.Get(Upper(Name));
					If Known = Undefined Then
						Known = New Map;
						Collected.Insert(Upper(Name), Known);
					EndIf;
					For Each Part In LiteralParts Do
						Known.Insert(Part.Key, True);
					EndDo;
					Continue;
				EndIf;
			EndIf;
			If Composite.Parts.Count() = 0 And AggregatedCompositeParts(Source, Probe, True) <> Undefined Then
				Composite = CompositePartsOfExpression(CompositeAggregateField(Source, Probe), Probe);
			EndIf;
			// Ссылки нескольких типов по ветвям - та же формула: тег, таблица и ссылка из MAX(_RTRef + _RRRef)
			// (замер mk_mmcase_1, mk_mmcase_2, mk_mmisn_1, mk_mmvtmulti_2, 20.11.2026, УХ).
			If Composite.Parts.Count() = 0 And Query.Operators.Count() = 1 And BranchedAggregateArgument(Source)
				And (DeclaredValueKinds(Query.Columns[Index].ValueType) > 1
					Or DeclaredTypeMix(Query.Columns[Index]).References > 1
					Or Not IsBlankString(UndefinedAggregateArgument(Source))) Then
				// МАКСИМУМ/МИНИМУМ над значением разных видов по ветвям: части - роли аргумента.
				Copy = Source;
				AggregateRoles = Undefined;
				Try
					AggregateRoles = BranchedAggregateParts(Copy, Probe, True,
						DeclaredTypeMix(Query.Columns[Index]).References);
				Except
					AggregateRoles = Undefined;
				EndTry;
				If AggregateRoles <> Undefined Then
					Known = Collected.Get(Upper(Name));
					If Known = Undefined Then
						Known = New Map;
						Collected.Insert(Upper(Name), Known);
					EndIf;
					For Each Part In AggregateRoles Do
						Known.Insert(Part.Key, True);
					EndDo;
					Continue;
				EndIf;
			EndIf;
			If Composite.Parts.Count() = 0 Then
				// Состав частей объявляют и выражения, у которых хранимого поля нет вовсе.
				// Ссылка одного типа: тег не неизвестен, а константен, и платформа ставит его
				// литералом. Выражение по ветвям: части собираются из частей ветвей. В обоих
				// случаях объявить состав надо здесь - он общий для всех ветвей объединения.
				Declared = New Array;
				// У колонки, чей результат не составной, части объявлять не надо: иначе к
				// строковой колонке приписываются _TYPE и _S, которых платформа не выводит.
				If IsCompositeDeclaredType(Query.Columns[Index])
					And Not ResultIsNotComposite(Source) Then
					// Колонка, которая держит и ссылку, и примитив, составом из одних
					// ссылочных частей не описывается: ветви с примитивом класть значение
					// некуда. Объявить такой состав - значит выдать правдоподобный, но
					// неверный SQL: замерено на Documents/VATAllocation (ВЫБРАТЬ 1 …
					// ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Остатки.Организация) - число уезжает базовой
					// колонкой рядом с шестнадцатью байтами ссылки, а части ветви с
					// единицей выходят NULL. Пока примитивные части по ветвям не
					// собираются, состав остаётся пустым, и выше срабатывает прежний
					// отказ - он честнее. Семь запросов ERP, пойманы корпусным прогоном.
					Mixed = DeclaredTypeMix(Query.Columns[Index]);
					If Not IsBlankString(SingleReferenceTarget(Source, Probe))
						And Not (Mixed.References > 0 And Mixed.Primitives > 0) Then
						Declared.Add("_TYPE");
						Declared.Add("_RTRef");
						Declared.Add("_RRRef");
					Else
						Branched = Undefined;
						Try
							Branched = BranchedCompositeParts(Source, Probe, True);
							If Branched = Undefined Then
								// Переход к составному полю, стоящий колонкой, а не ветвью.
								Branched = NavigatedCompositeParts(Source, Probe);
							EndIf;
						Except
							// Пробный разбор: что не вышло здесь, не выйдет и при выводе.
							Branched = Undefined;
						EndTry;
						If Branched = Undefined Then
							// Ветвь объединения целиком: примитив, ссылка одного типа,
							// ЗНАЧЕНИЕ(...). Разбор ветви это умеет, и состав частей здесь
							// берётся им же - иначе состав остаётся пустым и срабатывает
							// отказ, хотя значение выразимо.
							Try
								Branched = ArmCompositeParts(Source, Probe, True);
							Except
								Branched = Undefined;
							EndTry;
						EndIf;
						If Branched <> Undefined Then
							For Each Part In Branched Do
								// Один ссылочный тип - идентификатор таблицы однозначен, и
								// платформа части _RTRef не выводит вовсе: замерено двумя
								// запросами, с одним типом три колонки, с двумя четыре.
								If Part.Key = "_RTRef" And Mixed.References = 1 Then
									Continue;
								EndIf;
								Declared.Add(Part.Key);
							EndDo;
						EndIf;
					EndIf;
				EndIf;

				If Declared.Count() = 0 And IsTypeValueCall(Source)
					And DeclaredValueKinds(Query.Columns[Index].ValueType) > 1 Then
					// ТИПЗНАЧЕНИЯ ветвью объединения рядом с ветвью другого вида: части значения
					// типа - тег 0x06, _B и номер вида (замер vs3, 20.11.2026, УХ: `0x06, @P,
					// 0x08 + 0x000000E6, @P` против `0x05, 'абв', 0x, -1`). Сам по себе вызов
					// составным не считается (ResultIsNotComposite), и колонка уходила одной -
					// байты типа рядом со строкой.
					TypeParts = Undefined;
					Try
						TypeParts = ArmCompositeParts(Source, Probe, True);
					Except
						TypeParts = Undefined;
					EndTry;
					If TypeParts <> Undefined Then
						For Each Part In TypeParts Do
							Declared.Add(Part.Key);
						EndDo;
					EndIf;
				EndIf;

				If IsCompositeDeclaredType(Query.Columns[Index])
					And IsLiteralExpression(Source) Then
					// Литерал в разнотипной колонке - одна из её ветвей. Его роль добавляется
					// после обхода, и только туда, где состав объявила другая часть.
					LiteralParts = Undefined;
					Try
						LiteralParts = PrimitiveArmParts(Source, Probe);
					Except
						LiteralParts = Undefined;
					EndTry;
					If LiteralParts <> Undefined Then
						Roles = LiteralRoles.Get(Upper(Name));
						If Roles = Undefined Then
							Roles = New Array;
							LiteralRoles.Insert(Upper(Name), Roles);
						EndIf;
						For Each Part In LiteralParts Do
							Roles.Add(Part.Key);
						EndDo;
					EndIf;
				EndIf;

				If Declared.Count() = 0 And (Stubs.Get(Upper(Name)) <> Undefined
					Or ParameterArmMixesKinds(Source, Probe)) Then
					// Заглушка рядом с значением: платформа выводит части и базовой колонки не
					// выводит вовсе (замеры 9261-9263). Базовую колонку мы оставляем - следующие
					// запросы пакета обращаются к ней по имени, - а части добавляем: без них
					// сравнение с НЕОПРЕДЕЛЕНО сворачивалось в константу и отвечало иначе, чем
					// платформа, молча. Ветвь-параметр рядом с ветвью другого вида - тот же
					// случай: модель тип параметра не знает и колонку составной не объявляет.
					For Each Suffix In StubPartRoles(Source, Probe,
						DeclaredTypeMix(Query.Columns[Index])) Do
						Declared.Add(Suffix);
					EndDo;
				EndIf;

				If Declared.Count() > 0 Then
					Known = Collected.Get(Upper(Name));
					If Known = Undefined Then
						Known = New Map;
						Collected.Insert(Upper(Name), Known);
					EndIf;
					For Each Suffix In Declared Do
						Known.Insert(Suffix, True);
					EndDo;
				EndIf;
				Continue;
			EndIf;
			Known = Collected.Get(Upper(Name));
			If Known = Undefined Then
				Known = New Map;
				Collected.Insert(Upper(Name), Known);
			EndIf;
			For Each Part In Composite.Parts Do
				Known.Insert(Mid(PartAlias(Name, Part), StrLen(Name) + 1), True);
			EndDo;
		EndDo;
	EndDo;

	For Each Entry In LiteralRoles Do
		Known = Collected.Get(Entry.Key);
		If Known = Undefined Then
			Continue;
		EndIf;
		If Known.Get("_TYPE") = Undefined Then
			// Хранимое составное из одних ссылок (Регистратор) тега не хранит, но рядом с литералом
			// значение держит и примитив: платформа выводит тег, часть литерала, _RTRef и _RRRef
			// (замер cl_s, cl_n, 20.11.2026, УХ: `0x08, @P, _RecorderTRef, _RecorderRRef` против
			// `0x05, @P, 0x00000000, 0x00…`). Без тега строка ложилась в колонку ссылки.
			If Known.Get("_RTRef") = Undefined Or Known.Get("_RRRef") = Undefined Then
				Continue;
			EndIf;
			Known.Insert("_TYPE", True);
		EndIf;
		For Each Suffix In Entry.Value Do
			Known.Insert(Suffix, True);
		EndDo;
	EndDo;

	// Порядок частей - порядок хранения: тег типа, примитивы, ссылочные части. В этом
	// же порядке их выводит платформа, поэтому отдельного правила не нужно.
	For Each Entry In Collected Do
		Ordered = New Array;
		For Each Suffix In PartRoleOrder() Do
			If Entry.Value.Get(Suffix) <> Undefined Then
				Ordered.Add(Suffix);
			EndIf;
		EndDo;
		For Each Part In Entry.Value Do
			If Ordered.Find(Part.Key) = Undefined Then
				Ordered.Add(Part.Key);
			EndIf;
		EndDo;
		Result.Insert(Entry.Key, Ordered);
	EndDo;

	If Cacheable Then
		Context.TempTables.Insert(Marker, Result);
	EndIf;
	Return Result;

EndFunction

// Служебный тип, которым схема запроса обозначает вложенную таблицу, называется на
// языке платформы: QuerySchemaNestedTable на английской, ВложеннаяТаблицаСхемыЗапроса
// на русской. Проверяются оба написания - по TypeOf такую проверку не сделать.
Function IsNestedTableField(Field)

	Text = String(Field);
	Return StrFind(Text, "QuerySchemaNestedTable") > 0
		Or StrFind(Text, "ВложеннаяТаблицаСхемыЗапроса") > 0;

EndFunction

// Колонки-вложенные таблицы: их значение - таблица, и в SQL такого типа нет. Платформа
// читает их отдельным запросом уже после СУБД, поэтому здесь они опускаются, а в
// предупреждениях называются поимённо. Считаются один раз на запрос и по всем ветвям
// сразу: опустить колонку в одной ветви значит разойтись числом колонок.
Function NestedTableColumns(Query, Context)

	Result = New Map;
	For Each Operator In Query.Operators Do
		// По номеру колонки, а не поля ветви: голый NULL модель из полей ветви теряет (ColumnField), и
		// номера расходятся - опускалась бы чужая колонка (ворота 95, 21.11.2026, УХ: СуммаПР вместо
		// Счет.ВидыСубконто.(…) после трёх NULL).
		For Index = 0 To BranchFieldCount(Query, Operator) - 1 Do
			If Result.Get(Index) <> Undefined Then
				Continue;
			EndIf;
			Field = ColumnField(Query, Operator, Index);
			If Field = Undefined Or Not IsNestedTableField(Field) Then
				Continue;
			EndIf;
			Result.Insert(Index, True);
			Name = ?(Index < Query.Columns.Count(),
				TrimAll(Query.Columns[Index].Alias), Format(Index, "NG=0; NZ=0"));
			AddOnce(Context.Warnings, StrTemplate(
				"Column %1 selects a nested table (a tabular section inside the select list)"
				+ " and is left out: its value is a table of its own, and the platform builds"
				+ " it with a separate query after the DBMS has answered. Query that tabular"
				+ " section separately and join it by the reference.", Name));
		EndDo;
	EndDo;
	Return Result;

EndFunction

// Обычно псевдонимы выводит только первая ветвь объединения: остальные T-SQL всё
// равно не использует. Но объединение, наполняющее временную таблицу, выводится общим
// табличным выражением, а внутри него ORDER BY по псевдониму первой ветви не
// связывается - замерено на MS SQL. Там псевдонимы нужны в каждой ветви.
Function AliasEveryOperator(Query)

	// Часть с ПЕРВЫЕ упорядочивается внутри своего подзапроса по псевдонимам колонок.
	Return Query.Order.Count() > 0 And Query.Operators.Count() > 1
		And (Not IsBlankString(Query.PlacementTable) Or UnionPartIsLimited(Query));

EndFunction

// МАКСИМУМ и МИНИМУМ от составного поля. Замерено: платформа берёт максимум по тегу
// типа, а ссылочную часть достаёт из MAX(RTRef + RRRef) через SUBSTRING, то есть
// сравнивает сначала тип, потом байты ссылки. Максимум по одной колонке ссылки даёт
// другую строку, и расходится это молча - поэтому отказ, а не приближение.
Function CompositeAggregateField(Text, Context)

	Trimmed = TrimAll(Text);
	Open = StrFind(Trimmed, "(");
	If Open = 0 Or Not StrEndsWith(Trimmed, ")") Then
		Return "";
	EndIf;

	Name = Upper(TrimAll(Left(Trimmed, Open - 1)));
	If Name <> "MAX" And Name <> Upper("Максимум") And Name <> "MIN" And Name <> Upper("Минимум") Then
		Return "";
	EndIf;

	Argument = TrimAll(Mid(Trimmed, Open + 1, StrLen(Trimmed) - Open - 1));
	If CompositePartsOfExpression(Argument, Context).Parts.Count() = 0 Then
		Return "";
	EndIf;
	Return Argument;

EndFunction

// МАКСИМУМ/МИНИМУМ хранимого составного поля с тегом - частями, как платформа. Замер 18.11.2026
// (УХ, mm_uh m1-m3): _TYPE - MAX(_TYPE); примитивная часть вида K - CASE WHEN MAX(_TYPE) = K THEN
// MAX(CASE WHEN _TYPE = K THEN часть END) ELSE CASE WHEN MAX(_TYPE) IS NOT NULL THEN <пустое> END END;
// ссылка - SUBSTRING(MAX(_RTRef + _RRRef), 1, 4) и (5, 16) при MAX(_TYPE) = 0x08. Тег сравнивается
// первым, поэтому МИНИМУМ бывает НЕОПРЕДЕЛЕНО (0x01). Неопределено - не этот случай: поле без тега
// (регистратор - AggregatedCompositeRef), ссылка без части таблицы, PostgreSQL.
// Аргумент агрегата верхнего уровня собран по ветвям: ВЫБОР или ЕСТЬNULL.
Function BranchedAggregateArgument(Text)

	Trimmed = TrimAll(Text);
	Open = StrFind(Trimmed, "(");
	If Open = 0 Then
		Return False;
	EndIf;
	Tokens = Tokenize(Mid(Trimmed, Open + 1));
	If Tokens.Count() = 0 Or Tokens[0].Kind <> "Name" Then
		Return False;
	EndIf;
	Word = Upper(Tokens[0].Value);
	Return Word = "CASE" Or Word = Upper("Выбор") Or Word = "ISNULL" Or Word = Upper("ЕстьNULL");

EndFunction

// Сколько видов значения объявлено у колонки: число, строка, дата, булево, ссылка (все ссылки - один вид).
Function DeclaredValueKinds(ValueType)

	If ValueType = Undefined Then
		Return 0;
	EndIf;
	Kinds = New Map;
	For Each Item In ValueType.Types() Do
		If Item = Type("Null") Or Item = Type("Undefined") Then
			Continue;
		ElsIf Item = Type("Number") Or Item = Type("String") Or Item = Type("Date") Or Item = Type("Boolean") Then
			Kinds.Insert(String(Item), True);
		Else
			Kinds.Insert("Reference", True);
		EndIf;
	EndDo;
	Return Kinds.Count();

EndFunction

// Сколько ролей значения (не тега и не таблицы ссылки) в составе частей.
Function ValueRoleCount(Suffixes)

	Count = 0;
	For Each Suffix In Suffixes Do
		If Suffix = "_L" Or Suffix = "_N" Or Suffix = "_T" Or Suffix = "_S" Or Suffix = "_RRRef" Then
			Count = Count + 1;
		EndIf;
	EndDo;
	Return Count;

EndFunction

// Untagged - и у составного без тега (регистратор): таблица и ссылка из одного MAX(_RTRef + _RRRef). Так описывается
// колонка временной таблицы и подзапроса (замеры xm3, xm4, 21.11.2026, УХ: `SUBSTRING(MAX(T2._RecorderTRef +
// T2._RecorderRRef),1,4)` и `(…,5,16)` - две колонки; внешний МАКСИМУМ и переход по типам читают обе).
Function AggregatedCompositeParts(Text, Context, Untagged = False)

	Argument = CompositeAggregateField(Text, Context);
	If IsBlankString(Argument) Or Context.Options.Dialect = "PostgreSQL" Then
		Return Undefined;
	EndIf;
	Trimmed = TrimAll(Text);
	Name = Upper(TrimAll(Left(Trimmed, StrFind(Trimmed, "(") - 1)));
	Aggregate = ?(Name = "MAX" Or Name = Upper("Максимум"), "MAX", "MIN");
	Composite = CompositePartsOfExpression(Argument, Context);
	Columns = New Map;
	For Each Part In Composite.Parts Do
		Columns.Insert(Mid(PartAlias("X", Part), 2), FieldColumn(Composite.Descriptor, Composite.Alias, Part, Context));
	EndDo;
	If Untagged And Columns.Count() = 2 And Columns.Get("_RTRef") <> Undefined And Columns.Get("_RRRef") <> Undefined Then
		Joined = Aggregate + "(" + Columns.Get("_RTRef") + " + " + Columns.Get("_RRRef") + ")";
		Result = New Map;
		Result.Insert("_RTRef", "SUBSTRING(" + Joined + ", 1, 4)");
		Result.Insert("_RRRef", "SUBSTRING(" + Joined + ", 5, 16)");
		Return Result;
	EndIf;
	// Колонка временной таблицы или подзапроса из ссылки одного типа и НЕОПРЕДЕЛЕНО держит тег и _RRRef
	// без _RTRef; ссылка берётся как часть вида 0x08 - MAX(CASE WHEN _TYPE = 0x08 THEN _RRRef END)
	// (замер mk_mmvtund_1, mk_mmvtund_2, 20.11.2026, УХ). Хранимое поле «примитивы и один ссылочный тип» - так же
	// (замер mp1, 20.11.2026, УХ, ОтветыНаВопросыАнкет.Ответ). У виртуальной таблицы не замерено.
	Return AggregatePartsFormula(Aggregate, Columns, Context, Composite.Descriptor.Purpose = "TemporaryTable"
		Or Not Composite.Descriptor.IsDerived);

EndFunction

// Части МАКСИМУМ/МИНИМУМ составного значения по частям аргумента (Columns: суффикс - SQL части).
Function AggregatePartsFormula(Aggregate, Columns, Context, SingleReference = False)

	Tag = Columns.Get("_TYPE");
	// Ссылка одного типа без части таблицы: её часть берётся, как часть примитива вида 0x08, -
	// MAX(CASE WHEN тег = 0x08 THEN ссылка END) при MAX(тег) = 0x08 (замер aggu a1, a2, a7,
	// 19.11.2026: ЕСТЬNULL(ссылка, НЕОПРЕДЕЛЕНО), ВЫБОР … ИНАЧЕ НЕОПРЕДЕЛЕНО).
	ReferenceAsKind = SingleReference And Columns.Get("_RTRef") = Undefined And Columns.Get("_RRRef") <> Undefined;
	If Tag = Undefined Or ((Columns.Get("_RRRef") <> Undefined) <> (Columns.Get("_RTRef") <> Undefined)
		And Not ReferenceAsKind) Then
		Return Undefined;
	EndIf;
	MaxTag = Aggregate + "(" + Tag + ")";
	Kinds = New Map;
	Kinds.Insert("_L", "02");
	Kinds.Insert("_N", "03");
	Kinds.Insert("_T", "04");
	Kinds.Insert("_S", "05");
	If ReferenceAsKind Then
		Kinds.Insert("_RRRef", "08");
	EndIf;
	Result = New Map;
	Result.Insert("_TYPE", MaxTag);
	For Each Suffix In PartRoleOrder() Do
		Column = Columns.Get(Suffix);
		Kind = Kinds.Get(Suffix);
		If Column = Undefined Or Kind = Undefined Then
			Continue;
		EndIf;
		EmptyValue = ?(Suffix = "_N", "0.0", EmptyPartLiteral(Suffix, Context));
		Result.Insert(Suffix, "CASE WHEN " + MaxTag + " = " + BinaryLiteral(Kind, Context) + " THEN " + Aggregate
			+ "(CASE WHEN " + Tag + " = " + BinaryLiteral(Kind, Context) + " THEN " + Column + " END) ELSE CASE WHEN "
			+ MaxTag + " IS NOT NULL THEN " + EmptyValue + " END END");
	EndDo;
	If Columns.Get("_RRRef") <> Undefined And Not ReferenceAsKind Then
		Joined = Aggregate + "(" + Columns.Get("_RTRef") + " + " + Columns.Get("_RRRef") + ")";
		Result.Insert("_RTRef", "CASE WHEN " + MaxTag + " = " + BinaryLiteral("08", Context) + " THEN SUBSTRING("
			+ Joined + ", 1, 4) ELSE CASE WHEN " + MaxTag + " IS NOT NULL THEN " + EmptyPartLiteral("_RTRef", Context)
			+ " END END");
		Result.Insert("_RRRef", "CASE WHEN " + MaxTag + " = " + BinaryLiteral("08", Context) + " THEN SUBSTRING("
			+ Joined + ", 5, 16) ELSE CASE WHEN " + MaxTag + " IS NOT NULL THEN " + EmptyPartLiteral("_RRRef", Context)
			+ " END END");
	EndIf;
	Return Result;

EndFunction

// МАКСИМУМ/МИНИМУМ над значением разных видов, собранным по ветвям (ВЫБОР, ЕСТЬNULL). Замер 19.11.2026
// (УХ, agg_uh ag1, ag2): та же формула, что у хранимого поля, над частями аргумента - тег по ветвям,
// часть вида K - ВЫБОР по ветвям с пустыми значениями чужих видов. Неопределено - аргумент не разобран.
Function BranchedAggregateParts(Text, Context, RolesOnly = False, References = -1)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return Undefined;
	EndIf;
	Name = TopLevelAggregate(Text);
	If Name = "MAX" Or Name = Upper("Максимум") Then
		Aggregate = "MAX";
	ElsIf Name = "MIN" Or Name = Upper("Минимум") Then
		Aggregate = "MIN";
	Else
		Return Undefined;
	EndIf;
	Tokens = Tokenize(TrimAll(Text));
	If Tokens.Count() < 4 Or Tokens[1].Value <> "(" Or Tokens[Tokens.Count() - 1].Value <> ")" Then
		Return Undefined;
	EndIf;
	Depth = 0;
	For Index = 1 To Tokens.Count() - 1 Do
		If Tokens[Index].Kind = "Symbol" And Tokens[Index].Value = "(" Then
			Depth = Depth + 1;
		ElsIf Tokens[Index].Kind = "Symbol" And Tokens[Index].Value = ")" Then
			Depth = Depth - 1;
			If Depth = 0 And Index < Tokens.Count() - 1 Then
				Return Undefined;
			EndIf;
		EndIf;
	EndDo;
	Argument = TokensText(Tokens, 2, Tokens.Count() - 2);
	Parts = Undefined;
	Try
		Parts = BranchedCompositeParts(Argument, Context, RolesOnly);
	Except
		Parts = Undefined;
	EndTry;
	If Parts = Undefined Then
		Argument = TokensText(Tokens, 2, Tokens.Count() - 2);
		Try
			Parts = ArmCompositeParts(Argument, Context, RolesOnly);
		Except
			Parts = Undefined;
		EndTry;
	EndIf;
	If Parts = Undefined Or Parts.Get("_TYPE") = Undefined Or Parts.Get("_B") <> Undefined Then
		Return Undefined;
	EndIf;
	// Ссылка рядом с НЕОПРЕДЕЛЕНО замерена (aggu a1-a7, 19.11.2026): одного типа - тег и ссылка,
	// нескольких (регистратор) - тег, таблица и ссылка из MAX(_RTRef + _RRRef). Ссылка рядом с
	// примитивом - та же формула, примитив - частью своего вида (замер mk_mxlit_1, mk_mxlit_2,
	// mk_mxsel_1, mk_mxsel_2, 20.11.2026, УХ); число ссылочных типов даёт объявленный тип колонки.
	Referenced = Parts.Get("_RRRef") <> Undefined Or Parts.Get("_RTRef") <> Undefined;
	If Referenced Then
		If References < 1 Or Parts.Get("_RRRef") = Undefined
			Or (References > 1 And Parts.Get("_RTRef") = Undefined) Then
			Return Undefined;
		EndIf;
		If References = 1 Then
			Parts.Delete("_RTRef");
		EndIf;
	EndIf;
	If RolesOnly Then
		Return Parts;
	EndIf;
	Return AggregatePartsFormula(Aggregate, Parts, Context, Referenced And References = 1);

EndFunction

// МАКСИМУМ/МИНИМУМ над хранимым составным полем без тега (регистратор): ссылка по формуле
// платформы. Замер 17.11.2026 (УХ, кеш планов): SUBSTRING(MAX(_RecorderTRef + _RecorderRRef), 5, 16).
// У поля с тегом платформа берёт MAX(_TYPE) и ссылку из MAX(_RTRef + _RRRef) - значение выходит
// частями, и одной колонкой его не выразить; поле с примитивными частями не замерено. Там пустая
// строка, и прежний отказ остаётся.
Function AggregatedCompositeRef(Text, Context)

	Argument = CompositeAggregateField(Text, Context);
	If IsBlankString(Argument) Or Context.Options.Dialect = "PostgreSQL" Then
		Return "";
	EndIf;
	Trimmed = TrimAll(Text);
	Name = Upper(TrimAll(Left(Trimmed, StrFind(Trimmed, "(") - 1)));
	Aggregate = ?(Name = "MAX" Or Name = Upper("Максимум"), "MAX", "MIN");
	Composite = CompositePartsOfExpression(Argument, Context);
	Columns = New Map;
	For Each Part In Composite.Parts Do
		Suffix = Mid(PartAlias("X", Part), 2);
		If Suffix <> "_TYPE" And Suffix <> "_RTRef" And Suffix <> "_RRRef" Then
			Return "";
		EndIf;
		Columns.Insert(Suffix, FieldColumn(Composite.Descriptor, Composite.Alias, Part, Context));
	EndDo;
	TableColumn = Columns.Get("_RTRef");
	ReferenceColumn = Columns.Get("_RRRef");
	If TableColumn = Undefined Or ReferenceColumn = Undefined Then
		Return "";
	EndIf;
	If Columns.Get("_TYPE") <> Undefined Then
		// С тегом минимум бывает НЕОПРЕДЕЛЕНО: платформа отдаёт его частью _TYPE, а одна колонка
		// ссылки вернула бы нули - другое значение (сверка 17.11.2026, МИНИМУМ(СубконтоДт1)).
		Return "";
	EndIf;
	Return "SUBSTRING(" + Aggregate + "(" + TableColumn + " + " + ReferenceColumn + "), 5, 16)";

EndFunction

// КОЛИЧЕСТВО(РАЗЛИЧНЫЕ <составное>): аргумент, если считать различные просят по
// составному значению. Пустая строка - не наш случай.
//
// Такое количество в T-SQL одним выражением не выражается: COUNT(DISTINCT …) берёт одну
// колонку, а составное значение живёт в нескольких - теге типа, идентификаторе таблицы и
// ссылке. Счёт по одной колонке ссылки **меньше**: значения разных типов с одним и тем же
// uuid сольются в одно. Выдать заниженное число молча нельзя, поэтому отказ.
// КОЛИЧЕСТВО(РАЗЛИЧНЫЕ <составное из ссылок с тегом>). По одной колонке ссылки сливаются
// НЕОПРЕДЕЛЕНО и пустые ссылки разных типов - у всех нули (сверка battery25: 1С 10, SQL 9).
// Значение составного - это тройка тег, таблица, ссылка, и склейка их байтов различает
// значения так же; NULL любой части даёт NULL склейки, и строка без значения не считается,
// как и у COUNT по полю. Форма платформы не замерена. Пустая строка - не этот случай.
// КОЛИЧЕСТВО(РАЗЛИЧНЫЕ) составного с примитивами - сумма счётов по видам, как у платформы (замер cd01): НЕОПРЕДЕЛЕНО,
// булево, число, дата, строка, ссылка. Пустая строка - есть часть, которой платформа так не считает (двоичная).
Function KindwiseDistinctCountSql(Composite, Context)

	Roles = New Map;
	For Each Column In Composite.Parts Do
		Name = Upper(TrimAll(String(Column)));
		Sql = FieldColumn(Composite.Descriptor, Composite.Alias, Column, Context);
		Matched = False;
		For Each Suffix In StrSplit("_TYPE,_RTREF,_RRREF,_L,_N,_T,_S", ",") Do
			If StrEndsWith(Name, Suffix) Then
				Roles.Insert(Suffix, Sql);
				Matched = True;
				Break;
			EndIf;
		EndDo;
		If Not Matched Then
			Return "";
		EndIf;
	EndDo;
	Tag = Roles.Get("_TYPE");
	If Tag = Undefined Then
		Return "";
	EndIf;
	Terms = New Array;
	Terms.Add("COUNT(DISTINCT CASE WHEN " + Tag + " = " + BinaryLiteral("01", Context) + " THEN "
		+ BinaryLiteral("01", Context) + " END)");
	Kinds = New Map;
	Kinds.Insert("_L", "02");
	Kinds.Insert("_N", "03");
	Kinds.Insert("_T", "04");
	Kinds.Insert("_S", "05");
	For Each Suffix In StrSplit("_L,_N,_T,_S", ",") Do
		Part = Roles.Get(Suffix);
		If Part <> Undefined Then
			Terms.Add("COUNT(DISTINCT CASE WHEN " + Tag + " = " + BinaryLiteral(Kinds.Get(Suffix), Context) + " THEN "
				+ Part + " END)");
		EndIf;
	EndDo;
	Reference = Roles.Get("_RRREF");
	If Reference <> Undefined Then
		Table = Roles.Get("_RTREF");
		Terms.Add("COUNT(DISTINCT CASE WHEN " + Tag + " = " + BinaryLiteral("08", Context) + " THEN "
			+ ?(Table = Undefined, "", Table + " + ") + Reference + " END)");
	EndIf;
	Return "CAST((" + StrConcat(Terms, " + ") + ") AS NUMERIC(12, 0))";

EndFunction

Function CompositeDistinctCountSql(Text, Context)

	Trimmed = TrimAll(Text);
	Open = StrFind(Trimmed, "(");
	If Open = 0 Or Not StrEndsWith(Trimmed, ")") Then
		Return "";
	EndIf;
	Name = Upper(TrimAll(Left(Trimmed, Open - 1)));
	If Name <> "COUNT" And Name <> Upper("Количество") Then
		Return "";
	EndIf;
	Argument = TrimAll(Mid(Trimmed, Open + 1, StrLen(Trimmed) - Open - 1));
	Upper_ = Upper(Argument);
	Prefix = "";
	If StrStartsWith(Upper_, "DISTINCT ") Then
		Prefix = "DISTINCT ";
	ElsIf StrStartsWith(Upper_, Upper("Различные") + " ") Then
		Prefix = Upper("Различные") + " ";
	EndIf;
	If IsBlankString(Prefix) Then
		Return "";
	EndIf;
	Argument = TrimAll(Mid(Argument, StrLen(Prefix) + 1));
	Composite = CompositePartsOfExpression(Argument, Context);
	If Composite.Parts.Count() >= 2 And PartsHoldPrimitive(Composite.Parts)
		And Context.Options.Dialect <> "PostgreSQL" Then
		Return KindwiseDistinctCountSql(Composite, Context);
	EndIf;
	If Composite.Parts.Count() < 2 Or PartsHoldPrimitive(Composite.Parts) Then
		Return "";
	EndIf;
	Columns = New Array;
	For Each Column In Composite.Parts Do
		Columns.Add(FieldColumn(Composite.Descriptor, Composite.Alias, Column, Context));
	EndDo;
	If Context.Options.Dialect = "PostgreSQL" Then
		Return "COUNT(DISTINCT " + StrConcat(Columns, " || ") + ")";
	EndIf;
	// Как и прочее КОЛИЧЕСТВО у платформы - numeric(12, 0) (сверка типов 17.11.2026: bigint у перевода).
	Return "CAST(COUNT_BIG(DISTINCT " + StrConcat(Columns, " + ") + ") AS NUMERIC(12, 0))";

EndFunction

Function CompositeDistinctCountField(Text, Context)

	Trimmed = TrimAll(Text);
	Open = StrFind(Trimmed, "(");
	If Open = 0 Or Not StrEndsWith(Trimmed, ")") Then
		Return "";
	EndIf;

	Name = Upper(TrimAll(Left(Trimmed, Open - 1)));
	If Name <> "COUNT" And Name <> Upper("Количество") Then
		Return "";
	EndIf;

	Argument = TrimAll(Mid(Trimmed, Open + 1, StrLen(Trimmed) - Open - 1));
	Upper_ = Upper(Argument);
	Prefix = "";
	If StrStartsWith(Upper_, "DISTINCT ") Then
		Prefix = "DISTINCT ";
	ElsIf StrStartsWith(Upper_, Upper("Различные") + " ") Then
		Prefix = Upper("Различные") + " ";
	EndIf;
	If IsBlankString(Prefix) Then
		Return "";
	EndIf;

	Argument = TrimAll(Mid(Argument, StrLen(Prefix) + 1));
	Parts = CompositePartsOfExpression(Argument, Context).Parts;
	If Parts.Count() = 0 Then
		Return "";
	EndIf;

	// Отказ нужен только там, где колонки самого значения не существует: у разнотипного
	// составного (ссылка рядом с числом, строкой или датой). У составного из одних ссылок
	// колонка ссылки есть, счёт по ней сверен с 1С (Reports/МатрицаРисков, 20 строк против
	// 20), и отказывать там нечему.
	If Not PartsHoldPrimitive(Parts) Then
		Return "";
	EndIf;
	If Not IsBlankString(CompositeDistinctCountSql(Trimmed, Context)) Then
		// Счёт по видам (замер cd01) - переводится.
		Return "";
	EndIf;
	Return Argument;

EndFunction

// Держат ли части составного значения примитивную роль: строку, число, дату или булево.
// Роль видна по суффиксу имени части, одинаковому и у хранимых колонок, и у подколонок
// временной таблицы.
Function PartsHoldPrimitive(Parts)

	For Each Part In Parts Do
		Name = Upper(TrimAll(String(Part)));
		If StrEndsWith(Name, "_L") Or StrEndsWith(Name, "_N")
			Or StrEndsWith(Name, "_T") Or StrEndsWith(Name, "_S") Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Ветвь объединения, значение которой односоставное, сведений о типе не теряет.
// Замерено: платформа ставит на место частей константы - 0x08 и идентификатор таблицы, -
// а колонкой ссылки само значение. NULL на их месте означал бы «тип неизвестен», хотя
// он известен статически, и в объединении это именно та сведения, которая нужна.
//
// Разбирается только простой путь с точкой, разрешающийся в ссылку одного типа: для
// выражения тип пришлось бы выводить, а вывода типов здесь нет.
// Таблица-получатель ссылки одного типа, либо пустая строка. Выделено из подстановки
// констант: тот же вопрос задаётся при согласовании состава частей по ветвям, когда
// текста SQL ещё нет.
Function SingleReferenceTarget(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return "";
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return "";
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;

	Origin = OriginOfResolved(Resolved);
	If Origin = Undefined Then
		Return "";
	EndIf;

	Try
		Return ReferencedTableName(Origin.LogicalName, Origin.FieldName);
	Except
		// Поле не ссылка одного типа, производная таблица или метаданных нет.
		Return "";
	EndTry;

EndFunction

// Колонка производной таблицы - субконто виртуальной таблицы бухгалтерского регистра: её
// значение типизировано видом характеристики (см. AccountingDescriptor).
Function IsCharacteristicValue(Resolved)

	Descriptor = Resolved.Descriptor;
	If Not Descriptor.IsDerived Or Not Descriptor.Property("ColumnSources")
		Or Descriptor.ColumnSources = Undefined Then
		Return False;
	EndIf;
	Origin = Descriptor.ColumnSources.Get(Upper(TrimAll(Resolved.FieldName)));
	Return Origin <> Undefined And Origin.Property("Characteristic") And Origin.Characteristic = True;

EndFunction

// Поле производной таблицы - виртуальной, временной или вложенного запроса - метаданных
// за собой не имеет, но ведёт к полю исходной таблицы: это записано в ColumnSources.
// Переход по ним даёт место, где у поля есть тип.
//
// Замерено (CashInTransit.Balance в объединении с регистром): без перехода части
// составной колонки выводились как NULL, строки ветви не схлопывались с такими же из
// другой ветви, и запрос с ИМЕЮЩИЕ СУММА(…) <> 0 отдавал 4 строки там, где 1С - ни
// одной. Поле того же регистра, взятое из таблицы записей, части подставляло верно -
// разница была только в производной таблице.
Function OriginOfResolved(Resolved)

	Descriptor = Resolved.Descriptor;
	FieldName = Resolved.FieldName;

	// Производная таблица может стоять над производной: вложенный запрос над
	// виртуальной таблицей. Шагов немного, но цикл закрыт от зацикливания.
	For Hop = 1 To 8 Do
		If Not Descriptor.IsDerived Then
			Break;
		EndIf;
		Origin = Undefined;
		If Descriptor.Property("ColumnSources") And Descriptor.ColumnSources <> Undefined Then
			Origin = Descriptor.ColumnSources.Get(Upper(TrimAll(FieldName)));
		EndIf;
		If Origin = Undefined Then
			Return Undefined;
		EndIf;
		Hopped = Undefined;
		Try
			Hopped = TableDescriptor(Origin.LogicalName);
		Except
			Return Undefined;
		EndTry;
		Descriptor = Hopped;
		FieldName = Origin.FieldName;
	EndDo;

	If Descriptor.IsDerived Then
		Return Undefined;
	EndIf;

	Result = New Structure;
	Result.Insert("LogicalName", Descriptor.LogicalName);
	Result.Insert("FieldName", FieldName);
	Return Result;

EndFunction

Function SinglePartFallbacks(Text, Expression, Context)

	Result = New Map;
	Target = SingleReferenceTarget(Text, Context);
	If IsBlankString(Target) Then
		// ЗНАЧЕНИЕ(Таблица.Имя) ссылкой одного типа тоже является, и части у неё
		// константны. Распознаватель выше отступает, увидев скобку: он писался для пути
		// к полю. Без этой ветки части выводились как NULL, строки не схлопывались с
		// такими же из других ветвей ОБЪЕДИНИТЬ, и строк выходило больше, чем у 1С.
		Inside = PredefinedValueArgument(TrimAll(Text));
		If Not IsBlankString(Inside) Then
			Origin = TypeOrigin(Inside, True);
			If Origin <> Undefined Then
				Target = Origin.LogicalName;
			EndIf;
		EndIf;
	EndIf;
	If IsBlankString(Target) Then
		Return Result;
	EndIf;

	Result.Insert("_TYPE", BinaryLiteral(HexLiteral(8, 2), Context));
	Result.Insert("_RTRef", ReferenceTypeIdLiteral(Target, Context));
	Result.Insert("_RRRef", Expression);
	Return Result;

EndFunction

// НЕОПРЕДЕЛЕНО внутри списка В переписывается в проверку NULL и список без него:
//
//   <выражение> В (НЕОПРЕДЕЛЕНО, A, B)  ->  (<выражение> IS NULL OR <выражение> IN (A, B))
//   <выражение> В (НЕОПРЕДЕЛЕНО)        ->  (<выражение> IS NULL)
//
// Зачем: в T-SQL «x IN (NULL, …)» не истинно никогда - сравнение с NULL даёт UNKNOWN, и
// строка с пустым значением выпадает молча. Замерено на одном и том же типовом запросе
// двух баз (CommonModules/SalesServer на ERP, ПродажиСервер на УХ): 1С отдаёт 1 строку,
// обработка ни одной, а тот же SQL с «(x IS NULL OR x IN (…))» - ту же одну. Сравнение с
// НЕОПРЕДЕЛЕНО вне списка обработка переводит как IS NULL давно; до списка правило не
// доходило.
//
// Почему переписью на языке запросов, а не в выводе SQL: левый операнд В в выводе
// разложен на части (ЕСТЬNULL, скобка, аргументы), и собрать его обратно из частей
// нельзя - взять «последнюю часть» значит выдать сломанный SQL. На языке запросов
// границу операнда видно по токенам.
//
// Ключевые слова пишутся по-английски: карта ключевых слов принимает оба варианта, и
// текст этот никуда, кроме собственного переводчика, не уходит.
//
// Перепись идемпотентна: после неё НЕОПРЕДЕЛЕНО в списках не остаётся.
Function ExpandUndefinedInLists(Text, Context = Undefined)

	Upper_ = Upper(Text);
	If StrFind(Upper_, "UNDEFINED") = 0 And StrFind(Upper_, Upper("Неопределено")) = 0 Then
		Return Text;
	EndIf;

	Result = Text;
	For Pass = 1 To 8 Do
		Next = ExpandedUndefinedList(Result, Context);
		If Next = Undefined Then
			Return Result;
		EndIf;
		Result = Next;
	EndDo;
	Return Result;

EndFunction

// Имя - поле составного типа у таблицы, условие которой переводится без псевдонима (условие виртуальной
// таблицы: BareFields). Поле одного типа - как прежде: QualifyBareCompositeFields его не трогает.
Function IsBareVirtualField(Name, Context)

	If Context = Undefined Or Not Context.Property("BareAlias") Or IsBlankString(Context.BareAlias)
		Or Context.BareDescriptor = Undefined Then
		Return False;
	EndIf;
	Return Context.BareFields.Get(Upper(TrimAll(Name))) <> Undefined
		And CompositeInfo(Context.BareDescriptor, TrimAll(Name)) <> Undefined;

EndFunction

// Один разворот. Undefined - разворачивать больше нечего.
Function ExpandedUndefinedList(Text, Context = Undefined)

	Tokens = Tokenize(Text);
	For Index = 0 To Tokens.Count() - 2 Do
		If Tokens[Index].Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Index].Value);
		If Word <> "IN" And Word <> Upper("В") Then
			Continue;
		EndIf;
		If Tokens[Index + 1].Value <> "(" Then
			Continue;
		EndIf;

		Finish = MatchingParen(Tokens, Index + 1);
		Items = TopLevelListItems(Tokens, Index + 1, Finish);
		If Items = Undefined Then
			Continue;
		EndIf;

		Kept = New Array;
		Found = False;
		For Each Item In Items Do
			Trimmed = Upper(TrimAll(Item));
			If Trimmed = "UNDEFINED" Or Trimmed = Upper("Неопределено") Then
				Found = True;
			Else
				Kept.Add(Item);
			EndIf;
		EndDo;
		If Not Found Then
			Continue;
		EndIf;

		// Инфиксное «X НЕ В (…)»: операнд стоит перед НЕ, и всё сравнение берётся под НЕ.
		Last = Index - 1;
		Negated = Last > 0 And Tokens[Last].Kind = "Name"
			And (Upper(Tokens[Last].Value) = "NOT" Or Upper(Tokens[Last].Value) = Upper("Не"));
		If Negated Then
			Last = Last - 1;
		EndIf;
		Start = OperandStart(Tokens, Last + 1);
		If Start = Undefined Then
			Continue;
		EndIf;
		Operand = TokensText(Tokens, Start, Last);
		If IsBlankString(Operand) Then
			Continue;
		EndIf;

		// НЕОПРЕДЕЛЕНО - значение с тегом 0x01, а не NULL (замеры 9226-9228, 9264, 9265):
		// «X В (НЕОПРЕДЕЛЕНО, …)» - это «X = НЕОПРЕДЕЛЕНО ИЛИ X В (…)», а сравнение с
		// НЕОПРЕДЕЛЕНО разбирают UndefinedComparisonSpan и UndefinedExpressionComparisonSpan
		// по набору типов. Через IS NULL терялись хранимые НЕОПРЕДЕЛЕНО (сверка battery25:
		// 1С 38 строк, SQL 1). Имя без точки - колонка временной таблицы: её набор типов
		// здесь неизвестен, для неё остаётся прежняя проверка на NULL.
		// Голое имя в условии виртуальной таблицы - поле регистра (BareFields), а не колонка временной таблицы:
		// его типы известны, и QualifyBareCompositeFields допишет псевдоним (замер iu01-iu07, 22.11.2026, УХ:
		// IS NULL терял хранимые НЕОПРЕДЕЛЕНО в СрезПоследних(&П, Поле В (НЕОПРЕДЕЛЕНО, ...))).
		If StrFind(Operand, ".") = 0 And Start = Last And Tokens[Start].Kind = "Name"
			And Not IsBareVirtualField(Operand, Context) Then
			Missing = "(" + Operand + " IS NULL)";
		Else
			Missing = "(" + Operand + " = UNDEFINED)";
		EndIf;
		Pieces = New Array;
		If Start > 0 Then
			Pieces.Add(TokensText(Tokens, 0, Start - 1));
		EndIf;
		If Kept.Count() = 0 Then
			Rewritten = Missing;
		Else
			Rewritten = "(" + Missing + " OR " + Operand + " IN ("
				+ StrConcat(Kept, ", ") + "))";
		EndIf;
		Pieces.Add(?(Negated, "(NOT " + Rewritten + ")", Rewritten));
		If Finish < Tokens.Count() - 1 Then
			Pieces.Add(TokensText(Tokens, Finish + 1, Tokens.Count() - 1));
		EndIf;
		Return StrConcat(Pieces, " ");
	EndDo;
	Return Undefined;

EndFunction

// Элементы списка верхнего уровня между скобками. Undefined - это не список значений:
// внутри подзапрос, и трогать его здесь нечем.
Function TopLevelListItems(Tokens, OpenIndex, CloseIndex)

	Items = New Array;
	Current = New Array;
	Depth = 0;
	For Index = OpenIndex + 1 To CloseIndex - 1 Do
		Value = Tokens[Index].Value;
		If Index = OpenIndex + 1 And Tokens[Index].Kind = "Name" Then
			Word = Upper(Value);
			If Word = "SELECT" Or Word = Upper("Выбрать") Then
				Return Undefined;
			EndIf;
		EndIf;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
		ElsIf Value = "," And Depth = 0 Then
			Items.Add(StrConcat(Current, " "));
			Current = New Array;
			Continue;
		EndIf;
		Current.Add(?(Tokens[Index].Kind = "Parameter", "&" + Value, Value));
	EndDo;
	If Current.Count() > 0 Then
		Items.Add(StrConcat(Current, " "));
	EndIf;
	Return Items;

EndFunction

// Где начинается левый операнд оператора на позиции Index. Undefined - форма операнда
// незнакомая, и переписывать нельзя.
Function OperandStart(Tokens, Index)

	Position = Index - 1;
	If Position < 0 Then
		Return Undefined;
	EndIf;

	If Tokens[Position].Value = ")" Then
		Open = MatchingOpenParen(Tokens, Position);
		If Open = Undefined Then
			Return Undefined;
		EndIf;
		// Перед скобкой имя - это вызов функции, он и есть операнд целиком.
		If Open > 0 And Tokens[Open - 1].Kind = "Name"
			And KeywordMap().Get(Upper(Tokens[Open - 1].Value)) = Undefined Then
			Return Open - 1;
		EndIf;
		Return Open;
	EndIf;

	Kind = Tokens[Position].Kind;
	If Kind = "Name" Or Kind = "Parameter" Or Kind = "Number" Or Kind = "String" Then
		// Ключевое слово операндом не бывает: НЕ В (…) переписывать по этому имени нельзя.
		If Kind = "Name" And KeywordMap().Get(Upper(Tokens[Position].Value)) <> Undefined Then
			Return Undefined;
		EndIf;
		Return Position;
	EndIf;
	Return Undefined;

EndFunction

// Открывающая скобка для закрывающей на позиции CloseIndex.
Function MatchingOpenParen(Tokens, CloseIndex)

	Depth = 0;
	Position = CloseIndex;
	While Position >= 0 Do
		Value = Tokens[Position].Value;
		If Value = ")" Then
			Depth = Depth + 1;
		ElsIf Value = "(" Then
			Depth = Depth - 1;
			If Depth = 0 Then
				Return Position;
			EndIf;
		EndIf;
		Position = Position - 1;
	EndDo;
	Return Undefined;

EndFunction

// Форма «ВЫБОР X КОГДА значение ТОГДА …» переписывается в «ВЫБОР КОГДА X = значение …».
// Замерено (эталон 9961): платформа ровно так и поступает - разворачивает сравнение
// селектора в проверку всех частей значения. Сравнение «составное = ЗНАЧЕНИЕ(…)»
// обработка уже переводит верно (замер 9911), поэтому переписанная форма переводится
// правильно сама, без отдельной ветки в переводчике.
//
// Без этого селектор составного поля сводился к одной колонке ссылки, и две пустые
// ссылки разных типов превращались в один и тот же ноль: вторая ветвь становилась
// недостижимой, а SQL - неверным без всякого предупреждения.
//
// Перепись идемпотентна: после неё формы с селектором не остаётся, и повторный проход
// ничего не меняет.
Function ExpandSelectorCases(Text)

	// Отсечка: переводчик выражений зовут очень часто, и лишняя токенизация на каждый
	// вызов дорога. Без слова ВЫБОР в тексте разворачивать нечего.
	Upper_ = Upper(Text);
	If StrFind(Upper_, "CASE") = 0 And StrFind(Upper_, Upper("Выбор")) = 0 Then
		Return Text;
	EndIf;

	Result = Text;
	For Pass = 1 To 8 Do
		Next = ExpandedSelectorCase(Result);
		If Next = Undefined Then
			Return Result;
		EndIf;
		Result = Next;
	EndDo;
	Return Result;

EndFunction

// Один разворот: находит первую форму с селектором и переписывает её. Undefined -
// таких форм больше нет.
Function ExpandedSelectorCase(Text)

	Tokens = Tokenize(Text);
	For Index = 0 To Tokens.Count() - 2 Do
		If Tokens[Index].Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Index].Value);
		If Word <> "CASE" And Word <> Upper("Выбор") Then
			Continue;
		EndIf;
		Following = Upper(Tokens[Index + 1].Value);
		If Following = "WHEN" Or Following = Upper("Когда") Then
			Continue;
		EndIf;

		// Селектор - от CASE до первого КОГДА этого же ВЫБОРа.
		FirstWhen = SameLevelKeyword(Tokens, Index + 1, "WHEN", Upper("Когда"));
		If FirstWhen = 0 Then
			Continue;
		EndIf;
		Selector = TokensText(Tokens, Index + 1, FirstWhen - 1);

		Pieces = New Array;
		If Index > 0 Then
			Pieces.Add(TokensText(Tokens, 0, Index - 1));
		EndIf;
		Pieces.Add(Tokens[Index].Value);

		Position = FirstWhen;
		While Position > 0 Do
			Then_ = SameLevelKeyword(Tokens, Position + 1, "THEN", Upper("Тогда"));
			If Then_ = 0 Then
				Return Undefined;
			EndIf;
			// Без скобок: трёхчастное сравнение составного поля со значением распознаётся
			// по образцу «путь = ЗНАЧЕНИЕ(…)», и лишние скобки его прячут - проверено,
			// со скобками сравнение сворачивалось к одной колонке ссылки.
			Pieces.Add(Tokens[Position].Value + " " + Selector + " = "
				+ TokensText(Tokens, Position + 1, Then_ - 1));
			NextWhen = SameLevelKeyword(Tokens, Then_ + 1, "WHEN", Upper("Когда"));
			If NextWhen = 0 Then
				Pieces.Add(TokensText(Tokens, Then_, Tokens.Count() - 1));
				Position = 0;
			Else
				Pieces.Add(TokensText(Tokens, Then_, NextWhen - 1));
				Position = NextWhen;
			EndIf;
		EndDo;
		Return StrConcat(Pieces, " ");
	EndDo;
	Return Undefined;

EndFunction

// Ключевое слово на том же уровне вложенности, что и начало поиска: вложенные ВЫБОРы
// и скобки пропускаются целиком. 0 - не найдено.
Function SameLevelKeyword(Tokens, From, English, Russian)

	Depth = 0;
	Nested = 0;
	For Index = From To Tokens.Count() - 1 Do
		Value = Tokens[Index].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			If Depth = 0 Then
				Return 0;
			EndIf;
			Depth = Depth - 1;
		ElsIf Depth = 0 And Tokens[Index].Kind = "Name" Then
			Word = Upper(Value);
			If Word = "CASE" Or Word = Upper("Выбор") Then
				Nested = Nested + 1;
			ElsIf Word = "END" Or Word = Upper("Конец") Then
				If Nested = 0 Then
					Return 0;
				EndIf;
				Nested = Nested - 1;
			ElsIf Nested = 0 And (Word = English Or Word = Russian) Then
				Return Index;
			EndIf;
		EndIf;
	EndDo;
	Return 0;

EndFunction

// Части значения одной ветви выражения: соответствие «роль - текст», либо Undefined,
// если ветвь не ссылочная или не разбирается.
//
// Замерено (эталоны 9960-9965): НЕОПРЕДЕЛЕНО платформа кладёт константами - тег 0x01,
// идентификатор таблицы 0x00000000, ссылка нулевая; у односоставной ссылки тег 0x08,
// идентификатор её таблицы, ссылка - сама колонка.
Function ArmCompositeParts(Text, Context, RolesOnly = False)

	Trimmed = TrimAll(Text);
	Upper_ = Upper(Trimmed);
	If Upper_ = "NULL" Then
		Return NullArmParts();
	EndIf;
	If Upper_ = "UNDEFINED" Or Upper_ = Upper("Неопределено") Then
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral("01", Context));
		Parts.Insert("_RTRef", BinaryLiteral("00000000", Context));
		Parts.Insert("_RRRef", BinaryLiteral("00000000000000000000000000000000", Context));
		Return Parts;
	EndIf;

	Parts = ParameterArmParts(Trimmed, Context);
	If Parts <> Undefined Then
		Return Parts;
	EndIf;

	Composite = CompositePartsOfExpression(Trimmed, Context);
	If Composite.Parts.Count() > 0 Then
		Parts = New Map;
		For Each Column In Composite.Parts Do
			Parts.Insert(PartAlias("", Column),
				FieldColumn(Composite.Descriptor, Composite.Alias, Column, Context));
		EndDo;
		Return Parts;
	EndIf;

	Target = SingleReferenceTarget(Trimmed, Context);
	If Not IsBlankString(Target) Then
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral(HexLiteral(8, 2), Context));
		Parts.Insert("_RTRef", ReferenceTypeIdLiteral(Target, Context));
		Parts.Insert("_RRRef", TranslateExpression(Trimmed, Context));
		Return Parts;
	EndIf;

	// ЗНАЧЕНИЕ(Справочник.X.ПустаяСсылка) - ссылка известного единственного типа, то есть
	// все три части константны. SingleReferenceTarget такую ветвь не узнаёт: он видит
	// скобку и сразу отступает, потому что писался для пути к полю.
	Inside = PredefinedValueArgument(Trimmed);
	If Not IsBlankString(Inside) Then
		Origin = TypeOrigin(Inside, True);
		If Origin <> Undefined Then
			Parts = New Map;
			Parts.Insert("_TYPE", BinaryLiteral(HexLiteral(8, 2), Context));
			Parts.Insert("_RTRef", ReferenceTypeIdLiteral(Origin.LogicalName, Context));
			Parts.Insert("_RRRef", PredefinedValueLiteral(Inside, Context));
			Return Parts;
		EndIf;
	EndIf;

	// Переход через точку к полю, которое само составное: части лежат в том же
	// соединении. Замерено (9985, 9986): платформа строит CASE по тегу типа источника и
	// подставляет в ветви части этой роли - то же правило «один скелет на роль».
	Parts = NavigatedCompositeParts(Trimmed, Context);
	If Parts <> Undefined Then
		Return Parts;
	EndIf;

	// Переход через точку по составной ссылке: значение - ссылка на целевую таблицу, но
	// для строк другого типа его нет. Замерено (9981): платформа закрывает идентификатор
	// таблицы проверкой «переход дал значение», как и у приведения.
	Navigated = NavigatedReferenceTarget(Trimmed, Context);
	If Not IsBlankString(Navigated) Then
		PathSql = TranslateExpression(Trimmed, Context);
		Guard = "(CASE WHEN " + PathSql + " IS NOT NULL THEN ";
		Parts = New Map;
		Parts.Insert("_TYPE", Guard + BinaryLiteral(HexLiteral(8, 2), Context) + " END)");
		Parts.Insert("_RTRef", Guard + ReferenceTypeIdLiteral(Navigated, Context) + " END)");
		Parts.Insert("_RRRef", PathSql);
		Return Parts;
	EndIf;

	// ВЫРАЗИТЬ(… КАК Т) сужает значение до одного типа, то есть тег и идентификатор
	// таблицы становятся константами. Замерено: отдельной колонкой платформа выводит
	// приведение одной колонкой (9974), а в ветви - идентификатором таблицы приведения
	// и самой ссылкой (9975), без тега: он статически 0x08.
	Parsed = SplitCastPath(Trimmed);
	If Parsed <> Undefined And Parsed.Tail.Count() = 0 Then
		Split = Undefined;
		Try
			Split = SplitCast(Parsed.Cast);
		Except
			Split = Undefined;
		EndTry;
		If Split <> Undefined Then
			Origin = TypeOrigin(Split.TypeText, False);
			If Origin <> Undefined Then
				// Приведение бывает неудачным, и тогда значения нет вовсе. Замерено (9975):
				// платформа закрывает и тег, и идентификатор таблицы проверкой «приведение
				// дало результат», иначе вышла бы пустая ссылка этого типа вместо отсутствия
				// значения.
				CastSql = TranslateExpression(Trimmed, Context);
				Guard = "(CASE WHEN " + CastSql + " IS NOT NULL THEN ";
				Parts = New Map;
				Parts.Insert("_TYPE", Guard + BinaryLiteral(HexLiteral(8, 2), Context) + " END)");
				Parts.Insert("_RTRef", Guard + ReferenceTypeIdLiteral(Origin.LogicalName, Context) + " END)");
				Parts.Insert("_RRRef", CastSql);
				Return Parts;
			EndIf;
		EndIf;
	EndIf;
	If Parsed <> Undefined And Parsed.Tail.Count() > 0 Then
		Parts = Undefined;
		Try
			Parts = CastTailArmParts(Trimmed, Parsed, Context);
		Except
			Parts = Undefined;
		EndTry;
		If Parts <> Undefined Then
			Return Parts;
		EndIf;
	EndIf;

	// Ветвь сама собрана по ветвям: ВЫБОР или ЕСТЬNULL внутри ветви. Разбирается тем же
	// механизмом - текст ветви строго короче всего выражения, поэтому рекурсия конечна.
	Nested = Undefined;
	Try
		Nested = BranchedCompositeParts(Trimmed, Context, RolesOnly);
	Except
		Nested = Undefined;
	EndTry;
	If Nested <> Undefined Then
		Return Nested;
	EndIf;

	// Примитивная ветвь рядом со ссылочной. Замерено (9900-9904): платформа выводит
	// примитивную часть своей колонкой - ветвь со строкой даёт тег 0x05 и значение в роли
	// _S, ссылочные роли нулями; с числом - 0x03 и _N, с датой - 0x04 и _T. То же правило
	// «один скелет на роль», просто роль не ссылочная.
	//
	// Пробуется последней, и это важно: вид выражения классификатор берёт по первой
	// распознанной ветви, поэтому вложенный ВЫБОР со строкой впереди он объявил бы строкой
	// целиком - ссылка из другой ветви исчезла бы молча. Сначала разбор по ветвям.
	Parts = AggregateReferenceArmParts(Trimmed, Context);
	If Parts <> Undefined Then
		Return Parts;
	EndIf;
	// Ветвь - МИНИМУМ или МАКСИМУМ составного поля. Замеры qb1, qb1d (21.11.2026, УХ: `ВЫБОР КОГДА
	// МИНИМУМ(П) = МАКСИМУМ(П) ТОГДА МИНИМУМ(П) ИНАЧЕ НЕОПРЕДЕЛЕНО КОНЕЦ`): части ветви - те же
	// формулы, что у колонки-агрегата (AggregatedCompositeParts): тег MIN(_TYPE), таблица и ссылка
	// из MIN(_RTRef + _RRRef) под проверкой тега.
	Aggregated = Undefined;
	Try
		Aggregated = AggregatedCompositeParts(Trimmed, Context);
	Except
		Aggregated = Undefined;
	EndTry;
	If Aggregated <> Undefined Then
		Return Aggregated;
	EndIf;
	Parts = PrimitiveArmParts(Trimmed, Context);
	If Parts = Undefined Then
		// Реквизит одного примитивного вида за составной колонкой производной таблицы
		// (`Товары.Упаковка.Наименование` рядом с НЕОПРЕДЕЛЕНО): тег - по факту чтения, как в d1.
		Try
			Parts = NavigatedCompositeParts(Trimmed, Context, True);
		Except
			Parts = Undefined;
		EndTry;
	EndIf;
	Return Parts;

EndFunction

// Ветвь - МИНИМУМ или МАКСИМУМ над ссылкой одного типа (в том числе ЕСТЬNULL и ВЫБОР,
// все значащие ветви которых - ссылки этой же таблицы). Тег и идентификатор таблицы у
// такого значения константны, ссылочная часть - сам агрегат, а «значения нет» (агрегат
// по пустой группе) закрывается проверкой, как у перехода через точку (9981). Образец УХ:
// `ВЫБОР КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ С.X) > 1 ТОГДА "<…>" ИНАЧЕ МИНИМУМ(ЕСТЬNULL(С.X,
// ЗНАЧЕНИЕ(…))) КОНЕЦ` - без этой ветви вид колонки брался по первой ветви, строкой, и
// байты ссылки уходили в _S. Undefined - ветвь не такая.
Function AggregateReferenceArmParts(Text, Context)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Text));
	Except
		Return Undefined;
	EndTry;
	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "(" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "MIN" And Word <> "MAX" And Word <> Upper("Минимум") And Word <> Upper("Максимум") Then
		Return Undefined;
	EndIf;
	If MatchingParen(Tokens, 1) <> Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	First = 2;
	If Upper(Tokens[First].Value) = "DISTINCT" Or Upper(Tokens[First].Value) = Upper("Различные") Then
		First = First + 1;
	EndIf;
	If First > Tokens.Count() - 2 Then
		Return Undefined;
	EndIf;
	TypeId = ArmReferenceTypeId(TokensText(Tokens, First, Tokens.Count() - 2), Context);
	If IsBlankString(TypeId) Then
		Return Undefined;
	EndIf;

	Copy = TrimAll(Text);
	AggregateSql = TranslateExpression(Copy, Context);
	Guard = "(CASE WHEN " + AggregateSql + " IS NOT NULL THEN ";
	Parts = New Map;
	Parts.Insert("_TYPE", Guard + BinaryLiteral(HexLiteral(8, 2), Context) + " END)");
	Parts.Insert("_RTRef", Guard + TypeId + " END)");
	Parts.Insert("_RRRef", AggregateSql);
	Return Parts;

EndFunction

// Ветвь ВЫРАЗИТЬ(X КАК Т).Поле - приведение с хвостом из одного поля. Составное поле
// отдаёт свои части из таблицы приведения, под той же проверкой «приведение удалось»,
// что и само соединение (CastTargetHop); поле одного типа - тег и часть своего вида,
// закрытые проверкой «значение есть», как у перехода через точку (9981). Образец УХ:
// `ВЫБОР КОГДА В ССЫЛКА Справочник.Т ТОГДА ВЫРАЗИТЬ(В КАК Справочник.Т).Поле ИНАЧЕ
// НЕОПРЕДЕЛЕНО КОНЕЦ` - без частей ВЫБОР уходил одной колонкой, и НЕОПРЕДЕЛЕНО
// становилось NULL. Хвост из нескольких полей (`ВЫРАЗИТЬ(С.Этап КАК Документ.Э).Партия.Изделие`,
// УХ СформироватьЗаданияПакетноеФормированиеЭтапов) проходится по ссылкам одного типа до
// последнего поля; значение одно - путь целиком, - и закрыто той же проверкой «значение
// есть», что и переход через точку. Составное поле внутри длинного хвоста не разбирается.
// Undefined - тип поля не выводится.
Function CastTailArmParts(Text, Parsed, Context)

	If Parsed.Tail.Count() = 0 Then
		Return Undefined;
	EndIf;
	Split = SplitCast(Parsed.Cast);
	If TypeOrigin(Split.TypeText, False) = Undefined Then
		Return Undefined;
	EndIf;
	Hop = CastTargetHop(Split.Expression, Split.TypeText, Context);
	Descriptor = Hop.Descriptor;
	Last = Parsed.Tail.Count() - 1;
	For Step = 0 To Last - 1 Do
		Through = TrimAll(Parsed.Tail[Step]);
		If CompositeInfo(Descriptor, Through) <> Undefined Then
			Return Undefined;
		EndIf;
		Target = ReferenceTargetOf(New Structure("Alias, Descriptor, FieldName, CompositeSegment, CompositeTail",
			Hop.Alias, Descriptor, Through, "", New Array));
		If Target = Undefined Then
			Return Undefined;
		EndIf;
		Descriptor = TableDescriptor(Target.FullName());
	EndDo;
	FieldName = TrimAll(Parsed.Tail[Last]);
	If Last > 0 And CompositeInfo(Descriptor, FieldName) <> Undefined Then
		Return Undefined;
	EndIf;

	If CompositeInfo(Hop.Descriptor, FieldName) <> Undefined Then
		ColumnList = Hop.Descriptor.Columns.Get(Upper(FieldName));
		If ColumnList = Undefined Then
			Return Undefined;
		EndIf;
		Parts = New Map;
		For Each Column In ColumnList Do
			Piece = FieldColumn(Hop.Descriptor, Hop.Alias, Column, Context);
			If Not IsBlankString(Hop.Extra) Then
				Piece = "(CASE WHEN " + Hop.Extra + " THEN " + Piece + " END)";
			EndIf;
			Parts.Insert(PartAlias("", Column), Piece);
		EndDo;
		Return Parts;
	EndIf;

	Resolved = New Structure("Alias, Descriptor, FieldName, CompositeSegment, CompositeTail",
		Hop.Alias, Descriptor, FieldName, "", New Array);
	Copy = TrimAll(Text);
	ValueSql = TranslateExpression(Copy, Context);
	Guard = "(CASE WHEN " + ValueSql + " IS NOT NULL THEN ";

	If Last = 0 And IsPresentationField(FieldName) Then
		// `ВЫРАЗИТЬ(X КАК Справочник.Т).Представление`. Замер qc1 (21.11.2026, УХ): платформа выводит
		// части ссылки под проверкой «строка справочника есть», наименование и номер ветви, а строку
		// представления собирает после чтения. Перевод отдаёт ту же строку (как
		// ReferencePresentationArmParts): тег 0x05 под проверкой «значение есть», часть _S.
		CastOrigin = TypeOrigin(Split.TypeText, False);
		CastTarget = ?(CastOrigin = Undefined, Undefined, MetadataOf(CastOrigin.LogicalName));
		If CastTarget = Undefined Or Not IsCatalogLike(CastTarget.FullName()) Or Not MentionsColumn(ValueSql) Then
			Return Undefined;
		EndIf;
		Parts = New Map;
		Parts.Insert("_TYPE", Guard + BinaryLiteral("05", Context) + " END)");
		Parts.Insert("_S", ValueSql);
		Return Parts;
	EndIf;

	Target = ReferenceTargetOf(Resolved);
	If Target <> Undefined Then
		Parts = New Map;
		Parts.Insert("_TYPE", Guard + BinaryLiteral(HexLiteral(8, 2), Context) + " END)");
		Parts.Insert("_RTRef", Guard + ReferenceTypeIdLiteral(Target.FullName(), Context) + " END)");
		Parts.Insert("_RRRef", ValueSql);
		Return Parts;
	EndIf;

	Owner = MetadataOf(Descriptor.LogicalName);
	If Owner = Undefined Then
		Return Undefined;
	EndIf;
	FieldType = FieldTypeDescription(Owner, FieldName);
	Kind = PrimitiveKindOfType(FieldType);
	If Kind = Undefined Then
		Return Undefined;
	EndIf;
	Parts = New Map;
	Parts.Insert("_TYPE", Guard + BinaryLiteral(Kind.Tag, Context) + " END)");
	Parts.Insert(Kind.Role, ValueSql);
	If Kind.Property("Binary") Then
		Parts.Insert("_BK", BinaryKindPlaceholder(Kind.Binary));
	EndIf;
	Return Parts;

EndFunction

// Ветвь - колонка временной таблицы или вложенного запроса одного примитивного вида, в которой
// NULL не бывает: тег - константа её вида, часть - сама колонка, как у хранимого поля того же
// вида. Тип через происхождение колонки разбор ветви не берёт (SqlTypeOfExpression), и такая
// ветвь рядом с составной ссылкой теряла части: дата ложилась в базовую колонку рядом с байтами
// ссылки (перепись 49z1, УХ ИнтеграцияЗЕРНОУТ: СУБД 8061). Колонка, которая может держать NULL,
// сюда не идёт - её тег платформа обязана закрыть проверкой, и эта форма не замерена.
// Undefined - ветвь не такая.
Function DerivedPrimitiveArmParts(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0
		Or Left(Trimmed, 1) = "&" Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Undefined;
	EndTry;
	If Not Resolved.Descriptor.IsDerived Or Not IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	If Not Resolved.Descriptor.Property("DeclaredTypes") Or Resolved.Descriptor.DeclaredTypes = Undefined Then
		// Поле виртуальной таблицы (описания типов у неё нет) первым аргументом ЕСТЬNULL: вид - по
		// полю регистра, из которого колонка взята. Замер qe2 (21.11.2026, УХ, `ЕСТЬNULL(П.<булево
		// СрезПоследних>, 0)`): тег `CASE WHEN поле IS NULL THEN 0x03 ELSE 0x02 END`, части - как у
		// хранимого поля (qe1). Вне ЕСТЬNULL тег такой колонки не замерен.
		If Not (Context.Options.Property("NullCheckedArm") And Context.Options.NullCheckedArm = True) Then
			Return Undefined;
		EndIf;
		Origin = OriginOfResolved(Resolved);
		Owner = ?(Origin = Undefined, Undefined, MetadataOf(Origin.LogicalName));
		If Owner = Undefined Then
			Return Undefined;
		EndIf;
		Kind = PrimitiveKindOfType(FieldTypeDescription(Owner, Origin.FieldName));
		If Kind = Undefined Or Kind.Property("Binary") Then
			Return Undefined;
		EndIf;
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral(Kind.Tag, Context));
		Parts.Insert(Kind.Role, TranslateExpression(Trimmed, Context));
		Return Parts;
	EndIf;
	FieldType = Resolved.Descriptor.DeclaredTypes.Get(Upper(TrimAll(Resolved.FieldName)));
	If FieldType = Undefined Or FieldType.ContainsType(Type("Null")) Then
		Return Undefined;
	EndIf;
	Kind = PrimitiveKindOfType(FieldType);
	If Kind = Undefined Or Kind.Property("Binary") Then
		Return Undefined;
	EndIf;
	Parts = New Map;
	Parts.Insert("_TYPE", BinaryLiteral(Kind.Tag, Context));
	Parts.Insert(Kind.Role, TranslateExpression(Trimmed, Context));
	Return Parts;

EndFunction

// Роль и тег примитивного типа, если описание типов держит ровно один примитив.
// Undefined - типов несколько, тип ссылочный или описания нет.
Function PrimitiveKindOfType(Description)

	If Description = Undefined Then
		Return Undefined;
	EndIf;
	Types = New Array;
	For Each Item In Description.Types() Do
		If Item <> Type("Null") Then
			Types.Add(Item);
		EndIf;
	EndDo;
	If Types.Count() <> 1 Then
		Return Undefined;
	EndIf;
	If Types[0] = Type("String") Then
		Return New Structure("Role, Tag", "_S", "05");
	ElsIf Types[0] = Type("Number") Then
		Return New Structure("Role, Tag", "_N", "03");
	ElsIf Types[0] = Type("Date") Then
		Return New Structure("Role, Tag", "_T", "04");
	ElsIf Types[0] = Type("Boolean") Then
		Return New Structure("Role, Tag", "_L", "02");
	ElsIf Types[0] = Type("UUID") Then
		Return New Structure("Role, Tag, Binary", "_B", "06", "1");
	ElsIf Types[0] = Type("ValueStorage") Then
		Return New Structure("Role, Tag, Binary", "_B", "06", "2");
	ElsIf Types[0] = Type("Type") Then
		Return New Structure("Role, Tag, Binary", "_B", "06", "3");
	EndIf;
	Return Undefined;

EndFunction

Function StubNeighbourArmParts(Arm, Branches, Context)

	Parts = Undefined;
	Try
		Parts = SourceColumnArmParts(Arm, Branches, Context);
	Except
		Parts = Undefined;
	EndTry;
	Return Parts;

EndFunction

// Ветвь - колонка временной таблицы, среза или вложенного запроса рядом с ветвью
// НЕОПРЕДЕЛЕНО. Вид такой колонки PrimitiveArmParts не берёт (тип через происхождение
// там не допускается), и без частей ЕСТЬNULL(x, НЕОПРЕДЕЛЕНО) уходил в COALESCE(x, NULL):
// платформа отдаёт НЕОПРЕДЕЛЕНО, перевод - NULL (полная сверка УХ 14.11.2026, 10
// записей). Здесь вид берётся по происхождению колонки - ссылка одного типа или один
// примитив; тег закрыт проверкой «значение есть», поэтому NULL ветви остаётся NULL.
// Ветвь может быть и МАКСИМУМ/МИНИМУМ над такой колонкой: ЕСТЬNULL(МАКСИМУМ(П.Дата),
// НЕОПРЕДЕЛЕНО) платформа строит над колонкой вложенного запроса и временной таблицы так же,
// как над полем базы, - тег по «значение есть» и часть вида (замер und_derived d1-d4,
// 19.11.2026, УХ: дата, число, строка). Ссылка под агрегатом не замерена - Undefined.
// Undefined - ветвь не такая, рядом нет НЕОПРЕДЕЛЕНО или вид не выводится.
Function SourceColumnArmParts(Arm, Branches, Context)

	Expression = TrimAll(Arm);
	Trimmed = MinMaxColumnArgument(Expression);
	Aggregated = Not IsBlankString(Trimmed);
	If Not Aggregated Then
		Trimmed = Expression;
	EndIf;
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0
		Or Left(Trimmed, 1) = "&" Then
		Return Undefined;
	EndIf;
	Stub = IsUndefinedLiteralText(Branches.Else_);
	For Each Item In Branches.Arms Do
		If IsUndefinedLiteralText(Item) Then
			Stub = True;
		EndIf;
	EndDo;
	If Not Stub Then
		Return Undefined;
	EndIf;

	Resolved = ResolveField(Trimmed, Context);
	If Not IsBlankString(Resolved.CompositeSegment)
		Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
		Return Undefined;
	EndIf;

	Target = ReferenceTargetOf(Resolved);
	Kind = Undefined;
	// Вычисляемая колонка временной таблицы или вложенного запроса происхождения не имеет,
	// но набор типов у неё объявлен моделью - тот же, по которому платформа строит части.
	Declared = Undefined;
	If Resolved.Descriptor.Property("DeclaredTypes") And Resolved.Descriptor.DeclaredTypes <> Undefined Then
		Declared = Resolved.Descriptor.DeclaredTypes.Get(Upper(TrimAll(Resolved.FieldName)));
	EndIf;
	If Target = Undefined And Declared <> Undefined Then
		Kind = PrimitiveKindOfType(Declared);
		If Kind = Undefined Then
			Types = New Array;
			For Each Item In Declared.Types() Do
				If Item <> Type("Null") Then
					Types.Add(Item);
				EndIf;
			EndDo;
			If Types.Count() = 1 Then
				Target = Metadata.FindByType(Types[0]);
			EndIf;
		EndIf;
	EndIf;
	If Aggregated And Target <> Undefined Then
		Return Undefined;
	EndIf;
	If Target = Undefined And Kind = Undefined Then
		SqlType = SqlTypeOfExpression(Trimmed, Context, True);
		Role = ?(IsBlankString(SqlType), "", SqlTypeKind(SqlType));
		Tags = New Map;
		Tags.Insert("_L", "02");
		Tags.Insert("_N", "03");
		Tags.Insert("_T", "04");
		Tags.Insert("_S", "05");
		If Tags.Get(Role) = Undefined Then
			Return Undefined;
		EndIf;
		Kind = New Structure("Role, Tag", Role, Tags.Get(Role));
	EndIf;

	Copy = Expression;
	ValueSql = TranslateExpression(Copy, Context);
	Guard = "(CASE WHEN " + ValueSql + " IS NOT NULL THEN ";
	Parts = New Map;
	If Target <> Undefined Then
		Parts.Insert("_TYPE", Guard + BinaryLiteral(HexLiteral(8, 2), Context) + " END)");
		Parts.Insert("_RTRef", Guard + ReferenceTypeIdLiteral(Target.FullName(), Context) + " END)");
		Parts.Insert("_RRRef", ValueSql);
	Else
		Parts.Insert("_TYPE", Guard + BinaryLiteral(Kind.Tag, Context) + " END)");
		Parts.Insert(Kind.Role, ValueSql);
		If Kind.Property("Binary") Then
			Parts.Insert("_BK", BinaryKindPlaceholder(Kind.Binary));
		EndIf;
	EndIf;
	Return Parts;

EndFunction

// Аргумент МАКСИМУМ/МИНИМУМ, если выражение целиком - такой агрегат над путём без
// вложенных скобок: «МАКСИМУМ(П.Дата)» - «П.Дата». Пустая строка - иначе.
Function MinMaxColumnArgument(Text)

	Open = StrFind(Text, "(");
	If Open = 0 Or Right(Text, 1) <> ")" Then
		Return "";
	EndIf;
	Word = Upper(TrimAll(Left(Text, Open - 1)));
	If Word <> "MAX" And Word <> "MIN" And Word <> Upper("Максимум") And Word <> Upper("Минимум") Then
		Return "";
	EndIf;
	Inner = TrimAll(Mid(Text, Open + 1, StrLen(Text) - Open - 1));
	If StrFind(Inner, "(") > 0 Or StrFind(Inner, ")") > 0 Or StrFind(Inner, " ") > 0 Then
		Return "";
	EndIf;
	Return Inner;

EndFunction

// Идентификатор таблицы (литерал), если значение выражения - ссылка одного и того же
// типа во всех значащих ветвях; ветви NULL значения не несут и не мешают. Пустая
// строка - иначе, в том числе при ветви НЕОПРЕДЕЛЕНО или примитиве.
Function ArmReferenceTypeId(Text, Context)

	Trimmed = TrimAll(Text);
	Target = SingleReferenceTarget(Trimmed, Context);
	If Not IsBlankString(Target) Then
		Return ReferenceTypeIdLiteral(Target, Context);
	EndIf;

	Inside = PredefinedValueArgument(Trimmed);
	If Not IsBlankString(Inside) Then
		Origin = TypeOrigin(Inside, True);
		Return ?(Origin = Undefined, "", ReferenceTypeIdLiteral(Origin.LogicalName, Context));
	EndIf;

	Branches = Undefined;
	Try
		Branches = ExpressionBranches(Trimmed);
	Except
		Branches = Undefined;
	EndTry;
	If Branches = Undefined Then
		Return "";
	EndIf;
	Arms = New Array;
	For Each Arm In Branches.Arms Do
		Arms.Add(Arm);
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		Arms.Add(Branches.Else_);
	EndIf;
	Found = "";
	For Each Arm In Arms Do
		If Upper(TrimAll(Arm)) = "NULL" Then
			Continue;
		EndIf;
		TypeId = ArmReferenceTypeId(Arm, Context);
		If IsBlankString(TypeId) Or (Not IsBlankString(Found) And TypeId <> Found) Then
			Return "";
		EndIf;
		Found = TypeId;
	EndDo;
	Return Found;

EndFunction

// Все значащие ветви выражения - того же вида, что и всё выражение. Вид ВЫБОРа
// классификатор берёт по первой распознанной ветви, и ветвь другого вида - ссылка,
// НЕОПРЕДЕЛЕНО - иначе ушла бы в роль чужого вида молча. Выражение без ветвей - True.
Function BranchesAgreeWithKind(Text, Kind, Context)

	Branches = Undefined;
	Try
		Branches = ExpressionBranches(Text);
	Except
		Return False;
	EndTry;
	If Branches = Undefined Then
		Return True;
	EndIf;
	Arms = New Array;
	For Each Arm In Branches.Arms Do
		Arms.Add(Arm);
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		Arms.Add(Branches.Else_);
	EndIf;
	For Each Arm In Arms Do
		If Upper(TrimAll(Arm)) = "NULL" Then
			Continue;
		EndIf;
		If IsUndefinedLiteralText(Arm) Then
			Return False;
		EndIf;
		ArmKind = PrimitiveLiteralRole(Arm);
		If IsBlankString(ArmKind) Then
			ArmType = "";
			Try
				ArmType = SqlTypeOfExpression(Arm, Context);
			Except
				Return False;
			EndTry;
			If IsBlankString(ArmType) Then
				Return False;
			EndIf;
			ArmKind = SqlTypeKind(ArmType);
		EndIf;
		If ArmKind <> Kind Or Not BranchesAgreeWithKind(Arm, Kind, Context) Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Части примитивной ветви: тег её вида и значение в роли этого вида. Undefined - вид
// по тексту не определяется (тогда прежний отказ остаётся в силе) или ветвь ссылочная.
// Вид берётся тем же классификатором, которым обработка выбирает тип колонки.
// Значение двоичного вида рядом с другим видом: уникальный идентификатор, хранилище значения, тип
// (ТИПЗНАЧЕНИЯ). Платформа выводит его тегом 0x06 и двоичной частью varbinary, у значения другого
// вида на её месте пустая последовательность (замеры 19.11.2026, УХ: und_uh u02 - ТИПЗНАЧЕНИЯ рядом
// с НЕОПРЕДЕЛЕНО, stor_uh g3 - ЕСТЬNULL(Идентификатор, НЕОПРЕДЕЛЕНО) по внешнему соединению).
Function BinaryKindArm(Text, Context)

	Return Not IsBlankString(BinaryKindOfArm(Text, Context));

EndFunction

// Ранг двоичного вида ветви: "1" - уникальный идентификатор, "2" - хранилище значения,
// "3" - тип; пустая строка - ветвь не двоичная. Порядок замерен (mk_probe2, УХ 19.11.2026):
// в колонке-номере платформа нумерует с нуля виды, которые в колонке есть, именно в этом
// порядке - идентификатор 0 рядом с хранилищем 1 (m4), хранилище 0 рядом с типом 1 (m1).
Function BinaryKindOfArm(Text, Context)

	Trimmed = TrimAll(Text);
	Tokens = Undefined;
	Try
		Tokens = Tokenize(Trimmed);
	Except
		Return "";
	EndTry;
	If Tokens.Count() > 2 And Tokens[0].Kind = "Name" And Tokens[1].Value = "("
		And MatchingParen(Tokens, 1) = Tokens.Count() - 1 Then
		Word = Upper(Tokens[0].Value);
		Return ?(Word = "VALUETYPE" Or Word = Upper("ТипЗначения"), "3", "");
	EndIf;
	If Tokens.Count() <> 1 Or Tokens[0].Kind <> "Name" Or StrFind(Trimmed, ".") = 0 Then
		Return "";
	EndIf;
	If IsValueStorageExpression(Trimmed, Context) Then
		Return "2";
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return "";
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;
	If IsUuidField(Resolved) Then
		Return "1";
	EndIf;
	// Поле одного двоичного вида - тип (Тип журнала документов: `0x08 + _DocumentTRef`, замер q4c), идентификатор.
	Kind = Undefined;
	Try
		Kind = PrimitiveKindOfType(ResolvedTypeDescription(Resolved));
	Except
		Kind = Undefined;
	EndTry;
	If Kind <> Undefined And Kind.Property("Binary") And Kind.Binary <> "2" Then
		Return Kind.Binary;
	EndIf;
	Return "";

EndFunction

// Заготовка номера двоичного вида. Это уже верный SQL со значением 0 - номер единственного
// двоичного вида колонки: ветвь объединения и одиночная ветвь разбором по ветвям не проходят,
// и заготовка выходит в SQL как есть (ворота 71: «#BK:» ронял 12 запросов). Ранг вида кодирует
// число нулей - 00, 000, 0000, что с готовыми номерами (0, 1, 2, -1) не совпадает; по нему
// ResolveBinaryKindMarkers перенумеровывает виды, когда их в колонке несколько.
Function BinaryKindPlaceholder(Rank)

	Return "CAST(" + Left("0000", Number(Rank) + 1) + " AS NUMERIC(10, 0))";

EndFunction

// Ранг вида по заготовке BinaryKindPlaceholder; пустая строка - это не заготовка.
Function BinaryKindPlaceholderRank(Text)

	For Rank = 1 To 3 Do
		If Text = BinaryKindPlaceholder(Format(Rank, "NG=0")) Then
			Return Format(Rank, "NG=0");
		EndIf;
	EndDo;
	Return "";

EndFunction

Function BinaryKindMarker(Number)

	Return "CAST(" + Format(Number, "NG=0; NZ=0") + " AS NUMERIC(10, 0))";

EndFunction

// Заготовки номера двоичного вида во всех ветвях заменяются номером вида среди видов,
// которые в колонке есть: платформа нумерует их с нуля (mk_probe2 m1, m3, m4).
Procedure ResolveBinaryKindMarkers(AllParts)

	Ranks = New Array;
	For Each Parts In AllParts Do
		Text = ?(Parts = Undefined, Undefined, Parts.Get("_BK"));
		Rank = ?(Text = Undefined, "", BinaryKindPlaceholderRank(Text));
		If Not IsBlankString(Rank) And Ranks.Find(Rank) = Undefined Then
			Ranks.Add(Rank);
		EndIf;
	EndDo;
	If Ranks.Count() = 0 Then
		Return;
	EndIf;
	Sorted = New ValueList;
	Sorted.LoadValues(Ranks);
	Sorted.SortByValue();
	For Each Parts In AllParts Do
		Text = ?(Parts = Undefined, Undefined, Parts.Get("_BK"));
		Rank = ?(Text = Undefined, "", BinaryKindPlaceholderRank(Text));
		If Not IsBlankString(Rank) Then
			Parts.Insert("_BK", BinaryKindMarker(Sorted.IndexOf(Sorted.FindByValue(Rank))));
		EndIf;
	EndDo;

EndProcedure

// Склейка строк верхнего уровня: `+`, среди операндов которого строковый литерал. В языке
// запросов `+` со строкой - только склейка, поэтому значение - строка.
Function IsStringConcatenation(Tokens)

	If Tokens = Undefined Or Tokens.Count() < 3 Then
		Return False;
	EndIf;
	Depth = 0;
	Plus = False;
	Literal = False;
	For Each Token In Tokens Do
		If Token.Value = "(" Then
			Depth = Depth + 1;
		ElsIf Token.Value = ")" Then
			Depth = Depth - 1;
		ElsIf Depth = 0 Then
			If Token.Kind = "Symbol" And Token.Value = "+" Then
				Plus = True;
			ElsIf Token.Kind = "Symbol" Then
				Return False;
			ElsIf Token.Kind = "String" Then
				Literal = True;
			ElsIf Token.Kind = "Name" And KeywordMap().Get(Upper(Token.Value)) <> Undefined Then
				Return False;
			EndIf;
		EndIf;
	EndDo;
	Return Plus And Literal;

EndFunction

// Путь `Поле.Реквизит`, где Поле - составная ссылка, а Реквизит у всех её типов, где он есть,
// одного примитивного вида: тег закрыт проверкой «значение есть» (у типов без реквизита и у
// пустой ссылки значения нет), часть - сам переход. Undefined - путь не такой.
Function NavigatedPrimitiveArmParts(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0
		Or Left(Trimmed, 1) = "&" Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Undefined;
	EndTry;
	If IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	// Тип составной ссылки - и у колонки временной таблицы; путь после неё - любой длины, через промежуточные составные
	// ссылки тоже (замер p6a, p6b: вложенный ВЫБОР по типам каждого звена, 23.11.2026, УХ 26975).
	FieldType = CompositeFieldType(Resolved.Descriptor, Resolved.CompositeSegment);
	If FieldType = Undefined Then
		Return Undefined;
	EndIf;
	Tail = New Array;
	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined Then
		For Each Item In Resolved.CompositeTail Do
			Tail.Add(Item);
		EndDo;
	EndIf;
	Tail.Add(Resolved.FieldName);
	Kind = "";
	For Each ItemType In FieldType.Types() Do
		Target = Metadata.FindByType(ItemType);
		If Target = Undefined Then
			Continue;
		EndIf;
		For Each Branch In BranchFieldTypes(Target.FullName(), Tail) Do
			ItemKind = KindOfTypeDescription(Branch);
			If Not IsBlankString(Kind) And ItemKind <> Kind Then
				Return Undefined;
			EndIf;
			Kind = ItemKind;
		EndDo;
	EndDo;
	Tags = New Map;
	Tags.Insert("String", "05,_S");
	Tags.Insert("Number", "03,_N");
	Tags.Insert("Date", "04,_T");
	Tags.Insert("Boolean", "02,_L");
	Found = Tags.Get(Kind);
	If Found = Undefined Then
		Return Undefined;
	EndIf;
	Pair = StrSplit(Found, ",");
	Copy = Trimmed;
	ValueSql = TranslateExpression(Copy, Context);
	Parts = New Map;
	Parts.Insert("_TYPE", "(CASE WHEN " + ValueSql + " IS NOT NULL THEN " + BinaryLiteral(Pair[0], Context) + " END)");
	Parts.Insert(Pair[1], ValueSql);
	Return Parts;

EndFunction

// Ветвь `Поле.Представление`, где Поле - ссылка одного типа на справочник. Замер mk_undpres_1
// (20.11.2026, УХ): у `ВЫБОР … ТОГДА Т.Валюта.Представление … ИНАЧЕ НЕОПРЕДЕЛЕНО` платформа выводит части
// ссылки (тег `CASE WHEN T2._IDRRef IS NOT NULL THEN 0x08 END`, номер таблицы, ссылку), наименование из
// присоединённой таблицы и номер ветви, а значение - строку наименования - собирает после чтения; строки
// справочника нет - значения нет (NULL). Перевод отдаёт ту же строку, как и представление колонкой
// (PresentationExpression): часть _S - представление через точку, тег 0x05 закрыт проверкой «значение
// есть». Форма колонок у платформы другая, значение то же. Undefined - ветвь не такая.
Function ReferencePresentationArmParts(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or Left(Trimmed, 1) = "&" Then
		Return Undefined;
	EndIf;
	Segments = StrSplit(Trimmed, ".", False);
	If Segments.Count() < 3 Or Not IsPresentationField(Segments[Segments.UBound()]) Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined
		Or Resolved.Descriptor.Fields.Get(Upper(TrimAll(Resolved.FieldName))) <> Undefined Then
		Return Undefined;
	EndIf;
	Segments.Delete(Segments.UBound());
	TargetName = SingleReferenceTarget(StrConcat(Segments, "."), Context);
	If IsBlankString(TargetName) Then
		Return Undefined;
	EndIf;
	Target = MetadataOf(TargetName);
	If Target = Undefined Or Not IsCatalogLike(Target.FullName()) Then
		Return Undefined;
	EndIf;
	Copy = Trimmed;
	ValueSql = TranslateExpression(Copy, Context);
	If Not MentionsColumn(ValueSql) Then
		Return Undefined;
	EndIf;
	Parts = New Map;
	Parts.Insert("_TYPE", "(CASE WHEN " + ValueSql + " IS NOT NULL THEN " + BinaryLiteral("05", Context) + " END)");
	Parts.Insert("_S", ValueSql);
	Return Parts;

EndFunction

// Ветвь - функция ПРЕДСТАВЛЕНИЕ(...) / ПРЕДСТАВЛЕНИЕССЫЛКИ(...) целиком: строковая часть с текстом представления, как у
// колонки (замер q4d-q4f, 23.11.2026, УХ: рядом с типом значение строки - текст, у типа - тип). Только где колонку не
// различают по частям - платформа различает представление по ссылке (op6, op7): не РАЗЛИЧНЫЕ, без группировки, все
// объединения - ВСЕ, без ПОМЕСТИТЬ. Undefined - ветвь не такая или различение возможно.
Function PresentationFunctionArmParts(Tokens, Text, Context)

	If Tokens = Undefined Or Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or MatchingParen(Tokens, 1) <> Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "PRESENTATION" And Word <> Upper("Представление") And Word <> "REFPRESENTATION"
		And Word <> Upper("ПредставлениеСсылки") Then
		Return Undefined;
	EndIf;
	If Not Context.Property("Operator") Or Context.Operator = Undefined Or Context.Operator.SelectDistinct
		Or Context.Operator.Group.Count() > 0 Then
		Return Undefined;
	EndIf;
	If Context.Property("Query") And Context.Query <> Undefined Then
		If Not IsBlankString(Context.Query.PlacementTable) Then
			Return Undefined;
		EndIf;
		For Index = 1 To Context.Query.Operators.Count() - 1 Do
			If Context.Query.Operators[Index].UnionType <> QuerySchemaUnionType.UnionAll Then
				Return Undefined;
			EndIf;
		EndDo;
	EndIf;
	Value = "";
	Try
		Value = TranslateExpression(Text, Context);
	Except
		Return Undefined;
	EndTry;
	Parts = New Map;
	Parts.Insert("_TYPE", BinaryLiteral("05", Context));
	Parts.Insert("_S", Value);
	Return Parts;

EndFunction

// Ветвь `Колонка.Представление`, где колонка - «ссылка на один справочник или примитив» (тег,
// примитивная часть, ссылка без идентификатора таблицы). Замеры qc2, qc6 (21.11.2026, УХ,
// `ВЫБОР КОГДА ВТ.Операция ССЫЛКА Справочник.Т ТОГДА ВТ.Операция.Представление ИНАЧЕ ВТ.Операция
// КОНЕЦ`): та же форма, что у ссылки одного типа (ReferencePresentationArmParts) - строка
// представления из присоединённого справочника; у значения другого вида её нет (NULL).
// Undefined - ветвь не такая.
Function CompositePresentationArmParts(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or Left(Trimmed, 1) = "&" Then
		Return Undefined;
	EndIf;
	Segments = StrSplit(Trimmed, ".", False);
	If Segments.Count() <> 3 Or Not IsPresentationField(Segments[2]) Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Segments[0] + "." + Segments[1], Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined Then
		Return Undefined;
	EndIf;
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Or IsBlankString(Info.TypeColumn) Or IsBlankString(Info.RefColumn)
		Or Not IsBlankString(Info.RefTypeColumn) Then
		Return Undefined;
	EndIf;
	Table = SoleReferenceTable(ResolvedTypeDescription(Resolved));
	If IsBlankString(Table) Then
		Return Undefined;
	EndIf;
	Target = MetadataOf(Table);
	If Target = Undefined Or Not IsCatalogLike(Target.FullName()) Then
		Return Undefined;
	EndIf;
	Copy = Trimmed;
	ValueSql = TranslateExpression(Copy, Context);
	If Not MentionsColumn(ValueSql) Then
		Return Undefined;
	EndIf;
	Parts = New Map;
	Parts.Insert("_TYPE", "(CASE WHEN " + ValueSql + " IS NOT NULL THEN " + BinaryLiteral("05", Context) + " END)");
	Parts.Insert("_S", ValueSql);
	Return Parts;

EndFunction

Function PrimitiveArmParts(Text, Context)

	Role = "";
	Tag = "";
	If Upper(TrimAll(Text)) = "NULL" Then
		// Литерал NULL вида не имеет - его части разбирает NullArmParts.
		Return Undefined;
	EndIf;

	// Ветвь-сравнение - булево значение. Замер mk_casebool_1 (20.11.2026, УХ): рядом с перечислением
	// платформа выводит тег 0x02 и часть _L `CASE WHEN (условие) THEN 0x01 ELSE 0x00 END` - условие,
	// которое не выполнено или неизвестно, даёт Ложь. Проверка раньше литералов: `1 = 1` - не число.
	Condition = False;
	Try
		Condition = IsConditionExpression(Text);
	Except
		Condition = False;
	EndTry;
	If Condition Then
		Saved = Context.BooleanContext;
		Context.BooleanContext = True;
		Try
			ConditionSql = TranslateExpression(Text, Context);
		Except
			Context.BooleanContext = Saved;
			Raise;
		EndTry;
		Context.BooleanContext = Saved;
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral("02", Context));
		Parts.Insert("_L", "(CASE WHEN " + ConditionSql + " THEN " + BooleanLiteral(True, Context)
			+ " ELSE " + BooleanLiteral(False, Context) + " END)");
		Return Parts;
	EndIf;

	// Литерал определяется по токенам, а не классификатором типов: тот на выражении без
	// скобок и пробелов сразу уходит в разбор пути, поэтому «"нет"» и «0» он не узнаёт -
	// а это как раз самая частая форма разнотипной ветви (ЕСТЬNULL(ссылка, 0)).
	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Text));
	Except
		Tokens = Undefined;
	EndTry;
	If Tokens <> Undefined And Tokens.Count() > 0 And Tokens.Count() <= 4 Then
		Kinds = New Map;
		For Each Token In Tokens Do
			Kinds.Insert(Token.Kind, True);
		EndDo;
		If Tokens.Count() = 1 And Tokens[0].Kind = "String" Then
			Role = "_S";
			Tag = "05";
		ElsIf Tokens.Count() = 4 And Tokens[0].Kind = "Name" And (Upper(Tokens[0].Value) = "STRING"
			Or Upper(Tokens[0].Value) = Upper("Строка")) And Tokens[1].Value = "(" And Tokens[2].Kind = "String" Then
			// СТРОКА("литерал") - та же строка (ворота 103, УХ: `ИНАЧЕ СТРОКА("")` рядом с ТИПЗНАЧЕНИЯ).
			Role = "_S";
			Tag = "05";
		ElsIf Kinds.Get("Number") <> Undefined And Kinds.Get("Name") = Undefined
			And Kinds.Get("String") = Undefined Then
			// Число, в том числе со знаком и дробной частью: знак и точка - отдельные токены.
			Role = "_N";
			Tag = "03";
		ElsIf Tokens.Count() = 1 And Tokens[0].Kind = "Name" Then
			Word = Upper(Tokens[0].Value);
			If Word = "TRUE" Or Word = Upper("Истина")
				Or Word = "FALSE" Or Word = Upper("Ложь") Then
				Role = "_L";
				Tag = "02";
			EndIf;
		EndIf;
	EndIf;
	If Not IsBlankString(Role) Then
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral(Tag, Context));
		Parts.Insert(Role, TranslateExpression(Text, Context));
		Return Parts;
	EndIf;

	Binary = BinaryKindOfArm(Text, Context);
	If Not IsBlankString(Binary) Then
		// Рядом с двоичной частью платформа выводит колонку-номер двоичного вида
		// (numeric(10,0)): 0, 1, 2 - вид среди двоичных видов колонки, -1 - значение не
		// двоичного вида. Замеры und_uh u02, stor_uh g3, mk_probe2 m7, m8.
		Result = New Map;
		Result.Insert("_TYPE", BinaryLiteral("06", Context));
		Result.Insert("_B", TranslateExpression(Text, Context));
		Result.Insert("_BK", BinaryKindPlaceholder(Binary));
		Return Result;
	EndIf;

	// Путь через составную ссылку к реквизиту одного примитивного вида во всех её типах и
	// склейка строк: замер mk_casers_3, 4 (20.11.2026, УХ) - тег `CASE WHEN значение IS NOT NULL
	// THEN 0x05 END` (у склейки - константа 0x05), часть - само значение.
	Navigated = NavigatedPrimitiveArmParts(Text, Context);
	If Navigated <> Undefined Then
		Return Navigated;
	EndIf;
	If IsStringConcatenation(Tokens) Then
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral("05", Context));
		Parts.Insert("_S", TranslateExpression(Text, Context));
		Return Parts;
	EndIf;
	Shown = ReferencePresentationArmParts(Text, Context);
	If Shown = Undefined Then
		Shown = CompositePresentationArmParts(Text, Context);
	EndIf;
	If Shown = Undefined Then
		Shown = PresentationFunctionArmParts(Tokens, Text, Context);
	EndIf;
	If Shown <> Undefined Then
		Return Shown;
	EndIf;
	Placed = DerivedPrimitiveArmParts(Text, Context);
	If Placed <> Undefined Then
		Return Placed;
	EndIf;

	// Ветвь с ПРЕДСТАВЛЕНИЕМ сюда попасть не должна, и классификатор её строкой не
	// называет - это верно. Замерено (9994-9997): представление платформа собирает после
	// СУБД, а в SQL выводит ссылочные колонки, наименование из присоединённой таблицы и
	// ключ сортировки - пять колонок. Строковой роли там нет, это отдельный класс.
	SqlType = "";
	Try
		// Форму колонки определяет только то, что замерено: тип через происхождение
		// колонки сюда не допускается.
		SqlType = SqlTypeOfExpression(Text, Context, False);
	Except
		Return Undefined;
	EndTry;
	Upper_ = Upper(TrimAll(SqlType));
	If IsBlankString(Upper_) Then
		Upper_ = FunctionResultSqlType(Text);
	EndIf;
	If IsBlankString(Upper_) And Tokens <> Undefined And Tokens.Count() > 2
		And TopLevelBinary(Tokens, 0, Tokens.Count() - 1, "+-*/") > 0 And Not IsStringConcatenation(Tokens)
		And IsBlankString(NumericOperand(Tokens, 0, Tokens.Count() - 1, Context).Reason) Then
		// Арифметика чисел - число (замер un03-un05): без этого ветвь объединения уходила в NULL.
		Upper_ = "NUMERIC";
	EndIf;
	If IsBlankString(Upper_) Then
		Return Undefined;
	EndIf;

	If StrFind(Upper_, "CHAR") > 0 Then
		Role = "_S";
		Tag = "05";
	ElsIf StrFind(Upper_, "NUMERIC") > 0 Or StrFind(Upper_, "INT") > 0 Or Upper_ = "FLOAT" Then
		Role = "_N";
		Tag = "03";
	ElsIf Upper_ = "DATETIME2" Then
		Role = "_T";
		Tag = "04";
	ElsIf Upper_ = "BINARY(1)" Then
		// Ровно один байт - булево. BINARY(16) - это ссылка, и сюда она попасть не должна.
		Role = "_L";
		Tag = "02";
	EndIf;
	If IsBlankString(Role) Or Not BranchesAgreeWithKind(Text, Role, Context) Then
		Return Undefined;
	EndIf;

	Result = New Map;
	Result.Insert("_TYPE", BinaryLiteral(Tag, Context));
	Result.Insert(Role, TranslateExpression(Text, Context));
	Return Result;

EndFunction

// Вид результата функции языка запросов, которую классификатор типов не знает: строковые
// функции дают строку, функции длины, поиска и частей даты - число; ВЫРАЗИТЬ к примитиву -
// значение этого примитива. Пустая строка - вид не выводится. Нужен ветви ВЫБОРа рядом с
// ветвью другого вида: без вида частей нет, и CASE со строкой и числом СУБД не выполняет
// (ошибка 245). Замерено (9741, ERP WE): у `ТОГДА ПОДСТРОКА(…) ИНАЧЕ 0` платформа выводит
// тег 0x05/0x03, часть _N и часть _S с SUBSTRING.
Function FunctionResultSqlType(Text)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Text));
	Except
		Return "";
	EndTry;
	If Tokens = Undefined Or Tokens.Count() < 3 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or MatchingParen(Tokens, 1) <> Tokens.Count() - 1 Then
		Return "";
	EndIf;
	Word = Upper(Tokens[0].Value);

	If Word = "CAST" Or Word = Upper("Выразить") Then
		Depth = 0;
		For Position = 1 To Tokens.Count() - 2 Do
			Value = Tokens[Position].Value;
			If Value = "(" Then
				Depth = Depth + 1;
			ElsIf Value = ")" Then
				Depth = Depth - 1;
			ElsIf Depth = 1 And Tokens[Position].Kind = "Name"
				And (Upper(Value) = "AS" Or Upper(Value) = Upper("Как")) Then
				Target = Upper(Tokens[Position + 1].Value);
				If Target = "STRING" Or Target = Upper("Строка") Then
					Return "NVARCHAR";
				ElsIf Target = "NUMBER" Or Target = Upper("Число") Then
					Return "NUMERIC";
				ElsIf Target = "DATE" Or Target = Upper("Дата") Then
					Return "DATETIME2";
				ElsIf Target = "BOOLEAN" Or Target = Upper("Булево") Then
					Return "BINARY(1)";
				EndIf;
				Return "";
			EndIf;
		EndDo;
		Return "";
	EndIf;

	Strings = StrSplit("SUBSTRING,TRIML,TRIMR,TRIMALL,UPPER,LOWER,STRREPLACE,LEFT,RIGHT,"
		+ Upper("Подстрока,СокрЛ,СокрП,СокрЛП,ВРег,НРег,СтрЗаменить,Лев,Прав"), ",", False);
	If Strings.Find(Word) <> Undefined Then
		Return "NVARCHAR";
	EndIf;
	Numbers = StrSplit("STRINGLENGTH,STRFIND,YEAR,QUARTER,MONTH,DAYOFYEAR,DAY,WEEK,WEEKDAY,HOUR,"
		+ "MINUTE,SECOND," + Upper("ДлинаСтроки,СтрНайти,Год,Квартал,Месяц,ДеньГода,День,Неделя,"
		+ "ДеньНедели,Час,Минута,Секунда"), ",", False);
	If Numbers.Find(Word) <> Undefined Then
		Return "NUMERIC";
	EndIf;
	Return "";

EndFunction

// Части ветви из одного параметра, значение которого задано. Undefined - ветвь не
// параметр, значения нет или его вид не выводится (список, uuid без типа).
//
// Тип параметра в тексте запроса не записан, его несёт значение, и платформа строит
// колонку по значению при исполнении - так же, как по литералу того же вида. Сверка
// 13.11.2026 (ERP WE, Catalog.TermsOfSale, 10 строк): у `ВЫБОР КОГДА Дата =
// ДАТАВРЕМЯ(1,1,1) ТОГДА &S ИНАЧЕ Дата КОНЕЦ` со строкой S части _TYPE 0x05/0x04, _T и _S
// совпали с 1С при S = "", "none" и "without restrictions"; одной колонкой SQL отдавал
// 1900-01-01 и падал с ошибкой 241. У `ТОГДА &Ref ИНАЧЕ НЕОПРЕДЕЛЕНО` со ссылкой _TYPE
// 0x08/0x01 и _RRRef совпали с 1С при обоих исходах условия.
Function ParameterArmParts(Text, Context)

	Name = LoneParameterName(Text);
	If IsBlankString(Name) Then
		Return Undefined;
	EndIf;

	Kind = ParameterPrimitiveRole(Name, Context);
	If Kind <> Undefined Then
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral(Kind.Tag, Context));
		Parts.Insert(Kind.Role, TranslateExpression("&" + Name, Context));
		Return Parts;
	EndIf;

	If Not Context.Options.Property("ParameterValues")
		Or TypeOf(Context.Options.ParameterValues) <> Type("Map") Then
		Return Undefined;
	EndIf;
	Value = Context.Options.ParameterValues.Get(Name);
	If Value = Undefined Then
		Return Undefined;
	EndIf;
	Parts = Undefined;
	Try
		Target = Metadata.FindByType(TypeOf(Value));
		If Target <> Undefined Then
			Parts = New Map;
			Parts.Insert("_TYPE", BinaryLiteral(HexLiteral(8, 2), Context));
			Parts.Insert("_RTRef", ReferenceTypeIdLiteral(Target.FullName(), Context));
			Parts.Insert("_RRRef", TranslateExpression("&" + Name, Context));
		EndIf;
	Except
		Parts = Undefined;
	EndTry;
	Return Parts;

EndFunction

// Ветвь ВЫБОРа из одного параметра без значения, когда рядом с ней только НЕОПРЕДЕЛЕНО
// и такие же параметры. Undefined - ветвь не такая.
//
// Без значения тип неизвестен до исполнения, а колонка всё равно составная: НЕОПРЕДЕЛЕНО
// одной колонкой не выражается, прежде оно уходило в NULL, и тега 0x01 у колонки не было
// вовсе. Ветвь читается так, как её объявляет шапка: параметр неизвестного
// типа там BINARY(16), то есть ссылка, - тот же договор, что у сравнения составного поля
// с параметром. Отказ стоил бы 127 запросов УХ, 60 ERP WE и 60 ERP (верхняя граница по
// тексту корпусов, 13.11.2026). Таблица ссылки неизвестна, поэтому её номер - NULL, а не
// пустой номер: пустой выдавал бы чужое значение за известное.
//
// Если тип параметра шапка знает - из схемы (`НАЧАЛОПЕРИОДА(&Д, …)` делает &Д датой) или
// из сравнения, - ветвь читается этим видом: шапка объявит DATETIME2, и ссылочная часть
// с датой внутри отвергается СУБД (УХ 41072, ошибка 257).
Function UntypedParameterArmParts(Arm, Branches, Context)

	Name = LoneParameterName(Arm);
	If IsBlankString(Name) Or Branches.Kind <> "CASE" Or IsOuterColumnStub(Name, Context) Then
		Return Undefined;
	EndIf;

	Others = New Array;
	For Each Item In Branches.Arms Do
		Others.Add(Item);
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		Others.Add(Branches.Else_);
	EndIf;
	Stub = False;
	For Each Item In Others Do
		If IsUndefinedLiteralText(Item) Then
			Stub = True;
		ElsIf IsBlankString(LoneParameterName(Item)) Then
			Return Undefined;
		EndIf;
	EndDo;
	If Not Stub Then
		Return Undefined;
	EndIf;

	Declared = DeclaredParameterSqlType(Name, Context);
	Role = SqlTypeKind(Declared);
	If Not IsBlankString(Declared) And Role <> "_RRRef" Then
		Tags = New Structure("_L, _N, _T, _S", "02", "03", "04", "05");
		AddOnce(Context.Warnings, StrTemplate(
			"Parameter &%1 stands as a whole branch of CASE beside UNDEFINED, and no value is supplied"
			+ " for it. The SQL reads it as the DECLARE header declares it - %2 - and returns the column"
			+ " through its parts: the type tag is 0x%3 for the parameter and 0x01 for UNDEFINED. If the"
			+ " value is of another kind, the platform returns that kind instead: supply the parameter"
			+ " value to get the right parts.",
			Name, Declared, Tags[Role]));
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral(Tags[Role], Context));
		Parts.Insert(Role, TranslateExpression("&" + Name, Context));
		Return Parts;
	EndIf;

	AddOnce(Context.Warnings, StrTemplate(
		"Parameter &%1 stands as a whole branch of CASE beside UNDEFINED, and no value is supplied"
		+ " for it, so its type is unknown before execution. The SQL reads it as the DECLARE header"
		+ " declares it - a reference, BINARY(16) - and returns the column through its parts: the"
		+ " type tag is 0x08 for the parameter and 0x01 for UNDEFINED; the table of the reference is"
		+ " not known, so no table id comes with it. If the value is a string, a number, a date or a boolean, the"
		+ " platform returns that kind instead: supply the parameter value to get the right parts.",
		Name));

	Parts = New Map;
	Parts.Insert("_TYPE", BinaryLiteral(HexLiteral(8, 2), Context));
	Parts.Insert("_RTRef", "NULL");
	Parts.Insert("_RRRef", TranslateExpression("&" + Name, Context));
	Return Parts;

EndFunction

// Тип параметра в том порядке, в каком его выбирает шапка: схема, затем выведенный.
// Пустая строка - тип неизвестен.
Function DeclaredParameterSqlType(Name, Context)

	If Context.Options.Property("SchemaParameterTypes")
		And TypeOf(Context.Options.SchemaParameterTypes) = Type("Map") Then
		Known = Context.Options.SchemaParameterTypes.Get(Upper(TrimAll(Name)));
		If Known <> Undefined Then
			Return Known;
		EndIf;
	EndIf;
	Return InferredParameterType(Name, Context);

EndFunction

// Имя параметра, если текст - один параметр и ничего больше; иначе пустая строка.
Function LoneParameterName(Text)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Text));
	Except
		Return "";
	EndTry;
	If Tokens = Undefined Or Tokens.Count() <> 1 Or Tokens[0].Kind <> "Parameter" Then
		Return "";
	EndIf;
	Return Tokens[0].Value;

EndFunction

// Параметр - заглушка обращения к колонке внешнего запроса, а не параметр запроса.
Function IsOuterColumnStub(Name, Context)

	Return Context.Options.Property("OuterColumns") And Context.Options.OuterColumns <> Undefined
		And Context.Options.OuterColumns.Get(Name) <> Undefined;

EndFunction

// Колонка - ВЫБОР с ветвью-параметром, и ветви дают значения разных видов: строку рядом
// с датой, ссылку рядом с НЕОПРЕДЕЛЕНО. Модель запроса такую колонку составной не
// объявляет - тип параметра она не знает, - поэтому состав частей объявляется здесь.
// Ветви одного вида (параметр-дата рядом с датой) колонку не меняют: она остаётся одной.
Function ParameterArmMixesKinds(Source, Context)

	Text = TrimAll(Source);
	Branches = Undefined;
	Try
		Branches = ExpressionBranches(Text);
	Except
		Return False;
	EndTry;
	If Branches = Undefined Or Branches.Kind <> "CASE" Then
		Return False;
	EndIf;

	Found = Not IsBlankString(LoneParameterName(Branches.Else_));
	For Each Arm In Branches.Arms Do
		Found = Found Or Not IsBlankString(LoneParameterName(Arm));
	EndDo;
	If Not Found Then
		Return False;
	EndIf;

	Parts = Undefined;
	Try
		Parts = BranchedCompositeParts(Text, Context, True);
	Except
		Return False;
	EndTry;
	If Parts = Undefined Then
		Return False;
	EndIf;
	If BranchCarriesUndefined(Text) Then
		Return True;
	EndIf;

	Kinds = 0;
	Reference = False;
	For Each Part In Parts Do
		If Part.Key = "_RTRef" Or Part.Key = "_RRRef" Then
			Reference = True;
		ElsIf Part.Key <> "_TYPE" Then
			Kinds = Kinds + 1;
		EndIf;
	EndDo;
	Return Kinds + ?(Reference, 1, 0) > 1;

EndFunction

// SQL-тип по заданному значению параметра; пустая строка - значения нет или вид не
// выводится (список).
Function ParameterValueSqlType(Name, Context)

	If Not Context.Options.Property("ParameterValues")
		Or TypeOf(Context.Options.ParameterValues) <> Type("Map") Then
		Return "";
	EndIf;
	Value = Context.Options.ParameterValues.Get(TrimAll(Name));
	Kind = TypeOf(Value);
	If Value = Undefined Then
		Return "";
	ElsIf Kind = Type("String") Then
		Return ?(StrLen(Value) > 500, "NVARCHAR(MAX)", "NVARCHAR(500)");
	ElsIf Kind = Type("Number") Then
		Return "NUMERIC(20, 8)";
	ElsIf Kind = Type("Date") Then
		Return "DATETIME2";
	ElsIf Kind = Type("Boolean") Then
		Return "BINARY(1)";
	ElsIf Kind = Type("Structure") Then
		// Ссылка, заданная голым uuid.
		Return "BINARY(16)";
	EndIf;
	Try
		If Metadata.FindByType(Kind) <> Undefined Then
			Return "BINARY(16)";
		EndIf;
	Except
		Return "";
	EndTry;
	Return "";

EndFunction

// Вид значения, который держит SQL-тип: роль его части. Всё, что не примитив, - ссылка.
Function SqlTypeKind(SqlType)

	Upper_ = Upper(TrimAll(SqlType));
	If Upper_ = "DATETIME2" Then
		Return "_T";
	ElsIf StrFind(Upper_, "CHAR") > 0 Then
		Return "_S";
	ElsIf StrFind(Upper_, "NUMERIC") > 0 Or StrFind(Upper_, "INT") > 0 Or Upper_ = "FLOAT" Then
		Return "_N";
	ElsIf Upper_ = "BINARY(1)" Then
		Return "_L";
	EndIf;
	Return "_RRRef";

EndFunction

// Аргумент ЗНАЧЕНИЕ(...) либо пустая строка. Образец узкий: вся ветвь целиком - один
// вызов, без ничего вокруг.
Function PredefinedValueArgument(Text)

	Trimmed = TrimAll(Text);
	If Not StrEndsWith(Trimmed, ")") Then
		Return "";
	EndIf;
	Open = StrFind(Trimmed, "(");
	If Open = 0 Then
		Return "";
	EndIf;

	Name = Upper(TrimAll(Left(Trimmed, Open - 1)));
	If Name <> "VALUE" And Name <> Upper("Значение") Then
		Return "";
	EndIf;
	Return TrimAll(Mid(Trimmed, Open + 1, StrLen(Trimmed) - Open - 1));

EndFunction

// Выражения из одних констант убираются из группировки: T-SQL их не принимает
// («каждое выражение группировки обязано содержать хотя бы одну колонку»), а строки они
// не различают - во всех строках значение одно и то же. Группировка целиком из констант
// остаётся как есть: без неё группа была бы не одна, а столько же, сколько строк.
Procedure DropConstantGroups(Group)

	ConstantOnly = New Array;
	For Each Column In Group Do
		If Not MentionsColumn(Column) Then
			ConstantOnly.Add(Column);
		EndIf;
	EndDo;
	If ConstantOnly.Count() = 0 Or ConstantOnly.Count() = Group.Count() Then
		Return;
	EndIf;
	For Each Column In ConstantOnly Do
		Group.Delete(Group.Find(Column));
	EndDo;

EndProcedure

// Есть ли в выражении колонка таблицы. Константы и параметры T-SQL в GROUP BY не
// принимает: «каждое выражение группировки обязано содержать хотя бы одну колонку».
// Признак колонки - точка после псевдонима или имя в квадратных скобках.
Function MentionsColumn(Text)

	// Точка и скобка внутри строкового литерала колонки не означают: N'н.д.' - константа,
	// и в GROUP BY её класть нельзя (MS SQL: ошибка 164). Число с точкой (0.5) - тоже
	// константа: колонка начинается с псевдонима, а не с цифры.
	Rest = Text;
	Quote = StrFind(Rest, "'");
	While Quote > 0 Do
		Close = StrFind(Rest, "'", , Quote + 1);
		If Close = 0 Then
			Break;
		EndIf;
		Rest = Left(Rest, Quote - 1) + Mid(Rest, Close + 1);
		Quote = StrFind(Rest, "'");
	EndDo;
	If StrFind(Rest, "[") > 0 Then
		Return True;
	EndIf;
	Position = StrFind(Rest, ".");
	While Position > 0 Do
		// Начало слова перед точкой: у псевдонима - буква, у числа 0.5 - цифра.
		Start = Position - 1;
		While Start > 1 And (IsNameChar(Mid(Rest, Start - 1, 1)) Or IsDigit(Mid(Rest, Start - 1, 1))) Do
			Start = Start - 1;
		EndDo;
		Head = ?(Start >= 1, Mid(Rest, Start, 1), "");
		If Head = "]" Or (IsNameChar(Head) And Not IsDigit(Head)) Then
			Return True;
		EndIf;
		Position = StrFind(Rest, ".", , Position + 1);
	EndDo;
	Return False;

EndFunction

// Части составного поля, достигнутого переходом через составную ссылку. Undefined -
// это не такой случай либо собрать не удалось. SingleKind - собрать части и у реквизита одного
// примитивного вида (тег под проверкой «реквизит прочитан» и часть вида): так его читает ветвь
// ВЫБОРа рядом с НЕОПРЕДЕЛЕНО, когда прочие разборы ветви не подошли.
Function NavigatedCompositeParts(Text, Context, SingleKind = False)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return Undefined;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Undefined;
	EndTry;
	If IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;

	// Реквизит одного имени у разных типов ссылки бывает разного вида (число у одного справочника,
	// строка у другого) или сам составной с примитивными частями. Тогда частей больше трёх
	// ссылочных: пробный вызов с ролью «?» отдаёт их состав, пустая строка - значение ссылочное.
	Roles = "";
	Try
		Roles = CompositeNavigation(Resolved, Resolved.CompositeSegment, Resolved.FieldName, Context,
			?(SingleKind, "?1", "?"));
	Except
		Roles = "";
	EndTry;
	Mixed = Not IsBlankString(Roles);
	If Not Mixed Then
		Roles = "_TYPE,_RTRef,_RRRef";
	EndIf;

	Result = New Map;
	Saved = Context.Options.Property("MixedNavigationRoles") And Context.Options.MixedNavigationRoles;
	Context.Options.Insert("MixedNavigationRoles", Mixed);
	For Each Role In StrSplit(Roles, ",", False) Do
		Piece = "";
		Try
			Piece = CompositeNavigation(Resolved, Resolved.CompositeSegment,
				Resolved.FieldName, Context, Role);
		Except
			Context.Options.Insert("MixedNavigationRoles", Saved);
			Return Undefined;
		EndTry;
		If IsBlankString(Piece) Then
			Context.Options.Insert("MixedNavigationRoles", Saved);
			Return Undefined;
		EndIf;
		Result.Insert(Role, Piece);
	EndDo;
	Context.Options.Insert("MixedNavigationRoles", Saved);
	Return Result;

EndFunction

// Запрошены части значения разных видов за составной ссылкой (NavigatedCompositeParts).
Function MixedNavigationRoles(Context)

	Return Context.Options.Property("MixedNavigationRoles") And Context.Options.MixedNavigationRoles = True;

EndFunction

// Роль и тег значения одного вида: Kind из BranchFieldKind. Undefined - вид без своей части здесь
// (хранилище значения, идентификатор, тип).
Function KindValueRole(Kind)

	If Kind = "Boolean" Then
		Return New Structure("Role, Tag", "_L", "02");
	ElsIf Kind = "Number" Then
		Return New Structure("Role, Tag", "_N", "03");
	ElsIf Kind = "Date" Then
		Return New Structure("Role, Tag", "_T", "04");
	ElsIf Kind = "String" Then
		Return New Structure("Role, Tag", "_S", "05");
	ElsIf Kind = "Reference" Then
		Return New Structure("Role, Tag", "_RRRef", "08");
	EndIf;
	Return Undefined;

EndFunction

// Какие части несёт реквизит FieldName таблицы Descriptor вида Kind: отметки в Roles. Вид не
// выведен или своей части не имеет - отметка «?», и состав не объявляется вовсе.
Procedure NoteNavigatedRoles(Roles, Kind, Descriptor, FieldName)

	Roles.Insert("#" + String(Kind), True);
	If Kind = "Composite" Then
		Info = CompositeInfo(Descriptor, FieldName);
		If Info = Undefined Or IsBlankString(Info.TypeColumn) Then
			Roles.Insert("?", True);
			Return;
		EndIf;
		For Each Pair In InfoPartColumns(Info) Do
			Roles.Insert(Pair.Key, True);
		EndDo;
		Return;
	EndIf;
	Own = KindValueRole(Kind);
	If Own = Undefined Then
		Roles.Insert("?", True);
		Return;
	EndIf;
	Roles.Insert("_TYPE", True);
	Roles.Insert(Own.Role, True);
	If Kind = "Reference" Then
		Roles.Insert("_RTRef", True);
	EndIf;

EndProcedure

// Состав частей строкой через запятую в порядке ролей; пустая строка - примитивных частей нет
// (значение ссылочное, три прежние роли), вид у всех ветвей один (значение - одна колонка, прежний
// путь) либо вид какой-то ветви не выведен.
Function NavigatedRolesText(Roles, SingleKind = False)

	If Roles.Get("?") <> Undefined Then
		Return "";
	EndIf;
	KindCount = 0;
	For Each Pair In Roles Do
		If StrStartsWith(Pair.Key, "#") Then
			KindCount = KindCount + 1;
		EndIf;
	EndDo;
	If KindCount < 2 And Roles.Get("#Composite") = Undefined And Not SingleKind Then
		Return "";
	EndIf;
	If Roles.Get("_L") = Undefined And Roles.Get("_N") = Undefined And Roles.Get("_T") = Undefined
		And Roles.Get("_S") = Undefined Then
		Return "";
	EndIf;
	Names = New Array;
	For Each Suffix In PartRoleOrder() Do
		If Roles.Get(Suffix) <> Undefined Then
			Names.Add(Suffix);
		EndIf;
	EndDo;
	Return StrConcat(Names, ",");

EndFunction

// Часть Role значения реквизита одного вида в ветви составной ссылки. Замеры d1, d8 (21.11.2026,
// УХ, `П.ПотребительРасчета.Код`: число у одного справочника, строка у трёх; `Ф.ВладелецФайла.Основание`:
// строка, ссылка, составное): тег - `CASE WHEN <реквизит> IS NOT NULL THEN <тег вида> END`, часть
// своего вида - сам реквизит, части других видов - `CASE WHEN <реквизит> IS NOT NULL THEN <пустое
// значение> END`, идентификатор таблицы у ссылки - под той же проверкой.
Function NavigatedBranchPart(Current, TargetField, Own, Role, Context)

	Kind = Undefined;
	Owner = MetadataOf(Current.LogicalName);
	If Owner <> Undefined Then
		Kind = BranchFieldKind(Owner, TargetField);
	EndIf;
	Value = KindValueRole(Kind);
	If Value = Undefined Or (Not Current.IsDerived And IsFolderField(TargetField)) Then
		Raise StrTemplate("The parts of field %1.%2 cannot be built: its kind is not one of boolean, number,"
			+ " date, string or reference.", Current.LogicalName, TargetField);
	EndIf;
	If Role = Value.Role Then
		Return Own;
	EndIf;
	Guard = "(CASE WHEN " + Own + " IS NOT NULL THEN ";
	If Role = "_TYPE" Then
		Return Guard + BinaryLiteral(Value.Tag, Context) + " END)";
	EndIf;
	If Role = "_RTRef" And Kind = "Reference" Then
		Return Guard + ReferenceTypeIdLiteral(ReferencedTableName(Current.LogicalName, TargetField), Context)
			+ " END)";
	EndIf;
	Return Guard + EmptyPartLiteral(Role, Context) + " END)";

EndFunction

// Целевая таблица перехода через точку по составной ссылке, либо пустая строка.
// Состав типов такого значения считает CompositeTailOrigin - объединение по тем ветвям
// составной ссылки, у которых такой путь есть. Один ссылочный тип означает, что
// значение односоставное, и его части константны.
Function NavigatedReferenceTarget(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return "";
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return "";
	EndTry;
	If IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;

	Origin = CompositeTailOrigin(Resolved);
	If Origin = Undefined Or Not Origin.Property("Type") Or Origin.Type = Undefined Then
		Return "";
	EndIf;
	Types = Origin.Type.Types();
	If Types.Count() <> 1 Then
		Return "";
	EndIf;
	Target = Metadata.FindByType(Types[0]);
	If Target = Undefined Then
		Return "";
	EndIf;
	Return Target.FullName();

EndFunction

// Часть ветви по роли. Роли у ветви может не быть, и тогда на её месте стоит та же
// константа, что у НЕОПРЕДЕЛЕНО: значения этой роли в такой строке нет.
// Пустое значение роли. Одно место на все механизмы: им заполняется роль, которой
// у ветви нет, и им же сравнение составного поля с литералом проверяет остальные части.
Function EmptyPartLiteral(Suffix, Context)

	If Suffix = "_RTRef" Then
		Return BinaryLiteral("00000000", Context);
	ElsIf Suffix = "_L" Then
		Return BooleanLiteral(False, Context);
	ElsIf Suffix = "_N" Then
		Return "0";
	ElsIf Suffix = "_T" Then
		Return ValueLiteral(Date(1, 1, 1), Context);
	ElsIf Suffix = "_S" Then
		Return TextLiteral("", Context);
	ElsIf Suffix = "_B" Then
		// Двоичная часть (идентификатор, хранилище, тип) у значения другого вида - пустая
		// последовательность байт: @P = 0x в плане платформы (замер und_uh u02, stor_uh g3).
		Return BinaryLiteral("", Context);
	ElsIf Suffix = "_BK" Then
		// Номер двоичного вида у значения не двоичного вида, у НЕОПРЕДЕЛЕНО и у NULL: -1
		// (план платформы: -@P при @P = 1; замеры und_uh u02, vtcorp v2, mk_probe2 m7).
		Return BinaryKindMarker(-1);
	EndIf;
	Return BinaryLiteral("00000000000000000000000000000000", Context);

EndFunction

// Ветвь-литерал NULL. Это не НЕОПРЕДЕЛЕНО: значения нет вовсе, и NULL стоит во всех
// частях, а не тег 0x01 и пустые значения ролей. Замерено 14.11.2026 (УХ):
// `ВЫБОР … ТОГДА ссылка ИНАЧЕ NULL КОНЕЦ` во временной таблице и затем `ЕСТЬ NULL` - все
// такие строки NULL, ни одной Неопределено; `ВЫБРАТЬ NULL … ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ
// ссылка` - строка NULL остаётся NULL. Тег 0x01 превращал отсутствие значения в
// НЕОПРЕДЕЛЕНО, и `НЕ … ЕСТЬ NULL` пропускал такие строки.
//
// Роль у ветви одна - тег: составной её делает соседняя ветвь, а не она. ArmPart отдаёт
// для неё NULL по любой роли.
// Несёт ли ветвь ссылку и значение примитива; ветвь NULL не несёт ничего.
Procedure NoteArmRoles(Parts, Referenced, Valued)

	If IsNullArm(Parts) Then
		Return;
	EndIf;
	For Each Part In Parts Do
		If Part.Key = "_RTRef" Or Part.Key = "_RRRef" Then
			Referenced = True;
		ElsIf Part.Key <> "_TYPE" And Part.Key <> "_BK" Then
			Valued = True;
		EndIf;
	EndDo;

EndProcedure

Function NullArmParts()

	Parts = New Map;
	Parts.Insert("_TYPE", "NULL");
	Return Parts;

EndFunction

Function IsNullArm(Parts)

	Return Parts <> Undefined And Parts.Count() = 1 And Parts.Get("_TYPE") = "NULL";

EndFunction

Function ArmPart(Parts, Suffix, Context)

	If IsNullArm(Parts) Then
		Return ?(Suffix = "_BK", EmptyPartLiteral(Suffix, Context), "NULL");
	EndIf;
	Text = ?(Parts = Undefined, Undefined, Parts.Get(Suffix));
	If Text <> Undefined Then
		Return Text;
	EndIf;
	If Suffix = "_TYPE" Then
		// Составное без тега - регистратор: он всегда ссылка, тег платформа не хранит.
		// Пустой тег 0x01 читался бы как НЕОПРЕДЕЛЕНО и переставлял строки в порядке.
		If Parts <> Undefined And Parts.Get("_RTRef") <> Undefined Then
			Return BinaryLiteral(HexLiteral(8, 2), Context);
		EndIf;
		Return BinaryLiteral("01", Context);
	EndIf;
	Return EmptyPartLiteral(Suffix, Context);

EndFunction

// Разбор выражения на ветви: ВЫБОР КОГДА … ТОГДА … ИНАЧЕ … КОНЕЦ и ЕСТЬNULL(a, b).
// Форма «ВЫБОР X КОГДА значение» не разбирается: платформа разворачивает такое
// сравнение в проверку всех трёх частей (эталон 9961), и это отдельный шаг.
Function ExpressionBranches(Source)

	Tokens = Tokenize(ExpandUndefinedInLists(ExpandSelectorCases(Source)));
	If Tokens.Count() < 3 Or Tokens[0].Kind <> "Name" Then
		Return Undefined;
	EndIf;

	Word = Upper(Tokens[0].Value);
	Result = New Structure("Kind, Conditions, Arms, Else_", "", New Array, New Array, "");

	If Word = "ISNULL" Or Word = Upper("ЕстьNULL") Then
		Consumed = 0;
		Arguments = CollectArguments(Tokens, 0, Consumed);
		If Arguments.Count() <> 2 Then
			Return Undefined;
		EndIf;
		Result.Kind = "ISNULL";
		Result.Arms.Add(Argument(Arguments, 0));
		Result.Arms.Add(Argument(Arguments, 1));
		Return Result;
	EndIf;

	If Word <> "CASE" And Word <> Upper("Выбор") Then
		Return Undefined;
	EndIf;
	Next = Upper(Tokens[1].Value);
	If Next <> "WHEN" And Next <> Upper("Когда") Then
		Return Undefined;
	EndIf;

	Depth = 0;
	Nested = 0;
	Position = 1;
	While Position < Tokens.Count() Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
		ElsIf Depth = 0 And Tokens[Position].Kind = "Name" Then
			Keyword = Upper(Value);
			If Keyword = "CASE" Or Keyword = Upper("Выбор") Then
				Nested = Nested + 1;
			ElsIf Keyword = "END" Or Keyword = Upper("Конец") Then
				If Nested = 0 Then
					Break;
				EndIf;
				Nested = Nested - 1;
			ElsIf Nested = 0 And (Keyword = "WHEN" Or Keyword = Upper("Когда")) Then
				// Границу условия ищем с учётом вложенных ВЫБОРов: счёт одних скобок
				// останавливался на ТОГДА внутреннего ВЫБОРа и обрезал условие - внешний
				// WHEN оставался без THEN, а условием становился вложенный CASE.
				Finish = SameLevelKeyword(Tokens, Position + 1, "THEN", Upper("Тогда"));
				If Finish = 0 Then
					Return Undefined;
				EndIf;
				Result.Conditions.Add(TokensText(Tokens, Position + 1, Finish - 1));
				Position = Finish;
				Continue;
			ElsIf Nested = 0 And (Keyword = "THEN" Or Keyword = Upper("Тогда")) Then
				Finish = BranchEnd(Tokens, Position + 1);
				If Finish < Position + 1 Then
					Return Undefined;
				EndIf;
				Result.Arms.Add(TokensText(Tokens, Position + 1, Finish));
				Position = Finish;
			ElsIf Nested = 0 And (Keyword = "ELSE" Or Keyword = Upper("Иначе")) Then
				Finish = BranchEnd(Tokens, Position + 1);
				If Finish < Position + 1 Then
					Return Undefined;
				EndIf;
				Result.Else_ = TokensText(Tokens, Position + 1, Finish);
				Position = Finish;
			EndIf;
		EndIf;
		Position = Position + 1;
	EndDo;

	If Result.Conditions.Count() = 0 Or Result.Conditions.Count() <> Result.Arms.Count() Then
		Return Undefined;
	EndIf;
	Result.Kind = "CASE";
	Return Result;

EndFunction

// Части составного значения, собранного по ветвям. Замерено: платформа строит один и
// тот же скелет выражения на каждую роль и подставляет в ветви части этой роли -
// ВЫБОР остаётся ВЫБОРом, ЕСТЬNULL остаётся ЕСТЬNULL (эталоны 9960, 9962-9965).
//
// Условия переводятся один раз на всё выражение, а не на каждую роль: перевод условия
// регистрирует соединения, и повторный зарегистрировал бы их дважды.
Function BranchedCompositeParts(Source, Context, RolesOnly = False)

	Branches = ExpressionBranches(Source);
	If Branches = Undefined Then
		Return Undefined;
	EndIf;

	Values = New Array;
	Roles = New Map;
	Composites = 0;
	FirstArm = True;
	For Each Arm In Branches.Arms Do
		// Первый аргумент ЕСТЬNULL: его NULL закрывает сама функция (тег - по проверке «значение
		// есть»), поэтому вид поля виртуальной таблицы здесь берётся по происхождению колонки
		// (DerivedPrimitiveArmParts).
		Checked = Branches.Kind = "ISNULL" And FirstArm;
		FirstArm = False;
		Saved = Context.Options.Property("NullCheckedArm") And Context.Options.NullCheckedArm = True;
		Context.Options.Insert("NullCheckedArm", Checked);
		Try
			Parts = ArmCompositeParts(Arm, Context, RolesOnly);
		Except
			Context.Options.Insert("NullCheckedArm", Saved);
			Raise;
		EndTry;
		Context.Options.Insert("NullCheckedArm", Saved);
		If Parts = Undefined Then
			Parts = UntypedParameterArmParts(Arm, Branches, Context);
		EndIf;
		If Parts = Undefined Then
			Parts = StubNeighbourArmParts(Arm, Branches, Context);
		EndIf;
		If Parts = Undefined Then
			Return Undefined;
		EndIf;
		Values.Add(Parts);
		For Each Part In Parts Do
			Roles.Insert(Part.Key, True);
		EndDo;
		If Parts.Count() > 1 Then
			Composites = Composites + 1;
		EndIf;
	EndDo;

	ElseParts = Undefined;
	If Not IsBlankString(Branches.Else_) Then
		ElseParts = ArmCompositeParts(Branches.Else_, Context, RolesOnly);
		If ElseParts = Undefined Then
			ElseParts = UntypedParameterArmParts(Branches.Else_, Branches, Context);
		EndIf;
		If ElseParts = Undefined Then
			ElseParts = StubNeighbourArmParts(Branches.Else_, Branches, Context);
		EndIf;
		If ElseParts = Undefined Then
			Return Undefined;
		EndIf;
		For Each Part In ElseParts Do
			Roles.Insert(Part.Key, True);
		EndDo;
		If ElseParts.Count() > 1 Then
			Composites = Composites + 1;
		EndIf;
	EndIf;

	If Composites = 0 Then
		// Ни одна ветвь не составная: собирать нечего, прежний вывод верен.
		Return Undefined;
	EndIf;

	// Ссылочные части НЕОПРЕДЕЛЕНО выводятся, только если ссылку несёт другая ветвь: рядом
	// с одними примитивами платформа выводит тег и части примитивов (замеры u06 - строка,
	// und_uh u02 - тип, stor_uh g3 - идентификатор).
	Referenced = False;
	Valued = False;
	AllParts = New Array;
	Index = 0;
	For Each Parts In Values Do
		AllParts.Add(Parts);
		If Not IsUndefinedLiteralText(Branches.Arms[Index]) Then
			NoteArmRoles(Parts, Referenced, Valued);
		EndIf;
		Index = Index + 1;
	EndDo;
	If ElseParts <> Undefined Then
		AllParts.Add(ElseParts);
		If Not IsUndefinedLiteralText(Branches.Else_) Then
			NoteArmRoles(ElseParts, Referenced, Valued);
		EndIf;
	EndIf;
	If Valued And Not Referenced Then
		Roles.Delete("_RTRef");
		Roles.Delete("_RRRef");
	EndIf;
	ResolveBinaryKindMarkers(AllParts);

	If RolesOnly Then
		// Пробному проходу нужны только ключи: условия он не переводит, потому что их
		// перевод создаёт табличные выражения в общем реестре, а текст прохода выбрасывается.
		Names = New Map;
		For Each Suffix In PartRoleOrder() Do
			If Roles.Get(Suffix) <> Undefined Then
				Names.Insert(Suffix, "");
			EndIf;
		EndDo;
		Return Names;
	EndIf;

	Conditions = New Array;
	Saved = Context.BooleanContext;
	For Each Condition In Branches.Conditions Do
		// Условие переводится в логическом контексте: иначе булево поле остаётся колонкой,
		// а T-SQL логического типа не знает и требует сравнения. Так же поступает перевод
		// условий соединения.
		Context.BooleanContext = True;
		Conditions.Add(TranslateExpression(Condition, Context));
		Context.BooleanContext = Saved;
	EndDo;

	// Проверка «первый аргумент ЕСТЬNULL отсутствует» считается один раз: перевод
	// регистрирует соединение, и повторять его незачем. Текст аргумента передаётся
	// локальной копией - параметры BSL передаются по ссылке, и перевод перезаписывает
	// переданную строку: без копии Branches.Arms[0] со второй роли был бы уже переведён.
	NullProbe = "";
	If Branches.Kind = "ISNULL" And Values.Count() > 0 Then
		ProbeArm = Branches.Arms[0];
		NullProbe = IsNullProbe(Values[0], ProbeArm, Context);
	EndIf;

	Result = New Map;
	For Each Suffix In PartRoleOrder() Do
		If Roles.Get(Suffix) = Undefined Then
			Continue;
		EndIf;

		Texts = New Array;
		For Each Parts In Values Do
			Texts.Add(NumberPartSql(ArmPart(Parts, Suffix, Context), Suffix, Context));
		EndDo;
		If Branches.Kind <> "ISNULL" And ElseParts <> Undefined Then
			Texts.Add(NumberPartSql(ArmPart(ElseParts, Suffix, Context), Suffix, Context));
		EndIf;

		// Без ИНАЧЕ свёртывать нельзя: у непокрытой строки значение NULL, а не значение
		// ветви, и одинаковые ветви этого не отменяют.
		Same = (Branches.Kind = "ISNULL") Or (ElseParts <> Undefined);
		For Each Text In Texts Do
			If Text <> Texts[0] Then
				Same = False;
				Break;
			EndIf;
		EndDo;
		If Same Then
			// Значение этой роли от ветви не зависит - ВЫБОР не нужен. Заодно это снимает
			// выражение из одних констант: GROUP BY такое не принимает, а в группировку
			// подколонки добираются.
			Result.Insert(Suffix, Texts[0]);
			Continue;
		EndIf;

		If Branches.Kind = "ISNULL" Then
			If MentionsColumn(Texts[0]) Then
				// Часть первого аргумента - сама обнуляемая колонка, и её же проверяет
				// платформа (эталоны 9962, 9963).
				Result.Insert(Suffix, "COALESCE(" + Texts[0] + ", " + Texts[1] + ")");
			Else
				// Часть константна - у односоставной ссылки тег и идентификатор таблицы
				// именно такие. ISNULL от константы всегда отдаёт её саму, и вторая ветвь
				// становится недостижимой. Платформа в этом случае проверяет сам первый
				// аргумент: CASE WHEN <аргумент> IS NULL THEN … ELSE … END (эталоны
				// 9900-9902).
				Result.Insert(Suffix, "(CASE WHEN " + NullProbe
					+ " IS NULL THEN " + Texts[1] + " ELSE " + Texts[0] + " END)");
			EndIf;
			Continue;
		EndIf;

		Pieces = New Array;
		Pieces.Add("CASE");
		For Index = 0 To Conditions.Count() - 1 Do
			Pieces.Add("WHEN " + Conditions[Index] + " THEN " + Texts[Index]);
		EndDo;
		If ElseParts <> Undefined Then
			Pieces.Add("ELSE " + Texts[Texts.UBound()]);
		EndIf;
		Pieces.Add("END");
		Result.Insert(Suffix, "(" + StrConcat(Pieces, " ") + ")");
	EndDo;
	Return Result;

EndFunction

// Колонка, по которой видно, что первый аргумент ЕСТЬNULL отсутствует. У составного
// значения это тег типа, у односоставного - сама колонка значения: тег там константа и
// об отсутствии ничего не говорит. Замерено: 9963 проверяет _TYPE, 9900-9902 - колонку
// ссылки.
Function IsNullProbe(Parts, Arm, Context)

	Text = ?(Parts = Undefined, Undefined, Parts.Get("_TYPE"));
	If Text <> Undefined And MentionsColumn(Text) Then
		Return Text;
	EndIf;
	Return TranslateExpression(Arm, Context);

EndFunction

// Состав объявленных типов колонки: сколько в нём ссылочных и сколько примитивных.
// Ссылочный тип отличается тем, что по нему находится объект метаданных. Null не
// считается ни тем, ни другим: у колонки после внешнего соединения он объявлен всегда.
Function DeclaredTypeMix(Column)

	Result = New Structure("References, Primitives", 0, 0);
	Description = Undefined;
	Try
		Description = Column.ValueType;
	Except
		Return Result;
	EndTry;
	If Description = Undefined Then
		Return Result;
	EndIf;

	For Each Item In Description.Types() Do
		If Item = Type("Null") Then
			Continue;
		EndIf;
		If Metadata.FindByType(Item) = Undefined Then
			Result.Primitives = Result.Primitives + 1;
		Else
			Result.References = Result.References + 1;
		EndIf;
	EndDo;
	Return Result;

EndFunction

// Агрегат верхним уровнем выражения: МАКСИМУМ, МИНИМУМ или СУММА. КОЛИЧЕСТВО здесь
// не нужно - его результат число, составным он не бывает.
Function TopLevelAggregate(Text)

	Trimmed = Upper(TrimAll(Text));
	If Not StrEndsWith(Trimmed, ")") Then
		Return "";
	EndIf;
	Open = StrFind(Trimmed, "(");
	If Open = 0 Then
		Return "";
	EndIf;

	Name = TrimAll(Left(Trimmed, Open - 1));
	For Each Known In StrSplit("MAX,MIN,SUM," + Upper("Максимум") + "," + Upper("Минимум")
		+ "," + Upper("Сумма"), ",", False) Do
		If Name = Known Then
			Return Name;
		EndIf;
	EndDo;
	Return "";

EndFunction

// Части колонки принадлежат разным видам значения: ссылочная роль рядом с примитивной
// либо две разные примитивные. Единого SQL-типа для такой колонки нет.
Function MixedKindParts(PartSuffixes, Alias)

	If PartSuffixes = Undefined Or IsBlankString(TrimAll(Alias)) Then
		Return False;
	EndIf;
	Suffixes = PartSuffixes.Get(Upper(TrimAll(Alias)));
	If Suffixes = Undefined Then
		Return False;
	EndIf;

	References = 0;
	Primitives = 0;
	Typed = False;
	For Each Suffix In Suffixes Do
		If Suffix = "_RTRef" Or Suffix = "_RRRef" Then
			References = 1;
		ElsIf Suffix = "_L" Or Suffix = "_N" Or Suffix = "_T" Or Suffix = "_S" Or Suffix = "_B" Then
			Primitives = Primitives + 1;
		ElsIf Suffix = "_TYPE" Then
			Typed = True;
		EndIf;
	EndDo;
	// Тег рядом с единственным примитивом без ссылочных частей: второй вид - НЕОПРЕДЕЛЕНО,
	// части значения у него нет (замер u06: строка рядом с НЕОПРЕДЕЛЕНО - тег и _S).
	Return (Primitives > 0 And (References > 0 Or Typed)) Or Primitives > 1;

EndFunction

// Порядок по колонке идёт по её частям: разнотипная либо несёт идентификатор таблицы ссылки.
Function OrderedByParts(PartSuffixes, Alias)

	If MixedKindParts(PartSuffixes, Alias) Then
		Return True;
	EndIf;
	Suffixes = PartSuffixes.Get(Upper(TrimAll(Alias)));
	Return Suffixes <> Undefined And Suffixes.Find("_RTRef") <> Undefined;

EndFunction

// Результат выражения заведомо не составной: представление и строковые функции дают
// строку, ТИПЗНАЧЕНИЯ - значение типа, КОЛИЧЕСТВО - число. Составного в такой колонке
// не бывает, и предупреждать о потере частей там нечего. Проверяется только верхний
// уровень: вложенное в ВЫБОР представление остаётся под предупреждением, потому что
// рядом с ним в другой ветви может стоять ссылка.
// Роль литерала-примитива без ДАТАВРЕМЯ: _S у строки, _N у числа, _L у ИСТИНА/ЛОЖЬ; пустая
// строка - текст не такой литерал. Токены - как у PrimitiveArmParts.
Function PrimitiveLiteralRole(Text)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Text));
	Except
		Return "";
	EndTry;
	If Tokens <> Undefined And Tokens.Count() = 4 And Tokens[0].Kind = "Name" And (Upper(Tokens[0].Value) = "STRING"
		Or Upper(Tokens[0].Value) = Upper("Строка")) And Tokens[1].Value = "(" And Tokens[2].Kind = "String" Then
		// СТРОКА("литерал") - та же строка (ворота 103, УХ).
		Return "_S";
	EndIf;
	If Tokens = Undefined Or Tokens.Count() = 0 Or Tokens.Count() > 3 Then
		Return "";
	EndIf;
	If Tokens.Count() = 1 And Tokens[0].Kind = "String" Then
		Return "_S";
	EndIf;
	If Tokens.Count() = 1 And Tokens[0].Kind = "Name" Then
		Word = Upper(Tokens[0].Value);
		Return ?(Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь"),
			"_L", "");
	EndIf;
	Kinds = New Map;
	For Each Token In Tokens Do
		Kinds.Insert(Token.Kind, True);
	EndDo;
	Return ?(Kinds.Get("Number") <> Undefined And Kinds.Get("Name") = Undefined
		And Kinds.Get("String") = Undefined, "_N", "");

EndFunction

// ВЫБОР, у которого ветви - литералы разных видов: строка рядом с числом или булевым,
// число рядом с булевым. Платформа отдаёт значение каждой ветви её видом (сверка 13.11.2026,
// ERP WE: `ВЫБОР КОГДА … ТОГДА "007" ИНАЧЕ 5 КОНЕЦ` - 1С "007", SQL 7; ИСТИНА рядом с 5 -
// 1С Истина, SQL 1), а CASE СУБД сводит ветви к одному типу молча. Разбор по частям такие
// ветви не берёт (ResultIsNotComposite считает литерал несоставным), поэтому отказ. Ветвь
// ДАТАВРЕМЯ сюда не считается: с ней выражение расщепляется на части, и это сверено.
Procedure CheckCaseLiteralKinds(Tokens)

	For Index = 0 To Tokens.Count() - 1 Do
		If Tokens[Index].Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Index].Value);
		If Word <> "CASE" And Word <> Upper("Выбор") Then
			Continue;
		EndIf;
		Roles = New Map;
		For Each Span In CaseArmSpans(Tokens, Index) Do
			Role = PrimitiveLiteralRole(TokensText(Tokens, Span.From, Span.Till));
			If Not IsBlankString(Role) Then
				Roles.Insert(Role, True);
			EndIf;
		EndDo;
		If Roles.Count() > 1 Then
			Raise "CASE returns literals of different kinds - a string beside a number, a boolean beside"
				+ " a number or a string. The platform returns each branch as a value of its own kind, and"
				+ " the SQL CASE converts them all to one type, so ""007"" comes back as 7. Make the"
				+ " branches one kind, for example write the number as a string.";
		EndIf;
	EndDo;

EndProcedure

// Сравнение двух литералов разных видов: "5" = 5, ИСТИНА = 1, "" = 0, 5 В ("5", 6). У
// платформы значения разных видов не равны (сверка 13.11.2026, ERP WE: все четыре - Ложь),
// а СУБД приводит одно к другому и отвечает Истина. Платформа решает такое сравнение до SQL
// (замер lit l1-l4, 19.11.2026, УХ): `=` - заведомо ложное условие (`(0x00) = 0x01`, рядом
// с другими условиями `1=0`), `<>` - условия нет, ВЫБОР над ним - константа. Здесь сравнение
// заменяется литералом ЛОЖЬ или ИСТИНА, элемент списка В другого вида - выбрасывается.
// Сравнение поля с литералом другого вида не трогается: ГДЕ P.ЭтоГруппа = 1 у платформы и у
// SQL дали одно (12 строк).
Procedure CheckLiteralComparisonKinds(Tokens)

	Index = 1;
	While Index < Tokens.Count() - 1 Do
		Last = Tokens.Count() - 1;
		Token = Tokens[Index];
		Left = LoneLiteralRole(Tokens, Index - 1, -1);
		If IsBlankString(Left) Then
			Index = Index + 1;
			Continue;
		EndIf;
		If Token.Kind = "Symbol" And (Token.Value = "=" Or Token.Value = "<>") Then
			Right = LoneLiteralRole(Tokens, Index + 1, 1);
			If Not IsBlankString(Right) And Right <> Left Then
				Tokens.Delete(Index + 1);
				Tokens.Delete(Index);
				Tokens[Index - 1] = NewToken("Name", ?(Token.Value = "=", "FALSE", "TRUE"));
				Continue;
			EndIf;
		ElsIf Token.Kind = "Name" And (Upper(Token.Value) = "IN" Or Upper(Token.Value) = Upper("В"))
			And Index < Last And Tokens[Index + 1].Value = "(" Then
			Kept = New Array;
			Foreign = 0;
			Plain = True;
			Position = Index + 2;
			While Position <= Last And Tokens[Position].Value <> ")" Do
				Role = TokenLiteralRole(Tokens[Position]);
				If IsBlankString(Role) Or (Position < Last And Tokens[Position + 1].Value <> ","
					And Tokens[Position + 1].Value <> ")") Then
					// Элемент списка - не одиночный литерал: вид его здесь не выводится.
					Plain = False;
					Break;
				EndIf;
				If Role = Left Then
					Kept.Add(Tokens[Position]);
				Else
					Foreign = Foreign + 1;
				EndIf;
				Position = Position + 2;
			EndDo;
			// Цикл шагает через запятую: после последнего элемента Position стоит за скобкой.
			Close = Position - 1;
			If Plain And Foreign > 0 And Close <= Last And Tokens[Close].Value = ")" Then
				If Kept.Count() = 0 Then
					// Ни одного элемента того же вида: значение не равно ни одному.
					For Step = Index To Close Do
						Tokens.Delete(Index);
					EndDo;
					Tokens[Index - 1] = NewToken("Name", "FALSE");
					Continue;
				EndIf;
				// Элементы другого вида значению не равны: список собирается из остальных.
				For Step = Index + 2 To Close - 1 Do
					Tokens.Delete(Index + 2);
				EndDo;
				At = Index + 2;
				For Each Element In Kept Do
					If At > Index + 2 Then
						Tokens.Insert(At, NewToken("Symbol", ","));
						At = At + 1;
					EndIf;
					Tokens.Insert(At, Element);
					At = At + 1;
				EndDo;
			EndIf;
		EndIf;
		Index = Index + 1;
	EndDo;

EndProcedure

// Роль одиночного литерала-токена на позиции, если он не часть арифметики: соседний токен
// с внешней стороны (Step = -1 - слева, 1 - справа) не знак действия. Пустая строка иначе.
Function LoneLiteralRole(Tokens, Position, Step)

	If Position < 0 Or Position > Tokens.Count() - 1 Then
		Return "";
	EndIf;
	Role = TokenLiteralRole(Tokens[Position]);
	If IsBlankString(Role) Then
		Return "";
	EndIf;
	Outer = Position + Step;
	If Outer >= 0 And Outer <= Tokens.Count() - 1
		And StrFind("+-*/.", Tokens[Outer].Value) > 0 And StrLen(Tokens[Outer].Value) = 1 Then
		Return "";
	EndIf;
	Return Role;

EndFunction

// Колонка объединения: во всех частях литералы (или NULL), и видов среди них больше одного.
Function MixedLiteralColumn(Query, Index)

	If Query.Operators.Count() < 2 Or Index >= Query.Columns.Count() Then
		Return False;
	EndIf;
	Roles = New Map;
	For Each Operator In Query.Operators Do
		Source = TrimAll(ColumnFieldText(Query, Operator, Index));
		If Upper(Source) = "NULL" Then
			Continue;
		EndIf;
		Role = PrimitiveLiteralRole(Source);
		If IsBlankString(Role) Then
			Return False;
		EndIf;
		Roles.Insert(Role, True);
	EndDo;
	Return Roles.Count() > 1;

EndFunction

// Колонка объединения, где во всех частях литералы, а виды их разные: `ВЫБРАТЬ "007"
// ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ 5`. Платформа отдаёт строку строкой и число числом (сверка
// 13.11.2026, ERP WE), UNION СУБД сводит колонку к одному типу: 7 и 5. Части у такой колонки
// не собираются - их объявляет только часть с полем, - поэтому отказ. Часть с полем рядом с
// литералом другого вида расщепляется и сверена (Description и 0).
Procedure CheckUnionLiteralKinds(Query)

	If Query.Operators.Count() < 2 Then
		Return;
	EndIf;
	For Index = 0 To Query.Columns.Count() - 1 Do
		Roles = New Map;
		AllLiterals = True;
		For Each Operator In Query.Operators Do
			If Index >= BranchFieldCount(Query, Operator) Then
				AllLiterals = False;
				Break;
			EndIf;
			Source = TrimAll(ColumnFieldText(Query, Operator, Index));
			If Upper(Source) = "NULL" Then
				Continue;
			EndIf;
			Role = PrimitiveLiteralRole(Source);
			If IsBlankString(Role) Then
				AllLiterals = False;
				Break;
			EndIf;
			Roles.Insert(Role, True);
		EndDo;
		If AllLiterals And Roles.Count() > 1 Then
			Raise StrTemplate("Column %1 of the union holds literals of different kinds in its parts - a"
				+ " string beside a number or a boolean. The platform returns each as a value of its own"
				+ " kind, and the SQL UNION converts the column to one type. Make the literals one kind.",
				TrimAll(Query.Columns[Index].Alias));
		EndIf;
	EndDo;

EndProcedure

// Значение аргумента, если это один строковый литерал (кавычки сняты, удвоенные - одна); иначе Undefined.
Function StringLiteralArgument(Argument)

	Tokens = Tokenize(TrimAll(String(Argument)));
	If Tokens.Count() <> 1 Or Tokens[0].Kind <> "String" Then
		Return Undefined;
	EndIf;
	Raw = Tokens[0].Value;
	Return StrReplace(Mid(Raw, 2, StrLen(Raw) - 2), """""", """");

EndFunction

// Роль токена-литерала: _S, _N, _L; пустая строка - токен не литерал-примитив.
Function TokenLiteralRole(Token)

	If Token.Kind = "String" Then
		Return "_S";
	ElsIf Token.Kind = "Number" Then
		Return "_N";
	ElsIf Token.Kind = "Name" Then
		Word = Upper(Token.Value);
		If Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь") Then
			Return "_L";
		EndIf;
	EndIf;
	Return "";

EndFunction

// Текст целиком - примитивный литерал: строка, число, логическое или ДАТАВРЕМЯ.
// Узнаётся токенами, как это делает PrimitiveArmParts: классификатор типов на выражении
// без скобок и пробелов уходит в разбор пути и литерала не узнаёт.
Function IsLiteralExpression(Text)

	Trimmed = TrimAll(Text);
	Normalized = Upper(Trimmed);
	If StrStartsWith(Normalized, "DATETIME(")
		Or StrStartsWith(Normalized, Upper("ДатаВремя(")) Then
		Return True;
	EndIf;

	Tokens = Undefined;
	Try
		Tokens = Tokenize(Trimmed);
	Except
		Return False;
	EndTry;
	If Tokens = Undefined Or Tokens.Count() = 0 Or Tokens.Count() > 3 Then
		Return False;
	EndIf;

	If Tokens.Count() = 1 And Tokens[0].Kind = "String" Then
		Return True;
	EndIf;
	If Tokens.Count() = 1 And Tokens[0].Kind = "Name" Then
		Word = Upper(Tokens[0].Value);
		Return Word = "TRUE" Or Word = Upper("Истина")
			Or Word = "FALSE" Or Word = Upper("Ложь");
	EndIf;

	// Число, в том числе со знаком и дробной частью: знак и точка - отдельные токены.
	Kinds = New Map;
	For Each Token In Tokens Do
		Kinds.Insert(Token.Kind, True);
	EndDo;
	Return Kinds.Get("Number") <> Undefined
		And Kinds.Get("Name") = Undefined And Kinds.Get("String") = Undefined;

EndFunction

// Вызов ТИПЗНАЧЕНИЯ(...) или ТИП(...) целиком: значение вида «тип».
Function IsTypeValueCall(Text)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Text));
	Except
		Return False;
	EndTry;
	If Tokens.Count() < 3 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or Tokens[Tokens.Count() - 1].Value <> ")" Then
		Return False;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "VALUETYPE" And Word <> Upper("ТипЗначения") And Word <> "TYPE" And Word <> Upper("Тип") Then
		Return False;
	EndIf;
	Depth = 0;
	For Index = 1 To Tokens.Count() - 1 Do
		If Tokens[Index].Value = "(" Then
			Depth = Depth + 1;
		ElsIf Tokens[Index].Value = ")" Then
			Depth = Depth - 1;
			If Depth = 0 And Index < Tokens.Count() - 1 Then
				Return False;
			EndIf;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Ветви ВЫБОР: значение типа рядом со значением другого вида. Каждая ветвь сама по себе не
// составная, а вместе - составная: замер vs1, vs4 (20.11.2026, УХ) - `ВЫБОР … ТОГДА ТИПЗНАЧЕНИЯ(…)
// ИНАЧЕ "" КОНЕЦ` платформа отдаёт тегом 0x06/0x05, частями _S, _B и номером двоичного вида.
// Ветвь NULL вида не задаёт.
Function TypeValueBesideOtherKind(Branches)

	Texts = New Array;
	For Each Arm In Branches.Arms Do
		Texts.Add(Arm);
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		Texts.Add(Branches.Else_);
	EndIf;
	TypeArm = False;
	OtherArm = False;
	For Each Text In Texts Do
		If IsTypeValueCall(Text) Then
			TypeArm = True;
		ElsIf Upper(TrimAll(Text)) <> "NULL" Then
			OtherArm = True;
		EndIf;
	EndDo;
	Return TypeArm And OtherArm;

EndFunction

// Ветви ВЫБОР - литералы разных видов (строка, число, булево). Платформа отдаёт такое значение частями:
// тег по ветвям и по колонке на вид, недостающие - пустыми значениями (замер 18.11.2026, УХ, lit_uh s1,
// s3: CASE ... THEN 0x03 ELSE 0x05, CASE ... THEN @P ELSE @P на _N и _S).
Function MixedLiteralArms(Branches)

	Roles = New Map;
	Texts = New Array;
	For Each Arm In Branches.Arms Do
		Texts.Add(Arm);
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		Texts.Add(Branches.Else_);
	EndIf;
	For Each Text In Texts Do
		Role = PrimitiveLiteralRole(Text);
		If Not IsBlankString(Role) Then
			Roles.Insert(Role, True);
		EndIf;
	EndDo;
	Return Roles.Count() > 1;

EndFunction

// Путь к колонке производной таблицы, которая во всех ветвях - КОЛИЧЕСТВО (DerivedCountColumn): число.
Function CountColumnPath(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrSplit(Trimmed, ".", False).Count() <> 2 Then
		Return False;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return False;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return False;
	EndIf;
	Return DerivedCountColumn(Resolved) = True;

EndFunction

Function ResultIsNotComposite(Text)

	Trimmed = Upper(TrimAll(Text));

	// Сравнение или логическое выражение на верхнем уровне - булево значение, даже если внутри
	// стоит составное: `ЕСТЬNULL(п, НЕОПРЕДЕЛЕНО) = литерал КАК Флаг` выводился с частями
	// _TYPE/_RRRef, и значение собиралось как НЕОПРЕДЕЛЕНО вместо ЛОЖЬ (полная сверка УХ,
	// ИзменениеУсловийДоговораАренды.ПринятКУчетуУУ, ИнтеграцияЦУЗсЭТП.ПоставщикСМП).
	Condition = False;
	Try
		Condition = IsConditionExpression(Text);
	Except
		Condition = False;
	EndTry;
	If Condition Then
		Return True;
	EndIf;

	// Унарный минус - число: в языке запросов он применим только к числу. Модель запроса даёт
	// `-КОЛИЧЕСТВО(РАЗЛИЧНЫЕ <составное>)`, как и самому агрегату, тип аргумента (справка 17.11.2026,
	// УХ: `КОЛИЧЕСТВО(РАЗЛИЧНЫЕ <составное>)` - numeric(12,0), колонка - число), и ветвь объединения с
	// минусом отвергалась как «ссылка рядом с примитивом».
	If StrStartsWith(Trimmed, "-") Then
		Return True;
	EndIf;

	// Вызов стоит и внутри ВЫБОР или ЕСТЬNULL, и тогда результат всего выражения тоже не
	// составной. Это важно именно для представления: модель объявляет ПРЕДСТАВЛЕНИЕССЫЛКИ
	// типом источника, а не результата - замерено, `['Catalog.Currencies', 'String']`
	// против `['String']` у ПРЕДСТАВЛЕНИЕ, - и без этой проверки отказ «колонка держит и
	// ссылку, и примитив» срабатывает ложно на значении, которое на самом деле строка.
	//
	// Если ни одна ветвь не даёт составного значения, его нет и у выражения. Ветви строго
	// короче целого, поэтому рекурсия конечна. Разбор стоит выше проверки на скобку:
	// ВЫБОР … КОНЕЦ скобкой не кончается.
	Branches = Undefined;
	Try
		Branches = ExpressionBranches(TrimAll(Text));
	Except
		Branches = Undefined;
	EndTry;
	If Branches <> Undefined And Branches.Arms.Count() > 0 Then
		If MixedLiteralArms(Branches) Or TypeValueBesideOtherKind(Branches) Then
			Return False;
		EndIf;
		For Each Arm In Branches.Arms Do
			If Not ResultIsNotComposite(Arm) Then
				Return False;
			EndIf;
		EndDo;
		If Not IsBlankString(Branches.Else_)
			And Not ResultIsNotComposite(Branches.Else_) Then
			Return False;
		EndIf;
		Return True;
	EndIf;

	// Литерал составным значением не бывает: это одно значение одного вида. Без этой
	// проверки `ЕСТЬNULL(ПРЕДСТАВЛЕНИЕССЫЛКИ(…), "")` оставался «составным» из-за второй
	// ветви. Отказ там, где он нужен, не ослабляется: ссылка рядом с литералом
	// по-прежнему делает выражение составным.
	If IsLiteralExpression(Trimmed) Then
		Return True;
	EndIf;

	If Not StrEndsWith(Trimmed, ")") Then
		Return False;
	EndIf;

	Open = StrFind(Trimmed, "(");
	If Open = 0 Then
		Return False;
	EndIf;

	Name = TrimAll(Left(Trimmed, Open - 1));
	// ТИП(…) - литерал типа, составным значением он не бывает.
	For Each Known In StrSplit("PRESENTATION,REFPRESENTATION,VALUETYPE,COUNT,TYPE,"
		+ Upper("Представление") + "," + Upper("ПредставлениеСсылки") + ","
		+ Upper("ТипЗначения") + "," + Upper("Количество") + "," + Upper("Тип"), ",", False) Do
		If Name = Known Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Колонка, в которой нет ничего, кроме НЕОПРЕДЕЛЕНО. Замерено 09.11.2026 (метки 9221,
// 9222, 9233): платформа выводит такую колонку одним тегом типа 0x01 - ни основной
// колонки значения, ни NULL. Признак берётся из модели: НЕОПРЕДЕЛЕНО в набор типов не
// входит вовсе, поэтому у колонки «только неопределено» типов ноль, а рядом со ссылкой
// или числом остаётся их тип, и тогда значение собирает разбор ветвей.
Function UndefinedOnlyColumn(Query, FieldIndex, Source)

	Word = Upper(TrimAll(Source));
	If Word <> "UNDEFINED" And Word <> Upper("Неопределено") Then
		Return False;
	EndIf;
	Columns = Undefined;
	Try
		Columns = Query.Columns;
	Except
		Return False;
	EndTry;
	If FieldIndex >= Columns.Count() Then
		Return False;
	EndIf;
	Count = 0;
	Try
		For Each Item In Columns[FieldIndex].ValueType.Types() Do
			If Item <> Type("Null") Then
				Count = Count + 1;
			EndIf;
		EndDo;
	Except
		Return False;
	EndTry;
	Return Count = 0;

EndFunction

// Колонки временной таблицы, которые держат только тег. Нужны тому, кто такую колонку
// читает: сравнение с НЕОПРЕДЕЛЕНО решается самой колонкой, а не константой (замер 9226).
// Колонка считается такой, когда литерал стоит в ней у каждой ветви объединения - иначе
// значение приходит и из другой ветви, и состав частей собирает разбор ветвей.
Function UndefinedOnlyColumns(Definition)

	Result = New Map;
	Columns = Undefined;
	Operators = Undefined;
	Try
		Columns = Definition.Columns;
		Operators = Definition.Operators;
	Except
		Return Result;
	EndTry;
	For Index = 0 To Columns.Count() - 1 Do
		Name = TrimAll(Columns[Index].Alias);
		If IsBlankString(Name) Then
			Continue;
		EndIf;
		Tagged = Operators.Count() > 0;
		For Each Operator In Operators Do
			If Index >= BranchFieldCount(Definition, Operator)
				Or Not UndefinedOnlyColumn(Definition, Index,
					ColumnFieldText(Definition, Operator, Index)) Then
				Tagged = False;
				Break;
			EndIf;
		EndDo;
		If Tagged Then
			Result.Insert(Upper(Name), Name);
		EndIf;
	EndDo;
	Return Result;

EndFunction

// Колонка временной таблицы, заполненная одним литералом НЕОПРЕДЕЛЕНО. Пустая строка,
// если это не она. Замеры 9226, 9241-9243: платформа сравнивает, группирует и соединяет
// по этой колонке, то есть значение в ней есть - тег 0x01.
Function TagOnlyColumnSql(Resolved, Context)

	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;
	Descriptor = Resolved.Descriptor;
	If Descriptor = Undefined Or Not Descriptor.Property("TagOnly")
		Or Descriptor.TagOnly = Undefined Then
		Return "";
	EndIf;
	Canonical = Descriptor.TagOnly.Get(Upper(TrimAll(Resolved.FieldName)));
	If Canonical = Undefined Then
		Return "";
	EndIf;
	// Поле надо пометить использованным, иначе временная таблица соберётся без него -
	// так же, как это делает CompositeInfo для подколонок.
	If Descriptor.Property("Used") And Descriptor.Used <> Undefined Then
		Descriptor.Used.Insert(Upper(Canonical), True);
	EndIf;
	Return FieldColumn(Descriptor, Resolved.Alias, Canonical, Context);

EndFunction

// МИНИМУМ/МАКСИМУМ верхним уровнем колонки, которая выводится частями, над ВЫБОР или ЕСТЬNULL из
// одних ссылок нескольких типов, без НЕОПРЕДЕЛЕНО в ветвях.
Function BranchedReferenceAggregate(Query, FieldIndex, Original, PartSuffixes)

	If PartSuffixes = Undefined Or Query.Operators.Count() <> 1 Or FieldIndex >= Query.Columns.Count()
		Or IsBlankString(TopLevelAggregate(Original)) Or Not BranchedAggregateArgument(Original)
		Or Not IsBlankString(UndefinedAggregateArgument(Original)) Then
		Return False;
	EndIf;
	If PartSuffixes.Get(Upper(TrimAll(Query.Columns[FieldIndex].Alias))) = Undefined Then
		Return False;
	EndIf;
	Mix = DeclaredTypeMix(Query.Columns[FieldIndex]);
	Return Mix.References > 1 And Mix.Primitives = 0;

EndFunction

// МИНИМУМ/МАКСИМУМ с НЕОПРЕДЕЛЕНО в аргументе стоит верхним уровнем колонки, у колонки есть
// состав частей, и формула платформы над частями аргумента строится.
Function UndefinedAggregateByParts(Query, Operator, FieldIndex, Original, PartSuffixes, Context)

	If PartSuffixes = Undefined Or Query.Operators.Count() <> 1 Or FieldIndex >= Query.Columns.Count()
		Or IsBlankString(TopLevelAggregate(Original)) Or Not BranchedAggregateArgument(Original) Then
		Return False;
	EndIf;
	If PartSuffixes.Get(Upper(TrimAll(Query.Columns[FieldIndex].Alias))) = Undefined Then
		Return False;
	EndIf;
	Copy = Original;
	Parts = Undefined;
	Try
		Parts = BranchedAggregateParts(Copy, Context, True, DeclaredTypeMix(Query.Columns[FieldIndex]).References);
	Except
		Parts = Undefined;
	EndTry;
	Return Parts <> Undefined;

EndFunction

// Аргумент МИНИМУМ/МАКСИМУМ, ветви которого дают и НЕОПРЕДЕЛЕНО, и значение. Пустая
// строка - такого агрегата в выражении нет.
Function UndefinedAggregateArgument(Text)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Text));
	Except
		Return "";
	EndTry;
	For Index = 0 To Tokens.Count() - 2 Do
		If Tokens[Index].Kind <> "Name" Or Tokens[Index + 1].Value <> "(" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Index].Value);
		If Word <> "MIN" And Word <> "MAX" And Word <> Upper("Минимум") And Word <> Upper("Максимум") Then
			Continue;
		EndIf;
		Close = MatchingParen(Tokens, Index + 1);
		If Close = Undefined Or Close >= Tokens.Count() Or Tokens[Close].Value <> ")" Then
			Continue;
		EndIf;
		First = Index + 2;
		If First < Close And (Upper(Tokens[First].Value) = "DISTINCT"
			Or Upper(Tokens[First].Value) = Upper("Различные")) Then
			First = First + 1;
		EndIf;
		If First > Close - 1 Then
			Continue;
		EndIf;
		Argument = TokensText(Tokens, First, Close - 1);
		Kinds = New Structure("Undefined, Value", False, False);
		NoteArmKinds(Argument, Kinds);
		If Kinds.Undefined And Kinds.Value Then
			Return Argument;
		EndIf;
	EndDo;
	Return "";

EndFunction

// Первый параметр выражения, значение которого не передано; пустая строка - таких нет. Вид
// значения параметра решает, из каких частей платформа собирает колонку (замер ветви-параметра
// 13.11.2026: вид ветви - вид значения), а ВЫБОР по булеву параметру она сворачивает до СУБД
// (17.11.2026), поэтому без значения части не строятся, а со значением строятся.
//
// Считается параметр, стоящий ветвью целиком (значение колонки) или условием целиком (`КОГДА &Флаг`,
// `КОГДА НЕ &Флаг`). Параметр внутри сравнения не считается: такое условие платформа не сворачивает
// (замер 15.11.2026, строковый параметр), и его значение состава частей не меняет.
Function ParameterWithoutValue(Text, Context)

	Values = Undefined;
	If Context <> Undefined And Context.Options.Property("ParameterValues")
		And TypeOf(Context.Options.ParameterValues) = Type("Map") Then
		Values = Context.Options.ParameterValues;
	EndIf;
	Trimmed = TrimAll(Text);
	Name = LoneParameterName(Trimmed);
	If Not IsBlankString(Name) Then
		Return ?(Values = Undefined Or Values.Get(Name) = Undefined, Name, "");
	EndIf;
	// Колонка временной таблицы, наполненная параметром (`ВЫБРАТЬ &П КАК К ПОМЕСТИТЬ ВТ`): её тип -
	// тип значения параметра (замеры qb2, qb2s, 21.11.2026, УХ: ссылка в параметре - колонка `RRef`,
	// тег и идентификатор таблицы документа в выражениях над ней).
	Placed = PlacedParameterWithoutValue(Trimmed, Context, Values);
	If Not IsBlankString(Placed) Then
		Return Placed;
	EndIf;
	Branches = Undefined;
	Try
		Branches = ExpressionBranches(Trimmed);
	Except
		Branches = Undefined;
	EndTry;
	If Branches = Undefined Then
		Return "";
	EndIf;
	If Branches.Kind <> "ISNULL" Then
		For Each Condition In Branches.Conditions Do
			Bare = TrimAll(Condition);
			If StrStartsWith(Upper(Bare), "NOT ") Or StrStartsWith(Upper(Bare), Upper("Не ")) Then
				Bare = TrimAll(Mid(Bare, StrFind(Bare, " ") + 1));
			EndIf;
			Name = LoneParameterName(Bare);
			If Not IsBlankString(Name) And (Values = Undefined Or Values.Get(Name) = Undefined) Then
				Return Name;
			EndIf;
		EndDo;
	EndIf;
	For Each Arm In Branches.Arms Do
		Found = ParameterWithoutValue(Arm, Context);
		If Not IsBlankString(Found) Then
			Return Found;
		EndIf;
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		Return ParameterWithoutValue(Branches.Else_, Context);
	EndIf;
	Return "";

EndFunction

// Параметр без значения, которым наполнена колонка временной таблицы по пути Path. Пустая строка -
// путь не такой или значение передано.
Function PlacedParameterWithoutValue(Path, Context, Values)

	If Context = Undefined Then
		Return "";
	EndIf;
	Trimmed = TrimAll(Path);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrSplit(Trimmed, ".", False).Count() <> 2 Then
		Return "";
	EndIf;
	Try
		Resolved = ResolveField(Trimmed, Context);
		Descriptor = Resolved.Descriptor;
		If Descriptor = Undefined Or Not Descriptor.IsDerived Or Not Descriptor.Property("NumericSource")
			Or Descriptor.NumericSource = Undefined Then
			Return "";
		EndIf;
		Definition = Descriptor.NumericSource.Definition;
		Wanted = Upper(TrimAll(Resolved.FieldName));
		For Index = 0 To Definition.Columns.Count() - 1 Do
			If Upper(TrimAll(Definition.Columns[Index].Alias)) <> Wanted Then
				Continue;
			EndIf;
			For Each Operator In Definition.Operators Do
				If Index >= BranchFieldCount(Definition, Operator) Then
					Continue;
				EndIf;
				Name = LoneParameterName(TrimAll(ColumnFieldText(Definition, Operator, Index)));
				If Not IsBlankString(Name) And (Values = Undefined Or Values.Get(Name) = Undefined) Then
					Return Name;
				EndIf;
			EndDo;
		EndDo;
	Except
		Return "";
	EndTry;
	Return "";

EndFunction

// Текст отказа для колонки Name, значение которой зависит от параметра Parameter без значения.
Function ParameterKindRefusal(Name, Parameter)

	Return StrTemplate(
		"Column %1 is built from values of different kinds, and one of them comes from parameter &%2,"
		+ " whose value is not given. The platform types such a column by the value of the parameter (a"
		+ " reference, a string, a number - each gets its own type tag and part; a CASE over a boolean"
		+ " parameter is folded before the DBMS), so without the value the parts of the column cannot be"
		+ " built, and a single SQL column would turn one kind into another silently. Give the parameters"
		+ " of this expression their values (ParameterValues) and translate again.", Name, Parameter);

EndFunction

// Что дают ветви выражения: НЕОПРЕДЕЛЕНО (Kinds.Undefined) и значение (Kinds.Value).
// NULL и недостающее ИНАЧЕ значения не дают.
Procedure NoteArmKinds(Text, Kinds)

	If Upper(TrimAll(Text)) = "NULL" Then
		Return;
	EndIf;
	If IsUndefinedLiteralText(Text) Then
		Kinds.Undefined = True;
		Return;
	EndIf;
	Branches = Undefined;
	Try
		Branches = ExpressionBranches(TrimAll(Text));
	Except
		Branches = Undefined;
	EndTry;
	If Branches = Undefined Then
		Kinds.Value = True;
		Return;
	EndIf;
	For Each Arm In Branches.Arms Do
		NoteArmKinds(Arm, Kinds);
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		NoteArmKinds(Branches.Else_, Kinds);
	EndIf;

EndProcedure

// Поле выборки, у которого частей нет, а значение одной колонкой не выражается.
//
// ЕСТЬNULL(a, b) с аргументами разных видов: модель объявляет оба типа (булево из
// вложенного запроса и число - полная сверка УХ 14.11.2026: 1С Ложь, SQL 0), а
// CheckNullFallbackKinds вид колонки вложенного запроса не видит. COALESCE(binary(1), 0)
// СУБД приводит к числу молча.
//
// ВЫБОР или ЕСТЬNULL с ветвью НЕОПРЕДЕЛЕНО рядом со значением: без частей литерал
// НЕОПРЕДЕЛЕНО уходит в NULL, и строка, где платформа отдаёт НЕОПРЕДЕЛЕНО (тег 0x01),
// приходит пустой - молча (полная сверка УХ 14.11.2026: ЕСТЬNULL(x, НЕОПРЕДЕЛЕНО) над
// колонкой временной таблицы, ВЫРАЗИТЬ(…).Поле с ИНАЧЕ НЕОПРЕДЕЛЕНО). Проверка там, где
// части вообще выводятся (PartSuffixes есть): у колонки только из НЕОПРЕДЕЛЕНО типов нет,
// её закрывает UndefinedOnlyColumn.
Procedure CheckFieldWithoutParts(Original, Column, PartSuffixes, Context = Undefined)

	Name = TrimAll(Column.Alias);
	If PartSuffixes <> Undefined And PartSuffixes.Get(Upper(Name)) <> Undefined Then
		Return;
	EndIf;
	Branches = Undefined;
	Try
		Branches = ExpressionBranches(TrimAll(Original));
	Except
		Return;
	EndTry;
	If Branches = Undefined Then
		Return;
	EndIf;
	Condition = False;
	Try
		Condition = IsConditionExpression(Original);
	Except
		Condition = False;
	EndTry;
	If Condition Then
		Return;
	EndIf;
	Mix = DeclaredTypeMix(Column);

	If Branches.Kind = "ISNULL" And Branches.Arms.Count() = 2 And Mix.Primitives > 1 Then
		Second = Branches.Arms[1];
		If Not IsEmptyTextLiteral(Second) And Upper(TrimAll(Second)) <> "NULL"
			And Not IsUndefinedLiteralText(Second) Then
			Missing = ParameterWithoutValue(Original, Context);
			If Not IsBlankString(Missing) Then
				Raise ParameterKindRefusal(Name, Missing);
			EndIf;
			Raise StrTemplate("ISNULL(%1, %2) mixes values of different kinds. The platform returns"
				+ " such a value as a composite one, of the kind of whichever argument it came from,"
				+ " and this translation builds a single column that converts one kind into the"
				+ " other. Cast both arguments to one type with CAST.",
				TrimAll(Branches.Arms[0]), TrimAll(Second));
		EndIf;
	EndIf;

	// Ветвь - колонка временной таблицы, которая держит части (там НЕОПРЕДЕЛЕНО рядом со
	// ссылкой). Без частей здесь от неё остаётся основная колонка, а в ней на месте
	// НЕОПРЕДЕЛЕНО - NULL (полная сверка УХ 14.11.2026: ЕСТЬNULL(Обороты.Н, Способы.Н), где
	// Способы.Н = ЕСТЬNULL(…, НЕОПРЕДЕЛЕНО), - 1С НЕОПРЕДЕЛЕНО, SQL NULL).
	If PartSuffixes <> Undefined And Context <> Undefined And Branches.Kind = "ISNULL" Then
		Arms = New Array;
		For Each Arm In Branches.Arms Do
			Arms.Add(Arm);
		EndDo;
		If Not IsBlankString(Branches.Else_) Then
			Arms.Add(Branches.Else_);
		EndIf;
		For Each Arm In Arms Do
			Trimmed = TrimAll(Arm);
			If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
				Continue;
			EndIf;
			Resolved = Undefined;
			Try
				Resolved = ResolveField(Trimmed, Context);
			Except
				Continue;
			EndTry;
			If Resolved.Descriptor.IsDerived And IsBlankString(Resolved.CompositeSegment)
				And CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
				Raise StrTemplate(
					"Column %1 is computed over %2, a column that carries its value in parts (a type tag"
					+ " and the value columns), and the result has no parts of its own here: only the"
					+ " base column of %2 would be used, and where it holds UNDEFINED or a value of"
					+ " another type the result would come back as NULL or as foreign bytes - silently."
					+ " Select %2 as a column of its own, or narrow it to one type with CAST.",
					Name, Trimmed);
			EndIf;
		EndDo;
	EndIf;

	If PartSuffixes <> Undefined And Mix.References + Mix.Primitives > 0
		And BranchCarriesUndefined(Original) Then
		Missing = ParameterWithoutValue(Original, Context);
		If Not IsBlankString(Missing) Then
			Raise ParameterKindRefusal(Name, Missing);
		EndIf;
		Raise StrTemplate(
			"Column %1 puts UNDEFINED beside a value, and the parts of that value cannot be built"
			+ " here: the type of the other branch is not known statically. The platform returns"
			+ " UNDEFINED as a value of its own (type tag 0x01); a single SQL column can only hold"
			+ " NULL in its place, so those rows would come back empty - silently. Use NULL instead"
			+ " of UNDEFINED if an empty value is what is meant, or narrow the branch to a field of"
			+ " a known type.", Name);
	EndIf;

EndProcedure

Function SelectedFieldsSql(Operator, Query, Context, IsFirstOperator)

	Nested = NestedTableColumns(Query, Context);
	WithAliases = IsFirstOperator Or AliasEveryOperator(Query);
	Context.Insert("OutputNames", New Array);

	// Состав частей общий для всех колонок и для всех ветвей, поэтому считается один
	// раз на запрос - в QuerySql. Запрос без ПОМЕСТИТЬ по имени не кешируется, а расчёт
	// обходит источники каждой ветви пробным контекстом: на колонку это обходило бы их
	// заново, на ветвь - удваивало сбор источников.
	PartSuffixes = Context.PartSuffixes;
	If PartSuffixes = Undefined
		And (Not IsBlankString(Query.PlacementTable) Or Context.ExposeCompositeParts) Then
		PartSuffixes = PlacementPartSuffixes(Query, Context);
	EndIf;

	Parts = New Array;
	For FieldIndex = 0 To BranchFieldCount(Query, Operator) - 1 Do
		If Nested.Get(FieldIndex) <> Undefined Then
			Continue;
		EndIf;
		Mark = Context.CompositeColumns.Count();
		Source = ColumnFieldText(Query, Operator, FieldIndex);
		// Параметры в BSL передаются по ссылке, и разбор выражения перезаписывает
		// переданный текст. Исходный текст поля нужен ниже, поэтому он сохраняется.
		Original = Source;

		Aggregated = CompositeAggregateField(Original, Context);
		AggregatedRef = AggregatedCompositeRef(Original, Context);
		AggregatedParts = AggregatedCompositeParts(Original, Context, True);
		If AggregatedParts <> Undefined And AggregatedParts.Get("_RRRef") <> Undefined Then
			AggregatedRef = AggregatedParts.Get("_RRRef");
		EndIf;
		If AggregatedParts = Undefined And BranchedReferenceAggregate(Query, FieldIndex, Original, PartSuffixes) Then
			// Ссылки нескольких типов по ветвям: базовая колонка - ссылка из SUBSTRING(MAX(_RTRef + _RRRef), 5, 16),
			// а не максимум байтов ссылки (замер mk_mmcase_1, mk_mmisn_1, 20.11.2026, УХ).
			Copy = Original;
			Try
				AggregatedParts = BranchedAggregateParts(Copy, Context, False,
					DeclaredTypeMix(Query.Columns[FieldIndex]).References);
			Except
				AggregatedParts = Undefined;
			EndTry;
			If AggregatedParts <> Undefined And AggregatedParts.Get("_RRRef") <> Undefined Then
				AggregatedRef = AggregatedParts.Get("_RRRef");
			EndIf;
		EndIf;
		If Not IsBlankString(Aggregated) And IsBlankString(AggregatedRef) And AggregatedParts = Undefined Then
			Raise StrTemplate(
				"MAX or MIN over the composite field %1 cannot be translated. The platform"
				+ " compares the type tag first and the reference bytes second, over several"
				+ " stored columns at once, so a maximum over the reference column alone"
				+ " returns a different row - and it would do so silently. Narrow the field"
				+ " to a single type with CAST(%1 AS <type>), or group by the field instead"
				+ " of aggregating it.", Aggregated);
		EndIf;

		// В 1С сравнение - это значение типа Булево, и его спокойно кладут в список
		// выборки. В T-SQL булева типа нет, поэтому условие превращается в ВЫБОР.
		Counted = CompositeDistinctCountField(Original, Context);
		If Not IsBlankString(Counted) Then
			Raise StrTemplate(
				"COUNT of distinct values of the composite field %1 cannot be translated."
				+ " A composite value lives in several stored columns - the type tag, the table"
				+ " id and the reference - and COUNT(DISTINCT …) in T-SQL takes one expression."
				+ " Counting the reference column alone returns a SMALLER number: values of"
				+ " different types sharing a uuid merge into one. Narrow the field to a single"
				+ " type with CAST(%1 AS <type>), or count distinct over the parts yourself.",
				Counted);
		EndIf;

		WithUndefined = UndefinedAggregateArgument(Original);
		If Not IsBlankString(WithUndefined) And UndefinedAggregateByParts(Query, Operator, FieldIndex, Original,
			PartSuffixes, Context) Then
			// Агрегат верхним уровнем колонки, которая выводится частями: тег сравнивается первым
			// и здесь, по формуле платформы (BranchedAggregateParts, замер aggu a1-a7).
			WithUndefined = "";
		EndIf;
		If Not IsBlankString(WithUndefined) Then
			// Замерено 14.11.2026 (УХ, probe33.py): над пятью ссылками и
			// НЕОПРЕДЕЛЕНО МИНИМУМ даёт НЕОПРЕДЕЛЕНО, МАКСИМУМ - ссылку: тег сравнивается
			// первым. В SQL НЕОПРЕДЕЛЕНО вне частей - NULL, и агрегат его пропускает.
			Raise StrTemplate(
				"MAX or MIN over %1 cannot be translated: the argument is UNDEFINED in some rows and a"
				+ " value in others. The platform compares the type tag first, so MIN returns UNDEFINED"
				+ " as soon as one row holds it, and MAX returns the value; in SQL UNDEFINED outside"
				+ " the parts of a value is NULL, and the aggregate skips it - the result would differ"
				+ " silently. Aggregate the value without UNDEFINED, or check for it separately.",
				WithUndefined);
		EndIf;

		// Выражение, по которому упорядочен результат, платформа пишет с литералами в тексте, как
		// в операторе с группировкой: ВЫБОР ... ТОГДА 1 ИНАЧЕ 99 КОНЕЦ КАК П ... УПОРЯДОЧИТЬ ПО П -
		// `THEN 1.0 ELSE 99.0`, NUMERIC(3, 1) (замер 44870; без порядка - параметры NUMERIC(10)).
		SavedInline = Context.LiteralsInline;
		If OrderedColumn(Query, FieldIndex) Then
			Context.LiteralsInline = True;
		EndIf;
		// Колонка-ВЫБОР из литералов разных видов уходит частями (MixedLiteralArms); базовой колонки у
		// неё в итоговом результате нет, и проверка видов ветвей здесь не к месту.
		Context.Insert("MixedLiteralParts", Context.FinalResult And PartSuffixes <> Undefined
			And FieldIndex < Query.Columns.Count() And PartSuffixes.Get(Upper(TrimAll(Query.Columns[FieldIndex].Alias))) <> Undefined);
		// ЕСТЬNULL над значениями разных видов, которое уходит частями (BranchedCompositeParts): базовой
		// колонки у него нет ни в итоговом результате, ни во временной таблице (PartsOnlyPlacement), и
		// проверка видов аргументов при её переводе не к месту. Замеры mk_isnbool_1, 2, mk_isnnum_1
		// (20.11.2026, УХ): `ЕСТЬNULL(булево, 0)`, `ЕСТЬNULL(число, строка)` - тег, часть каждого вида;
		// хранилище рядом с литералом - 9451-9455.
		Context.Insert("PartsCarryValue", FieldIndex < Query.Columns.Count()
			And ((Context.FinalResult And MixedKindParts(PartSuffixes, Query.Columns[FieldIndex].Alias))
				Or PartsOnlyPlacement(Query, FieldIndex, Original, PartSuffixes, Context)));
		// МоментВремени колонкой: дата под именем колонки, таблица и ссылка - колонками-спутниками ниже.
		// Через FieldValue такое поле не идёт - там отказ. Колонка, объявленная моментом времени, обязана
		// получить спутники в каждой ветви объединения (иначе у ветвей разойдётся число колонок) и в
		// запросе временной таблицы или вложенном (иначе читающий запрос обратится к колонкам, которых
		// нет: `&Момент КАК М ПОМЕСТИТЬ ВТ` - Invalid column name). Ветвь объединения с голым NULL -
		// NULL во всех трёх колонках.
		PitParts = Undefined;
		PitNull = False;
		If FieldIndex < Query.Columns.Count() Then
			PitText = Original;
			PitParts = PointInTimeParts(PitText, Context);
			If PitParts = Undefined And ColumnIsPointInTime(Query, FieldIndex) Then
				If Query.Operators.Count() > 1 And Upper(TrimAll(Original)) = "NULL" Then
					PitNull = True;
				ElsIf Query.Operators.Count() > 1 Or Not Context.FinalResult
					Or Not IsBlankString(Query.PlacementTable) Then
					Raise StrTemplate(
						"Column %1 is a point in time, and it is filled with %2 here - in a branch of a union, a"
						+ " temporary table or a subquery. A point in time is a pair - the date and the reference -"
						+ " kept in several columns, and they are built only for a field of a document, of an"
						+ " accumulation or accounting register or of another such column; a parameter or an"
						+ " expression leaves the reference columns out, and whoever reads the column would not"
						+ " find them. Select the date and the reference as columns of their own.",
						TrimAll(Query.Columns[FieldIndex].Alias), TrimAll(Original));
				EndIf;
			EndIf;
		EndIf;
		If PitParts = Undefined Then
			Try
				Expression = ValueExpression(Source, Context);
			Except
				// Реквизит разного вида за составной ссылкой одной колонкой не выражается, и здесь она
				// не нужна: в итоговом запросе базовая колонка разнотипного значения не выводится, во
				// временной таблице и подзапросе на её месте заглушка (PartsOnlyPlacement) - значение
				// идёт частями (NavigatedCompositeParts). В прочих местах отказ остаётся.
				If StrFind(ErrorDescription(), "is of different kinds in its types") = 0
					Or FieldIndex >= Query.Columns.Count()
					Or Not MixedKindParts(PartSuffixes, Query.Columns[FieldIndex].Alias)
					Or Not (Context.FinalResult
						Or PartsOnlyPlacement(Query, FieldIndex, Original, PartSuffixes, Context)) Then
					Raise;
				EndIf;
				Expression = "NULL";
			EndTry;
		Else
			Expression = PitParts.DatePart;
			AddOnce(Context.Warnings, StrTemplate(
				"Column %1 is a point in time. It comes back as three columns: %1 holds the date, %1_RTRef the"
				+ " table of the reference and %1_RRRef the reference; the platform builds the value from them"
				+ " after reading.", TrimAll(Query.Columns[FieldIndex].Alias)));
		EndIf;
		Context.MixedLiteralParts = False;
		Context.PartsCarryValue = False;
		Context.LiteralsInline = SavedInline;
		DistinctParts = CompositeDistinctCountSql(Original, Context);
		// `-КОЛИЧЕСТВО(РАЗЛИЧНЫЕ <составное>)` - то же количество по всем частям, со знаком: ветвь
		// объединения в УХ (ФормаВыбораОрдераПриРазбиении). По одной колонке ссылки счёт меньше.
		NegatedText = TrimAll(Original);
		If IsBlankString(DistinctParts) And StrStartsWith(NegatedText, "-") Then
			NegatedText = TrimAll(Mid(NegatedText, 2));
			NegatedTokens = Tokenize(NegatedText);
			If NegatedTokens.Count() > 3 And NegatedTokens[0].Kind = "Name" And NegatedTokens[1].Value = "("
				And MatchingParen(NegatedTokens, 1) = NegatedTokens.Count() - 1 Then
				NegatedCount = CompositeDistinctCountSql(NegatedText, Context);
				If Not IsBlankString(NegatedCount) Then
					DistinctParts = "-" + NegatedCount;
				EndIf;
			EndIf;
		EndIf;
		If Not IsBlankString(DistinctParts) Then
			Expression = DistinctParts;
		EndIf;
		If Not IsBlankString(AggregatedRef) Then
			Expression = AggregatedRef;
		EndIf;
		If UndefinedOnlyColumn(Query, FieldIndex, Original) Then
			// Значение есть, и оно не NULL, а тег типа. Прежде колонка уезжала как NULL, и
			// всё, что её читает - сравнение, группировка, соединение, - отвечало иначе, чем
			// платформа, молча и на любых данных.
			Expression = BinaryLiteral("01", Context);
		EndIf;

		Info = New Structure;
		Info.Insert("Expression", Expression);
		Info.Insert("Name", ?(FieldIndex < Query.Columns.Count(), TrimAll(Query.Columns[FieldIndex].Alias), ""));
		Info.Insert("Aggregate", False);
		// Ключ выражения - по нему поле узнаёт себя в группировках текста запроса.
		// Считается только при надобности: группировок, потерянных моделью, обычно нет.
		Info.Insert("Branching", "");
		If Context.Options.Property("BranchingGroups") And Context.Options.BranchingGroups <> Undefined
			And Context.Options.BranchingGroups.Count() > 0 Then
			FieldKey = ExpressionKey(Original);
			If Context.Options.BranchingGroups.Get(FieldKey) <> Undefined Then
				Info.Branching = FieldKey;
			EndIf;
		EndIf;
		Try
			Field = ColumnField(Query, Operator, FieldIndex);
			Info.Aggregate = Field <> Undefined And Field.ContainsAggregateFunction();
		Except
			// Полем выборки бывает не выражение, а звёздочка или описание таблицы.
		EndTry;
		Info.Insert("Columns", ColumnsOfExpression(Context, Mark, Info.Expression));
		Context.SelectedInfo.Add(Info);

		// Литерал колонкой платформа передаёт параметром в типе по значению, и в выборке с
		// группировкой тоже (замеры 43100-43103): 0 - NUMERIC(10, 0), 1.5 - NUMERIC(38, 8).
		If Context.Options.Dialect <> "PostgreSQL" And IsBlankString(Query.PlacementTable) And BareNumberText(Original) Then
			Saved = Context.LiteralsInline;
			Context.LiteralsInline = False;
			Literal = ParameterLiteralSql(StrReplace(TrimAll(Original), " ", ""), Context);
			Context.LiteralsInline = Saved;
			UnionType = UnionLiteralNumberType(Query, FieldIndex, Context, Original);
			If Not IsBlankString(UnionType) Then
				Expression = "CAST(" + Expression + " AS " + UnionType + ")";
			ElsIf StrStartsWith(Literal, "CAST(") Then
				Expression = "CAST(" + Expression + Mid(Literal, StrFind(Literal, " AS "));
			EndIf;
		EndIf;
		If Not IsBlankString(Query.PlacementTable) And FieldIndex < Query.Columns.Count() Then
			Expression = PlacedQuotientSql(Expression, Original, Query.Columns[FieldIndex].ValueType, Context,
				Query, FieldIndex);
			Expression = PlacedSmallNumberSql(Expression, Original, Query.Columns[FieldIndex].ValueType, Context);
		ElsIf Query.Operators.Count() > 1 And FieldIndex < Query.Columns.Count() Then
			Expression = UnionQuotientSql(Expression, Original, Query, FieldIndex, Context);
		EndIf;

		If WithAliases And FieldIndex < Query.Columns.Count() Then
			Expression = Expression + " AS " + QuoteIdentifier(Query.Columns[FieldIndex].Alias, Context);
		EndIf;

		// Главной колонки значения у разнотипного составного не существует: в одной колонке
		// SQL не держит и ссылку, и строку - MS SQL отказывается приводить nvarchar к binary,
		// а там, где приведение проходит молча (число, дата), значение подменяется. Платформа
		// такую колонку и не выводит: замеры 9900-9904 дают только части. Решение принимается
		// по объявленному составу ролей - он общий для всех ветвей объединения, иначе у
		// ветвей разошлось бы число колонок.
		//
		// Только в итоговом запросе. У ПОМЕСТИТЬ колонку бросать нельзя: следующие запросы
		// пакета обращаются к ней по имени, и без неё они перестают связываться - проверено
		// прогоном, 8 запросов ERP.
		If Context.FinalResult And FieldIndex < Query.Columns.Count()
			And MixedKindParts(PartSuffixes, Query.Columns[FieldIndex].Alias) Then
			AddOnce(Context.Warnings, StrTemplate(
				"Column %1 holds values of different kinds - a reference beside a string, a number"
				+ " or a date - and SQL has no type that holds both, so the column itself is not"
				+ " returned. The value comes back through its parts: read %1_TYPE first, it says"
				+ " which part holds the value.", TrimAll(Query.Columns[FieldIndex].Alias)));
			If Context.OmittedBase.Find(Info.Expression) = Undefined Then
				Context.OmittedBase.Add(Info.Expression);
			EndIf;
		ElsIf Context.FinalResult And FieldIndex < Query.Columns.Count()
			And Not IsBlankString(UndefinedAggregateArgument(Original))
			And UndefinedAggregateByParts(Query, Operator, FieldIndex, Original, PartSuffixes, Context) Then
			// МИНИМУМ/МАКСИМУМ над значением рядом с НЕОПРЕДЕЛЕНО: платформа выводит только части
			// (замер aggu a1-a7), а базовая колонка без тега отдала бы у МИНИМУМ значение там,
			// где результат - НЕОПРЕДЕЛЕНО.
			AddOnce(Context.Warnings, StrTemplate(
				"Column %1 is a minimum or maximum over a value that is UNDEFINED in some rows, so the"
				+ " column itself is not returned. The value comes back through its parts: read %1_TYPE"
				+ " first - 0x01 means UNDEFINED, otherwise it says which part holds the value.",
				TrimAll(Query.Columns[FieldIndex].Alias)));
			If Context.OmittedBase.Find(Info.Expression) = Undefined Then
				Context.OmittedBase.Add(Info.Expression);
			EndIf;
		ElsIf PartsOnlyPlacement(Query, FieldIndex, Original, PartSuffixes, Context) Then
			// Временная таблица и подзапрос: платформа кладёт туда только части, без базовой
			// колонки (замерено 9867, 9870, ERP WE), и читает их по частям (9869, 9870). Колонку
			// по имени здесь оставить надо - к ней обращаются следующие запросы, - но значения в
			// ней нет: NULL, одинаковый у всех строк, поэтому РАЗЛИЧНЫЕ, группировка и порядок
			// идут по частям. Чтение мимо частей перевод отвергает (PartsOnlyRefusal).
			If Context.Options.Property("PartsOnlyStubs") Then
				Context.Options.PartsOnlyStubs.Insert(Upper(TrimAll(Query.Columns[FieldIndex].Alias)),
					TrimAll(Query.Columns[FieldIndex].Alias));
			EndIf;
			If Context.Options.Property("PartsOnlyStubQueries") Then
				StubColumns = Context.Options.PartsOnlyStubQueries.Get(Query);
				If StubColumns <> Undefined Then
					StubColumns.Insert(Upper(TrimAll(Query.Columns[FieldIndex].Alias)), True);
				EndIf;
			EndIf;
			Parts.Add("  NULL" + ?(WithAliases,
				" AS " + QuoteIdentifier(Query.Columns[FieldIndex].Alias, Context), ""));
			If FieldIndex < Query.Columns.Count() Then
				Context.OutputNames.Add(QuoteIdentifier(Query.Columns[FieldIndex].Alias, Context));
			EndIf;
		Else
			Parts.Add("  " + Expression);
			If FieldIndex < Query.Columns.Count() Then
				Context.OutputNames.Add(QuoteIdentifier(Query.Columns[FieldIndex].Alias, Context));
			EndIf;
		EndIf;
		If PitParts <> Undefined Then
			// Таблица и ссылка момента времени - сразу за датой, в порядке платформы (ptp9:
			// `T1._Date_Time, 0x000002D7, T1._IDRRef`; ptp1: `_Period, _RecorderTRef, _RecorderRRef`).
			// Имена - по образцу частей составного значения; их же читает PointInTimeParts у колонки
			// временной таблицы. В GROUP BY (группировка, РАЗЛИЧНЫЕ с порядком) спутники попадают через
			// PlacementParts, как части составного; таблица-литерал туда не идёт.
			PitName = TrimAll(Query.Columns[FieldIndex].Alias);
			For Each PitSuffix In StrSplit("_RTRef,_RRRef", ",", False) Do
				PitPiece = ?(PitSuffix = "_RTRef", PitParts.TablePart, PitParts.ReferencePart);
				Parts.Add("  " + PitPiece + ?(WithAliases, " AS " + QuoteIdentifier(PitName + PitSuffix, Context), ""));
				Context.OutputNames.Add(QuoteIdentifier(PitName + PitSuffix, Context));
				If Not (PitSuffix = "_RTRef" And PitParts.TableConstant)
					And Context.PlacementParts.Find(PitPiece) = Undefined Then
					Context.PlacementParts.Add(PitPiece);
				EndIf;
			EndDo;
		ElsIf PitNull Then
			// Ветвь объединения - голый NULL: значения нет, NULL в обеих колонках-спутниках. Тип задан
			// явно: голый NULL в первой ветви дал бы колонке объединения тип int.
			PitName = TrimAll(Query.Columns[FieldIndex].Alias);
			For Each PitSuffix In StrSplit("_RTRef,_RRRef", ",", False) Do
				PitPiece = "CAST(NULL AS " + ?(Context.Options.Dialect = "PostgreSQL", "BYTEA",
					?(PitSuffix = "_RTRef", "BINARY(4)", "BINARY(16)")) + ")";
				Parts.Add("  " + PitPiece + ?(WithAliases, " AS " + QuoteIdentifier(PitName + PitSuffix, Context), ""));
				Context.OutputNames.Add(QuoteIdentifier(PitName + PitSuffix, Context));
			EndDo;
		EndIf;

		If FieldIndex < Query.Columns.Count() Then
			CheckFieldWithoutParts(Original, Query.Columns[FieldIndex], PartSuffixes, Context);
		EndIf;

		// В запросе, наполняющем временную таблицу, составное поле выносится целиком.
		// Состав подколонок общий для всех ветвей объединения: ветвь, у которой такой
		// подколонки нет, отдаёт NULL, иначе у ветвей разошлось бы число колонок.
		If FieldIndex < Query.Columns.Count() And PartSuffixes <> Undefined Then

			Name = TrimAll(Query.Columns[FieldIndex].Alias);
			Suffixes = PartSuffixes.Get(Upper(Name));

			If Suffixes = Undefined And IsCompositeDeclaredType(Query.Columns[FieldIndex])
				And Not ResultIsNotComposite(Original) And Not CountColumnPath(Original, Context) Then

				Mix = DeclaredTypeMix(Query.Columns[FieldIndex]);
				If Mix.References > 0 And Mix.Primitives > 0 Then
					// Одна колонка не вмещает и ссылку, и примитив: MS SQL приводит её к одному
					// типу, и замерено, что ссылка рядом со строкой возвращается как nvarchar(16),
					// рядом с числом как int - шестнадцать байт ссылки превращаются в мусор без
					// ошибки. Платформа собирает каждую часть своим ВЫБОРом (замеры 9900-9904).
					// Выдать похожее, но другое - худший исход, поэтому отказ.
					Missing = ParameterWithoutValue(Original, Context);
					If Not IsBlankString(Missing) Then
						Raise ParameterKindRefusal(Name, Missing);
					EndIf;
					BinaryKind = "";
					Try
						Declared = Query.Columns[FieldIndex].ValueType;
						BinaryKind = ?(Declared.ContainsType(Type("Type")), "a type",
							?(Declared.ContainsType(Type("UUID")), "a UUID",
							?(Declared.ContainsType(Type("ValueStorage")), "a value storage", "")));
					Except
						BinaryKind = "";
					EndTry;
					Squeezed = Upper(StrReplace(StrReplace(StrReplace(Original, " ", ""), Chars.LF, ""), Chars.Tab, ""));
					If IsBlankString(BinaryKind) And (StrFind(Squeezed, Upper("Представление(")) > 0
						Or StrFind(Squeezed, Upper("ПредставлениеСсылки(")) > 0 Or StrFind(Squeezed, "PRESENTATION(") > 0
						Or StrFind(Squeezed, Upper(".Представление")) > 0 Or StrFind(Squeezed, ".PRESENTATION") > 0) Then
						// Замеры qc5, qc5b, db12, db15 (21.11.2026, УХ): `CASE … THEN 0x08 ELSE 0x05 END`, строка, ссылка,
						// поле показа и номер ветви; группировка и РАЗЛИЧНЫЕ - по всем этим колонкам.
						Raise StrTemplate(
							"Column %1 takes the presentation of a reference in some branches and a string in others. The"
							+ " platform keeps such a column as a value with a type tag: the reference itself (tag 0x08)"
							+ " with its description and the number of the branch beside the string (tag 0x05); it groups,"
							+ " compares and tells the rows apart by those parts and builds the text after reading the"
							+ " rows (measured). This translation does not build the parts of such a value, and one text"
							+ " column would merge different objects that share a description - silently. Select the"
							+ " reference and the string as two columns.", Name);
					EndIf;
					If Not IsBlankString(BinaryKind) Then
						// Замер qc3, dc19 (21.11.2026, УХ, `ЕСТЬNULL(Ж.ТипОперации, Ж.Тип)` у журнала документов): тег
						// `CASE WHEN ссылка IS NOT NULL THEN 0x08 ELSE 0x06 END`, двоичная часть `0x08 + T1._DocumentTRef`
						// (у ссылки - параметр), ссылка и номер двоичного вида (`-@P2` у ссылки, `@P3` у типа).
						Raise StrTemplate(
							"Column %1 holds a reference in some rows and %2 in others - a value of a binary kind. The"
							+ " platform returns such a column in parts (measured): the type tag (0x08 for the reference,"
							+ " 0x06 for the binary value), the binary part (for a type - 0x08 and the table id), the"
							+ " reference and the number of the binary kind; the value itself (the type, the UUID) it"
							+ " builds from them after reading the rows. This translation does not build the parts of a"
							+ " binary kind beside a reference for this expression. Select the reference and the other"
							+ " value as two columns.", Name, BinaryKind);
					EndIf;
					Raise StrTemplate(
						"Column %1 can hold both a reference and a %2, and the processor cannot"
						+ " produce the parts of that value here: it is not a stored composite"
						+ " field. In one SQL column the DBMS converts the value to a single type,"
						+ " and the bytes of a reference come back as text or as a number - wrong,"
						+ " and without an error. Narrow the expression to one kind of value:"
						+ " select the reference and the %2 as two columns, or CAST the reference"
						+ " to a presentation if a readable value is what you need.",
						Name, "primitive value");
				EndIf;

				Aggregate = TopLevelAggregate(Original);
				If Not IsBlankString(Aggregate) And IsBlankString(AggregatedCompositeRef(Original, Context)) Then
					// Замерено (9908): платформа берёт MAX от тега типа, а ссылочную часть
					// достаёт из MAX(_RTRef + _RRRef) через SUBSTRING, то есть сравнивает
					// сначала тип, потом байты. Агрегат по одной колонке ссылки даёт другую
					// строку. Отказ ловит и выражение в аргументе, не только простое поле.
					Raise StrTemplate(
						"%1 over the composite value of column %2 cannot be translated: the"
						+ " platform compares the type tag first and the reference bytes second,"
						+ " over several stored columns at once, so an aggregate over the"
						+ " reference column alone returns a different row - and it would do so"
						+ " silently. Narrow the value to one type before aggregating it.",
						Aggregate, Name);
				EndIf;

				// Двоичный вид рядом с примитивом: CASE приводит двоичное значение к строке или числу молча (bt04).
				Declared = Undefined;
				Try
					Declared = Query.Columns[FieldIndex].ValueType;
				Except
					Declared = Undefined;
				EndTry;
				If Declared <> Undefined And (Declared.ContainsType(Type("Type")) Or Declared.ContainsType(Type("UUID"))
					Or Declared.ContainsType(Type("ValueStorage"))) And (Declared.ContainsType(Type("String"))
					Or Declared.ContainsType(Type("Number")) Or Declared.ContainsType(Type("Date"))
					Or Declared.ContainsType(Type("Boolean"))) Then
					Raise StrTemplate(
						"Column %1 holds a value of a binary kind (a type, a UUID or a value storage) beside a string,"
						+ " a number, a date or a boolean, and its parts cannot be built here: SELECT DISTINCT, grouping,"
						+ " a union without ALL and a temporary table tell such rows apart by the parts (the platform"
						+ " returns a type tag, the primitive part, the binary part and the number of the binary kind)."
						+ " In one SQL column the DBMS converts the binary value to text or a number silently. Select the"
						+ " two values as separate columns.", Name);
				EndIf;
				// Вычисляемое составное значение: платформа собирает каждую часть своим
				// ВЫБОРом, а здесь оно сворачивается в одну колонку, и СУБД приводит её к
				// одному типу. Замерено: ссылка рядом со строкой даёт nvarchar(16), рядом
				// с числом - int, то есть байты ссылки превращаются в мусор. Молчать об
				// этом нельзя, а отказывать по объявленному типу - значит отвергать и то,
				// что переводится верно.
				AddOnce(Context.Warnings, StrTemplate(
					"Column %1 has a composite type in the query model, but it is not a stored"
					+ " composite field, so its parts cannot be reproduced: the platform builds"
					+ " each part with a CASE of its own. The column is returned as a single"
					+ " value and the DBMS converts it to one type - a reference beside a string"
					+ " comes back as text, beside a number as an integer, and the type tag is"
					+ " lost. Narrow the expression to one type if the value matters.", Name));
			EndIf;
			MixedAggregate = Not IsBlankString(TopLevelAggregate(Original)) And BranchedAggregateArgument(Original)
				And Query.Operators.Count() = 1
				And (DeclaredValueKinds(Query.Columns[FieldIndex].ValueType) > 1
					Or DeclaredTypeMix(Query.Columns[FieldIndex]).References > 1
					Or Not IsBlankString(UndefinedAggregateArgument(Original)))
				And CompositePartsOfExpression(Original, Context).Parts.Count() = 0;
			If Suffixes <> Undefined And AggregatedParts = Undefined And MixedAggregate Then
				// МАКСИМУМ(ВЫБОР ... ТОГДА Дата ИНАЧЕ 0 КОНЕЦ): агрегат над значением разных видов, собранным
				// по ветвям, - частями по формуле платформы (BranchedAggregateParts).
				Copy = Original;
				AggregatedParts = BranchedAggregateParts(Copy, Context, False,
					DeclaredTypeMix(Query.Columns[FieldIndex]).References);
			EndIf;
			If Suffixes <> Undefined And AggregatedParts = Undefined And MixedAggregate Then
				Raise StrTemplate("%1 over a value of different kinds in column %2 (built by branches, not a"
					+ " stored composite field) is not translated: the parts of its argument could not be"
					+ " built, and the platform compares the type tag first.",
					TopLevelAggregate(Original), Name);
			EndIf;
			If Suffixes <> Undefined Then
				// Разбор ветви удался - значит роли, которой у ветви нет, здесь нет по
				// существу, и её место занимает пустое значение своего вида, а не NULL.
				BranchFilled = False;
				Composite = CompositePartsOfExpression(Original, Context);
				Available = New Map;
				For Each Part In Composite.Parts Do
					Available.Insert(Mid(PartAlias(Name, Part), StrLen(Name) + 1),
						FieldColumn(Composite.Descriptor, Composite.Alias, Part, Context));
				EndDo;
				If Available.Count() = 0 And AggregatedParts <> Undefined Then
					BranchFilled = True;
					For Each Part In AggregatedParts Do
						Available.Insert(Part.Key, Part.Value);
					EndDo;
				EndIf;
				If Available.Count() = 0 Then
					// Хранимого поля за колонкой нет - значение собрано по ветвям.
					Branched = Undefined;
					Try
						Branched = BranchedCompositeParts(Original, Context);
						If Branched = Undefined Then
							Branched = NavigatedCompositeParts(Original, Context);
						EndIf;
					Except
						Branched = Undefined;
					EndTry;
					If Branched <> Undefined Then
						BranchFilled = True;
						For Each Part In Branched Do
							Available.Insert(Part.Key, Part.Value);
						EndDo;
					EndIf;
				EndIf;
				// Ветвь объединения целиком разбирается тем же разбором ветви. Части,
				// которых у этой ветви нет, платформа заполняет пустыми значениями своих
				// видов, а не NULL - замерено, и ArmPart делает ровно это.
				If Available.Count() = 0 Then
					Arm = Undefined;
					Try
						Arm = ArmCompositeParts(Original, Context);
					Except
						Arm = Undefined;
					EndTry;
					If IsNullArm(Arm) Then
						// Ветвь NULL: значения нет ни в одной части (см. NullArmParts).
						For Each Suffix In Suffixes Do
							Available.Insert(Suffix, "NULL");
						EndDo;
					ElsIf Arm <> Undefined Then
						BranchFilled = True;
						For Each Part In Arm Do
							Available.Insert(Part.Key, Part.Value);
						EndDo;
					ElsIf Suffixes.Find("_B") <> Undefined Then
						// Колонка держит двоичный вид (тип, идентификатор, хранилище), а значение этой
						// ветви на части не разбирается: все части вышли бы NULL, и значение пропало бы.
						// Замер vp1, vp2 (20.11.2026, УХ): ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(…)) рядом с
						// ТИПЗНАЧЕНИЯ платформа отдаёт значением типа и числовым признаком, а имя типа
						// подставляет после чтения строк - SQL этого не повторяет.
						Raise StrTemplate(
							"Column %1 holds a binary kind of value (a type, a UUID or a value storage) in"
							+ " another branch, and the value of this branch (%2) cannot be split into the"
							+ " same parts: every part would come back NULL, and the value would be lost"
							+ " silently. Where this branch is a PRESENTATION of a type, the platform returns"
							+ " the type itself with a marker and puts the name in after reading the rows."
							+ " Select the two values as separate columns.", Name, TrimAll(Original));
					EndIf;
				EndIf;
				// Базовая колонка разнотипного вычисляемого значения во временной таблице
				// невыразима: выбросить её нельзя (следующие запросы пакета обращаются к
				// ней по имени), а оставить - значит положить строку рядом со ссылкой в
				// одну колонку, чего СУБД не принимает. Платформа базовой колонки здесь
				// не держит вовсе, но чтение частей из временной таблицы - отдельная
				// работа. Пока отказ.
				If Not Context.FinalResult And Composite.Parts.Count() = 0
					And MixedKindParts(PartSuffixes, Name)
					And Not PartsOnlyPlacement(Query, FieldIndex, Original, PartSuffixes, Context) Then
					Raise StrTemplate(
						"Column %1 holds values of different kinds and is not the final result of"
						+ " the query - it fills a temporary table or stands as a subquery, and"
						+ " there the column has to exist by name: whoever reads it refers to it."
						+ " SQL has no type that holds both a reference and a string, a number or"
						+ " a date, and the DBMS converts such a column silently - the bytes of a"
						+ " reference come back as text or as an integer. Narrow the expression to"
						+ " one kind of value, or select the parts as separate columns.", Name);
				EndIf;
				// Значение ветви держит часть, которой в составе колонки нет: вывод её не возьмёт, и
				// значение пропадёт молча - тег скажет «двоичное», а двоичной части нет (перепись
				// 49z1, ERP WE: ВЫБОР … ТОГДА ТИПЗНАЧЕНИЯ(Ссылка) ИНАЧЕ "" рядом со строкой).
				For Each Part In Available Do
					// _RTRef у колонки с одним ссылочным типом платформа не выводит (замерено, см.
					// PlacementPartSuffixes): таблица ссылки однозначна, и значение не теряется.
					If Suffixes.Find(Part.Key) = Undefined And Part.Key <> "_TYPE" And Part.Key <> "_BK"
						And Part.Key <> "_RTRef"
						And (MentionsColumn(Part.Value) Or StrFind(Part.Value, "@") > 0) Then
						Raise StrTemplate(
							"Column %1 gets part %2 from one of its branches, and the parts of the"
							+ " column, gathered over all branches, do not include it: the value of"
							+ " that branch would be lost, while its type tag still claims it - silently."
							+ " Narrow the expression to one kind of value, or select that value as a"
							+ " separate column.", Name, Part.Key);
					EndIf;
				EndDo;
				Fallback = Undefined;
				For Each Suffix In Suffixes Do
					Column = Available.Get(Suffix);
					If Column <> Undefined And Context.PlacementParts.Find(Column) = Undefined
						And MentionsColumn(Column) And PartFitsGrouping(Column) Then
						Context.PlacementParts.Add(Column);
					EndIf;
					Piece = Column;
					If Piece = Undefined Then
						If Fallback = Undefined Then
							// Внутри идут обращения к метаданным, а у поля самой широкой формы
							// не отсутствует ни одна часть - считаем только по нужде.
							Fallback = SinglePartFallbacks(Original, Info.Expression, Context);
						EndIf;
						Piece = Fallback.Get(Suffix);
					EndIf;
					If Piece = Undefined And Suffix = "_TYPE" And Composite.Parts.Count() > 0
						And Available.Get("_RTRef") <> Undefined And Available.Get("_RRRef") <> Undefined Then
						// Хранимое составное без тега - регистратор: он всегда ссылка. NULL в теге
						// читался бы как «значения нет», и «= НЕОПРЕДЕЛЕНО»/«<> НЕОПРЕДЕЛЕНО» по
						// объединённой колонке теряли строки (сверка battery25: 1С 22, SQL 68).
						// Проверка на NULL - как у перехода (9985): строка без пары тега не получает.
						Piece = "(CASE WHEN " + Available.Get("_RRRef") + " IS NOT NULL THEN "
							+ BinaryLiteral(HexLiteral(8, 2), Context) + " END)";
					ElsIf Piece = Undefined And Composite.Parts.Count() > 0 And Available.Get("_TYPE") = Undefined
						And Available.Get("_RTRef") <> Undefined And Available.Get("_RRRef") <> Undefined Then
						// Примитивная часть рядом с регистратором (ветвь-литерал другого вида): платформа
						// ставит пустое значение её вида, а не NULL - замер cl_s, cl_n (20.11.2026, УХ).
						Piece = EmptyPartLiteral(Suffix, Context);
					EndIf;
					If Piece = Undefined And BranchFilled Then
						Piece = EmptyPartLiteral(Suffix, Context);
					EndIf;
					If Piece = Undefined Then
						Piece = "NULL";
						AddOnce(Context.Warnings, StrTemplate(
							"Part %1%2 is NULL in one branch of the union: that branch has no such"
							+ " part, and what belongs there could not be determined statically."
							+ " Rows of that branch report no value in this part; read the value"
							+ " through %1_TYPE, which says which part holds it.", Name, Suffix));
					EndIf;
					If Suffix = "_N" And Piece <> "NULL" And Not IsBlankString(Query.PlacementTable)
						And Query.Operators.Count() = 1 And Context.Options.Dialect <> "PostgreSQL" Then
						Placed = PlacedNumberPart(Original, Context);
						If Placed <> Undefined Then
							Piece = StrTemplate("CAST(%1 AS NUMERIC(%2, %3))", Piece,
								Format(Placed.Precision, "NG=0"), Format(Placed.Scale, "NG=0; NZ=0"));
						EndIf;
					EndIf;
					If Suffix = "_N" And Piece <> "NULL" And IsBlankString(Query.PlacementTable)
						And Query.Operators.Count() > 1 And FieldIndex < Query.Columns.Count() Then
						// Частное в ветви объединения - к типу колонки, как у колонки без частей (замер qu01).
						Piece = UnionQuotientSql(Piece, Original, Query, FieldIndex, Context, True);
					EndIf;
					If WithAliases Then
						Piece = Piece + " AS " + QuoteIdentifier(Name + Suffix, Context);
					EndIf;
					Parts.Add("  " + Piece);
					Context.OutputNames.Add(QuoteIdentifier(Name + Suffix, Context));
				EndDo;
			EndIf;
		EndIf;
	EndDo;
	If Parts.Count() = 0 Then
		// Все колонки выброшены - значит выбирать нечего, и «SELECT FROM ...» СУБД не
		// разберёт. Такое бывает у запроса, где каждая колонка выбирает вложенную таблицу.
		Raise "Every column of this query selects a nested table, so nothing is left to"
			+ " select: the value of such a column is a table of its own, and the platform"
			+ " builds it with a query of its own. Select the tabular section as a table"
			+ " (FROM Catalog.Name.TabularSection) instead.";
	EndIf;
	Return StrConcat(Parts, "," + Chars.LF);

EndFunction

// Разнотипное значение, собранное по ветвям, в запросе, который не итоговый: его колонка
// держит только части (MixedKindParts), хранимого составного поля за ней нет. Только MS SQL:
// заглушка базовой колонки - тип XML.
Function PartsOnlyPlacement(Query, FieldIndex, Original, PartSuffixes, Context)

	If Context.FinalResult Or Context.Options.Dialect = "PostgreSQL"
		Or FieldIndex >= Query.Columns.Count()
		Or Not MixedKindParts(PartSuffixes, Query.Columns[FieldIndex].Alias) Then
		Return False;
	EndIf;
	If CompositePartsOfExpression(Original, Context).Parts.Count() = 0 Then
		Return True;
	EndIf;
	// Копия колонки, которая сама держит только части: базовой колонки нет и у источника.
	Trimmed = TrimAll(Original);
	If StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return False;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return False;
	EndTry;
	// Решение - у выборки, наполнившей таблицу-источник (HoldsOnlyParts): колонка, которая сама
	// скопирована из колонки с заглушкой, вычисляемой ветви не имеет, и по составу частей одна
	// (IsPartsOnlyColumn) её не узнать - вторая копия подряд читала заглушку (отказ «exists only as
	// its parts» на 9 запросах корпуса: копия ВТ в ВТ и дальше в выборку).
	Return IsBlankString(Resolved.CompositeSegment) And Resolved.Descriptor <> Undefined
		And HoldsOnlyParts(Resolved.Descriptor, Resolved.FieldName, Context);

EndFunction

// Колонка временной таблицы или подзапроса, которая держит только части значения разных
// видов: у неё есть тег и две примитивные части или примитивная рядом со ссылочной, и хотя
// бы одна ветвь объединения её вычисляет - там базовой колонки нет (PartsOnlyPlacement), а
// у ветви с хранимым полем в ней лежит только ссылочная часть. Части смотрятся по составу
// колонок, без CompositeInfo: тот помечает поле использованным.
Function IsPartsOnlyColumn(Descriptor, FieldName)

	If Not Descriptor.IsDerived Then
		Return False;
	EndIf;
	ColumnList = Descriptor.Columns.Get(Upper(TrimAll(FieldName)));
	If ColumnList = Undefined Or ColumnList.Count() < 2 Then
		Return False;
	EndIf;
	If Not ColumnHasComputedBranch(Descriptor, FieldName) Then
		Return False;
	EndIf;
	Tagged = False;
	References = 0;
	Primitives = 0;
	For Each Column In ColumnList Do
		Upper_ = Upper(Column);
		If StrEndsWith(Upper_, "_TYPE") Then
			Tagged = True;
		ElsIf StrEndsWith(Upper_, "_RRREF") Then
			References = 1;
		ElsIf StrEndsWith(Upper_, "_S") Or StrEndsWith(Upper_, "_N") Or StrEndsWith(Upper_, "_T")
			Or StrEndsWith(Upper_, "_L") Then
			Primitives = Primitives + 1;
		EndIf;
	EndDo;
	// Тег рядом с одним примитивом (второй вид - НЕОПРЕДЕЛЕНО: дата или булево из ВЫБОРа с ветвью
	// НЕОПРЕДЕЛЕНО) - та же колонка из частей: выборка, наполнившая таблицу, ставит ей заглушку по
	// MixedKindParts, и признак здесь обязан совпадать с ним. Прежде он не совпадал, и копия такой
	// колонки в другую таблицу, подзапрос или ветвь объединения читала заглушку - отказ «exists only
	// as its parts» на запросе, который платформа исполняет копированием частей (rd1-rd5, rb1-rb5,
	// 21.11.2026, УХ).
	Return Tagged And Primitives > 0;

EndFunction

// Колонки, которым выборка, наполнившая производную таблицу, поставила заглушку вместо базовой
// колонки (имя в верхнем регистре). Undefined - запрос таблицы этим переводом не переводился.
Function PlacedStubs(Descriptor, Context)

	If Context = Undefined Or Not Context.Options.Property("PartsOnlyStubQueries")
		Or Not Descriptor.Property("NumericSource") Or Descriptor.NumericSource = Undefined Then
		Return Undefined;
	EndIf;
	Return Context.Options.PartsOnlyStubQueries.Get(Descriptor.NumericSource.Definition);

EndFunction

// Колонка производной таблицы держит значение только частями: базовая колонка - заглушка
// (PartsOnlyPlacement). Решение берётся у выборки, наполнившей таблицу, - по нему ставилась
// заглушка; без её записи - по составу частей (IsPartsOnlyColumn).
Function HoldsOnlyParts(Descriptor, FieldName, Context)

	If Descriptor = Undefined Or Not Descriptor.IsDerived Then
		Return False;
	EndIf;
	ColumnList = Descriptor.Columns.Get(Upper(TrimAll(FieldName)));
	If ColumnList = Undefined Or ColumnList.Count() < 2 Then
		Return False;
	EndIf;
	Stubs = PlacedStubs(Descriptor, Context);
	If Stubs <> Undefined Then
		Return Stubs.Get(Upper(TrimAll(FieldName))) <> Undefined;
	EndIf;
	Return IsPartsOnlyColumn(Descriptor, FieldName);

EndFunction

// Путь «Псевдоним.Колонка» к колонке из одних частей. Путь длиннее не разрешается: разрешение
// строило бы соединения переходов.
Function HoldsOnlyPartsPath(Path, Context)

	Trimmed = TrimAll(Path);
	If StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, "(") > 0 Or StrSplit(Trimmed, ".", False).Count() <> 2 Then
		Return False;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return False;
	EndTry;
	Return IsBlankString(Resolved.CompositeSegment)
		And HoldsOnlyParts(Resolved.Descriptor, Resolved.FieldName, Context);

EndFunction

// Колонки частей по ролям (суффикс - имя колонки) из разложения CompositeInfo.
Function InfoPartColumns(Info)

	Names = New Map;
	Names.Insert("_TYPE", Info.TypeColumn);
	Names.Insert("_L", Info.BooleanColumn);
	Names.Insert("_N", Info.NumberColumn);
	Names.Insert("_T", Info.DateColumn);
	Names.Insert("_S", Info.StringColumn);
	Names.Insert("_RTRef", Info.RefTypeColumn);
	Names.Insert("_RRRef", Info.RefColumn);
	Result = New Map;
	For Each Pair In Names Do
		If Not IsBlankString(Pair.Value) Then
			Result.Insert(Pair.Key, Pair.Value);
		EndIf;
	EndDo;
	Return Result;

EndFunction

// Часть ссылки одного типа в роли Suffix из ReferencePartRoles: тег, идентификатор таблицы
// Target, сама ссылка Reference.
Function PartOfReference(Suffix, Target, Reference, Context)

	If Suffix = "_TYPE" Then
		Return BinaryLiteral(HexLiteral(8, 2), Context);
	ElsIf Suffix = "_RTRef" Then
		Return ReferenceTypeIdLiteral(Target, Context);
	EndIf;
	Return Reference;

EndFunction

// Единственный ссылочный тип описания типов: имя его таблицы. Пустая строка - ссылочных типов
// нет, их несколько либо описания нет.
Function SoleReferenceTable(Description)

	If Description = Undefined Then
		Return "";
	EndIf;
	Found = "";
	Try
		For Each Item In Description.Types() Do
			Target = Metadata.FindByType(Item);
			If Target = Undefined Then
				Continue;
			EndIf;
			If Not IsBlankString(Found) Then
				Return "";
			EndIf;
			Found = Target.FullName();
		EndDo;
	Except
		Return "";
	EndTry;
	Return Found;

EndFunction

// Единственный вид значения по описанию типов (то же, что DeclaredSingleKind у колонки модели):
// роль части (Role), тег (Tag) и у ссылки таблица (Target). Undefined - видов несколько, вид не
// из этих либо описания нет.
Function SingleKindOfDescription(Description)

	If Description = Undefined Then
		Return Undefined;
	EndIf;
	Found = Undefined;
	Try
		For Each Item In Description.Types() Do
			If Item = Type("Null") Then
				Continue;
			EndIf;
			If Found <> Undefined Then
				Return Undefined;
			EndIf;
			Found = Item;
		EndDo;
	Except
		Return Undefined;
	EndTry;
	If Found = Undefined Then
		Return Undefined;
	EndIf;
	Meta = Metadata.FindByType(Found);
	If Meta <> Undefined Then
		Return New Structure("Role, Tag, Target", "_RRRef", "08", Meta.FullName());
	ElsIf Found = Type("String") Then
		Return New Structure("Role, Tag, Target", "_S", "05", "");
	ElsIf Found = Type("Number") Then
		Return New Structure("Role, Tag, Target", "_N", "03", "");
	ElsIf Found = Type("Date") Then
		Return New Structure("Role, Tag, Target", "_T", "04", "");
	ElsIf Found = Type("Boolean") Then
		Return New Structure("Role, Tag, Target", "_L", "02", "");
	EndIf;
	Return Undefined;

EndFunction

// Описание типов поля по разрешённому пути. У хранимого поля - из метаданных; у колонки
// временной таблицы или подзапроса - из модели запроса, который её наполнил: там тип сведён по
// всем ветвям объединения, а не взят по первой (ColumnSources). Undefined - не выведено
// (виртуальная таблица, стандартное поле без описания).
Function ResolvedTypeDescription(Resolved)

	Descriptor = Resolved.Descriptor;
	If Descriptor = Undefined Then
		Return Undefined;
	EndIf;
	If Not Descriptor.IsDerived Then
		Owner = MetadataOf(Descriptor.LogicalName);
		If Owner = Undefined Then
			Return Undefined;
		EndIf;
		Try
			Return FieldTypeDescription(Owner, Resolved.FieldName);
		Except
			Return Undefined;
		EndTry;
	EndIf;
	Wanted = Upper(TrimAll(Resolved.FieldName));
	If Descriptor.Property("DeclaredTypes") And Descriptor.DeclaredTypes <> Undefined Then
		Declared = Descriptor.DeclaredTypes.Get(Wanted);
		If Declared <> Undefined Then
			Return Declared;
		EndIf;
	EndIf;
	If Not Descriptor.Property("NumericSource") Or Descriptor.NumericSource = Undefined Then
		Return Undefined;
	EndIf;
	Try
		Definition = Descriptor.NumericSource.Definition;
		For Each Column In Definition.Columns Do
			If Upper(TrimAll(Column.Alias)) = Wanted Then
				Return Column.ValueType;
			EndIf;
		EndDo;
	Except
		Return Undefined;
	EndTry;
	Return Undefined;

EndFunction

// Идентификатор таблицы ссылки у значения из частей, в которых его колонки нет (ссылочный тип
// один, Table). Замеры qa13, qa14, qd1a (21.11.2026, УХ): `CASE WHEN тег = 0x08 THEN <таблица>
// WHEN тег <> 0x08 THEN 0x00000000 END`.
Function TableIdByTag(Tag, Table, Context)

	Reference = BinaryLiteral(HexLiteral(8, 2), Context);
	Return "(CASE WHEN " + Tag + " = " + Reference + " THEN " + ReferenceTypeIdLiteral(Table, Context)
		+ " WHEN " + Tag + " <> " + Reference + " THEN " + BinaryLiteral("00000000", Context) + " END)";

EndFunction

// Операнд сравнения по частям: колонка с частями (составное поле, колонка из одних частей) либо
// ссылка одного типа, поднятая в части. Parts - роль и текст SQL; Lifted - ссылка одного типа;
// Table - таблица единственного ссылочного типа (пустая строка - не выведена или типов
// несколько); TableColumn - идентификатор таблицы лежит колонкой. Undefined - операнд не такой.
//
// Подъём ссылки одного типа (замеры qa2, qa8, qa9, qa11, qa14): тег и идентификатор таблицы -
// `CASE WHEN <ссылка> IS NOT NULL THEN <константа> END`, ссылочная часть - сама ссылка. В
// условии соединения и отбора платформа пишет тег константой (qa1, qa6, qa7) - там NULL и Ложь
// неразличимы; под НЕ и в значении-условии различимы, поэтому проверка здесь всегда.
Function PairOperand(Path, Context)

	Trimmed = TrimAll(Path);
	// Имя без точки - поле в условии параметров виртуальной таблицы (BareFields).
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0
		Or (StrFind(Trimmed, ".") = 0 And Context.BareFields.Get(Upper(Trimmed)) = Undefined) Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined Then
		Return Undefined;
	EndIf;

	Result = New Structure("Parts, Lifted, Table, TableColumn", New Map, False, "", False);
	Description = ResolvedTypeDescription(Resolved);
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info <> Undefined Then
		If IsBlankString(Info.TypeColumn) Then
			Return Undefined;
		EndIf;
		For Each Pair In InfoPartColumns(Info) Do
			Result.Parts.Insert(Pair.Key, FieldColumn(Resolved.Descriptor, Resolved.Alias, Pair.Value, Context));
		EndDo;
		Result.TableColumn = Result.Parts.Get("_RTRef") <> Undefined;
		If Result.Parts.Get("_RRRef") <> Undefined And Not Result.TableColumn Then
			Result.Table = SoleReferenceTable(Description);
			If Not IsBlankString(Result.Table) Then
				Result.Parts.Insert("_RTRef", TableIdByTag(Result.Parts.Get("_TYPE"), Result.Table, Context));
			EndIf;
		EndIf;
		Return Result;
	EndIf;

	Kind = SingleKindOfDescription(Description);
	Target = ?(Kind <> Undefined And Kind.Role = "_RRRef", Kind.Target, "");
	If IsBlankString(Target) And Not Resolved.Descriptor.IsDerived Then
		Target = SingleReferenceTarget(Trimmed, Context);
	EndIf;
	If IsBlankString(Target) Then
		Return Undefined;
	EndIf;
	Copy = Trimmed;
	Reference = TranslateValue(Copy, Context);
	Guard = "(CASE WHEN " + Reference + " IS NOT NULL THEN ";
	Result.Lifted = True;
	Result.Table = Target;
	Result.Parts.Insert("_TYPE", Guard + BinaryLiteral(HexLiteral(8, 2), Context) + " END)");
	Result.Parts.Insert("_RTRef", Guard + ReferenceTypeIdLiteral(Target, Context) + " END)");
	Result.Parts.Insert("_RRRef", Reference);
	Return Result;

EndFunction

// Сравнение «=» или «<>» двух операндов по частям (PairOperand). Правило - по замерам 21.11.2026,
// УХ: тег с тегом; идентификатор таблицы с идентификатором, если хотя бы у одной стороны он
// различает значения (у обеих один и тот же единственный тип - платформа его не сравнивает:
// qa1, qa8); ссылка со ссылкой; примитивная часть - с частью той же роли. Роль, которой у одной
// из сторон нет, не сравнивается: при равных тегах значение такого вида невозможно, и часть у
// другой стороны пустая (платформа в «=» сравнивает её с пустым значением - qa3, qa13, в «<>» не
// сравнивает - qa12; здесь эта часть у ветви объединения с хранимым составным полем - NULL, и
// сравнение с пустым значением теряло бы строку). «=» - через И, «<>» - через ИЛИ.
// Пустая строка - форма не замерена.
Function PairPartsComparison(Left, Operator, Right, Context)

	If Left.Parts.Get("_TYPE") = Undefined Or Right.Parts.Get("_TYPE") = Undefined Then
		Return "";
	EndIf;
	Referenced = Left.Parts.Get("_RRRef") <> Undefined And Right.Parts.Get("_RRRef") <> Undefined;
	SameTable = Not Left.TableColumn And Not Right.TableColumn
		And Not IsBlankString(Left.Table) And Left.Table = Right.Table;
	Tests = New Array;
	For Each Suffix In PartRoleOrder() Do
		LeftPart = Left.Parts.Get(Suffix);
		RightPart = Right.Parts.Get(Suffix);
		If Suffix = "_RTRef" Then
			If Not Referenced Or SameTable Then
				Continue;
			EndIf;
			If LeftPart = Undefined Or RightPart = Undefined Then
				// Тип ссылки одной из сторон не выведен: сравнить таблицы нечем.
				Return "";
			EndIf;
		ElsIf LeftPart = Undefined Or RightPart = Undefined Then
			Continue;
		EndIf;
		Tests.Add(LeftPart + " " + Operator + " " + RightPart);
	EndDo;
	If Tests.Count() < 2 Then
		Return "";
	EndIf;
	Return "(" + StrConcat(Tests, ?(Operator = "=", " AND ", " OR ")) + ")";

EndFunction

// `МИНИМУМ(П) = МАКСИМУМ(П)` над составными ссылками (любая пара МИНИМУМ/МАКСИМУМ). Замеры qb1,
// qb1d (21.11.2026, УХ): части агрегатов попарно - `MIN(_TYPE) = MAX(_TYPE) AND <таблица MIN> =
// <таблица MAX> AND <ссылка MIN> = <ссылка MAX>`. Одной ссылочной колонкой сравнение шире: у
// НЕОПРЕДЕЛЕНО и пустой ссылки байты ссылки одни. Undefined - не этот случай (аргумент не составное
// поле, есть примитивные части - не замерено).
Function AggregatedCompositeComparisonSql(Tokens, Index, Context, Consumed)

	If Tokens[Index].Kind <> "Name" Or Index + 7 > Tokens.Count() - 1 Or Tokens[Index + 1].Value <> "(" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index].Value);
	If Word <> "MIN" And Word <> "MAX" And Word <> Upper("Минимум") And Word <> Upper("Максимум") Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	LeftClose = MatchingParen(Tokens, Index + 1);
	If LeftClose = Undefined Or LeftClose + 4 > Tokens.Count() - 1
		Or Tokens[LeftClose + 1].Kind <> "Symbol" Or Tokens[LeftClose + 1].Value <> "="
		Or Tokens[LeftClose + 2].Kind <> "Name" Or Tokens[LeftClose + 3].Value <> "(" Then
		Return Undefined;
	EndIf;
	RightClose = MatchingParen(Tokens, LeftClose + 3);
	If RightClose = Undefined Or Not RightIsBoundary(Tokens, RightClose) Then
		Return Undefined;
	EndIf;
	LeftParts = Undefined;
	RightParts = Undefined;
	Try
		LeftParts = AggregatedCompositeParts(TokensText(Tokens, Index, LeftClose), Context);
		If LeftParts <> Undefined Then
			RightParts = AggregatedCompositeParts(TokensText(Tokens, LeftClose + 2, RightClose), Context);
		EndIf;
	Except
		Return Undefined;
	EndTry;
	If LeftParts = Undefined Or RightParts = Undefined Then
		Return Undefined;
	EndIf;
	Tests = New Array;
	For Each Suffix In PartRoleOrder() Do
		LeftPart = LeftParts.Get(Suffix);
		RightPart = RightParts.Get(Suffix);
		If LeftPart = Undefined And RightPart = Undefined Then
			Continue;
		EndIf;
		If LeftPart = Undefined Or RightPart = Undefined
			Or (Suffix <> "_TYPE" And Suffix <> "_RTRef" And Suffix <> "_RRRef") Then
			Return Undefined;
		EndIf;
		Tests.Add(LeftPart + " = " + RightPart);
	EndDo;
	If Tests.Count() <> 3 Then
		Return Undefined;
	EndIf;
	Consumed = RightClose - Index + 1;
	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

// `Путь = Путь` и `Путь <> Путь`, где хотя бы один путь - колонка из одних частей, а второй -
// колонка с частями либо ссылка одного типа. Сюда доходит то, что не разобрали
// MixedCaseComparisonSql и CompositeValueComparisonSpan: «<>» со ссылкой одного типа (qa1n, qa2,
// qa2w, qa2c), стороны с разным составом частей (qa3, qa12, qa13), ссылки разных таблиц (qa14).
// Undefined - не этот случай.
Function PartsPairComparisonSql(Tokens, Index, Context)

	If Index + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Sign = Tokens[Index + 1];
	If Sign.Kind <> "Symbol" Or (Sign.Value <> "=" And Sign.Value <> "<>")
		Or Tokens[Index].Kind <> "Name" Or Tokens[Index + 2].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Index + 2) Then
		Return Undefined;
	EndIf;
	LeftPath = TrimAll(Tokens[Index].Value);
	RightPath = TrimAll(Tokens[Index + 2].Value);
	If Not HoldsOnlyPartsPath(LeftPath, Context) And Not HoldsOnlyPartsPath(RightPath, Context) Then
		Return Undefined;
	EndIf;
	Left = PairOperand(LeftPath, Context);
	If Left = Undefined Then
		Return Undefined;
	EndIf;
	Right = PairOperand(RightPath, Context);
	If Right = Undefined Or (Left.Lifted And Right.Lifted) Then
		Return Undefined;
	EndIf;
	Sql = PairPartsComparison(Left, Sign.Value, Right, Context);
	Return ?(IsBlankString(Sql), Undefined, Sql);

EndFunction

// Колонка из одних частей против ссылки одного типа - поля таблицы или колонки без частей.
// Undefined - не этот случай.
Function PartsOnlyReferenceSpan(Composite, Token, Context)

	Info = Composite.Info;
	ColumnList = Composite.Resolved.Descriptor.Columns.Get(Upper(TrimAll(Composite.Resolved.FieldName)));
	If Token.Kind <> "Name" Or StrFind(Token.Value, ".") = 0
		Or IsBlankString(Info.TypeColumn) Or IsBlankString(Info.RefColumn)
		Or ColumnList = Undefined Or InfoPartColumns(Info).Count() <> ColumnList.Count() Then
		Return Undefined;
	EndIf;
	Text = TrimAll(Token.Value);
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Text, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment)
		Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
		Return Undefined;
	EndIf;
	Target = SingleReferenceTarget(Text, Context);
	// При идентификаторе таблицы в колонке тип второй стороны должен быть доказан: у колонки
	// производной таблицы он взят из первой ветви объединения.
	If IsBlankString(Target) Or (Not IsBlankString(Info.RefTypeColumn) And Resolved.Descriptor.IsDerived) Then
		Return Undefined;
	EndIf;
	If IsBlankString(Info.RefTypeColumn) Then
		// Идентификатора таблицы в колонке нет - ссылочный тип у неё один. Если он другой, чем у
		// второй стороны, платформа сравнивает и таблицы (замер qa14); это разбирает
		// PartsPairComparisonSql.
		Own = SoleReferenceTable(ResolvedTypeDescription(Composite.Resolved));
		If Not IsBlankString(Own) And Own <> Target Then
			Return Undefined;
		EndIf;
	EndIf;

	Span = New Structure;
	Span.Insert("First", Composite);
	Span.Insert("PartsOnly", Text);
	Span.Insert("Target", Target);
	Return Span;

EndFunction

// Колонка из одних частей = ссылка одного типа: тег ссылки, идентификатор таблицы (если он в
// колонке есть) и сама ссылка. Замер mk_ptref_1, 20.11.2026, УХ: `_TYPE = 0x08 AND _S = CASE WHEN
// T2._IDRRef IS NOT NULL THEN '' END AND _RRRef = T2._IDRRef`. Сравнение пустой примитивной части
// при теге 0x08 у платформы ничего не отсекает, а здесь эта часть у ветви объединения с хранимым
// составным полем - NULL (SelectedFieldsSql: «Part … is NULL in one branch»), и строка выпала
// бы. Поэтому примитивные части не сравниваются.
Function PartsOnlyReferenceSql(Span, Context)

	Operand = Span.First;
	Copy = Span.PartsOnly;
	Reference = TranslateValue(Copy, Context);
	Columns = InfoPartColumns(Operand.Info);
	// Тег и идентификатор таблицы ссылки - под проверкой «значение есть». Замеры qa2, qa8, qa9, qa11
	// (21.11.2026, УХ): `CASE WHEN <ссылка> IS NOT NULL THEN 0x08 END`. Константа давала другой
	// ответ под НЕ и в значении-условии: при ссылке NULL и строке в колонке `тег = 0x08` - Ложь, а
	// не NULL, и `НЕ К = Д` пропускало строку, которую 1С не выдаёт (qa9: 1С 0 строк, SQL 7).
	Tests = New Array;
	For Each Suffix In ReferencePartRoles() Do
		Column = Columns.Get(Suffix);
		If Column <> Undefined Then
			Part = PartOfReference(Suffix, Span.Target, Reference, Context);
			If Suffix <> "_RRRef" Then
				Part = "(CASE WHEN " + Reference + " IS NOT NULL THEN " + Part + " END)";
			EndIf;
			Tests.Add(FieldColumn(Operand.Resolved.Descriptor, Operand.Resolved.Alias, Column, Context)
				+ " = " + Part);
		EndIf;
	EndDo;
	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

// Части, которыми ссылка одного типа отличается от значения другого вида и от другой ссылки.
Function ReferencePartRoles()

	Return StrSplit("_TYPE,_RTRef,_RRRef", ",", False);

EndFunction

// Единственный вид значения колонки по модели запроса: роль части (Role), тег (Tag) и у ссылки
// таблица (Target). Undefined - видов несколько или вид не из этих.
Function DeclaredSingleKind(Column)

	Description = Undefined;
	Try
		Description = Column.ValueType;
	Except
		Return Undefined;
	EndTry;
	If Description = Undefined Then
		Return Undefined;
	EndIf;
	Found = Undefined;
	For Each Item In Description.Types() Do
		If Item = Type("Null") Then
			Continue;
		EndIf;
		If Found <> Undefined Then
			Return Undefined;
		EndIf;
		Found = Item;
	EndDo;
	If Found = Undefined Then
		Return Undefined;
	EndIf;
	Meta = Metadata.FindByType(Found);
	If Meta <> Undefined Then
		Return New Structure("Role, Tag, Target", "_RRRef", "08", Meta.FullName());
	ElsIf Found = Type("String") Then
		Return New Structure("Role, Tag, Target", "_S", "05", "");
	ElsIf Found = Type("Number") Then
		Return New Structure("Role, Tag, Target", "_N", "03", "");
	ElsIf Found = Type("Date") Then
		Return New Structure("Role, Tag, Target", "_T", "04", "");
	ElsIf Found = Type("Boolean") Then
		Return New Structure("Role, Tag, Target", "_L", "02", "");
	EndIf;
	Return Undefined;

EndFunction

// Элемент вхождения в подзапрос, который платформа сравнивает по частям внутри EXISTS (замеры
// mk_ptref_2, mk_ptref_3, mk_ptcmp_2, 20.11.2026, УХ). Side "Left": слева колонка из одних
// частей (Parts), колонка подзапроса одного вида (Kind). Side "Column": колонка подзапроса из
// одних частей (Suffixes), слева ссылка одного типа (Target). Undefined - элемент сравнивается
// целиком, прежним путём.
Function PartsInPlan(LeftText, Query, Index, Context)

	Left = TrimAll(LeftText);
	Segments = StrSplit(Left, ".", False).Count();
	If StrFind(Left, " ") > 0 Or StrFind(Left, "(") > 0
		Or (Segments <> 2 And Not (Segments = 1 And Context.BareFields.Get(Upper(Left)) <> Undefined)) Then
		Return Undefined;
	EndIf;
	OnlyParts = HoldsOnlyPartsPath(Left, Context);
	LeftParts = CompositeFieldParts(Left, Context);
	If OnlyParts Or LeftParts <> Undefined Then
		If LeftParts = Undefined Or LeftParts.Get("_TYPE") = Undefined Then
			Return Undefined;
		EndIf;
		PartSuffixes = PlacementPartSuffixes(Query, Context);
		Name = TrimAll(Query.Columns[Index].Alias);
		If MixedKindParts(PartSuffixes, Name) Then
			// И слева, и в подзапросе колонка с частями. Замер qa5p (21.11.2026, УХ): `T1._TYPE =
			// T2._TYPE AND T1._T = T2._T` - части попарно.
			Return PairInPlan(Left, Query, Index, PartSuffixes.Get(Upper(Name)), Context);
		EndIf;
		Kind = SubqueryColumnKind(Query, Index, Context);
		If Kind = Undefined Or LeftParts.Get(Kind.Role) = Undefined Then
			Return Undefined;
		EndIf;
		If Kind.Role = "_RRRef" And LeftParts.Get("_RTRef") = Undefined Then
			// Идентификатора таблицы слева нет - ссылочный тип там один, и он обязан быть тем же.
			Own = "";
			Try
				Own = SoleReferenceTable(ResolvedTypeDescription(ResolveField(Left, Context)));
			Except
				Own = "";
			EndTry;
			If (Not OnlyParts And IsBlankString(Own)) Or (Not IsBlankString(Own) And Own <> Kind.Target) Then
				Return Undefined;
			EndIf;
		EndIf;
		Return New Structure("Side, Parts, Kind", "Left", LeftParts, Kind);
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Left, Context);
	Except
		Return Undefined;
	EndTry;
	PartSuffixes = PlacementPartSuffixes(Query, Context);
	Name = TrimAll(Query.Columns[Index].Alias);
	If Not MixedKindParts(PartSuffixes, Name) Then
		Return Undefined;
	EndIf;
	Suffixes = PartSuffixes.Get(Upper(Name));
	If Suffixes.Find("_TYPE") = Undefined Or Suffixes.Find("_B") <> Undefined Or Suffixes.Find("_BK") <> Undefined Then
		Return Undefined;
	EndIf;
	If CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
		// Слева составная ссылка, в подзапросе колонка из частей: части попарно (правило - у
		// PairPartsComparison, замеры qa13, qin1).
		Return PairInPlan(Left, Query, Index, Suffixes, Context);
	EndIf;
	Target = SingleReferenceTarget(Left, Context);
	If IsBlankString(Target) Then
		// Side "Scalar": слева значение одного примитивного вида, колонка подзапроса из частей без
		// ссылочных. Замер qa5s (21.11.2026, УХ): `0x04 = T2._TYPE AND T1.<дата> = T2._T`.
		Kind = SingleKindOfDescription(ResolvedTypeDescription(Resolved));
		If Kind = Undefined Or Kind.Role = "_RRRef" Or Suffixes.Find(Kind.Role) = Undefined
			Or Suffixes.Find("_RRRef") <> Undefined Or Suffixes.Find("_RTRef") <> Undefined Then
			Return Undefined;
		EndIf;
		Return New Structure("Side, Suffixes, Kind", "Scalar", Suffixes, Kind);
	EndIf;
	If Suffixes.Find("_RRRef") = Undefined
		Or (Suffixes.Find("_RTRef") <> Undefined And Resolved.Descriptor.IsDerived) Then
		Return Undefined;
	EndIf;
	Return New Structure("Side, Suffixes, Target", "Column", Suffixes, Target);

EndFunction

// План вхождения, где обе стороны сравниваются частями (PairPartsComparison): слева операнд
// PairOperand, в подзапросе колонка с частями Suffixes. Table - единственный ссылочный тип
// колонки подзапроса, если идентификатора таблицы среди её частей нет. Undefined - форма не
// замерена.
Function PairInPlan(Left, Query, Index, Suffixes, Context)

	If Suffixes = Undefined Or Suffixes.Find("_TYPE") = Undefined
		Or Suffixes.Find("_B") <> Undefined Or Suffixes.Find("_BK") <> Undefined Then
		Return Undefined;
	EndIf;
	Operand = PairOperand(Left, Context);
	If Operand = Undefined Then
		Return Undefined;
	EndIf;
	Table = "";
	If Suffixes.Find("_RRRef") <> Undefined And Suffixes.Find("_RTRef") = Undefined Then
		Table = SubqueryColumnTable(Query, Index, Context);
	EndIf;
	Plan = New Structure("Side, Left, Suffixes, Table", "Pair", Operand, Suffixes, Table);
	If IsBlankString(PairInConditionSql(Plan, "T", "X", Context)) Then
		Return Undefined;
	EndIf;
	Return Plan;

EndFunction

// Условие плана "Pair": части левого операнда против частей колонки Name подзапроса Alias.
Function PairInConditionSql(Plan, Alias, Name, Context)

	Right = New Structure("Parts, Lifted, Table, TableColumn", New Map, False, Plan.Table, False);
	For Each Suffix In Plan.Suffixes Do
		Right.Parts.Insert(Suffix, Alias + "." + QuoteIdentifier(Name + Suffix, Context));
	EndDo;
	Right.TableColumn = Right.Parts.Get("_RTRef") <> Undefined;
	If Not Right.TableColumn And Right.Parts.Get("_RRRef") <> Undefined And Not IsBlankString(Plan.Table) Then
		Right.Parts.Insert("_RTRef", TableIdByTag(Right.Parts.Get("_TYPE"), Plan.Table, Context));
	EndIf;
	Return PairPartsComparison(Plan.Left, "=", Right, Context);

EndFunction

// Единственный ссылочный тип колонки подзапроса вхождения - по источнику колонки в каждой ветви
// (как SubqueryColumnKind). Пустая строка - не выведен либо у ветвей разный.
Function SubqueryColumnTable(Query, Index, Context)

	Found = "";
	For Each Operator In Query.Operators Do
		Probe = NewContext(Context.Options, New Array, Context.TempTables, "TT");
		Resolved = Undefined;
		Try
			CollectSources(Operator, Probe);
			Source = TrimAll(ColumnFieldText(Query, Operator, Index));
			If StrFind(Source, "(") > 0 Or StrFind(Source, " ") > 0 Or StrSplit(Source, ".", False).Count() <> 2 Then
				Return "";
			EndIf;
			Resolved = ResolveField(Source, Probe);
		Except
			Return "";
		EndTry;
		If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined Then
			Return "";
		EndIf;
		Table = SoleReferenceTable(ResolvedTypeDescription(Resolved));
		If IsBlankString(Table) Or (Not IsBlankString(Found) And Found <> Table) Then
			Return "";
		EndIf;
		Found = Table;
	EndDo;
	Return Found;

EndFunction

// Единственный вид значения колонки подзапроса вхождения. Модель подзапроса, разобранного
// отдельно от пакета, типов колонок временных таблиц не знает (DeclaredSingleKind пуст), поэтому
// вид выводится и по источнику колонки в каждой ветви: путь «Псевдоним.Колонка», тип которой
// описан метаданными или моделью запроса, наполнившего таблицу. Undefined - не выведен либо у
// ветвей разный.
Function SubqueryColumnKind(Query, Index, Context)

	Kind = DeclaredSingleKind(Query.Columns[Index]);
	If Kind <> Undefined Then
		Return Kind;
	EndIf;
	Found = Undefined;
	For Each Operator In Query.Operators Do
		Probe = NewContext(Context.Options, New Array, Context.TempTables, "TT");
		Resolved = Undefined;
		Try
			CollectSources(Operator, Probe);
			Source = TrimAll(ColumnFieldText(Query, Operator, Index));
			If StrFind(Source, "(") > 0 Or StrFind(Source, " ") > 0 Or StrSplit(Source, ".", False).Count() <> 2 Then
				Return Undefined;
			EndIf;
			Resolved = ResolveField(Source, Probe);
		Except
			Return Undefined;
		EndTry;
		If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined
			Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
			Return Undefined;
		EndIf;
		Kind = SingleKindOfDescription(ResolvedTypeDescription(Resolved));
		If Kind = Undefined Then
			Return Undefined;
		EndIf;
		If Found = Undefined Then
			Found = Kind;
		ElsIf Found.Role <> Kind.Role Or Found.Target <> Kind.Target Then
			Return Undefined;
		EndIf;
	EndDo;
	Return Found;

EndFunction

// Колонки подзапроса вхождения под его псевдонимом (TAIN …) в PartsOnlyAliasReads: обычная
// колонка - законное чтение, даже если у другой временной таблицы пакета колонка того же имени
// держит только части (корпус УХ: `ОперацииОчистить.РабочийЦентр` рядом с заглушкой
// `ОперацииРасписания.РабочийЦентр` - ложный отказ «exists only as its parts»). Колонка из
// частей остаётся с заглушкой, и обращение к её базовой колонке - по-прежнему отказ.
Procedure NoteInSubqueryReads(Alias, Query, Context)

	If Not Context.Options.Property("PartsOnlyAliasReads") Or Context.Options.Dialect = "PostgreSQL" Then
		Return;
	EndIf;
	PartSuffixes = PlacementPartSuffixes(Query, Context);
	Reads = Context.Options.PartsOnlyAliasReads;
	For Each Column In Query.Columns Do
		Name = TrimAll(Column.Alias);
		If IsBlankString(Name) Then
			Continue;
		EndIf;
		ReadKey = Upper(Alias + ".[" + Name + "]");
		If MixedKindParts(PartSuffixes, Name) Then
			Reads.Insert(ReadKey, False);
		ElsIf Reads.Get(ReadKey) <> False Then
			Reads.Insert(ReadKey, True);
		EndIf;
	EndDo;

EndProcedure

// Условие одного элемента вхождения по частям (PartsInPlan); Alias - псевдоним подзапроса,
// ColumnName - имя его колонки.
Function PartsInConditionSql(Plan, LeftText, Alias, ColumnName, Context)

	Name = TrimAll(ColumnName);
	Column = Alias + "." + QuoteIdentifier(Name, Context);
	Tests = New Array;
	If Plan.Side = "Left" Then
		Kind = Plan.Kind;
		If Kind.Role <> "_RRRef" Then
			// Колонка подзапроса - примитив: тег его вида и часть этого вида (mk_ptcmp_2).
			Return "(" + Plan.Parts.Get("_TYPE") + " = " + BinaryLiteral(Kind.Tag, Context) + " AND "
				+ Plan.Parts.Get(Kind.Role) + " = " + Column + ")";
		EndIf;
		// Колонка подзапроса - ссылка: тег, идентификатор таблицы и ссылка, без примитивных частей
		// (почему - у PartsOnlyReferenceSql).
		For Each Suffix In ReferencePartRoles() Do
			Part = Plan.Parts.Get(Suffix);
			If Part <> Undefined Then
				Tests.Add(Part + " = " + PartOfReference(Suffix, Kind.Target, Column, Context));
			EndIf;
		EndDo;
	ElsIf Plan.Side = "Pair" Then
		Return PairInConditionSql(Plan, Alias, Name, Context);
	ElsIf Plan.Side = "Scalar" Then
		Copy = LeftText;
		Tests.Add(BinaryLiteral(Plan.Kind.Tag, Context) + " = " + Alias + "." + QuoteIdentifier(Name + "_TYPE", Context));
		Tests.Add(TranslateValue(Copy, Context) + " = " + Alias + "." + QuoteIdentifier(Name + Plan.Kind.Role, Context));
	Else
		Copy = LeftText;
		Reference = TranslateValue(Copy, Context);
		For Each Suffix In ReferencePartRoles() Do
			If Plan.Suffixes.Find(Suffix) <> Undefined Then
				Tests.Add(Alias + "." + QuoteIdentifier(Name + Suffix, Context) + " = "
					+ PartOfReference(Suffix, Plan.Target, Reference, Context));
			EndIf;
		EndDo;
	EndIf;
	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

// `колонка из одних частей [НЕ] В (ВЫБРАТЬ …)`: платформа пишет [NOT] EXISTS с условием по
// частям колонки (замер mk_ptref_2, 20.11.2026, УХ: `_TYPE = 0x08 AND _N = 0 AND _RRRef =
// T2.<поле>`). Undefined - не этот случай; Consumed - число разобранных токенов.
Function PartsOnlyInSubquerySql(Tokens, Index, Context, Consumed)

	Token = Tokens[Index];
	If Token.Kind <> "Name" Or Index + 3 > Tokens.Count() - 1
		Or (StrFind(Token.Value, ".") = 0 And Context.BareFields.Get(Upper(TrimAll(Token.Value))) = Undefined)
		Or Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Position = Index + 1;
	Negated = False;
	Word = Upper(Tokens[Position].Value);
	If Tokens[Position].Kind = "Name" And (Word = "NOT" Or Word = Upper("Не")) Then
		Negated = True;
		Position = Position + 1;
		Word = Upper(Tokens[Position].Value);
	EndIf;
	If Tokens[Position].Kind <> "Name" Or (Word <> "IN" And Word <> Upper("В"))
		Or Position + 2 > Tokens.Count() - 1 Or Tokens[Position + 1].Value <> "(" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Position + 2].Value);
	If Tokens[Position + 2].Kind <> "Name" Or (Word <> "SELECT" And Word <> Upper("Выбрать")) Then
		Return Undefined;
	EndIf;
	Left = TrimAll(Token.Value);
	// План по частям нужен, когда слева колонка из одних частей или составное поле с примитивными
	// частями, либо в пакете есть колонки из одних частей (такая может стоять в подзапросе).
	If Not HoldsOnlyPartsPath(Left, Context) And CompositeFieldParts(Left, Context) = Undefined
		And Not (Context.Options.Property("PartsOnlyStubs") And Context.Options.PartsOnlyStubs.Count() > 0) Then
		Return Undefined;
	EndIf;
	Closing = MatchingParen(Tokens, Position + 1);
	If Not RightIsBoundary(Tokens, Closing) Then
		Return Undefined;
	EndIf;
	Schema = New QuerySchema;
	Try
		Schema.SetQueryText(WithoutOuterReferences(TokensText(Tokens, Position + 2, Closing - 1), Context));
	Except
		Return Undefined;
	EndTry;
	If Schema.QueryBatch.Count() <> 1 Then
		Return Undefined;
	EndIf;
	Query = Schema.QueryBatch[0];
	If Query.Columns.Count() <> 1 Then
		Return Undefined;
	EndIf;
	Plan = PartsInPlan(Left, Query, 0, Context);
	If Plan = Undefined Then
		Return Undefined;
	EndIf;
	Alias = NextAliasPrefix(Context.AliasPrefix) + "IN";
	Body = QuerySql(Query, Context.Options, Context.Warnings, Context.TempTables,
		NextAliasPrefix(NextAliasPrefix(Context.AliasPrefix)), Plan.Side <> "Left", False, True);
	NoteInSubqueryReads(Alias, Query, Context);
	Consumed = Closing - Index + 1;
	Return ?(Negated, "NOT ", "") + "EXISTS (SELECT 1 FROM (" + Chars.LF + Body + Chars.LF + ") AS " + Alias
		+ " WHERE " + PartsInConditionSql(Plan, Left, Alias, Query.Columns[0].Alias, Context) + ")";

EndFunction

// КОЛИЧЕСТВО(колонка из одних частей): платформа считает значения по тегу - COUNT_BIG(_TYPE),
// замер mk_ptjoin2_2, 20.11.2026, УХ. Undefined - не этот случай.
Function PartsOnlyCountArgument(Tokens, Index, Context)

	If Index < 2 Or Index + 1 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name"
		Or StrFind(Tokens[Index].Value, ".") = 0 Or Tokens[Index - 1].Value <> "("
		Or Tokens[Index + 1].Value <> ")" Or Tokens[Index - 2].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index - 2].Value);
	If Word <> "COUNT" And Word <> Upper("Количество") Then
		Return Undefined;
	EndIf;
	Path = TrimAll(Tokens[Index].Value);
	If Not HoldsOnlyPartsPath(Path, Context) Then
		Return Undefined;
	EndIf;
	Resolved = ResolveField(Path, Context);
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Or IsBlankString(Info.TypeColumn) Then
		Return Undefined;
	EndIf;
	Return FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);

EndFunction

// Есть ли у колонки ветвь, где она не путь к полю, а выражение или литерал. Запрос, который
// наполняет таблицу, берётся из описания (NumericSource); без него - True.
Function ColumnHasComputedBranch(Descriptor, FieldName)

	If Not Descriptor.Property("NumericSource") Or Descriptor.NumericSource = Undefined Then
		Return True;
	EndIf;
	Definition = Descriptor.NumericSource.Definition;
	Target = Upper(TrimAll(FieldName));
	Try
		For Index = 0 To Definition.Columns.Count() - 1 Do
			If Upper(TrimAll(Definition.Columns[Index].Alias)) <> Target Then
				Continue;
			EndIf;
			For Each Operator In Definition.Operators Do
				If Index >= BranchFieldCount(Definition, Operator) Then
					Continue;
				EndIf;
				Text = TrimAll(ColumnFieldText(Definition, Operator, Index));
				If StrFind(Text, " ") > 0 Or StrFind(Text, "(") > 0 Or StrFind(Text, ".") = 0
					Or StrFind(Text, """") > 0 Then
					Return True;
				EndIf;
			EndDo;
			Return False;
		EndDo;
	Except
		Return True;
	EndTry;
	Return True;

EndFunction

// АВТОНОМЕРЗАПИСИ. Замерено: платформа принимает эту функцию только в запросе,
// наполняющем временную таблицу, и нумерует строки в порядке этого же запроса.
Function RecordAutoNumber(Context)

	Parts = New Array;
	If Context.Query <> Undefined Then
		For Each OrderItem In Context.Query.Order Do
			Parts.Add(AutoNumberOrderExpression(OrderItem.Item, Context) + OrderDirection(OrderItem));
		EndDo;
	EndIf;

	If Parts.Count() = 0 Then
		// Порядок не задан: платформа нумерует в порядке чтения, воспроизвести его нечем.
		AddOnce(Context.Warnings,
			"RECORDAUTONUMBER without ORDER BY numbers the rows in the order the DBMS returns them,"
			+ " and that order is not guaranteed to match the platform.");
		Return "ROW_NUMBER() OVER (ORDER BY (SELECT NULL))";
	EndIf;
	Return "ROW_NUMBER() OVER (ORDER BY " + StrConcat(Parts, ", ") + ")";

EndFunction

// Порядок для оконной функции. УПОРЯДОЧИТЬ ПО обычно называет колонку выборки, но
// внутри OVER() псевдонима выборки ещё не существует - нужен сам расчёт колонки.
Function AutoNumberOrderExpression(Item, Context)

	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = Undefined;
	EndTry;
	If Alias = Undefined Then
		Return TranslateExpression(TrimAll(String(Item)), Context);
	EndIf;

	Query = Context.Query;
	Operator = Query.Operators[0];
	For Index = 0 To Query.Columns.Count() - 1 Do
		If Upper(TrimAll(Query.Columns[Index].Alias)) <> Upper(TrimAll(Alias))
			Or Index >= BranchFieldCount(Query, Operator) Then
			Continue;
		EndIf;
		Source = ColumnFieldText(Query, Operator, Index);
		If StrFind(Upper(Source), "RECORDAUTONUMBER") > 0
			Or StrFind(Upper(Source), Upper("АвтоНомерЗаписи")) > 0 Then
			Raise "RECORDAUTONUMBER cannot be ordered by itself.";
		EndIf;
		Return TranslateExpression(Source, Context);
	EndDo;
	Raise StrTemplate("RECORDAUTONUMBER cannot order by %1: no such column in the selection.", Alias);

EndFunction

// Ссылка на параметр и больше ничего: «@Name» или «:Name» в зависимости от диалекта.
// Имена параметров проходят через TransliterateName, поэтому буквы только латинские.
Function IsBareParameter(Expression, Context)

	Text = TrimAll(Expression);
	// Порядок при РАЗЛИЧНЫЕ оборачивает выражение в МИНИМУМ: под обёрткой параметр
	// остаётся параметром, и упорядочивать по нему всё так же нечего.
	If StrStartsWith(Text, "MIN(") And StrEndsWith(Text, ")") Then
		Text = TrimAll(Mid(Text, 5, StrLen(Text) - 5));
	EndIf;

	Prefix = ?(Context.Options.Dialect = "PostgreSQL", ":", "@");
	If Not StrStartsWith(Text, Prefix) Then
		Return False;
	EndIf;

	Name = Mid(Text, StrLen(Prefix) + 1);
	If IsBlankString(Name) Then
		Return False;
	EndIf;

	Allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_";
	For Index = 1 To StrLen(Name) Do
		If StrFind(Allowed, Mid(Name, Index, 1)) = 0 Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Составной ли тип у колонки по модели запроса. Null в составе не считается: у колонки
// после внешнего соединения платформа объявляет тип поля и Null, а составным значением
// это не делает. Тип берётся у платформы, своего вывода типов здесь нет.
Function IsCompositeDeclaredType(Column)

	Description = Undefined;
	Try
		Description = Column.ValueType;
	Except
		Return False;
	EndTry;
	If Description = Undefined Then
		Return False;
	EndIf;

	Count = 0;
	For Each Item In Description.Types() Do
		If Item <> Type("Null") Then
			Count = Count + 1;
		EndIf;
	EndDo;
	Return Count > 1;

EndFunction

// Порядок частей значения - порядок ролей: тег типа, примитивы, идентификатор таблицы,
// ссылка. У поля с тегом типа он совпадает с порядком хранения, у регистратора нет -
// структура хранения отдаёт ссылку раньше идентификатора, а платформа пишет
// идентификатор первым (замер 9940 в composite-reference3.json).
// Число в части _N составного значения платформа передаёт так же, как литерал колонкой:
// параметром в типе по значению - `ЕСТЬNULL(Строка, 1.25)` даёт numeric(38, 8), а не (3, 2)
// литерала (замер 18.11.2026, УХ, пробы ncorp n1-n5).
Function NumberPartSql(Text, Suffix, Context)

	If Suffix <> "_N" Or Context.Options.Dialect = "PostgreSQL" Or Not BareNumberText(Text) Then
		Return Text;
	EndIf;
	Return ParameterLiteralSql(StrReplace(TrimAll(Text), " ", ""), Context);

EndFunction

Function PartRoleOrder()

	Return StrSplit("_TYPE,_L,_N,_T,_S,_B,_RTRef,_RRRef,_BK", ",", False);

EndFunction

// Можно ли добирать часть значения в группировку. Нельзя две вещи: агрегат - ему
// группировка не нужна, и СУБД отвергает его в списке группировки, - и подзапрос, который
// там не принимается тоже. Признак агрегата: после вырезания агрегатных вызовов колонок
// в выражении не осталось.
Function PartFitsGrouping(Column)

	If StrFind(Upper(Column), "SELECT") > 0 Then
		Return False;
	EndIf;
	Return MentionsColumn(WithoutAggregateCalls(Column));

EndFunction

Function PartsInRoleOrder(Parts)

	Ordered = New Array;
	For Each Suffix In PartRoleOrder() Do
		For Each Column In Parts Do
			If PartAlias("", Column) = Suffix And Ordered.Find(Column) = Undefined Then
				Ordered.Add(Column);
			EndIf;
		EndDo;
	EndDo;
	For Each Column In Parts Do
		If Ordered.Find(Column) = Undefined Then
			Ordered.Add(Column);
		EndIf;
	EndDo;
	Return Ordered;

EndFunction

// Упорядочивание по составному значению. Замерено на платформе: в ORDER BY перечислены
// все колонки хранения поля, в порядке хранения, каждая отдельным элементом. По одной
// колонке ссылки порядок строк получается другим, и расходится он молча: ссылки разных
// таблиц сортируются между собой, а примитивные значения не участвуют вовсе.
//
// Колонки берутся физические, а не псевдонимы выборки: псевдонима части в запросе,
// который части не выводит, не существует. MS SQL сверяет элемент ORDER BY со списком
// выборки по выражению, поэтому под РАЗЛИЧНЫЕ физическая колонка принимается.
Function OrderPartExpressions(Item, Context)

	Composite = CompositePartsOfExpression(TrimAll(String(Item)), Context);
	If Composite.Parts.Count() = 0 Then
		Return Undefined;
	EndIf;

	Parts = New Array;
	For Each Part In PartsInRoleOrder(Composite.Parts) Do
		Expression = FieldColumn(Composite.Descriptor, Composite.Alias, Part, Context);
		Parts.Add(?(Context.GroupInsteadOfDistinct, "MIN(" + Expression + ")", Expression));
	EndDo;
	Return Parts;

EndFunction

// Упорядочивание по вычисляемому составному значению, у которого колонки значения нет:
// частей в хранении не существует, но в списке выборки они есть - псевдонимами. Замерено
// (100110010-100110012): платформа упорядочивает по всем частям в порядке ролей, а УБЫВ
// относит к каждой части.
//
// Составное из одних ссылок упорядочивается так же - по _TYPE, _RTRef, _RRRef: по одной колонке
// ссылки ссылки разных таблиц перемешиваются (полная сверка порядка УХ: СоставыГруппПользователей
// и ВТ_АдресаВладельцев, ERP WE: UserGroupCompositions; SQL с порядком по трём частям совпал с 1С
// во всех трёх). У ссылки одного типа тег и таблица постоянны, и порядок от частей не меняется.
Function OrderPartAliases(Item, Context)

	If Context.PartSuffixes = Undefined Then
		Return Undefined;
	EndIf;

	Alias = "";
	Try
		Alias = TrimAll(Item.Alias);
	Except
		Return Undefined;
	EndTry;
	If IsBlankString(Alias) Or Not OrderedByParts(Context.PartSuffixes, Alias) Then
		Return Undefined;
	EndIf;

	Suffixes = Context.PartSuffixes.Get(Upper(Alias));
	If Suffixes = Undefined Then
		Return Undefined;
	EndIf;

	// Псевдоним части - колонка списка выборки: под GROUP BY вместо РАЗЛИЧНЫЕ она сгруппирована,
	// и в ORDER BY идёт как есть. Внутри MIN псевдоним выборки T-SQL не связывает (207, ERP:
	// GoodsIssueNote, РАЗЛИЧНЫЕ с порядком по составному Recipient и полю вне выборки).
	Parts = New Array;
	For Each Suffix In Suffixes Do
		Parts.Add(QuoteIdentifier(Alias + Suffix, Context));
	EndDo;
	Return Parts;

EndFunction

// Упорядочивание по выражению вне выборки, собранному по ветвям разных видов. Замерено
// (9410): платформа упорядочивает по тегу и по частям в порядке хранения, направление - на
// каждой части. Одной колонкой такое выражение в MS SQL не строится (дата и число в одном
// CASE), а ссылки разных таблиц сортировались бы без тега и идентификатора таблицы.
// Постоянные части не выводятся: порядок от них не зависит, а T-SQL константу в ORDER BY
// не принимает. Однотипное выражение остаётся прежнему выводу - одной колонкой.
Function OrderBranchedParts(Item, Context)

	Try
		Alias = Item.Alias;
		Return Undefined;
	Except
		Alias = Undefined;
	EndTry;

	Parts = Undefined;
	Try
		Parts = BranchedCompositeParts(TrimAll(String(Item)), Context);
		If Parts = Undefined Then
			// Замер d6 (21.11.2026, УХ): порядок по реквизиту разного вида - по тегу, затем по частям.
			Parts = NavigatedMixedParts(TrimAll(String(Item)), Context);
		EndIf;
	Except
		Parts = Undefined;
	EndTry;
	If Parts = Undefined Then
		Return Undefined;
	EndIf;

	Varies = False;
	For Each Suffix In StrSplit("_TYPE,_RTRef", ",", False) Do
		Text = Parts.Get(Suffix);
		If Text <> Undefined And MentionsColumn(Text) Then
			Varies = True;
		EndIf;
	EndDo;
	If Not Varies Then
		Return Undefined;
	EndIf;

	Pieces = New Array;
	For Each Suffix In PartRoleOrder() Do
		Text = Parts.Get(Suffix);
		If Text = Undefined Or Not MentionsColumn(Text) Then
			Continue;
		EndIf;
		Pieces.Add(?(Context.GroupInsteadOfDistinct, "MIN(" + Text + ")", Text));
	EndDo;
	Return Pieces;

EndFunction

// Порядок по полю Представление объекта - это порядок по самой ссылке (УХ, n27.py, n27b.py:
// РолиКонтактныхЛицПартнеров, Валюты, Организации, СтатьиДвиженияДенежныхСредств - и псевдонимом,
// и «Т.Представление» без него ровно порядок по Ссылка, УБЫВ - по Ссылка УБЫВ, с порядком по
// Наименование не совпал ни разу). Отдаёт путь к ссылке либо Undefined. Объединение отказывается:
// ссылки в его списке выборки нет, а T-SQL упорядочивает только по нему. Одиночное РАЗЛИЧНЫЕ ключ
// получает скрытой колонкой (PresentationHiddenColumns) и сюда с ним не приходит.
Function PresentationOrderSource(Query, Item, Context)

	Text = PresentationOrderPath(Query, Item, Context);
	If Text = Undefined Then
		Return Undefined;
	EndIf;
	If Query.Operators.Count() > 1 Or Query.Operators[0].SelectDistinct Then
		Grouped = False;
		If Query.Operators.Count() = 1 And Context.Property("GroupInsteadOfDistinct", Grouped) And Grouped = True Then
			// РАЗЛИЧНЫЕ заменено группировкой по списку выборки, и ссылка выбранного представления в ней есть
			// (PresentationGrouping): порядок по ней допустим. Замер op3, p8j (20-21.11.2026, УХ): `ORDER BY 2, 3` -
			// ссылка и поле показа, и через две точки так же.
			Return PresentationSourcePath(Text, Context);
		EndIf;
		Raise StrTemplate(
			"ORDER BY %1 orders by the reference the presentation belongs to, not by its text: the platform"
			+ " selects that reference as a hidden column and orders by it (measured). Here such a column is built"
			+ " for a single SELECT DISTINCT and for a union of SELECTs without grouping whose branches give a"
			+ " reference of one type each, in the final result; this query is not such (grouping, a composite"
			+ " reference, a nested query). Select the reference as well and order by it.", Text);
	EndIf;
	Return PresentationSourcePath(Text, Context);

EndFunction

// Текст поля «…Представление», по которому упорядочивают, или Undefined.
Function PresentationOrderPath(Query, Item, Context)

	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = Undefined;
	EndTry;
	Text = "";
	If Alias = Undefined Then
		Text = TrimAll(String(Item));
	Else
		Fields = Query.Operators[0].SelectedFields;
		For Index = 0 To Min(Fields.Count(), Query.Columns.Count()) - 1 Do
			If Upper(TrimAll(Query.Columns[Index].Alias)) = Upper(TrimAll(Alias)) Then
				Text = TrimAll(String(Fields[Index]));
				Break;
			EndIf;
		EndDo;
	EndIf;
	Return PresentationPathOfText(Text, Context);

EndFunction

// Текст поля «…Представление» объекта по пути, или Undefined: выражение, реквизит с именем Представление.
Function PresentationPathOfText(Text, Context)

	If IsBlankString(Text) Or StrFind(Text, "(") > 0 Or StrFind(Text, " ") > 0 Then
		Return Undefined;
	EndIf;
	Segments = StrSplit(Text, ".", False);
	If Segments.Count() < 2 Or Not IsPresentationField(Segments[Segments.Count() - 1]) Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Text, Context);
	Except
		Return Undefined;
	EndTry;
	If IsBlankString(Resolved.CompositeSegment)
		And Resolved.Descriptor.Fields.Get(Upper(Resolved.FieldName)) <> Undefined Then
		// Реквизит с именем Представление - обычное поле.
		Return Undefined;
	EndIf;
	Return Text;

EndFunction

// УПОРЯДОЧИТЬ ПО Поле ИЕРАРХИЯ [УБЫВ]. Замер 18.11.2026 (УХ, hier_uh h1-h6): в SQL платформа пишет
// ORDER BY (T._ParentIDRRef) [DESC], (T._IDRRef) [DESC] таблицы поля - и у справочника, и у плана
// счетов, при любом поле; само дерево (группа перед своими элементами на любой глубине) она строит у
// себя после чтения. Поле не иерархической таблицы платформа отвергает. Перевод - SQL-часть и
// предупреждение про то, что делает платформа.
Function HierarchyOrderKeys(OrderItem, Context)

	Text = HierarchyItemText(OrderItem);
	Direction = ?(OrderItem.Direction = QuerySchemaOrderDirection.HierarchyDescending, " DESC", "");
	FieldKeys = HierarchyFieldKeys(Text, Context);
	Keys = New Array;
	Keys.Add(FieldKeys.Parent + Direction);
	Keys.Add(FieldKeys.Ref + Direction);
	AddOnce(Context.Warnings, HierarchyTreeWarning(TrimAll(Text)));
	Return Keys;

EndFunction

Function IsHierarchyOrder(OrderItem)

	Return OrderItem.Direction = QuerySchemaOrderDirection.HierarchyAscending
		Or OrderItem.Direction = QuerySchemaOrderDirection.HierarchyDescending;

EndFunction

Function HierarchyItemText(OrderItem)

	Text = "";
	Try
		Text = String(OrderItem.Item.Fields.Get(0));
	Except
		Text = String(OrderItem.Item);
	EndTry;
	Return Text;

EndFunction

Function HierarchyTreeWarning(Text)

	Return StrTemplate("ORDER BY %1 HIERARCHY: the SQL orders the rows by parent and reference, as the"
		+ " platform asks the DBMS; the tree order itself (every group before its members at any depth)"
		+ " the platform builds on its side after reading, and it is not in the SQL.", Text);

EndFunction

// Родитель и ссылка объекта, по которым платформа упорядочивает ИЕРАРХИЯ, и его таблица. Объект - сама
// ссылка, если поле - ссылка на иерархическую таблицу (С.Родитель: родитель и ссылка объекта по ссылке,
// LEFT JOIN), иначе - владелец поля (С.Наименование, С.Родитель.Наименование). Замер 19.11.2026, УХ,
// hier6 hd3, hs3, hd4.
Function HierarchyFieldKeys(Text, Context)

	Path = TrimAll(Text);
	Segments = StrSplit(Path, ".");
	Last = Upper(Segments[Segments.Count() - 1]);
	Alias = "";
	If Segments.Count() > 1 And Last <> "ССЫЛКА" And Last <> "REF" Then
		For Each Name In StrSplit("Родитель,Parent", ",") Do
			Try
				ValueExpression(Path + "." + Name, Context);
				Alias = Path;
				Break;
			Except
				Alias = "";
			EndTry;
		EndDo;
	EndIf;
	If IsBlankString(Alias) Then
		Segments.Delete(Segments.Count() - 1);
		Alias = StrConcat(Segments, ".");
	EndIf;
	If IsBlankString(Alias) Then
		Alias = Path;
	EndIf;
	Result = New Structure("Parent, Ref, Table", Undefined, Undefined, "");
	For Each Pair In StrSplit("Parent:Родитель,Ref:Ссылка", ",") Do
		Column = Undefined;
		Found = "";
		For Each Name In StrSplit(Pair, ":") Do
			Try
				Column = ValueExpression(Alias + "." + Name, Context);
				Found = Name;
				Break;
			Except
				Column = Undefined;
			EndTry;
		EndDo;
		If Column = Undefined Then
			Raise StrTemplate("ORDER BY %1 HIERARCHY: the table of %1 has no parent field, so it is not"
				+ " hierarchical - the platform refuses such an order as well.", TrimAll(Text));
		EndIf;
		Role = StrSplit(Pair, ":")[0];
		Result.Insert(Role, Column);
		If Role = "Ref" Then
			Result.Table = SingleReferenceTarget(Alias + "." + Found, Context);
		EndIf;
	EndDo;
	Return Result;

EndFunction

// УПОРЯДОЧИТЬ ПО ... ИЕРАРХИЯ в объединении и в РАЗЛИЧНЫЕ. Замер 19.11.2026 (УХ, hier3-5): платформа
// добавляет в каждую ветвь скрытые колонки - ссылку и родителя таблицы поля - и упорядочивает по ним
// позицией (ORDER BY 4, 3; у РАЗЛИЧНЫЕ - то же, родитель и ссылка входят в DISTINCT, что строк не
// меняет: родитель определяется ссылкой). Если ветви берут разные таблицы, колонки составные:
// таблица и ссылка родителя, затем таблица и ссылка значения (ORDER BY 6, 7, 4, 5). Перевод - те же
// скрытые колонки и внешний SELECT, который их не выводит; порядок - во внешнем SELECT.
Function HierarchyInSelection(Query)

	If Query.Operators.Count() < 2 And Not Query.Operators[0].SelectDistinct Then
		Return False;
	EndIf;
	For Each OrderItem In Query.Order Do
		If IsHierarchyOrder(OrderItem) Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

Function HierarchyHiddenColumns(Query, Blocks, FinalResult)

	If Not IsBlankString(Query.PlacementTable) Then
		Raise HierarchyPlacementRefusal();
	EndIf;
	// РАЗЛИЧНЫЕ с группировкой в одиночном запросе: скрытые колонки - и в выборке, и в GROUP BY (замер hm5, hm7,
	// 21.11.2026, УХ: `SELECT DISTINCT T1._ParentIDRRef, …, T2._IDRRef, T2._ParentIDRRef … GROUP BY T1._ParentIDRRef,
	// T2._IDRRef, T2._ParentIDRRef ORDER BY 4, 3`). Их определяет упорядочиваемое поле, и группировка от них не
	// мельчает - если поле сгруппировано.
	Grouped = False;
	For Each Block In Blocks Do
		If GroupCount(Block.Operator) > 0 Or SelectionHasAggregate(Block.Operator)
			Or Block.Context.GroupInsteadOfDistinct Then
			If Blocks.Count() > 1 Or GroupCount(Block.Operator) = 0 Or Block.Context.GroupInsteadOfDistinct Then
				Raise "ORDER BY ... HIERARCHY in a union with grouping or in a SELECT DISTINCT with aggregates and"
					+ " without GROUP BY is not translated yet: how the platform groups its hidden parent column"
					+ " there is not measured.";
			EndIf;
			Grouped = True;
		EndIf;
	EndDo;

	Hidden = New Map;
	ItemIndex = -1;
	Number = 0;
	For Each OrderItem In Query.Order Do
		ItemIndex = ItemIndex + 1;
		If Not IsHierarchyOrder(OrderItem) Then
			Continue;
		EndIf;
		Number = Number + 1;
		ColumnIndex = HierarchyColumnIndex(Query, OrderItem.Item);
		BranchKeys = New Array;
		Tables = New Map;
		For Each Block In Blocks Do
			If ColumnIndex = Undefined Then
				If Blocks.Count() > 1 Then
					Raise StrTemplate("ORDER BY %1 HIERARCHY in a union names no column of the union - not"
						+ " translated.", TrimAll(String(OrderItem.Item)));
				EndIf;
				Text = HierarchyItemText(OrderItem);
			Else
				Text = ColumnFieldText(Query, Block.Operator, ColumnIndex);
			EndIf;
			FieldKeys = HierarchyFieldKeys(Text, Block.Context);
			If Grouped Then
				Own = False;
				If Block.Operator.Group <> Undefined Then
					For Each Grouping In Block.Operator.Group Do
						If StrReplace(Upper(String(Grouping)), " ", "") = StrReplace(Upper(TrimAll(Text)), " ", "") Then
							Own = True;
						EndIf;
					EndDo;
				EndIf;
				If Not Own Then
					Raise StrTemplate("ORDER BY %1 HIERARCHY in a grouped SELECT DISTINCT orders by a field that is"
						+ " not grouped - not translated.", TrimAll(String(OrderItem.Item)));
				EndIf;
				For Each Key_ In StrSplit("Parent,Ref", ",") Do
					If Block.Group.Find(FieldKeys[Key_]) = Undefined Then
						Block.Group.Add(FieldKeys[Key_]);
					EndIf;
				EndDo;
			EndIf;
			BranchKeys.Add(FieldKeys);
			Tables.Insert(Upper(FieldKeys.Table), True);
		EndDo;
		Composite = Tables.Count() > 1;
		If Composite Then
			Roles = StrSplit("ParentType,Parent,RefType,Ref", ",");
		Else
			Roles = StrSplit("Parent,Ref", ",");
		EndIf;
		Names = New Array;
		For Each Role In Roles Do
			Names.Add(QuoteIdentifier("Q2SHierarchy" + Format(Number, "NG=0") + Role, Blocks[0].Context));
		EndDo;
		For BlockIndex = 0 To Blocks.Count() - 1 Do
			FieldKeys = BranchKeys[BlockIndex];
			Values = New Map;
			Values.Insert("Parent", FieldKeys.Parent);
			Values.Insert("Ref", FieldKeys.Ref);
			If Composite Then
				If IsBlankString(FieldKeys.Table) Then
					Raise "ORDER BY ... HIERARCHY: the table of a union branch is not known - not translated.";
				EndIf;
				TypeId = ReferenceTypeIdLiteral(FieldKeys.Table, Blocks[BlockIndex].Context);
				Values.Insert("ParentType", TypeId);
				Values.Insert("RefType", TypeId);
			EndIf;
			Extra = New Array;
			For Index = 0 To Roles.Count() - 1 Do
				Extra.Add("  " + Values.Get(Roles[Index]) + " AS " + Names[Index]);
			EndDo;
			Blocks[BlockIndex].Fields = Blocks[BlockIndex].Fields + "," + Chars.LF + StrConcat(Extra, "," + Chars.LF);
		EndDo;
		Hidden.Insert(ItemIndex, Names);
	EndDo;
	Return Hidden;

EndFunction

// Роли спутников колонки-представления в порядке вывода: тег, идентификатор таблицы, ссылка, номер ветви.
Function CarriedPresentationRoles()

	Return StrSplit("_PTYPE,_PRTRef,_PRRRef,_PN", ",", False);

EndFunction

// Откуда взято выражение представления (PresentationFacts).
Procedure NotePresentationFacts(Context, Expression, Table, Dotted, Loose)

	Context.PresentationFacts.Insert(Expression, New Structure("Table, Dotted, Loose", Table, Dotted, Loose));

EndProcedure

// Ссылка за выражением колонки по ролям спутников: колонка-представление, прочитанная из временной таблицы или
// вложенного запроса (CarriedPresentations), представление составной ссылки (три части) либо ссылки одной
// таблицы. Numbered - функция ПРЕДСТАВЛЕНИЕ, а не поле через точку: в ОБЪЕДИНИТЬ ВСЕ у неё свой номер ветви.
// Undefined - выражение не представление ссылки.
Function PresentationCarrier(Own, Expression)

	Known = Own.CarriedPresentations.Get(Expression);
	If Known <> Undefined Then
		Return New Structure("Roles, Table, Numbered, Loose", Known.Roles, Known.Table, False, Known.Loose);
	EndIf;
	Facts = Own.PresentationFacts.Get(Expression);
	Numbered = Facts = Undefined Or Not Facts.Dotted;
	Roles = New Map;
	Parts = Own.CompositePresentations.Get(Expression);
	If Parts <> Undefined Then
		If Parts.Count() <> 3 Then
			Return Undefined;
		EndIf;
		Roles.Insert("_PTYPE", Parts[0]);
		Roles.Insert("_PRTRef", Parts[1]);
		Roles.Insert("_PRRRef", Parts[2]);
		Return New Structure("Roles, Table, Numbered, Loose", Roles, "", Numbered, Facts <> Undefined And Facts.Loose);
	EndIf;
	Reference = Own.PresentationGrouping.Get(Expression);
	If Reference = Undefined Then
		Return Undefined;
	EndIf;
	Roles.Insert("_PRRRef", Reference);
	Return New Structure("Roles, Table, Numbered, Loose", Roles, ?(Facts = Undefined, "", Facts.Table), Numbered, False);

EndFunction

// Текст поля ветви на языке запросов по номеру колонки; Fallback - когда запроса нет или текст не читается.
Function BranchFieldText(Query, Operator, Position, Fallback)

	If Query = Undefined Then
		Return Fallback;
	EndIf;
	Try
		Return TrimAll(ColumnFieldText(Query, Operator, Position));
	Except
		Return Fallback;
	EndTry;

EndFunction

// Ветвь колонки - строка: строковый литерал, поле одного строкового вида или параметр со строковым значением.
Function IsStringBranch(Own, Operator, Position, Query = Undefined)

	Expression = TrimAll(Own.SelectedInfo[Position].Expression);
	// Строковый литерал в переводе - N'…' (кавычки внутри удвоены).
	If StrStartsWith(Expression, "N'") And StrEndsWith(Expression, "'")
		And StrFind(StrReplace(Mid(Expression, 3, StrLen(Expression) - 3), "''", ""), "'") = 0 Then
		Return True;
	EndIf;
	Original = BranchFieldText(Query, Operator, Position, Expression);
	Tokens = Undefined;
	Try
		Tokens = Tokenize(Original);
	Except
		Return False;
	EndTry;
	If Tokens.Count() <> 1 Then
		Return False;
	EndIf;
	If Tokens[0].Kind = "String" Then
		Return True;
	EndIf;
	If Tokens[0].Kind = "Parameter" Then
		Value = HierarchyParameterValue(Tokens[0].Value, Own);
		Return TypeOf(Value) = Type("String");
	EndIf;
	If Tokens[0].Kind = "Name" And StrFind(Tokens[0].Value, ".") > 0 Then
		Return ResolvedPathTag(Tokens[0].Value, Own, False) = "05";
	EndIf;
	Return False;

EndFunction

// Носители ссылки одной колонки по ветвям запроса. Carriers - по ветвям (Undefined у ветви NULL), Roles - общий
// состав ролей без номера ветви, Table - общая таблица ссылки или пусто, Numbered - хотя бы у одной ветви функция
// ПРЕДСТАВЛЕНИЕ либо свой номер ветви, OwnNumber - число ветвей со своим номером. Undefined - колонка не
// представление ссылки во всех ветвях или состав ролей у ветвей разный.
Function ColumnPresentationCarriers(Blocks, Position, Query = Undefined)

	Result = New Structure("Carriers, Roles, Table, Numbered, Loose, OwnNumber, Strings", New Array, Undefined, Undefined,
		False, False, 0, False);
	RoleSet = Undefined;
	For Each Block In Blocks Do
		Info = Block.Context.SelectedInfo[Position];
		If Upper(TrimAll(Info.Expression)) = "NULL" Then
			Result.Carriers.Add(Undefined);
			Continue;
		EndIf;
		Carrier = ?(Info.Aggregate, Undefined, PresentationCarrier(Block.Context, Info.Expression));
		If Carrier = Undefined And Blocks.Count() > 1 And Not Info.Aggregate
			And IsStringBranch(Block.Context, Block.Operator, Position, Query) Then
			// Ветвь-строка рядом с представлением: спутники пустые, как у NULL (замер pu05-pu07). Колонка-представление
			// временной таблицы - строкового типа, но она носитель (dp108), поэтому проверка носителя первой.
			Result.Carriers.Add(Undefined);
			Result.Strings = True;
			Continue;
		EndIf;
		If Carrier = Undefined Then
			Return Undefined;
		EndIf;
		Present = New Array;
		For Each Role In CarriedPresentationRoles() Do
			If Role <> "_PN" And Carrier.Roles.Get(Role) <> Undefined Then
				Present.Add(Role);
			EndIf;
		EndDo;
		RoleKey = StrConcat(Present, ",");
		If RoleSet = Undefined Then
			RoleSet = RoleKey;
		ElsIf RoleSet <> RoleKey Then
			Return Undefined;
		EndIf;
		If Result.Table = Undefined Then
			Result.Table = Carrier.Table;
		ElsIf Result.Table <> Carrier.Table Then
			Result.Table = "";
		EndIf;
		If Carrier.Roles.Get("_PN") <> Undefined Then
			Result.OwnNumber = Result.OwnNumber + 1;
		EndIf;
		Result.Numbered = Result.Numbered Or Carrier.Numbered Or Carrier.Roles.Get("_PN") <> Undefined;
		Result.Loose = Result.Loose Or Carrier.Loose;
		Result.Carriers.Add(Carrier);
	EndDo;
	If RoleSet = Undefined Then
		Return Undefined;
	EndIf;
	Result.Roles = StrSplit(RoleSet, ",", False);
	If Result.Table = Undefined Then
		Result.Table = "";
	EndIf;
	Return Result;

EndFunction

// РАЗЛИЧНЫЕ над выражением с колонкой-представлением временной таблицы или вложенного запроса: `ВЫБРАТЬ РАЗЛИЧНЫЕ
// ЕСТЬNULL(ВТ.П, "нет")`, `ВЫБОР … ТОГДА ВТ.П ИНАЧЕ "есть" КОНЕЦ`. Замеры da14, db12 (21.11.2026, УХ): платформа
// выводит такое выражение значением с тегом - `CASE … THEN 0x08 ELSE 0x05 END`, строка, ссылка, поле показа, номер
// ветви - и DISTINCT различает строки по ссылке (217 строк при 6 одинаковых наименованиях, по тексту 211). Частей
// такого значения перевод не строит; если сама колонка выбрана рядом, её ссылка уже различает строки.
Procedure RefuseDistinctOverCarried(Blocks)

	For Each Block In Blocks Do
		Own = Block.Context;
		If Block.Operator.SelectDistinct Then
			For Each Pair In Own.MixedPresentations Do
				For Each Info In Own.SelectedInfo Do
					If Not Info.Aggregate And MentionsWholeColumn(Info.Expression, Pair.Key) Then
						Raise MixedPresentationRefusal(Pair.Value, "tells the rows of SELECT DISTINCT apart");
					EndIf;
				EndDo;
			EndDo;
		EndIf;
		If Not Block.Operator.SelectDistinct Or Own.CarriedPresentations.Count() = 0 Then
			Continue;
		EndIf;
		For Each Pair In Own.CarriedPresentations Do
			Bare = False;
			Inside = "";
			For Each Info In Own.SelectedInfo Do
				If Info.Expression = Pair.Key Then
					Bare = True;
				ElsIf Not Info.Aggregate And MentionsWholeColumn(Info.Expression, Pair.Key) Then
					Inside = Info.Name;
				EndIf;
			EndDo;
			If Not Bare And Not IsBlankString(Inside) Then
				Raise StrTemplate(
					"SELECT DISTINCT with column %1 computed over the presentation of a reference kept in a temporary"
					+ " table or a nested query. The platform returns such an expression as a value with a type tag -"
					+ " the reference with its description beside the string - and DISTINCT tells the rows apart by"
					+ " the reference (measured); the text alone would merge different objects that share a"
					+ " description. This translation does not build the parts of such a value. Select the presentation"
					+ " column itself as well, or the reference.", Inside);
			EndIf;
		EndDo;
	EndDo;

EndProcedure

// Колонка запроса в одних ветвях - представление ссылки, в других - строка или иное значение; либо читает такую же
// колонку временной таблицы. Замеры db15, de8 (21.11.2026, УХ): платформа держит её значением с тегом (`CASE WHEN
// … IS NOT NULL THEN 0x08 END, …` рядом с `0x05`) и различает, группирует и сравнивает по частям.
Function MixedPresentationColumn(Blocks, Position, Query = Undefined, Unvalued = "")

	UnvaluedBranch = "";
	Carriers = 0;
	Others = 0;
	For Each Block In Blocks Do
		Own = Block.Context;
		Info = Own.SelectedInfo[Position];
		If Own.MixedPresentations.Get(Info.Expression) <> Undefined Then
			Return True;
		EndIf;
		If Upper(TrimAll(Info.Expression)) = "NULL" Then
			Continue;
		EndIf;
		If Not Info.Aggregate And PresentationCarrier(Own, Info.Expression) <> Undefined Then
			Carriers = Carriers + 1;
		ElsIf Blocks.Count() > 1 And Not Info.Aggregate And IsStringBranch(Own, Block.Operator, Position, Query) Then
			// Строка рядом с представлением переводится спутниками (ColumnPresentationCarriers).
			Continue;
		Else
			Others = Others + 1;
			Field = BranchFieldText(Query, Block.Operator, Position, "");
			If StrStartsWith(Field, "&") And StrFind(Field, " ") = 0
				And HierarchyParameterValue(Mid(Field, 2), Own) = Undefined Then
				UnvaluedBranch = Field;
			EndIf;
		EndIf;
	EndDo;
	Unvalued = UnvaluedBranch;
	Return Carriers > 0 And Others > 0;

EndFunction

// Отказ там, где колонку «представление ссылки либо строка» различают, группируют, сравнивают или сливают.
Function MixedPresentationRefusal(Name, Use)

	// Имя с параметром ветви через перевод строки: ветвь - параметр без значения (УХ 3225), и строка это или ссылка,
	// решает значение - отказ «нет значения параметра».
	If StrFind(Name, Chars.LF) > 0 Then
		Pair = StrSplit(Name, Chars.LF);
		Return StrTemplate("Column %1 is the presentation of a reference in some branches of a union and %2 in another,"
			+ " and the platform %3 by the parts of such a value: whether %2 is a string or a reference decides those parts,"
			+ " and no value is supplied. Supply the value of %2.", Pair[0], Pair[1], Use);
	EndIf;

	Return StrTemplate(
		"Column %1 is the presentation of a reference in some branches of a union and a string in others. The platform"
		+ " keeps such a column as a value with a type tag - the reference (tag 0x08) with its description beside the"
		+ " string (tag 0x05) - and %2 by those parts (measured). This translation keeps only the text, which would"
		+ " merge a presentation with an equal string and different objects that share a description - silently."
		+ " Select the reference and the string as two columns.", Name, Use);

EndFunction

// Спутник колонки-представления у ветви без значения (NULL): тип - как у настоящего спутника.
Function EmptyPresentationCompanion(Role)

	If Role = "_PN" Then
		Return "CAST(-1 AS NUMERIC(10, 0))";
	EndIf;
	Return "CAST(NULL AS BINARY(" + ?(Role = "_PTYPE", "1", ?(Role = "_PRTRef", "4", "16")) + "))";

EndFunction

// Представление ссылки во временной таблице и вложенном запросе. Замеры da1-da25, db1-db15, dc1-dc9, de4-de8, df2,
// df6, df7 (21.11.2026, УХ): колонка `ПРЕДСТАВЛЕНИЕ(ссылка)`, `ПРЕДСТАВЛЕНИЕССЫЛКИ(ссылка)` и
// `ссылка.Представление` у платформы - сама ссылка и поле показа (`INSERT INTO #tt (…_00RRef, …_01) SELECT
// T1._IDRRef, T2._Description`; у документа - ссылка, номер и дата, dc1; у составной ссылки - три её части без
// текста, db5), и всё, что читает колонку дальше, идёт по ссылке: `SELECT DISTINCT …_00RRef, …_01`, `GROUP BY
// …_00RRef, …_01`, `ON (T1.…_00RRef = T2.…_00RRef AND T1.…_01 = T2.…_01)` - 217 строк при 6 одинаковых
// наименованиях, а по одному тексту 211 и 229. В ОБЪЕДИНИТЬ ВСЕ у функции ПРЕДСТАВЛЕНИЕ ещё и номер ветви (dc9,
// de4, de7, df6: `…, @P1 … UNION ALL …, @P4`; РАЗЛИЧНЫЕ не склеивает один объект из разных ветвей - 434 строки из
// 2 × 217), у ветви NULL он отрицательный (dc8); у поля через точку (df7) и в ОБЪЕДИНИТЬ без ВСЕ (df2) номера нет.
// Здесь текст представления остаётся колонкой запроса, а ссылка, её части и номер ветви идут рядом
// колонками-спутниками <имя>_PTYPE, _PRTRef, _PRRRef, _PN; читающий запрос узнаёт их по описанию таблицы
// (PresentationCompanions, NoteCarriedPresentation). Спутники не ставятся, когда у ветвей объединения колонка разного
// рода (представление рядом со строкой, составная ссылка рядом с одиночной - у платформы это значение с тегом,
// db15, de8) - там перевод прежний, по тексту. Только MS SQL.
Procedure CarryPresentationReferences(Query, Blocks, Opt)

	If Opt.Dialect = "PostgreSQL" Or Blocks.Count() = 0 Then
		Return;
	EndIf;
	If Not Opt.Property("PresentationCompanions") Then
		Opt.Insert("PresentationCompanions", New Map);
	EndIf;
	Carried = New Map;
	Opt.PresentationCompanions.Insert(Query, Carried);
	First = Blocks[0].Context;
	Width = First.SelectedInfo.Count();
	AllUnionAll = True;
	For Index = 0 To Blocks.Count() - 1 Do
		If Blocks[Index].Context.SelectedInfo.Count() <> Width Then
			Return;
		EndIf;
		If Index > 0 And Query.Operators[Index].UnionType <> QuerySchemaUnionType.UnionAll Then
			AllUnionAll = False;
		EndIf;
	EndDo;
	For Position = 0 To Width - 1 Do
		Name = First.SelectedInfo[Position].Name;
		If IsBlankString(Name) Then
			Continue;
		EndIf;
		Unvalued = "";
		If MixedPresentationColumn(Blocks, Position, Query, Unvalued) Then
			Shown = ?(IsBlankString(Unvalued), Name, Name + Chars.LF + Unvalued);
			If Blocks.Count() > 1 And Not AllUnionAll Then
				Raise MixedPresentationRefusal(Shown, "merges the rows of a UNION");
			EndIf;
			Carried.Insert(Upper(Name), New Structure("Name, Roles, Text, Table, Loose, Mixed, Strings", Shown, New Array,
				False, "", False, True, False));
			Continue;
		EndIf;
		Found = ColumnPresentationCarriers(Blocks, Position, Query);
		If Found = Undefined Then
			Continue;
		EndIf;
		If Blocks.Count() > 1 And Not AllUnionAll And Found.OwnNumber > 0 Then
			// Колонка с номером ветви в ОБЪЕДИНИТЬ без ВСЕ - не замерено.
			Continue;
		EndIf;
		Roles = Found.Roles;
		If (Blocks.Count() = 1 And Found.OwnNumber > 0) Or (Blocks.Count() > 1 And AllUnionAll And Found.Numbered) Then
			Roles.Add("_PN");
		EndIf;
		For Index = 0 To Blocks.Count() - 1 Do
			Block = Blocks[Index];
			Own = Block.Context;
			Carrier = Found.Carriers[Index];
			For Each Role In Roles Do
				If Carrier = Undefined Then
					Piece = EmptyPresentationCompanion(Role);
				ElsIf Role <> "_PN" Then
					Piece = Carrier.Roles.Get(Role);
				ElsIf Blocks.Count() = 1 Then
					Piece = Carrier.Roles.Get(Role);
				ElsIf Carrier.Roles.Get(Role) = Undefined Then
					Piece = "CAST(" + Format(Index * 1000, "NG=0; NZ=0") + " AS NUMERIC(10, 0))";
				Else
					Piece = "CAST(" + Carrier.Roles.Get(Role) + " + " + Format(Index * 1000, "NG=0; NZ=0")
						+ " AS NUMERIC(10, 0))";
				EndIf;
				Block.Fields = Block.Fields + "," + Chars.LF + "  " + Piece + " AS " + QuoteIdentifier(Name + Role, Own);
				If Index = 0 Then
					First.OutputNames.Add(QuoteIdentifier(Name + Role, Own));
				EndIf;
				If Carrier <> Undefined And MentionsColumn(Piece) Then
					If Own.PlacementParts.Find(Piece) = Undefined Then
						Own.PlacementParts.Add(Piece);
					EndIf;
					If Block.Group.Count() > 0 And Block.Group.Find(Piece) = Undefined Then
						Block.Group.Add(Piece);
					EndIf;
				EndIf;
			EndDo;
		EndDo;
		Carried.Insert(Upper(Name), New Structure("Name, Roles, Text, Table, Loose, Mixed, Strings", Name, Roles,
			Roles.Find("_PTYPE") = Undefined, Found.Table, Found.Loose, False, Found.Strings));
	EndDo;

EndProcedure

// ОБЪЕДИНИТЬ без ВСЕ в итоговом запросе с колонкой-представлением. Замеры da13, df1 (21.11.2026, УХ): `SELECT
// T1.…_00RRef, T1.…_01 FROM #tt … UNION SELECT T2.…_00RRef, T2.…_01 …`, у функции ПРЕДСТАВЛЕНИЕ прямо в ветвях -
// `SELECT T1._IDRRef … UNION SELECT T2._IDRRef …`: строки сливаются по ссылке, 217 строк, а по тексту 211. Ссылка
// идёт скрытой колонкой каждой ветви, как у РАЗЛИЧНЫЕ (DistinctPresentationColumns), и внешний SELECT её не
// показывает. Ветви с РАЗЛИЧНЫЕ, колонка со своим номером ветви - прежний путь. Отдаёт Hidden.
Function UnionPresentationKeys(Query, Blocks, Hidden)

	If Blocks.Count() < 2 Or Blocks[0].Context.Options.Dialect = "PostgreSQL" Then
		Return Hidden;
	EndIf;
	Plain = False;
	Width = Blocks[0].Context.SelectedInfo.Count();
	For Index = 0 To Blocks.Count() - 1 Do
		If Blocks[Index].Context.SelectedInfo.Count() <> Width Or Blocks[Index].Operator.SelectDistinct Then
			Return Hidden;
		EndIf;
		If Index > 0 And Query.Operators[Index].UnionType <> QuerySchemaUnionType.UnionAll Then
			Plain = True;
		EndIf;
	EndDo;
	If Not Plain Then
		Return Hidden;
	EndIf;
	Result = Hidden;
	Number = 0;
	For Position = 0 To Width - 1 Do
		Unvalued = "";
		If MixedPresentationColumn(Blocks, Position, Query, Unvalued) Then
			Raise MixedPresentationRefusal(Blocks[0].Context.SelectedInfo[Position].Name
				+ ?(IsBlankString(Unvalued), "", Chars.LF + Unvalued), "merges the rows of a UNION");
		EndIf;
		Found = ColumnPresentationCarriers(Blocks, Position, Query);
		If Found = Undefined Or Found.OwnNumber > 0 Then
			Continue;
		EndIf;
		For Each Role In Found.Roles Do
			Number = Number + 1;
			Name = QuoteIdentifier("Q2SUnionRef" + Format(Number, "NG=0"), Blocks[0].Context);
			For Index = 0 To Blocks.Count() - 1 Do
				Block = Blocks[Index];
				Carrier = Found.Carriers[Index];
				Piece = ?(Carrier = Undefined, EmptyPresentationCompanion(Role), Carrier.Roles.Get(Role));
				Block.Fields = Block.Fields + "," + Chars.LF + "  " + Piece + " AS " + Name;
				If Carrier <> Undefined And MentionsColumn(Piece) And Block.Group.Count() > 0
					And Block.Group.Find(Piece) = Undefined Then
					Block.Group.Add(Piece);
				EndIf;
			EndDo;
			If Result = Undefined Then
				Result = New Map;
			EndIf;
			Names = New Array;
			Names.Add(Name);
			Result.Insert("Union" + Format(Number, "NG=0"), Names);
		EndDo;
	EndDo;
	Return Result;

EndFunction

// Спутники колонок-представлений запроса - в описание временной таблицы или вложенного запроса.
Procedure NotePresentationCompanions(Descriptor, Definition, Opt)

	Found = Undefined;
	If Opt.Property("PresentationCompanions") Then
		Found = Opt.PresentationCompanions.Get(Definition);
	EndIf;
	Descriptor.Insert("PresentationCompanions", Found);

EndProcedure

// Одинаков ли состав спутников у таблицы и у запроса, который в неё добавляет (ДОБАВИТЬ).
Function SamePresentationCompanions(Descriptor, Definition, Opt)

	Known = Undefined;
	If Descriptor.Property("PresentationCompanions") Then
		Known = Descriptor.PresentationCompanions;
	EndIf;
	Added = Undefined;
	If Opt.Property("PresentationCompanions") Then
		Added = Opt.PresentationCompanions.Get(Definition);
	EndIf;
	KnownCount = ?(Known = Undefined, 0, Known.Count());
	AddedCount = ?(Added = Undefined, 0, Added.Count());
	If KnownCount <> AddedCount Then
		Return False;
	EndIf;
	If KnownCount = 0 Then
		Return True;
	EndIf;
	For Each Pair In Known Do
		Mate = Added.Get(Pair.Key);
		If Mate = Undefined Or StrConcat(Mate.Roles, ",") <> StrConcat(Pair.Value.Roles, ",") Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Колонка производной таблицы, прочитанная выражением: если это колонка-представление со спутниками, её ссылка
// запоминается - по ней группируют (OperatorBlock), различают (DistinctPresentationColumns), сравнивают и
// упорядочивают, и её же несёт дальше следующая временная таблица (CarryPresentationReferences).
Procedure NoteCarriedPresentation(Resolved, Column, Context)

	If Not Resolved.Descriptor.Property("PresentationCompanions") Or Resolved.Descriptor.PresentationCompanions = Undefined Then
		Return;
	EndIf;
	Entry = Resolved.Descriptor.PresentationCompanions.Get(Upper(TrimAll(Resolved.FieldName)));
	If Entry = Undefined Then
		Return;
	EndIf;
	If Entry.Mixed Then
		Context.MixedPresentations.Insert(Column, Entry.Name);
		Return;
	EndIf;
	Roles = New Map;
	Ordered = New Array;
	For Each Role In Entry.Roles Do
		Companion = Resolved.Alias + "." + QuoteIdentifier(Entry.Name + Role, Context);
		Roles.Insert(Role, Companion);
		Ordered.Add(Companion);
	EndDo;
	Context.CarriedPresentations.Insert(Column, New Structure("Roles, Text, Table, Loose", Roles, Entry.Text,
		Entry.Table, Entry.Loose));
	Context.PresentationGrouping.Insert(Column, Ordered[0]);
	If Ordered.Count() > 1 Then
		Context.CompositePresentations.Insert(Column, Ordered);
	EndIf;

EndProcedure

// Операнд - колонка-представление временной таблицы или вложенного запроса со спутниками: её текст SQL, спутники
// по ролям, Text - сравнивается и текст (ссылка одной таблицы), Table - таблица ссылки. Undefined - не такая колонка.
Function CarriedPresentationOperand(Path, Context)

	Trimmed = TrimAll(Path);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrSplit(Trimmed, ".", False).Count() <> 2 Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Undefined;
	EndTry;
	If Resolved.Descriptor = Undefined Or Not Resolved.Descriptor.IsDerived Or Not IsBlankString(Resolved.CompositeSegment)
		Or Not Resolved.Descriptor.Property("PresentationCompanions")
		Or Resolved.Descriptor.PresentationCompanions = Undefined
		Or Resolved.Descriptor.PresentationCompanions.Get(Upper(TrimAll(Resolved.FieldName))) = Undefined Then
		Return Undefined;
	EndIf;
	Sql = FieldReference(Trimmed, Context);
	Entry = Context.CarriedPresentations.Get(Sql);
	If Entry = Undefined Then
		Return Undefined;
	EndIf;
	Return New Structure("Sql, Roles, Text, Table, Loose", Sql, Entry.Roles, Entry.Text, Entry.Table, Entry.Loose);

EndFunction

// Имя колонки «представление ссылки либо строка» по пути к колонке производной таблицы; пустая строка - не она.
Function MixedPresentationName(Path, Context)

	Trimmed = TrimAll(Path);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrSplit(Trimmed, ".", False).Count() <> 2 Then
		Return "";
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return "";
	EndTry;
	If Resolved.Descriptor = Undefined Or Not Resolved.Descriptor.IsDerived Or Not IsBlankString(Resolved.CompositeSegment)
		Or Not Resolved.Descriptor.Property("PresentationCompanions")
		Or Resolved.Descriptor.PresentationCompanions = Undefined Then
		Return "";
	EndIf;
	Entry = Resolved.Descriptor.PresentationCompanions.Get(Upper(TrimAll(Resolved.FieldName)));
	If Entry <> Undefined And Entry.Property("Strings") And Entry.Strings Then
		// Строки в ветвях: спутники у них NULL, равенство по спутникам ложно - сравнение не переводится.
		Return Entry.Name;
	EndIf;
	Return ?(Entry = Undefined Or Not Entry.Mixed, "", Entry.Name);

EndFunction

// Отказ сравнения колонок-представлений в незамеренном сочетании.
Function CarriedPresentationRefusal(LeftPath, RightPath, Reason)

	Return StrTemplate(
		"%1 and %2 are columns of a temporary table or a nested query that hold presentations of references, and the"
		+ " platform compares such columns by the references behind them, not by the text (measured). This"
		+ " combination - %3 - has not been measured, so it is not translated. Put the references themselves into"
		+ " the table and compare them.", TrimAll(LeftPath), TrimAll(RightPath), Reason);

EndFunction

// `ВТ.П = ВТ2.П`, `ВТ.П <> ВТ2.П`, `ВТ.П ЕСТЬ [НЕ] NULL` над колонками-представлениями со спутниками. Замеры
// (21.11.2026, УХ): da3, da21 - `ссылка = ссылка AND поле показа = поле показа`; db1 - `(ссылка <> ссылка) OR (поле
// <> поле)`; de4 - у колонок с номером ветви ещё `номер = номер`, de5 - с номером только у одной стороны он не
// сравнивается; dc6 - ссылки разных таблиц: `CASE WHEN а IS NOT NULL THEN <таблица а> END = CASE WHEN б IS NOT NULL
// THEN <таблица б> END AND …`; db6 - составная ссылка: три части попарно, без текста; dc5 - составная против ссылки
// одной таблицы: `_TYPE = 0x08 AND _RTRef = <таблица> AND _RRRef = ссылка`; da8, de6, de14 - `ссылка IS NULL`; dc3 -
// у составной все три части IS NULL. Сравнение такой колонки со строкой, ПОДСТРОКА, ПОДОБНО, `+`, МАКСИМУМ и
// КОЛИЧЕСТВО над ней платформа отвергает сама (da5, da6, da10, da12, db2, dc7). Undefined - не этот случай.
Function CarriedPresentationConditionSql(Tokens, Index, Context, Consumed)

	Token = Tokens[Index];
	If Token.Kind <> "Name" Or StrFind(Token.Value, ".") = 0 Or Index + 2 > Tokens.Count() - 1
		Or Context.CarriedPresentations = Undefined Or Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Sign = Tokens[Index + 1];
	Word = Upper(Sign.Value);
	If Sign.Kind = "Name" And (Word = "IS" Or Word = Upper("Есть")) Then
		Last = Index + 2;
		Negated = False;
		Word = Upper(Tokens[Last].Value);
		If Word = "NOT" Or Word = Upper("Не") Then
			Negated = True;
			Last = Last + 1;
			If Last > Tokens.Count() - 1 Then
				Return Undefined;
			EndIf;
		EndIf;
		If Upper(Tokens[Last].Value) <> "NULL" Then
			Return Undefined;
		EndIf;
		Operand = CarriedPresentationOperand(Token.Value, Context);
		If Operand = Undefined Then
			Return Undefined;
		EndIf;
		Tests = New Array;
		For Each Role In CarriedPresentationRoles() Do
			Part = Operand.Roles.Get(Role);
			If Part <> Undefined And Role <> "_PN" Then
				Tests.Add(Part + " IS NULL");
			EndIf;
		EndDo;
		Consumed = Last - Index + 1;
		Return ?(Negated, "NOT ", "") + "(" + StrConcat(Tests, " AND ") + ")";
	EndIf;
	If Sign.Kind <> "Symbol" Or (Sign.Value <> "=" And Sign.Value <> "<>") Or Tokens[Index + 2].Kind <> "Name"
		Or StrFind(Tokens[Index + 2].Value, ".") = 0 Or Not RightIsBoundary(Tokens, Index + 2) Then
		Return Undefined;
	EndIf;
	Left = CarriedPresentationOperand(Token.Value, Context);
	Right = CarriedPresentationOperand(Tokens[Index + 2].Value, Context);
	MixedSides = 0;
	MixedName = "";
	For Each Side In StrSplit(Token.Value + "," + Tokens[Index + 2].Value, ",", False) Do
		Found = MixedPresentationName(Side, Context);
		If Not IsBlankString(Found) Then
			MixedSides = MixedSides + 1;
			MixedName = Found;
		EndIf;
	EndDo;
	If MixedSides = 2 Or (MixedSides = 1 And (Left <> Undefined Or Right <> Undefined)) Then
		Raise MixedPresentationRefusal(MixedName, "compares it");
	EndIf;
	If Left = Undefined Or Right = Undefined Then
		Return Undefined;
	EndIf;
	Equal = Sign.Value = "=";
	If Left.Loose Or Right.Loose Then
		Raise CarriedPresentationRefusal(Token.Value, Tokens[Index + 2].Value,
			"a composite reference that can also hold a string, a number, a date or a boolean");
	EndIf;
	Tests = New Array;
	If Left.Text And Right.Text Then
		If Not IsBlankString(Left.Table) And Not IsBlankString(Right.Table)
			And ReferenceTypeIdLiteral(Left.Table, Context) <> ReferenceTypeIdLiteral(Right.Table, Context) Then
			If Not Equal Then
				Raise CarriedPresentationRefusal(Token.Value, Tokens[Index + 2].Value,
					"<> between references of different tables");
			EndIf;
			Tests.Add("CASE WHEN " + Left.Roles.Get("_PRRRef") + " IS NOT NULL THEN "
				+ ReferenceTypeIdLiteral(Left.Table, Context) + " END = CASE WHEN " + Right.Roles.Get("_PRRRef")
				+ " IS NOT NULL THEN " + ReferenceTypeIdLiteral(Right.Table, Context) + " END");
		EndIf;
		Tests.Add(Left.Roles.Get("_PRRRef") + " " + Sign.Value + " " + Right.Roles.Get("_PRRRef"));
		Tests.Add(Left.Sql + " " + Sign.Value + " " + Right.Sql);
		If Left.Roles.Get("_PN") <> Undefined And Right.Roles.Get("_PN") <> Undefined Then
			Tests.Add(Left.Roles.Get("_PN") + " " + Sign.Value + " " + Right.Roles.Get("_PN"));
		EndIf;
	ElsIf Not Left.Text And Not Right.Text Then
		For Each Role In StrSplit("_PTYPE,_PRTRef,_PRRRef", ",", False) Do
			Tests.Add(Left.Roles.Get(Role) + " " + Sign.Value + " " + Right.Roles.Get(Role));
		EndDo;
	Else
		Composite = ?(Left.Text, Right, Left);
		Single = ?(Left.Text, Left, Right);
		If Not Equal Or IsBlankString(Single.Table) Then
			Raise CarriedPresentationRefusal(Token.Value, Tokens[Index + 2].Value,
				?(Equal, "a composite reference against a reference whose table is not known here",
				"<> between a composite reference and a reference of one table"));
		EndIf;
		Tests.Add(Composite.Roles.Get("_PTYPE") + " = " + BinaryLiteral(HexLiteral(8, 2), Context));
		Tests.Add(Composite.Roles.Get("_PRTRef") + " = " + ReferenceTypeIdLiteral(Single.Table, Context));
		Tests.Add(Composite.Roles.Get("_PRRRef") + " = " + Single.Roles.Get("_PRRRef"));
	EndIf;
	Consumed = 3;
	Return "(" + StrConcat(Tests, ?(Equal, " AND ", " OR ")) + ")";

EndFunction

// УПОРЯДОЧИТЬ ПО колонке-представлению со спутниками. Замеры da9, db10, db14, de7, dc4, df8 (21.11.2026, УХ):
// `ORDER BY (T1.…_00RRef), (T1.…_01)` - ссылка, потом поле показа, у колонки с номером ветви ещё и он (`ORDER BY 1,
// 2, 3`), у составной ссылки - три её части. По тексту порядок другой, и ПЕРВЫЕ отбирает другие строки. Только
// одиночный оператор без РАЗЛИЧНЫЕ: в объединении и РАЗЛИЧНЫЕ T-SQL упорядочивает по колонкам выборки.
// Undefined - не этот случай.
Function CarriedPresentationOrderKeys(Query, Item, Context)

	If Query.Operators.Count() <> 1 Or Query.Operators[0].SelectDistinct Then
		Return Undefined;
	EndIf;
	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = Undefined;
	EndTry;
	Text = "";
	If Alias = Undefined Then
		Text = TrimAll(String(Item));
	Else
		Fields = Query.Operators[0].SelectedFields;
		For Index = 0 To Min(Fields.Count(), Query.Columns.Count()) - 1 Do
			If Upper(TrimAll(Query.Columns[Index].Alias)) = Upper(TrimAll(Alias)) Then
				Text = TrimAll(String(Fields[Index]));
				Break;
			EndIf;
		EndDo;
	EndIf;
	If IsBlankString(Text) Then
		Return Undefined;
	EndIf;
	Operand = CarriedPresentationOperand(Text, Context);
	If Operand = Undefined Then
		Return Undefined;
	EndIf;
	Keys = New Array;
	For Each Role In StrSplit("_PTYPE,_PRTRef,_PRRRef", ",", False) Do
		If Operand.Roles.Get(Role) <> Undefined Then
			Keys.Add(Operand.Roles.Get(Role));
		EndIf;
	EndDo;
	If Operand.Text Then
		Keys.Add(Operand.Sql);
	EndIf;
	If Operand.Roles.Get("_PN") <> Undefined Then
		Keys.Add(Operand.Roles.Get("_PN"));
	EndIf;
	Return Keys;

EndFunction

// РАЗЛИЧНЫЕ с представлением ссылки в выборке. Замер op2, op6, op7 (20.11.2026, УХ): колонка представления у
// платформы - ссылка и поле показа (`SELECT DISTINCT T1._IDRRef, T1._Description`; у ПРЕДСТАВЛЕНИЕ(К.Ссылка) -
// `T1._IDRRef, T2._Description` через LEFT JOIN), и DISTINCT различает строки по ссылке: 217 строк при 6
// одинаковых наименованиях. Перевод по одному тексту склеивал их (49z3: 211). Ссылка, которой нет среди колонок,
// выводится скрытой колонкой, как ключи ИЕРАРХИИ, и внешний SELECT её не показывает. Во временной таблице так же
// (замер dt1, 20.11.2026, УХ: `INSERT INTO #tt1 (_Q_001_F_000_00RRef, _Q_001_F_000_01) SELECT DISTINCT T1._IDRRef,
// T1._Description`, 217 строк): ВТ здесь - общее табличное выражение, и внешний SELECT по OutputNames оставляет в
// нём только колонки запроса, поэтому чтение ВТ и `SELECT *` у ДОБАВИТЬ скрытой колонки не видят. ВТ с
// УПОРЯДОЧИТЬ ПО - отказ: обёртка вынесла бы ORDER BY за подзапрос, а в CTE он без TOP недопустим. Вложенный
// запрос, объединение и группировка - отказ, не замерены. Составная ссылка - так же, только скрытыми колонками
// идут её части (замер px_dist, 20.11.2026, УХ: `SELECT DISTINCT T1.ValueDt1_TYPE, T1.ValueDt1_RTRef,
// T1.ValueDt1_RRRef` у ПРЕДСТАВЛЕНИЕ(СубконтоДт1); op8, px_dist2 - так же у реквизита документа).
// Представление внутри большего выражения не рассматривается. Отдаёт Hidden.
Function DistinctPresentationColumns(Query, Blocks, FinalResult, Hidden, InOperand = False)

	If InOperand Then
		// Операнд В (…): набор значений от РАЗЛИЧНЫЕ не зависит, а скрытая колонка сломала бы число колонок.
		Return Hidden;
	EndIf;
	If Blocks.Count() > 1 Then
		Return UnionDistinctPresentationColumns(Query, Blocks, FinalResult, Hidden);
	EndIf;
	Result = Hidden;
	Number = 0;
	For Each Block In Blocks Do
		Own = Block.Context;
		If Not Block.Operator.SelectDistinct Then
			Continue;
		EndIf;
		Selected = New Map;
		For Each Info In Own.SelectedInfo Do
			Selected.Insert(Info.Expression, True);
		EndDo;
		For Each Column In Own.PlacementParts Do
			Selected.Insert(Column, True);
		EndDo;
		// Составное представление: строки различаются частями ссылки (op8, px_dist). Если все части выбраны (сама
		// ссылка в выборке), DISTINCT их и так учитывает; иначе недостающие части идут скрытыми колонками ниже.
		// При группировке вместо РАЗЛИЧНЫЕ - отказ: там в GROUP BY попал бы один тег (ревью L1, L2).
		MissingParts = New Array;
		For Each Info In Own.SelectedInfo Do
			Parts = ?(Info.Aggregate, Undefined, Own.CompositePresentations.Get(Info.Expression));
			If Parts = Undefined Then
				Continue;
			EndIf;
			For Each Part In Parts Do
				If Selected.Get(Part) = Undefined And MissingParts.Find(Part) = Undefined Then
					MissingParts.Add(Part);
				EndIf;
			EndDo;
		EndDo;
		Placed = Not IsBlankString(Query.PlacementTable);
		// Во ВТ порядок бывает только с ПЕРВЫЕ (без них платформа запрос отвергает, замер p8e), и стоит он внутри
		// обёртки, где скрытая колонка видна.
		Reachable = FinalResult
			Or (Placed And (Query.Order.Count() = 0 Or Block.Operator.RetrievedRecordsCount <> Undefined));
		// С группировкой ссылка и её части - ключи группировки (замер p8g, p8h, 21.11.2026, УХ: `SELECT DISTINCT …,
		// _TYPE, _RTRef, _RRRef, MIN(…) … GROUP BY …, _TYPE, _RTRef, _RRRef`), и скрытой колонкой их выбрать можно.
		Grouped = GroupCount(Block.Operator) > 0 Or SelectionHasAggregate(Block.Operator);
		If Grouped And MissingParts.Count() > 0 And Not Own.GroupInsteadOfDistinct Then
			// Группировка по ПРЕДСТАВЛЕНИЕ(составной ссылки) заявляет первую часть; платформа группирует по всем
			// (замер gp2, p8g), и остальные части такого представления - тоже ключи.
			For Each Info In Own.SelectedInfo Do
				Parts = ?(Info.Aggregate, Undefined, Own.CompositePresentations.Get(Info.Expression));
				If Parts = Undefined Or Parts.Count() = 0 Or Block.Group.Find(Parts[0]) = Undefined Then
					Continue;
				EndIf;
				For Each Part In Parts Do
					If Block.Group.Find(Part) = Undefined Then
						Block.Group.Add(Part);
					EndIf;
				EndDo;
			EndDo;
		EndIf;
		If MissingParts.Count() > 0 And (Own.GroupInsteadOfDistinct Or Not Reachable
			Or (Grouped And Not AllInGroup(MissingParts, Block.Group))) Then
			Raise DistinctPresentationRefusal(True);
		EndIf;
		For Each Part In MissingParts Do
			Number = Number + 1;
			Name = QuoteIdentifier("Q2SDistinctRef" + Format(Number, "NG=0"), Own);
			Block.Fields = Block.Fields + "," + Chars.LF + "  " + Part + " AS " + Name;
			If Result = Undefined Then
				Result = New Map;
			EndIf;
			Names = New Array;
			Names.Add(Name);
			Result.Insert("Distinct" + Format(Number, "NG=0"), Names);
			Selected.Insert(Part, True);
		EndDo;
		If Own.GroupInsteadOfDistinct Then
			// Группировка вместо РАЗЛИЧНЫЕ уже получает ссылку представления (OperatorBlock, PresentationGrouping).
			Continue;
		EndIf;
		Missing = New Array;
		For Each Info In Own.SelectedInfo Do
			If Info.Aggregate Or Own.CompositePresentations.Get(Info.Expression) <> Undefined Then
				Continue;
			EndIf;
			Reference = Own.PresentationGrouping.Get(Info.Expression);
			If Reference = Undefined Or Selected.Get(Reference) <> Undefined Or Missing.Find(Reference) <> Undefined Then
				Continue;
			EndIf;
			Missing.Add(Reference);
		EndDo;
		If Missing.Count() = 0 Then
			Continue;
		EndIf;
		If Not Reachable Or (Grouped And Not AllInGroup(Missing, Block.Group)) Then
			Raise DistinctPresentationRefusal(False);
		EndIf;
		For Each Reference In Missing Do
			Number = Number + 1;
			Name = QuoteIdentifier("Q2SDistinctRef" + Format(Number, "NG=0"), Own);
			Block.Fields = Block.Fields + "," + Chars.LF + "  " + Reference + " AS " + Name;
			If Result = Undefined Then
				Result = New Map;
			EndIf;
			Names = New Array;
			Names.Add(Name);
			Result.Insert("Distinct" + Format(Number, "NG=0"), Names);
		EndDo;
	EndDo;
	Return Result;

EndFunction

// УПОРЯДОЧИТЬ ПО …Представление в объединении. Замер op4b, p8i (20-21.11.2026, УХ): каждая ветвь выбирает ссылку
// представления скрытой колонкой - при ссылках одной таблицы одну ссылку, при разных ещё и таблицу константой
// (`0x0000002F AS C_2, T1._IDRRef AS C_3`), - и объединение упорядочено по ним (`ORDER BY 2, 3` и `2, 3, 4`); поле
// показа от ссылки зависит. Здесь те же скрытые колонки и внешний SELECT без них. Только итог запроса без группировки
// и ссылка одного типа в каждой ветви; иначе отказ PresentationOrderSource.
Function UnionPresentationHiddenColumns(Query, Blocks, FinalResult, Hidden)

	If Not FinalResult Or Not IsBlankString(Query.PlacementTable) Then
		Return Hidden;
	EndIf;
	For Each Block In Blocks Do
		If GroupCount(Block.Operator) > 0 Or SelectionHasAggregate(Block.Operator) Or Block.Context.GroupInsteadOfDistinct Then
			Return Hidden;
		EndIf;
	EndDo;
	Result = Hidden;
	ItemIndex = -1;
	Number = 0;
	For Each OrderItem In Query.Order Do
		ItemIndex = ItemIndex + 1;
		If IsHierarchyOrder(OrderItem) Or (Result <> Undefined And Result.Get(ItemIndex) <> Undefined) Then
			Continue;
		EndIf;
		ColumnIndex = HierarchyColumnIndex(Query, OrderItem.Item);
		If ColumnIndex = Undefined Then
			Continue;
		EndIf;
		Sources = New Array;
		Tables = New Map;
		For Each Block In Blocks Do
			Field = TrimAll(ColumnFieldText(Query, Block.Operator, ColumnIndex));
			Text = PresentationPathOfText(Field, Block.Context);
			If Text = Undefined Then
				Break;
			EndIf;
			Source = PresentationSourcePath(Text, Block.Context);
			Target = "";
			If CompositePartsOfExpression(Source, Block.Context).Parts.Count() = 0 Then
				Target = SingleReferenceTarget(Source, Block.Context);
			EndIf;
			If IsBlankString(Target) Then
				Break;
			EndIf;
			Sources.Add(New Structure("Source, Target", Source, Target));
			Tables.Insert(Upper(Target), True);
		EndDo;
		If Sources.Count() <> Blocks.Count() Then
			Continue;
		EndIf;
		Number = Number + 1;
		Names = New Array;
		If Tables.Count() > 1 Then
			Names.Add(QuoteIdentifier("Q2SPresentation" + Format(Number, "NG=0") + "Type", Blocks[0].Context));
		EndIf;
		Names.Add(QuoteIdentifier("Q2SPresentation" + Format(Number, "NG=0") + "Ref", Blocks[0].Context));
		For BlockIndex = 0 To Blocks.Count() - 1 Do
			Own = Blocks[BlockIndex].Context;
			Extra = New Array;
			If Tables.Count() > 1 Then
				Extra.Add("  " + ReferenceTypeIdLiteral(Sources[BlockIndex].Target, Own) + " AS " + Names[0]);
			EndIf;
			Extra.Add("  " + ValueExpression(Sources[BlockIndex].Source, Own) + " AS " + Names[Names.UBound()]);
			Blocks[BlockIndex].Fields = Blocks[BlockIndex].Fields + "," + Chars.LF + StrConcat(Extra, "," + Chars.LF);
		EndDo;
		If Result = Undefined Then
			Result = New Map;
		EndIf;
		Result.Insert(ItemIndex, Names);
	EndDo;
	Return Result;

EndFunction

// РАЗЛИЧНЫЕ с представлением ссылки в ветвях ОБЪЕДИНИТЬ ВСЕ. Замер p8a, p8c, p8d (21.11.2026, УХ): колонка
// представления в каждой ветви - ссылка и поле показа (у ссылок разных таблиц ещё и таблица константой), и DISTINCT
// ветви различает строки по ссылке; во временной таблице так же (`INSERT INTO #tt (…_00TRef, …_00RRef, …_01) SELECT
// DISTINCT … UNION ALL SELECT …`). Здесь ссылка недостающей колонки идёт скрытой колонкой во все ветви на одно место:
// своя ссылка ветви или NULL, если представления ссылки в этой колонке у ветви нет; внешний SELECT её не показывает.
// ОБЪЕДИНИТЬ без ВСЕ (p8b: строки разных ветвей различаются по ссылке, а у разных таблиц и по таблице), составная
// ссылка и группировка - отказ.
Function UnionDistinctPresentationColumns(Query, Blocks, FinalResult, Hidden)

	Wanted = New Map;
	Width = Blocks[0].Context.SelectedInfo.Count();
	For Each Block In Blocks Do
		If Not Block.Operator.SelectDistinct Then
			Continue;
		EndIf;
		Own = Block.Context;
		Selected = New Map;
		For Each Info In Own.SelectedInfo Do
			Selected.Insert(Info.Expression, True);
		EndDo;
		For Each Column In Own.PlacementParts Do
			Selected.Insert(Column, True);
		EndDo;
		For Position = 0 To Own.SelectedInfo.Count() - 1 Do
			Info = Own.SelectedInfo[Position];
			If Info.Aggregate Then
				Continue;
			EndIf;
			Parts = Own.CompositePresentations.Get(Info.Expression);
			If Parts <> Undefined Then
				For Each Part In Parts Do
					If Selected.Get(Part) = Undefined Then
						Raise DistinctPresentationRefusal(True);
					EndIf;
				EndDo;
				Continue;
			EndIf;
			Reference = Own.PresentationGrouping.Get(Info.Expression);
			If Reference <> Undefined And Selected.Get(Reference) = Undefined Then
				Wanted.Insert(Position, True);
			EndIf;
		EndDo;
	EndDo;
	If Wanted.Count() = 0 Then
		Return Hidden;
	EndIf;
	Refuse = Not (FinalResult Or (Not IsBlankString(Query.PlacementTable) And Query.Order.Count() = 0));
	For Index = 0 To Blocks.Count() - 1 Do
		Block = Blocks[Index];
		Refuse = Refuse Or Block.Context.SelectedInfo.Count() <> Width Or Block.Context.GroupInsteadOfDistinct
			Or GroupCount(Block.Operator) > 0 Or SelectionHasAggregate(Block.Operator)
			Or (Index > 0 And Query.Operators[Index].UnionType <> QuerySchemaUnionType.UnionAll);
	EndDo;
	If Refuse Then
		Raise DistinctPresentationRefusal(False);
	EndIf;
	Result = Hidden;
	Number = 0;
	For Position = 0 To Width - 1 Do
		If Wanted.Get(Position) = Undefined Then
			Continue;
		EndIf;
		Number = Number + 1;
		Name = QuoteIdentifier("Q2SDistinctRef" + Format(Number, "NG=0"), Blocks[0].Context);
		For Each Block In Blocks Do
			Own = Block.Context;
			Info = Own.SelectedInfo[Position];
			Reference = ?(Info.Aggregate, Undefined, Own.PresentationGrouping.Get(Info.Expression));
			If Reference = Undefined Or Own.CompositePresentations.Get(Info.Expression) <> Undefined Then
				Reference = ?(Own.Options.Dialect = "PostgreSQL", "CAST(NULL AS BYTEA)", "CAST(NULL AS BINARY(16))");
			EndIf;
			Block.Fields = Block.Fields + "," + Chars.LF + "  " + Reference + " AS " + Name;
		EndDo;
		If Result = Undefined Then
			Result = New Map;
		EndIf;
		Names = New Array;
		Names.Add(Name);
		Result.Insert("Distinct" + Format(Number, "NG=0"), Names);
	EndDo;
	Return Result;

EndFunction

// Все ли выражения - ключи группировки блока.
Function AllInGroup(Items, Group)

	For Each Item In Items Do
		If Group.Find(Item) = Undefined Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Отказ РАЗЛИЧНЫЕ с представлением ссылки без самой ссылки там, где скрытая колонка ссылки не строится.
Function DistinctPresentationRefusal(Composite)

	Return "SELECT DISTINCT with the presentation of a " + ?(Composite, "composite reference", "reference")
		+ ", without the reference itself, is translated in the final result, a temporary table and a UNION ALL,"
		+ " with grouping when the reference is a grouping key: the platform tells the rows apart by the "
		+ ?(Composite, "parts of the reference (type, table, reference)", "reference")
		+ ", and here it becomes a hidden column (measured). In a nested query the platform passes the reference out"
		+ " with the column, and the outer query groups and orders by it (measured p8f) - a hidden column cannot do"
		+ " that; a UNION without ALL tells the rows of different branches apart by the reference as well. Select"
		+ " the reference as well.";

EndFunction

// УПОРЯДОЧИТЬ ПО …Представление в одиночном РАЗЛИЧНЫЕ. Замер op1-op3 (20.11.2026, УХ): колонка представления
// у платформы - ссылка и поле показа, и обе входят в DISTINCT (op2: 217 строк при 6 одинаковых именах);
// порядок - по позиции ссылки. Здесь ссылка выводится скрытой колонкой, как ключи ИЕРАРХИИ, и порядок идёт
// по ней; поле показа от ссылки зависит, второй ключ порядка ничего не меняет. Только итог запроса, без
// группировки и с ссылкой одного типа - иные формы не замерены (op4b, op5b, op8), и для них остаётся отказ
// PresentationOrderSource. Отдаёт Hidden (индекс элемента порядка - имена колонок) или Undefined.
Function PresentationHiddenColumns(Query, Blocks, FinalResult, Hidden)

	If Blocks.Count() > 1 Then
		Return UnionPresentationHiddenColumns(Query, Blocks, FinalResult, Hidden);
	EndIf;
	Block = Blocks[0];
	// Во ВТ порядок бывает только с ПЕРВЫЕ, и он стоит внутри обёртки - там скрытая колонка видна (замер p8k).
	PlacedTop = Not IsBlankString(Query.PlacementTable) And Block.Operator.RetrievedRecordsCount <> Undefined;
	If Not (FinalResult Or PlacedTop) Or GroupCount(Block.Operator) > 0
		Or SelectionHasAggregate(Block.Operator) Or Block.Context.GroupInsteadOfDistinct Then
		Return Hidden;
	EndIf;
	Result = Hidden;
	ItemIndex = -1;
	Number = 0;
	For Each OrderItem In Query.Order Do
		ItemIndex = ItemIndex + 1;
		If IsHierarchyOrder(OrderItem) Or (Result <> Undefined And Result.Get(ItemIndex) <> Undefined) Then
			Continue;
		EndIf;
		Text = PresentationOrderPath(Query, OrderItem.Item, Block.Context);
		If Text = Undefined Then
			Continue;
		EndIf;
		Source = PresentationSourcePath(Text, Block.Context);
		If CompositePartsOfExpression(Source, Block.Context).Parts.Count() > 0 Then
			Continue;
		EndIf;
		Number = Number + 1;
		Name = QuoteIdentifier("Q2SPresentation" + Format(Number, "NG=0") + "Ref", Block.Context);
		Block.Fields = Block.Fields + "," + Chars.LF + "  " + ValueExpression(Source, Block.Context) + " AS " + Name;
		If Result = Undefined Then
			Result = New Map;
		EndIf;
		Names = New Array;
		Names.Add(Name);
		Result.Insert(ItemIndex, Names);
	EndDo;
	Return Result;

EndFunction

// Запрос, наполняющий временную таблицу, с ИЕРАРХИЕЙ в порядке платформа отвергает при исполнении (замер hn2, hn6,
// hn7, 21.11.2026, УХ: «SDBL error: Result exceeds dimensionality limits» и с ПЕРВЫЕ 3, и с ПЕРВЫЕ 10).
Function HierarchyPlacementRefusal()

	Return "ORDER BY ... HIERARCHY in a query that fills a temporary table: the platform rejects such a query when it"
		+ " runs (SDBL error ""Result exceeds dimensionality limits""), so there is no SQL to compare it with. Order the"
		+ " rows by HIERARCHY in the query that reads the temporary table.";

EndFunction

Function HierarchyColumnIndex(Query, Item)

	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = UnionOrderColumn(Query, Item);
	EndTry;
	If Alias = Undefined Then
		Return Undefined;
	EndIf;
	For Index = 0 To Query.Columns.Count() - 1 Do
		If Upper(TrimAll(Query.Columns[Index].Alias)) = Upper(TrimAll(Alias)) Then
			Return Index;
		EndIf;
	EndDo;
	Return Undefined;

EndFunction

Function OrderSql(Query, Context)

	Nested = NestedTableColumns(Query, Context);

	Hidden = Undefined;
	If Context.Property("HierarchyHidden") Then
		Hidden = Context.HierarchyHidden;
	EndIf;
	Parts = New Array;
	ItemIndex = -1;
	For Each OrderItem In Query.Order Do
		ItemIndex = ItemIndex + 1;
		// The order element keeps what is ordered by in its Item property, not in the element itself.
		If IsDroppedColumn(Query, Nested, OrderItem.Item) Then
			AddOnce(Context.Warnings, StrTemplate(
				"ORDER BY %1 is dropped: it orders a nested table or its rows, and nested"
				+ " tables are left out of the SQL. Order the rows when you query that"
				+ " tabular section separately.", TrimAll(OrderItem.Item.Alias)));
			Continue;
		EndIf;
		If OrderItem.Direction = QuerySchemaOrderDirection.HierarchyAscending
			Or OrderItem.Direction = QuerySchemaOrderDirection.HierarchyDescending Then
			If Not IsBlankString(Query.PlacementTable) Then
				Raise HierarchyPlacementRefusal();
			EndIf;
			If Not Context.FinalResult Then
				// Вложенный запрос и подзапрос: ИЕРАРХИЮ платформа отбрасывает и упорядочивает по самому полю (замер
				// hn1, hn4, hn5, hn8, 21.11.2026, УХ: `SELECT TOP 10 … ORDER BY (T2._IDRRef)`, УБЫВ - `DESC`, у
				// РАЗЛИЧНЫЕ - `ORDER BY 1`). Порядок по родителю и ссылке отбирал другие строки ПЕРВЫЕ (1С и SQL
				// расходились в выборе десяти элементов справочника).
				Direction = ?(OrderItem.Direction = QuerySchemaOrderDirection.HierarchyDescending, " DESC", "");
				ColumnIndex = HierarchyColumnIndex(Query, OrderItem.Item);
				If ColumnIndex = Undefined Then
					// Пункт порядка без псевдонима - выражение: колонка - та, что выбирает его же.
					Wanted = StrReplace(Upper(HierarchyItemText(OrderItem)), " ", "");
					For Index = 0 To Min(Query.Columns.Count(), BranchFieldCount(Query, Query.Operators[0])) - 1 Do
						If StrReplace(Upper(ColumnFieldText(Query, Query.Operators[0], Index)), " ", "") = Wanted Then
							ColumnIndex = Index;
							Break;
						EndIf;
					EndDo;
				EndIf;
				If Query.Operators.Count() > 1 Or Query.Operators[0].SelectDistinct Then
					If ColumnIndex = Undefined Then
						Raise StrTemplate("ORDER BY %1 HIERARCHY in a nested union or SELECT DISTINCT names no selected"
							+ " column - not translated.", TrimAll(String(OrderItem.Item)));
					EndIf;
					Parts.Add(QuoteIdentifier(TrimAll(Query.Columns[ColumnIndex].Alias), Context) + Direction);
				Else
					Text = ?(ColumnIndex = Undefined, HierarchyItemText(OrderItem),
						ColumnFieldText(Query, Query.Operators[0], ColumnIndex));
					Parts.Add(ValueExpression(Text, Context) + Direction);
				EndIf;
				Continue;
			EndIf;
			If Hidden <> Undefined Then
				// Объединение и РАЗЛИЧНЫЕ: ключи - скрытые колонки выборки (HierarchyHiddenColumns).
				Direction = ?(OrderItem.Direction = QuerySchemaOrderDirection.HierarchyDescending, " DESC", "");
				For Each Name In Hidden.Get(ItemIndex) Do
					Parts.Add(Name + Direction);
				EndDo;
				AddOnce(Context.Warnings, HierarchyTreeWarning(TrimAll(String(OrderItem.Item))));
				Continue;
			EndIf;
			If Query.Operators.Count() > 1 Or Query.Operators[0].SelectDistinct Then
				// Платформа выбирает родителя скрытой колонкой; в объединении и в РАЗЛИЧНЫЕ T-SQL
				// упорядочивает только по колонкам выборки (ворота 65, ERP WE: 2 запроса).
				Raise StrTemplate("ORDER BY %1 HIERARCHY in a union or a SELECT DISTINCT is not translated yet:"
					+ " the platform orders by the parent through a hidden column, and SQL orders such a query"
					+ " only by selected columns.", TrimAll(String(OrderItem.Item)));
			EndIf;
			For Each HierarchyKey In HierarchyOrderKeys(OrderItem, Context) Do
				Parts.Add(HierarchyKey);
			EndDo;
			Continue;
		EndIf;
		If Hidden <> Undefined And Hidden.Get(ItemIndex) <> Undefined Then
			// РАЗЛИЧНЫЕ: ключ - ссылка представления скрытой колонкой (PresentationHiddenColumns, замер op1-op3).
			Direction = OrderDirection(OrderItem);
			For Each Name In Hidden.Get(ItemIndex) Do
				Parts.Add(Name + Direction);
			EndDo;
			Continue;
		EndIf;
		PitKeys = PointInTimeOrderKeys(Query, OrderItem.Item, Context, Hidden <> Undefined);
		If PitKeys <> Undefined Then
			// Замеры pfp1, ptp1, ptp7, ptp10, ptp15 (20.11.2026, УХ): направление - на каждой колонке.
			Direction = OrderDirection(OrderItem);
			For Each PitKey In PitKeys Do
				Parts.Add(PitKey + Direction);
			EndDo;
			Continue;
		EndIf;
		CarriedKeys = CarriedPresentationOrderKeys(Query, OrderItem.Item, Context);
		If CarriedKeys <> Undefined Then
			Direction = OrderDirection(OrderItem);
			For Each CarriedKey In CarriedKeys Do
				Parts.Add(CarriedKey + Direction);
			EndDo;
			Continue;
		EndIf;
		Source = PresentationOrderSource(Query, OrderItem.Item, Context);
		If Source <> Undefined Then
			Direction = OrderDirection(OrderItem);
			Composite = CompositePartsOfExpression(Source, Context);
			If Composite.Parts.Count() = 0 Then
				Parts.Add(ValueExpression(Source, Context) + Direction);
			Else
				For Each Part In PartsInRoleOrder(Composite.Parts) Do
					Parts.Add(FieldColumn(Composite.Descriptor, Composite.Alias, Part, Context) + Direction);
				EndDo;
			EndIf;
			Continue;
		EndIf;
		AccountOrder = ChartOfAccountsCodeOrder(Query, OrderItem.Item, Context);
		If AccountOrder <> Undefined Then
			Parts.Add(AccountOrder + OrderDirection(OrderItem));
			Continue;
		EndIf;
		UnionColumn = UnionOrderColumn(Query, OrderItem.Item);
		If UnionColumn <> Undefined Then
			Direction = OrderDirection(OrderItem);
			Suffixes = Undefined;
			If Context.PartSuffixes <> Undefined And OrderedByParts(Context.PartSuffixes, UnionColumn) Then
				Suffixes = Context.PartSuffixes.Get(Upper(UnionColumn));
			EndIf;
			If Suffixes = Undefined Then
				Parts.Add(QuoteIdentifier(UnionColumn, Context) + Direction);
			Else
				For Each Suffix In Suffixes Do
					Parts.Add(QuoteIdentifier(UnionColumn + Suffix, Context) + Direction);
				EndDo;
			EndIf;
			Continue;
		EndIf;
		Pieces = OrderPartExpressions(OrderItem.Item, Context);
		If Pieces = Undefined Then
			Pieces = OrderPartAliases(OrderItem.Item, Context);
		EndIf;
		If Pieces = Undefined Then
			Pieces = OrderBranchedParts(OrderItem.Item, Context);
		EndIf;
		If Pieces <> Undefined Then
			// Направление относится к значению целиком, значит к каждой его части.
			Direction = OrderDirection(OrderItem);
			For Each Piece In Pieces Do
				Parts.Add(Piece + Direction);
			EndDo;
			Continue;
		EndIf;

		Expression = OrderExpression(OrderItem.Item, Context);
		If IsBareParameter(Expression, Context) Then
			// В 1С этот параметр подставляют текстом - списком полей порядка. Значением
			// он становится только здесь, и упорядочить по нему нечего.
			AddOnce(Context.Warnings, StrTemplate(
				"ORDER BY %1 is dropped: the platform substitutes this parameter as the"
				+ " text of the ordering list, not as a value, and a variable cannot"
				+ " order anything. Put the ordering fields in the query text.",
				Expression));
			Continue;
		EndIf;
		Parts.Add(Expression + OrderDirection(OrderItem));
	EndDo;
	If Hidden <> Undefined Then
		// Порядок идёт во внешнем SELECT над запросом со скрытыми колонками: там видны только имена.
		For Each Part In Parts Do
			Bare = ?(StrEndsWith(Part, " DESC"), Left(Part, StrLen(Part) - 5), Part);
			First = Left(Bare, 1);
			Last = Right(Bare, 1);
			If Not ((First = "[" And Last = "]") Or (First = """" And Last = """")) Or StrFind(Bare, "].[") > 0 Then
				Raise StrTemplate("ORDER BY over hidden key columns (HIERARCHY in a union or a SELECT DISTINCT, or a"
					+ " reference presentation under SELECT DISTINCT) is translated over the selected columns, and"
					+ " the order key %1 is not one of them - not translated yet.", Part);
			EndIf;
		EndDo;
	EndIf;
	If Parts.Count() = 0 Then
		Return "";
	EndIf;
	// A repeated key orders nothing, and MS SQL refuses it (error 169): the code of a chart of
	// accounts orders by Порядок, so `Порядок, Код` names _OrderField twice.
	Unique = New Array;
	Keys = New Map;
	For Each Part In Parts Do
		OrderKey = Upper(?(StrEndsWith(Part, " DESC"), Left(Part, StrLen(Part) - 5), Part));
		If Keys.Get(OrderKey) = Undefined Then
			Keys.Insert(OrderKey, True);
			Unique.Add(Part);
		EndIf;
	EndDo;
	Return "ORDER BY " + StrConcat(Unique, ", ");

EndFunction

// Код плана счетов платформа упорядочивает по реквизиту Порядок (_OrderField), а не по
// строке кода: замер 15.11.2026, УХ, ПланСчетов.Хозрасчетный, 447 счетов - УПОРЯДОЧИТЬ ПО Код,
// ПС.Код и по псевдониму колонки дают порядок по Порядок («99.09» раньше «001»), справочник -
// по коду. Undefined - элемент порядка не код плана счетов.
Function ChartOfAccountsCodeOrder(Query, Item, Context)

	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = Undefined;
	EndTry;
	Text = "";
	If Alias = Undefined Then
		Text = TrimAll(String(Item));
	Else
		Fields = Query.Operators[0].SelectedFields;
		For Index = 0 To Min(Fields.Count(), Query.Columns.Count()) - 1 Do
			If Upper(TrimAll(Query.Columns[Index].Alias)) = Upper(TrimAll(Alias)) Then
				Text = TrimAll(String(Fields[Index]));
				Break;
			EndIf;
		EndDo;
	EndIf;
	If IsBlankString(Text) Or StrFind(Text, "(") > 0 Or StrFind(Text, " ") > 0 Then
		Return Undefined;
	EndIf;
	Segments = StrSplit(Text, ".", False);
	Last = Upper(Segments[Segments.Count() - 1]);
	If Segments.Count() < 2 Or (Last <> "CODE" And Last <> Upper("Код")) Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Text, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	Names = StrSplit(Upper(Resolved.Descriptor.LogicalName), ".", False);
	If Names.Count() <> 2 Or (Names[0] <> "CHARTOFACCOUNTS" And Names[0] <> Upper("ПланСчетов")) Then
		Return Undefined;
	EndIf;
	OrderName = "";
	If Resolved.Descriptor.Fields.Get("ORDER") <> Undefined Then
		OrderName = "Order";
	ElsIf Resolved.Descriptor.Fields.Get(Upper("Порядок")) <> Undefined Then
		OrderName = "Порядок";
	Else
		Return Undefined;
	EndIf;
	Operator = Query.Operators[0];
	If Query.Operators.Count() > 1 Or Operator.SelectDistinct Or GroupCount(Operator) > 0
		Or SelectionHasAggregate(Operator) Then
		Raise StrTemplate(
			"ORDER BY %1 orders a chart of accounts by its Order attribute, not by the code text. In a"
			+ " union, a SELECT DISTINCT or a grouped query that attribute is not among the selected"
			+ " columns, and this ordering is not measured there. Select %2 and order by it.",
			Text, Left(Text, StrLen(Text) - StrLen(Segments[Segments.Count() - 1])) + OrderName);
	EndIf;
	Segments[Segments.Count() - 1] = OrderName;
	Return ValueExpression(StrConcat(Segments, "."), Context);

EndFunction

// Элемент порядка объединения, записанный полем таблицы, а не колонкой результата.
// Замерено (9301-9306): платформа ищет это выражение в списке выборки первой части и
// упорядочивает по найденной колонке - по позиции, как бы колонка ни называлась и что бы
// ни стояло на этой позиции в остальных частях. Выражение, которого в первой части нет,
// и псевдоним таблицы другой части платформа не принимает вовсе.
Function UnionOrderColumn(Query, Item)

	If Query.Operators.Count() < 2 Then
		Return Undefined;
	EndIf;
	Try
		Alias = Item.Alias;
		Return Undefined;
	Except
		Alias = Undefined;
	EndTry;

	Wanted = TextWithoutSpaces(String(Item));
	Fields = Query.Operators[0].SelectedFields;
	For Index = 0 To Fields.Count() - 1 Do
		If Index < Query.Columns.Count()
			And TextWithoutSpaces(String(Fields[Index])) = Wanted Then
			Return TrimAll(Query.Columns[Index].Alias);
		EndIf;
	EndDo;
	Return Undefined;

EndFunction

Function TextWithoutSpaces(Text)

	Result = Upper(Text);
	For Each Symbol In StrSplit(" ," + Chars.Tab + "," + Chars.LF + "," + Chars.CR, ",", False) Do
		Result = StrReplace(Result, Symbol, "");
	EndDo;
	Return Result;

EndFunction

// Часть объединения с ПЕРВЫЕ при общем порядке. Замерено (9301, 9307, 9311, 9314, 9315):
// платформа заворачивает каждую такую часть в подзапрос и упорядочивает её внутри тем же
// порядком, что и всё объединение, - N строк отбираются по порядку. Без порядка (9312)
// часть остаётся как есть.
Function UnionPartIsLimited(Query)

	If Query.Order.Count() = 0 Or Query.Operators.Count() < 2 Then
		Return False;
	EndIf;
	For Each Operator In Query.Operators Do
		If Operator.RetrievedRecordsCount <> Undefined Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Упорядочивание по колонке-вложенной таблице. Такой колонки в списке выборки нет -
// её значение таблица, и платформа читает её отдельным запросом после СУБД, - поэтому
// и в ORDER BY её имени взяться негде.
Function IsDroppedColumn(Query, Nested, Item)

	If Nested.Count() = 0 Then
		Return False;
	EndIf;

	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = Undefined;
	EndTry;
	If Alias = Undefined Then
		Return False;
	EndIf;

	Wanted = Upper(TrimAll(Alias));
	For Each Item_ In Nested Do
		If Item_.Key < Query.Columns.Count()
			And Upper(TrimAll(Query.Columns[Item_.Key].Alias)) = Wanted Then
			Return True;
		EndIf;
	EndDo;

	// Упорядочивают и по полю внутри вложенной таблицы - платформа им упорядочивает строки
	// самой вложенной таблицы. В модели это колонка схемы, которой нет среди колонок
	// запроса: наружу вложенные колонки не выходят, а текст поля их не показывает -
	// String у вложенной таблицы отдаёт только имя типа. Замерено на запросе УХ с
	// `ИнвентаризационнаяКомиссия.( … Председатель … )`: порядок по `Дата` и `Ссылка` -
	// колонки выборки, по `Председатель` - нет. Мы вложенную таблицу не возвращаем, значит
	// упорядочивать её полем нечем, и порядок внешних строк от этого не меняется.
	For Each Column In Query.Columns Do
		If Upper(TrimAll(Column.Alias)) = Wanted Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Направление сортировки. Замерено на 8.3.24 и на 8.3.27: XMLString на значении этого
// системного перечисления падает с «Error transforming XML data» на обеих платформах,
// то есть работает всегда запасная ветка. String отдаёт Descending или Ascending -
// английское имя значения, независимо от языка конфигурации. Сравнение идёт по началу
// слова, чтобы принять и Desc, и Descending, и Убыв, и Убывание.
Function OrderDirection(Item)


	Name = "";
	Try
		Name = XMLString(Item.Direction);
	Except
		Name = String(Item.Direction);
	EndTry;

	Name = Upper(TrimAll(Name));
	Return ?(StrStartsWith(Name, "DESC") Or StrStartsWith(Name, Upper("Убыв")), " DESC", "");

EndFunction

// ORDER BY may name an output column of the query or an arbitrary expression.
Function OrderExpression(Item, Context)

	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = Undefined;
	EndTry;

	If Alias <> Undefined Then
		Return QuoteIdentifier(Alias, Context);
	EndIf;

	// Упорядочить можно и по условию: в 1С оно имеет тип Булево. ValueExpression сам
	// решает, условие это или уже значение.
	Expression = ValueExpression(TrimAll(String(Item)), Context);
	If Context.GroupInsteadOfDistinct Then
		// Внутри группы значение одно - МИНИМУМ возвращает именно его. Нужен он затем,
		// чтобы элемент порядка не требовалось выводить в список колонок.
		Return "MIN(" + Expression + ")";
	EndIf;
	Return Expression;

EndFunction

// РАЗЛИЧНЫЕ с порядком по выражению: T-SQL требует, чтобы элемент порядка стоял в списке
// выборки, платформа - нет. Признак узкий: только РАЗЛИЧНЫЕ без своей группировки и без
// агрегатов, и только когда хотя бы один элемент порядка не назвал колонку выборки.
Function DistinctOrderNeedsGrouping(Operator, Query)

	If Not Operator.SelectDistinct Or GroupCount(Operator) > 0
		Or SelectionHasAggregate(Operator) Then
		Return False;
	EndIf;

	For Each OrderItem In Query.Order Do
		If IsHierarchyOrder(OrderItem) Then
			Continue;
		EndIf;
		Alias = Undefined;
		Try
			Alias = OrderItem.Item.Alias;
		Except
			Alias = Undefined;
		EndTry;
		If Alias = Undefined And UnionOrderColumn(Query, OrderItem.Item) = Undefined Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

#EndRegion

#Region ExpressionTranslation

// Подзапрос - своя область видимости, и её псевдонимы не должны перекрывать внешние:
// иначе в отладке невозможно понять, какая T1 имеется в виду.
Function NextAliasPrefix(Prefix)

	If StrLen(Prefix) < 2 Then
		Return Prefix + "A";
	EndIf;
	Last = Right(Prefix, 1);
	If Last = "Z" Then
		Return Prefix + "A";
	EndIf;
	Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Return Left(Prefix, StrLen(Prefix) - 1) + Mid(Alphabet, StrFind(Alphabet, Last) + 1, 1);

EndFunction

Function NewContext(Opt, Warnings, TempTables = Undefined, AliasPrefix = "T")

	Context = New Structure;
	Context.Insert("Options", Opt);
	Context.Insert("Warnings", Warnings);
	Context.Insert("Aliases", New Map);
	Context.Insert("AliasCounter", 0);
	Context.Insert("NavigationJoins", New Array);
	Context.Insert("NavigationAliases", New Map);
	Context.Insert("HopAliases", New Map);
	Context.Insert("NavigationColumns", New Array);
	// Колонки, из которых собрано значение составной ссылки, и разбор списка выборки
	// по полям: без них не восстановить группировку, выброшенную платформой из модели.
	Context.Insert("CompositeColumns", New Array);
	Context.Insert("SelectedInfo", New Array);
	// Условия ИМЕЮЩИЕ текущего оператора: заполняется в OperatorBlock.
	Context.Insert("HavingInfo", New Array);
	Context.Insert("TempTables", ?(TempTables = Undefined, New Map, TempTables));
	Context.Insert("BareFields", New Map);
	Context.Insert("BareDescriptor", Undefined);
	Context.Insert("BareAlias", "");
	Context.Insert("AliasPrefix", AliasPrefix);
	Context.Insert("BooleanContext", False);
	// Переведённые условия соединений: они переводятся до вывода FROM, а используются
	// при выводе, и переводить их второй раз нельзя - соединения лягут дважды.
	Context.Insert("JoinConditions", New Map);
	// Запрос, который стоит источником-подзапросом, обязан вынести наружу подколонки
	// составных полей: снаружи спрашивают тег типа, а не только ссылку.
	Context.Insert("ExposeCompositeParts", False);
	// Итоговый результат запроса: только здесь базовую колонку разнотипного значения можно
	// выбросить - её имя наружу больше никто не спрашивает. Во временной таблице и в
	// подзапросе-источнике спрашивают.
	Context.Insert("FinalResult", False);
	Context.Insert("PartSuffixes", Undefined);
	// Подколонки, вынесенные наружу отдельной веткой: в группировку их надо добрать,
	// обычный механизм их не видит.
	Context.Insert("PlacementParts", New Array);
	// Выражения колонок, которых в списке выборки нет: у разнотипного
	// составного значения главной колонки не существует, и группировать по ней
	// нельзя - СУБД отвечает «Invalid column name».
	Context.Insert("OmittedBase", New Array);
	// РАЗЛИЧНЫЕ заменено группировкой по списку выборки: элемент порядка идёт под МИНИМУМ.
	Context.Insert("GroupInsteadOfDistinct", False);
	// Литералы и параметры в выборке и в ИМЕЮЩИЕ оператора с группировкой платформа пишет в
	// текст (`7.0`), а не параметром: от этого зависит тип делителя (замеры 7759-7763, 7851).
	Context.Insert("LiteralsInline", False);
	// Колонка -> массив её определителей: колонок, любая из которых, оказавшись в
	// группировке, делает значение колонки однозначным.
	Context.Insert("ColumnDeterminants", New Map);
	// Колонки, которые обязательными считает старый механизм ссылок: их поведение
	// не меняется, проверка определителя к ним не применяется.
	Context.Insert("ProvenColumns", New Array);
	// Автонумерация строк опирается на порядок самого запроса, а он лежит не у оператора.
	Context.Insert("Query", Undefined);
	// Формат даты, разделитель разрядов и слово-связку платформа берёт из региональных
	// установок информационной базы. Прочитать их напрямую нельзя, зато String() в этом
	// же сеансе отдаёт ровно то, что платформа кладёт в представление, - на этом и
	// держится калибровка.
	Context.Insert("SessionFormats", SessionPresentationFormats());
	// Выражение представления -> колонка ссылки, из которой оно собрано. Нужна при
	// сборке GROUP BY: группировать надо по ссылке, как это делает платформа.
	Context.Insert("PresentationGrouping", New Map);
	Context.Insert("CompositePresentations", New Map);
	// Выражение представления -> откуда оно: таблица ссылки, взято ли через точку, есть ли у составной ссылки
	// примитивные части (NotePresentationFacts). Нужно спутникам колонки-представления.
	Context.Insert("PresentationFacts", New Map);
	// Колонка-представление, прочитанная из временной таблицы или вложенного запроса, -> её спутники по ролям
	// (NoteCarriedPresentation).
	Context.Insert("CarriedPresentations", New Map);
	// Колонка производной таблицы, которая в одних ветвях объединения представление ссылки, а в других строка
	// (MixedPresentationColumn): у платформы это значение с тегом, здесь - один текст.
	Context.Insert("MixedPresentations", New Map);
	Return Context;

EndFunction

// Чем платформа складывает представление: формат даты, разделитель разрядов и слово
// между номером и датой. Всё это лежит в региональных установках информационной базы, и
// ни язык сеанса, ни локаль базы на них не влияют - замерено. Зато String() в том же
// сеансе отдаёт в точности те строки, которые платформа кладёт в представление, поэтому
// формат опознаётся по образцу, а не выводится разбором.
//
// Неизвестный образец - не повод подобрать похожий: подпись из представления попадает в
// отчёт, и расхождение в ней читают как расхождение данных. Поэтому здесь возвращается
// пустое значение, а место вызова отказывается переводить и печатает сам образец.
Function SessionPresentationFormats()

	Probe = Date(2017, 4, 27, 15, 8, 49);
	DateRendered = String(Probe);
	Patterns = New Map;
	Patterns.Insert("27/04/17 15:08:49", "dd/MM/yy HH:mm:ss");
	Patterns.Insert("4/27/2017 3:08:49 PM", "M/d/yyyy h:mm:ss tt");
	Patterns.Insert("27.04.2017 15:08:49", "dd.MM.yyyy H:mm:ss");
	Pattern = Patterns.Get(DateRendered);
	// Час 15 не показывает, пишется ли ведущий ноль. На русских установках УХ платформа
	// писала `0:00:00`, на ERP WE с тем же образцом - `00:00:00` (сверка dbg32,
	// ПРЕДСТАВЛЕНИЕ(Дата)); различает их вторая проба с часом 5.
	If Pattern = "dd.MM.yyyy H:mm:ss" And StrFind(String(Date(2017, 4, 27, 5, 8, 49)), " 05:") > 0 Then
		Pattern = "dd.MM.yyyy HH:mm:ss";
	EndIf;

	NumberRendered = String(471481544);
	Separators = New Map;
	Separators.Insert("471,481,544", ",");
	Separators.Insert("471 481 544", " ");
	Separators.Insert("471.481.544", ".");
	// Русские установки дают неразрывный пробел, а не обычный (замер 08.11.2026).
	Separators.Insert("471" + Char(160) + "481" + Char(160) + "544", Char(160));
	Separator = Separators.Get(NumberRendered);

	BooleanRendered = String(True);
	Words = New Map;
	// Слово даёт язык интерфейса платформы, а не региональные установки и не язык
	// пользователя ИБ: замерено 08.11.2026 на одной базе, где формат уже был русским,
	// а слово стало русским только вместе с интерфейсом.
	Words.Insert("Yes", "dated");
	Words.Insert("Да", "от");
	Word = Words.Get(BooleanRendered);

	Formats = New Structure;
	Formats.Insert("DateRendered", DateRendered);
	Formats.Insert("DatePattern", ?(Pattern = Undefined, "", Pattern));
	Formats.Insert("NumberRendered", NumberRendered);
	Formats.Insert("GroupSeparator", ?(Separator = Undefined, "", Separator));
	// Десятичный разделитель - по тому же образцу: «1,5» или «1.5».
	Decimal = Mid(String(1.5), 2, 1);
	Formats.Insert("DecimalSeparator", ?(Decimal = "," Or Decimal = ".", Decimal, ""));
	Formats.Insert("BooleanRendered", BooleanRendered);
	Formats.Insert("DateWord", ?(Word = Undefined, "", Word));
	Return Formats;

EndFunction

Procedure AddOnce(Warnings, Text)

	For Each Existing In Warnings Do
		If Existing = Text Then
			Return;
		EndIf;
	EndDo;
	Warnings.Add(Text);

EndProcedure

// Сравнение, приставленное к другому без скобок: `A = B <> 0`. Платформа читает цепочку
// слева, `(A = B) <> 0`, и логическое значение сравнивает со вторым операндом (замер chain
// c1-c6, 19.11.2026, УХ). Число или строка - значение другого вида, и условие решается до SQL
// константой: `<> 0` - `1=1`, `= 0` - `1=0`, ВЫБОР над ним - константа; так и с арифметикой
// и параметром в первом сравнении (c9, c10). `= ИСТИНА` и `<> ЛОЖЬ` оставляют первое
// сравнение как есть (`_Code = @P`), `= ЛОЖЬ` и `<> ИСТИНА` - `NOT (…)`, и NULL из внешнего
// соединения отдельно не обрабатывается (c7, c8, c12). Второй операнд - поле или параметр -
// не замерен, такую цепочку отвергает HasChainedComparison.
Procedure FoldChainedComparisons(Tokens)

	Folded = True;
	While Folded Do
		Folded = False;
		First = New Array;
		Start = New Array;
		First.Add(-1);
		Start.Add(0);
		For Index = 0 To Tokens.Count() - 1 Do
			Token = Tokens[Index];
			Value = Token.Value;
			Top = First.UBound();
			If Token.Kind = "Symbol" Then
				If Value = "(" Then
					First.Add(-1);
					Start.Add(Index + 1);
				ElsIf Value = ")" Then
					If Top > 0 Then
						First.Delete(Top);
						Start.Delete(Top);
					EndIf;
				ElsIf Value = "," Then
					First[Top] = -1;
					Start[Top] = Index + 1;
				ElsIf Value = "=" Or Value = "<>" Or Value = "<" Or Value = ">"
					Or Value = "<=" Or Value = ">=" Then
					If First[Top] < 0 Then
						First[Top] = Index;
					ElsIf FoldChainAt(Tokens, Start[Top], Index) Then
						Folded = True;
						Break;
					EndIf;
				EndIf;
			ElsIf Token.Kind = "Name" Then
				Word = Upper(Value);
				If Word = "SELECT" Or Word = Upper("Выбрать") Then
					Return;
				ElsIf Word = "CASE" Or Word = Upper("Выбор") Then
					First.Add(-1);
					Start.Add(Index + 1);
				ElsIf Word = "END" Or Word = Upper("Конец") Then
					If Top > 0 Then
						First.Delete(Top);
						Start.Delete(Top);
					EndIf;
				ElsIf Word = "AND" Or Word = Upper("И") Or Word = "OR" Or Word = Upper("ИЛИ")
					Or Word = "NOT" Or Word = Upper("НЕ")
					Or Word = "WHEN" Or Word = Upper("Когда")
					Or Word = "THEN" Or Word = Upper("Тогда")
					Or Word = "ELSE" Or Word = Upper("Иначе") Then
					First[Top] = -1;
					Start[Top] = Index + 1;
				EndIf;
			EndIf;
		EndDo;
	EndDo;

EndProcedure

// Свёртка одной цепочки: From - первый токен первого сравнения, Operator - второе сравнение.
// Ложь - второй операнд не литерал, токены не тронуты.
Function FoldChainAt(Tokens, From, Operator)

	Value = Tokens[Operator].Value;
	If (Value <> "=" And Value <> "<>") Or Operator >= Tokens.Count() - 1 Then
		Return False;
	EndIf;
	Role = LoneLiteralRole(Tokens, Operator + 1, 1);
	If IsBlankString(Role) Then
		Return False;
	EndIf;
	Equals = Value = "=";
	If Role <> "_L" Then
		For Step = From To Operator Do
			Tokens.Delete(From);
		EndDo;
		Tokens[From] = NewToken("Name", ?(Equals, "FALSE", "TRUE"));
		Return True;
	EndIf;
	Word = Upper(Tokens[Operator + 1].Value);
	Tokens.Delete(Operator + 1);
	Tokens.Delete(Operator);
	Tokens.Insert(Operator, NewToken("Symbol", ")"));
	Tokens.Insert(From, NewToken("Symbol", "("));
	If (Word = "TRUE" Or Word = Upper("Истина")) <> Equals Then
		Tokens.Insert(From, NewToken("Name", "NOT"));
	EndIf;
	Return True;

EndFunction

// Два сравнения подряд на одном уровне скобок без связки между ними. В T-SQL такой текст
// не разбирается вовсе, а что платформа строит из формы, которую не свернул
// FoldChainedComparisons, не замерено. Выражение с подзапросом не проверяется: его разбирает
// сама платформа, и предложения у него свои.
Function HasChainedComparison(Tokens)

	Seen = New Array;
	Seen.Add(False);
	For Each Token In Tokens Do
		Value = Token.Value;
		Top = Seen.UBound();
		If Token.Kind = "Symbol" Then
			If Value = "(" Then
				Seen.Add(False);
			ElsIf Value = ")" Then
				If Top > 0 Then
					Seen.Delete(Top);
				EndIf;
			ElsIf Value = "," Then
				Seen[Top] = False;
			ElsIf Value = "=" Or Value = "<>" Or Value = "<" Or Value = ">"
				Or Value = "<=" Or Value = ">=" Then
				If Seen[Top] Then
					Return True;
				EndIf;
				Seen[Top] = True;
			EndIf;
		ElsIf Token.Kind = "Name" Then
			Word = Upper(Value);
			If Word = "SELECT" Or Word = Upper("Выбрать") Then
				Return False;
			ElsIf Word = "CASE" Or Word = Upper("Выбор") Then
				Seen.Add(False);
			ElsIf Word = "END" Or Word = Upper("Конец") Then
				If Top > 0 Then
					Seen.Delete(Top);
				EndIf;
			ElsIf Word = "AND" Or Word = Upper("И") Or Word = "OR" Or Word = Upper("ИЛИ")
				Or Word = "NOT" Or Word = Upper("НЕ")
				Or Word = "WHEN" Or Word = Upper("Когда")
				Or Word = "THEN" Or Word = Upper("Тогда")
				Or Word = "ELSE" Or Word = Upper("Иначе") Then
				Seen[Top] = False;
			EndIf;
		EndIf;
	EndDo;
	Return False;

EndFunction

// `НЕ (условие) <> значение`: скобка после НЕ - операнд сравнения, а не вызов функции.
Function IsNegatedComparisonOperand(Tokens, Index)

	If Index = 0 Or Tokens[Index - 1].Kind <> "Name" Then
		Return False;
	EndIf;
	Word = Upper(Tokens[Index - 1].Value);
	If Word <> "NOT" And Word <> Upper("НЕ") Then
		Return False;
	EndIf;
	Closing = MatchingParen(Tokens, Index);
	If Closing + 1 > Tokens.Count() - 1 Or Tokens[Closing + 1].Kind <> "Symbol" Then
		Return False;
	EndIf;
	Value = Tokens[Closing + 1].Value;
	Return Value = "=" Or Value = "<>" Or Value = "<" Or Value = ">" Or Value = "<=" Or Value = ">=";

EndFunction

// Rewrites one 1C expression into SQL. The structure of the query is already known
// from the schema, so only the expression grammar is handled here.
// «ЗНАЧЕНИЕ(…) = Т.Поле», «НЕОПРЕДЕЛЕНО = Т.Поле», «&П = Т.Поле»: литерал слева от поля.
// Разборы сравнений составного поля ждут поле слева, и обратная запись уходила в общий
// путь - одна колонка ссылки против литерала (сверка battery25: ЗНАЧЕНИЕ(…ПустаяСсылка) =
// составное - 1С 1 строка, SQL 38). = и <> симметричны, поэтому операнды переставляются.
Function FieldFirstComparisons(Tokens)

	Index = 0;
	While Index < Tokens.Count() Do
		Token = Tokens[Index];
		Width = 0;
		If Token.Kind = "Parameter" Or IsUndefinedLiteralToken(Token) Then
			Width = 1;
		ElsIf Token.Kind = "Name"
			And (Upper(Token.Value) = "VALUE" Or Upper(Token.Value) = Upper("Значение"))
			And Index + 3 < Tokens.Count() And Tokens[Index + 1].Value = "("
			And Tokens[Index + 2].Kind = "Name" And Tokens[Index + 3].Value = ")" Then
			Width = 4;
		EndIf;
		If Width > 0 And Index + Width + 1 < Tokens.Count() Then
			Operator = Tokens[Index + Width];
			Field = Tokens[Index + Width + 1];
			FieldEnd = Index + Width + 1;
			If Operator.Kind = "Symbol" And (Operator.Value = "=" Or Operator.Value = "<>")
				And Field.Kind = "Name" And StrFind(Field.Value, ".") > 0
				And Not IsUndefinedLiteralToken(Field)
				And (FieldEnd + 1 >= Tokens.Count() Or Tokens[FieldEnd + 1].Value <> "(")
				And LeftIsBoundary(Tokens, Index) And RightIsBoundary(Tokens, FieldEnd) Then
				Reordered = New Array;
				For Position = 0 To Index - 1 Do
					Reordered.Add(Tokens[Position]);
				EndDo;
				Reordered.Add(Field);
				Reordered.Add(Operator);
				For Position = Index To Index + Width - 1 Do
					Reordered.Add(Tokens[Position]);
				EndDo;
				For Position = FieldEnd + 1 To Tokens.Count() - 1 Do
					Reordered.Add(Tokens[Position]);
				EndDo;
				Tokens = Reordered;
				Index = Index + Width + 2;
				Continue;
			EndIf;
		EndIf;
		Index = Index + 1;
	EndDo;
	Return Tokens;

EndFunction

// Голое имя составного поля в условии виртуальной таблицы - то же поле, что и с псевдонимом таблицы
// подзапроса. Замер vtc1-vtc4 (21.11.2026, УХ, кэш планов, Обороты регистра накопления, измерение
// составного типа): `Договор = &Д` - `(_TYPE = 0x08 AND _RTRef = 0x00000082 AND _RRRef = @P2)`,
// `Договор В (&Д)` - те же тег и идентификатор таблицы и `_RRRef IN (@P2)`, `Договор ССЫЛКА ...` -
// `(_TYPE = 0x08 AND _RTRef = 0x00000082)`: ровно то же, что платформа выдаёт на это сравнение во
// внешнем ГДЕ. Распознаватели сравнений составного берут только путь с точкой, и голое имя уходило
// общему разбору: одна колонка ссылки из BareFields (`VT._Fld36122_RRRef = 0x...`) - с параметром
// совпадали ссылки других таблиц с теми же байтами и значения без ссылки. Имя дополняется псевдонимом
// здесь, один раз, и дальше идёт теми же путями, что поле с псевдонимом.
//
// Поле одного типа не трогается: колонка у него одна, и прежний разбор отдаёт её же. Подзапрос -
// своя область видимости, его имена не наши. Имя перед скобкой - функция, после КАК - тип, после
// точки - поле значения выражения, в скобках ТИП(...) - имя типа.
Procedure QualifyBareCompositeFields(Tokens, Context)

	If IsBlankString(Context.BareAlias) Or Context.BareDescriptor = Undefined Then
		Return;
	EndIf;

	Index = 0;
	While Index < Tokens.Count() Do
		Token = Tokens[Index];
		If Token.Kind <> "Name" Then
			Index = Index + 1;
			Continue;
		EndIf;
		Word = Upper(Token.Value);
		If Word = "SELECT" Or Word = Upper("Выбрать") Then
			Index = SubqueryEnd(Tokens, Index) + 1;
			Continue;
		EndIf;
		If StrFind(Token.Value, ".") = 0 And Context.BareFields.Get(Word) <> Undefined
			And (Index = Tokens.Count() - 1 Or Tokens[Index + 1].Value <> "(")
			And Not FollowsTypeOrValueContext(Tokens, Index)
			And KeywordMap().Get(Word) = Undefined And LiteralMap(Context).Get(Word) = Undefined
			And CompositeInfo(Context.BareDescriptor, Token.Value) <> Undefined Then
			Token.Value = Context.BareAlias + "." + Token.Value;
		EndIf;
		Index = Index + 1;
	EndDo;

EndProcedure

// Имя на этом месте - не поле таблицы: тип после КАК, поле значения выражения после точки, имя типа
// в ТИП(...).
Function FollowsTypeOrValueContext(Tokens, Index)

	If Index = 0 Then
		Return False;
	EndIf;
	Previous = Tokens[Index - 1];
	If Previous.Kind = "Name" Then
		Word = Upper(Previous.Value);
		Return Word = "AS" Or Word = Upper("Как");
	EndIf;
	If Previous.Value = "." Then
		Return True;
	EndIf;
	If Previous.Value = "(" And Index > 1 And Tokens[Index - 2].Kind = "Name" Then
		Word = Upper(Tokens[Index - 2].Value);
		Return Word = "TYPE" Or Word = Upper("Тип");
	EndIf;
	Return False;

EndFunction

// Text - по значению: ниже это рабочая переменная, и без Val перевод подменял текст у вызывающего
// (начало Обороты(ДАТАВРЕМЯ(...), , Месяц) переводилось второй раз уже из SQL).
Function TranslateExpression(Val Text, Context)

	Tokens = Tokenize(ExpandUndefinedInLists(ExpandSelectorCases(Text), Context));
	QualifyBareCompositeFields(Tokens, Context);
	FoldChainedComparisons(Tokens);
	Tokens = FieldFirstComparisons(Tokens);
	If HasChainedComparison(Tokens) Then
		Raise "A comparison is chained to another one without parentheses, as in `A = B <> 0`:"
			+ " the platform compares the logical result of the first with the next value,"
			+ " and no SQL form for that has been measured."
			+ " Put parentheses around the part that is meant as one operand.";
	EndIf;
	NoteCaseBranchParameterTypes(Tokens, Context);
	If Not (Context.Property("MixedLiteralParts") And Context.MixedLiteralParts) Then
		CheckCaseLiteralKinds(Tokens);
	EndIf;
	CheckLiteralComparisonKinds(Tokens);
	WarnAboutNarrowSum(Tokens, Context);
	Parts = New Array;
	Index = 0;
	CaseWrap = New Array;
	LastPath = "";
	// Деление оборачивает свои операнды в CAST: начало делимого ищется по номеру первой
	// части его первого токена, а приведение делителя закрывается после его последнего токена.
	PartsAt = New Map;
	Closers = New Array;

	While Index < Tokens.Count() Do
		Token = Tokens[Index];
		CloseDivisionOperands(Closers, Parts, Index);
		PartsAt.Insert(Index, Parts.Count());

		NoteParameterType(Tokens, Index, Context);

		Consumed = 0;
		CompositeHierarchy = CompositeHierarchySql(Tokens, Index, Context, Consumed);
		If CompositeHierarchy <> Undefined Then
			Parts.Add(CompositeHierarchy);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Predefined = PredefinedNameComparisonSpan(Tokens, Index);
		If Predefined <> Undefined Then
			Parts.Add(PredefinedNameComparisonSql(Predefined, Context));
			Index = Index + 3;
			Continue;
		EndIf;

		Comparison = UndefinedComparisonSpan(Tokens, Index, Context);
		If Comparison <> Undefined Then
			Parts.Add(UndefinedComparisonSql(Comparison.Path, Comparison.Equals, Context));
			Index = Index + 3;
			Continue;
		EndIf;

		Consumed = 0;
		Tagged = UndefinedExpressionComparisonSql(Tokens, Index, Context, Consumed);
		If Tagged <> Undefined Then
			Parts.Add(Tagged);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		Widened = IsNullUndefinedInequalitySql(Tokens, Index, Context, Consumed);
		If Widened <> Undefined Then
			Parts.Add(Widened);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		Narrowed = IsNullUndefinedEqualitySql(Tokens, Index, Context, Consumed);
		If Narrowed <> Undefined Then
			Parts.Add(Narrowed);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Nullness = UndefinedNullnessSpan(Tokens, Index, Parts);
		If Nullness <> Undefined Then
			Parts.Add(Nullness);
			Index = Index + 2;
			Continue;
		EndIf;

		Consumed = 0;
		TagNullness = DerivedCompositeNullnessSql(Tokens, Index, Context, Consumed);
		If TagNullness <> Undefined Then
			Parts.Add(TagNullness);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		CaseNullness = CaseNullnessSql(Tokens, Index, Context, Consumed);
		If CaseNullness <> Undefined Then
			Parts.Add(CaseNullness);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		MixedCase = MixedCaseComparisonSql(Tokens, Index, Context, Consumed);
		If MixedCase <> Undefined Then
			Parts.Add(MixedCase);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		CarriedCondition = CarriedPresentationConditionSql(Tokens, Index, Context, Consumed);
		If CarriedCondition <> Undefined Then
			Parts.Add(CarriedCondition);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Paired = CompositeValueComparisonSpan(Tokens, Index, Context);
		If Paired <> Undefined Then
			Rendered = CompositeValueComparisonSql(Paired, Context);
			If Rendered <> Undefined Then
				Parts.Add(Rendered);
				Index = Index + 3;
				Continue;
			EndIf;
		EndIf;

		PartsPair = PartsPairComparisonSql(Tokens, Index, Context);
		If PartsPair <> Undefined Then
			Parts.Add(PartsPair);
			Index = Index + 3;
			Continue;
		EndIf;

		Consumed = 0;
		AggregatedPair = AggregatedCompositeComparisonSql(Tokens, Index, Context, Consumed);
		If AggregatedPair <> Undefined Then
			Parts.Add(AggregatedPair);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		PartsIn = PartsOnlyInSubquerySql(Tokens, Index, Context, Consumed);
		If PartsIn <> Undefined Then
			Parts.Add(PartsIn);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		CompositeIn = StoredCompositeInSql(Tokens, Index, Context, Consumed);
		If CompositeIn <> Undefined Then
			Parts.Add(CompositeIn);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Counted = PartsOnlyCountArgument(Tokens, Index, Context);
		If Counted <> Undefined Then
			Parts.Add(Counted);
			Index = Index + 1;
			Continue;
		EndIf;

		Typed = TypedReferenceComparisonSpan(Tokens, Index, Context);
		If Typed <> Undefined Then
			Rendered = TypedReferenceComparisonSql(Typed, Context);
			If Rendered <> Undefined Then
				Parts.Add(Rendered);
				Index = Index + Typed.Consumed;
				Continue;
			EndIf;
		EndIf;

		IsNullLiteral = IsNullLiteralComparisonSpan(Tokens, Index, Context);
		If IsNullLiteral <> Undefined Then
			Parts.Add(IsNullLiteralComparisonSql(IsNullLiteral, Context));
			Index = Index + IsNullLiteral.Consumed;
			Continue;
		EndIf;

		Foreign = ForeignKindLiteralComparisonSpan(Tokens, Index, Context);
		If Foreign = Undefined Then
			Foreign = ForeignKindParameterComparisonSpan(Tokens, Index, Context);
		EndIf;
		If Foreign <> Undefined Then
			Parts.Add(Foreign.Sql);
			Index = Index + Foreign.Consumed;
			Continue;
		EndIf;

		Primitive = PrimitiveLiteralComparisonSpan(Tokens, Index, Context);
		If Primitive <> Undefined Then
			Rendered = PrimitiveLiteralComparisonSql(Primitive, Context);
			If Rendered <> Undefined Then
				Parts.Add(Rendered);
				Index = Index + Primitive.Consumed;
				Continue;
			EndIf;
		EndIf;

		Consumed = 0;
		Known = KnownTypeReferenceComparisonSql(Tokens, Index, Context, Consumed);
		If Known <> Undefined Then
			Parts.Add(Known);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		CastRefs = CastReferenceTestSql(Tokens, Index, Context, Consumed);
		If CastRefs <> Undefined Then
			Parts.Add(CastRefs);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		ShortType = ShortTypeTestSql(Tokens, Index, Context, Consumed);
		If ShortType <> Undefined Then
			Parts.Add(ShortType);
			Index = Index + Consumed;
			Continue;
		EndIf;

		Consumed = 0;
		PitTest = PointInTimeComparisonSql(Tokens, Index, Context, Consumed);
		If PitTest <> Undefined Then
			Parts.Add(PitTest);
			Index = Index + Consumed;
			Continue;
		EndIf;

		If Token.Kind = "Name" Then
			Word = Upper(Token.Value);
			If Word = "CASE" Or Word = Upper("Выбор") Then
				// Условие бывает и вне булева контекста: ВЫБОР внутри КОГДА соседнего
				// ВЫБОРА стоит в условии, даже если весь он - колонка списка выборки.
				// Тот же признак спрашивает NeedsBooleanWrapSpan.
				CaseWrap.Add((Context.BooleanContext Or InCaseCondition(Tokens, Index))
					And LeftIsBoundary(Tokens, Index));
			ElsIf (Word = "END" Or Word = Upper("Конец")) And CaseWrap.Count() > 0 Then
				// 1С разрешает ВЫБОР, возвращающий булево; в T-SQL это значение,
				// поэтому его сравнивают с истиной.
				Wrap = CaseWrap[CaseWrap.Count() - 1] And RightIsBoundary(Tokens, Index);
				CaseWrap.Delete(CaseWrap.Count() - 1);
				If Wrap Then
					Parts.Add("END = " + BooleanLiteral(True, Context));
					Index = Index + 1;
					Continue;
				EndIf;
			EndIf;
		EndIf;

		// Список `В`, среди элементов которого есть условие. Подзапрос и прочие формы
		// списка остаются прежнему коду: здесь только случай, который иначе даёт
		// битый текст.
		If Token.Kind = "Symbol" And Token.Value = "(" And Index > 0
			And Tokens[Index - 1].Kind = "Name"
			And (Upper(Tokens[Index - 1].Value) = "IN"
				Or Upper(Tokens[Index - 1].Value) = Upper("В")) Then

			Closing = MatchingParen(Tokens, Index);
			Items = ListItems(Tokens, Index, Closing);
			If Items <> Undefined And ListHasCondition(Items) Then
				Rendered = New Array;
				For Each Item In Items Do
					Rendered.Add(ValueExpression(Item, Context));
				EndDo;
				Parts.Add("(" + StrConcat(Rendered, ", ") + ")");
				Index = Closing + 1;
				Continue;
			EndIf;
		EndIf;

		// Скобка, за которой точка и имя, - обращение к полю значения выражения (9411).
		If Token.Kind = "Symbol" And Token.Value = "(" Then
			Closing = MatchingParen(Tokens, Index);
			If Closing > Index + 1 And Closing + 2 < Tokens.Count()
				And Tokens[Closing + 1].Value = "." And Tokens[Closing + 2].Kind = "Name" Then
				Consumed = 0;
				Dereferenced = ExpressionDereferenceSql(Tokens, Index, Closing, Consumed, Context);
				// Самостоятельный операнд условия - булево поле: как у обычного пути, сравнение
				// с ИСТИНА, иначе T-SQL не примет колонку там, где ждёт условие.
				If NeedsBooleanWrapSpan(Tokens, Index, Closing + Consumed, Context) Then
					Dereferenced = "(" + Dereferenced + " = " + BooleanLiteral(True, Context) + ")";
				EndIf;
				Parts.Add(Dereferenced);
				Index = Closing + 1 + Consumed;
				Continue;
			EndIf;
		EndIf;

		// Условие в скобках, стоящее операндом, - это значение: `Поле <> (А = Б)`,
		// `(А = Б) = ЛОЖЬ`, `В (ИСТИНА, Поле = ИСТИНА)`. Признак «операнд, а не условие»
		// уже есть: самостоятельным условием отрезок делает NeedsBooleanWrapSpan.
		// Скобка вызова функции сюда не попадает - перед ней стоит имя.
		If Token.Kind = "Symbol" And Token.Value = "(" And Not IsTupleIn(Tokens, Index)
			And (Index = 0 Or Tokens[Index - 1].Kind <> "Name"
				Or IsNegatedComparisonOperand(Tokens, Index)) Then

			Closing = MatchingParen(Tokens, Index);
			If Closing > Index + 1
				And Not NeedsBooleanWrapSpan(Tokens, Index, Closing, Context) Then

				Inner = TokensText(Tokens, Index + 1, Closing - 1);
				If IsConditionExpression(Inner) Then
					Saved = Context.BooleanContext;
					Context.BooleanContext = True;
					Condition = TranslateExpression(Inner, Context);
					Context.BooleanContext = Saved;
					Parts.Add(ConditionAsValue(Condition, Context));
					Index = Closing + 1;
					Continue;
				EndIf;
			EndIf;
		EndIf;

		If Token.Kind = "Symbol" And Token.Value = "(" And IsTupleIn(Tokens, Index) Then
			// (А, Б) В (ВЫБРАТЬ ...) - в 1С так можно, в T-SQL кортежного вхождения нет.
			Consumed = 0;
			Parts.Add(TupleInExpression(Tokens, Index, Context, Consumed));
			Index = Index + Consumed + 1;
			Continue;

		ElsIf Token.Kind = "String" Then
			Parts.Add(StringLiteral(Token.Value, Context));

		ElsIf Token.Kind = "Symbol" And Token.Value = "/" Then
			// Масштаб частного СУБД выводит из типов операндов, поэтому деление пишется в тех
			// типах, в каких его пишет платформа, - см. DivisionSql.
			Consumed = 0;
			DivisionSql(Tokens, Index, Parts, PartsAt, Closers, Context, Consumed);
			Index = Index + Consumed + 1;
			Continue;

		ElsIf Token.Kind = "Symbol" And Token.Value = "*" And Index > 0 And Tokens[Index - 1].Value <> "(" Then
			MultiplicationSql(Tokens, Index, Parts, PartsAt, Closers, Context);

		ElsIf Token.Kind = "Number" Then
			Parts.Add(NumberLiteralSql(Tokens, Index, Context));

		ElsIf Token.Kind = "Symbol" And (Token.Value = "+" Or Token.Value = "-") And Index > 0
			And EndsOperand(Tokens[Index - 1]) Then
			AdditionSql(Tokens, Index, Parts, PartsAt, Closers, Context);

		ElsIf Token.Kind = "Symbol" Then
			Parts.Add(Token.Value);

		ElsIf Token.Kind = "Parameter" Then
			CheckParameterValueKind(Tokens, Index, Context);
			Reference = ParameterReference(Token.Value, Context);
			If NeedsBooleanWrapSpan(Tokens, Index, Index, Context) Then
				Reference = "(" + Reference + " = " + BooleanLiteral(True, Context) + ")";
			ElsIf Reference = "NULL" Then
				Reference = AggregateNullSql(Tokens, Index);
			Else
				Reference = ArithmeticParameterSql(Reference, Tokens, Index, Context);
			EndIf;
			Parts.Add(Reference);

		ElsIf Token.Kind = "Name" Then
			// ССЫЛКА - инфиксный оператор, и платформа выдаёт на него ровно тот же SQL,
			// что на ТИПЗНАЧЕНИЯ(...) = ТИП(...). Слева от него всегда путь к полю.
			Operator = Upper(Token.Value);

			// Подзапрос внутри выражения - это полноценный запрос со своими источниками
			// и своей областью видимости. Разбирать его потоком токенов нельзя: платформа
			// отдаёт его текстом, и текст надо вернуть ей же на разбор.
			If Operator = "SELECT" Or Operator = Upper("Выбрать") Then
				Finish = SubqueryEnd(Tokens, Index);
				Parts.Add(SubquerySql(TokensText(Tokens, Index, Finish), Context,
					InSubqueryOperand(Tokens, Index, Context)));
				Index = Finish + 1;
				Continue;
			EndIf;

			// Ветка ВЫБОРа - это значение. Если в исходнике там стоит условие
			// (в 1С оно имеет тип Булево), в T-SQL его надо превратить в значение.
			If Operator = "THEN" Or Operator = Upper("Тогда")
				Or Operator = "ELSE" Or Operator = Upper("Иначе") Then

				Parts.Add(KeywordMap().Get(Operator));
				Finish = BranchEnd(Tokens, Index + 1);
				Branch = TokensText(Tokens, Index + 1, Finish);
				// Условие, целиком взятое в скобки, - то же условие: скобки его типа не
				// меняют. Подзапрос в скобках сюда не относится.
				If Finish > Index + 2 And Tokens[Index + 1].Value = "("
					And MatchingParen(Tokens, Index + 1) = Finish
					And Upper(Tokens[Index + 2].Value) <> "SELECT"
					And Upper(Tokens[Index + 2].Value) <> Upper("Выбрать")
					And IsConditionExpression(TokensText(Tokens, Index + 2, Finish - 1)) Then
					Branch = TokensText(Tokens, Index + 2, Finish - 1);
				EndIf;
				If Not IsBlankString(Branch) And IsConditionExpression(Branch) Then
					Saved = Context.BooleanContext;
					Context.BooleanContext = True;
					Parts.Add(ConditionAsValue(
						TranslateExpression(Branch, Context), Context));
					Context.BooleanContext = Saved;
					Index = Finish + 1;
					Continue;
				EndIf;
				Index = Index + 1;
				Continue;
			EndIf;

			// В ИЕРАРХИИ - не функция: слева поле, справа список узлов, а весь оператор
			// заменяет собой уже выданное ключевое слово вхождения.
			If (Operator = "HIERARCHY" Or Operator = Upper("Иерархии"))
				And Parts.Count() > 0 And Upper(TrimAll(Parts[Parts.Count() - 1])) = "IN"
				And Index + 1 < Tokens.Count() And Tokens[Index + 1].Value = "(" Then

				Consumed = 0;
				Nodes = CollectArguments(Tokens, Index, Consumed);
				// LastPath - последнее поле выражения, а не обязательно левый операнд: перед
				// [НЕ] В может стоять ВЫРАЗИТЬ, ЕСТЬNULL или ВЫБОР, а поле - из более ранней части
				// условия. Тогда иерархию задаёт таблица, которую даёт само выражение.
				LeftEnd = Index - 1;
				If LeftEnd > 0 And IsNotKeywordToken(Tokens[LeftEnd - 1]) Then
					LeftEnd = LeftEnd - 1;
				EndIf;
				If Not IsBlankString(LastPath) And LeftOperandIsField(Tokens, LeftEnd, LastPath) Then
					Parts[Parts.Count() - 1] = HierarchyCondition(LastPath, Nodes, Context);
				Else
					Parts[Parts.Count() - 1] = ExpressionHierarchyCondition(Tokens, LeftEnd, Nodes, Context);
				EndIf;
				Index = Index + Consumed + 1;
				Continue;
			EndIf;

			If (Operator = "REFS" Or Operator = Upper("Ссылка"))
				And Not IsBlankString(LastPath) And Parts.Count() > 0
				And Index + 1 < Tokens.Count() And Tokens[Index + 1].Kind = "Name"
				And StrFind(Tokens[Index + 1].Value, ".") > 0
				And Metadata.FindByFullName(Tokens[Index + 1].Value) <> Undefined Then

				If Not LeftOperandIsField(Tokens, Index, LastPath) Then
					Raise StrTemplate(
						"REFS (ССЫЛКА) here is applied to an expression, not to a field:"
						+ " %1. The type test replaces the operand itself, and an expression"
						+ " cannot be replaced that way. Compute the value in a temporary"
						+ " table first, then apply REFS to its field.",
						TokensText(Tokens, Max(Index - 6, 0), Index + 1));
				EndIf;
				Parts[Parts.Count() - 1] = ReferenceTypeTest(LastPath, Tokens[Index + 1].Value, Context);
				LastPath = "";
				Index = Index + 2;
				Continue;
			EndIf;

			// Вызов функции, стоящий самостоятельным операндом условия: в 1С он вернул
			// Булево, в T-SQL его надо сравнить. Часть функций переводится подстановкой
			// имени, и их скобки разбирает общий цикл - значит, границу считаем здесь.
			If KeywordMap().Get(Operator) = Undefined
				And Index + 1 < Tokens.Count() And Tokens[Index + 1].Value = "(" Then

				Finish = MatchingParen(Tokens, Index + 1);
				// Скобки в отрезке обязаны сойтись. Если нет, граница найдена неверно -
				// например, на внутренней скобке СТРОКА(100) внутри ВЫРАЗИТЬ, - и тогда
				// следом стоит внешняя скобка, которая ложно выглядит концом условия.
				If ParensBalanced(Tokens, Index, Finish)
					And NeedsBooleanWrapSpan(Tokens, Index, Finish, Context) Then
					Saved = Context.BooleanContext;
					Context.BooleanContext = False;
					Inner = TranslateExpression(TokensText(Tokens, Index, Finish), Context);
					Context.BooleanContext = Saved;
					Parts.Add("(" + Inner + " = " + BooleanLiteral(True, Context) + ")");
					Index = Finish + 1;
					Continue;
				EndIf;
			EndIf;

			Consumed = 0;
			IsKeyword = False;
			Text = TranslateName(Tokens, Index, Context, Consumed, IsKeyword);

			// Самостоятельный операнд условия в 1С всегда имеет тип Булево - хоть поле,
			// хоть параметр, хоть ЕСТЬNULL(...). В T-SQL булева типа нет, поэтому здесь
			// решает позиция, а не вид выражения.
			If Not IsKeyword And NeedsBooleanWrapSpan(Tokens, Index, Index + Consumed, Context) Then
				Word = Upper(Token.Value);
				If Word = "TRUE" Or Word = Upper("Истина") Then
					Text = "1 = 1";
				ElsIf Word = "FALSE" Or Word = Upper("Ложь") Then
					Text = "1 = 0";
				Else
					Text = "(" + Text + " = " + BooleanLiteral(True, Context) + ")";
				EndIf;
			EndIf;
			If Text = "NULL" Then
				Text = AggregateNullSql(Tokens, Index);
			EndIf;
			Text = SumOfQuotientPrefix(Tokens, Index, Closers, Context) + Text;
			If Consumed = 0 And Not IsKeyword Then
				TotalType = ?(StrFind(Token.Value, ".") > 0, AggregatedResourceSql(Token.Value, Context), "");
				If Not IsBlankString(TotalType) Then
					Text = "CAST(" + Text + " AS " + TotalType + ")";
				EndIf;
			EndIf;

			Parts.Add(Text);
			If StrFind(Token.Value, ".") > 0
				Or (Not IsKeyword And Context.BareFields.Get(Operator) <> Undefined) Then
				LastPath = Token.Value;
			EndIf;
			Index = Index + Consumed;

		EndIf;

		Index = Index + 1;
	EndDo;
	CloseDivisionOperands(Closers, Parts, Tokens.Count());

	Return AssembleExpression(Parts);

EndFunction

#Region Division

// Деление так, как его пишет платформа (замеры 7710-7870, ERP WE, MS SQL). Платформа не
// умножает делимое на константу, а приводит его к NUMERIC(целые + 8, 8), где целые - число
// целых цифр делимого по типам 1С: у Число(15, 2) это NUMERIC(21, 8), у СУММА от него -
// NUMERIC(27, 8), у КОЛИЧЕСТВО - NUMERIC(20, 8). Приведения нет, когда у делимого и делителя
// вместе восемь дробных знаков и больше - так стоит результат другого деления, СРЕДНЕЕ,
// ВЫРАЗИТЬ(... КАК Число(15, 8)). Делитель не приводится вовсе: поле идёт в своём типе,
// литерал и параметр - в типе параметра (NUMERIC(10) у целого до десяти цифр, NUMERIC(38, 8)
// у прочих), а в операторе с группировкой - литералом `7.0`. Масштаб частного СУБД выводит из
// этих типов (у Число(15, 2) / 3 - 19 знаков, у СУММА / КОЛИЧЕСТВО - 19, у КОЛИЧЕСТВО / 7 в
// группировке - 11), поэтому совпадение типов и есть совпадение значений. Деление констант
// платформа считает сама и передаёт готовое значение; деление на ноль она в СУБД пропускает,
// и запрос падает с 8134 - у SQL так же.
Procedure DivisionSql(Tokens, Index, Parts, PartsAt, Closers, Context, Consumed)

	// На PostgreSQL деление платформы не замерено: там остаётся прежний множитель делимого.
	If Context.Options.Dialect = "PostgreSQL" Then
		Parts.Add("* 1.00000000 /");
		Return;
	EndIf;

	Start = DividendStart(Tokens, Index);
	Finish = DivisorEnd(Tokens, Index);
	First = PartsAt.Get(Start);
	If Start >= Index Or Finish <= Index Or First = Undefined Or First >= Parts.Count() Then
		Raise StrTemplate("The operands of the division in %1 could not be delimited, and the"
			+ " platform types the dividend and the divisor separately. Put each operand in"
			+ " parentheses.", TokensText(Tokens, Max(Index - 3, 0), Min(Index + 3, Tokens.Count() - 1)));
	EndIf;

	Left = NumericOperand(Tokens, Start, Index - 1, Context);
	Right = NumericOperand(Tokens, Index + 1, Finish, Context);
	Reason = ?(IsBlankString(Left.Reason), Right.Reason, Left.Reason);
	If Not IsBlankString(Reason) Then
		Raise StrTemplate("The division %1 cannot be translated exactly: %2. The platform casts"
			+ " the dividend by its number of digits and passes the divisor in its own type, and"
			+ " SQL Server derives the scale of the quotient from both - without these types the"
			+ " result would differ from 1C in its last digits.", TokensText(Tokens, Start, Finish), Reason);
	EndIf;

	If Left.Constant And Right.Constant And Right.Value <> 0 Then
		// Константу платформа делит сама и передаёт параметром с 27-28 значащими цифрами
		// (10 / 3 - NUMERIC(28, 27)). Тип такого параметра в дальнейшей арифметике не замерен:
		// `Поле + 10 / 3` она пишет с приведением поля к NUMERIC(38, 8).
		If Not ConstantStandsAlone(Tokens, Start, Finish) Then
			Raise StrTemplate("The division of constants %1 stands inside arithmetic. The platform"
				+ " computes it itself and passes the value with 28 significant digits, and how it"
				+ " types the rest of the expression around such a value has not been measured."
				+ " Compute the constant beforehand and pass it as a parameter.",
				TokensText(Tokens, Start, Finish));
		EndIf;
		While Parts.Count() > First Do
			Parts.Delete(Parts.Count() - 1);
		EndDo;
		Parts.Add(FoldedQuotient(Left.Value / Right.Value));
		If Not Context.Options.SubstituteParameters And SpanHasParameter(Tokens, Start, Finish) Then
			AddOnce(Context.Warnings, StrTemplate("The division %1 is computed from the supplied parameter"
				+ " values, as the platform computes it itself: the SQL holds the quotient, and a value"
				+ " changed in the DECLARE header does not reach it.", TokensText(Tokens, Start, Finish)));
		EndIf;
		Consumed = Finish - Index;
		Return;
	EndIf;

	If Not Left.Unbounded And Not Right.Unbounded And Left.Fraction + Right.Fraction < 8 Then
		WrapDividend(Parts, First, StrTemplate("NUMERIC(%1, 8)", Format(Min(Left.Whole + 8, 38), "NG=0")));
	ElsIf Not Left.Exact Then
		WrapDividend(Parts, First, OperandSqlType(Left));
	EndIf;

	Parts.Add("/");
	If Right.Exact Then
		Return;
	EndIf;
	TypeName = OperandSqlType(Right);
	If Right.Constant And Tokens[Finish].Kind = "Number"
		And (Finish = Index + 1 Or Finish = Index + 2 And Tokens[Index + 1].Kind = "Symbol") Then
		Parts.Add("CAST(" + ?(Tokens[Index + 1].Value = "-", "-", "") + Tokens[Finish].Value
			+ " AS " + TypeName + ")");
		Consumed = Finish - Index;
		Return;
	EndIf;
	Parts.Add("CAST(");
	Closers.Add(New Structure("Finish, Text", Finish, " AS " + TypeName + ")"));

EndProcedure

// Частное констант литералом. Длиннее 38 цифр СУБД литерала не примет, и платформа передаёт
// его сокращённым: 1.123456789012 / 3 - NUMERIC(37, 37), 123456789012345678 / 7 -
// NUMERIC(38, 21) (замеры 7900-7903). Округление ли это или отсечение, сверкой не видно: 1С
// отдаёт значение запроса с 28 значащими цифрами.
Function FoldedQuotient(Value)

	Text = XMLString(Value);
	Digits = StrSplit(StrReplace(Text, "-", ""), ".", True);
	Whole = ?(Int(?(Value < 0, -Value, Value)) = 0, 0, StrLen(Digits[0]));
	Fraction = ?(Digits.Count() > 1, StrLen(Digits[1]), 0);
	Limit = ?(Whole = 0, 37, 38 - Whole);
	If Fraction > Limit Then
		Text = XMLString(Round(Value, Max(Limit, 0)));
	EndIf;
	Return Text;

EndFunction

Function SpanHasParameter(Tokens, Start, Finish)

	For Position = Start To Finish Do
		If Tokens[Position].Kind = "Parameter" Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Приведения делителей, чей последний токен уже позади. Позже открытое закрывается раньше.
Procedure CloseDivisionOperands(Closers, Parts, Index)

	Position = Closers.Count() - 1;
	While Position >= 0 Do
		If Closers[Position].Finish < Index And Parts.Count() > 0 Then
			Parts[Parts.Count() - 1] = Parts[Parts.Count() - 1] + Closers[Position].Text;
			Closers.Delete(Position);
		EndIf;
		Position = Position - 1;
	EndDo;

EndProcedure

Procedure WrapDividend(Parts, First, TypeName)

	Parts[First] = "CAST(" + Parts[First];
	Parts[Parts.Count() - 1] = Parts[Parts.Count() - 1] + " AS " + TypeName + ")";

EndProcedure

// СУММА, в аргументе которой есть деление: платформа приводит сумму к типу 1С - целых на
// шесть больше, чем у аргумента, дробных столько же (СУММА(Поле / 3) - NUMERIC(27, 8)), и
// частные, сложенные с 19 знаками, округляются до восьми. Пустая строка - приводить нечего.
Function SumOfQuotientPrefix(Tokens, Index, Closers, Context)

	Word = Upper(Tokens[Index].Value);
	If Context.Options.Dialect = "PostgreSQL" Or Tokens[Index].Kind <> "Name"
		Or Index + 1 >= Tokens.Count() Or Tokens[Index + 1].Value <> "(" Then
		Return "";
	EndIf;
	If Word = "COUNT" Or Word = Upper("Количество") Then
		// КОЛИЧЕСТВО платформа отдаёт как CAST(COUNT_BIG(...) AS NUMERIC(12)) - и *, и РАЗЛИЧНЫЕ,
		// в выборке, во временной таблице и в арифметике (замеры 43108, 43211, 43213).
		Closers.Add(New Structure("Finish, Text", MatchingParen(Tokens, Index + 1), " AS NUMERIC(12, 0))"));
		Return "CAST(";
	EndIf;
	If Word <> "SUM" And Word <> Upper("Сумма") Then
		Return "";
	EndIf;
	Closing = MatchingParen(Tokens, Index + 1);
	HasQuotient = False;
	For Position = Index + 2 To Closing - 1 Do
		If Tokens[Position].Kind = "Symbol" And Tokens[Position].Value = "/" Then
			HasQuotient = True;
			Break;
		EndIf;
	EndDo;
	// Сумму платформа приводит к своему типу всегда - в выборке, во временной таблице, в
	// объединении (CAST(SUM(Число(15, 2)) AS NUMERIC(21, 2)), замеры 43109-43112); перевод отдавал
	// NUMERIC(38, s), а в арифметике это урезало масштаб: `СУММА(Сумма) * 1.123456789012` в
	// группировке - 6 знаков против 13 (замер 7932). Тип не вывелся - сумма остаётся как есть.
	Operand = NumericOperand(Tokens, Index, Closing, Context);
	If Not HasQuotient And Not IsBlankString(Operand.Reason) Then
		Return "";
	EndIf;
	If Not IsBlankString(Operand.Reason) Then
		Raise StrTemplate("The sum %1 cannot be translated exactly: %2. The platform casts a sum of"
			+ " quotients to the type of its argument widened by six digits, which rounds every"
			+ " total to that scale.", TokensText(Tokens, Index, Closing), Operand.Reason);
	EndIf;
	Closers.Add(New Structure("Finish, Text", Closing, " AS " + OperandSqlType(Operand) + ")"));
	Return "CAST(";

EndFunction

// Колонка FieldIndex - ключ УПОРЯДОЧИТЬ ПО запроса из одного оператора.
Function OrderedColumn(Query, FieldIndex)

	If Query.Operators.Count() <> 1 Or FieldIndex >= Query.Columns.Count() Then
		Return False;
	EndIf;
	Alias = Upper(TrimAll(Query.Columns[FieldIndex].Alias));
	For Each OrderItem In Query.Order Do
		Try
			If Upper(TrimAll(OrderItem.Item.Alias)) = Alias Then
				Return True;
			EndIf;
		Except
			// Ключом бывает выражение, а не колонка.
		EndTry;
	EndDo;
	Return False;

EndFunction

// Текст поля выборки - числовой литерал, возможно со знаком.
// Литерал в ветви объединения, где в другой ветви на том же месте не литерал: платформа приводит
// его к типу 1С колонки объединения - `ЕСТЬNULL(Т.НомерСтроки, 0) ... ОБЪЕДИНИТЬ ВСЕ ... 0` даёт во
// второй ветви CAST(@P AS NUMERIC(5, 0)), и колонка остаётся numeric(5, 0), а не (10, 0) параметра
// (замер 18.11.2026, ERP WE). Литерал во всех ветвях платформа не приводит, и литерал, чей тип 1С
// (разрядность по записи: 0 - Число(1, 0)) равен типу колонки, тоже: Число(1, 0) ОБЪЕДИНИТЬ 0 - @P
// numeric(10), колонка numeric(10, 0) (пробы ucorp u1-u6, УХ). Пусто - правило не к месту.
Function UnionLiteralNumberType(Query, FieldIndex, Context, LiteralText)

	If Query.Operators.Count() < 2 Or FieldIndex >= Query.Columns.Count() Then
		Return "";
	EndIf;
	Type = UnionColumnNumberType(Query, FieldIndex, Context);
	If Type = Undefined Then
		Return "";
	EndIf;
	Clean = StrReplace(StrReplace(TrimAll(LiteralText), " ", ""), "-", "");
	Point = StrFind(Clean, ".");
	Whole = ?(Point = 0, Clean, Left(Clean, Point - 1));
	While StrLen(Whole) > 1 And Left(Whole, 1) = "0" Do
		Whole = Mid(Whole, 2);
	EndDo;
	Fraction = ?(Point = 0, 0, StrLen(Clean) - Point);
	If StrLen(Whole) + Fraction = Type.Digits And Fraction = Type.Fraction Then
		Return "";
	EndIf;
	Return StrTemplate("NUMERIC(%1, %2)", Format(Type.Digits, "NG=0"), Format(Type.Fraction, "NG=0; NZ=0"));

EndFunction

// Тип 1С числовой колонки объединения, у которой в одной из ветвей не литерал: Digits, Fraction
// или Undefined.
Function UnionColumnNumberType(Query, FieldIndex, Context)

	OtherKind = False;
	For Each Branch In Query.Operators Do
		If FieldIndex < BranchFieldCount(Query, Branch)
			And Not BareNumberText(ColumnFieldText(Query, Branch, FieldIndex)) Then
			OtherKind = True;
			Break;
		EndIf;
	EndDo;
	If Not OtherKind Then
		Return Undefined;
	EndIf;
	ValueType = Query.Columns[FieldIndex].ValueType;
	If ValueType <> Undefined And NumberOnly(ValueType) And ValueType.NumberQualifiers.Digits > 0 Then
		Return New Structure("Digits, Fraction", ValueType.NumberQualifiers.Digits,
			ValueType.NumberQualifiers.FractionDigits);
	EndIf;
	// Разрядности схема не знает (колонка временной таблицы из пролога): тип колонки объединения -
	// по выражениям ветвей, как у частного в объединении (UnionQuotientSql).
	Union = Undefined;
	Try
		Union = ColumnExpressionOperand(Query, Upper(TrimAll(Query.Columns[FieldIndex].Alias)), Context);
	Except
		Return Undefined;
	EndTry;
	If Union = Undefined Or Not IsBlankString(Union.Reason) Or Union.Unbounded
		Or Union.Whole + Union.Fraction = 0 Then
		Return Undefined;
	EndIf;
	Return New Structure("Digits, Fraction", Min(Union.Whole + Union.Fraction, 38), Union.Fraction);

EndFunction

Function BareNumberText(Text)

	Clean = StrReplace(TrimAll(Text), " ", "");
	If StrStartsWith(Clean, "-") Then
		Clean = Mid(Clean, 2);
	EndIf;
	Return Not IsBlankString(Clean) And NumberFromText(Clean) <> Undefined;

EndFunction

// Колонка временной таблицы из одного вида движения (ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход), ВЫБОР из
// них) или из голого NULL: платформа хранит её в #tt как numeric(1, 0), перевод отдавал int (замер
// 17.11.2026, УХ, scorp s2, s3, s5; в итоговой выборке тот же литерал у обоих - int).
Function PlacedSmallNumberSql(Expression, Text, ValueType, Context)

	If Context.Options.Dialect = "PostgreSQL" Or ValueType = Undefined Then
		Return Expression;
	EndIf;
	RecordKinds = 0;
	For Each Item In ValueType.Types() Do
		If Item = Type("AccumulationRecordType") Or Item = Type("AccountingRecordType") Then
			RecordKinds = RecordKinds + 1;
		ElsIf Item <> Type("Null") Then
			Return Expression;
		EndIf;
	EndDo;
	If RecordKinds > 0 Or Upper(TrimAll(Text)) = "NULL" Then
		Return "CAST(" + Expression + " AS NUMERIC(1, 0))";
	EndIf;
	Return Expression;

EndFunction

// Числовая часть составной колонки временной таблицы. Платформа создаёт колонку _N в #tt по числам
// выражения: литерал - его цифры без знака, ведущего нуля и хвостовых нулей (0 - numeric(1, 0),
// 0.50 - (1, 1), 1000000.123 - (10, 3)), поле - его тип, несколько - наибольшие целые плюс наибольшие
// дробные (0 и 1.5 - (2, 1), 0 и Число(15, 2) - (15, 2)); у МАКСИМУМ/МИНИМУМ - по аргументу. Ветви
// других видов (дата, строка, булево, ЗНАЧЕНИЕ) не влияют. Перевод держит временную таблицу
// подзапросом, и без приведения часть была бы в типе выражения: NUMERIC(10, 0) у 0, (38, 8) у 1.5
// (замер tempdb.sys.columns, УХ, 19.11.2026; ttcorp tt1-tt7, PurchasesGET_purchases ERP WE).
// Неопределено - число в ветвях не найдено или разрядность какой-то ветви не выводится.
Function PlacedNumberPart(Text, Context)

	Tokens = Tokenize(Text);
	If Tokens.Count() = 0 Then
		Return Undefined;
	EndIf;
	Start = 0;
	Finish = Tokens.Count() - 1;
	Word = Upper(Tokens[0].Value);
	If Tokens.Count() > 3 And (Word = "MAX" Or Word = "MIN" Or Word = Upper("Максимум") Or Word = Upper("Минимум"))
		And Tokens[1].Value = "(" And MatchingParen(Tokens, 1) = Finish Then
		Start = 2;
		Finish = Finish - 1;
	EndIf;
	Digits = New Structure("Whole, Fraction, Found", 0, 0, False);
	If Not CollectNumberBranches(Tokens, Start, Finish, Context, Digits) Or Not Digits.Found Then
		Return Undefined;
	EndIf;
	Return New Structure("Precision, Scale", Min(Max(Digits.Whole + Digits.Fraction, 1), 38), Digits.Fraction);

EndFunction

Function CollectNumberBranches(Tokens, Start, Finish, Context, Digits)

	If Finish < Start Then
		Return False;
	EndIf;
	First = Tokens[Start];
	If First.Value = "(" And MatchingParen(Tokens, Start) = Finish Then
		Return CollectNumberBranches(Tokens, Start + 1, Finish - 1, Context, Digits);
	EndIf;
	Word = Upper(First.Value);
	If First.Kind = "Name" And (Word = "CASE" Or Word = Upper("Выбор")) And CaseEnd(Tokens, Start) = Finish Then
		Position = Start + 1;
		While Position < Finish Do
			Token = Tokens[Position];
			Word = Upper(Token.Value);
			If Token.Value = "(" Then
				Position = MatchingParen(Tokens, Position) + 1;
				Continue;
			EndIf;
			If Token.Kind = "Name" And (Word = "CASE" Or Word = Upper("Выбор")) Then
				Position = CaseEnd(Tokens, Position) + 1;
				Continue;
			EndIf;
			If Token.Kind = "Name" And (Word = "THEN" Or Word = Upper("Тогда") Or Word = "ELSE" Or Word = Upper("Иначе")) Then
				BranchFinish = BranchEnd(Tokens, Position + 1);
				If Not CollectNumberBranches(Tokens, Position + 1, BranchFinish, Context, Digits) Then
					Return False;
				EndIf;
				Position = BranchFinish + 1;
				Continue;
			EndIf;
			Position = Position + 1;
		EndDo;
		Return True;
	EndIf;
	If Start = Finish Then
		If First.Kind = "String" Or Word = "NULL" Or Word = "TRUE" Or Word = "FALSE" Or Word = Upper("Истина")
			Or Word = Upper("Ложь") Or Word = "UNDEFINED" Or Word = Upper("Неопределено") Then
			Return True;
		EndIf;
		If First.Kind = "Name" And KeywordMap().Get(Word) = Undefined And LiteralMap(Context).Get(Word) = Undefined Then
			Exact = True;
			FieldType = NumericFieldType(First.Value, Context, Exact);
			If FieldType <> Undefined And Not FieldType.ContainsType(Type("Number")) Then
				Return True;
			EndIf;
		EndIf;
	ElsIf First.Kind = "Name" And Tokens[Start + 1].Value = "(" And MatchingParen(Tokens, Start + 1) = Finish
		And (Word = "DATETIME" Or Word = Upper("ДатаВремя") Or Word = "VALUE" Or Word = Upper("Значение")) Then
		Return True;
	EndIf;
	Operand = NumericOperand(Tokens, Start, Finish, Context);
	If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Then
		Return False;
	EndIf;
	Digits.Whole = Max(Digits.Whole, Operand.Whole);
	Digits.Fraction = Max(Digits.Fraction, Operand.Fraction);
	Digits.Found = True;
	Return True;

EndFunction

// Колонка временной таблицы с делением. Платформа кладёт её в колонку #tt типа модели, и
// частное с 19 знаками там округляется до восьми (Число(15, 2) / 3 - 722.38666667, замер
// 7780); перевод держит временную таблицу подзапросом, и без приведения знаков было бы 19.
Function PlacedQuotientSql(Expression, Text, ValueType, Context, Query = Undefined, FieldIndex = 0)

	Tokens = Tokenize(Text);
	HasQuotient = False;
	For Each Token In Tokens Do
		If Token.Kind = "Symbol" And Token.Value = "/" Then
			HasQuotient = True;
			Break;
		EndIf;
	EndDo;
	If Context.Options.Dialect = "PostgreSQL" Then
		Return Expression;
	EndIf;
	If ValueType = Undefined Or Not NumberOnly(ValueType) Then
		Return Expression;
	EndIf;
	// Колонка #tt - тип 1С выражения, и любое числовое значение в ней платформа хранит в этом
	// типе: литерал 0 - Число(1, 0), 1000000 - Число(7, 0), КОЛИЧЕСТВО - Число(12, 0), СУММА -
	// Число(p + 6, s), АВТОНОМЕРЗАПИСИ - Число(12, 1) (замеры 43105, 43213-43215, ворота 400).
	If Tokens.Count() = 3 And (Upper(Tokens[0].Value) = "RECORDAUTONUMBER"
		Or Upper(Tokens[0].Value) = Upper("АвтоНомерЗаписи")) Then
		Return StrTemplate("CAST(%1 AS NUMERIC(12, 1))", Expression);
	EndIf;
	If Not HasQuotient Then
		Own = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
		Target = Own;
		If IsBlankString(Own.Reason) And Query <> Undefined And Query.Operators.Count() > 1 Then
			Target = ColumnExpressionOperand(Query, Upper(TrimAll(Query.Columns[FieldIndex].Alias)), Context);
		EndIf;
		If Not IsBlankString(Own.Reason) Or Not IsBlankString(Target.Reason) Or Target.Unbounded Then
			Return Expression;
		EndIf;
		Digits = CappedDigits(Target.Whole, Target.Fraction);
		// У нуля цифр нет, а колонка - Число(1, 0).
		Precision = Max(Digits.Whole + Digits.Fraction, 1);
		If Own.Exact And Own.Precision = Precision And Own.Scale = Digits.Fraction Then
			Return Expression;
		EndIf;
		Return StrTemplate("CAST(%1 AS NUMERIC(%2, %3))", Expression,
			Format(Precision, "NG=0"), Format(Digits.Fraction, "NG=0; NZ=0"));
	EndIf;
	Digits = ValueType.NumberQualifiers.Digits;
	Fraction = ValueType.NumberQualifiers.FractionDigits;
	If Digits = 0 Then
		Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
		If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Then
			Raise StrTemplate("The temporary table column %1 holds a quotient whose number of digits is"
				+ " not known%2. The platform stores the column in a typed table and rounds the quotient"
				+ " to that type, and without the type the values would differ in their last digits.",
				Text, ?(IsBlankString(Operand.Reason), "", ": " + Operand.Reason));
		EndIf;
		Digits = Operand.Whole + Operand.Fraction;
		Fraction = Operand.Fraction;
	EndIf;
	Return StrTemplate("CAST(%1 AS NUMERIC(%2, %3))", Expression, Format(Digits, "NG=0"),
		Format(Fraction, "NG=0; NZ=0"));

EndFunction

// Колонка объединения, в ветвях которого есть деление. Платформа приводит ветвь к типу 1С
// колонки объединения, если тип ветви другой: `Т.СуммаУпр ОБЪЕДИНИТЬ ВСЕ Т.Сумма / 3` - первая
// ветвь CAST(... AS NUMERIC(21, 8)), `Т.Сумма / 3 ОБЪЕДИНИТЬ ВСЕ Т.Сумма / 7.5` - первая ветвь
// CAST(частное AS NUMERIC(22, 8)), и её частное округляется до восьми знаков, а у второй
// остаётся 17 (замеры 7912-7915).
Function UnionQuotientSql(Expression, Text, Query, FieldIndex, Context, NumberPart = False)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return Expression;
	EndIf;
	HasQuotient = False;
	For Each Branch In Query.Operators Do
		If FieldIndex >= BranchFieldCount(Query, Branch) Then
			Continue;
		EndIf;
		For Each Token In Tokenize(ColumnFieldText(Query, Branch, FieldIndex)) Do
			If Token.Kind = "Symbol" And Token.Value = "/" Then
				HasQuotient = True;
				Break;
			EndIf;
		EndDo;
	EndDo;
	If Not HasQuotient Then
		Return Expression;
	EndIf;
	// Тип колонки объединения читается только при делении в ветвях: у части колонок схемы (перепись
	// 21.11.2026, УХ, СверткаИнформационнойБазы) свойства ValueType нет вовсе.
	ValueType = Undefined;
	Try
		ValueType = Query.Columns[FieldIndex].ValueType;
	Except
		Raise StrTemplate("The union column %1 holds a quotient, and the query schema gives no type for it, so"
			+ " the scale the platform rounds the quotient to is unknown.", TrimAll(Query.Columns[FieldIndex].Alias));
	EndTry;
	If ValueType = Undefined Or Not (NumberOnly(ValueType) Or NumberPart And NumberBesideUndefined(ValueType)) Then
		Return Expression;
	EndIf;

	Alias = Upper(TrimAll(Query.Columns[FieldIndex].Alias));
	Union = ColumnExpressionOperand(Query, Alias, Context);
	Tokens = Tokenize(Text);
	Own = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
	Reason = ?(IsBlankString(Union.Reason), Own.Reason, Union.Reason);
	If IsBlankString(Reason) And Union.Unbounded Then
		Reason = "a branch holds a value without a fixed number of digits";
	EndIf;
	If Not IsBlankString(Reason) Then
		Raise StrTemplate("The union column %1 holds a quotient, and its type cannot be derived: %2. The"
			+ " platform casts every branch of another type to the type of the union column, which"
			+ " rounds a quotient to that scale.", TrimAll(Query.Columns[FieldIndex].Alias), Reason);
	EndIf;
	If Own.Unbounded Or Own.Whole <> Union.Whole Or Own.Fraction <> Union.Fraction Then
		Return StrTemplate("CAST(%1 AS NUMERIC(%2, %3))", Expression,
			Format(Min(Union.Whole + Union.Fraction, 38), "NG=0"), Format(Union.Fraction, "NG=0; NZ=0"));
	EndIf;
	Return Expression;

EndFunction

// Умножение в типах платформы. Сомножитель, тип которого у перевода другой (СУММА, КОЛИЧЕСТВО,
// колонка временной таблицы по модели), приводится к типу платформы; сверх 38 цифр сомножители
// сужаются, как их сужает платформа (ProductPlan): `x * x * x` у Число(15, 2) -
// CAST(x * x AS NUMERIC(24, 4)) * CAST(x AS NUMERIC(13, 2)). Литерал и параметр не приводятся.
Procedure MultiplicationSql(Tokens, Index, Parts, PartsAt, Closers, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Parts.Add("*");
		Return;
	EndIf;
	Start = DividendStart(Tokens, Index);
	Finish = DivisorEnd(Tokens, Index);
	First = PartsAt.Get(Start);
	If Start >= Index Or Finish <= Index Or First = Undefined Or First >= Parts.Count() Then
		Parts.Add("*");
		Return;
	EndIf;
	Left = NumericOperand(Tokens, Start, Index - 1, Context);
	Right = NumericOperand(Tokens, Index + 1, Finish, Context);
	CheckUnknownParameter(Left, Right, "*", Tokens, Start, Finish);
	If Not IsBlankString(Left.Reason) Or Not IsBlankString(Right.Reason)
		Or Left.Constant And Right.Constant Then
		Parts.Add("*");
		Return;
	EndIf;
	Plan = ProductPlan(Left, Right);
	If Plan.Narrow And Not Left.Constant Then
		WrapDividend(Parts, First, StrTemplate("NUMERIC(%1, %2)", Format(Plan.LeftWhole + Left.Fraction, "NG=0"),
			Format(Left.Fraction, "NG=0; NZ=0")));
	ElsIf Not Plan.Narrow And Not Left.Exact And Not Left.Constant Then
		WrapDividend(Parts, First, OperandSqlType(Left));
	EndIf;
	Parts.Add("*");
	If Right.Constant Then
		Return;
	EndIf;
	TypeName = "";
	If Plan.Narrow Then
		TypeName = StrTemplate("NUMERIC(%1, %2)", Format(Plan.RightWhole + Right.Fraction, "NG=0"),
			Format(Right.Fraction, "NG=0; NZ=0"));
	ElsIf Not Right.Exact Then
		TypeName = OperandSqlType(Right);
	EndIf;
	If Not IsBlankString(TypeName) Then
		Parts.Add("CAST(");
		Closers.Add(New Structure("Finish, Text", Finish, " AS " + TypeName + ")"));
	EndIf;

EndProcedure

// Параметр - операнд арифметики. Платформа передаёт его в типе по значению (NUMERIC(10),
// NUMERIC(38, 8) или точный тип, в группировке - литералом), и от этого типа зависит масштаб
// результата: `Сумма * &П` при П = 0.12345678 у 1С - шесть знаков (замер 7931). Перевод пишет
// переменную в этом типе явно, при подстановке и без неё.
Function ArithmeticParameterSql(Reference, Tokens, Index, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return Reference;
	EndIf;
	Before = ?(Index > 0, Tokens[Index - 1].Value, "");
	After = ?(Index + 1 < Tokens.Count(), Tokens[Index + 1].Value, "");
	Binary = (Before = "+" Or Before = "-") And Index > 1 And EndsOperand(Tokens[Index - 2]);
	If Not (Before = "*" Or Before = "/" Or IsArithmetic(After) Or Binary) Then
		Return Reference;
	EndIf;
	Operand = ParameterOperand(Tokens[Index].Value, Context);
	If Not IsBlankString(Operand.Reason) Then
		Return Reference;
	EndIf;
	Return "CAST(" + Reference + " AS " + OperandSqlType(Operand) + ")";

EndFunction

// Сложение и вычитание с параметром, значение которого не передано.
Procedure AdditionSql(Tokens, Index, Parts, PartsAt, Closers, Context)

	Sign = Tokens[Index].Value;
	If Context.Options.Dialect = "PostgreSQL" Then
		Parts.Add(Sign);
		Return;
	EndIf;
	Start = Index;
	Position = Index;
	While True Do
		Start = DividendStart(Tokens, Position);
		If Start >= Position Then
			Parts.Add(Sign);
			Return;
		EndIf;
		If Start > 1 And Tokens[Start - 1].Kind = "Symbol"
			And (Tokens[Start - 1].Value = "+" Or Tokens[Start - 1].Value = "-")
			And EndsOperand(Tokens[Start - 2]) Then
			Position = Start - 1;
			Continue;
		EndIf;
		Break;
	EndDo;
	Finish = DivisorEnd(Tokens, Index);
	While Finish > Index And Finish + 1 < Tokens.Count() And Tokens[Finish + 1].Kind = "Symbol"
		And (Tokens[Finish + 1].Value = "*" Or Tokens[Finish + 1].Value = "/") Do
		Finish = DivisorEnd(Tokens, Finish + 1);
	EndDo;
	First = PartsAt.Get(Start);
	If Finish <= Index Or First = Undefined Or First >= Parts.Count() Then
		Parts.Add(Sign);
		Return;
	EndIf;
	Left = NumericOperand(Tokens, Start, Index - 1, Context);
	Right = NumericOperand(Tokens, Index + 1, Finish, Context);
	CheckUnknownParameter(Left, Right, "+", Tokens, Start, Finish);
	If Not IsBlankString(Left.Reason) Or Not IsBlankString(Right.Reason) Or Left.Unbounded Or Right.Unbounded Then
		Parts.Add(Sign);
		Return;
	EndIf;
	If WidenedAddend(Left, Right) Then
		WrapDividend(Parts, First, StrTemplate("NUMERIC(38, %1)", Format(Min(Right.Fraction, 8), "NG=0; NZ=0")));
	EndIf;
	Parts.Add(Sign);
	If WidenedAddend(Right, Left) Then
		Parts.Add("CAST(");
		Closers.Add(New Structure("Finish, Text", Finish,
			StrTemplate(" AS NUMERIC(38, %1))", Format(Min(Left.Fraction, 8), "NG=0; NZ=0"))));
	EndIf;

EndProcedure

// Слагаемое, которое платформа приводит к NUMERIC(38, min(дробные другого, 8)): его целые вместе с
// дробными другого слагаемого больше 38 (замеры 840000-840014, 841200-841313): Число(38, 0) +
// Число(36, 2) - CAST(x AS NUMERIC(38, 2)) + y, Число(38, 10) + Число(20, 15) - CAST(x AS NUMERIC(38,
// 8)) + y, Число(34, 0) + Число(10, 4) - без приведения. Константа не приводится.
Function WidenedAddend(Addend, Other)

	Return Not Addend.Constant And Addend.Whole + Other.Fraction > 38;

EndFunction

// Один операнд - параметр без значения, другой - число известного типа. Перевод допустим, только
// если ни при одном типе, который платформа может дать параметру, СУБД не урежет масштаб
// результата ниже точного: NUMERIC(10), NUMERIC(38, 8) и точный тип с девятью-37 дробными знаками.
Procedure CheckUnknownParameter(Left, Right, Sign, Tokens, Start, Finish)

	If Left.Property("UnknownParameter") And IsBlankString(Right.Reason) Then
		Name = Left.UnknownParameter;
		Known = Right;
	ElsIf Right.Property("UnknownParameter") And IsBlankString(Left.Reason) Then
		Name = Right.UnknownParameter;
		Known = Left;
	Else
		Return;
	EndIf;
	If Known.Unbounded Then
		Known = NewOperand(0, Known.Scale, Known.Precision, Known.Scale, True);
	EndIf;
	Candidates = New Array;
	Candidates.Add(NewOperand(10, 0, 10, 0, False));
	Candidates.Add(NewOperand(30, 8, 38, 8, False));
	For Fraction = 9 To 37 Do
		Candidates.Add(NewOperand(0, Fraction, Fraction, Fraction, False));
		Candidates.Add(NewOperand(38 - Fraction, Fraction, 38, Fraction, False));
	EndDo;
	For Each Candidate In Candidates Do
		If Sign = "*" Then
			Type = MultiplicativeSqlType(Known.Precision + Candidate.Precision + 1, Known.Scale + Candidate.Scale);
			Exact = Known.Fraction + Candidate.Fraction;
		Else
			Scale = Max(Known.Scale, Candidate.Scale);
			Type = AdditiveSqlType(Max(Known.Precision - Known.Scale, Candidate.Precision - Candidate.Scale)
				+ Scale + 1, Scale);
			Exact = Max(Known.Fraction, Candidate.Fraction);
		EndIf;
		If Type.Scale < Exact Then
			Raise StrTemplate("The value of parameter &%1 in %2 is not given. The platform types a parameter"
				+ " by its value - NUMERIC(10) for an integer of up to ten digits, the exact type for more"
				+ " than eight fraction digits, NUMERIC(38, 8) otherwise - and with NUMERIC(%3, %4) SQL"
				+ " Server would cut the scale of the result to %5 of %6 digits. Pass the value in"
				+ " ParameterValues: a sample with the same number of integer and fraction digits is enough,"
				+ " it only sets the type, and with SubstituteParameters = False the SQL keeps the @variable.",
				Name, TokensText(Tokens, Start, Finish), Format(Candidate.Precision, "NG=0"),
				Format(Candidate.Scale, "NG=0; NZ=0"), Format(Type.Scale, "NG=0; NZ=0"), Format(Exact, "NG=0"));
		EndIf;
	EndDo;

EndProcedure

// Тип суммы у MS SQL сверх 38 цифр: дробных остаётся 38 минус большие целые слагаемых, перенос
// разряда в счёт не идёт (NUMERIC(30, 2) + NUMERIC(20, 15) - NUMERIC(38, 10), NUMERIC(35, 0) +
// NUMERIC(10, 4) - NUMERIC(38, 3); sp_describe_first_result_set, 16.11.2026).
Function AdditiveSqlType(Precision, Scale)

	If Precision > 38 Then
		Integral = Precision - Scale - 1;
		Scale = Max(Min(Scale, 38 - Integral), 0);
		Precision = 38;
	EndIf;
	Return New Structure("Precision, Scale", Precision, Scale);

EndFunction

// Начало делимого: цепочка операндов через * и / слева от знака, со знаком перед первым.
Function DividendStart(Tokens, Index)

	Position = Index - 1;
	While Position >= 0 Do
		Start = OperandStartBackward(Tokens, Position);
		If Start < 0 Then
			Return Index;
		EndIf;
		Before = Start - 1;
		If Before >= 0 And Tokens[Before].Kind = "Symbol"
			And (Tokens[Before].Value = "-" Or Tokens[Before].Value = "+")
			And (Before = 0 Or Not EndsOperand(Tokens[Before - 1])) Then
			Start = Before;
			Before = Start - 1;
		EndIf;
		If Before >= 0 And Tokens[Before].Kind = "Symbol"
			And (Tokens[Before].Value = "*" Or Tokens[Before].Value = "/") Then
			Position = Before - 1;
			Continue;
		EndIf;
		Return Start;
	EndDo;
	Return Index;

EndFunction

// Первый токен операнда, который кончается на Position; -1 - там не конец операнда.
Function OperandStartBackward(Tokens, Position)

	Token = Tokens[Position];
	Word = Upper(Token.Value);
	If Token.Kind = "Symbol" And Token.Value = ")" Then
		Depth = 0;
		Open = Position;
		While Open >= 0 Do
			If Tokens[Open].Value = ")" Then
				Depth = Depth + 1;
			ElsIf Tokens[Open].Value = "(" Then
				Depth = Depth - 1;
				If Depth = 0 Then
					Break;
				EndIf;
			EndIf;
			Open = Open - 1;
		EndDo;
		If Open < 0 Then
			Return -1;
		EndIf;
		If Open > 0 And Tokens[Open - 1].Kind = "Name"
			And KeywordMap().Get(Upper(Tokens[Open - 1].Value)) = Undefined Then
			Return Open - 1;
		EndIf;
		Return Open;
	EndIf;
	If Token.Kind = "Name" And (Word = "END" Or Word = Upper("Конец")) Then
		Depth = 0;
		Open = Position;
		While Open >= 0 Do
			Value = Upper(Tokens[Open].Value);
			If Tokens[Open].Kind = "Name" And (Value = "END" Or Value = Upper("Конец")) Then
				Depth = Depth + 1;
			ElsIf Tokens[Open].Kind = "Name" And (Value = "CASE" Or Value = Upper("Выбор")) Then
				Depth = Depth - 1;
				If Depth = 0 Then
					Return Open;
				EndIf;
			EndIf;
			Open = Open - 1;
		EndDo;
		Return -1;
	EndIf;
	If Token.Kind = "Number" Or Token.Kind = "Parameter" Or Token.Kind = "String" Then
		Return Position;
	EndIf;
	If Token.Kind = "Name" And KeywordMap().Get(Word) = Undefined Then
		// Поле значения выражения - `(...).Числитель`: операнд начинается со скобки.
		If Position > 1 And Tokens[Position - 1].Value = "." And Tokens[Position - 2].Value = ")" Then
			Return OperandStartBackward(Tokens, Position - 2);
		EndIf;
		Return Position;
	EndIf;
	Return -1;

EndFunction

// Последний токен делителя: один операнд справа от знака, со своим знаком.
Function DivisorEnd(Tokens, Index)

	Position = Index + 1;
	If Position < Tokens.Count() And Tokens[Position].Kind = "Symbol"
		And (Tokens[Position].Value = "-" Or Tokens[Position].Value = "+") Then
		Position = Position + 1;
	EndIf;
	If Position >= Tokens.Count() Then
		Return Index;
	EndIf;
	Token = Tokens[Position];
	Word = Upper(Token.Value);
	If Token.Value = "(" Then
		Closing = MatchingParen(Tokens, Position);
		If Closing + 2 < Tokens.Count() And Tokens[Closing + 1].Value = "." And Tokens[Closing + 2].Kind = "Name" Then
			Return Closing + 2;
		EndIf;
		Return Closing;
	EndIf;
	If Token.Kind = "Name" And (Word = "CASE" Or Word = Upper("Выбор")) Then
		Return CaseEnd(Tokens, Position);
	EndIf;
	If Token.Kind = "Name" And Position + 1 < Tokens.Count() And Tokens[Position + 1].Value = "("
		And KeywordMap().Get(Word) = Undefined Then
		Closing = MatchingParen(Tokens, Position + 1);
		// ВЫРАЗИТЬ(&П КАК Справочник.X).Поле - поле значения вызова.
		If Closing + 2 < Tokens.Count() And Tokens[Closing + 1].Value = "." And Tokens[Closing + 2].Kind = "Name" Then
			Return Closing + 2;
		EndIf;
		Return Closing;
	EndIf;
	If Token.Kind = "Number" Or Token.Kind = "Parameter" Or Token.Kind = "String"
		Or Token.Kind = "Name" And KeywordMap().Get(Word) = Undefined Then
		Return Position;
	EndIf;
	Return Index;

EndFunction

// КОНЕЦ своего ВЫБОРа.
Function CaseEnd(Tokens, CaseIndex)

	Depth = 0;
	For Position = CaseIndex To Tokens.Count() - 1 Do
		If Tokens[Position].Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(Tokens[Position].Value);
		If Word = "CASE" Or Word = Upper("Выбор") Then
			Depth = Depth + 1;
		ElsIf Word = "END" Or Word = Upper("Конец") Then
			Depth = Depth - 1;
			If Depth = 0 Then
				Return Position;
			EndIf;
		EndIf;
	EndDo;
	Return Tokens.Count() - 1;

EndFunction

// Константа, вокруг которой нет арифметики: скобки вокруг неё не в счёт.
Function ConstantStandsAlone(Tokens, Start, Finish)

	While Start > 0 And Finish + 1 < Tokens.Count() And Tokens[Start - 1].Value = "("
		And Tokens[Finish + 1].Value = ")" And MatchingParen(Tokens, Start - 1) = Finish + 1
		And (Start = 1 Or Tokens[Start - 2].Kind <> "Name"
			Or KeywordMap().Get(Upper(Tokens[Start - 2].Value)) <> Undefined) Do
		Start = Start - 1;
		Finish = Finish + 1;
	EndDo;
	Before = ?(Start > 0, Tokens[Start - 1].Value, "");
	After = ?(Finish + 1 < Tokens.Count(), Tokens[Finish + 1].Value, "");
	Return Not IsArithmetic(Before) And Not IsArithmetic(After);

EndFunction

// Тип числового операнда так, как его видит платформа. Whole и Fraction - разрядность 1С
// (целые и дробные цифры), по ней платформа приводит делимое. Precision и Scale - тип SQL, в
// котором операнд уходит в СУБД. Exact - перевод даёт операнд в том же типе SQL. Unbounded -
// у значения нет разрядности 1С: частное без приведения, СРЕДНЕЕ. Constant - литерал или
// параметр с известным значением. Reason непуст - тип не выводится, и это причина.
Function NumericOperand(Tokens, Start, Finish, Context)

	If Finish < Start Then
		Return UnknownOperand("an operand is missing");
	EndIf;
	First = Tokens[Start];
	If First.Value = "(" And MatchingParen(Tokens, Start) = Finish Then
		Return NumericOperand(Tokens, Start + 1, Finish - 1, Context);
	EndIf;

	Position = TopLevelBinary(Tokens, Start, Finish, "+-");
	If Position > 0 Then
		Return SumOperand(NumericOperand(Tokens, Start, Position - 1, Context),
			NumericOperand(Tokens, Position + 1, Finish, Context));
	EndIf;
	Position = TopLevelBinary(Tokens, Start, Finish, "*/");
	If Position > 0 Then
		Left = NumericOperand(Tokens, Start, Position - 1, Context);
		Right = NumericOperand(Tokens, Position + 1, Finish, Context);
		If Tokens[Position].Value = "*" Then
			Return ProductOperand(Left, Right);
		EndIf;
		Return QuotientOperand(Left, Right);
	EndIf;

	If First.Kind = "Symbol" And (First.Value = "-" Or First.Value = "+") Then
		Operand = NumericOperand(Tokens, Start + 1, Finish, Context);
		If First.Value = "-" And Operand.Constant Then
			Operand.Value = -Operand.Value;
		EndIf;
		Return Operand;
	EndIf;

	Word = Upper(First.Value);
	If Start = Finish Then
		If First.Kind = "Number" Then
			Return ConstantOperand(NumberFromText(First.Value), Context);
		ElsIf First.Kind = "Parameter" Then
			Return ParameterOperand(First.Value, Context);
		ElsIf First.Kind = "Name" And KeywordMap().Get(Word) = Undefined
			And LiteralMap(Context).Get(Word) = Undefined Then
			Return FieldOperand(First.Value, Context);
		EndIf;
		Return UnknownOperand(StrTemplate("%1 is not a number", First.Value));
	EndIf;

	If First.Kind = "Name" And (Word = "CASE" Or Word = Upper("Выбор")) And CaseEnd(Tokens, Start) = Finish Then
		Return CaseOperand(Tokens, Start, Finish, Context);
	EndIf;
	If First.Kind = "Name" And Tokens[Start + 1].Value = "(" And MatchingParen(Tokens, Start + 1) = Finish Then
		Return FunctionOperand(Tokens, Start, Finish, Context);
	EndIf;
	Dereferenced = CastFieldOperand(Tokens, Start, Finish);
	If Dereferenced <> Undefined Then
		Return Dereferenced;
	EndIf;
	Return UnknownOperand(StrTemplate("the type of %1 is not derived", TokensText(Tokens, Start, Finish)));

EndFunction

Function NewOperand(Whole, Fraction, Precision, Scale, Exact)

	Operand = New Structure("Whole, Fraction, Precision, Scale, Exact, Unbounded, Constant, Value, Reason",
		Whole, Fraction, Precision, Scale, Exact, False, False, Undefined, "");
	// ВЫРАЗИТЬ к числу: произведение с таким сомножителем платформа не сужает (ProductPlan).
	Operand.Insert("Cast", False);
	Return Operand;

EndFunction

Function UnknownOperand(Reason)

	Operand = NewOperand(0, 0, 0, 0, False);
	Operand.Reason = Reason;
	Return Operand;

EndFunction

// Без разрядности 1С: дробных знаков условно 99, приведения делимого такой операнд не даёт.
Function UnboundedOperand(Precision, Scale, Exact)

	Operand = NewOperand(0, 99, Precision, Scale, Exact);
	Operand.Unbounded = True;
	Return Operand;

EndFunction

Function OperandSqlType(Operand)

	Return StrTemplate("NUMERIC(%1, %2)", Format(Operand.Precision, "NG=0; NZ=0"),
		Format(Operand.Scale, "NG=0; NZ=0"));

EndFunction

// Самый правый бинарный знак из Signs вне скобок и вне ВЫБОРа; 0 - такого нет.
Function TopLevelBinary(Tokens, Start, Finish, Signs)

	Depth = 0;
	Position = Finish;
	While Position > Start Do
		Token = Tokens[Position];
		Word = Upper(Token.Value);
		If Token.Value = ")" Then
			Depth = Depth + 1;
		ElsIf Token.Value = "(" Then
			Depth = Depth - 1;
		ElsIf Token.Kind = "Name" And (Word = "END" Or Word = Upper("Конец")) Then
			Depth = Depth + 1;
		ElsIf Token.Kind = "Name" And (Word = "CASE" Or Word = Upper("Выбор")) Then
			Depth = Depth - 1;
		ElsIf Depth = 0 And Token.Kind = "Symbol" And StrLen(Token.Value) = 1
			And StrFind(Signs, Token.Value) > 0 And EndsOperand(Tokens[Position - 1]) Then
			Return Position;
		EndIf;
		Position = Position - 1;
	EndDo;
	Return 0;

EndFunction

// Литерал или значение параметра. Платформа передаёт его параметром: целое до десяти цифр -
// NUMERIC(10), больше восьми дробных знаков - в точном типе значения, прочее - NUMERIC(38, 8); в операторе с группировкой - литералом в тексте, и
// целое в пределах int тогда пишется с `.0` (7 - `7.0`, NUMERIC(2, 1)), а прочее как есть
// (0.25 - NUMERIC(2, 2), 123456789012 - NUMERIC(12, 0)). Знак уходит отдельно: -25 - это
// `-@P1` с @P1 = 25, тип у него тот же.
Function ConstantOperand(Value, Context)

	If TypeOf(Value) <> Type("Number") Then
		Return UnknownOperand("a constant is not a number");
	EndIf;
	Magnitude = ?(Value < 0, -Value, Value);
	Digits = StrSplit(XMLString(Magnitude), ".", True);
	Whole = ?(Int(Magnitude) = 0, 0, StrLen(Digits[0]));
	Fraction = ?(Digits.Count() > 1, StrLen(Digits[1]), 0);
	If Context.Property("LiteralsInline") And Context.LiteralsInline Then
		If Fraction = 0 And Magnitude <= 2147483647 Then
			Operand = NewOperand(Whole, Fraction, Whole + 1, 1, False);
		Else
			Operand = NewOperand(Whole, Fraction, Max(Whole + Fraction, 1), Fraction, False);
		EndIf;
	ElsIf Fraction = 0 And Whole <= 10 Then
		// Голый целый литерал СУБД типизирует по его цифрам (3 - NUMERIC(1, 0)), а не как
		// NUMERIC(10): `x / -3` дал 10 знаков вместо 19. Поэтому точным константу не считаем.
		Operand = NewOperand(Whole, Fraction, 10, 0, False);
	ElsIf Fraction > 8 Then
		// Больше восьми дробных знаков - точный тип значения: 1.123456789012 - NUMERIC(13, 12),
		// 10 / 3 - NUMERIC(28, 27) (замеры 7880-7883, 7710).
		Operand = NewOperand(Whole, Fraction, Min(Whole + Fraction, 38), Fraction, False);
	Else
		Operand = NewOperand(Whole, Fraction, 38, 8, False);
	EndIf;
	Operand.Constant = True;
	Operand.Value = Value;
	Return Operand;

EndFunction

// Тип параметра платформа берёт из его значения, поэтому значение нужно и без подстановки:
// в SQL остаётся переменная, а тип из значения идёт в приведение и в шапку DECLARE.
Function ParameterOperand(Name, Context)

	Value = Undefined;
	If Not IsOuterColumnStub(Name, Context) And Context.Options.Property("ParameterValues")
		And TypeOf(Context.Options.ParameterValues) = Type("Map") Then
		Value = Context.Options.ParameterValues.Get(Name);
	EndIf;
	If Value = Null Then
		// Значение NULL: результат арифметики NULL при любом типе параметра (негативная
		// батарея dz26: 5 / &П при NULL - NULL).
		Return NewOperand(10, 0, 10, 0, False);
	ElsIf Value <> Undefined And TypeOf(Value) <> Type("Number") Then
		// Значение не число: платформа отвергает запрос («Wrong parameters», батарея dz29).
		Kind = ?(TypeOf(Value) = Type("String"), "String", ?(TypeOf(Value) = Type("Date"), "Date",
			?(TypeOf(Value) = Type("Boolean"), "Boolean", "Reference")));
		RefuseParameterKind(Name, Kind, "Number", "arithmetic");
	EndIf;
	If TypeOf(Value) <> Type("Number") Then
		Unknown = UnknownOperand(StrTemplate("the value of parameter &%1 is not given, and the platform"
			+ " types a parameter by its value (NUMERIC(10) for an integer of up to ten digits,"
			+ " the exact type for more than eight fraction digits, NUMERIC(38, 8) otherwise) and"
			+ " casts a dividend by its digits. Pass the value in ParameterValues: a sample with the"
			+ " same number of integer and fraction digits is enough, it only sets the type, and with"
			+ " SubstituteParameters = False the SQL keeps the @variable", Name));
		Unknown.Insert("UnknownParameter", Name);
		Return Unknown;
	EndIf;
	Operand = ConstantOperand(Value, Context);
	Operand.Exact = False;
	Return Operand;

EndFunction

Function FieldOperand(Path, Context)

	Aggregated = AggregatedResourceOperand(Path, Context);
	If Aggregated <> Undefined Then
		Return Aggregated;
	EndIf;
	Computed = ComputedColumnOperand(Path, Context);
	If Computed <> Undefined Then
		Return Computed;
	EndIf;
	Exact = True;
	FieldType = NumericFieldType(Path, Context, Exact);
	If FieldType = Undefined Then
		Return UnknownOperand(StrTemplate("the number of digits of %1 is not known", Path));
	EndIf;
	If Not NumberOnly(FieldType) Then
		Kinds = New Array;
		For Each Kind In FieldType.Types() Do
			Kinds.Add(String(Kind));
		EndDo;
		Return UnknownOperand(StrTemplate("%1 is not a field of type Number alone (%2)", Path, StrConcat(Kinds, ", ")));
	EndIf;
	Digits = FieldType.NumberQualifiers.Digits;
	Fraction = FieldType.NumberQualifiers.FractionDigits;
	If Digits = 0 Then
		Return UnknownOperand(StrTemplate("%1 is a number without length", Path));
	EndIf;
	Return NewOperand(Digits - Fraction, Fraction, Digits, Fraction, Exact);

EndFunction

// Остаток или оборот виртуальной таблицы регистра накопления - см. RegisterAggregatedResources.
Function AggregatedResourceOperand(Path, Context, WithSql = False)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	Descriptor = Resolved.Descriptor;
	If Descriptor = Undefined Or Not Descriptor.Property("AggregatedResources") Then
		Return Undefined;
	EndIf;
	Entry = Descriptor.AggregatedResources.Get(Upper(TrimAll(Resolved.FieldName)));
	If Entry = Undefined Then
		Return Undefined;
	EndIf;
	// Остатки и обороты платформа собирает по-разному в зависимости от того, какие поля
	// спросил оператор (замеры 44400-44528): без остатков оборот - +6, с остатком - +12; конечный
	// остаток без начала периода - +14, а если спрошен и оборот - +13. Спрошены все измерения
	// регистра - платформа не сворачивает строки итогов, и остаток уже: +6 у Остатки, +12 и +14
	// у начального и конечного с началом периода (замеры 45220-45263, УХ).
	If Entry.Property("AllDimensions") And VirtualFieldsReferenced(Descriptor, "DimensionNames", Context) Then
		Entry = Entry.AllDimensions;
	ElsIf Entry.Property("Plain") And Not VirtualFieldsReferenced(Descriptor, "BalanceNames", Context) Then
		Entry = Entry.Plain;
	ElsIf Entry.Property("WithTurnover") And VirtualFieldsReferenced(Descriptor, "TurnoverNames", Context) Then
		Entry = Entry.WithTurnover;
	EndIf;
	If WithSql Then
		Return Entry;
	EndIf;
	// Ссылку на итог перевод приводит к этому же типу (AggregatedResourceSql).
	Return NewOperand(Entry.Whole, Entry.Fraction, Entry.Whole + Entry.Fraction, Entry.Fraction, True);

EndFunction

// Итог виртуальной таблицы в типе SQL платформы: она приводит SUM внутри таблицы, перевод - при
// обращении к колонке (Остатки - CAST(SUM AS NUMERIC(p + 12, s)), Обороты - p + 6). Пустая
// строка - это не итог.
Function AggregatedResourceSql(Path, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return "";
	EndIf;
	Entry = AggregatedResourceOperand(Path, Context, True);
	If Entry = Undefined Then
		Return "";
	EndIf;
	Return StrTemplate("NUMERIC(%1, %2)", Format(Entry.Whole + Entry.Fraction, "NG=0"),
		Format(Entry.Fraction, "NG=0; NZ=0"));

EndFunction
// Спрашивает ли оператор хоть одно поле виртуальной таблицы из набора Descriptor[Names] - в
// списке выборки, в условиях, в группировке или в соединениях; для DimensionNames - все поля
// набора. Ответ запоминается в описателе.
Function VirtualFieldsReferenced(Descriptor, Names, Context)

	CacheKey = "Referenced" + Names;
	If Descriptor.Property(CacheKey) Then
		Return Descriptor[CacheKey];
	EndIf;
	Every = (Names = "DimensionNames");
	If Not Descriptor.Property(Names) Or Not Context.Property("Operator") Or Context.Operator = Undefined Then
		Return Not Every;
	EndIf;
	If Every And Descriptor[Names].Count() = 0 Then
		Return False;
	EndIf;
	Aliases = New Map;
	For Each Item In Context.Aliases Do
		If Item.Value.Descriptor = Descriptor Then
			Aliases.Insert(Item.Key, True);
		EndIf;
	EndDo;
	Operator = Context.Operator;
	Texts = New Array;
	For Each Expression In Operator.SelectedFields Do
		Texts.Add(String(Expression));
	EndDo;
	For Each Expression In Operator.Filter Do
		Texts.Add(String(Expression));
	EndDo;
	For Each GroupText In GroupTexts(Operator, Context) Do
		Texts.Add(GroupText);
	EndDo;
	For Each Source In Operator.Sources Do
		For Each Join In Source.Joins Do
			Texts.Add(JoinConditionText(Join));
		EndDo;
	EndDo;
	Seen = New Map;
	For Each Text In Texts Do
		For Each Token In Tokenize(Text) Do
			If Token.Kind <> "Name" Then
				Continue;
			EndIf;
			// Измерение спрашивают и через точку дальше: Т.Номенклатура.Наименование.
			Parts = StrSplit(Upper(Token.Value), ".");
			If Parts.Count() >= 2 And Aliases.Get(Parts[0]) <> Undefined
				And Descriptor[Names].Get(Parts[1]) <> Undefined Then
				Seen.Insert(Parts[1], True);
			ElsIf Descriptor[Names].Get(Parts[0]) <> Undefined Then
				Seen.Insert(Parts[0], True);
			EndIf;
		EndDo;
	EndDo;
	Found = ?(Every, Seen.Count() = Descriptor[Names].Count(), Seen.Count() > 0);
	Descriptor.Insert(CacheKey, Found);
	Return Found;

EndFunction

// Среднее от значения с шестью дробными знаками и больше платформа пишет без множителя 1.0:
// `СРЕДНЕЕ(Сумма / 3)` - AVG(частное), 11 знаков; с множителем масштаб на знак больше (замер 7910).
Function AverageKeepsScale(Text, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return False;
	EndIf;
	Try
		Tokens = Tokenize(Text);
		Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
	Except
		Return False;
	EndTry;
	Return IsBlankString(Operand.Reason) And Operand.Scale >= 6;

EndFunction

// Тип поля, из которого колонка пришла без изменений, если это число. Происхождение бывает и у
// вычисляемой колонки: КОЛИЧЕСТВО(Т.Ссылка) ведёт к Т.Ссылка, и тип этого поля к колонке не
// относится - её тип даёт выражение (КОЛИЧЕСТВО - Число(12, 0)). Undefined - числового поля нет.
Function NumericOrigin(Descriptor, FieldName)

	If Not Descriptor.Property("ColumnSources") Or Descriptor.ColumnSources = Undefined Then
		Return Undefined;
	EndIf;
	Origin = Descriptor.ColumnSources.Get(FieldName);
	If Origin = Undefined Or Not Origin.Property("FieldName") Then
		Return Undefined;
	EndIf;
	Owner = MetadataOf(Origin.LogicalName);
	If Owner = Undefined Then
		Return Undefined;
	EndIf;
	FieldType = FieldTypeDescription(Owner, TrimAll(Origin.FieldName));
	If FieldType = Undefined Or Not NumberOnly(FieldType) Then
		Return Undefined;
	EndIf;
	Return FieldType;

EndFunction

// Тип - число, допустимо вместе с Null. Null в наборе типов колонки дают левое соединение и ветвь
// NULL (КОЛИЧЕСТВО из вложенного запроса по левому соединению, ВЫБОР ... ИНАЧЕ NULL); платформа
// считает такую колонку числом: ISNULL(T2.Q_001_F_001_, @P1) приводит к NUMERIC(20, 8) как
// КОЛИЧЕСТВО, колонку ВТ из ВЫБОР с NULL - как поле (замеры 841009, 841010).
// Число рядом с НЕОПРЕДЕЛЕНО (и NULL) - числовая часть составной колонки.
Function NumberBesideUndefined(TypeDescription)

	HasNumber = False;
	For Each Kind In TypeDescription.Types() Do
		If Kind = Type("Number") Then
			HasNumber = True;
		ElsIf Kind <> Type("Null") And Kind <> TypeOf(Undefined) Then
			Return False;
		EndIf;
	EndDo;
	Return HasNumber;

EndFunction

Function NumberOnly(TypeDescription)

	HasNumber = False;
	For Each Kind In TypeDescription.Types() Do
		If Kind = Type("Number") Then
			HasNumber = True;
		ElsIf Kind <> Type("Null") Then
			Return False;
		EndIf;
	EndDo;
	Return HasNumber;

EndFunction

// Вычисляемая колонка временной таблицы или вложенного запроса: тип выводится из её
// выражения в контексте того запроса. Вложенный запрос платформа подставляет текстом, и тип
// колонки - тип выражения (`Q.A / 7` при `Т.Сумма / 3 КАК A` - без приведения, замер 7839);
// временную таблицу она создаёт с колонкой типа 1С (`Т.Сумма * 1.5` - Число(17, 3), замер
// 7863). Undefined - колонка не вычисляемая или не числовая, её тип даёт поле.
Function ComputedColumnOperand(Path, Context)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	Descriptor = Resolved.Descriptor;
	If Not IsBlankString(Resolved.CompositeSegment) Or Descriptor = Undefined
		Or Not Descriptor.Property("NumericSource") Or Descriptor.NumericSource = Undefined Then
		Return Undefined;
	EndIf;
	FieldName = Upper(TrimAll(Resolved.FieldName));
	// Колонка объединения - не поле одной ветви, даже если ветвь его просто выбирает: её тип -
	// общий тип ветвей (остаток Число(27, 2) и поле Число(15, 2) - Число(27, 2), замер 44822).
	If NumericOrigin(Descriptor, FieldName) <> Undefined
		And Descriptor.NumericSource.Definition.Operators.Count() = 1 Then
		Return Undefined;
	EndIf;
	Declared = Descriptor.DeclaredTypes.Get(FieldName);
	// Тип колонки - тип её выражения, а не тип модели: колонку временной таблицы платформа создаёт
	// в нём (СРЕДНЕЕ(Число(15, 2)) - Число(21, 8), хотя модель объявляет Число(15, 2), замер 44300),
	// колонку вложенного запроса - типизирует им (остаток Число(15, 2) - Число(27, 2): СУММА от
	// неё - NUMERIC(33, 2), делимое - NUMERIC(33, 8), замеры 44800-44826). Тип модели решает, только
	// если тип выражения не вывелся.
	Typed = Declared <> Undefined And NumberOnly(Declared) And Declared.NumberQualifiers.Digits > 0;
	If Declared = Undefined Then
		Return Undefined;
	EndIf;

	// Модель запроса даёт агрегату тип аргумента: КОЛИЧЕСТВО(Т.Сделка) у неё - ссылка. Тип такой
	// колонки выводится из выражения; не вывелся - решает объявленный тип, как прежде.
	Operand = Descriptor.NumericColumns.Get(FieldName);
	If Operand = Undefined Then
		Operand = ColumnExpressionOperand(Descriptor.NumericSource.Definition, FieldName,
			Descriptor.NumericSource.Context, Descriptor.NumericSource.TempTables);
		Descriptor.NumericColumns.Insert(FieldName, Operand);
	EndIf;
	If Not IsBlankString(Operand.Reason) And (Typed Or Not NumberOnly(Declared)) Then
		Return Undefined;
	EndIf;
	If Not IsBlankString(Operand.Reason) Then
		Return UnknownOperand(StrTemplate("the type of the computed column %1 is not derived: %2",
			Path, Operand.Reason));
	EndIf;
	If Not IsBlankString(Descriptor.Subquery) Then
		Result = NewOperand(Operand.Whole, Operand.Fraction, Operand.Precision, Operand.Scale, Operand.Exact);
		Result.Unbounded = Operand.Unbounded;
		Return Result;
	EndIf;
	If Typed And (Operand.Unbounded Or Operand.Whole + Operand.Fraction > 38) Then
		Return Undefined;
	EndIf;
	If Operand.Unbounded Or Operand.Whole + Operand.Fraction > 38 Then
		Return UnknownOperand(StrTemplate("the temporary table column %1 holds a value without a fixed"
			+ " number of digits, and the type the platform gives it has not been measured", Path));
	EndIf;
	Return NewOperand(Operand.Whole, Operand.Fraction, Operand.Whole + Operand.Fraction,
		Operand.Fraction, False);

EndFunction

// Тип колонки по выражениям всех ветвей запроса - как у ВЫБОР из этих выражений.
Function ColumnExpressionOperand(Definition, FieldName, Context, TempTables = Undefined)

	Column = -1;
	For Index = 0 To Definition.Columns.Count() - 1 Do
		If Upper(TrimAll(Definition.Columns[Index].Alias)) = FieldName Then
			Column = Index;
			Break;
		EndIf;
	EndDo;
	If Column < 0 Then
		Return UnknownOperand("the column is not found");
	EndIf;
	Result = Undefined;
	For Each Operator In Definition.Operators Do
		// Голый NULL ветви модель в полях выборки не хранит, и полей у ветви меньше, чем
		// колонок: считать по BranchFieldCount, как ColumnFieldText.
		If Column >= BranchFieldCount(Definition, Operator) Then
			Return UnknownOperand("a branch has no such column");
		EndIf;
		Probe = NewContext(Context.Options, New Array, ?(TempTables = Undefined, Context.TempTables, TempTables), "TT");
		Try
			CollectSources(Operator, Probe);
			Probe.LiteralsInline = GroupCount(Operator) > 0 Or SelectionHasAggregate(Operator);
			Tokens = Tokenize(ColumnFieldText(Definition, Operator, Column));
			Branch = NumericOperand(Tokens, 0, Tokens.Count() - 1, Probe);
		Except
			Return UnknownOperand(BriefErrorDescription(ErrorInfo()));
		EndTry;
		If Not IsBlankString(Branch.Reason) Then
			Return Branch;
		EndIf;
		Branch.Constant = False;
		If Result = Undefined Then
			Result = Branch;
			Continue;
		EndIf;
		Integral = Max(Result.Precision - Result.Scale, Branch.Precision - Branch.Scale);
		Scale = Max(Result.Scale, Branch.Scale);
		Unbounded = Result.Unbounded Or Branch.Unbounded;
		Result = NewOperand(Max(Result.Whole, Branch.Whole), Max(Result.Fraction, Branch.Fraction),
			Min(Integral + Scale, 38), Scale, Result.Exact And Branch.Exact);
		Result.Unbounded = Unbounded;
	EndDo;
	If Result = Undefined Then
		Return UnknownOperand("the query has no branches");
	EndIf;
	Return Result;

EndFunction

// Описание типа поля, как в SqlTypeOfPath. Колонка, пришедшая из поля без изменений, несёт
// его тип и в SQL; вычисляемая колонка временной таблицы - тип модели запроса, а в SQL перевод
// даёт её в типе выражения, поэтому Exact снимается.
Function NumericFieldType(Path, Context, Exact)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	If Resolved.Descriptor = Undefined Then
		Return Undefined;
	EndIf;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return CompositeTargetFieldType(Resolved);
	EndIf;
	FieldName = Upper(TrimAll(Resolved.FieldName));
	Descriptor = Resolved.Descriptor;
	If Descriptor.IsDerived Then
		OriginType = NumericOrigin(Descriptor, FieldName);
		If OriginType <> Undefined Then
			Return OriginType;
		EndIf;
		If Descriptor.Property("DeclaredTypes") And Descriptor.DeclaredTypes <> Undefined Then
			Exact = False;
			Return Descriptor.DeclaredTypes.Get(FieldName);
		EndIf;
		Return Undefined;
	EndIf;
	Owner = MetadataOf(Descriptor.LogicalName);
	If Owner = Undefined Then
		Return Undefined;
	EndIf;
	Return FieldTypeDescription(Owner, TrimAll(Resolved.FieldName));

EndFunction

// Тип поля через составную ссылку хранимого поля: у всех типов ссылки, где поле есть, он один - тогда это тип
// значения, платформа собирает его ВЫБОРом по типам с NULL этого типа у прочих (замер om1, 21.11.2026, УХ:
// `CASE … THEN T2._Fld153952 … ELSE CAST(NULL AS NUMERIC(10, 4)) END`, тип numeric(10, 4)). Типы разные, поле не
// число, путь длиннее или через производную таблицу - Undefined.
Function CompositeTargetFieldType(Resolved)

	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined
		And Resolved.CompositeTail.Count() > 0 Then
		Return Undefined;
	EndIf;
	If Resolved.Descriptor.IsDerived Then
		// Колонка виртуальной таблицы или подзапроса, взятая из поля регистра: состав - у этого поля (dv01).
		Origin = Undefined;
		If Resolved.Descriptor.Property("ColumnSources") And Resolved.Descriptor.ColumnSources <> Undefined Then
			Origin = Resolved.Descriptor.ColumnSources.Get(Upper(TrimAll(Resolved.CompositeSegment)));
		EndIf;
		If Origin = Undefined Then
			Return Undefined;
		EndIf;
		If Origin.Property("Type") And Origin.Type <> Undefined Then
			Composite = Origin.Type;
		Else
			OriginOwner = MetadataOf(Origin.LogicalName);
			If OriginOwner = Undefined Then
				Return Undefined;
			EndIf;
			Composite = FieldTypeDescription(OriginOwner, TrimAll(Origin.FieldName));
		EndIf;
	Else
		Owner = MetadataOf(Resolved.Descriptor.LogicalName);
		If Owner = Undefined Then
			Return Undefined;
		EndIf;
		Composite = FieldTypeDescription(Owner, TrimAll(Resolved.CompositeSegment));
	EndIf;
	If Composite = Undefined Then
		Return Undefined;
	EndIf;
	Found = Undefined;
	For Each Item In Composite.Types() Do
		Target = Metadata.FindByType(Item);
		If Target = Undefined Then
			Continue;
		EndIf;
		Own = FieldTypeDescription(Target, TrimAll(Resolved.FieldName));
		If Own = Undefined Then
			Continue;
		EndIf;
		If Not NumberOnly(Own) Then
			Return Undefined;
		EndIf;
		If Found = Undefined Then
			Found = Own;
		ElsIf Found.NumberQualifiers.Digits <> Own.NumberQualifiers.Digits
			Or Found.NumberQualifiers.FractionDigits <> Own.NumberQualifiers.FractionDigits Then
			Return Undefined;
		EndIf;
	EndDo;
	Return Found;

EndFunction

Function FunctionOperand(Tokens, Start, Finish, Context)

	Word = Upper(Tokens[Start].Value);
	Inner = Start + 2;
	Last = Finish - 1;
	If Inner <= Last And (Upper(Tokens[Inner].Value) = "DISTINCT" Or Upper(Tokens[Inner].Value) = Upper("Различные")) Then
		Inner = Inner + 1;
	EndIf;

	If Word = "COUNT" Or Word = Upper("Количество") Then
		// КОЛИЧЕСТВО платформа отдаёт как CAST(COUNT_BIG(*) AS NUMERIC(12)), перевод - так же.
		Return NewOperand(12, 0, 12, 0, True);
	EndIf;

	If Word = "SUM" Or Word = Upper("Сумма") Then
		Argument = NumericOperand(Tokens, Inner, Last, Context);
		If Not IsBlankString(Argument.Reason) Then
			Return Argument;
		EndIf;
		If Argument.Unbounded Then
			Return UnknownOperand("it sums a value without a fixed number of digits (a quotient the"
				+ " platform does not cast, an average), and that cast has not been measured");
		EndIf;
		// СУММА(Число(15, 2)) - CAST(SUM(...) AS NUMERIC(21, 2)), СУММА(1) - NUMERIC(7, 0); сверх 38
		// цифр - T(p + 6, s), см. CappedDigits. У нуля цифр нет, и СУММА(0) - NUMERIC(1, 0), а не (6, 0)
		// (замер 17.11.2026, УХ: CAST(SUM(0.0) AS NUMERIC(1, 0))).
		If Argument.Whole + Argument.Fraction = 0 Then
			// Колонка временной таблицы из литерала 0 хранится Число(1, 0), и её сумма - NUMERIC(7, 0) (замер
			// s601, 22.11.2026, УХ; полная сверка типов 22.11: 139 колонок УХ и 69 ERP WE - numeric(1,0) вместо (7,0),
			// и сумма единиц по десяти строкам переполняла бы NUMERIC(1, 0)). Сам литерал - NUMERIC(1, 0).
			If Inner = Last And Tokens[Inner].Kind = "Name" And StrFind(Tokens[Inner].Value, ".") > 0 Then
				Return NewOperand(7, 0, 7, 0, True);
			EndIf;
			Return NewOperand(1, 0, 1, 0, True);
		EndIf;
		Type = CappedDigits(Argument.Whole + 6, Argument.Fraction);
		Return NewOperand(Type.Whole, Type.Fraction, Type.Whole + Type.Fraction, Type.Fraction, True);
	EndIf;

	If Word = "MIN" Or Word = Upper("Минимум") Or Word = "MAX" Or Word = Upper("Максимум") Then
		Return NumericOperand(Tokens, Inner, Last, Context);
	EndIf;

	If Word = "AVG" Or Word = Upper("Среднее") Then
		Argument = NumericOperand(Tokens, Inner, Last, Context);
		If Not IsBlankString(Argument.Reason) Then
			Return Argument;
		EndIf;
		// AVG у СУБД - NUMERIC(38, max(s, 6)); перевод пишет AVG(1.0 * x) до пяти дробных знаков
		// аргумента и AVG(x) с шести (AverageKeepsScale) - тип тот же. Тип 1С - целые аргумента
		// и восемь дробных: колонка ВТ со СРЕДНЕЕ(Число(15, 2)) - Число(21, 8) (замер 7958).
		Return NewOperand(Argument.Whole, 8, 38, Max(Argument.Scale, 6), True);
	EndIf;

	If DatePartFunctionName(Word) Then
		// Часть даты платформа пишет как CAST(DATEPART(...) AS NUMERIC(4)), тип 1С - Число(4, 0):
		// делимое ГОД(...) / 4 - NUMERIC(12, 8) (замеры 841100-841112, все десять функций).
		Return NewOperand(4, 0, 4, 0, False);
	EndIf;

	If Word = "DATEDIFF" Or Word = Upper("РазностьДат") Then
		// Платформа пишет CAST(DATEDIFF(...) AS NUMERIC(12)), а делимое из него приводит к
		// NUMERIC(18, 8): целых по типу 1С десять (замеры 7968-7970).
		Return NewOperand(10, 0, 12, 0, False);
	EndIf;

	If Word = "STRFIND" Or Word = Upper("СтрНайти")
		Or Word = "STOREDDATASIZE" Or Word = Upper("РазмерХранимыхДанных") Then
		// Платформа пишет CAST(CHARINDEX(...) AS NUMERIC(12, 0)) и CAST(DATALENGTH(...) AS NUMERIC(12, 0))
		// (замер 18.11.2026, fn_uh s1-s3, r1-r3).
		Return NewOperand(12, 0, 12, 0, True);
	EndIf;

	If StrSplit("SIN,COS,TAN,ASIN,ACOS,ATAN,EXP,LOG,LOG10,SQRT", ",").Find(Word) <> Undefined Then
		// См. MathFunction: от константы - значение параметром, SQRT - по аргументу, прочие - NUMERIC(38, 9).
		Constant = NumberFromText(StrReplace(TokensText(Tokens, Inner, Last), " ", ""));
		If Constant <> Undefined Then
			Return ConstantOperand(Number(SignificantText(MathValue(Word, Constant), 15)), Context);
		EndIf;
		If Word <> "SQRT" Then
			Return NewOperand(29, 9, 38, 9, True);
		EndIf;
		Value = NumericOperand(Tokens, Inner, Last, Context);
		If Not IsBlankString(Value.Reason) Or Value.Unbounded Then
			Return Value;
		EndIf;
		Root = SqrtType(Value);
		Return NewOperand(Root.Precision - Root.Scale, Root.Scale, Root.Precision, Root.Scale, True);
	EndIf;

	If Word = "INT" Or Word = Upper("Цел") Then
		// CAST(ROUND(x, 0, 1) AS <тип x>) - см. IntFunction.
		Value = NumericOperand(Tokens, Inner, Last, Context);
		If Not IsBlankString(Value.Reason) Or Value.Unbounded Then
			Return Value;
		EndIf;
		Return NewOperand(Value.Whole, Value.Fraction, Value.Whole + Value.Fraction, Value.Fraction, True);
	EndIf;

	If (Word = "POW" Or Word = Upper("Степень")) And PowerOfConstant(Tokens, Inner, Last) Then
		// Степень двух литералов платформа считает сама и передаёт значением (Т.Сумма / СТЕПЕНЬ(1.1, 2)
		// - делитель @P1, делимое NUMERIC(21, 8), замер 7966): это константа.
		Comma = 0;
		For Position = Inner To Last Do
			If Tokens[Position].Value = "," Then
				Comma = Position;
				Break;
			EndIf;
		EndDo;
		Base = NumberFromText(TokensText(Tokens, Inner, Comma - 1));
		Exponent = ?(Comma = 0, Undefined, NumberFromText(TokensText(Tokens, Comma + 1, Last)));
		If Base <> Undefined And Exponent <> Undefined And Base >= 0 Then
			Return ConstantOperand(Pow(Base, Exponent), Context);
		EndIf;
	EndIf;

	If (Word = "POW" Or Word = Upper("Степень")) And Not PowerOfConstant(Tokens, Inner, Last) Then
		// CAST(POWER(CAST(x AS NUMERIC(38, 8)), y) AS NUMERIC(38, 8)) - замеры 7965-7967.
		Return NewOperand(30, 8, 38, 8, True);
	EndIf;

	If Word = "ROUND" Or Word = Upper("Окр") Then
		// CAST(ROUND(x, n) AS <тип x>) - см. RoundFunction.
		Comma = 0;
		Depth = 0;
		For Position = Inner To Last Do
			If Tokens[Position].Value = "(" Then
				Depth = Depth + 1;
			ElsIf Tokens[Position].Value = ")" Then
				Depth = Depth - 1;
			ElsIf Depth = 0 And Tokens[Position].Value = "," Then
				Comma = Position;
				Break;
			EndIf;
		EndDo;
		// Без разрядности (ОКР(x)) - то же, что ОКР(x, 0): тип аргумента.
		Value = NumericOperand(Tokens, Inner, ?(Comma = 0, Last, Comma - 1), Context);
		If Not IsBlankString(Value.Reason) Or Value.Unbounded Then
			Return Value;
		EndIf;
		Return NewOperand(Value.Whole, Value.Fraction, Value.Whole + Value.Fraction, Value.Fraction, True);
	EndIf;

	If Word = "ISNULL" Or Word = Upper("ЕстьNULL") Then
		Comma = 0;
		Depth = 0;
		For Position = Inner To Last Do
			If Tokens[Position].Value = "(" Then
				Depth = Depth + 1;
			ElsIf Tokens[Position].Value = ")" Then
				Depth = Depth - 1;
			ElsIf Depth = 0 And Tokens[Position].Value = "," Then
				Comma = Position;
				Break;
			EndIf;
		EndDo;
		If Comma = 0 Then
			Return UnknownOperand("ISNULL without the second argument");
		EndIf;
		Value = NumericOperand(Tokens, Inner, Comma - 1, Context);
		Fallback = NumericOperand(Tokens, Comma + 1, Last, Context);
		If Not IsBlankString(Value.Reason) Then
			Return Value;
		ElsIf Not IsBlankString(Fallback.Reason) Then
			Return Fallback;
		ElsIf Value.Unbounded Or Fallback.Unbounded Then
			Return UnknownOperand("ISNULL over a value without a fixed number of digits");
		EndIf;
		// Платформа пишет ISNULL, приводя первый аргумент к общей разрядности: ЕСТЬNULL(Число(5, 3),
		// 1000) - ISNULL(CAST(x AS NUMERIC(7, 3)), @P). Перевод пишет COALESCE, его тип шире.
		// Сверх 38 цифр тип общий - T(p, s), как у ВЫБОР: ЕСТЬNULL(Число(30, 2), Число(20, 15)) -
		// ISNULL(CAST(x AS NUMERIC(38, 10)), y) (замер 840108).
		Digits = CappedDigits(Max(Value.Whole, Fallback.Whole), Max(Value.Fraction, Fallback.Fraction));
		If Digits.Whole = Value.Whole And Digits.Fraction = Value.Fraction Then
			// Второй аргумент тип не расширяет: платформа первый не приводит, у ЕСТЬNULL тип первого
			// (ЕСТЬNULL(Число(10, 4) / Число(10, 4), 0) / 3 - частное с 26 знаками, замер 7960).
			Return NewOperand(Digits.Whole, Digits.Fraction, Value.Precision, Value.Scale, Value.Exact);
		EndIf;
		Return NewOperand(Digits.Whole, Digits.Fraction, Digits.Whole + Digits.Fraction, Digits.Fraction, False);
	EndIf;

	If Word = "CAST" Or Word = Upper("Выразить") Then
		Depth = 0;
		For Position = Inner To Last - 3 Do
			Value = Upper(Tokens[Position].Value);
			If Value = "(" Then
				Depth = Depth + 1;
			ElsIf Value = ")" Then
				Depth = Depth - 1;
			ElsIf Depth = 0 And Tokens[Position].Kind = "Name" And (Value = "AS" Or Value = Upper("Как")) Then
				Kind = Upper(Tokens[Position + 1].Value);
				If (Kind <> "NUMBER" And Kind <> Upper("Число")) Or Tokens[Position + 2].Value <> "("
					Or Tokens[Position + 3].Kind <> "Number" Then
					Break;
				EndIf;
				Digits = NumberFromText(Tokens[Position + 3].Value);
				Fraction = 0;
				If Position + 5 <= Last And Tokens[Position + 4].Value = "," And Tokens[Position + 5].Kind = "Number" Then
					Fraction = NumberFromText(Tokens[Position + 5].Value);
				EndIf;
				If Digits = Undefined Or Fraction = Undefined Or Digits = 0 Then
					Break;
				EndIf;
				Operand = NewOperand(Digits - Fraction, Fraction, Digits, Fraction, True);
				Operand.Cast = True;
				Return Operand;
			EndIf;
		EndDo;
		Return UnknownOperand("CAST to a number without a stated length");
	EndIf;

	If Word = "RECORDAUTONUMBER" Or Word = Upper("АвтоНомерЗаписи") Then
		// В арифметике АВТОНОМЕРЗАПИСИ - Число(10, 0): делимое платформа приводит к NUMERIC(18, 8), разность с
		// единицей - к NUMERIC(19, 8), как у поля Число(10, 0) (замер am1, 21.11.2026, УХ: `ВТ.Н / 3`,
		// `ЦЕЛ((ВТ.Н - 1) / 1000)`; поле Число(10, 0) - jm1, ЖурналДокументов.Взаимодействия.Размер). Колонка ВТ -
		// NUMERIC(12, 1) (PlacedQuotientSql).
		Return NewOperand(10, 0, 12, 1, False);
	EndIf;

	Return UnknownOperand(StrTemplate("the type of %1(...) is not derived", Tokens[Start].Value));

EndFunction

// Поле значения ВЫРАЗИТЬ(... КАК <ссылочный тип>).Поле: тип поля берётся из метаданных, значение
// параметра для него не нужно. Платформа пишет его как поле: ВЫРАЗИТЬ(Т.Ссылка КАК
// Справочник.Номенклатура).ЧислительВеса / 3 - CAST(T2._Fld16585 AS NUMERIC(20, 8)) (замер 841008).
// Undefined - отрезок не такой формы.
Function CastFieldOperand(Tokens, Start, Finish)

	If Finish - Start < 6 Or Tokens[Finish].Kind <> "Name" Or Tokens[Finish - 1].Value <> "."
		Or Tokens[Finish - 2].Value <> ")" Then
		Return Undefined;
	EndIf;
	CastStart = Start;
	CastEnd = Finish - 2;
	While Tokens[CastStart].Value = "(" And MatchingParen(Tokens, CastStart) = CastEnd Do
		CastStart = CastStart + 1;
		CastEnd = CastEnd - 1;
	EndDo;
	Word = Upper(Tokens[CastStart].Value);
	If (Word <> "CAST" And Word <> Upper("Выразить")) Or CastStart + 1 > CastEnd
		Or Tokens[CastStart + 1].Value <> "(" Or MatchingParen(Tokens, CastStart + 1) <> CastEnd
		Or StrFind(Tokens[Finish].Value, ".") > 0 Then
		Return Undefined;
	EndIf;
	TypeName = "";
	For Position = CastStart + 2 To CastEnd - 2 Do
		Value = Upper(Tokens[Position].Value);
		If Tokens[Position].Kind = "Name" And (Value = "AS" Or Value = Upper("Как")) Then
			If Position + 2 = CastEnd Then
				TypeName = Tokens[Position + 1].Value;
			EndIf;
			Break;
		EndIf;
	EndDo;
	If IsBlankString(TypeName) Then
		Return Undefined;
	EndIf;
	Owner = MetadataOf(TypeName);
	FieldType = ?(Owner = Undefined, Undefined, FieldTypeDescription(Owner, Tokens[Finish].Value));
	If FieldType = Undefined Or Not NumberOnly(FieldType) Or FieldType.NumberQualifiers.Digits = 0 Then
		Return UnknownOperand(StrTemplate("the field %1 of %2 is not a number of a stated length",
			Tokens[Finish].Value, TypeName));
	EndIf;
	Digits = FieldType.NumberQualifiers.Digits;
	Fraction = FieldType.NumberQualifiers.FractionDigits;
	Return NewOperand(Digits - Fraction, Fraction, Digits, Fraction, True);

EndFunction

Function DatePartFunctionName(Word)

	Names = StrSplit("YEAR,QUARTER,MONTH,DAYOFYEAR,DAY,WEEK,WEEKDAY,HOUR,MINUTE,SECOND,"
		+ Upper("Год,Квартал,Месяц,ДеньГода,День,Неделя,ДеньНедели,Час,Минута,Секунда"), ",", False);
	Return Names.Find(Word) <> Undefined;

EndFunction

// Первый аргумент степени - литерал: такую степень платформа, по замеру 9474, считает иначе.
Function PowerOfConstant(Tokens, Inner, Last)

	Position = Inner;
	If Position <= Last And Tokens[Position].Value = "-" Then
		Position = Position + 1;
	EndIf;
	Return Position <= Last And Tokens[Position].Kind = "Number"
		And (Position = Last Or Tokens[Position + 1].Value = ",");

EndFunction

// ВЫБОР: разрядность 1С - наибольшие целые и дробные ветвей (ВЫБОР ... ТОГДА Число(15, 2)
// ИНАЧЕ 0 КОНЕЦ / 3 - NUMERIC(21, 8)), тип SQL - по правилу CASE у СУБД.
Function CaseOperand(Tokens, Start, Finish, Context)

	Branches = New Array;
	Depth = 0;
	Position = Start + 1;
	While Position < Finish Do
		Token = Tokens[Position];
		Word = Upper(Token.Value);
		If Token.Value = "(" Then
			Position = MatchingParen(Tokens, Position) + 1;
			Continue;
		EndIf;
		If Token.Kind = "Name" And (Word = "CASE" Or Word = Upper("Выбор")) Then
			Position = CaseEnd(Tokens, Position) + 1;
			Continue;
		EndIf;
		If Token.Kind = "Name" And (Word = "THEN" Or Word = Upper("Тогда") Or Word = "ELSE" Or Word = Upper("Иначе")) Then
			BranchFinish = BranchEnd(Tokens, Position + 1);
			// NULL и НЕОПРЕДЕЛЕНО в разрядность ветвей не входят: числовую часть колонки задают числа (замер
			// qu01-qu03, 22.11.2026, УХ: ВЫБОР ... ИНАЧЕ НЕОПРЕДЕЛЕНО в объединении - тег 0x01 и число отдельно).
			Lone = Upper(Tokens[BranchFinish].Value);
			If Not (BranchFinish = Position + 1 And (Lone = "NULL" Or Lone = "UNDEFINED" Or Lone = Upper("Неопределено"))) Then
				Branches.Add(NumericOperand(Tokens, Position + 1, BranchFinish, Context));
			EndIf;
			Position = BranchFinish + 1;
			Continue;
		EndIf;
		Position = Position + 1;
	EndDo;
	If Branches.Count() = 0 Then
		Return UnknownOperand("CASE without a number in its branches");
	EndIf;

	Whole = 0;
	Fraction = 0;
	Integral = 0;
	Scale = 0;
	Exact = True;
	Unbounded = False;
	For Each Branch In Branches Do
		If Not IsBlankString(Branch.Reason) Then
			Return Branch;
		EndIf;
		Whole = Max(Whole, Branch.Whole);
		Fraction = Max(Fraction, Branch.Fraction);
		Integral = Max(Integral, Branch.Precision - Branch.Scale);
		Scale = Max(Scale, Branch.Scale);
		Exact = Exact And Branch.Exact;
		Unbounded = Unbounded Or Branch.Unbounded;
	EndDo;
	// Сверх 38 цифр платформа ветви не приводит (замеры 840100-840108): тип 1С - T(p, s), а тип SQL
	// выводит СУБД - целые сохраняются, дробных остаётся 38 минус целые (ВЫБОР из Число(30, 2) и
	// Число(20, 15) - Число(38, 10) и NUMERIC(38, 10)).
	If Integral + Scale > 38 Then
		Scale = Max(Min(Scale, 38 - Integral), 0);
	EndIf;
	If Unbounded Then
		Return UnboundedOperand(Min(Integral + Scale, 38), Scale, Exact);
	EndIf;
	Digits = CappedDigits(Whole, Fraction);
	Return NewOperand(Digits.Whole, Digits.Fraction, Min(Integral + Scale, 38), Scale, Exact);

EndFunction

// Сумма и разность: целых на одну больше, чем у большего операнда (`(Поле + 1) / 3` -
// NUMERIC(22, 8) у Число(15, 2)).
Function SumOperand(Left, Right)

	If Not IsBlankString(Left.Reason) Then
		Return Left;
	ElsIf Not IsBlankString(Right.Reason) Then
		Return Right;
	ElsIf Left.Constant And Right.Constant Then
		Return UnknownOperand("arithmetic of constants is computed by the platform itself");
	EndIf;
	// Слагаемые в SQL - в тех типах, в которых их пишет AdditionSql; тип 1С сверх 38 цифр - T(p, s).
	LeftPrecision = Left.Precision;
	LeftScale = Left.Scale;
	RightPrecision = Right.Precision;
	RightScale = Right.Scale;
	If WidenedAddend(Left, Right) Then
		LeftPrecision = 38;
		LeftScale = Min(Right.Fraction, 8);
	EndIf;
	If WidenedAddend(Right, Left) Then
		RightPrecision = 38;
		RightScale = Min(Left.Fraction, 8);
	EndIf;
	Scale = Max(LeftScale, RightScale);
	Type = AdditiveSqlType(Max(LeftPrecision - LeftScale, RightPrecision - RightScale) + Scale + 1, Scale);
	If Left.Unbounded Or Right.Unbounded Then
		Return UnboundedOperand(Type.Precision, Type.Scale, Left.Exact And Right.Exact);
	EndIf;
	Digits = CappedDigits(Max(Left.Whole, Right.Whole) + 1, Max(Left.Fraction, Right.Fraction));
	Return NewOperand(Digits.Whole, Digits.Fraction, Type.Precision, Type.Scale, Left.Exact And Right.Exact);

EndFunction

// Произведение: целые и дробные складываются (`Поле * Поле / 3` - NUMERIC(34, 8) у
// Число(15, 2)). Больше 38 цифр платформа сужает сомножители (`x * x * x` - CAST(x * x AS
// NUMERIC(24, 4)) * CAST(x AS NUMERIC(13, 2))), и это правило не выведено.
Function ProductOperand(Left, Right)

	If Not IsBlankString(Left.Reason) Then
		Return Left;
	ElsIf Not IsBlankString(Right.Reason) Then
		Return Right;
	EndIf;
	// Произведение двух констант платформа пишет произведением параметров (`@P3 * @P4`), и дальше
	// оно сомножитель как любой другой (замеры произведений, run3). Сомножители в SQL - в тех
	// типах, в которых их пишет MultiplicationSql.
	Plan = ProductPlan(Left, Right);
	LeftPrecision = Left.Precision;
	LeftScale = Left.Scale;
	RightPrecision = Right.Precision;
	RightScale = Right.Scale;
	If Plan.Narrow And Not Left.Constant Then
		LeftPrecision = Plan.LeftWhole + Left.Fraction;
		LeftScale = Left.Fraction;
	EndIf;
	If Plan.Narrow And Not Right.Constant Then
		RightPrecision = Plan.RightWhole + Right.Fraction;
		RightScale = Right.Fraction;
	EndIf;
	Type = MultiplicativeSqlType(LeftPrecision + RightPrecision + 1, LeftScale + RightScale);
	Digits = CappedDigits(Left.Whole + Right.Whole, Left.Fraction + Right.Fraction);
	Result = NewOperand(Digits.Whole, Digits.Fraction, Type.Precision, Type.Scale, True);
	Result.Unbounded = Left.Unbounded Or Right.Unbounded;
	// Произведение констант и дальше константа: сомножителем оно не приводится, а бюджет целых
	// получает по своим цифрам (`1234567 * 0.000123456789 * Число(38, 3)` - (@P1 * @P2) *
	// CAST(x AS NUMERIC(25, 3))).
	If Left.Constant And Right.Constant Then
		Result.Constant = True;
		Result.Value = Left.Value * Right.Value;
	EndIf;
	Return Result;

EndFunction

// Частное внутри выражения - тот же выбор, что в DivisionSql; перевод пишет его в типах
// платформы, поэтому оно точное.
Function QuotientOperand(Left, Right)

	If Not IsBlankString(Left.Reason) Then
		Return Left;
	ElsIf Not IsBlankString(Right.Reason) Then
		Return Right;
	ElsIf Left.Constant And Right.Constant And Right.Value <> 0 Then
		Return UnknownOperand("a division of constants stands inside arithmetic, and the platform"
			+ " passes its value in a type that has not been measured");
	EndIf;
	If Not Left.Unbounded And Not Right.Unbounded And Left.Fraction + Right.Fraction < 8 Then
		Precision = Min(Left.Whole + 8, 38);
		Type = DivisionSqlType(Precision, 8, Right.Precision, Right.Scale);
		// Целых у частного по типу 1С больше на дробные знаки делителя: `Сумма / 3` и
		// `Сумма / 7.5` в объединении - Число(22, 8), ветвь с первым приводится к нему (замер 7914).
		Return NewOperand(Min(Left.Whole + Right.Fraction, 30), 8, Type.Precision, Type.Scale, True);
	EndIf;
	// Без приведения у частного тот же тип 1С: целые делимого плюс дробные делителя, восемь
	// дробных. Колонка ВТ с Число(10, 4) / Число(10, 4) - Число(18, 8), с x * y / (z * w) -
	// Число(28, 8), с Сумма / (СуммаУпр / 7) - Число(29, 8) (СУММА по ней, замеры 7950-7959).
	Type = DivisionSqlType(Left.Precision, Left.Scale, Right.Precision, Right.Scale);
	Return NewOperand(Min(Left.Whole + Right.Fraction, 30), 8, Type.Precision, Type.Scale, True);

EndFunction

// Тип 1С сверх 38 цифр: T(p, s) = (38, max(8, 38 - целые)) - целые урезаются, дробных не меньше
// восьми (замеры произведений 820000-838301, заметка query-runtime-semantics-2026-11).
Function CappedDigits(Whole, Fraction)

	If Whole + Fraction > 38 Then
		Fraction = Max(8, 38 - Whole);
		Whole = 38 - Fraction;
	EndIf;
	Return New Structure("Whole, Fraction", Whole, Fraction);

EndFunction

// Сужение сомножителей произведения (2 150 точек, SQL платформы совпал до символа; заметка
// query-runtime-semantics-2026-11, «Произведение: тип в 1С и сужение сомножителей»). Целые
// I = iL + iR, дробные S = sL + sR. Сужения нет, пока I + 1 + min(S, 8) не больше 38. Иначе целым
// сомножителей отводится B = 37 - min(S, 8): константе - её цифры, другому - остаток; без
// констант бюджет делится пропорционально целым, вниз округляется доля большего.
Function ProductPlan(Left, Right)

	Plan = New Structure("Narrow, LeftWhole, RightWhole", False, Left.Whole, Right.Whole);
	Total = Left.Whole + Right.Whole;
	Fraction = Min(Left.Fraction + Right.Fraction, 8);
	// Сомножитель-ВЫРАЗИТЬ сужения отменяет: Число(15, 2) * ВЫРАЗИТЬ(... КАК Число(31, 10)) и
	// x * y * ВЫРАЗИТЬ(... КАК Число(10, 4)) платформа пишет простым произведением (замеры 7980-7986).
	If Total + 1 + Fraction <= 38 Or Left.Constant And Right.Constant Or Left.Cast Or Right.Cast Then
		Return Plan;
	EndIf;
	Budget = 37 - Fraction;
	If Right.Constant Then
		Plan.RightWhole = Right.Whole;
		Plan.LeftWhole = Budget - Right.Whole;
	ElsIf Left.Constant Then
		Plan.LeftWhole = Left.Whole;
		Plan.RightWhole = Budget - Left.Whole;
	ElsIf Left.Whole >= Right.Whole Then
		Plan.LeftWhole = Int(Budget * Left.Whole / Total);
		Plan.RightWhole = Budget - Plan.LeftWhole;
	Else
		Plan.RightWhole = Int(Budget * Right.Whole / Total);
		Plan.LeftWhole = Budget - Plan.RightWhole;
	EndIf;
	Plan.Narrow = True;
	Return Plan;

EndFunction

// Тип частного у MS SQL: масштаб max(6, s1 + p2 + 1), точность p1 - s1 + s2 + масштаб.
Function DivisionSqlType(Precision1, Scale1, Precision2, Scale2)

	Scale = Max(6, Scale1 + Precision2 + 1);
	Return MultiplicativeSqlType(Precision1 - Scale1 + Scale2 + Scale, Scale);

EndFunction

// Сверх 38 цифр MS SQL урезает масштаб: до 38 - целые, если целых не больше 32, иначе до 6.
Function MultiplicativeSqlType(Precision, Scale)

	If Precision > 38 Then
		Integral = Precision - Scale;
		If Integral <= 32 Then
			Scale = Min(Scale, 38 - Integral);
		ElsIf Scale > 6 Then
			Scale = 6;
		EndIf;
		Precision = 38;
	EndIf;
	Return New Structure("Precision, Scale", Precision, Scale);

EndFunction

#EndRegion

// Дробный литерал - операнд арифметики. Платформа передаёт его параметром NUMERIC(38, 8), если
// дробных знаков не больше восьми (и целое длиннее десяти цифр - тоже), а литерал СУБД
// типизирует по цифрам: `Сумма * 0.12345678` у 1С 267.550595 (масштаб урезан до шести), у
// голого литерала 267.5505957452 (замеры 7931, 7750). В операторе с группировкой платформа
// пишет литерал в текст, и он остаётся как есть.
Function WideLiteralSql(Value, Context)

	If Context.Property("LiteralsInline") And Context.LiteralsInline Then
		Return Value;
	EndIf;
	Number = NumberFromText(Value);
	If Number = Undefined Then
		Return Value;
	EndIf;
	Operand = ConstantOperand(Number, Context);
	If Operand.Precision = 38 And Operand.Scale = 8 Then
		Return "CAST(" + Value + " AS NUMERIC(38, 8))";
	EndIf;
	Return Value;

EndFunction

// Литерал - значение ветви ВЫБОР: ТОГДА 5 / ИНАЧЕ 5 перед КОГДА, ИНАЧЕ или КОНЕЦ.
Function IsCaseValue(Tokens, Index)

	If Index = 0 Or Index + 1 >= Tokens.Count() Then
		Return False;
	EndIf;
	Before = Upper(Tokens[Index - 1].Value);
	If Before = "-" And Index > 1 Then
		Before = Upper(Tokens[Index - 2].Value);
	EndIf;
	After = Upper(Tokens[Index + 1].Value);
	Return (Before = "THEN" Or Before = Upper("Тогда") Or Before = "ELSE" Or Before = Upper("Иначе"))
		And (After = "WHEN" Or After = Upper("Когда") Or After = "ELSE" Or After = Upper("Иначе")
			Or After = "END" Or After = Upper("Конец"));

EndFunction

// Литерал так, как его передаёт платформа: параметром NUMERIC(10) / NUMERIC(38, 8) / в точном типе,
// а внутри выражения оператора с группировкой - текстом `5.0` (замеры 43100-43108: колонка 0 -
// NUMERIC(10, 0), ВЫБОР ТОГДА 5 ИНАЧЕ 99 - NUMERIC(10, 0), в группировке - NUMERIC(3, 1)).
Function ParameterLiteralSql(Value, Context)

	Number = NumberFromText(Value);
	If Number = Undefined Then
		Return Value;
	EndIf;
	Operand = ConstantOperand(Number, Context);
	If Context.Property("LiteralsInline") And Context.LiteralsInline Then
		If Operand.Fraction = 0 And Number <= 2147483647 And StrFind(Value, ".") = 0 Then
			Return Value + ".0";
		EndIf;
		Return Value;
	EndIf;
	Return "CAST(" + Value + " AS " + OperandSqlType(Operand) + ")";

EndFunction

// Целый литерал - операнд арифметики или значение под СУММА. СУБД считает его int, и int
// рядом с int переполняется (8115) там, где у 1С значение: `1000000 * 1000000`,
// `СУММА(1) * СУММА(1)`, `СУММА(ВЫБОР ... ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) * 1000` (негативная батарея
// 13.11.2026: ov01, cn06, cn17). NUMERIC(10, 0) - тот тип, к которому СУБД сама приводит int
// рядом с дробным числом, поэтому смешанная арифметика считается как прежде, меняется только
// int рядом с int. Унарный минус и литерал вне арифметики остаются как были.
Function NumberLiteralSql(Tokens, Index, Context)

	Value = Tokens[Index].Value;
	Before = ?(Index > 0, Tokens[Index - 1].Value, "");
	After = ?(Index + 1 < Tokens.Count(), Tokens[Index + 1].Value, "");
	Binary = (Before = "+" Or Before = "-") And Index > 1 And EndsOperand(Tokens[Index - 2]);
	If StrFind(Value, ".") > 0 Or StrLen(Value) > 10 Then
		If Context.Options.Dialect <> "PostgreSQL"
			And (Before = "*" Or Before = "/" Or IsArithmetic(After) Or Binary) Then
			Return WideLiteralSql(Value, Context);
		EndIf;
		If IsCaseValue(Tokens, Index) And Context.Options.Dialect <> "PostgreSQL" Then
			Return ParameterLiteralSql(Value, Context);
		EndIf;
		Return Value;
	EndIf;
	If (Before = "*" Or Before = "/" Or IsArithmetic(After) Or Binary)
		And Context.Options.Dialect <> "PostgreSQL" And Context.Property("LiteralsInline") And Context.LiteralsInline
		And NumberFromText(Value) <> Undefined And NumberFromText(Value) <= 2147483647 Then
		// В операторе с группировкой платформа пишет целое в текст с `.0`: `СУММА(x) * СУММА(y) * 3`
		// - `* 3.0`, NUMERIC(2, 1); с NUMERIC(10, 0) масштаб произведения урезался до шести знаков.
		Return Value + ".0";
	EndIf;
	If Before = "*" Or Before = "/" Or IsArithmetic(After) Or Binary Or IsSumValue(Tokens, Index) Then
		Return "CAST(" + Value + " AS NUMERIC(10, 0))";
	EndIf;
	If IsCaseValue(Tokens, Index) And Context.Options.Dialect <> "PostgreSQL" Then
		Return ParameterLiteralSql(Value, Context);
	EndIf;
	Return Value;

EndFunction

// Токен, которым кончается операнд: после него + и - бинарные.
Function EndsOperand(Token)

	If Token.Kind = "Number" Or Token.Kind = "String" Or Token.Kind = "Parameter" Or Token.Value = ")" Then
		Return True;
	EndIf;
	If Token.Kind <> "Name" Then
		Return False;
	EndIf;
	Word = Upper(Token.Value);
	Return Word = "END" Or Word = Upper("Конец") Or KeywordMap().Get(Word) = Undefined;

EndFunction

// Литерал - значение под СУММА: весь её аргумент или ветвь ВЫБОР в нём.
Function IsSumValue(Tokens, Index)

	If Index = 0 Then
		Return False;
	EndIf;
	Before = Upper(Tokens[Index - 1].Value);
	After = ?(Index + 1 < Tokens.Count(), Tokens[Index + 1].Value, "");
	Whole = Before = "(" And After = ")";
	Branch = Before = "THEN" Or Before = Upper("Тогда") Or Before = "ELSE" Or Before = Upper("Иначе");
	If Not Whole And Not Branch Then
		Return False;
	EndIf;
	Name = EnclosingCallName(Tokens, Index);
	Return Name = "SUM" Or Name = Upper("Сумма");

EndFunction

// Имя функции, в скобках которой стоит токен. Пустая строка - токен вне вызова.
Function EnclosingCallName(Tokens, Index)

	Depth = 0;
	Position = Index - 1;
	While Position >= 0 Do
		Value = Tokens[Position].Value;
		If Value = ")" Then
			Depth = Depth + 1;
		ElsIf Value = "(" Then
			If Depth = 0 Then
				If Position > 0 And Tokens[Position - 1].Kind = "Name" Then
					Return Upper(Tokens[Position - 1].Value);
				EndIf;
				Return "";
			EndIf;
			Depth = Depth - 1;
		EndIf;
		Position = Position - 1;
	EndDo;
	Return "";

EndFunction

// NULL - весь аргумент агрегата. Без типа СУБД такой агрегат не принимает (8117), у 1С он
// даёт NULL, а КОЛИЧЕСТВО - 0 (негативная батарея 13.11.2026: ag11 КОЛИЧЕСТВО(NULL) и
// КОЛИЧЕСТВО(РАЗЛИЧНЫЕ NULL), ag13 СУММА(NULL)). Вне агрегата NULL остаётся NULL.
Function AggregateNullSql(Tokens, Index)

	Position = Index - 1;
	If Position >= 0 And (Upper(Tokens[Position].Value) = "DISTINCT"
		Or Upper(Tokens[Position].Value) = Upper("Различные")) Then
		Position = Position - 1;
	EndIf;
	If Position < 1 Or Tokens[Position].Value <> "(" Or Index + 1 >= Tokens.Count()
		Or Tokens[Index + 1].Value <> ")" Then
		Return "NULL";
	EndIf;
	Name = Upper(Tokens[Position - 1].Value);
	If Name = "COUNT" Or Name = Upper("Количество") Then
		Return "CAST(NULL AS INT)";
	ElsIf Name = "SUM" Or Name = Upper("Сумма") Or Name = "MAX" Or Name = Upper("Максимум")
		Or Name = "MIN" Or Name = Upper("Минимум") Then
		Return "CAST(NULL AS NUMERIC(15, 0))";
	EndIf;
	Return "NULL";

EndFunction

// СУММА от литерала. Платформа даёт сумме столько целых цифр, сколько их у аргумента, плюс
// шесть, и падает с 8115, когда итог до них дорастает; СУБД отдаёт значение. Замер (негативная
// батарея 13.11.2026, cases5, ERP WE): СУММА(1) - ошибка от 10^7, СУММА(10) - от 10^8,
// СУММА(0.5) - от 10^6, ВЫБОР из литерала 1 - как СУММА(1). Это предел самой платформы, а не
// дефект перевода, поэтому предупреждение, а не отказ.
Procedure WarnAboutNarrowSum(Tokens, Context)

	For Index = 0 To Tokens.Count() - 2 Do
		Word = Upper(Tokens[Index].Value);
		If Tokens[Index].Kind <> "Name" Or Tokens[Index + 1].Value <> "("
			Or (Word <> "SUM" And Word <> Upper("Сумма")) Then
			Continue;
		EndIf;
		Closing = MatchingParen(Tokens, Index + 1);
		Digits = LiteralSumDigits(Tokens, Index + 2, Closing - 1);
		If Digits < 0 Then
			Continue;
		EndIf;
		AddOnce(Context.Warnings, StrTemplate(
			"SUM(%1) sums a literal. The platform gives such a sum %2 integer digits and fails with"
			+ " an arithmetic overflow (8115) once the total reaches 10^%2, while the SQL returns the"
			+ " value. Wrap the argument in CAST(... AS NUMBER(15, 0)) to get the value in both.",
			TokensText(Tokens, Index + 2, Closing - 1), Format(Digits + 6, "NG=0")));
	EndDo;

EndProcedure

// Целые цифры литерала или ВЫБОР из литералов в аргументе СУММА; -1 - аргумент не такой.
Function LiteralSumDigits(Tokens, Start, Finish)

	If Finish < Start Then
		Return -1;
	EndIf;
	First = Upper(Tokens[Start].Value);
	If First <> "CASE" And First <> Upper("Выбор") Then
		Return LiteralDigits(Tokens, Start, Finish);
	EndIf;
	Last = Upper(Tokens[Finish].Value);
	If Last <> "END" And Last <> Upper("Конец") Then
		Return -1;
	EndIf;
	Bounds = StrSplit("WHEN,ELSE,END," + Upper("Когда,Иначе,Конец"), ",", False);
	Digits = -1;
	Position = Start + 1;
	While Position < Finish Do
		Word = Upper(Tokens[Position].Value);
		If Word = "CASE" Or Word = Upper("Выбор") Then
			Return -1;
		EndIf;
		If Word = "THEN" Or Word = Upper("Тогда") Or Word = "ELSE" Or Word = Upper("Иначе") Then
			Stop = Position + 1;
			While Stop < Finish And Bounds.Find(Upper(Tokens[Stop].Value)) = Undefined Do
				Stop = Stop + 1;
			EndDo;
			Branch = LiteralDigits(Tokens, Position + 1, Stop - 1);
			If Branch < 0 Then
				Return -1;
			EndIf;
			Digits = Max(Digits, Branch);
			Position = Stop;
			Continue;
		EndIf;
		Position = Position + 1;
	EndDo;
	Return Digits;

EndFunction

// Целые цифры числового литерала, в том числе со знаком минус; ведущий ноль не цифра:
// у 0.5 их ноль. -1 - отрезок не литерал.
Function LiteralDigits(Tokens, Start, Finish)

	First = Start;
	If Finish > First And Tokens[First].Value = "-" Then
		First = First + 1;
	EndIf;
	If Finish <> First Or Tokens[First].Kind <> "Number" Then
		Return -1;
	EndIf;
	Whole = StrSplit(Tokens[First].Value, ".")[0];
	While Left(Whole, 1) = "0" Do
		Whole = Mid(Whole, 2);
	EndDo;
	Return StrLen(Whole);

EndFunction

// Вид значения параметра против операции, где он стоит. Платформа сверяет их при исполнении
// и отвергает запрос, а подставленный литерал СУБД принимает и отдаёт значение (негативная
// батарея 13.11.2026: dz29 `Т.Наценка / &П` при "" - «Wrong parameters "/"», lk18
// `ПОДОБНО &П` при 5, cm39 `ГДЕ &П` при "abc" - «Operation not allowed in clause "ГДЕ"»).
// Проверяется только переданное значение: без него вид параметра неизвестен.
Procedure CheckParameterValueKind(Tokens, Index, Context)

	Name = Tokens[Index].Value;
	Kind = SuppliedParameterKind(Name, Context);
	If IsBlankString(Kind) Then
		Return;
	EndIf;
	Before = ?(Index > 0, Upper(Tokens[Index - 1].Value), "");
	After = ?(Index + 1 < Tokens.Count(), Upper(Tokens[Index + 1].Value), "");
	If Before = "*" Or Before = "/" Or Before = "-" Or After = "*" Or After = "/" Or After = "-" Then
		RefuseParameterKind(Name, Kind, "Number", "arithmetic");
	ElsIf Before = "LIKE" Or Before = Upper("Подобно") Or After = "LIKE" Or After = Upper("Подобно") Then
		RefuseParameterKind(Name, Kind, "String", "LIKE");
	ElsIf NeedsBooleanWrapSpan(Tokens, Index, Index, Context) Then
		RefuseParameterKind(Name, Kind, "Boolean", "a condition");
	EndIf;

EndProcedure

// Вид переданного значения параметра: Number, String, Boolean, Date, Reference. Пустая
// строка - значения нет, оно NULL или вид не выводится (список, ссылка платформы).
Function SuppliedParameterKind(Name, Context)

	If IsBlankString(Name) Or Not Context.Options.SubstituteParameters
		Or IsOuterColumnStub(Name, Context) Then
		Return "";
	EndIf;
	ValueType = TypeOf(Context.Options.ParameterValues.Get(Name));
	If ValueType = Type("Number") Then
		Return "Number";
	ElsIf ValueType = Type("String") Then
		Return "String";
	ElsIf ValueType = Type("Boolean") Then
		Return "Boolean";
	ElsIf ValueType = Type("Date") Then
		Return "Date";
	ElsIf ValueType = Type("Structure") Then
		Return "Reference";
	EndIf;
	Return "";

EndFunction

Procedure RefuseParameterKind(Name, Kind, Expected, Operation)

	If IsBlankString(Kind) Or Kind = Expected Then
		Return;
	EndIf;
	Raise StrTemplate("Parameter &%1 is given a value of kind %2, while %3 takes a %4 here."
		+ " The platform refuses such a query when it runs it (""Wrong parameters"","
		+ " ""Incompatible types""), and the SQL with the value substituted would return a value"
		+ " instead. Pass a %4 value.", Name, Lower(Kind), Operation, Lower(Expected));

EndProcedure

// Аргумент-дата функции дат. Части даты от литерала NULL платформа отвергает («Wrong
// parameters "ГОД"»), НАЧАЛОПЕРИОДА(NULL) принимает и отдаёт NULL; параметр со значением не
// даты отвергает везде (негативная батарея 13.11.2026: dt17 ГОД(NULL), dt16 НАЧАЛОПЕРИОДА(&П)
// при 5).
Procedure CheckDateArgument(Arguments, Position, NullRefused, Context)

	Raw = Argument(Arguments, Position);
	If NullRefused And Upper(Raw) = "NULL" Then
		Raise "A date part (YEAR, MONTH, DAY and the like) is taken from the NULL literal. The platform"
			+ " refuses such a query (""Wrong parameters""), and the SQL would return NULL instead."
			+ " Pass a date or drop the call.";
	EndIf;
	Name = LoneParameterName(Raw);
	If Not IsBlankString(Name) Then
		RefuseParameterKind(Name, SuppliedParameterKind(Name, Context), "Date", "a date function");
	EndIf;

EndProcedure

// Индекс закрывающей скобки для открывающей.
// Сходятся ли скобки в отрезке токенов.
Function ParensBalanced(Tokens, Start, Finish)

	Depth = 0;
	For Index = Start To Finish Do
		If Tokens[Index].Value = "(" Then
			Depth = Depth + 1;
		ElsIf Tokens[Index].Value = ")" Then
			Depth = Depth - 1;
			If Depth < 0 Then
				Return False;
			EndIf;
		EndIf;
	EndDo;
	Return Depth = 0;

EndFunction

Function MatchingParen(Tokens, OpenIndex)

	Depth = 0;
	Position = OpenIndex;

	While Position < Tokens.Count() Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
			If Depth = 0 Then
				Return Position;
			EndIf;
		EndIf;
		Position = Position + 1;
	EndDo;

	Return Tokens.Count() - 1;

EndFunction

// Где кончается ветка ВЫБОРа: на ближайших КОГДА или КОНЕЦ своего уровня.
Function BranchEnd(Tokens, From)

	Depth = 0;
	CaseDepth = 0;
	Position = From;

	While Position < Tokens.Count() Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			If Depth = 0 Then
				Return Position - 1;
			EndIf;
			Depth = Depth - 1;
		ElsIf Depth = 0 And Tokens[Position].Kind = "Name" Then
			Word = Upper(Value);
			If Word = "CASE" Or Word = Upper("Выбор") Then
				CaseDepth = CaseDepth + 1;
			ElsIf Word = "END" Or Word = Upper("Конец") Then
				If CaseDepth = 0 Then
					Return Position - 1;
				EndIf;
				CaseDepth = CaseDepth - 1;
			ElsIf CaseDepth = 0 And (Word = "WHEN" Or Word = Upper("Когда")
				Or Word = "ELSE" Or Word = Upper("Иначе")) Then
				Return Position - 1;
			EndIf;
		EndIf;
		Position = Position + 1;
	EndDo;

	Return Tokens.Count() - 1;

EndFunction

// Обратная сборка исходного текста: имя параметра лексер держит без амперсанда.
Function TokensText(Tokens, From, Till)

	Parts = New Array;
	For Index = From To Till Do
		Parts.Add(?(Tokens[Index].Kind = "Parameter", "&" + Tokens[Index].Value, Tokens[Index].Value));
	EndDo;
	Return TrimAll(StrConcat(Parts, " "));

EndFunction

// Перед скобкой кортежа может стоять только ключевое слово или знак. Если там имя -
// это вызов функции, и скобка открывает список её аргументов.
Function OpensExpressionGroup(Tokens, OpenIndex)

	If OpenIndex = 0 Then
		Return True;
	EndIf;
	Previous = Tokens[OpenIndex - 1];
	If Previous.Kind <> "Name" Then
		Return True;
	EndIf;

	Allowed = New Map;
	Words = New Array;
	Words.Add("WHERE|ГДЕ");
	Words.Add("AND|И");
	Words.Add("OR|ИЛИ");
	Words.Add("NOT|НЕ");
	Words.Add("ON|ПО");
	Words.Add("HAVING|ИМЕЮЩИЕ");
	Words.Add("WHEN|КОГДА");
	Words.Add("THEN|ТОГДА");
	Words.Add("ELSE|ИНАЧЕ");
	Words.Add("CASE|ВЫБОР");
	Words.Add("SELECT|ВЫБРАТЬ");
	Words.Add("IN|В");
	Words.Add("BY|ПО");
	For Each Pair In Words Do
		For Each Word In StrSplit(Pair, "|", False) Do
			Allowed.Insert(Word, True);
		EndDo;
	EndDo;

	Return Allowed.Get(Upper(Previous.Value)) = True;

EndFunction

// Кортежное вхождение: скобка со списком выражений, за которой идёт В и подзапрос.
// Замерено: без проверки открывающей скобки сюда попадали вызовы функций с двумя
// аргументами - ЕСТЬNULL(X, НЕОПРЕДЕЛЕНО) В (список) читалось как кортеж из двух полей.
// На корпусах двух конфигураций это давало 97 ложных отказов.
Function IsTupleIn(Tokens, OpenIndex)

	If Not OpensExpressionGroup(Tokens, OpenIndex) Then
		Return False;
	EndIf;

	Finish = MatchingParen(Tokens, OpenIndex);
	If Finish + 2 >= Tokens.Count() Then
		Return False;
	EndIf;

	Word = Upper(Tokens[Finish + 1].Value);
	If Word <> "IN" And Word <> Upper("В") Then
		Return False;
	EndIf;
	If Tokens[Finish + 2].Value <> "(" Then
		Return False;
	EndIf;

	Depth = 0;
	For Index = OpenIndex + 1 To Finish - 1 Do
		Value = Tokens[Index].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
		ElsIf Value = "," And Depth = 0 Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

Function TupleInExpression(Tokens, OpenIndex, Context, Consumed)

	Finish = MatchingParen(Tokens, OpenIndex);
	RightOpen = Finish + 2;
	RightClose = MatchingParen(Tokens, RightOpen);
	Consumed = RightClose - OpenIndex;

	Lefts = SplitByComma(Tokens, OpenIndex + 1, Finish - 1);
	Inner = TokensText(Tokens, RightOpen + 1, RightClose - 1);

	// Справа параметр: это таблица значений - строки в памяти 1С, в тексте запроса их нет (корпус: все
	// отказы этого вида - `(А, Б) В (&ТаблицаЗначений)`, УХ 10, ERP WE 5). Входа нет - отказ законен.
	RightTokens = Tokenize(Inner);
	If RightTokens.Count() = 1 And RightTokens[0].Kind = "Parameter" Then
		Raise StrTemplate("(%1) IN (&%2): &%2 is a value table, rows held in 1C memory and passed with the"
			+ " query. The text carries only the parameter name, not the rows, so there is nothing to compare"
			+ " the tuple with in the SQL. Put the rows into a table of the database, or replace &%2 with a"
			+ " subquery over the tables they come from.", TokensText(Tokens, OpenIndex + 1, Finish - 1),
			TrimAll(RightTokens[0].Value));
	EndIf;

	Schema = New QuerySchema;
	Try
		Schema.SetQueryText(WithoutOuterReferences(Inner, Context));
	Except
		// #Имя - временная таблица, которую текст не создаёт (замер tp03, tp04): платформа её не находит.
		For Position = 0 To RightTokens.Count() - 2 Do
			If RightTokens[Position].Value = "#" And RightTokens[Position + 1].Kind = "Name" Then
				Raise StrTemplate("#%1 is a temporary table that some other query creates - this text does not create"
					+ " it itself. Paste the query that fills #%1 into the ""Missing queries"" field above and translate"
					+ " again.", RightTokens[Position + 1].Value);
			EndIf;
		EndDo;
		Raise "A tuple on the left of IN requires a subquery on the right.";
	EndTry;
	If Schema.QueryBatch.Count() <> 1 Then
		Raise "A subquery inside an expression cannot be a batch.";
	EndIf;

	Query = Schema.QueryBatch[0];
	If Query.Columns.Count() <> Lefts.Count() Then
		Raise "The number of columns of the subquery does not match the tuple on the left of IN.";
	EndIf;

	Alias = NextAliasPrefix(Context.AliasPrefix) + "IN";
	// Элемент, у которого слева или в подзапросе колонка из одних частей, сравнивается по частям
	// (PartsInPlan); части колонки подзапроса выводятся только при ExposeParts.
	Plans = New Array;
	Exposed = False;
	For Index = 0 To Lefts.Count() - 1 Do
		Plan = PartsInPlan(Lefts[Index], Query, Index, Context);
		Plans.Add(Plan);
		If Plan <> Undefined And Plan.Side <> "Left" Then
			Exposed = True;
		EndIf;
	EndDo;
	Body = QuerySql(Query, Context.Options, Context.Warnings, Context.TempTables,
		NextAliasPrefix(NextAliasPrefix(Context.AliasPrefix)), Exposed, False, True);
	NoteInSubqueryReads(Alias, Query, Context);

	Conditions = New Array;
	For Index = 0 To Lefts.Count() - 1 Do
		If Plans[Index] <> Undefined Then
			Conditions.Add(PartsInConditionSql(Plans[Index], Lefts[Index], Alias,
				Query.Columns[Index].Alias, Context));
			Continue;
		EndIf;
		Conditions.Add(CompositeTupleInTests(Lefts[Index], Query, Index, Context) + Alias + "."
			+ QuoteIdentifier(Query.Columns[Index].Alias, Context) + " = " + TranslateValue(Lefts[Index], Context));
	EndDo;

	Return "EXISTS (SELECT 1 FROM (" + Chars.LF + Body + Chars.LF + ") AS " + Alias
		+ " WHERE " + StrConcat(Conditions, " AND ") + ")";

EndFunction

Function SplitByComma(Tokens, From, Till)

	Result = New Array;
	Current = New Array;
	Depth = 0;

	For Index = From To Till Do
		Value = Tokens[Index].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
		ElsIf Value = "," And Depth = 0 Then
			Result.Add(TrimAll(StrConcat(Current, " ")));
			Current = New Array;
			Continue;
		EndIf;
		Current.Add(?(Tokens[Index].Kind = "Parameter", "&" + Value, Value));
	EndDo;

	If Current.Count() > 0 Then
		Result.Add(TrimAll(StrConcat(Current, " ")));
	EndIf;
	Return Result;

EndFunction

// Где кончается подзапрос: на закрывающей скобке того уровня, на котором он начался.
Function SubqueryEnd(Tokens, From)

	Depth = 0;
	Position = From;

	While Position < Tokens.Count() Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			If Depth = 0 Then
				Return Position - 1;
			EndIf;
			Depth = Depth - 1;
		EndIf;
		Position = Position + 1;
	EndDo;

	Return Tokens.Count() - 1;

EndFunction

// Коррелированный подзапрос ссылается на псевдоним внешнего запроса, поэтому сам по
// себе он не является запросом и платформа его не разберёт. Такие обращения заменяются
// на параметры-заглушки: текст становится самостоятельным, а при генерации SQL вместо
// заглушки подставляется настоящая колонка внешнего запроса.
Function WithoutOuterReferences(Text, Context)

	Tokens = Tokenize(Text);
	Inner = InnerAliases(Tokens);
	Replaced = New Array;
	Found = False;

	For Index = 0 To Tokens.Count() - 1 Do
		Token = Tokens[Index];
		Value = Token.Value;

		If Token.Kind = "Name" And StrFind(Value, ".") > 0 Then
			Head = Upper(TrimAll(StrSplit(Value, ".", False)[0]));
			If Inner.Get(Head) = Undefined And Context.Aliases.Get(Head) <> Undefined
				And Not IsTableNameToken(Tokens, Index, Head) Then
				Replaced.Add("&" + OuterReferencePlaceholder(Value, Context));
				Found = True;
				Continue;
			EndIf;
		EndIf;

		Replaced.Add(?(Token.Kind = "Parameter", "&" + Value, Value));
	EndDo;

	Return ?(Found, StrConcat(Replaced, " "), Text);

EndFunction

// Имя таблицы в ИЗ подзапроса, а не обращение к внешнему псевдониму: `Документ.X.Товары КАК Т`
// при внешнем псевдониме `Документ` (УХ ЭтапПроизводства2_2.РазделитьПартиюСЭтапа, ERP WE
// NonFinancialItemProfiles - имя таблицы подменялось заглушкой, и подзапрос не разбирался).
// Первое слово - коллекция метаданных, и имя стоит на месте таблицы.
Function IsTableNameToken(Tokens, Index, Head)

	If CollectionSynonyms().Get(Head) = Undefined Then
		Return False;
	EndIf;
	Previous = ?(Index > 0, Upper(Tokens[Index - 1].Value), "");
	Following = ?(Index < Tokens.Count() - 1, Upper(Tokens[Index + 1].Value), "");
	If Not (Previous = "FROM" Or Previous = Upper("Из") Or Previous = "JOIN" Or Previous = Upper("Соединение")
		Or Following = "AS" Or Following = Upper("Как")) Then
		Return False;
	EndIf;
	// Поле внешнего запроса тоже стоит перед КАК (`Документ.Номер КАК Н`): таблицей имя
	// считается, только если такой объект метаданных есть.
	Found = Undefined;
	Try
		Found = MetadataOf(Tokens[Index].Value);
	Except
		Found = Undefined;
	EndTry;
	Return Found <> Undefined;

EndFunction

// Псевдонимы, объявленные внутри самого подзапроса: их не подменяют.
Function InnerAliases(Tokens)

	Aliases = New Map;
	For Index = 1 To Tokens.Count() - 1 Do
		Previous = Upper(Tokens[Index - 1].Value);
		If Previous <> "AS" And Previous <> Upper("Как") Then
			Continue;
		EndIf;
		If Tokens[Index].Kind = "Name" Then
			Aliases.Insert(Upper(Tokens[Index].Value), True);
		EndIf;
	EndDo;
	Return Aliases;

EndFunction

Function OuterReferencePlaceholder(Path, Context)

	If Not Context.Options.Property("OuterColumns") Then
		Context.Options.Insert("OuterColumns", New Map);
	EndIf;
	If Context.Options.OuterColumns = Undefined Then
		Context.Options.OuterColumns = New Map;
	EndIf;

	Name = "OuterRef" + Format(Context.Options.OuterColumns.Count() + 1, "NG=0; NZ=0");
	// МоментВремени внешнего запроса - части, а не одно значение (PointInTimeParts): их отдаёт заглушка в сравнении
	// моментов времени (PointInTimeParameterParts); одним значением заглушка не переводится (ParameterReference).
	PathSegments = StrSplit(TrimAll(Path), ".", False);
	PitParts = Undefined;
	If PathSegments.Count() > 1 And IsPointInTimeField(PathSegments[PathSegments.Count() - 1]) Then
		PitParts = PointInTimeParts(Path, Context);
	EndIf;
	If PitParts <> Undefined Then
		If Not Context.Options.Property("OuterPointsInTime") Or Context.Options.OuterPointsInTime = Undefined Then
			Context.Options.Insert("OuterPointsInTime", New Map);
		EndIf;
		Context.Options.OuterPointsInTime.Insert(Name, PitParts);
		Context.Options.OuterColumns.Insert(Name, PitParts.DatePart);
	Else
		// Внешняя ссылка переводится во внешнем контексте: соединения по точке принадлежат
		// внешнему запросу, а не подзапросу.
		Context.Options.OuterColumns.Insert(Name, FieldReference(Path, Context));
	EndIf;
	// Путь и внешний контекст - для ТИПЗНАЧЕНИЯ от заглушки: тип поля внешнего запроса
	// выводится там же, где само поле (ParameterTypeLiteral).
	If Not Context.Options.Property("OuterColumnSources") Or Context.Options.OuterColumnSources = Undefined Then
		Context.Options.Insert("OuterColumnSources", New Map);
	EndIf;
	Context.Options.OuterColumnSources.Insert(Name, New Structure("Path, Context", Path, Context));
	Return Name;

EndFunction

// Подзапрос переводится тем же путём, что и обычный запрос: платформа разбирает его
// текст, а псевдонимы уходят на уровень глубже, чтобы не перекрыть внешние.
//
// InOperand - левый операнд «X В (ВЫБРАТЬ …)», если подзапрос стоит справа от В:
// структура Text (текст операнда, пустая строка - операнд не выделен) и IsNullLiteral.
Function SubquerySql(Text, Context, InOperand = Undefined)

	Schema = New QuerySchema;
	Try
		Schema.SetQueryText(WithoutOuterReferences(Text, Context));
	Except
		Raise StrTemplate("The platform could not parse the subquery: %1", ErrorDescription());
	EndTry;

	If Schema.QueryBatch.Count() <> 1 Then
		Raise "A subquery inside an expression cannot be a batch.";
	EndIf;

	Body = QuerySql(Schema.QueryBatch[0], Context.Options, Context.Warnings,
		Context.TempTables, NextAliasPrefix(Context.AliasPrefix), False, False, True);

	// Вхождение в подзапрос платформа считает двузначно - «есть совпадение или нет», -
	// когда колонка подзапроса составная, и тогда NULL ни слева, ни в подзапросе не
	// делает результат неизвестным. Замерено 14.11.2026 (УХ,
	// m_t2c.py): X = NULL, ссылка A, ссылка B; подзапрос - NULL, A и ссылка
	// другого справочника. `НЕ X В (…)` - строки NULL и B, `X В (…)` - строка A, значение
	// `НЕ X В (…)` в выборке - Истина, Ложь, Истина. Запрос УХ «НЕ Ссылка В (ВЫБРАТЬ …)» над
	// временной таблицей с NULL у групп справочника: 1С 4824 строки, NOT IN - ни одной.
	// С односоставной колонкой платформа ведёт себя как NOT IN (m_t2b.py: NULL в подзапросе -
	// ни одной строки, NULL слева при непустом подзапросе - строки нет), поэтому перепись
	// только для составной. Литерал NULL слева платформа считает «не входит» при любом
	// подзапросе: `НЕ NULL В (ВЫБРАТЬ …)` - строка есть, а у NOT IN её нет.
	//
	// Двузначность даёт отбор внутри подзапроса: строки с NULL выбрасываются, а при NULL
	// слева подзапрос пуст, и IN от пустого множества ложно.
	If InOperand <> Undefined
		And (InOperand.IsNullLiteral Or SubqueryColumnIsComposite(Schema.QueryBatch[0], Context)) Then
		If IsBlankString(InOperand.Text) Then
			Raise "IN with a subquery whose column is composite cannot be translated here: the left"
				+ " operand is an expression whose bounds are not clear. The platform treats such an"
				+ " IN as two-valued - a NULL on either side means ""not in"", never ""unknown"" -"
				+ " and T-SQL IN does not, so NOT IN would lose rows silently. Put the left operand"
				+ " in parentheses or compute it in a temporary table first.";
		EndIf;
		OperandText = InOperand.Text;
		If Not InOperand.IsNullLiteral And CaseStartBackward(Tokenize(OperandText), Tokenize(OperandText).Count() - 1) = 0 Then
			// ВЫБОР слева переводится одним значением, как и поле (там предупреждает сравнение по ссылке).
			AddOnce(Context.Warnings,
				"A CASE on the left of IN is compared with the composite column of the subquery by its reference column"
				+ " alone, so it also matches values of other types with the same bytes - an empty reference of another"
				+ " table in particular. Narrow both sides to one type with CAST if that matters.");
		EndIf;
		OperandSql = ?(InOperand.IsNullLiteral, "NULL", TranslateValue(OperandText, Context));
		Body = "SELECT NullSafeIn.Value FROM (" + Chars.LF + Body + Chars.LF + ") AS NullSafeIn(Value)"
			+ " WHERE NullSafeIn.Value IS NOT NULL AND " + OperandSql + " IS NOT NULL";
	EndIf;
	Return Chars.LF + Body + Chars.LF;

EndFunction

// Колонка подзапроса составная: по модели (несколько типов) или потому, что это
// хранимое составное поле либо колонка временной таблицы с частями.
Function SubqueryColumnIsComposite(Query, Context)

	Try
		If Query.Columns.Count() > 0 And IsCompositeDeclaredType(Query.Columns[0]) Then
			Return True;
		EndIf;
	Except
		Return False;
	EndTry;
	For Each Operator In Query.Operators Do
		If Operator.SelectedFields.Count() = 0 Then
			Continue;
		EndIf;
		Probe = NewContext(Context.Options, New Array, Context.TempTables, "TT");
		Try
			CollectSources(Operator, Probe);
			If CompositePartsOfExpression(String(Operator.SelectedFields[0]), Probe).Parts.Count() > 1 Then
				Return True;
			EndIf;
		Except
			Continue;
		EndTry;
	EndDo;
	Return False;

EndFunction

// Левый операнд вхождения, если подзапрос на позиции Index стоит справа от В.
// Undefined - подзапрос не справа от В.
Function InSubqueryOperand(Tokens, Index, Context)

	If Index < 3 Or Tokens[Index - 1].Value <> "(" Or Tokens[Index - 2].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index - 2].Value);
	If Word <> "IN" And Word <> Upper("В") Then
		Return Undefined;
	EndIf;

	Result = New Structure("Text, IsNullLiteral", "", False);
	Last = Index - 3;
	If Tokens[Last].Kind = "Name"
		And (Upper(Tokens[Last].Value) = "NOT" Or Upper(Tokens[Last].Value) = Upper("Не")) Then
		Last = Last - 1;
	EndIf;
	If Last < 0 Then
		Return Result;
	EndIf;
	If Tokens[Last].Kind = "Name" And Upper(Tokens[Last].Value) = "NULL" Then
		Result.IsNullLiteral = True;
		Result.Text = "NULL";
		Return Result;
	EndIf;
	If Tokens[Last].Kind = "Name" And (Upper(Tokens[Last].Value) = "END" Or Upper(Tokens[Last].Value) = Upper("Конец")) Then
		// ВЫБОР … КОНЕЦ: границы операнда - сами слова ВЫБОР и КОНЕЦ (УХ, ВстраиваниеУХЗаявкаНаРасходование-
		// ДенежныхСредств.ТекстЗапросаКОплате).
		Start = CaseStartBackward(Tokens, Last);
		If Start = Undefined Or Start > 0 And Tokens[Start - 1].Kind = "Symbol"
			And Tokens[Start - 1].Value <> "(" And Tokens[Start - 1].Value <> "," Then
			Return Result;
		EndIf;
		Result.Text = TokensText(Tokens, Start, Last);
		Return Result;
	EndIf;
	Start = OperandStart(Tokens, Last + 1);
	If Start = Undefined Then
		Return Result;
	EndIf;
	// Операнд, стоящий за арифметикой, - часть большего выражения: «А + Б В (…)» сравнивает
	// сумму, а граница по токенам дала бы одно Б.
	If Start > 0 And Tokens[Start - 1].Kind = "Symbol" And StrFind("+-*/", Tokens[Start - 1].Value) > 0 Then
		Return Result;
	EndIf;
	Result.Text = TokensText(Tokens, Start, Last);
	Return Result;

EndFunction

// Слово ВЫБОР, которое открывает ВЫБОР, закрытый словом КОНЕЦ на позиции Finish. Undefined - пары нет.
Function CaseStartBackward(Tokens, Finish)

	Depth = 0;
	Position = Finish;
	While Position >= 0 Do
		If Tokens[Position].Kind = "Name" Then
			Word = Upper(Tokens[Position].Value);
			If Word = "END" Or Word = Upper("Конец") Then
				Depth = Depth + 1;
			ElsIf Word = "CASE" Or Word = Upper("Выбор") Then
				Depth = Depth - 1;
				If Depth = 0 Then
					Return Position;
				EndIf;
			EndIf;
		EndIf;
		Position = Position - 1;
	EndDo;
	Return Undefined;

EndFunction

// Glues translated pieces back together without stray spaces around brackets and commas.
Function AssembleExpression(Parts)

	Result = "";
	For Each Part In Parts Do
		If IsBlankString(Result) Then
			Result = Part;
			Continue;
		EndIf;
		Glue = (Part = ")" Or Part = "," Or Part = "." Or Part = "("
			Or Right(Result, 1) = "(" Or Right(Result, 1) = ".");
		Result = Result + ?(Glue, "", " ") + Part;
	EndDo;
	Return Result;

EndFunction

Function TranslateName(Tokens, Index, Context, Consumed, IsKeyword = False)

	Token = Tokens[Index];
	UpperName = Upper(Token.Value);

	// Field reference: <alias>.<field>
	If StrFind(Token.Value, ".") > 0 Then
		Return FieldReference(Token.Value, Context);
	EndIf;

	Keyword = KeywordMap().Get(UpperName);
	If Keyword <> Undefined Then
		IsKeyword = True;
		Return Keyword;
	EndIf;

	Literal = LiteralMap(Context).Get(UpperName);
	If Literal <> Undefined Then
		Return Literal;
	EndIf;

	Handled = SpecialFunction(Tokens, Index, Context, Consumed);
	If Handled <> Undefined Then
		Return Handled;
	EndIf;

	Func = FunctionMap(Context).Get(UpperName);
	If Func <> Undefined Then
		Return Func;
	EndIf;

	If Index + 1 < Tokens.Count() And Tokens[Index + 1].Value = "(" Then
		If UpperName = "RECORDAUTONUMBER" Or UpperName = Upper("АвтоНомерЗаписи") Then
			CollectArguments(Tokens, Index, Consumed);
			Return RecordAutoNumber(Context);
		EndIf;
		Raise StrTemplate("Function %1 is not supported yet.", Token.Value);
	EndIf;

	// Inside the parameters of a virtual table the fields are named without an alias.
	Bare = Context.BareFields.Get(UpperName);
	If Bare <> Undefined Then
		Return ValueColumn(Bare);
	EndIf;

	// An unqualified identifier the platform left as is: most often an output alias.
	Return QuoteIdentifier(Token.Value, Context);

EndFunction

// In 1C a boolean field is a condition by itself; T-SQL has no boolean type, so such
// a field has to be compared explicitly - but only where a condition is expected.
Function NeedsBooleanWrapSpan(Tokens, Start, Finish, Context)

	If Not Context.BooleanContext And Not InCaseCondition(Tokens, Start) Then
		Return False;
	EndIf;

	Return LeftIsBoundary(Tokens, Start) And RightIsBoundary(Tokens, Finish);

EndFunction

// Внутри ВЫБОРа условие тянется от КОГДА до ТОГДА и может состоять из многих операндов,
// поэтому смотреть только на предыдущее слово мало: ищем ближайшее ключевое слово,
// не заходя внутрь вызовов функций.
Function InCaseCondition(Tokens, Index)

	Depth = 0;
	CaseDepth = 0;
	Position = Index - 1;

	While Position >= 0 Do
		Value = Tokens[Position].Value;

		If Value = ")" Then
			Depth = Depth + 1;
		ElsIf Value = "(" Then
			If Depth > 0 Then
				Depth = Depth - 1;
			ElsIf Position > 0 And Tokens[Position - 1].Kind = "Name"
				And Not IsGroupingKeyword(Upper(Tokens[Position - 1].Value)) Then
				// Это открывающая скобка вызова функции: её аргумент - значение.
				// После связки скобка лишь группирует условие, и поиск идёт дальше.
				Return False;
			EndIf;
		ElsIf Depth = 0 And Tokens[Position].Kind = "Name" Then
			Word = Upper(Value);
			// Завершённый ВЫБОР левее - операнд того же условия: его ТОГДА и ИНАЧЕ к
			// искомому месту не относятся, и он пропускается целиком.
			If Word = "END" Or Word = Upper("Конец") Then
				CaseDepth = CaseDepth + 1;
			ElsIf CaseDepth > 0 Then
				If Word = "CASE" Or Word = Upper("Выбор") Then
					CaseDepth = CaseDepth - 1;
				EndIf;
			ElsIf Word = "WHEN" Or Word = Upper("Когда") Then
				Return IsSearchedCaseWhen(Tokens, Position);
			ElsIf Word = "THEN" Or Word = Upper("Тогда")
				Or Word = "ELSE" Or Word = Upper("Иначе")
				Or Word = "CASE" Or Word = Upper("Выбор") Then
				Return False;
			EndIf;
		EndIf;

		Position = Position - 1;
	EndDo;

	Return False;

EndFunction

// Обёртка нужна только самостоятельному операнду условия: внутри вызова функции
// или рядом со сравнением поле должно остаться как есть.
// Ключевые слова, после которых скобка группирует условие, а не открывает вызов.
// ТОГДА, ИНАЧЕ, В и МЕЖДУ сюда не входят: после них идёт значение, а не условие.
Function IsGroupingKeyword(UpperToken)

	Return OpensCondition(UpperToken);

EndFunction

// У ВЫБОРа две формы. В «ВЫБОР КОГДА <условие> ТОГДА» операнд КОГДА - условие, а в
// «ВЫБОР <выражение> КОГДА <значение> ТОГДА» - значение, и оборачивать его сравнением
// нельзя. Различить их можно только по тому, что стоит сразу за словом ВЫБОР.
Function IsSearchedCaseWhen(Tokens, WhenIndex)

	Depth = 0;
	CaseDepth = 0;
	Position = WhenIndex - 1;

	While Position >= 0 Do
		Value = Tokens[Position].Value;
		If Value = ")" Then
			Depth = Depth + 1;
		ElsIf Value = "(" Then
			If Depth > 0 Then
				Depth = Depth - 1;
			EndIf;
		ElsIf Depth = 0 And Tokens[Position].Kind = "Name" Then
			Word = Upper(Value);
			If Word = "END" Or Word = Upper("Конец") Then
				CaseDepth = CaseDepth + 1;
			ElsIf Word = "CASE" Or Word = Upper("Выбор") Then
				If CaseDepth = 0 Then
					If Position + 1 >= Tokens.Count() Then
						Return True;
					EndIf;
					Next = Upper(Tokens[Position + 1].Value);
					Return Next = "WHEN" Or Next = Upper("Когда");
				EndIf;
				CaseDepth = CaseDepth - 1;
			EndIf;
		EndIf;
		Position = Position - 1;
	EndDo;

	Return True;

EndFunction

// Принадлежит ли это И оператору МЕЖДУ. Смотрим назад по тому же уровню скобок:
// если раньше любой другой границы встретилось МЕЖДУ - да.
Function IsBetweenAnd(Tokens, Index)

	Depth = 0;
	Position = Index - 1;

	While Position >= 0 Do
		Value = Upper(Tokens[Position].Value);
		If Value = ")" Then
			Depth = Depth + 1;
		ElsIf Value = "(" Then
			If Depth = 0 Then
				Return False;
			EndIf;
			Depth = Depth - 1;
		ElsIf Depth = 0 Then
			If Value = "BETWEEN" Or Value = Upper("Между") Then
				Return True;
			ElsIf OpensCondition(Value) Or Value = "THEN" Or Value = Upper("Тогда")
				Or Value = "ELSE" Or Value = Upper("Иначе") Then
				Return False;
			EndIf;
		EndIf;
		Position = Position - 1;
	EndDo;

	Return False;

EndFunction

Function LeftIsBoundary(Tokens, Index)

	If Index = 0 Then
		Return True;
	EndIf;

	Token = Upper(Tokens[Index - 1].Value);
	If OpensCondition(Token) Then
		// И в МЕЖДУ ... И ... - часть оператора диапазона, а не логическая связка:
		// справа от него стоит граница, а не самостоятельное условие.
		If (Token = "AND" Or Token = Upper("И")) And IsBetweenAnd(Tokens, Index - 1) Then
			Return False;
		EndIf;
		If (Token = "WHEN" Or Token = Upper("Когда")) And Not IsSearchedCaseWhen(Tokens, Index - 1) Then
			Return False;
		EndIf;
		Return True;
	EndIf;
	If Token <> "(" Then
		Return False;
	EndIf;
	If Index < 2 Then
		Return True;
	EndIf;
	// Скобка открывает вызов функции, если перед ней стоит имя функции. Ключевое слово
	// именем не считается: И (...) - это группировка условия, а не вызов.
	If Tokens[Index - 2].Kind = "Name" Then
		Return IsGroupingKeyword(Upper(Tokens[Index - 2].Value));
	EndIf;
	Return Not OpensValueBracket(Upper(TrimAll(Tokens[Index - 2].Value)));

EndFunction

// Скобка после операции открывает значение, а не условие: в A = (ВЫРАЗИТЬ(...))
// внутри стоит операнд. Обернуть его как булево - значит получить A = (<выражение> = ИСТИНА),
// а такого T-SQL не принимает.
Function OpensValueBracket(Token)

	Operators = New Array;
	Operators.Add("=");
	Operators.Add("<>");
	Operators.Add("<");
	Operators.Add(">");
	Operators.Add("<=");
	Operators.Add(">=");
	Operators.Add("+");
	Operators.Add("-");
	Operators.Add("*");
	Operators.Add("/");
	Operators.Add(",");
	Return Operators.Find(Token) <> Undefined;

EndFunction

Function RightIsBoundary(Tokens, Index)

	If Index + 1 >= Tokens.Count() Then
		Return True;
	EndIf;

	Token = Upper(Tokens[Index + 1].Value);
	If Token <> ")" Then
		Return ClosesCondition(Token);
	EndIf;

	// Закрывающая скобка завершает условие только если за самой группой не стоит
	// сравнение или арифметика. Платформа нормализует операнд в скобки:
	// (ВЫРАЗИТЬ(...)) <> "" и (ВЫРАЗИТЬ(...)) - Т.Поле <> 0 - это значения, а не
	// условия, и оборачивать их как булево нельзя.
	Position = Index + 1;
	While Position < Tokens.Count() And Tokens[Position].Value = ")" Do
		Position = Position + 1;
	EndDo;
	If Position >= Tokens.Count() Then
		Return True;
	EndIf;
	Following = Upper(TrimAll(Tokens[Position].Value));
	Return Not IsComparison(Following) And Not IsArithmetic(Following);

EndFunction

// Слева условие открывают связки и КОГДА; ТОГДА и ИНАЧЕ вводят значение, не условие.
Function OpensCondition(UpperToken)

	Return UpperToken = "" Or UpperToken = "AND" Or UpperToken = Upper("И")
		Or UpperToken = "OR" Or UpperToken = Upper("ИЛИ")
		Or UpperToken = "NOT" Or UpperToken = Upper("НЕ")
		Or UpperToken = "WHEN" Or UpperToken = Upper("Когда");

EndFunction

Function ClosesCondition(UpperToken)

	Return UpperToken = "" Or UpperToken = "AND" Or UpperToken = Upper("И")
		Or UpperToken = "OR" Or UpperToken = Upper("ИЛИ")
		Or UpperToken = "THEN" Or UpperToken = Upper("Тогда")
		Or UpperToken = ")";

EndFunction

// Слева от ССЫЛКА должно стоять поле: проверка типа подставляется на место операнда,
// и выражение так заменить нельзя. Скобки вокруг поля платформа ставит сама, поэтому
// `(Поле) ССЫЛКА ...` - это тоже поле, а `ЕСТЬNULL(...) ССЫЛКА ...` - уже нет.
Function LeftOperandIsField(Tokens, Index, LastPath)

	Position = Index - 1;
	Depth = 0;

	While Position >= 0 Do
		Value = TrimAll(Tokens[Position].Value);

		If Value = ")" Then
			// Скобка закрывает вызов функции, если перед парной открывающей стоит имя.
			Depth = Depth + 1;
			Position = Position - 1;
			Continue;
		ElsIf Value = "(" Then
			If Depth = 0 Then
				Return False;
			EndIf;
			Depth = Depth - 1;
			If Position > 0 And Tokens[Position - 1].Kind = "Name" Then
				Return False;
			EndIf;
			Position = Position - 1;
			Continue;
		EndIf;

		Return Depth = 0 And Upper(Value) = Upper(TrimAll(LastPath));
	EndDo;

	Return False;

EndFunction

// Знак арифметики после отрезка означает, что отрезок - операнд выражения, а не
// самостоятельное условие.
Function IsArithmetic(UpperToken)

	Return UpperToken = "+" Or UpperToken = "-" Or UpperToken = "*" Or UpperToken = "/";

EndFunction

Function IsComparison(UpperToken)

	Return UpperToken = "=" Or UpperToken = "<>" Or UpperToken = "<" Or UpperToken = ">"
		Or UpperToken = "<=" Or UpperToken = ">="
		Or UpperToken = "IN" Or UpperToken = Upper("В")
		Or UpperToken = "BETWEEN" Or UpperToken = Upper("Между")
		Or UpperToken = "LIKE" Or UpperToken = Upper("Подобно")
		Or UpperToken = "IS" Or UpperToken = Upper("Есть");

EndFunction

// Тип параметра по второму операнду сравнения. Вызывается на каждом токене и молча
// выходит, если образца нет: наблюдатель, потока не меняет.
Procedure NoteParameterType(Tokens, Index, Context)

	// Параметр рядом с *, / или - в 1С может быть только числом: арифметики над датами и
	// строками (кроме +) язык запросов не знает. Без объявленного типа MS SQL не может
	// вывести тип результата деления (`@П * x * 1.00000000 / y`) и отвергает текст.
	If Tokens[Index].Kind = "Parameter" Then
		Before = ?(Index > 0, Tokens[Index - 1].Value, "");
		After = ?(Index < Tokens.Count() - 1, Tokens[Index + 1].Value, "");
		If Before = "*" Or Before = "/" Or After = "*" Or After = "/"
			Or Before = "-" Or After = "-" Then
			RememberParameterType(Tokens[Index].Value, "NUMERIC(20, 8)", Context);
		EndIf;
	EndIf;

	If Index + 2 > Tokens.Count() - 1 Then
		Return;
	EndIf;

	Operator = Tokens[Index + 1];

	// СУММА(&Параметр), СРЕДНЕЕ(&Параметр): эти агрегаты считают только числа.
	If Tokens[Index].Kind = "Name" And Operator.Value = "(" And Tokens[Index + 2].Kind = "Parameter"
		And Index + 3 <= Tokens.Count() - 1 And Tokens[Index + 3].Value = ")" Then
		Word = Upper(Tokens[Index].Value);
		If Word = "SUM" Or Word = Upper("Сумма") Or Word = "AVG" Or Word = Upper("Среднее") Then
			RememberParameterType(Tokens[Index + 2].Value, "NUMERIC(20, 8)", Context);
		EndIf;
		Return;
	EndIf;

	// «поле МЕЖДУ &Начало И &Конец»: оба параметра того же типа, что поле. Так записан
	// период почти везде, и символом сравнения этот образец не ловится - МЕЖДУ слово.
	If Operator.Kind = "Name" And Tokens[Index].Kind = "Name"
		And (Upper(Operator.Value) = "BETWEEN" Or Upper(Operator.Value) = Upper("Между"))
		And StrFind(Tokens[Index].Value, ".") > 0 Then
		SqlType = SqlTypeOfPath(Tokens[Index].Value, Context);
		If Not IsBlankString(SqlType) Then
			For Shift = 2 To 4 Do
				If Index + Shift > Tokens.Count() - 1 Then
					Break;
				EndIf;
				If Tokens[Index + Shift].Kind = "Parameter" Then
					RememberParameterType(Tokens[Index + Shift].Value, SqlType, Context);
				ElsIf Tokens[Index + Shift].Kind = "Name" And Shift <> 3 Then
					// Границей бывает и колонка временной таблицы, заполненная параметром.
					NoteColumnParameterTypes(Tokens[Index + Shift].Value, Tokens[Index].Value, Context);
				EndIf;
			EndDo;
		EndIf;
		Return;
	EndIf;

	If Operator.Kind <> "Symbol" Or Not IsComparison(Operator.Value) Then
		Return;
	EndIf;

	// Поля в сравнении нет: оба операнда - параметры. Тип одного из них к этому моменту
	// может быть ещё не выведен, поэтому пара откладывается до выдачи шапки.
	If Tokens[Index].Kind = "Parameter" And Tokens[Index + 2].Kind = "Parameter" Then
		LinkParameterTypes(Tokens[Index].Value, Tokens[Index + 2].Value, Context);
		Return;
	EndIf;

	Left = Tokens[Index];
	Right = Tokens[Index + 2];
	If Left.Kind = "Name" And Right.Kind = "Name" Then
		NoteColumnParameterTypes(Left.Value, Right.Value, Context);
		Return;
	EndIf;
	If Left.Kind = "Name" And Right.Kind = "Parameter" Then
		Path = Left.Value;
		Name = Right.Value;
	ElsIf Left.Kind = "Parameter" And Right.Kind = "Name" Then
		Path = Right.Value;
		Name = Left.Value;
	Else
		Return;
	EndIf;

	If StrFind(Path, ".") = 0 Then
		Return;
	EndIf;

	SqlType = SqlTypeOfPath(Path, Context);
	If IsBlankString(SqlType) Then
		Return;
	EndIf;

	RememberParameterType(Name, SqlType, Context);

EndProcedure

// Два параметра по обе стороны сравнения: типы у них общие, но какой именно станет
// известно позже. Пара запоминается, разбирает её ResolveParameterTypeLinks.
Procedure LinkParameterTypes(First, Second, Context)

	If IsBlankString(First) Or IsBlankString(Second)
		Or Upper(TrimAll(First)) = Upper(TrimAll(Second)) Then
		Return;
	EndIf;
	If Not Context.Options.Property("ParameterTypeLinks")
		Or Context.Options.ParameterTypeLinks = Undefined Then
		Context.Options.Insert("ParameterTypeLinks", New Array);
	EndIf;
	Link = New Structure("First, Second", Upper(TrimAll(First)), Upper(TrimAll(Second)));
	Context.Options.ParameterTypeLinks.Add(Link);

EndProcedure

// Перенос типа по цепочке сравнений «параметр с параметром». Проходов не больше, чем
// связей: за проход переносится хотя бы одна, иначе переносить нечего.
Procedure ResolveParameterTypeLinks(Context)

	If Not Context.Options.Property("ParameterTypeLinks")
		Or Context.Options.ParameterTypeLinks = Undefined Then
		Return;
	EndIf;

	Links = Context.Options.ParameterTypeLinks;
	For Pass = 1 To Links.Count() Do
		Spread = False;
		For Each Link In Links Do
			FirstType = InferredParameterType(Link.First, Context);
			SecondType = InferredParameterType(Link.Second, Context);
			If Not IsBlankString(FirstType) And IsBlankString(SecondType) Then
				RememberParameterType(Link.Second, FirstType, Context);
				Spread = True;
			ElsIf IsBlankString(FirstType) And Not IsBlankString(SecondType) Then
				RememberParameterType(Link.First, SecondType, Context);
				Spread = True;
			EndIf;
		EndDo;
		If Not Spread Then
			Break;
		EndIf;
	EndDo;

EndProcedure

Procedure RememberParameterType(Name, SqlType, Context)

	If IsBlankString(SqlType) Or IsBlankString(Name) Then
		Return;
	EndIf;
	If Not Context.Options.Property("ParameterSqlTypes")
		Or Context.Options.ParameterSqlTypes = Undefined Then
		Context.Options.Insert("ParameterSqlTypes", New Map);
	EndIf;
	Context.Options.ParameterSqlTypes.Insert(Upper(TrimAll(Name)), SqlType);

EndProcedure

// SQL-тип поля: у таблицы базы - из метаданных, у поля виртуальной таблицы, которого
// в метаданных нет, - по имени периода. Пустая строка означает «не определили».
Function SqlTypeOfPath(Path, Context, ThroughSources = True)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return "";
	EndTry;

	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;

	FieldName = Upper(TrimAll(Resolved.FieldName));
	If Resolved.Descriptor = Undefined Or Resolved.Descriptor.IsDerived Then
		// Период виртуальной таблицы строит сама обработка, в метаданных его нет.
		If FieldName = "PERIOD" Or FieldName = Upper("Период")
			Or FieldName = "DATE" Or FieldName = Upper("Дата")
			Or FieldName = "POINTINTIME" Or FieldName = Upper("МоментВремени") Then
			Return "DATETIME2";
		EndIf;
		// Колонка, пришедшая из поля метаданных без изменений - измерение или ресурс
		// виртуальной таблицы, колонка временной таблицы, - несёт тип этого поля.
		If ThroughSources And Resolved.Descriptor <> Undefined
			And Resolved.Descriptor.Property("ColumnSources") Then
			Origin = Resolved.Descriptor.ColumnSources.Get(FieldName);
			If Origin <> Undefined And Origin.Property("FieldName") Then
				Owner = MetadataOf(Origin.LogicalName);
				If Owner <> Undefined Then
					Return PrimitiveSqlType(FieldTypeDescription(Owner, TrimAll(Origin.FieldName)));
				EndIf;
			EndIf;
		EndIf;
		Return "";
	EndIf;

	// Табличная часть в языке запросов зовётся `Документ.X.Товары`, а полное имя
	// метаданных у неё другое, и FindByFullName её не находит. MetadataOf это умеет -
	// и свои табличные части, и стандартные. Без этого не выводился тип параметра у
	// формы `ВЫБОР КОГДА … ТОГДА &Параметр ИНАЧЕ Т.ПолеТабличнойЧасти КОНЕЦ`.
	Owner = MetadataOf(Resolved.Descriptor.LogicalName);
	If Owner = Undefined Then
		Return "";
	EndIf;

	FieldType = FieldTypeDescription(Owner, TrimAll(Resolved.FieldName));
	If FieldType = Undefined Then
		If FieldName = "PERIOD" Or FieldName = Upper("Период")
			Or FieldName = "DATE" Or FieldName = Upper("Дата")
			Or FieldName = "POINTINTIME" Or FieldName = Upper("МоментВремени") Then
			Return "DATETIME2";
		EndIf;
		Return "";
	EndIf;

	Return PrimitiveSqlType(FieldType);

EndFunction

// Тип SQL у поля с единственным примитивным типом; у ссылочного и составного - пусто.
Function PrimitiveSqlType(FieldType)

	If FieldType = Undefined Then
		Return "";
	EndIf;
	Types = FieldType.Types();
	If Types.Count() <> 1 Then
		Return "";
	EndIf;

	Kind = Types[0];
	If Kind = Type("Date") Then
		Return "DATETIME2";
	ElsIf Kind = Type("Number") Then
		Return "NUMERIC(20, 8)";
	ElsIf Kind = Type("String") Then
		Return "NVARCHAR(500)";
	ElsIf Kind = Type("Boolean") Then
		Return "BINARY(1)";
	EndIf;
	Return "";

EndFunction

Function IsBooleanField(Descriptor, FieldName)

	If Descriptor = Undefined Or Descriptor.IsDerived Then
		Return False;
	EndIf;

	Owner = MetadataOf(Descriptor.LogicalName);
	If Owner = Undefined Then
		Return False;
	EndIf;

	FieldType = FieldTypeDescription(Owner, TrimAll(FieldName));
	If FieldType = Undefined Then
		Return False;
	EndIf;

	Types = FieldType.Types();
	Return Types.Count() = 1 And Types[0] = Type("Boolean");

EndFunction

// Значение в терминах хранения. Составное значение платформа держит несколькими
// колонками и собирает его уже после чтения: байт типа, идентификатор таблицы ссылки,
// сама ссылка и примитивные полезные нагрузки. Поэтому значение здесь - упорядоченный
// список колонок с ролями, в том порядке, в каком их отдаёт структура хранения, плюс
// признак «односоставное».
//
// Роли: TYPE - байт типа, RTREF - идентификатор таблицы ссылки, RRREF - сама ссылка,
// S, N, T, L - строка, число, дата, булево. Роли может и не быть: у регистратора нет
// байта типа, потому что регистратор всегда ссылка, а у составного из примитивов и
// одной ссылки нет RTREF - ссылочный тип там ровно один. У односоставного значения
// колонка одна, и роль у неё пустая: различать нечего.
//
// Текст части - выражение, а не обязательно имя колонки. Замерено на платформе:
// ЕСТЬNULL(ссылка, строка) и ВЫБОР с разнотипными ветвями собирают каждую часть своим
// ВЫБОРом, а МАКСИМУМ(составное) - через SUBSTRING. Список пар «роль - текст» описывает
// и такие значения, без изменений.
Function NewValue(IsSingle)

	Value = New Structure;
	Value.Insert("Parts", New Array);
	Value.Insert("IsSingle", IsSingle);
	Return Value;

EndFunction

Procedure AddValuePart(Value, Role, Text)

	Part = New Structure;
	Part.Insert("Role", Role);
	Part.Insert("Text", Text);
	Value.Parts.Add(Part);

EndProcedure

// Односоставное значение: одна колонка, роли у неё нет.
Function SingleValue(Text)

	Value = NewValue(True);
	AddValuePart(Value, "", Text);
	Return Value;

EndFunction

// Одна колонка значения - та, которой пользуются нынешние потребители. Это последняя
// часть: у односоставного единственная, у составного - колонка ссылки, ровно её же
// отдаёт SingleColumn. Свести значение к одной колонке больше негде, поэтому вывод
// остаётся прежним ровно до тех пор, пока в последнюю часть кладут готовый текст.
Function ValueColumn(Value)

	Return Value.Parts[Value.Parts.Count() - 1].Text;

EndFunction

// Роль колонки в значении. Разложение берётся готовым, у CompositeInfo: суффиксы
// разбираются в одном месте, и порядок проверок там значим - _RTREF раньше TREF.
Function ValueRole(Info, Column)

	If Column = Info.TypeColumn Then
		Return "TYPE";
	ElsIf Column = Info.RefTypeColumn Then
		Return "RTREF";
	ElsIf Column = Info.RefColumn Then
		Return "RRREF";
	ElsIf Column = Info.StringColumn Then
		Return "S";
	ElsIf Column = Info.NumberColumn Then
		Return "N";
	ElsIf Column = Info.DateColumn Then
		Return "T";
	ElsIf Column = Info.BooleanColumn Then
		Return "L";
	EndIf;
	Return "";

EndFunction

// Значение поля таблицы. Составным поле считает тот же CompositeInfo, по которому
// работают сравнение типов, ВЫРАЗИТЬ и переход по составной ссылке, поэтому составным
// ничего нового не становится.
//
// Текст последней части не вычисляется, а берётся параметром Column: это ровно та
// строка, которую разрешение поля отдавало до появления значения. У таблицы базы она
// и есть последняя колонка списка - структура хранения кладёт колонку ссылки
// последней, а Fields отдаёт её же. У производной таблицы колонка ссылки объявлена
// дважды: отдельной частью <поле>_RRRef и самим полем, куда её выводит запрос, - и
// обработка берёт второе. Поэтому последняя часть именно переданная, а не собранная
// заново: тогда ValueColumn по любому значению даёт прежний вывод буква в букву.
Function StoredFieldValue(Descriptor, Alias, FieldName, Column, Context)

	Info = CompositeInfo(Descriptor, FieldName);
	If Info = Undefined Then
		Return SingleValue(Column);
	EndIf;

	ColumnList = Descriptor.Columns.Get(Upper(TrimAll(FieldName)));
	Value = NewValue(False);
	LastIndex = ColumnList.Count() - 1;
	For Index = 0 To LastIndex Do
		Stored = ColumnList[Index];
		AddValuePart(Value, ValueRole(Info, Stored),
			?(Index = LastIndex, Column, FieldColumn(Descriptor, Alias, Stored, Context)));
	EndDo;
	Return Value;

EndFunction

// Колонка поля: единственная колонка его значения. Составное значение платформа держит
// несколькими колонками, но нынешние потребители берут из него одну - ту же, что и до
// появления значения.
Function FieldReference(Path, Context)

	Return ValueColumn(FieldValue(Path, Context));

EndFunction

Function FieldValue(Path, Context)

	Resolved = ResolveField(Path, Context);

	If Not IsBlankString(Resolved.CompositeSegment) Then
		// Переход по типам ищет последний сегмент только среди колонок хранения, а
		// Представление в хранении не лежит - это псевдополе. Все обработчики псевдополей
		// стоят ниже этой проверки, поэтому за составной ссылкой они не срабатывали никогда,
		// и путь вида «составная ссылка.Представление» отвергался как «ни у одного типа нет
		// такого поля» - 48 запросов корпуса.
		//
		// Порядок такой: сначала переход, чтобы настоящий реквизит с именем Представление
		// побеждал псевдополе, и только когда его нет ни у одного типа - псевдополе.
		// Ветви с нехваткой поля отбрасываются до построения соединения, поэтому неудачная
		// попытка мусора в запросе не оставляет.
		Try
			Return SingleValue(
				CompositeNavigation(Resolved, Resolved.CompositeSegment, Resolved.FieldName, Context));
		Except
			If IsPresentationField(Resolved.FieldName)
				And Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined
				And Resolved.CompositeTail.Count() = 0 Then
				// Представление составной ссылки обработка уже умеет: это тот же путь, что у
				// ПРЕДСТАВЛЕНИЕ(<составная ссылка>), с тем же приближением и тем же
				// предупреждением. Остаток пути этим не закрывается - там представление надо
				// брать в конце хвоста внутри каждой ветви, и это отдельная работа.
				Return SingleValue(PresentationExpression(PresentationSourcePath(Path, Context), Context, True));
			EndIf;
			Raise;
		EndTry;
	EndIf;

	// В хранении лежит идентификатор объявления, а не имя. Проверки на отсутствие поля
	// здесь нет намеренно: поле в описателе есть, но его значение - не то, что спрашивают.
	If IsPredefinedNameSegment(Resolved.FieldName) Then
		Return SingleValue(PredefinedNameExpression(Path, Context));
	EndIf;

	If IsPredefinedFlag(Resolved.FieldName)
		And Resolved.Descriptor.Fields.Get(Upper(Resolved.FieldName)) = Undefined Then
		// Признака «предопределённый» в хранении нет, есть идентификатор предопределённых
		// данных: у обычного элемента он нулевой.
		Stored = PredefinedColumn(Resolved.Descriptor);
		If Stored = Undefined Then
			Raise StrTemplate("Table %1 keeps no predefined data identifier.",
				Resolved.Descriptor.LogicalName);
		EndIf;
		Column = FieldColumn(Resolved.Descriptor, Resolved.Alias, Stored, Context);
		RegisterKeyDeterminedColumn(Context, Resolved.Descriptor, Resolved.Alias, Column);
		// Без ИНАЧЕ: у строки внешнего соединения без пары идентификатор NULL, и признак
		// должен остаться NULL, а не стать ЛОЖЬ (сверка battery27: ЕСТЬ NULL - 1С 25, SQL 0).
		Empty = BinaryLiteral("00000000000000000000000000000000", Context);
		Return SingleValue(
			"(CASE WHEN " + Column + " <> " + Empty + " THEN " + BooleanLiteral(True, Context)
			+ " WHEN " + Column + " = " + Empty + " THEN " + BooleanLiteral(False, Context) + " END)");
	EndIf;

	// Тип у журнала документов - виртуальное поле: в хранении его нет, ссылка лежит
	// парой колонок, и первая из них несёт идентификатор таблицы документа. Это ровно
	// то же выражение, что строит ТИПЗНАЧЕНИЯ(Ссылка), поэтому к нему и обращаемся.
	If (Upper(Resolved.FieldName) = "TYPE" Or Upper(Resolved.FieldName) = Upper("Тип"))
		And Resolved.Descriptor.Fields.Get(Upper(Resolved.FieldName)) = Undefined Then
		Names = New Array;
		Names.Add("Ref");
		Names.Add("Ссылка");
		RefField = FirstExistingField(Resolved.Descriptor, Names);
		If Not IsBlankString(RefField) Then
			RefPath = Left(Path, StrLen(Path) - StrLen(Resolved.FieldName)) + RefField;
			Return SingleValue(
				ValueTypeOfResolved(ResolveField(RefPath, Context), RefPath, Context));
		EndIf;
	EndIf;

	If IsPointInTimeField(Resolved.FieldName)
		And Resolved.Descriptor.Fields.Get(Upper(Resolved.FieldName)) = Undefined Then
		// МоментВремени - не одно значение, а набор колонок: дата, таблица ссылки, ссылка (замеры
		// pfp1-pfp5, ptp1-ptp11, 20.11.2026, УХ). Колонкой выборки, ключом порядка и группировки и в
		// сравнении двух моментов его отдают SelectedFieldsSql, OrderSql, AddGroupExpressions и
		// PointInTimeComparisonSql через PointInTimeParts и сюда не заходят. Всё, что доходит сюда, -
		// место, где одного значения мало: прежде здесь отдавалась дата с предупреждением, и записи
		// одной секунды сравнивались и группировались иначе, чем у платформы, - молча.
		Raise PointInTimeRefusal(Path, Resolved);
	EndIf;

	// Представление в хранении не лежит: это псевдополе, равное ПРЕДСТАВЛЕНИЕ(<ссылка>).
	If IsPresentationField(Resolved.FieldName)
		And Resolved.Descriptor.Fields.Get(Upper(Resolved.FieldName)) = Undefined Then
		Return SingleValue(PresentationExpression(PresentationSourcePath(Path, Context), Context, True));
	EndIf;

	// ЭтотУзел тоже псевдополе: платформа считает его из идентификатора предопределённых
	// данных. Замерено (20101, 20102): CASE WHEN _PredefinedID > @P1 THEN 0x01 ELSE 0x00 END,
	// то есть «этот узел» - узел, который предопределён. Проверка на отсутствие поля в
	// хранении оставлена нарочно: реквизит с таким именем перекрывает псевдополе.
	If IsThisNodeField(Resolved.FieldName)
		And Resolved.Descriptor.Fields.Get(Upper(Resolved.FieldName)) = Undefined Then
		RegisterKeyDeterminedColumn(Context, Resolved.Descriptor, Resolved.Alias,
			Resolved.Alias + "." + PhysicalName("_PredefinedID", Context));
		Return SingleValue("(CASE WHEN " + Resolved.Alias + "."
			+ PhysicalName("_PredefinedID", Context) + " > "
			+ BinaryLiteral("00000000000000000000000000000000", Context) + " THEN "
			+ BooleanLiteral(True, Context) + " ELSE " + BooleanLiteral(False, Context) + " END)");
	EndIf;

	If Resolved.Descriptor.IsDerived And IsPointInTimeColumn(Resolved.Descriptor, Resolved.FieldName) Then
		// Колонка временной таблицы или вложенного запроса, которую модель запроса объявила моментом
		// времени: в ней лежит дата, таблица и ссылка - в колонках-спутниках (SelectedFieldsSql). Одна
		// дата здесь - то же молчаливое расхождение, что и у поля документа.
		Raise PointInTimeRefusal(Path, Resolved);
	EndIf;

	Stored = StorageFieldName(Resolved.Descriptor, Resolved.FieldName);
	If Resolved.Descriptor.IsDerived Then
		NoteCarriedPresentation(Resolved, Resolved.Alias + "." + QuoteIdentifier(Stored, Context), Context);
		// Column of a common table expression keeps the alias the query gave it.
		Return StoredFieldValue(Resolved.Descriptor, Resolved.Alias, Resolved.FieldName,
			Resolved.Alias + "." + QuoteIdentifier(Stored, Context), Context);
	EndIf;
	// FieldColumn, а не имя колонки: субконто и небалансовое измерение в условии виртуальной таблицы
	// бухгалтерского регистра собраны выражением (ConditionBase, DrCrConditionBase), колонки с таким
	// именем у таблицы нет. У остальных таблиц FieldColumn отдаёт ту же колонку, что и прежде.
	Column = FieldColumn(Resolved.Descriptor, Resolved.Alias, Stored, Context);
	RegisterStoredColumn(Context, Resolved.Descriptor, Resolved.Alias, Column);
	Return StoredFieldValue(Resolved.Descriptor, Resolved.Alias, Resolved.FieldName,
		?(IsFolderField(Resolved.FieldName), InvertedBoolean(Column, Context), Column), Context);

EndFunction

// Колонка, из которой выражение считает значение, не равное ей самой (ВЫРАЗИТЬ, признак
// предопределённого). В группировку она добирается только доказуемо - когда сгруппирована
// ссылка той же таблицы: тогда колонка ею определена и строк не прибавляет. Без условия
// добирать нельзя: запрос, сгруппированный по самому выражению, получил бы рядом сырую
// колонку, и группа раздробилась бы молча. У таблицы, присоединённой через точку,
// определителя в группировке нет, и колонка не добирается вовсе.
Procedure RegisterKeyDeterminedColumn(Context, Descriptor, Alias, Column)

	If Descriptor.IsDerived Or Context.HopAliases.Get(Alias) <> Undefined
		Or Context.CompositeColumns.Find(Column) <> Undefined Then
		Return;
	EndIf;
	KeyField = Descriptor.Fields.Get("REF");
	If KeyField = Undefined Then
		KeyField = Descriptor.Fields.Get(Upper("Ссылка"));
	EndIf;
	If KeyField <> Undefined Then
		RegisterDeterminedColumn(Context, Column, Alias + "." + PhysicalName(KeyField, Context));
	EndIf;

EndProcedure

// Хранимая колонка, прочитанная выражением, и её место в группировке.
Procedure RegisterStoredColumn(Context, Descriptor, Alias, Column)

	If Context.HopAliases.Get(Alias) <> Undefined Then
		// Реквизит, взятый через точку: в 1С группировки по нему не требуется, в T-SQL
		// присоединённую колонку надо положить в GROUP BY вместе со ссылкой.
		Context.NavigationColumns.Add(Column);
		Return;
	EndIf;

	// Поле своей же таблицы: в 1С его определяет сгруппированная ссылка, в T-SQL оно
	// обязано стоять в GROUP BY явно. Определитель один - колонка первичного ключа.
	// У таблицы без ссылки (регистр) определителя нет, и добирать поле нельзя:
	// зависимости от группировки у него тоже нет.
	KeyField = Descriptor.Fields.Get("REF");
	If KeyField = Undefined Then
		KeyField = Descriptor.Fields.Get(Upper("Ссылка"));
	EndIf;
	If KeyField <> Undefined Then
		RegisterDeterminedColumn(Context, Column, Alias + "." + PhysicalName(KeyField, Context));
	EndIf;

EndProcedure

// Разбор пути до владельца последнего поля: псевдоним, переходы по ссылкам и само поле.
// Если последний переход идёт по составной ссылке, он не делается - вместо него
// возвращается признак, и выражение собирается ветвями ВЫБОРа.
// Единственный источник оператора, у которого есть поле с таким именем. Если их
// несколько, 1С сама отвергает запрос как неоднозначный, и до нас он не доходит.
Function SoleSourceWithField(FieldName, Context)

	Wanted = Upper(TrimAll(FieldName));
	Found = "";
	Seen = New Map;

	For Each Item In Context.Aliases Do
		Entry = Item.Value;
		If Seen.Get(Entry.SafeAlias) <> Undefined Then
			Continue;
		EndIf;
		Seen.Insert(Entry.SafeAlias, True);
		If Entry.Descriptor.Fields.Get(Wanted) = Undefined Then
			Continue;
		EndIf;
		If Not IsBlankString(Found) Then
			Return "";
		EndIf;
		Found = Item.Key;
	EndDo;

	Return Found;

EndFunction

Function ResolveField(Path, Context)

	Parts = StrSplit(Path, ".", False);
	If Parts.Count() < 2 Then
		// В условии виртуальной таблицы поле пишется без псевдонима; ВЫРАЗИТЬ и
		// ТИПЗНАЧЕНИЯ приходят сюда именно с таким голым именем.
		If Not IsBlankString(Context.BareAlias) And Context.BareFields.Get(Upper(TrimAll(Path))) <> Undefined Then
			Parts = StrSplit(Context.BareAlias + "." + TrimAll(Path), ".", False);
		Else
			// 1С разрешает поле без псевдонима, если такое имя есть ровно у одного источника.
			Owner = SoleSourceWithField(TrimAll(Path), Context);
			If IsBlankString(Owner) Then
				Raise StrTemplate("Cannot resolve field %1.", Path);
			EndIf;
			Parts = StrSplit(Owner + "." + TrimAll(Path), ".", False);
		EndIf;
	EndIf;

	// Псевдоним может занимать несколько сегментов: у источника без псевдонима
	// это полное имя таблицы. Берём самое длинное совпадение.
	Taken = 0;
	Entry = Undefined;
	Prefix = "";
	MaxPrefix = Parts.Count() - 1;
	If MaxPrefix > 3 Then
		MaxPrefix = 3;
	EndIf;
	Length = MaxPrefix;
	While Length >= 1 Do
		Candidate = "";
		For Index = 0 To Length - 1 Do
			Candidate = Candidate + ?(Index = 0, "", ".") + TrimAll(Parts[Index]);
		EndDo;
		Found = Context.Aliases.Get(Upper(Candidate));
		If Found <> Undefined Then
			Entry = Found;
			Taken = Length;
			Prefix = Candidate;
			Break;
		EndIf;
		Length = Length - 1;
	EndDo;

	If Entry = Undefined And Not IsBlankString(Context.BareAlias)
		And Context.BareFields.Get(Upper(TrimAll(Parts[0]))) <> Undefined Then
		// В условии виртуальной таблицы поля пишутся без псевдонима, в том числе
		// в начале пути: Организация.ВалютаУчета - это путь от поля регистра.
		Entry = Context.Aliases.Get(Upper(Context.BareAlias));
		Taken = 0;
		Prefix = Context.BareAlias;
	EndIf;

	If Entry = Undefined Then
		// Путь может начинаться с поля без псевдонима: Сценарий.Наименование.
		Owner = SoleSourceWithField(TrimAll(Parts[0]), Context);
		If Not IsBlankString(Owner) Then
			Entry = Context.Aliases.Get(Upper(Owner));
			Taken = 0;
			Prefix = Owner;
		EndIf;
	EndIf;

	If Entry = Undefined Then
		Raise StrTemplate("Unknown table alias in %1.", Path);
	EndIf;

	Result = New Structure;
	Result.Insert("Alias", Entry.SafeAlias);
	Result.Insert("Descriptor", Entry.Descriptor);
	Result.Insert("FieldName", TrimAll(Parts[Parts.Count() - 1]));
	Result.Insert("CompositeSegment", "");
	Result.Insert("CompositeTail", New Array);

	// Every segment but the last is a reference. The platform walks such a chain with
	// left joins to the referenced tables, and the same chain is reproduced here.
	For Index = Taken To Parts.Count() - 2 Do
		Segment = TrimAll(Parts[Index]);

		If CompositeInfo(Result.Descriptor, Segment) <> Undefined Then
			// Путь может идти и дальше составной ссылки - платформа это принимает,
			// проверено перебором. Остаток разбирается отдельно в каждой ветке
			// состава: у разных типов одно и то же поле ведёт в разные таблицы.
			Result.CompositeSegment = Segment;
			For Next = Index + 1 To Parts.Count() - 2 Do
				Result.CompositeTail.Add(TrimAll(Parts[Next]));
			EndDo;
			Return Result;
		EndIf;

		Prefix = Prefix + "." + Segment;
		Hop = NavigationHop(Prefix, Result.Descriptor, Result.Alias, Segment, Context);
		Result.Alias = Hop.Alias;
		Result.Descriptor = Hop.Descriptor;
	EndDo;

	Return Result;

EndFunction

Function IsPredefinedFlag(FieldName)

	Normalized = Upper(TrimAll(FieldName));
	Return Normalized = "PREDEFINED" Or Normalized = Upper("Предопределенный")
		Or Normalized = Upper("Предопределённый");

EndFunction

Function PredefinedColumn(Descriptor)

	Column = Descriptor.Fields.Get("PREDEFINEDDATANAME");
	If Column = Undefined Then
		Column = Descriptor.Fields.Get(Upper("ИмяПредопределенныхДанных"));
	EndIf;
	Return Column;

EndFunction

// Описание типов содержит МоментВремени.
Function IsPointInTimeType(Description)

	If Description = Undefined Then
		Return False;
	EndIf;
	Try
		Return Description.ContainsType(Type("PointInTime"));
	Except
		Return False;
	EndTry;

EndFunction

// Колонка производной таблицы (временная таблица, вложенный запрос), у которой модель запроса
// объявила тип МоментВремени.
Function IsPointInTimeColumn(Descriptor, FieldName)

	If Not Descriptor.Property("DeclaredTypes") Or Descriptor.DeclaredTypes = Undefined Then
		Return False;
	EndIf;
	Return IsPointInTimeType(Descriptor.DeclaredTypes.Get(Upper(TrimAll(FieldName))));

EndFunction

// Колонка результата запроса объявлена моментом времени.
Function ColumnIsPointInTime(Query, ColumnIndex)

	Try
		Return IsPointInTimeType(Query.Columns[ColumnIndex].ValueType);
	Except
		Return False;
	EndTry;

EndFunction

// Части МоментВремени по тексту поля: DatePart - дата, TablePart - таблица ссылки, ReferencePart -
// ссылка; TableConstant - таблица известна статически (TableName - её имя). Замеры 20.11.2026, УХ:
// - документ (pfp1): `T1._Date_Time, T1._IDRRef`, в объединении ещё таблица литералом между ними
//   (ptp9: `T1._Date_Time, 0x000002D7, T1._IDRRef`);
// - документ по ссылке одного типа (ptp10): те же колонки присоединённой таблицы -
//   `LEFT OUTER JOIN … T2 …`, `T2._Date_Time, T2._IDRRef`;
// - запись регистра накопления (ptp1, ptp2) и регистра бухгалтерии (ptp14):
//   `T1._Period, T1._RecorderTRef, T1._RecorderRRef`;
// - колонка временной таблицы или вложенного запроса, объявленная моментом времени (ptp7:
//   `_Q_001_F_001_00, _Q_001_F_001_01RRef`): у платформы там дата и ссылка, таблицу она помнит
//   статически (ptp8: `CASE WHEN …RRef IS NOT NULL THEN 0x000002D7 END`); здесь статической памяти
//   нет, поэтому таблица лежит третьей колонкой-спутником. У документа она закрыта той же проверкой
//   ссылки, что у платформы: у строки внешнего соединения без документа дата и ссылка NULL, и
//   таблица без проверки осталась бы литералом - «<>» по такой колонке ВТ стало бы истиной там,
//   где у платформы NULL.
// - параметр со значением МоментВремени (PointInTimeParameterParts), ВЫРАЗИТЬ(…).МоментВремени
//   (CastPointInTimeParts), МоментВремени через составную ссылку (CompositePointInTimeParts).
// Undefined - текст не такой: выражение, параметр без значения МоментВремени, регистр сведений (не замерен),
// виртуальная таблица.
Function PointInTimeParts(Text, Context)

	Path = TrimAll(Text);
	If Left(Path, 1) = "&" Then
		Return PointInTimeParameterParts(Mid(Path, 2), Context);
	EndIf;
	If StrStartsWith(Upper(Path), "CAST") Or StrStartsWith(Upper(Path), Upper("Выразить")) Then
		Return CastPointInTimeParts(Path, Context);
	EndIf;
	If IsBlankString(Path) Or StrFind(Path, "(") > 0 Or StrFind(Path, " ") > 0 Or StrFind(Path, ".") = 0 Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return CompositePointInTimeParts(Resolved, Context);
	EndIf;

	Result = New Structure("DatePart, TablePart, ReferencePart, TableName, TableConstant", "", "", "", "", False);
	// ДвиженияССубконто (замер ppr5, 21.11.2026, УХ): `T1.Period_, T1.RecorderTRef, T1.RecorderRRef` подзапроса - те же
	// период и части регистратора, что у записи регистра; разбираются веткой регистра ниже.
	If Resolved.Descriptor.IsDerived And Not StrEndsWith(Upper(Resolved.Descriptor.LogicalName), ".RECORDS") Then
		If Not IsPointInTimeColumn(Resolved.Descriptor, Resolved.FieldName) Then
			Return Undefined;
		EndIf;
		Stored = Resolved.Descriptor.Fields.Get(Upper(TrimAll(Resolved.FieldName)));
		If Stored = Undefined Then
			Return Undefined;
		EndIf;
		Result.DatePart = Resolved.Alias + "." + QuoteIdentifier(Stored, Context);
		Result.TablePart = Resolved.Alias + "." + QuoteIdentifier(Stored + "_RTRef", Context);
		Result.ReferencePart = Resolved.Alias + "." + QuoteIdentifier(Stored + "_RRRef", Context);
		Return Result;
	EndIf;

	If Not IsPointInTimeField(Resolved.FieldName)
		Or Resolved.Descriptor.Fields.Get(Upper(Resolved.FieldName)) <> Undefined Then
		Return Undefined;
	EndIf;
	Segments = StrSplit(Path, ".", False);
	Segments.Delete(Segments.Count() - 1);
	Prefix = StrConcat(Segments, ".");
	LogicalName = Resolved.Descriptor.LogicalName;

	If IsDocumentLike(LogicalName) Then
		Names = New Array;
		Names.Add("Date");
		Names.Add("Дата");
		DateField = FirstExistingField(Resolved.Descriptor, Names);
		Names = New Array;
		Names.Add("Ref");
		Names.Add("Ссылка");
		RefField = FirstExistingField(Resolved.Descriptor, Names);
		If IsBlankString(DateField) Or IsBlankString(RefField) Then
			Return Undefined;
		EndIf;
		Result.DatePart = ValueExpression(Prefix + "." + DateField, Context);
		Result.ReferencePart = ValueExpression(Prefix + "." + RefField, Context);
		Result.TablePart = "(CASE WHEN " + Result.ReferencePart + " IS NOT NULL THEN "
			+ ReferenceTypeIdLiteral(LogicalName, Context) + " END)";
		Result.TableName = LogicalName;
		Result.TableConstant = True;
		Return Result;
	EndIf;

	// Регистр сведений, подчинённый регистратору (замеры ppr1-ppr3, 21.11.2026, УХ): те же три колонки -
	// `T1._Period, T1._RecorderTRef, T1._RecorderRRef`, порядок и сравнение по ним.
	UpperName = Upper(LogicalName);
	If StrStartsWith(UpperName, "ACCUMULATIONREGISTER.") Or StrStartsWith(UpperName, Upper("РегистрНакопления."))
		Or StrStartsWith(UpperName, "ACCOUNTINGREGISTER.") Or StrStartsWith(UpperName, Upper("РегистрБухгалтерии."))
		Or StrStartsWith(UpperName, "INFORMATIONREGISTER.") Or StrStartsWith(UpperName, Upper("РегистрСведений.")) Then
		Names = New Array;
		Names.Add("Period");
		Names.Add("Период");
		PeriodField = FirstExistingField(Resolved.Descriptor, Names);
		Names = New Array;
		Names.Add("Recorder");
		Names.Add("Регистратор");
		RecorderField = FirstExistingField(Resolved.Descriptor, Names);
		If IsBlankString(PeriodField) Or IsBlankString(RecorderField) Then
			Return Undefined;
		EndIf;
		Info = CompositeInfo(Resolved.Descriptor, RecorderField);
		If Info = Undefined Then
			// Регистратор одного вида (замер ppr11, 21.11.2026, УХ, УстановкаЛимитовПоДаннымБюджетированияСостояния):
			// колонки таблицы у записи нет - `ORDER BY (T1._Period), (T1._RecorderRRef)`; таблица известна статически,
			// как у документа, и закрыта той же проверкой ссылки.
			RecorderTable = "";
			Try
				RecorderTable = ReferencedTableName(LogicalName, RecorderField);
			Except
				Return Undefined;
			EndTry;
			Result.DatePart = ValueExpression(Prefix + "." + PeriodField, Context);
			Result.ReferencePart = ValueExpression(Prefix + "." + RecorderField, Context);
			Result.TablePart = "(CASE WHEN " + Result.ReferencePart + " IS NOT NULL THEN "
				+ ReferenceTypeIdLiteral(RecorderTable, Context) + " END)";
			Result.TableName = RecorderTable;
			Result.TableConstant = True;
			Return Result;
		EndIf;
		If IsBlankString(Info.RefTypeColumn) Or IsBlankString(Info.RefColumn) Then
			Return Undefined;
		EndIf;
		Result.DatePart = ValueExpression(Prefix + "." + PeriodField, Context);
		Result.TablePart = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context);
		Result.ReferencePart = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context);
		Return Result;
	EndIf;

	Return Undefined;

EndFunction

// МоментВремени - значение параметра (SubstituteParameters, значение в ParameterValues). Замер ptp6 (20.11.2026, УХ,
// `Д.МоментВремени <= &М`, `> &М`): дата и ссылка значения идут в SQL параметрами, таблицу ссылки платформа берёт из
// значения - у документа того же вида сравнения таблиц нет. Здесь дата и ссылка - литералы, таблица - литерал вида
// документа ссылки. Undefined - значения нет или оно не МоментВремени: какой это документ, по тексту не узнать.
Function PointInTimeParameterParts(Name, Context)

	ParameterName = TrimAll(Name);
	If Context.Options.Property("OuterPointsInTime") And Context.Options.OuterPointsInTime <> Undefined
		And Context.Options.OuterPointsInTime.Get(ParameterName) <> Undefined Then
		// Заглушка подзапроса вместо МоментВремени внешнего запроса (OuterReferencePlaceholder).
		Return Context.Options.OuterPointsInTime.Get(ParameterName);
	EndIf;
	If IsBlankString(ParameterName) Or StrFind(ParameterName, " ") > 0 Or Not Context.Options.SubstituteParameters Then
		Return Undefined;
	EndIf;
	Value = HierarchyParameterValue(ParameterName, Context);
	If TypeOf(Value) <> Type("PointInTime") Then
		Return Undefined;
	EndIf;
	Target = Undefined;
	If Value.Ref <> Undefined Then
		Target = Metadata.FindByType(TypeOf(Value.Ref));
	EndIf;
	If Target = Undefined Then
		// МоментВремени без ссылки (замер pc07, 21.11.2026, УХ): платформа сравнивает одну дату тем же знаком -
		// `(T1._Date_Time <= <дата> AND (T1._Date_Time < <дата>))`, `T1._Date_Time = <дата>`.
		Parts = New Structure("DatePart, TablePart, ReferencePart, TableName, TableConstant",
			ValueLiteral(Value.Date, Context), "NULL", "NULL", "", False);
		Parts.Insert("DateOnly", True);
		Return Parts;
	EndIf;
	Return New Structure("DatePart, TablePart, ReferencePart, TableName, TableConstant",
		ValueLiteral(Value.Date, Context), ReferenceTypeIdLiteral(Target.FullName(), Context),
		ReferenceLiteral(Value.Ref, Context), Target.FullName(), True);

EndFunction

// МоментВремени после ВЫРАЗИТЬ: `ВЫРАЗИТЬ(Д.ДокументВыдачи КАК Документ.X).МоментВремени`. Замер pfp2 (20.11.2026, УХ):
// дата и ссылка присоединённой таблицы типа - `T2._Date_Time, T2._IDRRef`, таблица известна статически. Соединение -
// то же, что у ВЫРАЗИТЬ(…).Поле (CastTargetHop): у значения другого типа строка не находится, и все части NULL.
// Undefined - текст не такой или тип приведения не документ.
Function CastPointInTimeParts(Path, Context)

	Parsed = SplitCastPath(Path);
	If Parsed = Undefined Or Parsed.Tail.Count() <> 1 Or Not IsPointInTimeField(Parsed.Tail[0]) Then
		Return Undefined;
	EndIf;
	Split = SplitCast(Parsed.Cast);
	If Not IsDocumentLike(TrimAll(Split.TypeText)) Then
		Return Undefined;
	EndIf;
	Hop = CastTargetHop(Split.Expression, Split.TypeText, Context);
	Return JoinedDocumentPointInTimeParts(Hop.Descriptor, Hop.Alias, Context);

EndFunction

// МоментВремени через составную ссылку. Замеры pfp2-pfp5 (20.11.2026, УХ): у каждого типа-документа состава -
// дата присоединённой таблицы ветви, таблица (`CASE WHEN T2._IDRRef IS NOT NULL THEN <таблица> END`) и ссылка, каждая
// ВЫБОРом по типу (`CASE WHEN <тип 1> THEN T2._Date_Time WHEN <тип 2> THEN T3._Date_Time ELSE NULL END`); тип без
// момента времени ветви не получает. Сравнивает (pfp4), упорядочивает и группирует (pfp3) платформа по этим колонкам.
// Undefined - путь глубже одной составной ссылки, составная колонка производной таблицы или ни одного документа в
// составе.
Function CompositePointInTimeParts(Resolved, Context)

	If Not IsPointInTimeField(Resolved.FieldName) Or Resolved.Descriptor.IsDerived Then
		Return Undefined;
	EndIf;
	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined
		And Resolved.CompositeTail.Count() > 0 Then
		Return Undefined;
	EndIf;
	Segment = Resolved.CompositeSegment;
	Info = CompositeInfo(Resolved.Descriptor, Segment);
	Owner = MetadataOf(Resolved.Descriptor.LogicalName);
	If Info = Undefined Or Owner = Undefined Then
		Return Undefined;
	EndIf;
	FieldType = FieldTypeDescription(Owner, Segment);
	If FieldType = Undefined Then
		Return Undefined;
	EndIf;

	Base = New Structure("Alias, FieldName, Descriptor", Resolved.Alias, Segment, Resolved.Descriptor);
	Dates = New Array;
	Tables = New Array;
	References = New Array;
	For Each ItemType In FieldType.Types() Do
		Target = Metadata.FindByType(ItemType);
		If Target = Undefined Or Not IsDocumentLike(Target.FullName()) Then
			Continue;
		EndIf;
		TargetDescriptor = TableDescriptor(Target.FullName());
		TypeTest = CompositeTypeTest(Resolved.Descriptor, Resolved.Alias, Info,
			ReferenceTypeIdLiteral(Target.FullName(), Context), Context);
		Alias = CompositeHop(Base, Info, TargetDescriptor, TypeTest, Context);
		Branch = JoinedDocumentPointInTimeParts(TargetDescriptor, Alias, Context);
		If Branch = Undefined Then
			Continue;
		EndIf;
		Dates.Add("WHEN " + TypeTest + " THEN " + Branch.DatePart);
		Tables.Add("WHEN " + TypeTest + " THEN " + Branch.TablePart);
		References.Add("WHEN " + TypeTest + " THEN " + Branch.ReferencePart);
	EndDo;
	If Dates.Count() = 0 Then
		Return Undefined;
	EndIf;
	Return New Structure("DatePart, TablePart, ReferencePart, TableName, TableConstant",
		"(CASE " + StrConcat(Dates, " ") + " END)", "(CASE " + StrConcat(Tables, " ") + " END)",
		"(CASE " + StrConcat(References, " ") + " END)", "", False);

EndFunction

// Части МоментВремени документа, присоединённого под Alias (после ВЫРАЗИТЬ, ветвь составной ссылки): дата и ссылка -
// колонки этой таблицы, таблица - литерал, закрытый проверкой ссылки: у строки без документа все части NULL, как у
// платформы (pfp2). Колонки взяты через точку - в группировке их добирают так же, как поле ветви (BranchValue).
Function JoinedDocumentPointInTimeParts(Descriptor, Alias, Context)

	Names = New Array;
	Names.Add("Date");
	Names.Add("Дата");
	DateField = FirstExistingField(Descriptor, Names);
	Names = New Array;
	Names.Add("Ref");
	Names.Add("Ссылка");
	RefField = FirstExistingField(Descriptor, Names);
	If IsBlankString(DateField) Or IsBlankString(RefField) Then
		Return Undefined;
	EndIf;
	DateColumn = Alias + "." + PhysicalName(Descriptor.Fields.Get(Upper(DateField)), Context);
	RefColumn = Alias + "." + PhysicalName(Descriptor.Fields.Get(Upper(RefField)), Context);
	If Context.NavigationColumns.Find(DateColumn) = Undefined Then
		Context.NavigationColumns.Add(DateColumn);
	EndIf;
	If Context.NavigationColumns.Find(RefColumn) = Undefined Then
		Context.NavigationColumns.Add(RefColumn);
	EndIf;
	Return New Structure("DatePart, TablePart, ReferencePart, TableName, TableConstant", DateColumn,
		"(CASE WHEN " + RefColumn + " IS NOT NULL THEN " + ReferenceTypeIdLiteral(Descriptor.LogicalName, Context)
		+ " END)", RefColumn, Descriptor.LogicalName, True);

EndFunction

// Колонки МоментВремени, по которым идут порядок и группировка: дата, таблица, ссылка. Таблица,
// известная статически, пропускается: платформа её туда не пишет (pfp1 - `ORDER BY (T1._Date_Time) DESC,
// (T1._IDRRef) DESC`, ptp3 - `GROUP BY T1._Date_Time, T1._IDRRef`), а константу в ORDER BY и GROUP BY
// MS SQL не принимает. У регистра таблица - колонка (ptp1 - `ORDER BY (T1._Period), (T1._RecorderTRef),
// (T1._RecorderRRef)`).
Function PointInTimeKeyColumns(PitParts)

	Columns = New Array;
	Columns.Add(PitParts.DatePart);
	If Not PitParts.TableConstant Then
		Columns.Add(PitParts.TablePart);
	EndIf;
	Columns.Add(PitParts.ReferencePart);
	Return Columns;

EndFunction

// Ключи порядка по МоментВремени. Элемент порядка - поле либо колонка выборки, за которой стоит поле.
// - Один оператор: физические колонки (PointInTimeKeyColumns).
// - Объединение (замер ptp15, 20.11.2026, УХ: `… UNION ALL … ORDER BY 1, 2, 3`): колонка результата и её
//   спутники по именам - дата, таблица, ссылка; таблица здесь у каждой ветви своя.
// - ByNames - порядок идёт во внешнем SELECT над запросом со скрытыми колонками (РАЗЛИЧНЫЕ с
//   представлением, ИЕРАРХИЯ): там видны только имена колонок, и ключи - те же три имени.
// Undefined - не МоментВремени. Поле вне выборки в сгруппированном запросе и под РАЗЛИЧНЫЕ -
// PointInTimeOrderKeysOutsideSelection.
Function PointInTimeOrderKeys(Query, Item, Context, ByNames = False)

	Alias = Undefined;
	Try
		Alias = Item.Alias;
	Except
		Alias = Undefined;
	EndTry;
	If Alias = Undefined And Query.Operators.Count() > 1 Then
		// Элемент порядка объединения, записанный выражением первой ветви.
		Alias = UnionOrderColumn(Query, Item);
	EndIf;
	Text = "";
	ColumnIndex = -1;
	If Alias = Undefined Then
		Text = TrimAll(String(Item));
	Else
		Fields = Query.Operators[0].SelectedFields;
		For Index = 0 To Min(Fields.Count(), Query.Columns.Count()) - 1 Do
			If Upper(TrimAll(Query.Columns[Index].Alias)) = Upper(TrimAll(Alias)) Then
				Text = TrimAll(String(Fields[Index]));
				ColumnIndex = Index;
				Break;
			EndIf;
		EndDo;
	EndIf;
	If Query.Operators.Count() > 1 Or (ByNames And ColumnIndex >= 0) Then
		If ColumnIndex < 0 Or Not ColumnIsPointInTime(Query, ColumnIndex) Then
			Return Undefined;
		EndIf;
		Columns = New Array;
		Columns.Add(QuoteIdentifier(TrimAll(Alias), Context));
		Columns.Add(QuoteIdentifier(TrimAll(Alias) + "_RTRef", Context));
		Columns.Add(QuoteIdentifier(TrimAll(Alias) + "_RRRef", Context));
		Return Columns;
	EndIf;
	If IsBlankString(Text) Then
		Return Undefined;
	EndIf;
	PitParts = PointInTimeParts(Text, Context);
	If PitParts = Undefined Then
		Return Undefined;
	EndIf;
	Operator = Query.Operators[0];
	If Alias = Undefined And (ByNames Or Operator.SelectDistinct Or GroupCount(Operator) > 0
		Or SelectionHasAggregate(Operator)) Then
		Return PointInTimeOrderKeysOutsideSelection(Operator, Text, PitParts, Context, ByNames);
	EndIf;
	Return PointInTimeKeyColumns(PitParts);

EndFunction

// Порядок по МоментВремени, которого нет среди колонок выборки, в сгруппированном запросе и под РАЗЛИЧНЫЕ.
// Замеры mtp1-mtp6 (21.11.2026, УХ): платформа принимает такой порядок, если сгруппирован (под РАЗЛИЧНЫЕ -
// выбран) сам МоментВремени или ссылка, которой он принадлежит, и выводит ключи скрытыми колонками:
// - mtp1 (группировка по ссылке и дате): `… T1._Date_Time, T1._IDRRef … GROUP BY T1._IDRRef, T1._Date_Time,
//   T1._Date_Time, T1._IDRRef ORDER BY 4, 5`; mtp2 (по одной ссылке) - дата дописана в GROUP BY; mtp4 (по
//   самому МоментВремени) - `ORDER BY 3 DESC, 4 DESC` по тем же колонкам;
// - mtp5 (РАЗЛИЧНЫЕ по одной ссылке): `SELECT DISTINCT T1._IDRRef, T1._Date_Time, T1._IDRRef … ORDER BY
//   2 DESC, 3 DESC`.
// Дата документа определена ссылкой, поэтому ни группы, ни строки от добора не меняются. Здесь ключи - те
// же колонки: в группировке они дописываются в GROUP BY (AddGroupColumn, добор после OrderSql), под
// РАЗЛИЧНЫЕ, которое заменено группировкой по выборке (DistinctOrderNeedsGrouping), берутся через MIN - в
// группе у них одно значение. Без ссылки в группировке (выборке) платформа отвергает запрос сама: mtp3
// «Field is not in group», ptp17 «Queries with the РАЗЛИЧНЫЕ clause should have ordering fields in the
// selected data list».
Function PointInTimeOrderKeysOutsideSelection(Operator, Text, PitParts, Context, ByNames)

	If ByNames Then
		Raise StrTemplate(
			"ORDER BY %1 orders by a point in time that is not among the selected columns, in a query that is"
			+ " ordered over hidden columns (HIERARCHY, or the presentation of a reference under SELECT"
			+ " DISTINCT). That combination is not measured and is not translated yet. Select %1 as a column"
			+ " and order by that column.", Text);
	EndIf;
	Grouped = GroupCount(Operator) > 0 Or SelectionHasAggregate(Operator);
	Texts = New Array;
	If Grouped Then
		Texts = GroupTexts(Operator, Context);
	Else
		For Each Field In Operator.SelectedFields Do
			Texts.Add(String(Field));
		EndDo;
	EndIf;
	If Not PointInTimeDetermined(Text, PitParts, Texts) Then
		If Grouped Then
			Raise StrTemplate(
				"ORDER BY %1 orders a grouped query by a point in time, and neither the point in time nor the"
				+ " reference it belongs to is grouped. The platform itself rejects such a query (measured: «Field"
				+ " is not in group»), so there is nothing to translate. Group by %1 or by its reference.", Text);
		EndIf;
		Raise StrTemplate(
			"ORDER BY %1 orders a SELECT DISTINCT by a point in time, and neither the point in time nor the"
			+ " reference it belongs to is selected. The platform itself rejects such a query (measured:"
			+ " «Queries with the РАЗЛИЧНЫЕ clause should have ordering fields in the selected data list»), so"
			+ " there is nothing to translate. Select %1 or its reference.", Text);
	EndIf;
	PitKeys = PointInTimeKeyColumns(PitParts);
	If Grouped Then
		For Each PitKey In PitKeys Do
			AddGroupColumn(Context, PitKey);
		EndDo;
		Return PitKeys;
	EndIf;
	If Not Context.GroupInsteadOfDistinct Then
		Return PitKeys;
	EndIf;
	Wrapped = New Array;
	For Each PitKey In PitKeys Do
		Wrapped.Add("MIN(" + PitKey + ")");
	EndDo;
	Return Wrapped;

EndFunction

// МоментВремени Text определён выражениями Texts (группировки или выборки): среди них он сам, путь ссылки,
// которой он принадлежит (`Т.Ссылка` у `Т.Ссылка.МоментВремени`), или у документа - его Ссылка. У регистра
// МоментВремени - период и регистратор строки, ссылкой он не определён; там только он сам.
Function PointInTimeDetermined(Text, PitParts, Texts)

	Wanted = New Array;
	Wanted.Add(CompactUpper(Text));
	Segments = StrSplit(TrimAll(Text), ".", False);
	If Segments.Count() > 1 Then
		Segments.Delete(Segments.Count() - 1);
		Prefix = StrConcat(Segments, ".");
		If Segments.Count() > 1 Then
			Wanted.Add(CompactUpper(Prefix));
		EndIf;
		If PitParts.TableConstant Then
			Wanted.Add(CompactUpper(Prefix + ".Ref"));
			Wanted.Add(CompactUpper(Prefix + ".Ссылка"));
		EndIf;
	EndIf;
	For Each Item In Texts Do
		If Wanted.Find(CompactUpper(Item)) <> Undefined Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Текст выражения без пробельных символов, в верхнем регистре: сравнение путей, записанных по-разному.
Function CompactUpper(Text)

	Result = StrReplace(Upper(Text), " ", "");
	Result = StrReplace(Result, Chars.Tab, "");
	Result = StrReplace(Result, Chars.LF, "");
	Return StrReplace(Result, Chars.CR, "");

EndFunction

// Сравнение двух моментов времени и проверка на NULL. Замеры 20.11.2026, УХ:
// - «=» (ptp5): `(Д1 = Д2 AND С1 = С2)`; «<>» (ptp5): `((Д1 <> Д2) OR (С1 <> С2))`;
// - порядок (ptp5, ptp8): `(Д1 >= Д2 AND (Д1 > Д2 OR (Д1 = Д2 AND (С1 >= С2))))` - нестрогое сравнение дат,
//   затем строгое либо равенство дат и сравнение ссылок исходным знаком;
// - разные таблицы (pfp4, ptp8): на месте сравнения ссылок - `((Т1 < Т2 OR Т1 = Т2 AND С1 < С2))`; у двух
//   документов разных типов платформа сворачивает его в постоянную (ptp4: `(1=1)`), здесь остаётся
//   сравнение двух литералов таблиц с тем же ответом;
// - ЕСТЬ NULL (ptp11): `((T2._Date_Time) IS NULL)` - по дате;
// - с параметром-МоментВремени (ptp6, pc01-pc05): то же сравнение пары, части параметра - из его значения;
// - МЕЖДУ (pc06): `(<пара> >= <нижняя>) AND (<пара> <= <верхняя>)`.
// Стороны - поле, ВЫРАЗИТЬ(…).МоментВремени или параметр со значением (PointInTimeParts, PointInTimeOperandEnd).
// Параметр без значения - отказ (PointInTimeParameterRefusal): SQL платформы зависит от значения. В не замерено:
// Undefined, и поле отказывает в FieldValue. Index - первый операнд; Consumed - сколько токенов разобрано.
Function PointInTimeComparisonSql(Tokens, Index, Context, Consumed)

	FirstEnd = PointInTimeOperandEnd(Tokens, Index);
	If FirstEnd < 0 Or FirstEnd + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Following = Tokens[FirstEnd + 1];
	Word = Upper(Following.Value);
	If Following.Kind = "Name" And (Word = "IS" Or Word = Upper("Есть")) Then
		NullAt = FirstEnd + 2;
		Negated = Upper(Tokens[NullAt].Value) = "NOT" Or Upper(Tokens[NullAt].Value) = Upper("Не");
		If Negated Then
			NullAt = NullAt + 1;
		EndIf;
		If NullAt > Tokens.Count() - 1 Or Upper(Tokens[NullAt].Value) <> "NULL" Or Not LeftIsBoundary(Tokens, Index) Then
			Return Undefined;
		EndIf;
		Sole = PointInTimeParts(TokensText(Tokens, Index, FirstEnd), Context);
		If Sole = Undefined Then
			Return Undefined;
		EndIf;
		Consumed = NullAt - Index + 1;
		Return "(" + Sole.DatePart + " IS " + ?(Negated, "NOT ", "") + "NULL)";
	EndIf;
	If Following.Kind = "Name" And (Word = "BETWEEN" Or Word = Upper("Между")) Then
		LowEnd = PointInTimeOperandEnd(Tokens, FirstEnd + 2);
		If LowEnd < 0 Or LowEnd + 2 > Tokens.Count() - 1
			Or (Upper(Tokens[LowEnd + 1].Value) <> "AND" And Upper(Tokens[LowEnd + 1].Value) <> Upper("И")) Then
			Return Undefined;
		EndIf;
		HighEnd = PointInTimeOperandEnd(Tokens, LowEnd + 2);
		If HighEnd < 0 Or Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, HighEnd) Then
			Return Undefined;
		EndIf;
		FirstText = TokensText(Tokens, Index, FirstEnd);
		Sole = PointInTimeParts(FirstText, Context);
		If Sole = Undefined Then
			Return Undefined;
		EndIf;
		LowText = TokensText(Tokens, FirstEnd + 2, LowEnd);
		HighText = TokensText(Tokens, LowEnd + 2, HighEnd);
		Low = PointInTimeParts(LowText, Context);
		If Low = Undefined Then
			PointInTimeParameterRefusal(LowText, FirstText, Context);
			Return Undefined;
		EndIf;
		High = PointInTimeParts(HighText, Context);
		If High = Undefined Then
			PointInTimeParameterRefusal(HighText, FirstText, Context);
			Return Undefined;
		EndIf;
		Consumed = HighEnd - Index + 1;
		Return "(" + PointInTimePairComparison(Sole, ">=", Low) + " AND " + PointInTimePairComparison(Sole, "<=", High)
			+ ")";
	EndIf;

	Op = Following.Value;
	SecondEnd = PointInTimeOperandEnd(Tokens, FirstEnd + 2);
	If Following.Kind <> "Symbol" Or (Op <> "=" And Op <> "<>" And Op <> "<" And Op <> ">" And Op <> "<=" And Op <> ">=")
		Or SecondEnd < 0 Or Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, SecondEnd) Then
		Return Undefined;
	EndIf;
	FirstText = TokensText(Tokens, Index, FirstEnd);
	SecondText = TokensText(Tokens, FirstEnd + 2, SecondEnd);
	First = PointInTimeParts(FirstText, Context);
	Second = PointInTimeParts(SecondText, Context);
	If First = Undefined And Second <> Undefined Then
		PointInTimeParameterRefusal(FirstText, SecondText, Context);
	ElsIf Second = Undefined And First <> Undefined Then
		PointInTimeParameterRefusal(SecondText, FirstText, Context);
	EndIf;
	If First = Undefined Or Second = Undefined Then
		Return Undefined;
	EndIf;
	Consumed = SecondEnd - Index + 1;
	Return PointInTimePairComparison(First, Op, Second);

EndFunction

// Конец операнда сравнения моментов времени, начатого токеном Start: поле через точку, параметр или
// ВЫРАЗИТЬ(…).МоментВремени. -1 - операнд не такой.
Function PointInTimeOperandEnd(Tokens, Start)

	If Start > Tokens.Count() - 1 Then
		Return -1;
	EndIf;
	Token = Tokens[Start];
	If Token.Kind = "Parameter" Then
		Return Start;
	EndIf;
	If Token.Kind <> "Name" Then
		Return -1;
	EndIf;
	Word = Upper(Token.Value);
	If Word = "CAST" Or Word = Upper("Выразить") Then
		If Start + 1 > Tokens.Count() - 1 Or Tokens[Start + 1].Value <> "(" Then
			Return -1;
		EndIf;
		Finish = MatchingParen(Tokens, Start + 1);
		If Finish + 2 > Tokens.Count() - 1 Or Tokens[Finish].Value <> ")" Or Tokens[Finish + 1].Value <> "."
			Or Tokens[Finish + 2].Kind <> "Name" Or Not IsPointInTimeField(Tokens[Finish + 2].Value) Then
			Return -1;
		EndIf;
		Return Finish + 2;
	EndIf;
	Return ?(StrFind(Token.Value, ".") > 0, Start, -1);

EndFunction

// Момент времени PointInTimeText сравнивается с параметром OtherText, у которого значения МоментВремени нет. Замер
// ptp6 (20.11.2026, УХ): дату и ссылку значения платформа передаёт параметрами, а таблицу ссылки вписывает в текст
// SQL из значения - без значения того же SQL не построить, это нехватка входа. Значение другого типа платформа в таком
// сравнении отвергает сама (замеры pc08, pc09, 21.11.2026, УХ: дата и Граница - «Wrong parameters of comparison
// operation»). Сторона не параметр - выход без отказа: решает FieldValue.
Procedure PointInTimeParameterRefusal(OtherText, PointInTimeText, Context)

	Other = TrimAll(OtherText);
	If Left(Other, 1) <> "&" Or StrFind(Other, " ") > 0 Then
		Return;
	EndIf;
	Name = Mid(Other, 2);
	Value = Undefined;
	If Context.Options.SubstituteParameters Then
		Value = HierarchyParameterValue(Name, Context);
	EndIf;
	If Value = Undefined Then
		Raise StrTemplate(
			"%1 is compared with parameter %2, a point in time. The platform passes the date and the reference of the"
			+ " value as SQL parameters and writes the table of the reference into the SQL text from the value itself"
			+ " (measured), so without the value that SQL cannot be built. Turn SubstituteParameters on and supply the"
			+ " point in time in ParameterValues under the name %3.", TrimAll(PointInTimeText), Other, Name);
	EndIf;
	Raise StrTemplate(
		"%1 is compared with parameter %2, whose value is of type %3, not a point in time. The platform itself rejects"
		+ " such a comparison (measured for a date and a boundary: «Wrong parameters of comparison operation»), so there"
		+ " is nothing to translate. Pass a point in time (МоментВремени) in ParameterValues.",
		TrimAll(PointInTimeText), Other, String(TypeOf(Value)));

EndProcedure

// Сравнение двух моментов времени, части которых уже построены (PointInTimeParts): замеры - у PointInTimeComparisonSql.
Function PointInTimePairComparison(First, Op, Second)

	If (First.Property("DateOnly") And First.DateOnly) Or (Second.Property("DateOnly") And Second.DateOnly) Then
		Return "(" + First.DatePart + " " + Op + " " + Second.DatePart + ")";
	EndIf;
	SameTable = First.TableConstant And Second.TableConstant And Upper(First.TableName) = Upper(Second.TableName);
	If Op = "=" Then
		Tests = New Array;
		Tests.Add(First.DatePart + " = " + Second.DatePart);
		If Not SameTable Then
			Tests.Add(First.TablePart + " = " + Second.TablePart);
		EndIf;
		Tests.Add(First.ReferencePart + " = " + Second.ReferencePart);
		Return "(" + StrConcat(Tests, " AND ") + ")";
	ElsIf Op = "<>" Then
		Tests = New Array;
		Tests.Add("(" + First.DatePart + " <> " + Second.DatePart + ")");
		If Not SameTable Then
			Tests.Add("(" + First.TablePart + " <> " + Second.TablePart + ")");
		EndIf;
		Tests.Add("(" + First.ReferencePart + " <> " + Second.ReferencePart + ")");
		Return "(" + StrConcat(Tests, " OR ") + ")";
	EndIf;
	Strict = ?(Op = "<" Or Op = "<=", "<", ">");
	Tie = "(" + First.ReferencePart + " " + Op + " " + Second.ReferencePart + ")";
	If Not SameTable Then
		Tie = "((" + First.TablePart + " " + Strict + " " + Second.TablePart + " OR " + First.TablePart + " = "
			+ Second.TablePart + " AND " + First.ReferencePart + " " + Op + " " + Second.ReferencePart + "))";
	EndIf;
	Return "(" + First.DatePart + " " + Strict + "= " + Second.DatePart + " AND (" + First.DatePart + " " + Strict + " "
		+ Second.DatePart + " OR (" + First.DatePart + " = " + Second.DatePart + " AND " + Tie + ")))";

EndFunction

// Текст отказа для МоментВремени там, где одного значения мало, а место набор колонок не строит.
Function PointInTimeRefusal(Path, Resolved)

	Kind = "";
	If Resolved.Descriptor.IsDerived Then
		Kind = "a column of a temporary table or a subquery that holds a point in time";
	ElsIf IsDocumentLike(Resolved.Descriptor.LogicalName) Then
		Kind = "the point in time of a document";
	Else
		Kind = "the point in time of " + Resolved.Descriptor.LogicalName;
	EndIf;
	Return StrTemplate(
		"%1 is %2. A point in time is a pair - the date and the reference - and the platform keeps it in several"
		+ " columns. This translation builds them where the field of a document, of a register or of a temporary"
		+ " table is selected as a column of its own, ordered by, grouped by, compared with another such field or"
		+ " with a parameter holding a point in time, or tested for NULL. Here it stands in a form that is not"
		+ " measured or not built (IN, a function over it, a virtual table other than RecordsWithExtDimensions), and"
		+ " the date alone would answer differently for records of one second. Use the date and the reference"
		+ " explicitly.", TrimAll(Path), Kind);

EndFunction

Function IsPointInTimeField(FieldName)

	Normalized = Upper(TrimAll(FieldName));
	Return Normalized = "POINTINTIME" Or Normalized = Upper("МоментВремени");

EndFunction

Function IsThisNodeField(FieldName)

	Normalized = Upper(TrimAll(FieldName));
	Return Normalized = "THISNODE" Or Normalized = Upper("ЭтотУзел");

EndFunction

Function IsPresentationField(FieldName)

	Normalized = Upper(TrimAll(FieldName));
	Return Normalized = "PRESENTATION" Or Normalized = Upper("Представление");

EndFunction

// От какого значения берётся представление: путь без последнего сегмента, а если там
// остался один псевдоним - ссылка его таблицы.
Function PresentationSourcePath(Path, Context)

	Parts = StrSplit(Path, ".", False);
	Parts.Delete(Parts.Count() - 1);
	Prefix = StrConcat(Parts, ".");
	If Parts.Count() > 1 Then
		Return Prefix;
	EndIf;

	Entry = Context.Aliases.Get(Upper(TrimAll(Prefix)));
	If Entry = Undefined Then
		Return Prefix;
	EndIf;
	Return Prefix + "." + PrimaryKeyName(Entry.Descriptor);

EndFunction

// Measured on a live ERP base 2026-09-16: a group has _Folder = 0x00 while IsFolder is
// True, so the stored column is the negation of what the query language shows.
Function IsFolderField(FieldName)
	Normalized = Upper(TrimAll(FieldName));
	Return Normalized = "ISFOLDER" Or Normalized = Upper("ЭтоГруппа");
EndFunction

Function InvertedBoolean(Column, Context)

	False_ = BooleanLiteral(False, Context);
	True_ = BooleanLiteral(True, Context);
	// Без ИНАЧЕ: у строки внешнего соединения без пары колонка NULL, и значение должно
	// остаться NULL, а не стать ЛОЖЬ. Так пишет и платформа (замер 9463).
	Return "(CASE WHEN " + Column + " = " + False_ + " THEN " + True_
		+ " WHEN NOT (" + Column + " = " + False_ + ") THEN " + False_ + " END)";

EndFunction

Function StorageFieldName(Descriptor, FieldName)

	Physical = Descriptor.Fields.Get(Upper(TrimAll(FieldName)));
	If Physical <> Undefined And Descriptor.Property("Used") And Descriptor.Used <> Undefined Then
		Descriptor.Used.Insert(Upper(Physical), True);
	EndIf;
	If Physical = Undefined Then
		// Обращение к табличной части через точку. Замерено: в списке выборки платформа
		// возвращает вложенную таблицу значений - колонки такого вида в SQL не бывает.
		// В условии то же выражение равносильно проверке существования строки, и это
		// пользователь может переписать сам, явным соединением или подзапросом.
		Owner = MetadataOf(Descriptor.LogicalName);
		Section = Undefined;
		If Owner <> Undefined Then
			Try
				Section = Owner.TabularSections.Find(TrimAll(FieldName));
			Except
				Section = Undefined;
			EndTry;
		EndIf;
		If Section <> Undefined Or IsStandardExtDimensions(Descriptor.LogicalName + "." + FieldName) Then
			Raise StrTemplate(
				"%2.%1 addresses a tabular section through a dot. In the field list the platform"
				+ " returns a nested value table there, and SQL has no column of that kind."
				+ " In a condition it means ""a row of %1 matches"", so rewrite it as an explicit"
				+ " join to %2.%1 or as a subquery, and translate again.",
				TrimAll(FieldName), Descriptor.LogicalName);
		EndIf;
		Raise StrTemplate(
			"Field %1 of table %2 has no physical storage.",
			FieldName, Descriptor.LogicalName);
	EndIf;
	Return Physical;

EndFunction

// One hop of reference navigation. The same prefix is joined once and reused.
Function NavigationHop(Prefix, Descriptor, CurrentAlias, Segment, Context)

	PrefixKey = Upper(Prefix);
	Existing = Context.NavigationAliases.Get(PrefixKey);
	If Existing <> Undefined Then
		Return Existing;
	EndIf;

	ReferenceColumn = StorageFieldName(Descriptor, Segment);

	If Descriptor.IsDerived Then
		Origin = Undefined;
		If Descriptor.Property("ColumnSources") And Descriptor.ColumnSources <> Undefined Then
			Origin = Descriptor.ColumnSources.Get(Upper(TrimAll(Segment)));
		EndIf;
		If Origin = Undefined Then
			// Вычисляемая колонка: тип - тип модели запроса, который её наполнил, если он ссылка одного типа и в
			// выражении нет параметров (тип параметра модель знает только по значению). Платформа переходит по
			// нему же (замер vn1, 21.11.2026, УХ).
			Declared = DeclaredReferenceTable(Descriptor, Segment);
			If IsBlankString(Declared) Or DerivedColumnUsesParameter(Descriptor, Segment) Then
				Raise StrTemplate(
					"Column %2 of temporary table %1 is not a plain field of a source, so its type is unknown and navigation through it is impossible.",
					Descriptor.LogicalName, Segment);
			EndIf;
			Target = TableDescriptor(Declared);
		ElsIf Origin.Property("Type") And Origin.Type <> Undefined Then
			// Поля метаданных за колонкой нет: состав типов пришёл с происхождением.
			Types = Origin.Type.Types();
			TargetMetadata = ?(Types.Count() = 1, Metadata.FindByType(Types[0]), Undefined);
			If TargetMetadata = Undefined Then
				Raise StrTemplate(
					"Column %2 of temporary table %1 keeps %3 types in one column, so navigation through it is impossible. Use ВЫРАЗИТЬ.",
					Descriptor.LogicalName, Segment, Format(Types.Count(), "NG=0; NZ=0"));
			EndIf;
			Target = TableDescriptor(TargetMetadata.FullName());
		Else
			Target = TableDescriptor(ReferencedTableName(Origin.LogicalName, Origin.FieldName));
		EndIf;
		SourceColumn = CurrentAlias + "." + QuoteIdentifier(ReferenceColumn, Context);
	Else
		Target = TableDescriptor(ReferencedTableName(Descriptor.LogicalName, Segment));
		SourceColumn = CurrentAlias + "." + PhysicalName(ReferenceColumn, Context);
	EndIf;

	Context.AliasCounter = Context.AliasCounter + 1;
	Alias = Context.AliasPrefix + Format(Context.AliasCounter, "NG=0");

	Join = New Structure;
	Join.Insert("Alias", Alias);
	Join.Insert("Table", QualifiedTableName(Target.PhysicalName, Context));
	Join.Insert("KeyColumn", PhysicalName(PrimaryKeyColumn(Target), Context));
	Join.Insert("Source", SourceColumn);
	Join.Insert("Extra", "");
	Context.NavigationJoins.Add(Join);

	Hop = New Structure;
	Hop.Insert("Alias", Alias);
	Hop.Insert("Descriptor", Target);
	Context.NavigationAliases.Insert(PrefixKey, Hop);
	Context.HopAliases.Insert(Alias, True);

	Return Hop;

EndFunction

// В выражении колонки производной таблицы есть параметр - в какой-либо ветви. Сведений о выражении нет - тоже Истина.
Function DerivedColumnUsesParameter(Descriptor, FieldName)

	If Not Descriptor.Property("NumericSource") Or Descriptor.NumericSource = Undefined Then
		Return True;
	EndIf;
	Definition = Descriptor.NumericSource.Definition;
	Wanted = Upper(TrimAll(FieldName));
	For Index = 0 To Definition.Columns.Count() - 1 Do
		If Upper(TrimAll(Definition.Columns[Index].Alias)) <> Wanted Then
			Continue;
		EndIf;
		For Each Operator In Definition.Operators Do
			If Index >= BranchFieldCount(Definition, Operator) Then
				Return True;
			EndIf;
			For Each Token In Tokenize(ColumnFieldText(Definition, Operator, Index)) Do
				If Token.Kind = "Parameter" Then
					Return True;
				EndIf;
			EndDo;
		EndDo;
		Return False;
	EndDo;
	Return True;

EndFunction

Function PrimaryKeyName(Descriptor)

	If Descriptor.Fields.Get("REF") <> Undefined Then
		Return "Ref";
	EndIf;
	Return "Ссылка";

EndFunction

Function PrimaryKeyColumn(Descriptor)

	KeyField = Descriptor.Fields.Get("REF");
	If KeyField = Undefined Then
		KeyField = Descriptor.Fields.Get(Upper("Ссылка"));
	EndIf;
	If KeyField = Undefined Then
		Raise StrTemplate("Table %1 has no reference field, navigation to it is impossible.", Descriptor.LogicalName);
	EndIf;
	Return KeyField;

EndFunction

// Which table a reference field points at. Taken from metadata: the storage structure
// knows physical names but not types.
// Объект метаданных таблицы. Табличная часть по полному имени не находится: её ищут
// в коллекции владельца.
// Виды субконто плана счетов - стандартная табличная часть: таблица в базе есть,
// а объекта метаданных у неё нет, FindByFullName возвращает Неопределено даже в полной
// форме с TabularSection. Поэтому владельца отдаём вместо неё: поля такой части
// известны платформе заранее, и разрешаются они по самому плану счетов.
Function IsStandardExtDimensions(Name)

	Upper_ = Upper(TrimAll(Name));
	Return StrEndsWith(Upper_, ".EXTDIMENSIONTYPES")
		Or StrEndsWith(Upper_, "." + Upper("ВидыСубконто"));

EndFunction

Function MetadataOf(TableName)

	Found = Metadata.FindByFullName(TableName);
	If Found <> Undefined Then
		Return Found;
	EndIf;

	Parts = StrSplit(TableName, ".", False);
	If Parts.Count() < 3 Then
		Return Undefined;
	EndIf;

	OwnerName = Parts[0] + "." + Parts[1];
	Owner = Metadata.FindByFullName(OwnerName);
	If Owner = Undefined Then
		Return Undefined;
	EndIf;

	If IsStandardExtDimensions(TableName) Then
		Return Owner;
	EndIf;

	Try
		Found = Owner.TabularSections.Find(Parts[2]);
		If Found <> Undefined Then
			Return Found;
		EndIf;
	Except
		// У объекта нет своих табличных частей - это ещё не значит, что нет стандартных.
	EndTry;

	// Стандартные табличные части лежат в отдельной коллекции: у плана видов расчёта это
	// БазовыеВидыРасчета, ВедущиеВидыРасчета, ВытесняющиеВидыРасчета. Своих табличных
	// частей среди них нет, поэтому прежний поиск их не находил, и запрос отвергался как
	// «объект метаданных не найден» - 7 запросов корпуса УХ. Физическую таблицу структура
	// хранения при этом знает (_CKinds10_BaseCK), не хватало только метаданных, а состав
	// полей у них стандартный - FieldTypeDescription читает StandardAttributes сам.
	// У коллекции стандартных табличных частей, как и у стандартных реквизитов, метода
	// Find нет - её обходят.
	Try
		For Each Standard In Owner.StandardTabularSections Do
			If Upper(Standard.Name) = Upper(TrimAll(Parts[2])) Then
				Return Standard;
			EndIf;
		EndDo;
	Except
		Return Undefined;
	EndTry;
	Return Undefined;

EndFunction

Function ReferencedTableName(TableName, FieldName)

	Owner = MetadataOf(TableName);
	ChangeTable = False;
	If Owner = Undefined Then
		Owner = ChangeTableOwner(TableName);
		ChangeTable = Owner <> Undefined;
	EndIf;
	If Owner = Undefined Then
		Raise StrTemplate("Metadata object %1 not found.", TableName);
	EndIf;

	Special = SpecialReferenceTarget(Owner, FieldName, TableName);
	If Special <> Undefined Then
		Return Special;
	EndIf;

	FieldType = ?(ChangeTable, ChangeTableFieldType(TableName, FieldName), FieldTypeDescription(Owner, FieldName));
	If FieldType = Undefined Then
		Raise StrTemplate(
			"Cannot determine the type of %1.%2, so navigation through it is not supported.", TableName, FieldName);
	EndIf;

	Types = FieldType.Types();
	If Types.Count() = 0 Then
		Raise StrTemplate("Field %1.%2 has no type.", TableName, FieldName);
	ElsIf Types.Count() > 1 Then
		Raise StrTemplate(
			"Field %1.%2 is of a composite type (%3 types). Navigation through composite references comes in a later stage.",
			TableName, FieldName, Format(Types.Count(), "NG=0; NZ=0"));
	EndIf;

	Target = Metadata.FindByType(Types[0]);
	If Target = Undefined Then
		Raise StrTemplate(
			"Field %1.%2 is not a reference, there is nothing to navigate to.", TableName, FieldName);
	EndIf;

	Return Target.FullName();

EndFunction

// Ref, Parent and Owner are standard fields whose type is not spelled out in the
// attribute collections, so they are resolved from the metadata object itself.
// Таблица изменений `X.Изменения` своих метаданных не имеет. Замер sm_ch1, sm_ch2 (21.11.2026, УХ):
// Ссылка - ссылка самого X (`LEFT JOIN _Reference216 T2 ON T1._IDRRef = T2._IDRRef`), Узел - пара
// _NodeTRef/_NodeRRef, а Узел.Поле - CASE по _NodeTRef над планами обмена, у которых поле есть. Прежде
// разыменование отвергалось «Metadata object X.Изменения not found» (УХ ОбновитьНоменклатуруВСервисеИнтеграции,
// ВозможныКоллизииСМобильнымПриложением; ERP WE PossibleCollisionsWithMobileApplication). Undefined - не таблица
// изменений.
Function ChangeTableOwner(TableName)

	Parts = StrSplit(TableName, ".", False);
	If Parts.Count() <> 3 Then
		Return Undefined;
	EndIf;
	Last = Upper(TrimAll(Parts[2]));
	If Last <> "CHANGES" And Last <> Upper("Изменения") Then
		Return Undefined;
	EndIf;
	Return Metadata.FindByFullName(TrimAll(Parts[0]) + "." + TrimAll(Parts[1]));

EndFunction

// Тип поля таблицы изменений: Узел - ссылки планов обмена, в состав которых входит объект (записи
// регистрации есть только у них), прочие поля - поля самого объекта (Ссылка, измерения регистра).
Function ChangeTableFieldType(TableName, FieldName)

	Owner = ChangeTableOwner(TableName);
	If Owner = Undefined Then
		Return Undefined;
	EndIf;
	Normalized = Upper(TrimAll(FieldName));
	If Normalized <> "NODE" And Normalized <> Upper("Узел") Then
		Return FieldTypeDescription(Owner, FieldName);
	EndIf;
	Types = New Array;
	For Each Plan In Metadata.ExchangePlans Do
		If Plan.Content.Contains(Owner) Then
			Types.Add(Type("ExchangePlanRef." + Plan.Name));
		EndIf;
	EndDo;
	Return New TypeDescription(Types);

EndFunction

// Собственное поле объекта метаданных - реквизит, реквизит адресации, измерение или ресурс, - а не
// стандартный реквизит с тем же именем.
Function IsOwnField(Owner, FieldName)

	Name = TrimAll(FieldName);
	Try
		If Owner.Attributes.Find(Name) <> Undefined Then
			Return True;
		EndIf;
	Except
	EndTry;
	Try
		If Owner.AddressingAttributes.Find(Name) <> Undefined Then
			Return True;
		EndIf;
	Except
	EndTry;
	Try
		If Owner.Dimensions.Find(Name) <> Undefined Then
			Return True;
		EndIf;
	Except
	EndTry;
	Try
		If Owner.Resources.Find(Name) <> Undefined Then
			Return True;
		EndIf;
	Except
	EndTry;
	Return False;

EndFunction

Function SpecialReferenceTarget(Owner, FieldName, TableName)

	Normalized = Upper(TrimAll(FieldName));

	// Родитель регистра сведений - его измерение, а не иерархия: ИерархияПартнеров.Родитель.Наименование - это
	// соединение по колонке измерения (замер sm_ip1, 21.11.2026, УХ). Прежде путь вёл на сам регистр - «has no
	// reference field» (УХ КонтрагентыДанныеВыбора, ERP WE CounterpartiesSelectionData).
	If Normalized = "REF" Or Normalized = Upper("Ссылка")
		Or (Normalized = "PARENT" Or Normalized = Upper("Родитель")) And Not IsOwnField(Owner, FieldName) Then
		// У табличной части Ссылка ведёт на владельца, а не на саму себя.
		Parts = StrSplit(TableName, ".", False);
		If Parts.Count() >= 3 Then
			Return Parts[0] + "." + Parts[1];
		EndIf;
		Return TableName;
	EndIf;

	// Счёт регистра бухгалтерии ведёт на его план счетов, в реквизитах его нет.
	If Normalized = "ACCOUNT" Or Normalized = "ACCOUNTDR" Or Normalized = "ACCOUNTCR"
		Or Normalized = Upper("Счет") Or Normalized = Upper("СчетДт") Or Normalized = Upper("СчетКт") Then
		Chart = Undefined;
		Try
			Chart = Owner.ChartOfAccounts;
		Except
			Chart = Undefined;
		EndTry;
		If Chart <> Undefined Then
			Return Chart.FullName();
		EndIf;
	EndIf;

	// Вид субконто ведёт на план видов характеристик, указанный у плана счетов.
	// В реквизитах его нет: у стандартной табличной части ВидыСубконто поля
	// фиксированы платформой, а владельцем здесь выступает сам план счетов.
	If Normalized = "EXTDIMENSIONTYPE" Or Normalized = Upper("ВидСубконто") Then
		Kinds = Undefined;
		Try
			Kinds = Owner.ExtDimensionTypes;
		Except
			Kinds = Undefined;
		EndTry;
		If Kinds <> Undefined Then
			Return Kinds.FullName();
		EndIf;
	EndIf;

	If Normalized <> "OWNER" And Normalized <> Upper("Владелец") Then
		Return Undefined;
	EndIf;

	Owners = Undefined;
	Try
		Owners = Owner.Owners;
	Except
		Owners = Undefined;
	EndTry;

	If Owners = Undefined Or Owners.Count() = 0 Then
		Raise StrTemplate("Table %1 has no owner.", TableName);
	ElsIf Owners.Count() > 1 Then
		Raise StrTemplate(
			"Table %1 has %2 owners, so Owner is a composite reference: that comes in a later stage.",
			TableName, Format(Owners.Count(), "NG=0; NZ=0"));
	EndIf;

	// Metadata collections are walked, not indexed.
	For Each OwnerMetadata In Owners Do
		Return OwnerMetadata.FullName();
	EndDo;

	Raise StrTemplate("Cannot read the owner of %1.", TableName);

EndFunction

Function FieldTypeDescription(Owner, FieldName)

	Try
		Found = Owner.Attributes.Find(FieldName);
		If Found <> Undefined Then
			Return Found.Type;
		EndIf;
	Except
	EndTry;

	// Графа журнала документов своего типа в метаданных не имеет: её значение - реквизит документа из ссылок графы
	// (замер jm1-jm3, 21.11.2026, УХ: Размер - numeric(10, 0) и приведение делимого к NUMERIC(18, 8), Организация и
	// ЗакупочнаяПроцедура - ссылки одного типа, переход - LEFT JOIN к их таблице).
	Found = Undefined;
	Try
		Found = Owner.Columns.Find(FieldName);
	Except
		Found = Undefined;
	EndTry;
	If Found <> Undefined Then
		Return JournalColumnType(Found);
	EndIf;

	// Реквизиты адресации задачи - своя коллекция, в Attributes их нет (УХ: «Cannot determine the
	// composition of Задача.ЗадачаИсполнителя.Исполнитель» у З.Исполнитель.Наименование).
	Try
		Found = Owner.AddressingAttributes.Find(FieldName);
		If Found <> Undefined Then
			Return Found.Type;
		EndIf;
	Except
	EndTry;

	// Коллекция стандартных реквизитов не имеет метода Find, её обходят. Ссылка
	// приходит и английским именем из происхождения колонки (`Ref`), а в русской
	// конфигурации стандартный реквизит зовётся `Ссылка` (УХ: 11 отказов «Cannot
	// determine the composition of Справочник.ДоговорыКонтрагентов.Ref»).
	IsRef = Upper(FieldName) = "REF" Or Upper(FieldName) = Upper("Ссылка");
	Try
		For Each Standard In Owner.StandardAttributes Do
			If Upper(Standard.Name) = Upper(FieldName)
				Or IsRef And (Upper(Standard.Name) = "REF" Or Upper(Standard.Name) = Upper("Ссылка")) Then
				Return Standard.Type;
			EndIf;
		EndDo;
	Except
	EndTry;
	// Ссылка строки табличной части - ссылка её владельца.
	If IsRef Then
		Try
			For Each Standard In Owner.Parent().StandardAttributes Do
				If Upper(Standard.Name) = "REF" Or Upper(Standard.Name) = Upper("Ссылка") Then
					Return Standard.Type;
				EndIf;
			EndDo;
		Except
		EndTry;
	EndIf;

	Try
		Found = Owner.Dimensions.Find(FieldName);
		If Found <> Undefined Then
			Return Found.Type;
		EndIf;
	Except
	EndTry;

	Try
		Found = Owner.Resources.Find(FieldName);
		If Found <> Undefined Then
			Return Found.Type;
		EndIf;
	Except
	EndTry;

	// У константы тип лежит на самом объекте метаданных, отдельного реквизита нет.
	Try
		Return Owner.Type;
	Except
	EndTry;

	// Поле стороны бухгалтерского регистра - `ПодразделениеКт`, `OrganizationDr` - в
	// метаданных лежит измерением без суффикса, тип у сторон один (замер ud_c, 19.11.2026,
	// УХ: ДвиженияССубконто.ПодразделениеКт рядом с НЕОПРЕДЕЛЕНО - тег 0x08 и ссылка
	// СтруктураПредприятия).
	Base = AccountingSideBaseName(Owner, FieldName);
	If Not IsBlankString(Base) Then
		Try
			Found = Owner.Dimensions.Find(Base);
			If Found <> Undefined Then
				Return Found.Type;
			EndIf;
		Except
		EndTry;
	EndIf;

	Return Undefined;

EndFunction

// Тип графы журнала - объединение типов реквизитов из её ссылок. Квалификаторы одного вида у реквизитов разные
// (Число(10, 0) и Число(15, 2)) - Undefined: тип хранения графы для такого случая не замерен.
Function JournalColumnType(Column)

	Types = New Array;
	Numbers = Undefined;
	Strings = Undefined;
	Dates = Undefined;
	Try
		References = Column.References;
	Except
		Return Undefined;
	EndTry;
	For Each Reference In References Do
		Description = Undefined;
		Try
			Description = Reference.Type;
		Except
			Return Undefined;
		EndTry;
		For Each Item In Description.Types() Do
			If Types.Find(Item) = Undefined Then
				Types.Add(Item);
			EndIf;
		EndDo;
		If Description.ContainsType(Type("Number")) Then
			Own = Description.NumberQualifiers;
			If Numbers = Undefined Then
				Numbers = Own;
			ElsIf Numbers.Digits <> Own.Digits Or Numbers.FractionDigits <> Own.FractionDigits
				Or Numbers.AllowedSign <> Own.AllowedSign Then
				Return Undefined;
			EndIf;
		EndIf;
		If Description.ContainsType(Type("String")) Then
			Own = Description.StringQualifiers;
			If Strings = Undefined Then
				Strings = Own;
			ElsIf Strings.Length <> Own.Length Or Strings.AllowedLength <> Own.AllowedLength Then
				Return Undefined;
			EndIf;
		EndIf;
		If Description.ContainsType(Type("Date")) Then
			Own = Description.DateQualifiers;
			If Dates = Undefined Then
				Dates = Own;
			ElsIf Dates.DateFractions <> Own.DateFractions Then
				Return Undefined;
			EndIf;
		EndIf;
	EndDo;
	If Types.Count() = 0 Then
		Return Undefined;
	EndIf;
	Return New TypeDescription(Types, Numbers, Strings, Dates);

EndFunction

// Имя измерения без суффикса стороны, если Owner - бухгалтерский регистр, а FieldName
// кончается на Дт, Кт, Dr или Cr. Пустая строка - иначе.
Function AccountingSideBaseName(Owner, FieldName)

	Accounting = False;
	Try
		Accounting = Metadata.AccountingRegisters.Contains(Owner);
	Except
		Accounting = False;
	EndTry;
	If Not Accounting Or StrLen(FieldName) < 3 Then
		Return "";
	EndIf;
	Suffix = Upper(Right(FieldName, 2));
	If Suffix <> Upper("Дт") And Suffix <> Upper("Кт") And Suffix <> "DR" And Suffix <> "CR" Then
		Return "";
	EndIf;
	Return Left(FieldName, StrLen(FieldName) - 2);

EndFunction

// Functions whose arguments have to be looked at, not just the name substituted.
// Anything else that is followed by a bracket is refused outright: emitting an
// unknown name as a quoted identifier would produce SQL that only looks valid.
Function SpecialFunction(Tokens, Index, Context, Consumed)

	UpperName = Upper(Tokens[Index].Value);
	If Index + 1 >= Tokens.Count() Or Tokens[Index + 1].Value <> "(" Then
		Return Undefined;
	EndIf;

	Kind = FunctionKind(UpperName);
	If Kind = Undefined Then
		Return Undefined;
	EndIf;

	Arguments = CollectArguments(Tokens, Index, Consumed);

	If Kind = "NULLFALLBACK" Then
		Return NullFallback(Arguments, Context, Consumed);
	ElsIf Kind = "AGGREGATEOFVALUE" Then
		Return AggregateOfCondition(UpperName, Arguments, Context, Consumed);
	ElsIf Kind = "DATETIME" Then
		Return DateLiteralFromArguments(RawArguments(Arguments), Context);
	ElsIf Kind = "VALUE" Then
		Return PredefinedValueLiteral(StrReplace(StrConcat(Arguments, ""), " ", ""), Context);
	ElsIf Kind = "YEAR" Then
		CheckDateArgument(Arguments, 0, True, Context);
		Folded = ConstantDatePart(RawArgument(Arguments, 0), "YEAR", Context);
		If Folded <> Undefined Then
			Return Folded;
		EndIf;
		If Context.Options.Dialect = "PostgreSQL" Then
			Return "(YEAR(" + Translated(Arguments, 0, Context) + ") - "
				+ Format(Context.Options.DateOffset, "NG=0; NZ=0") + ")";
		EndIf;
		// Платформа: CAST(DATEPART(YEAR, x) AS NUMERIC(4)) - 2000 - numeric(5, 0) на базе со
		// смещением, numeric(4, 0) без него (16.11.2026, сверка типов; int у YEAR() - другой тип).
		YearPart = "CAST(DATEPART(YEAR, " + Translated(Arguments, 0, Context) + ") AS NUMERIC(4))";
		If Context.Options.DateOffset = 0 Then
			Return YearPart;
		EndIf;
		Return "(" + YearPart + " - " + Format(Context.Options.DateOffset, "NG=0; NZ=0") + ")";
	ElsIf Kind = "DATEPART" Then
		CheckDateArgument(Arguments, 0, True, Context);
		Return DatePartFunction(UpperName, Arguments, Context);
	ElsIf Kind = "BEGINOFPERIOD" Or Kind = "ENDOFPERIOD" Then
		CheckDateArgument(Arguments, 0, False, Context);
		Return PeriodBoundary(Kind, Arguments, Context);
	ElsIf Kind = "DATEDIFF" Then
		If Context.Options.Dialect = "PostgreSQL" Then
			Raise "DATEDIFF is not supported for PostgreSQL yet: MS SQL counts boundary"
				+ " crossings rather than whole units, and a plain interval subtraction"
				+ " gives different numbers. Use the MSSQL dialect, or compute the"
				+ " difference in the reporting tool.";
		EndIf;
		// Платформа пишет CAST(DATEDIFF(...) AS NUMERIC(12)) на всех единицах - тип колонки numeric(12, 0).
		// Секунды и минуты считаются в bigint: у платформы больше int - ошибка 535, а
		// «СУММА(РАЗНОСТЬДАТ(ДАТАВРЕМЯ(2000, 1, 1), Дата, СЕКУНДА))» перевод считать обязан (polish27b).
		CheckDateArgument(Arguments, 0, False, Context);
		CheckDateArgument(Arguments, 1, False, Context);
		Unit = PeriodUnit(RawArgument(Arguments, 2));
		Return "CAST(" + ?(Unit = "second" Or Unit = "minute", "DATEDIFF_BIG(", "DATEDIFF(") + Unit + ", "
			+ Translated(Arguments, 0, Context) + ", " + Translated(Arguments, 1, Context)
			+ ") AS NUMERIC(12))";
	ElsIf Kind = "DATEADD" Then
		CheckDateArgument(Arguments, 0, False, Context);
		// Количество NULL без типа DATEADD не принимает (8116), у 1С результат NULL
		// (негативная батарея 13.11.2026, dt22).
		Amount = Translated(Arguments, 2, Context);
		If Upper(TrimAll(Amount)) = "NULL" Then
			Amount = "CAST(NULL AS INT)";
		EndIf;
		Return DateAddFunction(RawArgument(Arguments, 1), Amount, Translated(Arguments, 0, Context), Context);
	ElsIf Kind = "POW" Then
		// POWER отдаёт тип первого аргумента: POWER(2, 0.5) = 1. В 1С результат дробный и
		// округлён до шести знаков (замер 9474: POW(2, 0.5) = 1.414214, сумма по строкам -
		// сумма округлённых), поэтому степень считается во FLOAT и приводится к шести знакам.
		// Степень от выражения платформа пишет в NUMERIC(38, 8): CAST(POWER(CAST(x AS NUMERIC(38,
		// 8)), y) AS NUMERIC(38, 8)) - замеры 7965-7967. От литерала - как прежде (замер 9474).
		Base = TrimAll(RawArgument(Arguments, 0));
		Exponent = NumberFromText(TrimAll(RawArgument(Arguments, 1)));
		If Context.Options.Dialect <> "PostgreSQL" And NumberFromText(Base) <> Undefined
			And Exponent <> Undefined And NumberFromText(Base) >= 0 Then
			// Степень двух литералов платформа считает сама: СТЕПЕНЬ(2, 0.5) - 1.4142135623731
			// (сверка 16.11.2026), а не шесть знаков FLOAT.
			Return XMLString(Pow(NumberFromText(Base), Exponent));
		EndIf;
		If Context.Options.Dialect <> "PostgreSQL" And NumberFromText(Base) = Undefined Then
			Return "CAST(POWER(CAST(" + Translated(Arguments, 0, Context) + " AS NUMERIC(38, 8)), "
				+ Translated(Arguments, 1, Context) + ") AS NUMERIC(38, 8))";
		EndIf;
		Return "CAST(POWER(CAST(" + Translated(Arguments, 0, Context) + " AS FLOAT), "
			+ Translated(Arguments, 1, Context) + ") AS NUMERIC(38, 6))";
	ElsIf Kind = "AVG" Then
		// СРЕДНЕЕ от целого в T-SQL целое. Платформа пишет единицы ветвей как 1.0 (замер
		// 9472), и среднее выходит с шестью знаками; умножение на 1.0 даёт то же.
		Raw = TrimAll(RawArgument(Arguments, 0));
		Words = StrSplit(Raw, " " + Chars.Tab + Chars.LF + Chars.CR, False);
		Distinct = Words.Count() > 1
			And (Upper(Words[0]) = "DISTINCT" Or Upper(Words[0]) = Upper("Различные"));
		If Distinct Then
			Inner = TrimAll(Mid(Raw, StrLen(Words[0]) + 1));
			Saved = Context.BooleanContext;
			Context.BooleanContext = False;
			Value = TranslateExpression(Inner, Context);
			Context.BooleanContext = Saved;
			Return "AVG(DISTINCT " + ?(AverageKeepsScale(Inner, Context), "", "1.0 * ") + "(" + Value + "))";
		EndIf;
		Return "AVG(" + ?(AverageKeepsScale(Raw, Context), "", "1.0 * ") + "(" + Translated(Arguments, 0, Context) + "))";
	ElsIf Kind = "SUBSTRING" Then
		// Позицию меньше единицы платформа считает единицей и длину не укорачивает:
		// ПОДСТРОКА("Deleted", 0, 3) = "Del", (-2, 4) = "Dele" (замер d34.py). SUBSTRING СУБД
		// отсчитывает длину от нулевой позиции и отдаёт "De" (полная сверка ERP WE,
		// MetadataObjectIDs: 37 строк против 0).
		Start = Translated(Arguments, 1, Context);
		Literal = NumberFromText(StrReplace(StrReplace(StrReplace(Start, "(", ""), ")", ""), " ", ""));
		// Дробную позицию платформа отбрасывает до целого: ПОДСТРОКА("АБВ", 1.5, 1) = "А"
		// (негативная батарея 13.11.2026, ss06).
		If Literal <> Undefined Then
			Start = Format(Max(Int(Literal), 1), "NG=0");
		Else
			Start = "(CASE WHEN " + Start + " < 1 THEN 1 ELSE " + Start + " END)";
		EndIf;
		// Строка NULL без типа: SUBSTRING её не принимает (8116), у 1С - NULL (ss10).
		Value = Translated(Arguments, 0, Context);
		If Upper(TrimAll(Value)) = "NULL" Then
			Value = "CAST(NULL AS " + TextTypeName("(1)", Context) + ")";
		EndIf;
		// Отрицательную длину платформа считает нулём и отдаёт "", SUBSTRING СУБД падает
		// с 536/537 (ss01 ПОДСТРОКА("АБВГД", 2, -1), ss05 длина из поля, ss07 из параметра).
		Length = Translated(Arguments, 2, Context);
		LengthLiteral = NumberFromText(StrReplace(StrReplace(StrReplace(Length, "(", ""), ")", ""), " ", ""));
		If LengthLiteral = Undefined Then
			If Upper(TrimAll(Length)) <> "NULL" Then
				Length = "(CASE WHEN " + Length + " < 0 THEN 0 ELSE " + Length + " END)";
			EndIf;
		ElsIf LengthLiteral < 0 Then
			Length = "0";
		EndIf;
		Return "SUBSTRING(" + Value + ", " + Start + ", " + Length + ")";
	ElsIf Kind = "LENGTH" Then
		// Платформа считает и хвостовые пробелы, LEN их отбрасывает (сверка 13.11.2026, ERP WE:
		// ДЛИНАСТРОКИ("ab  ") 4 против 2, " " 1 против 0; код классификатора банков nchar(9)
		// "ABNA     " - 9 против 4). Приписанный символ держит пробелы внутри строки.
		// DATALENGTH / 2 не годится: строка UUID() собирается в varchar, байт там по одному.
		If Context.Options.Dialect = "PostgreSQL" Then
			Return "LENGTH(" + Translated(Arguments, 0, Context) + ")";
		EndIf;
		Return "(LEN((" + Translated(Arguments, 0, Context) + ") + " + TextLiteral("x", Context)
			+ ") - 1)";
	ElsIf Kind = "TRIMALL" Then
		Return "LTRIM(RTRIM(" + Translated(Arguments, 0, Context) + "))";
	ElsIf Kind = "TRIML" Then
		Return "LTRIM(" + Translated(Arguments, 0, Context) + ")";
	ElsIf Kind = "TRIMR" Then
		Return "RTRIM(" + Translated(Arguments, 0, Context) + ")";
	ElsIf Kind = "TYPE" Then
		Return TypeLiteral(RawArgument(Arguments, 0), Context);
	ElsIf Kind = "VALUETYPE" Then
		Return ValueTypeExpression(Argument(Arguments, 0), Context);
	ElsIf Kind = "CAST" Then
		Return CastExpression(Tokens, Index, Arguments, Consumed, Context);
	ElsIf Kind = "PRESENTATION" Then
		Return PresentationExpression(Argument(Arguments, 0), Context);
	ElsIf Kind = "ROUND" Then
		Return RoundFunction(Arguments, Context);
	ElsIf Kind = "INT" Then
		Return IntFunction(Arguments, Context);
	ElsIf Kind = "STRFIND" Then
		Return StrFindFunction(Arguments, Context);
	ElsIf Kind = "STOREDDATASIZE" Then
		Return StoredDataSizeFunction(Arguments, Context);
	ElsIf Kind = "GROUPEDBY" Then
		Return GroupedByFunction(Arguments, Context);
	ElsIf Kind = "LEFTRIGHT" Then
		Return LeftRightFunction(UpperName, Arguments, Context);
	ElsIf Kind = "STRREPLACE" Then
		Return StrReplaceFunction(Arguments, Context);
	ElsIf Kind = "MATH" Then
		Return MathFunction(UpperName, Arguments, Context);
	ElsIf Kind = "STRINGFUNC" Then
		Return StringFunction(RawArgument(Arguments, 0), Arguments, Context);
	ElsIf Kind = "UUIDFUNC" Then
		Return UuidFunction(Translated(Arguments, 0, Context), Context);
	EndIf;

	Raise StrTemplate("Function %1 is not supported yet.", Tokens[Index].Value);

EndFunction

// УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Ссылка) - идентификатор ссылки строкой. Платформа хранит
// ссылку шестнадцатью байтами с переставленными группами: порядок байт обратный тому,
// в каком группы идут в самом идентификаторе. Обратное преобразование уже есть в
// ReferenceLiteralFromUuid, здесь - прямое, из байт в строку.
//
// Группы идентификатора 8-4-4-4-12 лежат в байтах так:
//   байты  1..4   - четвёртая группа
//   байты  5..16  - пятая
//   байты 17..20  - третья
//   байты 21..24  - вторая
//   байты 25..32  - первая
Function UuidFunction(Value, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Hex = "encode(" + Value + ", 'hex')";
		Piece = "substring(%1 from %2 for %3)";
	Else
		Hex = "LOWER(CONVERT(VARCHAR(32), " + Value + ", 2))";
		Piece = "SUBSTRING(%1, %2, %3)";
	EndIf;

	Parts = New Array;
	Parts.Add(StrTemplate(Piece, Hex, "25", "8"));
	Parts.Add(StrTemplate(Piece, Hex, "21", "4"));
	Parts.Add(StrTemplate(Piece, Hex, "17", "4"));
	Parts.Add(StrTemplate(Piece, Hex, "1", "4"));
	Parts.Add(StrTemplate(Piece, Hex, "5", "12"));

	Glue = ?(Context.Options.Dialect = "PostgreSQL", " || '-' || ", " + '-' + ");
	Return "(" + StrConcat(Parts, Glue) + ")";

EndFunction

// СТРОКА(x) - не приведение типа, а форматирование по региональным установкам. Число
// платформа форматирует в СУБД своей функцией базы dbo.FORMAT_NUMBER (замер str s2, s3,
// 19.11.2026, УХ): `CAST(CASE WHEN x >= 0 THEN dbo.FORMAT_NUMBER(x,3,0,'<разряды>','<дробь>')
// WHEN x < 0 THEN '-' + dbo.FORMAT_NUMBER(ABS(x),…) END AS NVARCHAR(<2 × разрядность 1С>))` -
// Число(15,2) даёт NVARCHAR(30), ГОД(Дата) - 2000 - NVARCHAR(10). От числового литерала
// платформа считает строку сама и шлёт параметром (s1: СТРОКА(100) - '100'). Дата и булево - в
// DateOrBooleanStringFunction; строка - тождество.
Function StringFunction(Raw, Arguments, Context)

	Text = TrimAll(Raw);
	If StrStartsWith(Text, """") Then
		Return Translated(Arguments, 0, Context);
	EndIf;

	Numeric = NumericStringFunction(Text, Arguments, Context);
	If Numeric <> Undefined Then
		Return Numeric;
	EndIf;

	Other = DateOrBooleanStringFunction(Text, Arguments, Context);
	If Other <> Undefined Then
		Return Other;
	EndIf;

	Raise StrTemplate("STRING(%1): the platform writes STRING() in the SQL by the kind of its argument, and"
		+ " its form is measured for a string, a number, a date or boolean field and a literal. For this"
		+ " argument (an expression, a reference or a value of unknown kind) it is not measured, and a plain"
		+ " cast may give different strings. Select the value itself, or CAST(x AS STRING(n)).", Text);

EndFunction

// СТРОКА от даты и булева. Замеры sm_st1-sm_st11 (21.11.2026, УХ), sm_wst1-sm_wst3 (ERP WE): платформа
// форматирует это в СУБД, а не после чтения, и в ГДЕ пишет то же выражение.
// - Булево: `CAST(CASE WHEN x = 0x01 THEN 'Yes' ELSE 'No' END AS NVARCHAR(32))`, слова - String() сеанса.
//   У поля, которое бывает NULL (сторона внешнего соединения, разыменование через точку, колонка ВТ), вместо
//   ELSE стоит `WHEN NOT (x = 0x01) THEN 'No'`, и NULL остаётся NULL (sm_st4, sm_st9, sm_st10).
// - Дата: на УХ (смещение 2000, образец сеанса dd.MM.yyyy H:mm:ss) - `CAST(DATEADD(YEAR,-2000,x) AS
//   NVARCHAR(32))`, то есть «2025-10-01 12:00:00», а не формат сеанса; на ERP WE (без смещения,
//   dd.MM.yyyy HH:mm:ss) - `CAST(CONVERT(NVARCHAR,x,104) + ' ' + CONVERT(NVARCHAR,x,8) AS NVARCHAR(32))`.
//   Иные сочетания не сняты - отказ. Только поле с хранимой датой: от выражения строка зависит от его
//   SQL-типа (КОНЕЦПЕРИОДА у платформы - datetime и «.000» в строке, sm_st11), а перевод пишет выражения
//   дат иначе.
// - Литерал ДАТАВРЕМЯ(...), ИСТИНА, ЛОЖЬ платформа превращает в строку сама и шлёт параметром (sm_st5,
//   sm_wst2: «27.04.2017 15:08:49», «Yes»).
// Undefined - аргумент не такой.
Function DateOrBooleanStringFunction(Text, Arguments, Context)

	Tokens = Tokenize(Text);
	Kind = PrimitiveLiteralTypeName(Tokens);
	If Kind = "Boolean" Then
		Word = Upper(Tokens[0].Value);
		AddSessionStringWarning(Context);
		Return TextLiteral(String(Word = "TRUE" Or Word = Upper("Истина")), Context);
	ElsIf Kind = "Date" Then
		AddSessionStringWarning(Context);
		Return TextLiteral(String(DateLiteralValue(Tokens)), Context);
	EndIf;

	If Tokens.Count() <> 1 Or Tokens[0].Kind <> "Name" Or StrFind(Tokens[0].Value, ".") = 0 Then
		Return Undefined;
	EndIf;
	Path = Tokens[0].Value;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined Then
		Return Undefined;
	EndIf;

	// Строковое поле платформа отдаёт как есть: `СТРОКА(Д.Номер)` - `T1._Number` (sm_st8).
	If StrStartsWith(SqlTypeOfPath(Path, Context), "NVARCHAR") Then
		Return Translated(Arguments, 0, Context);
	EndIf;

	If SqlTypeOfPath(Path, Context) = "BINARY(1)" Then
		Column = Translated(Arguments, 0, Context);
		Test = Column + " = " + BooleanLiteral(True, Context);
		Plain = Not Resolved.Descriptor.IsDerived And StrSplit(Path, ".", False).Count() = 2
			And Context.Property("Operator") And Context.Operator <> Undefined
			And Not NullableSourceAlias(StrSplit(Path, ".", False)[0], Context);
		AddSessionStringWarning(Context);
		Return "CAST(CASE WHEN " + Test + " THEN " + TextLiteral(String(True), Context)
			+ ?(Plain, " ELSE ", " WHEN NOT (" + Test + ") THEN ") + TextLiteral(String(False), Context)
			+ " END AS " + TextTypeName("(32)", Context) + ")";
	EndIf;

	If Resolved.Descriptor.IsDerived Or SqlTypeOfPath(Path, Context, False) <> "DATETIME2" Then
		Return Undefined;
	EndIf;
	Offset = Context.Options.DateOffset;
	Pattern = Context.SessionFormats.DatePattern;
	Column = Translated(Arguments, 0, Context);
	AddSessionStringWarning(Context);
	If Context.Options.Dialect <> "PostgreSQL" And Offset = 2000 And Pattern = "dd.MM.yyyy H:mm:ss" Then
		Return "CAST(DATEADD(YEAR, -2000, " + Column + ") AS " + TextTypeName("(32)", Context) + ")";
	ElsIf Context.Options.Dialect <> "PostgreSQL" And Offset = 0 And Pattern = "dd.MM.yyyy HH:mm:ss" Then
		Return "CAST(CONVERT(NVARCHAR, " + Column + ", 104) + " + TextLiteral(" ", Context)
			+ " + CONVERT(NVARCHAR, " + Column + ", 8) AS " + TextTypeName("(32)", Context) + ")";
	EndIf;
	Raise StrTemplate("STRING(%1) of a date: the platform writes it in the SQL by the date format of the session"
		+ " and the year offset of the infobase, and the form is measured for dd.MM.yyyy H:mm:ss with offset 2000"
		+ " and dd.MM.yyyy HH:mm:ss without offset (MS SQL). This session renders a date as %2 with offset %3,"
		+ " which is not measured.", Text, Context.SessionFormats.DateRendered, Format(Offset, "NG=0; NZ=0"));

EndFunction

// Слова булева и вид даты в СТРОКА() - из сеанса и базы, как у платформы.
Procedure AddSessionStringWarning(Context)

	AddOnce(Context.Warnings, StrTemplate(
		"STRING() of a boolean or a date follows this session, the way the platform writes it: the words %1/%2"
		+ " of the interface language and the date form of this infobase (here %3); a session of another"
		+ " infobase or interface language gives other strings.", String(True), String(False),
		Context.SessionFormats.DateRendered));

EndProcedure

// СТРОКА от числа; Undefined - аргумент не число или форма не выводится.
Function NumericStringFunction(Text, Arguments, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return Undefined;
	EndIf;
	Formats = Context.SessionFormats;
	If Formats.GroupSeparator = "" Or Not Formats.Property("DecimalSeparator")
		Or Formats.DecimalSeparator = "" Then
		Return Undefined;
	EndIf;
	Tokens = Tokenize(Text);
	If Tokens.Count() = 0 Then
		Return Undefined;
	EndIf;

	// Литерал (со знаком): строку считает платформа до SQL.
	Literal = True;
	For Index = 0 To Tokens.Count() - 1 Do
		Token = Tokens[Index];
		If Not (Token.Kind = "Number" Or (Index = 0 And (Token.Value = "-" Or Token.Value = "+"))
			Or Token.Value = ".") Then
			Literal = False;
		EndIf;
	EndDo;
	If Literal Then
		Value = Undefined;
		Try
			Value = Number(StrReplace(Text, " ", ""));
		Except
			Value = Undefined;
		EndTry;
		If Value <> Undefined Then
			AddSessionFormatWarning(Context);
			Return TextLiteral(String(Value), Context);
		EndIf;
	EndIf;

	Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
	If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Or Operand.Whole + Operand.Fraction <= 0 Then
		Return Undefined;
	EndIf;
	Value = "(" + Translated(Arguments, 0, Context) + ")";
	Group = SeparatorText(Formats.GroupSeparator, Context);
	DecimalText = SeparatorText(Formats.DecimalSeparator, Context);
	Template = "dbo.FORMAT_NUMBER(%1, 3, 0, " + Group + ", " + DecimalText + ")";
	AddSessionFormatWarning(Context);
	Return "CAST(CASE WHEN " + Value + " >= 0 THEN " + StrTemplate(Template, Value)
		+ " WHEN " + Value + " < 0 THEN " + TextLiteral("-", Context) + " + "
		+ StrTemplate(Template, "ABS(" + Value + ")") + " END AS "
		+ TextTypeName("(" + Format(2 * (Operand.Whole + Operand.Fraction), "NG=") + ")", Context) + ")";

EndFunction

Procedure AddSessionFormatWarning(Context)

	AddOnce(Context.Warnings, StrTemplate(
		"STRING() of a number follows the regional settings of the infobase - here %1 for 471481544"
		+ " - the way the platform formats it; a session of another infobase may group digits differently.",
		Context.SessionFormats.NumberRendered));

EndProcedure

// Собирает аргументы вызова, сохраняя вложенные скобки.
Function CollectArguments(Tokens, Index, Consumed)

	Arguments = New Array;
	Position = Index + 1;
	Depth = 0;
	Current = New Array;

	While Position < Tokens.Count() Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Depth = Depth + 1;
			If Depth = 1 Then
				Position = Position + 1;
				Continue;
			EndIf;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
			If Depth = 0 Then
				Break;
			EndIf;
		ElsIf Value = "," And Depth = 1 Then
			Arguments.Add(StrConcat(Current, " "));
			Current = New Array;
			Position = Position + 1;
			Continue;
		EndIf;
		// Лексер держит имя параметра без амперсанда; если его не вернуть, повторный
		// разбор аргумента превратит параметр в идентификатор колонки.
		Current.Add(?(Tokens[Position].Kind = "Parameter", "&" + Value, Value));
		Position = Position + 1;
	EndDo;

	If Current.Count() > 0 Then
		Arguments.Add(StrConcat(Current, " "));
	EndIf;

	Consumed = Position - Index;
	Return Arguments;

EndFunction

Function RawArguments(Arguments)

	Result = New Array;
	For Each Item In Arguments Do
		Result.Add(StrReplace(Item, " ", ""));
	EndDo;
	Return Result;

EndFunction

Function RawArgument(Arguments, Index)
	Return ?(Index >= Arguments.Count(), "", StrReplace(Arguments[Index], " ", ""));
EndFunction

// Аргумент как есть. Вырезать пробелы можно только там, где аргумент заведомо путь
// или имя типа: внутри ВЫРАЗИТЬ пробел разделяет выражение и тип, и без него
// «Поле КАК Документ.Х» склеивается в одно бессмысленное имя.
Function Argument(Arguments, Index)
	Return ?(Index >= Arguments.Count(), "", TrimAll(Arguments[Index]));
EndFunction

Function Translated(Arguments, Index, Context)

	If Index >= Arguments.Count() Or IsBlankString(Arguments[Index]) Then
		Raise "A function argument is missing.";
	EndIf;
	// Аргумент функции - значение, а не условие: иначе булево поле обернётся
	// сравнением прямо внутри вызова и SQL станет невалидным.
	Return TranslateValue(Arguments[Index], Context);

EndFunction

// МАКСИМУМ и МИНИМУМ от условия. В 1С это законно - сравнение там значение типа
// Булево. В T-SQL булева типа нет, поэтому платформа оборачивает условие в ВЫБОР,
// причём вторым WHEN, а не ИНАЧЕ: неопределённое условие обязано остаться NULL.
// От всего остального агрегат переводится как раньше, поэтому здесь Undefined.
// ЕСТЬNULL. Оба аргумента - значения, а не условия: в 1С сравнение имеет тип Булево
// и его кладут сюда наравне с числом. В T-SQL булева типа нет, и условие обязано стать
// значением той же формой, что в списке выборки, иначе СУБД не разберёт текст.
// Поле, единственный тип которого - ХранилищеЗначения. Поле производной таблицы - через
// его происхождение.
Function IsValueStorageExpression(Text, Context)

	Trimmed = TrimAll(Text);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return False;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return False;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return False;
	EndIf;
	Origin = OriginOfResolved(Resolved);
	If Origin = Undefined Then
		Return False;
	EndIf;
	Owner = MetadataOf(Origin.LogicalName);
	If Owner = Undefined Then
		Return False;
	EndIf;
	FieldType = FieldTypeDescription(Owner, TrimAll(Origin.FieldName));
	Return FieldType <> Undefined And FieldType.Types().Count() = 1
		And FieldType.ContainsType(Type("ValueStorage"));

EndFunction

Function NullFallback(Arguments, Context, Consumed)

	If Arguments.Count() <> 2 Then
		Consumed = 0;
		Return Undefined;
	EndIf;

	// Перехват только ради условия. У составных полей ЕСТЬNULL разбирается иначе -
	// по подколонкам, - и подменять тот разбор нельзя: ломается всё остальное.
	First = Argument(Arguments, 0);
	Second = Argument(Arguments, 1);

	// Хранилище значения рядом с литералом. Замерено (9451-9455): платформа выводит такую
	// колонку четырьмя частями - тег (0x06 у хранилища, вид литерала у замены), часть вида
	// литерала, двоичная часть и число 0 у хранилища / -1 у замены, - а одной колонкой
	// varbinary(max) с литералом СУБД не связывает. Рядом с НЕОПРЕДЕЛЕНО части строит разбор
	// колонки по ветвям (тег, _B, номер двоичного вида; замер stor_uh g3), здесь - только
	// рядом с литералом другого вида.
	// Колонка уходит частями (SelectedFieldsSql, PartsCarryValue): части строит разбор по ветвям,
	// базовой колонки в SQL нет, и обе проверки ниже ей не нужны.
	Carried = Context.Property("PartsCarryValue") And Context.PartsCarryValue;
	If Not Carried And IsValueStorageExpression(First, Context) And Upper(TrimAll(Second)) <> "NULL"
		And Not IsUndefinedLiteralText(Second)
		And Not IsValueStorageExpression(Second, Context) Then
		Raise StrTemplate(
			"ISNULL(%1, %2) mixes a value storage with a value of another kind. The platform returns"
			+ " it as a column of four parts (kind tag, the part of the substitute's kind, the storage"
			+ " bytes and a marker), and this translation does not build the parts of a value storage.",
			TrimAll(First), TrimAll(Second));
	EndIf;

	// Пустая строка вторым аргументом годится только строке. У ссылки, булева и
	// идентификатора пустое значение своё, и подставить надо его: так делает и платформа.
	Typed = TypedNullFallback(First, Arguments, Context);
	If Typed <> Undefined Then
		Return Typed;
	EndIf;

	If IsUndefinedLiteralText(Second) Then
		Tagged = TagOnlyNullFallback(First, Context);
		If Tagged <> Undefined Then
			Return Tagged;
		EndIf;
	EndIf;

	If Not Carried Then
		CheckNullFallbackKinds(First, Second, Context);
	EndIf;

	// Число и числовой литерал: платформа пишет ISNULL, и результат остаётся в типе первого
	// аргумента (ЕСТЬNULL(НомерСтроки - 1, 0) - numeric(6, 0), ЕСТЬNULL(Курс, 1234567890123) -
	// numeric(10, 4)); COALESCE расширял тип до литерала (замер 16.11.2026, полная сверка типов).
	If Context.Options.Dialect <> "PostgreSQL" And NumberFromText(Second) <> Undefined
		And Not IsConditionExpression(First) And IsNumericFallbackArgument(First, Context)
		And LiteralFitsFirstArgument(First, Second, Context) Then
		Return "ISNULL(" + FallbackFirstArgumentSql(First, Context) + ", " + ValueExpression(Second, Context) + ")";
	EndIf;

	If Not IsConditionExpression(First) And Not IsConditionExpression(Second) Then
		Consumed = 0;
		Return Undefined;
	EndIf;

	Return "COALESCE(" + ValueExpression(First, Context) + ", "
		+ ValueExpression(Second, Context) + ")";

EndFunction

// Первый аргумент ЕСТЬNULL в типе 1С: платформа приводит его к общей разрядности, и у арифметики
// SQL-тип шире типа 1С (НомерСтроки - 1: numeric(11, 0) против Число(6, 0), сверка типов 17.11.2026).
// Только у поля, которое может быть NULL (NullableSourceAlias): у прочих платформа убирает
// ЕСТЬNULL и пишет арифметику как есть, numeric(11, 0) (замер 18.11.2026, ERP WE и УХ).
Function FallbackFirstArgumentSql(First, Context)

	Value = ValueExpression(First, Context);
	Tokens = Tokenize(TrimAll(First));
	If Tokens.Count() = 0 Or Tokens[0].Kind <> "Name"
		Or Not NullableSourceAlias(StrSplit(Tokens[0].Value, ".")[0], Context) Then
		Return Value;
	EndIf;
	Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
	If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Then
		Return Value;
	EndIf;
	Precision = Max(Operand.Whole + Operand.Fraction, 1);
	If Operand.Exact And Operand.Precision = Precision And Operand.Scale = Operand.Fraction Then
		Return Value;
	EndIf;
	Return StrTemplate("CAST(%1 AS NUMERIC(%2, %3))", Value, Format(Precision, "NG=0"),
		Format(Operand.Fraction, "NG=0; NZ=0"));

EndFunction

// Поле источника с этим псевдонимом платформа считает способным быть NULL: источник - временная
// таблица или вложенный запрос (их колонки платформа не проверяет), либо стоит на стороне внешнего
// соединения - присоединён левым или полным, либо ведёт правое или полное.
Function NullableSourceAlias(Alias, Context)

	If Not Context.Property("Operator") Or Context.Operator = Undefined Then
		Return False;
	EndIf;
	Wanted = Upper(TrimAll(Alias));
	For Each Source In Context.Operator.Sources Do
		For Each Item In AliasedSourceTables(Source) Do
			If SourceAlias(Item) = Wanted And (IsNestedQuery(Item) Or Context.Property("TempTables")
				And Context.TempTables <> Undefined
				And Context.TempTables.Get(Upper(TrimAll(Item.TableName))) <> Undefined) Then
				Return True;
			EndIf;
		EndDo;
	EndDo;
	For Each Source In Context.Operator.Sources Do
		Own = SourceAlias(TableOfSource(Source));
		For Each Join In Source.Joins Do
			Kind = Join.JoinType;
			If Kind = QuerySchemaJoinType.Inner Then
				Continue;
			EndIf;
			If SourceAlias(TableOfSource(Join.Source)) = Wanted And Kind <> QuerySchemaJoinType.RightOuter Then
				Return True;
			EndIf;
			If Own = Wanted And Kind <> QuerySchemaJoinType.LeftOuter Then
				Return True;
			EndIf;
		EndDo;
	EndDo;
	Return False;

EndFunction

Function AliasedSourceTables(Source)

	Tables = New Array;
	Tables.Add(TableOfSource(Source));
	For Each Join In Source.Joins Do
		Tables.Add(TableOfSource(Join.Source));
	EndDo;
	Return Tables;

EndFunction

// Первый аргумент ЕСТЬNULL - число: поле или параметр числового типа, либо арифметика,
// которая начинается с такого поля (НомерСтроки - 1). Тип не вывелся - не число.
Function IsNumericFallbackArgument(First, Context)

	SqlType = SqlTypeOfExpression(First, Context);
	If Not IsBlankString(SqlType) Then
		Return SqlTypeKind(SqlType) = "_N";
	EndIf;
	Tokens = Tokenize(TrimAll(First));
	If Tokens.Count() < 3 Or Tokens[0].Kind <> "Name" Or Tokens[1].Kind <> "Symbol"
		Or StrFind("+-*/", Tokens[1].Value) = 0 Then
		Return False;
	EndIf;
	SqlType = SqlTypeOfExpression(Tokens[0].Value, Context);
	Return Not IsBlankString(SqlType) And SqlTypeKind(SqlType) = "_N";

EndFunction

// Литерал помещается в тип первого аргумента ЕСТЬNULL. Платформа убирает ЕСТЬNULL у поля, которое
// не бывает NULL, а у прочих приводит первый аргумент к общей разрядности с литералом
// (ISNULL(CAST(x AS NUMERIC(7, 3)), 1000) у Число(5, 3)). Пока литерал помещается, общая разрядность -
// тип первого аргумента, и ISNULL(x, литерал) совпадает с обоими путями по типу и по значению.
Function LiteralFitsFirstArgument(First, Second, Context)

	Tokens = Tokenize(TrimAll(First));
	If Tokens.Count() = 0 Then
		Return False;
	EndIf;
	Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
	If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Then
		Return False;
	EndIf;
	Literal = NumberFromText(Second);
	If Literal = Undefined Then
		Return False;
	EndIf;
	Literal = ?(Literal < 0, -Literal, Literal);
	Whole = ?(Int(Literal) = 0, 0, StrLen(Format(Int(Literal), "NG=0; NZ=0")));
	Fraction = 0;
	Rest = Literal - Int(Literal);
	While Rest <> Int(Rest) And Fraction < 38 Do
		Rest = Rest * 10;
		Fraction = Fraction + 1;
	EndDo;
	Return Whole <= Operand.Whole And Fraction <= Operand.Fraction;

EndFunction

// ЕСТЬNULL над значениями разных видов - строкой и числом, булевым и числом. У платформы
// результат составной: каждая строка несёт свой вид. ISNULL СУБД приводил второй аргумент к
// типу первого, COALESCE приводит к старшему по типу, и строка не-число падает с ошибкой 245
// или молча становится числом. Частей у такого результата перевод не строит - отказ.
// Пустая строка вторым аргументом остаётся прежней дорогой (TypedNullFallback и неявное
// приведение у даты и числа). Виды берутся только там, где выводятся уверенно.
Procedure CheckNullFallbackKinds(First, Second, Context)

	If IsEmptyTextLiteral(Second) Or Upper(TrimAll(Second)) = "NULL" Then
		Return;
	EndIf;
	FirstType = SqlTypeOfExpression(First, Context);
	SecondType = SqlTypeOfExpression(Second, Context);
	If IsBlankString(FirstType) Or IsBlankString(SecondType) Then
		Return;
	EndIf;
	If SqlTypeKind(FirstType) = SqlTypeKind(SecondType) Then
		Return;
	EndIf;
	Raise StrTemplate("ISNULL(%1, %2) mixes values of different kinds. The platform returns such a"
		+ " value as a composite one, of the kind of whichever argument it came from, and this"
		+ " translation builds a single column that converts one kind into the other. Cast both"
		+ " arguments to one type with CAST.", TrimAll(First), TrimAll(Second));

EndProcedure

// ЕСТЬNULL(x, НЕОПРЕДЕЛЕНО), где x - колонка временной таблицы, в которой нет ничего,
// кроме НЕОПРЕДЕЛЕНО (тег 0x01, замеры 9226, 9241-9243). Значение в такой колонке - тег,
// и после внешнего соединения отсутствие строки платформа тоже отдаёт НЕОПРЕДЕЛЕНО, а
// литерал НЕОПРЕДЕЛЕНО вне частей переводится в NULL: COALESCE(x, NULL) отдавал NULL
// (полная сверка УХ 14.11.2026). Undefined - x не такая колонка.
Function TagOnlyNullFallback(First, Context)

	Trimmed = TrimAll(First);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return Undefined;
	EndIf;
	Column = "";
	Try
		Column = TagOnlyColumnSql(ResolveField(Trimmed, Context), Context);
	Except
		Column = "";
	EndTry;
	If IsBlankString(Column) Then
		Return Undefined;
	EndIf;
	Return "COALESCE(" + Column + ", " + BinaryLiteral("01", Context) + ")";

EndFunction

// ЕСТЬNULL с пустой строкой вторым аргументом над недостроковым первым. В 1С результат
// составного типа (значение либо строка), в SQL колонка одного типа, и пустое значение
// берётся по первому аргументу. Undefined означает «не наш случай», тогда перевод идёт
// обычным путём.
Function TypedNullFallback(First, Arguments, Context)

	If Not IsEmptyTextLiteral(RawArgument(Arguments, 1)) Then
		Return Undefined;
	EndIf;

	Empty = EmptyValueOfExpression(First, Context);
	If IsBlankString(Empty) Then
		Return Undefined;
	EndIf;

	Name = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL");
	Return Name + "(" + ValueExpression(First, Context) + ", " + Empty + ")";

EndFunction

// Литерал пустой строки в тексте запроса - это ровно два символа кавычки.
Function IsEmptyTextLiteral(Text)

	Trimmed = TrimAll(Text);
	Return StrLen(Trimmed) = 2 And Left(Trimmed, 1) = """" And Right(Trimmed, 1) = """";

EndFunction

// Пустое значение того же типа, что у выражения. Пустая строка означает «не знаем» или
// «это строка» - в обоих случаях подменять второй аргумент нельзя.
//
// Дата и число здесь намеренно не названы: у них пустая строка приводится неявно, текст
// связывается и сейчас, и менять работающее значило бы расширить правку за пределы
// отказа.
Function EmptyValueOfExpression(Expression, Context)

	Trimmed = TrimAll(Expression);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return "";
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return "";
	EndTry;

	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;
	// У составного поля ЕСТЬNULL разбирается по подколонкам - в тот разбор не вмешиваемся.
	If CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
		Return "";
	EndIf;

	// Ссылка одного типа. Работает и для колонки временной таблицы: её происхождение
	// описатель помнит, и ReferenceTargetOf читает его сам.
	If ReferenceTargetOf(Resolved) <> Undefined Then
		Return BinaryLiteral("00000000000000000000000000000000", Context);
	EndIf;

	If SqlTypeOfPath(Trimmed, Context, False) = "BINARY(1)" Then
		Return BooleanLiteral(False, Context);
	EndIf;

	// УникальныйИдентификатор лежит теми же шестнадцатью байтами, что и ссылка, но
	// ссылкой не является, и SqlTypeOfPath о нём ничего не говорит.
	If IsUuidField(Resolved) Then
		Return BinaryLiteral("00000000000000000000000000000000", Context);
	EndIf;

	Return "";

EndFunction

Function IsUuidField(Resolved)

	If Resolved.Descriptor = Undefined Or Resolved.Descriptor.IsDerived Then
		Return False;
	EndIf;

	Owner = MetadataOf(Resolved.Descriptor.LogicalName);
	If Owner = Undefined Then
		Return False;
	EndIf;

	FieldType = FieldTypeDescription(Owner, TrimAll(Resolved.FieldName));
	If FieldType = Undefined Then
		Return False;
	EndIf;

	Types = FieldType.Types();
	Return Types.Count() = 1 And Types[0] = Type("UUID");

EndFunction

// ОКР(Число, Разрядность). Замер 17.11.2026 (УХ): платформа пишет CAST(ROUND(x, @P) AS
// NUMERIC(<тип x в 1С>)) - у Число(10, 4) NUMERIC(10, 4), у частного Курс / 3 NUMERIC(14, 8);
// от двух констант считает сама, половина - от нуля (ОКР(-2.5, 0) = -3); третий аргумент
// (режим округления) в запросе не принимает.
Function RoundFunction(Arguments, Context)

	If Arguments.Count() < 1 Or Arguments.Count() > 2 Then
		Raise "ROUND takes the number and the number of fraction digits in a query.";
	EndIf;
	ValueText = Argument(Arguments, 0);
	// Разрядность необязательна, по умолчанию 0 (справка; замер p49x r1, 20.11.2026: ОКР(x) -
	// ROUND(x, @P) в типе аргумента, 714285,714… - 714286).
	DigitsText = ?(Arguments.Count() = 2, Argument(Arguments, 1), "0");
	// Знак у литерала отделён пробелом (- 2.5): константу разбираем без пробелов.
	Constant = NumberFromText(StrReplace(ValueText, " ", ""));
	Digits = NumberFromText(StrReplace(DigitsText, " ", ""));
	If Constant <> Undefined And Digits <> Undefined Then
		// Округлённую константу платформа передаёт параметром - как литерал (numeric(10) у целого).
		Return TranslateValue(XMLString(Round(Constant, Digits)), Context);
	EndIf;
	Rounded = "ROUND(" + Translated(Arguments, 0, Context) + ", "
		+ ?(Arguments.Count() = 2, Translated(Arguments, 1, Context), "0") + ")";
	If Context.Options.Dialect = "PostgreSQL" Then
		Return Rounded;
	EndIf;
	Tokens = Tokenize(TrimAll(ValueText));
	Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
	If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Then
		Raise StrTemplate("ROUND(%1, %2) cannot be translated exactly: %3. The platform casts the rounded"
			+ " value to the type of its argument.", TrimAll(ValueText), TrimAll(DigitsText),
			?(IsBlankString(Operand.Reason), "the argument has no fixed number of digits", Operand.Reason));
	EndIf;
	Return StrTemplate("CAST(%1 AS NUMERIC(%2, %3))", Rounded,
		Format(Operand.Whole + Operand.Fraction, "NG=0"), Format(Operand.Fraction, "NG=0; NZ=0"));

EndFunction

// ЦЕЛ(Число) - целая часть с отбрасыванием дробной к нулю. Замер 18.11.2026 (УХ, пробы fn_uh i1-i5):
// CAST(ROUND(x, @P, 1) AS NUMERIC(<тип x в 1С>)) - у Число(15, 2) NUMERIC(15, 2), у частного
// Сумма / 3 NUMERIC(21, 8); от константы платформа считает сама и передаёт параметром
// (ЦЕЛ(2.75) - 2, ЦЕЛ(-2.75) - -2).
Function IntFunction(Arguments, Context)

	If Arguments.Count() <> 1 Then
		Raise "INT takes one argument: the number.";
	EndIf;
	ValueText = Argument(Arguments, 0);
	Constant = NumberFromText(StrReplace(ValueText, " ", ""));
	If Constant <> Undefined Then
		Return TranslateValue(XMLString(Int(Constant)), Context);
	EndIf;
	If Context.Options.Dialect = "PostgreSQL" Then
		Return "TRUNC(" + Translated(Arguments, 0, Context) + ")";
	EndIf;
	Tokens = Tokenize(TrimAll(ValueText));
	Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
	If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Then
		Raise StrTemplate("INT(%1) cannot be translated exactly: %2. The platform casts the truncated value"
			+ " to the type of its argument.", TrimAll(ValueText),
			?(IsBlankString(Operand.Reason), "the argument has no fixed number of digits", Operand.Reason));
	EndIf;
	Return StrTemplate("CAST(ROUND(%1, 0, 1) AS NUMERIC(%2, %3))", Translated(Arguments, 0, Context),
		Format(Operand.Whole + Operand.Fraction, "NG=0"), Format(Operand.Fraction, "NG=0; NZ=0"));

EndFunction

// СТРНАЙТИ(Строка, Подстрока) - позиция первого вхождения или 0. Замер 18.11.2026 (УХ, fn_uh s1-s3):
// CAST(CHARINDEX(подстрока, строка) AS NUMERIC(12, 0)); пустая подстрока у поля - 0 и у 1С, и у CHARINDEX.
// Регистр сравнивает правило сортировки базы - так же, как у платформы.
// Два литерала платформа считает сама и передаёт результат параметром (замер sf1, sf4, 21.11.2026, УХ):
// без учёта регистра («Абв», «а» - 1), пустая подстрока - 1 (у CHARINDEX было бы 0), пустая строка - 0.
Function StrFindFunction(Arguments, Context)

	If Arguments.Count() <> 2 Then
		Raise "STRFIND takes two arguments in a query: the string and the substring to find.";
	EndIf;
	Haystack = StringLiteralArgument(Arguments[0]);
	Needle = StringLiteralArgument(Arguments[1]);
	If Haystack <> Undefined And Needle <> Undefined Then
		If Needle = "" Then
			Position = 1;
		Else
			Position = StrFind(Upper(Haystack), Upper(Needle));
		EndIf;
		Return "CAST(" + Format(Position, "NG=0; NZ=0") + " AS NUMERIC(12, 0))";
	EndIf;
	Text = Translated(Arguments, 0, Context);
	Sought = Translated(Arguments, 1, Context);
	If Context.Options.Dialect = "PostgreSQL" Then
		Return "CAST(CASE WHEN " + Sought + " = '' THEN 0 ELSE STRPOS(" + Text + ", " + Sought
			+ ") END AS NUMERIC(12, 0))";
	EndIf;
	Return "CAST(CHARINDEX(" + Sought + ", " + Text + ") AS NUMERIC(12, 0))";

EndFunction

// РАЗМЕРХРАНИМЫХДАННЫХ(Значение) - размер хранимого значения в байтах. Замер 18.11.2026 (УХ,
// fn_uh r1-r3): CAST(DATALENGTH(колонка) AS NUMERIC(12, 0)) - и у хранилища, и у строки (у строки -
// байты UTF-16). На PostgreSQL строка хранится в UTF-8, и что пишет там платформа, не замерено.
Function StoredDataSizeFunction(Arguments, Context)

	If Arguments.Count() <> 1 Then
		Raise "STOREDDATASIZE takes one argument: the stored value.";
	EndIf;
	If Context.Options.Dialect = "PostgreSQL" Then
		Raise "STOREDDATASIZE depends on how the DBMS stores the value (a string takes UTF-16 bytes in"
			+ " MS SQL and UTF-8 bytes in PostgreSQL), and the platform's PostgreSQL text for it has not"
			+ " been measured.";
	EndIf;
	Return "CAST(DATALENGTH(" + Translated(Arguments, 0, Context) + ") AS NUMERIC(12, 0))";

EndFunction

// ЛЕВ / ПРАВ (Строка, ЧислоСимволов). Замер 18.11.2026 (УХ, fn2_uh l1-l3, fn3_uh l4): LEFT / RIGHT;
// отрицательную длину платформа обнуляет - CASE WHEN n < 0 THEN 0 ELSE n END (и у литерала), дробный
// литерал отбрасывает до целого (ЛЕВ(х, 2.7) - LEFT(х, 2)).
Function LeftRightFunction(UpperName, Arguments, Context)

	If Arguments.Count() <> 2 Then
		Raise StrTemplate("%1 takes two arguments: the string and the number of characters.", UpperName);
	EndIf;
	Name = ?(UpperName = "LEFT" Or UpperName = Upper("Лев"), "LEFT", "RIGHT");
	Text = Translated(Arguments, 0, Context);
	CountText = Argument(Arguments, 1);
	Literal = NumberFromText(StrReplace(CountText, " ", ""));
	If Literal <> Undefined And Literal >= 0 Then
		Count = Format(Int(Literal), "NG=0; NZ=0");
	Else
		Count = Translated(Arguments, 1, Context);
		If Context.Options.Dialect = "PostgreSQL" Then
			Count = "CAST(TRUNC(" + Count + ") AS INTEGER)";
		EndIf;
		Count = "CASE WHEN " + Count + " < 0 THEN 0 ELSE " + Count + " END";
	EndIf;
	Return Name + "(" + Text + ", " + Count + ")";

EndFunction

// СТРЗАМЕНИТЬ(Строка, Подстрока, Замена). Замер 18.11.2026 (УХ, fn2_uh r1, fn3_uh r2, fn5_uh r3):
// REPLACE; у строки неограниченной длины платформа пишет REPLACE(CONVERT(VARCHAR(MAX), x), ...) -
// символы вне кодовой страницы правила сортировки базы теряются у неё так же. Пустая подстрока -
// строка без изменений и у 1С, и у REPLACE.
Function StrReplaceFunction(Arguments, Context)

	If Arguments.Count() <> 3 Then
		Raise "STRREPLACE takes three arguments: the string, the substring and its replacement.";
	EndIf;
	Text = Translated(Arguments, 0, Context);
	If Context.Options.Dialect <> "PostgreSQL" And UnboundedStringField(Argument(Arguments, 0), Context) Then
		Text = "CONVERT(VARCHAR(MAX), " + Text + ")";
	EndIf;
	Return "REPLACE(" + Text + ", " + Translated(Arguments, 1, Context) + ", "
		+ Translated(Arguments, 2, Context) + ")";

EndFunction

Function UnboundedStringField(Path, Context)

	Exact = True;
	FieldType = NumericFieldType(TrimAll(Path), Context, Exact);
	Return FieldType <> Undefined And FieldType.ContainsType(Type("String"))
		And FieldType.StringQualifiers.Length = 0;

EndFunction

// SIN, COS, TAN, ASIN, ACOS, ATAN, EXP, LOG, LOG10, SQRT. Замер 18.11.2026 (УХ, fn2_uh m1-m4,
// fn6_uh q1-q3): CAST(F(x) AS NUMERIC(38, 9)); у SQRT тип по аргументу - точность на 6 больше, знаков
// на 6 больше, но не больше 9 (Число(15, 2) - (21, 8), Число(10, 4) - (16, 9)). От константы платформа
// считает сама и передаёт параметром с 15 значащими цифрами (EXP(1) - 2.71828182845905).
Function MathFunction(UpperName, Arguments, Context)

	If Arguments.Count() <> 1 Then
		Raise StrTemplate("%1 takes one argument.", UpperName);
	EndIf;
	ValueText = Argument(Arguments, 0);
	Constant = NumberFromText(StrReplace(ValueText, " ", ""));
	If Constant <> Undefined Then
		Return TranslateValue(SignificantText(MathValue(UpperName, Constant), 15), Context);
	EndIf;
	Value = Translated(Arguments, 0, Context);
	If Context.Options.Dialect = "PostgreSQL" Then
		Name = ?(UpperName = "LOG", "LN", ?(UpperName = "LOG10", "LOG", UpperName));
		Return "CAST(" + Name + "(" + Value + ") AS NUMERIC(38, 9))";
	EndIf;
	If UpperName = "SQRT" Then
		Tokens = Tokenize(TrimAll(ValueText));
		Operand = NumericOperand(Tokens, 0, Tokens.Count() - 1, Context);
		If Not IsBlankString(Operand.Reason) Or Operand.Unbounded Then
			Raise StrTemplate("SQRT(%1) cannot be translated exactly: %2. The platform types the root by the"
				+ " digits of its argument.", TrimAll(ValueText),
				?(IsBlankString(Operand.Reason), "the argument has no fixed number of digits", Operand.Reason));
		EndIf;
		Type = SqrtType(Operand);
		Return StrTemplate("CAST(SQRT(%1) AS NUMERIC(%2, %3))", Value, Format(Type.Precision, "NG=0"),
			Format(Type.Scale, "NG=0; NZ=0"));
	EndIf;
	Return "CAST(" + UpperName + "(" + Value + ") AS NUMERIC(38, 9))";

EndFunction

Function SqrtType(Operand)

	Scale = Min(Operand.Fraction + 6, 9);
	Precision = Min(Operand.Whole + Operand.Fraction + 6, 38);
	Return New Structure("Precision, Scale", Precision, Scale);

EndFunction

Function MathValue(UpperName, Value)

	If UpperName = "SIN" Then
		Return Sin(Value);
	ElsIf UpperName = "COS" Then
		Return Cos(Value);
	ElsIf UpperName = "TAN" Then
		Return Tan(Value);
	ElsIf UpperName = "ASIN" Then
		Return ASin(Value);
	ElsIf UpperName = "ACOS" Then
		Return ACos(Value);
	ElsIf UpperName = "ATAN" Then
		Return ATan(Value);
	ElsIf UpperName = "EXP" Then
		Return Exp(Value);
	ElsIf UpperName = "LOG" Then
		Return Log(Value);
	ElsIf UpperName = "LOG10" Then
		Return Log10(Value);
	EndIf;
	Return Sqrt(Value);

EndFunction

// Число текстом с Digits значащими цифрами, без хвостовых нулей: так платформа передаёт значение
// функции от константы (SQRT(2) - 1.4142135623731, EXP(1) - 2.71828182845905).
Function SignificantText(Value, Digits)

	If Value = 0 Then
		Return "0";
	EndIf;
	Magnitude = 0;
	Absolute = ?(Value < 0, -Value, Value);
	While Absolute >= 10 Do
		Absolute = Absolute / 10;
		Magnitude = Magnitude + 1;
	EndDo;
	While Absolute < 1 Do
		Absolute = Absolute * 10;
		Magnitude = Magnitude - 1;
	EndDo;
	Rounded = Round(Value, Max(Digits - 1 - Magnitude, 0));
	Return XMLString(Rounded);

EndFunction

Function AggregateOfCondition(UpperName, Arguments, Context, Consumed)

	If Arguments.Count() <> 1 Then
		Consumed = 0;
		Return Undefined;
	EndIf;

	// Argument, а не RawArgument: тот вырезает пробелы и годится лишь для путей.
	// Без пробелов ВЫБОР КОГДА склеивается в одно имя, и разбор аргумента рушится.
	Argument = Argument(Arguments, 0);
	If Not IsConditionExpression(Argument) Then
		Consumed = 0;
		Return Undefined;
	EndIf;

	Name = ?(UpperName = "MIN" Or UpperName = Upper("Минимум"), "MIN", "MAX");

	Saved = Context.BooleanContext;
	Context.BooleanContext = True;
	Condition = TranslateExpression(Argument, Context);
	Context.BooleanContext = Saved;

	Return Name + "(CASE WHEN (" + Condition + ") THEN " + BooleanLiteral(True, Context)
		+ " WHEN NOT (" + Condition + ") THEN " + BooleanLiteral(False, Context) + " END)";

EndFunction

