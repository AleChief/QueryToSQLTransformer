#Region VirtualTables

// Virtual tables of registers become subqueries over the physical movement table.
// Balances are aggregated from the movements themselves rather than read from the
// totals table: the answer is the same, and it does not depend on how far the totals
// of the target database happen to be calculated.
Function VirtualTableDescriptor(Table, Context)

	Parts = StrSplit(TrimAll(Table.TableName), ".", False);
	If Parts.Count() < 3 Then
		Return Undefined;
	EndIf;

	Kind = VirtualKind(Parts[Parts.Count() - 1]);
	If Kind = Undefined Then
		Kind = CalculationVirtualKind(Parts);
	EndIf;
	If Kind = Undefined Then
		Return Undefined;
	EndIf;

	BaseName = "";
	For Index = 0 To Parts.Count() - 2 Do
		BaseName = BaseName + ?(Index = 0, "", ".") + Parts[Index];
	EndDo;

	Base = TableDescriptor(BaseName);
	Register = Metadata.FindByFullName(BaseName);
	If Register = Undefined Then
		Raise StrTemplate("Register %1 is not found in metadata.", BaseName);
	EndIf;

	If Kind = "TASKSBYPERFORMER" Then
		If Not Metadata.Tasks.Contains(Register) Then
			Return Undefined;
		EndIf;
		Return TasksByPerformerSubquery(BaseName, Base, Register, VirtualArguments(Table),
			TrimAll(Table.TableName), Context);
	EndIf;

	// Замерено (9484-9486, ERP WE): при выключенном использовании итогов платформа не считает
	// остатки и обороты по движениям, а отказывает: «Use of totals disabled» (Остатки, Обороты,
	// ОстаткиИОбороты). Перевод считает по движениям всегда и отдал бы результат там, где 1С
	// выдаёт ошибку, - поэтому настройка базы читается так же, как структура хранения.
	If Kind = "BALANCE" Or Kind = "TURNOVERS" Or Kind = "BALANCEANDTURNOVERS" Then
		TotalsUsed = True;
		Try
			If Metadata.AccumulationRegisters.Contains(Register) Then
				TotalsUsed = AccumulationRegisters[Register.Name].GetTotalsUsing();
			ElsIf Metadata.AccountingRegisters.Contains(Register) Then
				TotalsUsed = AccountingRegisters[Register.Name].GetTotalsUsing();
			EndIf;
		Except
			TotalsUsed = True;
		EndTry;
		If Not TotalsUsed Then
			Raise StrTemplate(
				"Virtual table %1: use of totals is disabled for register %2 in this infobase, and the"
				+ " platform refuses such a query («Use of totals disabled») instead of computing it from"
				+ " the records. Enable the use of totals, or read the register's record table.",
				Table.TableName, BaseName);
		EndIf;
	EndIf;

	Arguments = VirtualArguments(Table);
	NotePeriodParameters(Kind, Arguments, Context);

	If Kind = "BALANCE" Or Kind = "BALANCEANDTURNOVERS" Then
		// The platform fuses a balance virtual table with the outer query and drops
		// zero rows at the final granularity. Here it is a subquery, so after further
		// grouping rows that sum to zero survive where the platform would omit them.
		AddOnce(Context.Warnings,
			"Balances: if you group the result further, add HAVING SUM(<balance>) <> 0 - otherwise rows that add up to zero appear, which 1C would not show.");
	EndIf;

	If IsAccountingRegister(Register) Then
		Return AccountingDescriptor(BaseName, Base, Register, Kind, Arguments, Context);
	EndIf;

	If Kind = "SCHEDULEDATA" Then
		Return ScheduleDataDescriptor(BaseName, Base, Register, Arguments, Context);
	EndIf;

	If Kind = "CALCULATIONBASE" Then
		// Замеры b_all, b_two, b_cut, b_ud (21.11.2026, УХ, Начисления и Удержания): платформа собирает
		// таблицу несколькими операторами через временные таблицы - записи базового регистра с
		// фактическим периодом действия, виды расчёта из базовых видов (_CKinds…_BaseCK), пересчёт
		// ресурса по графику, когда запись базы накрывает базовый период частично
		// (CAST(Fld1882Base_ AS NUMERIC(20, 2)) * SUM(значение графика) / CALEND_). В УХ у всех 12
		// записей регистра вид расчёта без базовых видов, таблица при любых параметрах пуста; в ERP WE
		// регистров расчёта нет. Сверить перевод с платформой не на чем, поэтому его нет.
		Raise StrTemplate(
			"Virtual table %1 is the calculation base of register %2. For every record the platform sums"
			+ " the resources of the base register over the base period of the record (or its actual action"
			+ " period), takes only the records whose calculation type is among the base types of the"
			+ " record's type, and prorates a base record by the schedule when it covers the period only in"
			+ " part; it builds this in several statements through temporary tables. That construction is"
			+ " not translated: in the infobases it was measured on no record has a calculation type with"
			+ " base types, the table returns no rows for any parameters, and a translation could not be"
			+ " checked against the platform.", Table.TableName, BaseName);
	EndIf;

	If Kind = "ACTUALACTIONPERIOD" Then
		Return ActualActionPeriodSubquery(BaseName, Base, Register, Arguments, Context);
	EndIf;

	If Kind = "SLICELAST" Or Kind = "SLICEFIRST" Then
		Return SliceSubquery(BaseName, Base, Register, Arguments, Kind, Context);
	EndIf;

	If Kind = "BALANCE" Or Kind = "TURNOVERS" Or Kind = "BALANCEANDTURNOVERS" Then
		// Платформа группирует виртуальную таблицу по тем измерениям, которые запрошены
		// снаружи, а это известно только когда собран весь запрос. Первый проход даёт
		// состав полей, тело собирается заново из FROM.
		Descriptor = RegisterVirtualBody(BaseName, Base, Register, Kind, Arguments,
			Undefined, Context);
		Plan = New Structure;
		Plan.Insert("BaseName", BaseName);
		Plan.Insert("Base", Base);
		Plan.Insert("Register", Register);
		Plan.Insert("Kind", Kind);
		Plan.Insert("Arguments", Arguments);
		Descriptor.Insert("RegisterPlan", Plan);
		Return Descriptor;
	EndIf;

	Raise StrTemplate("Virtual table %1 is not supported yet.", Table.TableName);

EndFunction

// Сборка тела виртуальной таблицы регистра накопления. Used = Undefined - проход
// только за составом полей: общие табличные выражения этого прохода не нужны, поэтому
// их реестр на время подменяется, а собранный текст выбрасывается.
Function RegisterVirtualBody(BaseName, Base, Register, Kind, Arguments, Used, Context)

	Shape = (Used = Undefined);
	Saved = Undefined;
	If Shape Then
		Saved = Context.TempTables.Get(HierarchyRegistryKey());
		Context.TempTables.Insert(HierarchyRegistryKey(), New Array);
	EndIf;

	Try
		If Kind = "BALANCE" Then
			Descriptor = BalanceSubquery(BaseName, Base, Register, Arguments, Used, Context);
		ElsIf Kind = "TURNOVERS" Then
			Descriptor = TurnoversSubquery(BaseName, Base, Register, Arguments, Used, Context);
		Else
			Descriptor = BalanceAndTurnoversSubquery(BaseName, Base, Register, Arguments,
				Used, Context);
		EndIf;
	Except
		If Shape Then
			Context.TempTables.Insert(HierarchyRegistryKey(), Saved);
		EndIf;
		Raise;
	EndTry;

	If Shape Then
		Context.TempTables.Insert(HierarchyRegistryKey(), Saved);
	EndIf;
	Return Descriptor;

EndFunction

// Измерение остаётся в группировке, только если внешний запрос к нему обращается:
// свёртка остальных меняет не только суммы, но и сам состав строк.
Function NarrowDimensions(Dimensions, Used)

	If Used = Undefined Then
		Return Dimensions;
	EndIf;

	Kept = New Array;
	For Each Dimension In Dimensions Do
		Wanted = Used.Get(Upper(Dimension.Name)) <> Undefined;
		For Each Part In Dimension.Parts Do
			If Used.Get(Upper(PartAlias(Dimension.Name, Part))) <> Undefined Then
				Wanted = True;
			EndIf;
		EndDo;
		If Wanted Then
			Kept.Add(Dimension);
		EndIf;
	EndDo;
	Return Kept;

EndFunction

Function VirtualKind(Name)

	Normalized = Upper(TrimAll(Name));
	If Normalized = "BALANCE" Or Normalized = Upper("Остатки") Then
		Return "BALANCE";
	ElsIf Normalized = "TURNOVERS" Or Normalized = Upper("Обороты") Then
		Return "TURNOVERS";
	ElsIf Normalized = "SLICELAST" Or Normalized = Upper("СрезПоследних") Then
		Return "SLICELAST";
	ElsIf Normalized = "SLICEFIRST" Or Normalized = Upper("СрезПервых") Then
		Return "SLICEFIRST";
	ElsIf Normalized = "BALANCEANDTURNOVERS" Or Normalized = Upper("ОстаткиИОбороты") Then
		Return "BALANCEANDTURNOVERS";
	ElsIf Normalized = "RECORDSWITHEXTDIMENSIONS" Or Normalized = Upper("ДвиженияССубконто") Then
		Return "RECORDS";
	ElsIf Normalized = "DRCRTURNOVERS" Or Normalized = Upper("ОборотыДтКт") Then
		Return "DRCRTURNOVERS";
	ElsIf Normalized = "ACTUALACTIONPERIOD" Or Normalized = Upper("ФактическийПериодДействия") Then
		Return "ACTUALACTIONPERIOD";
	// Английское имя - TasksByExecutive (Task.ЗадачаИсполнителя.TasksByExecutive, 20.11.2026, УХ: 15 строк;
	// TaskByPerformer и в УХ, и в ERP WE - «Table not found»).
	ElsIf Normalized = "TASKSBYEXECUTIVE" Or Normalized = Upper("ЗадачиПоИсполнителю") Then
		Return "TASKSBYPERFORMER";
	EndIf;
	Return Undefined;

EndFunction

// Период виртуальной таблицы - позиционный аргумент, а не сравнение, поэтому
// наблюдатель за сравнениями его не видит. У остатков и срезов дата одна, у оборотов
// и остатков с оборотами - две: начало и конец.
Procedure NotePeriodParameters(Kind, Arguments, Context)

	Count = 0;
	If Kind = "BALANCE" Or Kind = "SLICELAST" Or Kind = "SLICEFIRST" Then
		Count = 1;
	ElsIf Kind = "TURNOVERS" Or Kind = "BALANCEANDTURNOVERS"
		Or Kind = "RECORDS" Or Kind = "DRCRTURNOVERS" Then
		Count = 2;
	EndIf;

	For Index = 0 To Count - 1 Do
		Argument = TrimAll(ArgumentAt(Arguments, Index));
		If StrLen(Argument) < 2 Or Left(Argument, 1) <> "&" Then
			Continue;
		EndIf;
		RememberParameterType(TrimAll(Mid(Argument, 2)), "DATETIME2", Context);
	EndDo;

EndProcedure

// Parameters of a virtual table are positional, an omitted one arrives as empty text.
Function VirtualArguments(Table)

	Arguments = New Array;
	For Each Parameter In Table.Parameters Do
		Text = "";
		Try
			Text = TrimAll(String(Parameter.Expression));
		Except
			Text = "";
		EndTry;
		Arguments.Add(Text);
	EndDo;
	Return Arguments;

EndFunction

Function ArgumentAt(Arguments, Index)
	Return ?(Index >= Arguments.Count(), "", Arguments[Index]);
EndFunction

// A composite dimension occupies three columns, so grouping by it needs separate work.
Function OriginalFieldName(Base, Key)
	Return Base.Names.Get(Key);
EndFunction

Function SingleColumn(Base, Name)

	ColumnList = Base.Columns.Get(Upper(TrimAll(Name)));
	If ColumnList = Undefined Then
		Raise StrTemplate("Field %1 of table %2 has no physical storage.", Name, Base.LogicalName);
	EndIf;
	// A composite field occupies _TYPE, _RTRef and _RRRef. The reference itself lives in
	// the last one, and a uuid is unique across tables, so equality and grouping work on it.
	Return ColumnList[ColumnList.Count() - 1];

EndFunction

// Подколонки составного поля. У односоставного их нет - возвращается пустой массив.
// Составное поле в подзапросе теряет тип, если вынести только колонку ссылки: признак
// типа лежит в соседних колонках. Поэтому они выносятся тоже, под теми же суффиксами.
Procedure AddCompositeColumns(Select, Group, Columns, Item, Context)

	If Item.Parts.Count() = 0 Then
		Return;
	EndIf;

	Names = New Array;
	For Each Part In Item.Parts Do
		Alias = PartAlias(Item.Name, Part);
		Select.Add("      " + VirtualColumn(Part, Context) + " AS " + QuoteIdentifier(Alias, Context));
		Group.Add(VirtualColumn(Part, Context));
		Names.Add(Alias);
	EndDo;
	Columns.Insert(Upper(Item.Name), Names);

EndProcedure

Function CompositeParts(Base, Name)

	Parts = New Array;
	ColumnList = Base.Columns.Get(Upper(TrimAll(Name)));
	If ColumnList = Undefined Or ColumnList.Count() < 2 Then
		Return Parts;
	EndIf;

	HasType = False;
	For Each Column In ColumnList Do
		If StrEndsWith(Upper(Column), "_TYPE") Then
			HasType = True;
		EndIf;
	EndDo;
	If Not HasType Then
		Return Parts;
	EndIf;

	For Each Column In ColumnList Do
		Parts.Add(Column);
	EndDo;
	Return Parts;

EndFunction

// Имя колонки-части в производной таблице: к имени поля добавляется тот же суффикс,
// что и в хранении, поэтому разбор подколонок работает и для подзапроса.
Function PartAlias(Name, Column)

	Upper_ = Upper(Column);
	If StrEndsWith(Upper_, "_TYPE") Then
		Return Name + "_TYPE";
	ElsIf StrEndsWith(Upper_, "_RTREF") Then
		Return Name + "_RTRef";
	ElsIf StrEndsWith(Upper_, "_RRREF") Then
		Return Name + "_RRRef";
	ElsIf StrEndsWith(Upper_, "_L") Then
		Return Name + "_L";
	ElsIf StrEndsWith(Upper_, "_N") Then
		Return Name + "_N";
	ElsIf StrEndsWith(Upper_, "_T") Then
		Return Name + "_T";
	ElsIf StrEndsWith(Upper_, "_S") Then
		Return Name + "_S";
	ElsIf StrEndsWith(Upper_, "TREF") Then
		// Регистратор хранится двумя колонками без тега типа, но роли у них те же:
		// TRef - идентификатор таблицы, RRef - ссылка. Имя по роли, а не по хранению,
		// иначе в результат протекает физическое имя вроде Recorder__RecorderTRef.
		Return Name + "_RTRef";
	ElsIf StrEndsWith(Upper_, "RREF") Then
		Return Name + "_RRRef";
	EndIf;
	// Порядок проверок тот же, что в CompositeInfo: длинный суффикс раньше короткого.
	Return Name + "_" + Column;

EndFunction

// Ссылка на колонку: у таблицы базы - физическое имя, у производной - её псевдоним.
// Поле таблицы обычно колонка, но не всегда: субконто заданного вида - это выражение
// «перебрать слоты хранения, пока не совпадёт вид». Такие поля лежат в Computed
// готовым текстом, и весь разбор составных ссылок работает с ними без изменений.
Function FieldColumn(Descriptor, Alias, Column, Context)

	If Descriptor.Property("Computed") And Descriptor.Computed <> Undefined Then
		Expression = Descriptor.Computed.Get(Upper(TrimAll(Column)));
		If Expression <> Undefined Then
			Return Expression;
		EndIf;
	EndIf;

	Reference = Alias + "." + ?(Descriptor.IsDerived,
		QuoteIdentifier(Column, Context), PhysicalName(Column, Context));
	If Descriptor.IsDerived And Context <> Undefined And Context.Options.Property("PartsOnlyRefs")
		And Descriptor.Fields.Get(Upper(TrimAll(Column))) <> Undefined
		And IsPartsOnlyColumn(Descriptor, Column) Then
		// Обращение запоминается, а не отвергается сразу: разбор обращается к колонке и там,
		// где значение потом не выводится (итоговая колонка частями, пробные проходы). Отказ -
		// только если обращение дошло до текста SQL (PartsOnlyRefusal).
		Context.Options.PartsOnlyRefs.Insert(Reference, Descriptor.LogicalName + "." + Column);
	EndIf;
	Return Reference;

EndFunction

// Колонка из одних частей прочитана целиком: обращение к её базовой колонке дошло до текста
// SQL - в выражении, функции, соединении или сравнении, которое по частям не переводится.
// Значения в базовой колонке нет (заглушка NULL), и ответ был бы молча другим, поэтому отказ.
// Sql - текст одного запроса пакета; пустая строка - чтения мимо частей нет. Excuse - не
// считать чтением заглушки «.[Имя]» за псевдонимом источника этого запроса, у которого колонка
// того же имени обычная (PartsOnlyAliasReads).
Function PartsOnlyRefusal(Sql, Opt, Excuse)

	// Отказ, найденный при проверке ветви объединения по её собственному тексту (QuerySql).
	If Excuse And Opt.Property("PartsOnlyBranchRefusal") And Not IsBlankString(Opt.PartsOnlyBranchRefusal) Then
		Return Opt.PartsOnlyBranchRefusal;
	EndIf;
	Return PartsOnlyScan(Sql, Opt, Excuse);

EndFunction

// Поиск чтения колонки-заглушки в тексте Sql (правила - у PartsOnlyRefusal).
Function PartsOnlyScan(Sql, Opt, Excuse)

	If Not Opt.Property("PartsOnlyStubs") Then
		Return "";
	EndIf;
	// Заглушка базовой колонки читается и там, где обращение к колонке строится мимо
	// FieldColumn. Колонки временных таблиц и подзапросов пишутся в квадратных скобках, поэтому
	// обращение «.[Имя]» к колонке с заглушкой видно по тексту. Колонку того же имени в другой
	// таблице отличает псевдоним перед точкой: его источник записан при сборе источников.
	Reads = New Map;
	If Excuse And Opt.Property("PartsOnlyAliasReads") Then
		Reads = Opt.PartsOnlyAliasReads;
	EndIf;
	Upper_ = Upper(Sql);
	Found = "";
	At = 0;
	For Each Pair In Opt.PartsOnlyStubs Do
		Needle = ".[" + Pair.Key + "]";
		Position = StrFind(Upper_, Needle);
		While Position > 0 And IsBlankString(Found) Do
			If Reads.Get(AliasBefore(Upper_, Position) + Needle) <> True Then
				Found = Pair.Value;
				At = Position;
			EndIf;
			Position = StrFind(Upper_, Needle, , Position + 1);
		EndDo;
	EndDo;

	For Each Pair In Opt.PartsOnlyRefs Do
		Position = StrFind(Sql, Pair.Key);
		While Position > 0 And IsBlankString(Found) Do
			Before = ?(Position = 1, " ", Mid(Sql, Position - 1, 1));
			If StrFind("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_[]", Before) = 0 Then
				Found = Pair.Value;
				At = Position;
			EndIf;
			Position = StrFind(Sql, Pair.Key, , Position + 1);
		EndDo;
	EndDo;
	If IsBlankString(Found) Then
		Return "";
	EndIf;
	// Место чтения - кусок собранного SQL вокруг обращения: по нему видно, какое выражение запроса
	// прочитало колонку целиком (в длинном пакете имя колонки встречается десятки раз).
	Start = Max(1, At - 70);
	Around = StrReplace(StrReplace(StrReplace(Mid(Sql, Start, 170), Chars.LF, " "), Chars.CR, " "), Chars.Tab, " ");
	While StrFind(Around, "  ") > 0 Do
		Around = StrReplace(Around, "  ", " ");
	EndDo;
	Return StrTemplate("Column %1 holds values of different kinds and exists only as its parts,"
		+ " the way the platform stores it. It is read here as one value - in an expression,"
		+ " a function, a join or a comparison that is not translated part by part - and the"
		+ " processor cannot do that exactly. Compare it with a literal, a field or a parameter"
		+ " of one kind, or narrow it with CAST before it is placed into the table."
		+ " The read, in the SQL built so far: ... %2 ...%3", Found, TrimAll(Around),
		?(StrFind(Mid(Sql, At, 100), "@") > 0, " A parameter stands next to the read: if its value is not"
			+ " given, give it (ParameterValues) - the kind of the value decides which part is compared.", ""));

EndFunction

// Псевдоним перед точкой в позиции Position: латинские буквы, цифры и подчёркивание - так
// пишутся псевдонимы источников (T1, TA2 …). Text - в верхнем регистре.
Function AliasBefore(Text, Position)

	Start = Position;
	While Start > 1 And StrFind("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", Mid(Text, Start - 1, 1)) > 0 Do
		Start = Start - 1;
	EndDo;
	Return Mid(Text, Start, Position - Start);

EndFunction

// Чтения колонок, собранные переводом одного запроса пакета: у каждого запроса свои псевдонимы
// источников, и обращение одного запроса к другому не относится.
Procedure ResetPartsOnlyReads(Opt)

	If Opt.Property("PartsOnlyBranchRefusal") Then
		Opt.Insert("PartsOnlyBranchRefusal", "");
	EndIf;
	If Opt.Property("PartsOnlyRefs") Then
		Opt.Insert("PartsOnlyRefs", New Map);
	EndIf;
	If Opt.Property("PartsOnlyAliasReads") Then
		Opt.Insert("PartsOnlyAliasReads", New Map);
	EndIf;

EndProcedure

// Колонки производного источника под его псевдонимом в SQL: обычная (True) или такая, у которой
// базовая колонка может быть заглушкой (False). Обычны колонка без частей, колонка виртуальной
// таблицы (её текст строит не выборка с заглушками) и колонка временной таблицы или подзапроса,
// которой наполнившая их выборка заглушку не ставила (PlacedStubs). Псевдоним, под которым в
// одном запросе стоят и обычная колонка, и колонка с заглушкой, остаётся с заглушкой.
Procedure NotePartsOnlyAliasReads(Alias, Descriptor, Context)

	If Not Descriptor.IsDerived Or Not Context.Options.Property("PartsOnlyAliasReads")
		Or Context.Options.Dialect = "PostgreSQL" Then
		Return;
	EndIf;
	Placed = Descriptor.Property("Purpose") And Descriptor.Purpose = "TemporaryTable";
	Stubs = Undefined;
	If Placed Then
		Stubs = PlacedStubs(Descriptor, Context);
	EndIf;
	Reads = Context.Options.PartsOnlyAliasReads;
	For Each Pair In Descriptor.Fields Do
		Plain = True;
		ColumnList = Descriptor.Columns.Get(Pair.Key);
		If Placed And ColumnList <> Undefined And ColumnList.Count() > 1 Then
			Plain = Stubs <> Undefined And Stubs.Get(Pair.Key) = Undefined;
		EndIf;
		ReadKey = Upper(Alias + ".[" + TrimAll(Pair.Value) + "]");
		If Reads.Get(ReadKey) = False Then
			Continue;
		EndIf;
		Reads.Insert(ReadKey, Plain);
	EndDo;

EndProcedure

Function RegisterColumns(Register, Base, Collection)

	Result = New Array;
	Source = Undefined;
	Try
		Source = ?(Collection = "Dimensions", Register.Dimensions, Register.Resources);
	Except
		Source = Undefined;
	EndTry;
	If Source = Undefined Then
		Return Result;
	EndIf;

	For Each Item In Source Do
		Column = New Structure;
		Column.Insert("Name", Item.Name);
		Column.Insert("Physical", SingleColumn(Base, Item.Name));
		Column.Insert("Parts", CompositeParts(Base, Item.Name));
		Result.Add(Column);
	EndDo;
	Return Result;

EndFunction

Function RecordKindColumn(Base)

	Column = Base.Fields.Get("RECORDTYPE");
	If Column = Undefined Then
		Column = Base.Fields.Get(Upper("ВидДвижения"));
	EndIf;
	Return Column;

EndFunction

Function PeriodColumn(Base)

	Column = Base.Fields.Get("PERIOD");
	If Column = Undefined Then
		Column = Base.Fields.Get(Upper("Период"));
	EndIf;
	Return Column;

EndFunction

Function ActiveCondition(Base, Context)

	Column = Base.Fields.Get("ACTIVE");
	If Column = Undefined Then
		Column = Base.Fields.Get(Upper("Активность"));
	EndIf;
	If Column = Undefined Then
		Return "";
	EndIf;
	Return VirtualColumn(Column, Context) + " = " + BooleanLiteral(True, Context);

EndFunction

// Both language spellings of a virtual field lead to the same output column.
Procedure RegisterAlias(Fields, ResourceName, EnglishSuffix, RussianSuffix, Alias)

	Fields.Insert(Upper(ResourceName + EnglishSuffix), Alias);
	Fields.Insert(Upper(ResourceName + RussianSuffix), Alias);

EndProcedure

// Регистратор виртуальной таблицы - поле регистра, его состав типов есть в метаданных.
// Состав типов регистратора ищут по имени поля в метаданных регистра, а имя там
// на языке конфигурации: Recorder на английской, Регистратор на русской.
Function RecorderFieldName(BaseName)

	Base = TableDescriptor(BaseName);
	Keys = New Array;
	Keys.Add("RECORDER");
	Keys.Add(Upper("Регистратор"));
	For Each Item In Keys Do
		If Base.Fields.Get(Item) <> Undefined Then
			Name = OriginalFieldName(Base, Item);
			If Not IsBlankString(Name) Then
				Return Name;
			EndIf;
		EndIf;
	EndDo;
	Return "Recorder";

EndFunction

Procedure RegisterRecorderSource(Descriptor, BaseName, Detail)

	If Detail.Parts.Get("RECORDER") = Undefined Then
		Return;
	EndIf;

	Origin = New Structure;
	Origin.Insert("LogicalName", BaseName);
	Origin.Insert("FieldName", RecorderFieldName(BaseName));
	Descriptor.ColumnSources.Insert("RECORDER", Origin);
	Descriptor.ColumnSources.Insert(Upper("Регистратор"), Origin);

EndProcedure

// Колонки виртуальной таблицы, по которым можно идти дальше через точку: измерения и
// ресурсы регистра. Их типы берутся из метаданных самого регистра.
Procedure RegisterColumnSources(Descriptor, BaseName, Dimensions, Resources = Undefined)

	Collections = New Array;
	Collections.Add(Dimensions);
	If Resources <> Undefined Then
		Collections.Add(Resources);
	EndIf;

	For Each Collection In Collections Do
		For Each Item In Collection Do
			Entry = New Structure;
			Entry.Insert("LogicalName", BaseName);
			Entry.Insert("FieldName", Item.Name);
			Descriptor.ColumnSources.Insert(Upper(Item.Name), Entry);
		EndDo;
	EndDo;

EndProcedure

// Разрядность ресурса виртуальной таблицы по типу 1С: платформа пишет его как CAST(SUM(...) AS
// NUMERIC(...)), у остатка - на 12 целых шире ресурса, у оборота - на 6 (Число(15, 2) - NUMERIC(27, 2)
// и NUMERIC(21, 2), Число(15, 3) в остатке - NUMERIC(27, 3); замеры 7890-7893, 7916-7918).
Procedure RegisterAggregatedResources(Descriptor, Register, Suffix, AlternativeSuffix, Widening,
	FixedWhole = Undefined, Variant = "")

	Digits = New Map;
	Resources = New Array;
	Try
		Resources = Register.Resources;
	Except
		Resources = New Array;
	EndTry;
	For Each Resource In Resources Do
		Types = Resource.Type.Types();
		If Types.Count() <> 1 Or Types[0] <> Type("Number") Or Resource.Type.NumberQualifiers.Digits = 0 Then
			Continue;
		EndIf;
		Fraction = Resource.Type.NumberQualifiers.FractionDigits;
		Whole = Resource.Type.NumberQualifiers.Digits - Fraction + Widening;
		If FixedWhole <> Undefined Then
			// Начальный остаток без начала периода платформа собирает из литерала: Число(7, 0),
			// NUMERIC(7, 0) в SQL (частное от него - CAST(... AS NUMERIC(15, 8)), замер 44521).
			Whole = FixedWhole;
			Fraction = 0;
		EndIf;
		Capped = CappedDigits(Whole, Fraction);
		Entry = New Structure("Whole, Fraction", Capped.Whole, Capped.Fraction);
		If Not IsBlankString(Variant) Then
			// Другая форма той же колонки - её выбирает AggregatedResourceOperand по составу полей.
			Main = Undefined;
			If Descriptor.Property("AggregatedResources") Then
				Main = Descriptor.AggregatedResources.Get(Upper(Resource.Name + Suffix));
			EndIf;
			If Main <> Undefined Then
				Main.Insert(Variant, Entry);
			EndIf;
			Continue;
		EndIf;
		Digits.Insert(Upper(Resource.Name + Suffix), Entry);
		Digits.Insert(Upper(Resource.Name + AlternativeSuffix), Entry);
	EndDo;
	If Not IsBlankString(Variant) Then
		Return;
	EndIf;
	If Descriptor.Property("AggregatedResources") Then
		For Each Item In Digits Do
			Descriptor.AggregatedResources.Insert(Item.Key, Item.Value);
		EndDo;
	Else
		Descriptor.Insert("AggregatedResources", Digits);
	EndIf;

EndProcedure

// Имена всех измерений регистра - для VirtualFieldsReferenced(..., "DimensionNames", ...).
Procedure RegisterDimensionNames(Descriptor, Dimensions)

	Names = New Map;
	For Each Dimension In Dimensions Do
		Names.Insert(Upper(Dimension.Name), True);
	EndDo;
	Descriptor.Insert("DimensionNames", Names);

EndProcedure

Function DerivedDescriptor(LogicalName, Fields, Subquery)

	Descriptor = New Structure;
	Descriptor.Insert("LogicalName", LogicalName);
	Descriptor.Insert("PhysicalName", LogicalName);
	Descriptor.Insert("Purpose", "Virtual");
	Descriptor.Insert("Fields", Fields);
	Descriptor.Insert("Columns", New Map);
	Descriptor.Insert("IsDerived", True);
	Descriptor.Insert("Subquery", Subquery);
	// Платформа отсеивает нулевые строки по тем ресурсам, которые выбраны снаружи.
	// FROM собирается последним, поэтому к тому моменту это уже известно.
	Descriptor.Insert("ZeroFilter", New Array);
	// Когда снаружи не спросили ни одного разреза, виртуальная таблица - это одна
	// итоговая строка, и платформа отдаёт её даже нулевой. Отсев тогда не применяется.
	Descriptor.Insert("ZeroGrouped", True);
	Descriptor.Insert("Used", New Map);
	// Измерения виртуальной таблицы - это поля регистра, и их типы метаданные знают.
	Descriptor.Insert("ColumnSources", New Map);
	Return Descriptor;

EndFunction

// Inside a virtual table condition the register fields are written bare.
Function VirtualColumn(Physical, Context)
	Return VirtualAlias() + "." + PhysicalName(Physical, Context);
EndFunction

Function VirtualAlias()
	Return "VT";
EndFunction

Function ConditionContext(Base, Context, Alias = "")

	Own = ?(IsBlankString(Alias), VirtualAlias(), Alias);
	Inner = NewContext(Context.Options, Context.Warnings, Context.TempTables,
		NextAliasPrefix(Context.AliasPrefix));

	// Таблице подзапроса даётся псевдоним: тогда внутри условия работает и обращение
	// через точку - навигационные соединения лягут в тот же подзапрос.
	Entry = New Structure;
	Entry.Insert("SafeAlias", Own);
	Entry.Insert("Descriptor", Base);
	Inner.Aliases.Insert(Upper(Own), Entry);

	// Поле в параметрах виртуальной таблицы пишется без псевдонима, и его колонка
	// кладётся сюда готовой - это второй вход, минуя воронку FieldValue. Чтобы
	// значение было и здесь, кладётся значение; одну колонку из него берёт ValueColumn,
	// и это ровно та же строка, что лежала тут раньше.
	For Each Item In Base.Fields Do
		Inner.BareFields.Insert(Item.Key, StoredFieldValue(Base, Own, Item.Key,
			FieldColumn(Base, Own, Item.Value, Context), Context));
	EndDo;
	Inner.BareDescriptor = Base;
	Inner.BareAlias = Own;
	Inner.BooleanContext = True;
	Return Inner;

EndFunction

// Условие виртуальной таблицы с обращением к табличной части через точку (Поле.ТЧ.Реквизит, Поле.Ссылка.ТЧ.Реквизит):
// голое поле регистра получает псевдоним условия, слагаемые И одной табличной части сливаются в один подзапрос по её
// строкам, ИЛИ и НЕ - как в отборе оператора (FilterConditions). Платформа пишет здесь тот же EXISTS, что в ГДЕ (замер
// ct01, ct03, 22.11.2026, УХ). Без таких обращений условие возвращается как есть.
Function VirtualTabularCondition(Condition, Inner)

	Condition = CastSectionPaths(Condition, Inner);
	Tokens = Tokenize(Condition);
	Qualified = False;
	For Each Token In Tokens Do
		If Token.Kind = "Name" And StrSplit(Token.Value, ".").Count() >= 3
			And Inner.BareFields.Get(Upper(StrSplit(Token.Value, ".")[0])) <> Undefined Then
			Token.Value = Inner.BareAlias + "." + Token.Value;
			Qualified = True;
		EndIf;
	EndDo;
	If Not Qualified Then
		Return Condition;
	EndIf;
	Tokens = WithoutOuterParentheses(Tokens);
	If TabularReferences(Tokens, 0, Tokens.Count() - 1, Undefined, Inner).Count() = 0 Then
		Return Condition;
	EndIf;

	Parts = New Array;
	Merged = New Map;
	Conjuncts = New Array;
	For Each Conjunct In ConjunctSplits(Tokens) Do
		For Each Part In TabularConjuncts(TokensText(Tokens, Conjunct.From, Conjunct.Till), Undefined, Inner) Do
			Conjuncts.Add(Part);
		EndDo;
	EndDo;
	// Один EXISTS - только хвост цепочки из условий одной табличной части (замер v9-v16, FilterConditions).
	TrailKey = Undefined;
	TrailFrom = Conjuncts.Count();
	For Position = -(Conjuncts.Count() - 1) To 0 Do
		Info = MergeableTabularInfo(Conjuncts[-Position], Undefined, Inner);
		If Info = Undefined Or (TrailKey <> Undefined And Info.Key <> TrailKey) Then
			Break;
		EndIf;
		TrailKey = Info.Key;
		TrailFrom = -Position;
	EndDo;
	For Index = 0 To Conjuncts.Count() - 1 Do
		Slice = WithoutOuterParentheses(Tokenize(Conjuncts[Index]));
		Last = Slice.Count() - 1;
		Text = TokensText(Slice, 0, Last);
		Refs = TabularReferences(Slice, 0, Last, Undefined, Inner);
		Word = ?(Slice[0].Kind = "Name", Upper(Slice[0].Value), "");
		If Refs.Count() = 0 Then
			Parts.Add("(" + Text + ")");
			Continue;
		EndIf;
		If Refs.Count() > 1 Or TopLevelSplits(Slice, "OR,ИЛИ").Count() > 1 Or Word = "NOT" Or Word = Upper("Не") Then
			Parts.Add("(" + TabularOperandText(Slice, 0, Last, Undefined, Inner) + ")");
			Continue;
		EndIf;
		For Each Pair In Refs Do
			Info = Pair.Value;
		EndDo;
		If Index < TrailFrom Then
			Single = New Array;
			Single.Add(Text);
			Parts.Add("(" + TabularSubqueryText(Info, Single) + ")");
			Continue;
		EndIf;
		Entry = Merged.Get(Info.Key);
		If Entry = Undefined Then
			Entry = New Structure("Index, Parts, Info", Parts.Count(), New Array, Info);
			Merged.Insert(Info.Key, Entry);
			Parts.Add("");
		EndIf;
		Entry.Parts.Add(Text);
	EndDo;
	For Each Pair In Merged Do
		Parts[Pair.Value.Index] = "(" + TabularSubqueryText(Pair.Value.Info, Pair.Value.Parts) + ")";
	EndDo;
	Return StrConcat(Parts, " AND ");

EndFunction

Function ConditionSql(Condition, Base, Context, Joins = Undefined, Alias = "")

	If IsBlankString(Condition) Then
		Return "";
	EndIf;

	Inner = ConditionContext(Base, Context, Alias);
	Result = "(" + TranslateExpression(VirtualTabularCondition(Condition, Inner), Inner) + ")";

	If Joins <> Undefined Then
		For Each Navigation In Inner.NavigationJoins Do
			Joins.Add(Navigation);
		EndDo;
	EndIf;

	Return Result;

EndFunction

// Источник подзапроса виртуальной таблицы: сама таблица регистра плюс соединения,
// которые понадобились для обращения через точку внутри условия.
Function VirtualFrom(Base, Context, Joins)

	Lines = New Array;
	Lines.Add("    FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS " + VirtualAlias());
	If Joins <> Undefined Then
		For Each Navigation In Joins Do
			Lines.Add("      LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias
				+ " ON " + JoinCondition(Navigation));
		EndDo;
	EndIf;
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Виртуальные таблицы, которые есть только у регистра расчёта: ДанныеГрафика и База<Регистр>. По форме
// имя не отличить от табличной части («Справочник.X.ДанныеГрафика»), поэтому вид читается только у
// регистра расчёта, а у базы - только когда хвост имени называет регистр расчёта.
Function CalculationVirtualKind(Parts)

	If Parts.Count() <> 3 Then
		Return Undefined;
	EndIf;
	Head = Upper(TrimAll(Parts[0]));
	If Head <> "CALCULATIONREGISTER" And Head <> Upper("РегистрРасчета") Then
		Return Undefined;
	EndIf;
	Name = TrimAll(Parts[2]);
	Normalized = Upper(Name);
	If Normalized = "SCHEDULEDATA" Or Normalized = Upper("ДанныеГрафика") Then
		Return "SCHEDULEDATA";
	EndIf;
	If StrLen(Name) > 4 And (StrStartsWith(Normalized, "BASE") Or StrStartsWith(Normalized, Upper("База")))
		And Metadata.CalculationRegisters.Find(Mid(Name, 5)) <> Undefined Then
		Return "CALCULATIONBASE";
	EndIf;
	Return Undefined;

EndFunction

// Колонка таблицы по имени колонки хранения - для стандартных реквизитов, чьи логические имена зависят
// от языка конфигурации (_ActionPeriod, _BPDateFrom …). Пустая строка - такой колонки нет.
Function StoredColumn(Base, Physical)

	For Each Item In Base.Fields Do
		If Upper(Item.Value) = Upper(Physical) Then
			Return Item.Value;
		EndIf;
	EndDo;
	Return "";

EndFunction

// Периоды, за которые ДанныеГрафика отдаёт значения графика: суффикс поля на обоих языках.
Function ScheduleDataPeriods(Register)

	Periods = New Array;
	ByAction = False;
	ByBase = False;
	Try
		ByAction = Register.ActionPeriod;
		ByBase = Register.BasePeriod;
	Except
		ByAction = False;
	EndTry;
	If ByAction Then
		Periods.Add(New Structure("Code, English, Russian", "AP", "ActionPeriod", "ПериодДействия"));
		Periods.Add(New Structure("Code, English, Russian", "AAP", "ActualActionPeriod",
			"ФактическийПериодДействия"));
	EndIf;
	If ByBase Then
		Periods.Add(New Structure("Code, English, Russian", "BP", "BasePeriod", "БазовыйПериод"));
	EndIf;
	Periods.Add(New Structure("Code, English, Russian", "RP", "RegistrationPeriod", "ПериодРегистрации"));
	Return Periods;

EndFunction

// ДанныеГрафика(Условие) регистра расчёта: записи регистра и значения графика за четыре периода
// записи - у каждого ресурса регистра графика поля <Ресурс>ПериодДействия,
// <Ресурс>ФактическийПериодДействия, <Ресурс>БазовыйПериод и <Ресурс>ПериодРегистрации (замер s_all,
// 21.11.2026, УХ, РегистрРасчета.Начисления: 16 полей у четырёх ресурсов графика). Здесь - только
// состав полей; текст собирает ScheduleDataSubquery, когда известно, какие поля спросили.
Function ScheduleDataDescriptor(BaseName, Base, Register, Arguments, Context)

	Schedule = Undefined;
	Try
		Schedule = Register.Schedule;
	Except
		Schedule = Undefined;
	EndTry;
	If Schedule = Undefined Then
		Raise StrTemplate("Calculation register %1 has no schedule, so it has no ScheduleData virtual table.",
			BaseName);
	EndIf;

	Fields = New Map;
	Columns = New Map;
	Sources = New Map;
	For Each Item In Base.Fields Do
		ColumnList = Base.Columns.Get(Item.Key);
		Name = OriginalFieldName(Base, Item.Key);
		If ColumnList = Undefined Or Name = Undefined Then
			Continue;
		EndIf;
		Fields.Insert(Item.Key, Name);
		Entry = New Structure;
		Entry.Insert("LogicalName", BaseName);
		Entry.Insert("FieldName", Name);
		Sources.Insert(Item.Key, Entry);
		If ColumnList.Count() < 2 Then
			Continue;
		EndIf;
		Aliases = New Array;
		For Each Column In ColumnList Do
			Aliases.Add(PartAlias(Name, Column));
		EndDo;
		Columns.Insert(Item.Key, Aliases);
	EndDo;

	Values = New Array;
	For Each Resource In Schedule.Resources Do
		For Each Period In ScheduleDataPeriods(Register) Do
			Canonical = Resource.Name + Period.English;
			Entry = New Structure;
			Entry.Insert("LogicalName", Schedule.FullName());
			Entry.Insert("FieldName", Resource.Name);
			For Each Spelling In StrSplit(Canonical + "," + Resource.Name + Period.Russian, ",") Do
				Fields.Insert(Upper(Spelling), Canonical);
				Sources.Insert(Upper(Spelling), Entry);
			EndDo;
			Value = New Structure;
			Value.Insert("Name", Canonical);
			Value.Insert("Resource", Resource.Name);
			Value.Insert("Period", Period.Code);
			Values.Add(Value);
		EndDo;
	EndDo;

	Descriptor = DerivedDescriptor(BaseName + ".SCHEDULEDATA", Fields, "");
	For Each Item In Columns Do
		Descriptor.Columns.Insert(Item.Key, Item.Value);
	EndDo;
	For Each Item In Sources Do
		Descriptor.ColumnSources.Insert(Item.Key, Item.Value);
	EndDo;

	Plan = New Structure;
	Plan.Insert("BaseName", BaseName);
	Plan.Insert("Base", Base);
	Plan.Insert("Register", Register);
	Plan.Insert("Arguments", Arguments);
	Plan.Insert("Values", Values);
	Descriptor.Insert("SchedulePlan", Plan);
	Return Descriptor;

EndFunction

// Связи записи регистра расчёта с графиком: реквизит или измерение со свойством «Связь с графиком»
// равны своему измерению регистра графика (замер t_sch1, 21.11.2026, УХ). Составное поле сравнивается
// с составным по частям; одиночная ссылка с составным измерением - частью ссылки при константах типа
// (T1.Fld108753RRef = T3._Fld31180_RRRef AND 0x08 = T3._Fld31180_TYPE AND 0x00000070 = T3._Fld31180_RTRef).
// Record и Graph - псевдонимы таблицы записей и таблицы графика.
Function ScheduleLinks(Plan, Target, Record, Graph, Context)

	Base = Plan.Base;
	Register = Plan.Register;
	Links = New Array;
	Collections = New Array;
	Collections.Add(Register.Dimensions);
	Collections.Add(Register.Attributes);
	For Each Collection In Collections Do
		For Each Item In Collection Do
			Link = Undefined;
			Try
				Link = Item.ScheduleLink;
			Except
				Link = Undefined;
			EndTry;
			If Link = Undefined Then
				Continue;
			EndIf;
			Own = Base.Columns.Get(Upper(Item.Name));
			Their = Target.Columns.Get(Upper(Link.Name));
			If Own = Undefined Or Their = Undefined Then
				Raise StrTemplate("Field %1 of %2 is linked to the schedule, and its storage or the storage of"
					+ " schedule dimension %3 is not found.", Item.Name, Plan.BaseName, Link.Name);
			EndIf;
			If Own.Count() = Their.Count() Then
				For Each Column In Own Do
					Pair = "";
					For Each Other In Their Do
						If PartAlias("", Other) = PartAlias("", Column) Then
							Pair = Other;
						EndIf;
					EndDo;
					If IsBlankString(Pair) Then
						Pair = Their[Own.Find(Column)];
					EndIf;
					Links.Add(Record + "." + PhysicalName(Column, Context) + " = " + Graph + "."
						+ PhysicalName(Pair, Context));
				EndDo;
				Continue;
			EndIf;
			Types = Item.Type.Types();
			Referenced = ?(Types.Count() = 1, Metadata.FindByType(Types[0]), Undefined);
			If Own.Count() <> 1 Or Referenced = Undefined Then
				Raise StrTemplate("Field %1 of %2 is linked to schedule dimension %3 of another composition of"
					+ " types, and the comparison the platform builds for such a pair is not measured.",
					Item.Name, Plan.BaseName, Link.Name);
			EndIf;
			For Each Other In Their Do
				Suffix = Upper(PartAlias("", Other));
				If Suffix = "_TYPE" Then
					Links.Add(BinaryLiteral("08", Context) + " = " + Graph + "." + PhysicalName(Other, Context));
				ElsIf Suffix = "_RTREF" Then
					Links.Add(ReferenceTypeIdLiteral(Referenced.FullName(), Context) + " = " + Graph + "."
						+ PhysicalName(Other, Context));
				Else
					Links.Add(Record + "." + PhysicalName(Own[0], Context) + " = " + Graph + "."
						+ PhysicalName(Other, Context));
				EndIf;
			EndDo;
		EndDo;
	EndDo;
	Return Links;

EndFunction

// Текст ДанныеГрафика. Замеры s_all, s_sel, s_cond, t_sch1-t_sch4 (21.11.2026, УХ, Начисления, кэш
// планов вместе с наполнением временных таблиц): без полей графика в выборке - сама таблица записей с
// условием; значение графика - сумма ресурса регистра графика по датам периода при равенстве связей:
//   ПериодДействия           - дата >= ПериодДействия и < ПериодДействия + период регистра (месяц);
//   БазовыйПериод            - дата >= БазовыйПериодНачало и <= БазовыйПериодКонец;
//   ПериодРегистрации        - дата >= ПериодРегистрации и < ПериодРегистрации + период регистра;
//   ФактическийПериодДействия - по каждому отрезку фактического периода действия записи (таблица
//     периодов действия, а без её строк - свой период действия записи) дата >= начала и <= конца,
//     суммы отрезков складываются.
// Платформа считает суммы во временной таблице по разным наборам (начало, конец, связи) и соединяет её
// слева; здесь те же суммы - подзапросом на запись и соединением по записи. Записи без строк графика
// получают NULL. Период регистра замерен один - месяц (DATEADD(MONTH, 1, …)).
Function ScheduleDataSubquery(Descriptor, Context)

	Plan = Descriptor.SchedulePlan;
	Base = Plan.Base;
	Register = Plan.Register;
	VirtualJoins = New Array;
	Condition = ConditionSql(ArgumentAt(Plan.Arguments, 0), Base, Context, VirtualJoins);

	Select = New Array;
	For Each Item In Base.Fields Do
		ColumnList = Base.Columns.Get(Item.Key);
		Name = OriginalFieldName(Base, Item.Key);
		If ColumnList = Undefined Or Name = Undefined Then
			Continue;
		EndIf;
		Select.Add("        " + VirtualColumn(ColumnList[ColumnList.Count() - 1], Context) + " AS "
			+ QuoteIdentifier(Name, Context));
		If ColumnList.Count() < 2 Then
			Continue;
		EndIf;
		For Each Column In ColumnList Do
			Select.Add("        " + VirtualColumn(Column, Context) + " AS "
				+ QuoteIdentifier(PartAlias(Name, Column), Context));
		EndDo;
	EndDo;

	Needed = New Array;
	Actual = New Array;
	For Each Value In Plan.Values Do
		If Not Used(Descriptor, Value.Name) Then
			Continue;
		EndIf;
		Needed.Add(Value);
		If Value.Period = "AAP" Then
			Actual.Add(Value);
		EndIf;
	EndDo;

	Extra = New Array;
	If Needed.Count() > 0 Then
		Target = TableDescriptor(Register.Schedule.FullName());
		Monthly = False;
		Try
			Monthly = Register.Periodicity = Metadata.ObjectProperties.CalculationRegisterPeriodicity.Month;
		Except
			Monthly = False;
		EndTry;
		If Not Monthly Then
			Raise StrTemplate("Virtual table %1.ScheduleData reads the schedule over the action period and the"
				+ " registration period of a record, and their length is measured for a register with monthly"
				+ " periodicity only; this register has another one.", Plan.BaseName);
		EndIf;
		DateName = "";
		Try
			DateName = Register.ScheduleDate.Name;
		Except
			DateName = "";
		EndTry;
		DateStored = ?(IsBlankString(DateName), Undefined, Target.Fields.Get(Upper(DateName)));
		ActionPeriod = StoredColumn(Base, "_ActionPeriod");
		ActionFrom = StoredColumn(Base, "_APDateFrom");
		ActionTill = StoredColumn(Base, "_APDateTill");
		BaseFrom = StoredColumn(Base, "_BPDateFrom");
		BaseTill = StoredColumn(Base, "_BPDateTill");
		Registration = StoredColumn(Base, "_Period");
		If DateStored = Undefined Or IsBlankString(Registration) Then
			Raise StrTemplate("The schedule of register %1 has an unexpected structure: its date dimension or"
				+ " the registration period of the register is not found in the storage structure.",
				Plan.BaseName);
		EndIf;
		Day = "S." + PhysicalName(DateStored, Context);
		Graph = QualifiedTableName(Target.PhysicalName, Context);
		Links = ScheduleLinks(Plan, Target, VirtualAlias(), "S", Context);

		For Each Value In Needed Do
			Stored = Target.Fields.Get(Upper(Value.Resource));
			If Stored = Undefined Then
				Raise StrTemplate("Resource %1 of the schedule of register %2 has no physical storage.",
					Value.Resource, Plan.BaseName);
			EndIf;
			Quoted = QuoteIdentifier(Value.Name, Context);
			If Value.Period = "AAP" Then
				Select.Add("        SA." + Quoted + " AS " + Quoted);
				Continue;
			EndIf;
			Bounds = New Array;
			If Value.Period = "AP" Then
				Bounds.Add(Day + " >= " + VirtualColumn(ActionPeriod, Context));
				Bounds.Add(Day + " < " + ShiftedDate(VirtualColumn(ActionPeriod, Context), "1", "month", Context));
			ElsIf Value.Period = "BP" Then
				Bounds.Add(Day + " >= " + VirtualColumn(BaseFrom, Context));
				Bounds.Add(Day + " <= " + VirtualColumn(BaseTill, Context));
			Else
				Bounds.Add(Day + " >= " + VirtualColumn(Registration, Context));
				Bounds.Add(Day + " < " + ShiftedDate(VirtualColumn(Registration, Context), "1", "month", Context));
			EndIf;
			For Each Link In Links Do
				Bounds.Add(Link);
			EndDo;
			Select.Add("        (SELECT SUM(S." + PhysicalName(Stored, Context) + ") FROM " + Graph + " AS S WHERE "
				+ StrConcat(Bounds, " AND ") + ") AS " + Quoted);
		EndDo;

		If Actual.Count() > 0 Then
			Periods = StorageStructure().Get(ActionPeriodsKey(Plan.BaseName));
			If Periods = Undefined Or IsBlankString(ActionFrom) Or IsBlankString(ActionTill) Then
				Raise StrTemplate("Register %1 keeps no table of action periods in this infobase, and the"
					+ " schedule over the actual action period cannot be built.", Plan.BaseName);
			EndIf;
			RecordKeys = New Array;
			PeriodKeys = New Array;
			OuterKeys = New Array;
			PieceFrom = "";
			PieceTill = "";
			For Each Physical In Periods.Physicals Do
				Normalized = Upper(Physical);
				If Normalized = "_APDATEFROM" Then
					PieceFrom = "AP." + PhysicalName(Physical, Context);
				ElsIf Normalized = "_APDATETILL" Then
					PieceTill = "AP." + PhysicalName(Physical, Context);
				Else
					RecordKeys.Add("R." + PhysicalName(Physical, Context));
					PeriodKeys.Add("AP." + PhysicalName(Physical, Context) + " = R." + PhysicalName(Physical, Context));
					OuterKeys.Add("SA." + PhysicalName(Physical, Context) + " = " + VirtualColumn(Physical, Context));
				EndIf;
			EndDo;
			If IsBlankString(PieceFrom) Or IsBlankString(PieceTill) Or RecordKeys.Count() = 0 Then
				Raise StrTemplate("The table of action periods of register %1 has an unexpected structure.",
					Plan.BaseName);
			EndIf;
			Sums = New Array;
			For Each Value In Actual Do
				Sums.Add("SUM(S." + PhysicalName(Target.Fields.Get(Upper(Value.Resource)), Context) + ") AS "
					+ QuoteIdentifier(Value.Name, Context));
			EndDo;
			Pieces = New Array;
			Pieces.Add(Day + " >= CASE WHEN " + PieceFrom + " IS NULL THEN R." + PhysicalName(ActionFrom, Context)
				+ " ELSE " + PieceFrom + " END");
			Pieces.Add(Day + " <= CASE WHEN " + PieceTill + " IS NULL THEN R." + PhysicalName(ActionTill, Context)
				+ " ELSE " + PieceTill + " END");
			For Each Link In ScheduleLinks(Plan, Target, "R", "S", Context) Do
				Pieces.Add(Link);
			EndDo;
			Extra.Add("      LEFT JOIN (SELECT " + StrConcat(RecordKeys, ", ") + ", " + StrConcat(Sums, ", ")
				+ " FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS R"
				+ " LEFT JOIN " + QualifiedTableName(Periods.PhysicalName, Context) + " AS AP ON "
				+ StrConcat(PeriodKeys, " AND ")
				+ " INNER JOIN " + Graph + " AS S ON " + StrConcat(Pieces, " AND ")
				+ " GROUP BY " + StrConcat(RecordKeys, ", ") + ") AS SA ON " + StrConcat(OuterKeys, " AND "));
		EndIf;
	EndIf;

	Lines = New Array;
	Lines.Add("      SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("  " + VirtualFrom(Base, Context, VirtualJoins));
	For Each Join In Extra Do
		Lines.Add(Join);
	EndDo;
	If Not IsBlankString(Condition) Then
		Lines.Add("      WHERE " + Condition);
	EndIf;
	Return StrConcat(Lines, Chars.LF);

EndFunction

// ФактическийПериодДействия(Условие) регистра расчёта. Замер fpd a1 (19.11.2026, УХ,
// РегистрРасчета.Начисления, кэш планов): записи регистра LEFT JOIN таблица периодов действия по
// регистратору (тип и ссылка) и номеру строки; начало и конец периода действия - из неё, если строка
// есть (`CASE WHEN T3._APDateFrom IS NULL THEN T2._APDateFrom ELSE T3._APDateFrom END`), иначе из записи;
// отбор `T3._APDateFrom <> <пустая дата> OR T3._APDateFrom IS NULL` - запись, вытесненная целиком, не
// выходит. Прочие поля регистра - как есть. Условие - на поля регистра, как у других виртуальных таблиц.
Function ActualActionPeriodSubquery(BaseName, Base, Register, Arguments, Context)

	Periods = StorageStructure().Get(ActionPeriodsKey(BaseName));
	If Periods = Undefined Then
		Raise StrTemplate("Register %1 keeps no table of action periods in this infobase, and its virtual"
			+ " table of the actual action period cannot be built.", BaseName);
	EndIf;
	VirtualJoins = New Array;
	Condition = ConditionSql(ArgumentAt(Arguments, 0), Base, Context, VirtualJoins);

	PeriodsAlias = VirtualAlias() + "AP";
	Own = New Map;
	For Each Physical In Periods.Physicals Do
		Own.Insert(Upper(Physical), Physical);
	EndDo;
	Keys = New Array;
	For Each Physical In Periods.Physicals Do
		Normalized = Upper(Physical);
		If Normalized = "_APDATEFROM" Or Normalized = "_APDATETILL" Then
			Continue;
		EndIf;
		// Регистратор, номер строки и разделители - общие колонки записи и её периода.
		Keys.Add(PeriodsAlias + "." + PhysicalName(Physical, Context) + " = " + VirtualColumn(Physical, Context));
	EndDo;
	If Own.Get("_APDATEFROM") = Undefined Or Own.Get("_APDATETILL") = Undefined Or Keys.Count() = 0 Then
		Raise StrTemplate("The table of action periods of register %1 has an unexpected structure.", BaseName);
	EndIf;

	Fields = New Map;
	Columns = New Map;
	Select = New Array;
	For Each Item In Base.Fields Do
		ColumnList = Base.Columns.Get(Item.Key);
		If ColumnList = Undefined Then
			Continue;
		EndIf;
		Name = OriginalFieldName(Base, Item.Key);
		If Name = Undefined Then
			Continue;
		EndIf;
		Stored = ColumnList[ColumnList.Count() - 1];
		Value = VirtualColumn(Stored, Context);
		If Upper(Stored) = "_APDATEFROM" Or Upper(Stored) = "_APDATETILL" Then
			Actual = PeriodsAlias + "." + PhysicalName(Own.Get(Upper(Stored)), Context);
			Value = "CASE WHEN " + Actual + " IS NULL THEN " + Value + " ELSE " + Actual + " END";
		EndIf;
		Select.Add("        " + Value + " AS " + QuoteIdentifier(Name, Context));
		Fields.Insert(Item.Key, Name);
		If ColumnList.Count() < 2 Then
			Continue;
		EndIf;
		Aliases = New Array;
		For Each Column In ColumnList Do
			Alias = PartAlias(Name, Column);
			Select.Add("        " + VirtualColumn(Column, Context) + " AS " + QuoteIdentifier(Alias, Context));
			Aliases.Add(Alias);
		EndDo;
		Columns.Insert(Item.Key, Aliases);
	EndDo;

	ActualFrom = PeriodsAlias + "." + PhysicalName(Own.Get("_APDATEFROM"), Context);
	Where = New Array;
	Where.Add("(" + ActualFrom + " <> " + ValueLiteral(Date(1, 1, 1), Context) + " OR " + ActualFrom + " IS NULL)");
	If Not IsBlankString(Condition) Then
		Where.Add(Condition);
	EndIf;

	Lines = New Array;
	Lines.Add("      SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("  " + VirtualFrom(Base, Context, VirtualJoins));
	Lines.Add("      LEFT JOIN " + QualifiedTableName(Periods.PhysicalName, Context) + " AS " + PeriodsAlias
		+ " ON " + StrConcat(Keys, " AND "));
	Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));

	Descriptor = DerivedDescriptor(BaseName + ".ACTUALACTIONPERIOD", Fields, StrConcat(Lines, Chars.LF));
	For Each Item In Columns Do
		Descriptor.Columns.Insert(Item.Key, Item.Value);
	EndDo;
	For Each Item In Fields Do
		Entry = New Structure;
		Entry.Insert("LogicalName", BaseName);
		Entry.Insert("FieldName", Item.Value);
		Descriptor.ColumnSources.Insert(Item.Key, Entry);
	EndDo;
	Return Descriptor;

EndFunction

// Задача.<X>.ЗадачиПоИсполнителю([Исполнитель], [Условие]). Замеры tq1b, tq3b, tq5b, tq7, tq2, tq6
// (20.11.2026, УХ, кэш планов, ЗадачаИсполнителя и БюджетнаяЗадача): UNION ALL двух выборок из таблицы
// задач. Первая - задачи, у которых основной реквизит адресации равен исполнителю. Вторая - задачи с пустым
// основным реквизитом (составной - НЕОПРЕДЕЛЕНО всеми колонками, одиночная ссылка - пустая), соединённые с
// регистром адресации: основное измерение равно исполнителю, прочие реквизиты адресации равны своим
// измерениям; реквизит без измерения в соединение не входит (у БюджетнаяЗадача в ON - один разделитель).
// Условие - в обе выборки, задача повторяется по числу подходящих записей регистра. Соединение у платформы
// правое (`_Task RIGHT OUTER JOIN _InfoRg`), но отбор по пустому основному реквизиту задачи строку без
// задачи отбрасывает, и внутреннее отдаёт те же строки. Без исполнителя платформа берёт значение параметра
// сеанса - текущего исполнителя задачи (tq2, tq6: `@P` вместо параметра).
Function TasksByPerformerSubquery(BaseName, Base, Task, Arguments, TableName, Context)

	Main = Task.MainAddressingAttribute;
	Addressing = Task.Addressing;
	If Main = Undefined Or Addressing = Undefined Or Main.AddressingDimension = Undefined Then
		Raise StrTemplate("%1: task %2 has no addressing register, or its main addressing attribute is not"
			+ " linked to a dimension of it, and the platform builds this virtual table from them. Select"
			+ " from the task table directly.", TableName, BaseName);
	EndIf;
	RegisterBase = TableDescriptor(Addressing.FullName());
	RegisterAlias = VirtualAlias() + "A";

	Performer = TrimAll(ArgumentAt(Arguments, 0));
	If IsBlankString(Performer) Then
		Performer = "&" + CurrentPerformerParameter(Task, TableName, Context);
	ElsIf IsBlankString(LoneParameterName(Performer)) Then
		Performer = "(" + Performer + ")";
	EndIf;
	Condition = ArgumentAt(Arguments, 1);

	Links = New Array;
	For Each Attribute In Task.AddressingAttributes Do
		If Upper(Attribute.Name) = Upper(Main.Name) Or Attribute.AddressingDimension = Undefined Then
			Continue;
		EndIf;
		Links.Add(AddressingLink(Base, Attribute.Name, RegisterBase, Attribute.AddressingDimension.Name,
			RegisterAlias, TableName, Context));
	EndDo;

	Fields = New Map;
	Columns = New Map;
	Select = New Array;
	For Each Item In Base.Fields Do
		ColumnList = Base.Columns.Get(Item.Key);
		If ColumnList = Undefined Then
			Continue;
		EndIf;
		Name = OriginalFieldName(Base, Item.Key);
		If Name = Undefined Then
			Continue;
		EndIf;
		Select.Add("        " + VirtualColumn(ColumnList[ColumnList.Count() - 1], Context)
			+ " AS " + QuoteIdentifier(Name, Context));
		Fields.Insert(Item.Key, Name);
		If ColumnList.Count() < 2 Then
			Continue;
		EndIf;
		Aliases = New Array;
		For Each Column In ColumnList Do
			Alias = PartAlias(Name, Column);
			Select.Add("        " + VirtualColumn(Column, Context) + " AS " + QuoteIdentifier(Alias, Context));
			Aliases.Add(Alias);
		EndDo;
		Columns.Insert(Item.Key, Aliases);
	EndDo;
	SelectText = StrConcat(Select, "," + Chars.LF);

	// Поле с псевдонимом, а не голое: голое имя составного поля в условии виртуальной таблицы даёт
	// одну колонку ссылки без байта типа и номера таблицы, а платформа сравнивает все три (tq1b).
	OwnJoins = New Array;
	OwnWhere = New Array;
	OwnWhere.Add(ConditionSql(VirtualAlias() + "." + Main.Name + " = " + Performer, Base, Context));
	OwnCondition = ConditionSql(Condition, Base, Context, OwnJoins);
	If Not IsBlankString(OwnCondition) Then
		OwnWhere.Add(OwnCondition);
	EndIf;

	LinkedJoins = New Array;
	LinkedWhere = New Array;
	LinkedWhere.Add(ConditionSql(RegisterAlias + "." + Main.AddressingDimension.Name + " = " + Performer,
		RegisterBase, Context, Undefined, RegisterAlias));
	LinkedWhere.Add(EmptyAddressingCondition(Base, Main.Name, TableName, Context));
	LinkedCondition = ConditionSql(Condition, Base, Context, LinkedJoins);
	If Not IsBlankString(LinkedCondition) Then
		LinkedWhere.Add(LinkedCondition);
	EndIf;

	Lines = New Array;
	Lines.Add("    SELECT * FROM (");
	Lines.Add("      SELECT");
	Lines.Add(SelectText);
	Lines.Add("  " + VirtualFrom(Base, Context, OwnJoins));
	Lines.Add("      WHERE " + StrConcat(OwnWhere, Chars.LF + "        AND "));
	Lines.Add("      UNION ALL");
	Lines.Add("      SELECT");
	Lines.Add(SelectText);
	Lines.Add("  " + VirtualFrom(Base, Context, LinkedJoins));
	Lines.Add("      INNER JOIN " + QualifiedTableName(RegisterBase.PhysicalName, Context) + " AS " + RegisterAlias
		+ " ON " + ?(Links.Count() = 0, "1 = 1", StrConcat(Links, " AND ")));
	Lines.Add("      WHERE " + StrConcat(LinkedWhere, Chars.LF + "        AND "));
	Lines.Add("    ) AS TaskRows");

	Descriptor = DerivedDescriptor(BaseName + ".TASKSBYPERFORMER", Fields, StrConcat(Lines, Chars.LF));
	For Each Item In Columns Do
		Descriptor.Columns.Insert(Item.Key, Item.Value);
	EndDo;
	For Each Item In Fields Do
		Entry = New Structure;
		Entry.Insert("LogicalName", BaseName);
		Entry.Insert("FieldName", Item.Value);
		Descriptor.ColumnSources.Insert(Item.Key, Entry);
	EndDo;
	Return Descriptor;

EndFunction

// Имя параметра, под которым в ParameterValues ждут текущего исполнителя задачи. Платформа берёт его
// значение из сеанса, исполняющего запрос; у SQL такого сеанса нет, значение может дать только вызывающий.
Function CurrentPerformerParameter(Task, TableName, Context)

	Current = Task.CurrentPerformer;
	If Current = Undefined Then
		Raise StrTemplate("%1 is given no performer, and task %2 declares no current performer to take"
			+ " instead. Pass the performer as the first parameter of the virtual table.",
			TableName, Task.FullName());
	EndIf;
	Name = Current.Name;
	Values = Undefined;
	If Context.Options.Property("ParameterValues") And TypeOf(Context.Options.ParameterValues) = Type("Map") Then
		Values = Context.Options.ParameterValues;
	EndIf;
	Substituted = Context.Options.Property("SubstituteParameters") And Context.Options.SubstituteParameters = True;
	If Not Substituted Or Values = Undefined Or Values.Get(Name) = Undefined Then
		Raise StrTemplate("%1 is given no performer, and the platform then takes the current performer of the"
			+ " task - the value of %2 in the session that runs the query. The SQL runs without that session"
			+ " and cannot read it. Pass the performer as the first parameter of the virtual table, or supply"
			+ " the value of %2 in ParameterValues under the name %3 with SubstituteParameters on.",
			TableName, Current.FullName(), Name);
	EndIf;
	Return Name;

EndFunction

// Вид колонки поля-ссылки в таблице хранения: часть составного или одиночная ссылка. Другие виды
// (строка, число, дата в составе типа) замерами задач не покрыты.
Function AddressingColumnKind(Physical)

	Normalized = Upper(TrimAll(Physical));
	If StrEndsWith(Normalized, "_TYPE") Then
		Return "TYPE";
	ElsIf StrEndsWith(Normalized, "_RTREF") Then
		Return "RTREF";
	ElsIf StrEndsWith(Normalized, "_RRREF") Then
		Return "RRREF";
	ElsIf StrEndsWith(Normalized, "RREF") Then
		Return "RREF";
	EndIf;
	Return "";

EndFunction

// Пустой основной реквизит адресации: у составного - НЕОПРЕДЕЛЕНО (tq1b: `_TYPE = 0x01 AND _RTRef =
// 0x00000000 AND _RRRef = 0x00…`), у одиночной ссылки - пустая ссылка (tq5b: `_Fld144200RRef = 0x00…`).
Function EmptyAddressingCondition(Base, Name, TableName, Context)

	ColumnList = Base.Columns.Get(Upper(Name));
	If ColumnList = Undefined Then
		Raise StrTemplate("%1: the task table keeps no column of addressing attribute %2.", TableName, Name);
	EndIf;
	EmptyReference = BinaryLiteral("00000000000000000000000000000000", Context);
	If ColumnList.Count() = 1 And AddressingColumnKind(ColumnList[0]) = "RREF" Then
		Return VirtualColumn(ColumnList[0], Context) + " = " + EmptyReference;
	EndIf;
	Parts = New Array;
	For Each Column In ColumnList Do
		Kind = AddressingColumnKind(Column);
		If Kind = "TYPE" Then
			Parts.Add(VirtualColumn(Column, Context) + " = " + BinaryLiteral("01", Context));
		ElsIf Kind = "RTREF" Then
			Parts.Add(VirtualColumn(Column, Context) + " = " + BinaryLiteral("00000000", Context));
		ElsIf Kind = "RRREF" Then
			Parts.Add(VirtualColumn(Column, Context) + " = " + EmptyReference);
		EndIf;
	EndDo;
	If ColumnList.Count() < 2 Or Parts.Count() <> ColumnList.Count() Then
		Raise StrTemplate("%1: main addressing attribute %2 is not a reference, and what the platform takes"
			+ " for its empty value here is not measured. Select from the task table directly.", TableName, Name);
	EndIf;
	Return "(" + StrConcat(Parts, " AND ") + ")";

EndFunction

// Реквизит адресации задачи = измерение регистра адресации, колонка к колонке того же вида (tq1b:
// `T4._Fld2067_TYPE = T5._Fld31972_TYPE AND … AND T4._Fld2070RRef = T5._Fld31969RRef`).
Function AddressingLink(Base, Name, RegisterBase, DimensionName, RegisterAlias, TableName, Context)

	Own = Base.Columns.Get(Upper(Name));
	Other = RegisterBase.Columns.Get(Upper(DimensionName));
	Refusal = StrTemplate("%1: addressing attribute %2 and dimension %3 of register %4 are stored in columns"
		+ " that the measured form does not cover (only references are), and how the platform matches them"
		+ " is not measured. Select from the task table directly.", TableName, Name, DimensionName,
		RegisterBase.LogicalName);
	If Own = Undefined Or Other = Undefined Or Own.Count() <> Other.Count() Then
		Raise Refusal;
	EndIf;
	ByKind = New Map;
	For Each Column In Other Do
		Kind = AddressingColumnKind(Column);
		If IsBlankString(Kind) Or ByKind.Get(Kind) <> Undefined Then
			Raise Refusal;
		EndIf;
		ByKind.Insert(Kind, Column);
	EndDo;
	Pairs = New Array;
	For Each Column In Own Do
		Pair = ByKind.Get(AddressingColumnKind(Column));
		If Pair = Undefined Then
			Raise Refusal;
		EndIf;
		Pairs.Add(VirtualColumn(Column, Context) + " = " + RegisterAlias + "." + PhysicalName(Pair, Context));
	EndDo;
	Return StrConcat(Pairs, " AND ");

EndFunction

Function TranslateArgument(Text, Context)

	If IsBlankString(Text) Then
		Return "";
	EndIf;
	Return TranslateExpression(Text, NewContext(Context.Options, Context.Warnings, Context.TempTables));

EndFunction

// Граница периода виртуальной таблицы регистра накопления - значение параметра МоментВремени или Граница
// (SubstituteParameters, ParameterValues). Замеры ptp12, ptp13 (20.11.2026, УХ) и pc10-pc19 (21.11.2026, УХ): платформа
// сравнивает период и регистратор движения с датой и ссылкой значения - `_Period = <дата> AND (_RecorderTRef <
// <таблица> OR _RecorderTRef = <таблица> AND _RecorderRRef < <ссылка>)`, таблицу ссылки она вписывает литералом; у
// Границы над датой - один период. Остатки на МоментВремени - как на Граница(М, Исключая): движения строго до
// момента. Including - вид границы, которым платформа читает голый МоментВремени на этом месте. Части результата:
// Date - литерал даты (по нему остальной перевод видит, что граница задана), UpTo - движения по границу (конец
// периода, остаток на границу), From - движения от границы (начало периода), Before - движения до неё (начальный
// остаток). Undefined - аргумент не параметр с таким значением: прежний перевод.
Function PeriodBound(Argument, Including, Base, Context)

	Text = TrimAll(Argument);
	If Left(Text, 1) <> "&" Or StrFind(Text, " ") > 0 Or Not Context.Options.SubstituteParameters Then
		Return Undefined;
	EndIf;
	Value = HierarchyParameterValue(Mid(Text, 2), Context);
	Inclusive = Including;
	Moment = Value;
	If TypeOf(Value) = Type("Boundary") Then
		Inclusive = (Value.BoundaryType = BoundaryType.Including);
		Moment = Value.Value;
	ElsIf TypeOf(Value) <> Type("PointInTime") Then
		Return Undefined;
	EndIf;

	Period = VirtualColumn(PeriodColumn(Base), Context);
	Result = New Structure("DateLiteral, UpToBound, FromBound, BeforeBound");
	If TypeOf(Moment) = Type("Date") Then
		Result.DateLiteral = ValueLiteral(Moment, Context);
		Result.UpToBound = Period + ?(Inclusive, " <= ", " < ") + Result.DateLiteral;
		Result.FromBound = Period + ?(Inclusive, " >= ", " > ") + Result.DateLiteral;
		Result.BeforeBound = Period + ?(Inclusive, " < ", " <= ") + Result.DateLiteral;
		Return Result;
	EndIf;
	If TypeOf(Moment) <> Type("PointInTime") Then
		Return Undefined;
	EndIf;
	Target = Undefined;
	If Moment.Ref <> Undefined Then
		Target = Metadata.FindByType(TypeOf(Moment.Ref));
	EndIf;
	Names = New Array;
	Names.Add("Recorder");
	Names.Add("Регистратор");
	RecorderField = FirstExistingField(Base, Names);
	Info = ?(IsBlankString(RecorderField), Undefined, CompositeInfo(Base, RecorderField));
	If Target = Undefined Or Info = Undefined Or IsBlankString(Info.RefTypeColumn) Or IsBlankString(Info.RefColumn) Then
		Raise StrTemplate(
			"Parameter %1 of a virtual table is a point in time without a reference, or the register keeps no recorder"
			+ " parts to compare it with. That form is not measured, so it is not translated. Pass the point in time of"
			+ " a document, or a date.", Text);
	EndIf;
	Result.DateLiteral = ValueLiteral(Moment.Date, Context);
	TableId = ReferenceTypeIdLiteral(Target.FullName(), Context);
	Reference = ReferenceLiteral(Moment.Ref, Context);
	TablePart = VirtualColumn(Info.RefTypeColumn, Context);
	ReferencePart = VirtualColumn(Info.RefColumn, Context);
	Result.UpToBound = PointInTimeBoundTest(Period, TablePart, ReferencePart, "<", ?(Inclusive, "<=", "<"), Result.DateLiteral,
		TableId, Reference);
	Result.FromBound = PointInTimeBoundTest(Period, TablePart, ReferencePart, ">", ?(Inclusive, ">=", ">"), Result.DateLiteral,
		TableId, Reference);
	Result.BeforeBound = PointInTimeBoundTest(Period, TablePart, ReferencePart, "<", ?(Inclusive, "<", "<="), Result.DateLiteral,
		TableId, Reference);
	Return Result;

EndFunction

// Движение (период, таблица и ссылка регистратора) по сторону Strict от момента (дата, таблица, ссылка); Last -
// знак сравнения ссылок, строгий или нет.
Function PointInTimeBoundTest(Period, TablePart, ReferencePart, Strict, Last, MomentDate, TableId, Reference)

	Return "(" + Period + " " + Strict + " " + MomentDate + " OR " + Period + " = " + MomentDate + " AND (" + TablePart + " " + Strict
		+ " " + TableId + " OR " + TablePart + " = " + TableId + " AND " + ReferencePart + " " + Last + " " + Reference
		+ "))";

EndFunction

// Balances and turnovers in one pass: opening balance before the start, turnovers
// inside the interval, closing balance up to the end - all from the same movements.
Function BalanceAndTurnoversSubquery(BaseName, Base, Register, Arguments, Used, Context)

	StartBound = PeriodBound(ArgumentAt(Arguments, 0), True, Base, Context);
	EndBound = PeriodBound(ArgumentAt(Arguments, 1), True, Base, Context);
	If StartBound = Undefined Then
		StartPeriod = TranslateArgument(ArgumentAt(Arguments, 0), Context);
	Else
		StartPeriod = StartBound.DateLiteral;
	EndIf;
	If EndBound = Undefined Then
		EndPeriod = TranslateArgument(ArgumentAt(Arguments, 1), Context);
	Else
		EndPeriod = EndBound.DateLiteral;
	EndIf;
	Periodicity = ArgumentAt(Arguments, 2);
	VirtualJoins = New Array;
	Condition = ConditionSql(ArgumentAt(Arguments, 4), Base, Context, VirtualJoins);

	Dimensions = NarrowDimensions(RegisterColumns(Register, Base, "Dimensions"), Used);
	Resources = RegisterColumns(Register, Base, "Resources");
	RecordKind = RecordKindColumn(Base);
	If RecordKind = Undefined Then
		Raise StrTemplate("Register %1 keeps no record kind, balances are meaningless.", BaseName);
	EndIf;
	Kind = VirtualColumn(RecordKind, Context);
	PeriodPhysical = VirtualColumn(PeriodColumn(Base), Context);

	Before = ?(IsBlankString(StartPeriod), "", PeriodPhysical + " < " + StartPeriod);
	FromStart = ?(IsBlankString(StartPeriod), "", PeriodPhysical + " >= " + StartPeriod);
	ToEnd = ?(IsBlankString(EndPeriod), "", PeriodPhysical + " <= " + EndPeriod);
	If StartBound <> Undefined Then
		Before = StartBound.BeforeBound;
		FromStart = StartBound.FromBound;
	EndIf;
	If EndBound <> Undefined Then
		ToEnd = EndBound.UpToBound;
	EndIf;

	Detail = DetailForUsedFields(PeriodDetail(Periodicity, Base, Context), Used, Base, Context);
	If Detail.Kind <> "NONE" And (StartBound <> Undefined Or EndBound <> Undefined) Then
		Raise StrTemplate(
			"%1.BalanceAndTurnovers is given a point in time or a boundary as its period together with a periodicity."
			+ " The platform then starts the first period from that point; this is not measured, so it is not"
			+ " translated. Pass dates, or drop the periodicity.", BaseName);
	EndIf;
	If Detail.Kind <> "NONE" Then
		Return BalanceAndTurnoversByPeriod(BaseName, Base, Dimensions, Resources, Kind,
			Detail, PeriodPhysical, StartPeriod, EndPeriod, Before, FromStart, ToEnd,
			Condition, VirtualJoins, PeriodCompletion(ArgumentAt(Arguments, 3)), Used, Context);
	EndIf;

	Fields = New Map;
	Select = New Array;
	Group = New Array;
	Having = New Array;
	ZeroNames = New Array;
	PartColumns = New Map;

	For Each Dimension In Dimensions Do
		Column = VirtualColumn(Dimension.Physical, Context);
		Select.Add("      " + Column + " AS " + QuoteIdentifier(Dimension.Name, Context));
		Group.Add(Column);
		Fields.Insert(Upper(Dimension.Name), Dimension.Name);
		AddCompositeColumns(Select, Group, PartColumns, Dimension, Context);
	EndDo;

	// Без начала периода и разрезов, когда снаружи спрошены одни начальные остатки, платформа
	// отдаёт итоговую строку с NULL в них, а не 0 - и с ЕСТЬNULL, СУММА, ГДЕ по нему, в ВТ; с любым
	// другим полем таблицы - 0 (замеры ob_we, ob_uh: CashAccountBalance, ЗаказыНаСборку). У
	// бухрегистра в той же форме 0.
	OpeningOnly = IsBlankString(Before) And Used <> Undefined And Used.Count() > 0;
	If OpeningOnly Then
		OpeningNames = New Map;
		For Each Resource In Resources Do
			OpeningNames.Insert(Upper(Resource.Name + "OpeningBalance"), True);
		EndDo;
		For Each Item In Used Do
			If OpeningNames.Get(Item.Key) = Undefined Then
				OpeningOnly = False;
				Break;
			EndIf;
		EndDo;
	EndIf;
	For Each Resource In Resources Do
		Column = VirtualColumn(Resource.Physical, Context);
		Signed = "CASE WHEN " + Kind + " = 0 THEN " + Column + " ELSE -" + Column + " END";

		// Без даты начала начальный остаток - остаток до начала времён, то есть ноль, как и
		// у бухрегистра. Guarded без условия отдавал сумму всех движений, и начальный остаток
		// совпадал с конечным (сверка battery34: 1С 0 строк, SQL 16).
		Opening = AddAggregate(Select, Fields, Resource.Name, "OpeningBalance", "НачальныйОстаток",
			?(IsBlankString(Before), ?(OpeningOnly, "CAST(NULL AS NUMERIC(7, 0))", "0"), Guarded(Signed, Before)),
			Context);
		Receipt = AddAggregate(Select, Fields, Resource.Name, "Receipt", "Приход",
			Guarded(Column, Both(FromStart, ToEnd, Kind + " = 0")), Context);
		Expense = AddAggregate(Select, Fields, Resource.Name, "Expense", "Расход",
			Guarded(Column, Both(FromStart, ToEnd, Kind + " = 1")), Context);
		Turn = AddAggregate(Select, Fields, Resource.Name, "Turnover", "Оборот",
			Guarded(Signed, Both(FromStart, ToEnd, "")), Context);
		Closing = AddAggregate(Select, Fields, Resource.Name, "ClosingBalance", "КонечныйОстаток",
			Guarded(Signed, ToEnd), Context);
		// Отсев здесь идёт по всем агрегатам ресурса, иначе набор с приходом, равным
		// расходу, пропал бы ещё до того, как станет известно, какие поля спросили.
		// Точный отбор по запрошенным полям делает ZeroFiltered.
		Having.Add(Opening + " <> 0 OR " + Receipt + " <> 0 OR " + Expense + " <> 0 OR "
			+ Turn + " <> 0 OR " + Closing + " <> 0");
		ZeroNames.Add(Resource.Name + "OpeningBalance");
		ZeroNames.Add(Resource.Name + "Receipt");
		ZeroNames.Add(Resource.Name + "Expense");
		ZeroNames.Add(Resource.Name + "Turnover");
		ZeroNames.Add(Resource.Name + "ClosingBalance");
	EndDo;

	Where = New Array;
	Active = ActiveCondition(Base, Context);
	If Not IsBlankString(Active) Then
		Where.Add(Active);
	EndIf;
	If Not IsBlankString(ToEnd) Then
		Where.Add(ToEnd);
	EndIf;
	If Not IsBlankString(Condition) Then
		Where.Add(Condition);
	EndIf;

	Lines = New Array;
	Lines.Add("    SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add(VirtualFrom(Base, Context, VirtualJoins));
	If Where.Count() > 0 Then
		Lines.Add("    WHERE " + StrConcat(Where, Chars.LF + "      AND "));
	EndIf;
	If Group.Count() > 0 Then
		Lines.Add("    GROUP BY " + StrConcat(Group, ", "));
	EndIf;
	If Having.Count() > 0 And Group.Count() > 0 Then
		Lines.Add("    HAVING " + StrConcat(Having, Chars.LF + "       OR "));
	EndIf;

	Descriptor = DerivedDescriptor(BaseName + ".BalanceAndTurnovers", Fields, StrConcat(Lines, Chars.LF));
	Descriptor.Columns = PartColumns;
	Descriptor.ZeroFilter = ZeroNames;
	// Замерено на CustomersARAPAccounting с условием, под которое не попало ни одной
	// записи: когда снаружи спросили только ресурс, 1С отдаёт одну итоговую строку с
	// нулём, а когда спросили измерение - ни одной. Отсев нулей поэтому применяется
	// только при группировке. У оборотов правило другое: там и без разрезов пустой
	// запрос даёт ноль строк, - и у периодичности тоже, поэтому тронуты только эти два
	// места. Без этого отчёт показывал «нет данных» там, где 1С показывает ноль.
	// Уточнено (УХ, n27b.py, РасчетыСКонтрагентамиФакт с отбором ЛОЖЬ): итоговая строка есть, только
	// если спрошен остаток - с одним приходом пустой набор даёт ноль строк; остаток у неё NULL без
	// даты начала и 0 с датой начала.
	// Состав выбранных полей известен не всегда (Used = Undefined): тогда прежнее правило -
	// отсев нулей только при группировке.
	BalanceUsed = (Used = Undefined);
	For Each Resource In Resources Do
		If Used <> Undefined And (Used.Get(Upper(Resource.Name + "OpeningBalance")) <> Undefined
			Or Used.Get(Upper(Resource.Name + "ClosingBalance")) <> Undefined) Then
			BalanceUsed = True;
		EndIf;
	EndDo;
	Descriptor.ZeroGrouped = Group.Count() > 0 Or Not BalanceUsed;
	Descriptor.Insert("ZeroTotals", Group.Count() = 0 And BalanceUsed And Not IsBlankString(StartPeriod));
	RegisterColumnSources(Descriptor, BaseName, Dimensions, Resources);
	// Ширина колонок зависит от параметров (замеры 7963, 841400-841414, 841606-841608). С началом
	// периода: начальный остаток +18 целых (CAST(SUM(...) AS NUMERIC(33, 2)) у Число(15, 2)), конечный -
	// сумма начального и оборота, +19; приход, расход и оборот +6. Без начала и конца: приход, расход и оборот +12, конечный +13. Только с
	// концом: приход, расход, оборот +6. Начальный остаток без начала периода платформа собирает
	// из литерала, конечный с одним концом - +14; эти формы не типизируются.
	// Уточнено замерами 44400-44528 (Число(15, 2), типы SQL и приведения делимого совпадают):
	// приход, расход и оборот - +12, если оператор спрашивает начальный или конечный остаток, и
	// +6, если нет; начальный остаток - +18 с началом периода, без него - Число(7, 0); конечный -
	// +19 с началом, без него +14, а если спрошен и оборот - +13.
	If Not IsBlankString(StartPeriod) Then
		RegisterAggregatedResources(Descriptor, Register, "OpeningBalance", "НачальныйОстаток", 18);
		RegisterAggregatedResources(Descriptor, Register, "ClosingBalance", "КонечныйОстаток", 19);
		RegisterAggregatedResources(Descriptor, Register, "OpeningBalance", "НачальныйОстаток", 12, , "AllDimensions");
		RegisterAggregatedResources(Descriptor, Register, "ClosingBalance", "КонечныйОстаток", 14, , "AllDimensions");
		RegisterDimensionNames(Descriptor, RegisterColumns(Register, Base, "Dimensions"));
	Else
		RegisterAggregatedResources(Descriptor, Register, "OpeningBalance", "НачальныйОстаток", 0, 7);
		RegisterAggregatedResources(Descriptor, Register, "ClosingBalance", "КонечныйОстаток", 14);
		RegisterAggregatedResources(Descriptor, Register, "ClosingBalance", "КонечныйОстаток", 13, , "WithTurnover");
	EndIf;
	For Each Suffix In StrSplit("Receipt,Приход,Expense,Расход,Turnover,Оборот", ",") Do
		RegisterAggregatedResources(Descriptor, Register, Suffix, Suffix, 12);
		RegisterAggregatedResources(Descriptor, Register, Suffix, Suffix, 6, , "Plain");
	EndDo;
	BalanceNames = New Map;
	TurnoverNames = New Map;
	For Each Resource In Resources Do
		For Each Suffix In StrSplit("OpeningBalance,НачальныйОстаток,ClosingBalance,КонечныйОстаток", ",") Do
			BalanceNames.Insert(Upper(Resource.Name + Suffix), True);
		EndDo;
		TurnoverNames.Insert(Upper(Resource.Name + "Turnover"), True);
		TurnoverNames.Insert(Upper(Resource.Name + "Оборот"), True);
	EndDo;
	Descriptor.Insert("BalanceNames", BalanceNames);
	Descriptor.Insert("TurnoverNames", TurnoverNames);
	Return Descriptor;

EndFunction

// ОстаткиИОбороты с периодичностью. Платформа здесь единственный раз заводит временную
// таблицу: питающий запрос отдаёт движения по бакетам, а накопительный итог считает
// сервер 1С в памяти. Одним оператором то же самое делает оконная функция - она есть
// с MS SQL 2012, то есть укладывается в правило генератора.
//
// Строки до начала периода штампуются бакетом начала: тогда накопление ставит их первыми
// и они дают начальный остаток первого бакета, как у платформы.
Function BalanceAndTurnoversByPeriod(BaseName, Base, Dimensions, Resources, Kind,
	Detail, PeriodPhysical, StartPeriod, EndPeriod,
	Before, FromStart, ToEnd, Condition, VirtualJoins, Completion, Used, Context)

	ByRecord = IsRecordDetail(Detail);

	Fields = New Map;
	PartColumns = New Map;
	For Each Item In Detail.Aliases Do
		Fields.Insert(Item.Key, Item.Value);
	EndDo;
	For Each Item In Detail.Parts Do
		PartColumns.Insert(Item.Key, Item.Value);
	EndDo;

	// Бакет питающего запроса. При группировке по периоду всё, что раньше начала
	// интервала, сливается в бакет начала - иначе остаток не с чего начать. При
	// детализации до записи сливать некуда, и лишние строки отсекаются после накопления.
	Feed = New Array;
	Group = New Array;
	PeriodAliases = New Array;
	Visible = New Array;

	For Each Column In Detail.Columns Do
		Alias = QuoteIdentifier(Column.Alias, Context);
		Expression = Column.Expression;
		If Not ByRecord And Not IsBlankString(Before) Then
			Expression = "CASE WHEN " + Before + " THEN "
				+ StrReplace(Column.Expression, PeriodPhysical, StartPeriod) + " ELSE " + Expression + " END";
		EndIf;
		Feed.Add("    " + Expression + " AS " + Alias);
		Group.Add(Expression);
		PeriodAliases.Add(Alias);
		If Column.Alias <> "SortKey" Then
			Visible.Add(Alias);
		EndIf;
	EndDo;

	SortAlias = QuoteIdentifier(Detail.SortAlias, Context);

	DimensionAliases = New Array;
	Partition = New Array;
	JoinOn = New Array;
	For Each Dimension In Dimensions Do
		Column = VirtualColumn(Dimension.Physical, Context);
		Alias = QuoteIdentifier(Dimension.Name, Context);
		Feed.Add("    " + Column + " AS " + Alias);
		Group.Add(Column);
		DimensionAliases.Add(Alias);
		Partition.Add(?(ByRecord, "F.", "P.") + Alias);
		JoinOn.Add("F." + Alias + " = P." + Alias);
		Fields.Insert(Upper(Dimension.Name), Dimension.Name);

		For Each Part In Dimension.Parts Do
			PartName = PartAlias(Dimension.Name, Part);
			PartQuoted = QuoteIdentifier(PartName, Context);
			Feed.Add("    " + VirtualColumn(Part, Context) + " AS " + PartQuoted);
			Group.Add(VirtualColumn(Part, Context));
			DimensionAliases.Add(PartQuoted);
			JoinOn.Add("F." + PartQuoted + " = P." + PartQuoted);
		EndDo;
		If Dimension.Parts.Count() > 0 Then
			Names = New Array;
			For Each Part In Dimension.Parts Do
				Names.Add(PartAlias(Dimension.Name, Part));
			EndDo;
			PartColumns.Insert(Upper(Dimension.Name), Names);
		EndIf;
	EndDo;

	Source = ?(ByRecord, "F.", "P.");
	Outer = New Array;
	For Each Alias In Visible Do
		If Not ByRecord And Not IsBlankString(StartPeriod) And Alias = PeriodAliases[0] Then
			// Первый период при начале внутри него платформа показывает датой начала
			// (battery35: ОстаткиИОбороты(15.02.2024, …, Месяц) - Период = 15.02.2024).
			Outer.Add("      CASE WHEN W." + Alias + " < " + StartPeriod + " THEN " + StartPeriod
				+ " ELSE W." + Alias + " END AS " + Alias);
			Continue;
		EndIf;
		Outer.Add("      W." + Alias + " AS " + Alias);
	EndDo;
	For Each Alias In DimensionAliases Do
		Outer.Add("      W." + Alias + " AS " + Alias);
	EndDo;

	Window = New Array;
	Carried = New Array;
	ZeroNames = New Array;
	// Строка периода живёт по своим правилам: период с движениями платформа показывает
	// всегда, даже когда все выбранные поля нулевые, а период-границу - только при
	// ненулевом остатке. Если же остатки снаружи не спрашивали, таблица ведёт себя
	// как обороты, и строку решает обычный отсев нулей.
	BalanceUsed = False;
	BalanceChecks = New Array;

	For Each Resource In Resources Do
		Column = VirtualColumn(Resource.Physical, Context);
		Signed = "CASE WHEN " + Kind + " = 0 THEN " + Column + " ELSE -" + Column + " END";

		Receipt = QuoteIdentifier(Resource.Name + "Receipt", Context);
		Expense = QuoteIdentifier(Resource.Name + "Expense", Context);
		Turnover = QuoteIdentifier(Resource.Name + "Turnover", Context);
		Delta = QuoteIdentifier(Resource.Name + "Delta", Context);
		Running = QuoteIdentifier(Resource.Name + "Running", Context);

		Feed.Add("    SUM(" + Guarded(Column, Both(FromStart, ToEnd, Kind + " = 0")) + ") AS " + Receipt);
		Feed.Add("    SUM(" + Guarded(Column, Both(FromStart, ToEnd, Kind + " = 1")) + ") AS " + Expense);
		Feed.Add("    SUM(" + Guarded(Signed, Both(FromStart, ToEnd, "")) + ") AS " + Turnover);
		// Дельта включает и движения до начала интервала - из неё растёт остаток.
		Feed.Add("    SUM(" + Guarded(Signed, ToEnd) + ") AS " + Delta);

		Carried.Add("        " + ?(ByRecord, "F." + Receipt, "COALESCE(F." + Receipt + ", 0)") + " AS " + Receipt);
		Carried.Add("        " + ?(ByRecord, "F." + Expense, "COALESCE(F." + Expense + ", 0)") + " AS " + Expense);
		Carried.Add("        " + ?(ByRecord, "F." + Turnover, "COALESCE(F." + Turnover + ", 0)") + " AS " + Turnover);

		// Записи одного момента идут в порядке регистратора и номера строки: без этого
		// нарастающий остаток внутри секунды недетерминирован (сверка battery34: число строк
		// совпало, начальные остатки - нет).
		Ordering = Source + SortAlias;
		If ByRecord Then
			// Сначала вид регистратора (идентификатор таблицы), потом ссылка: при одном
			// моменте приход другим документом платформа ставит раньше (сверка dbg36).
			For Each Alias In PeriodAliases Do
				If Alias <> SortAlias And StrFind(Upper(Alias), "_RTREF") > 0 Then
					Ordering = Ordering + ", " + Source + Alias;
				EndIf;
			EndDo;
			For Each Alias In PeriodAliases Do
				If Alias <> SortAlias And StrFind(Upper(Alias), "_RTREF") = 0 Then
					Ordering = Ordering + ", " + Source + Alias;
				EndIf;
			EndDo;
		EndIf;
		Window.Add("        SUM(" + ?(ByRecord, "F." + Delta, "COALESCE(F." + Delta + ", 0)") + ") OVER ("
			+ ?(Partition.Count() = 0, "", "PARTITION BY " + StrConcat(Partition, ", ") + " ")
			+ "ORDER BY " + Ordering
			+ " ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS " + Running);

		Outer.Add("      W." + Running + " - W." + Turnover + " AS "
			+ QuoteIdentifier(Resource.Name + "OpeningBalance", Context));
		Outer.Add("      W." + Receipt + " AS " + Receipt);
		Outer.Add("      W." + Expense + " AS " + Expense);
		Outer.Add("      W." + Turnover + " AS " + Turnover);
		Outer.Add("      W." + Running + " AS "
			+ QuoteIdentifier(Resource.Name + "ClosingBalance", Context));

		If Used <> Undefined Then
			If Used.Get(Upper(Resource.Name + "OpeningBalance")) <> Undefined Then
				BalanceUsed = True;
				BalanceChecks.Add("W." + Running + " - W." + Turnover + " <> 0");
			EndIf;
			If Used.Get(Upper(Resource.Name + "ClosingBalance")) <> Undefined Then
				BalanceUsed = True;
				BalanceChecks.Add("W." + Running + " <> 0");
			EndIf;
			// Движение в периоде считается по тому ресурсу, который спросили: у регистра
			// их несколько, и движение по количеству при нулевой сумме строки не даёт.
			If ResourceUsed(Used, Resource.Name, Resources) Then
				BalanceChecks.Add("W." + Receipt + " <> 0");
				BalanceChecks.Add("W." + Expense + " <> 0");
			EndIf;
		EndIf;

		RegisterAlias(Fields, Resource.Name, "OpeningBalance", "НачальныйОстаток",
			Resource.Name + "OpeningBalance");
		RegisterAlias(Fields, Resource.Name, "Receipt", "Приход", Resource.Name + "Receipt");
		RegisterAlias(Fields, Resource.Name, "Expense", "Расход", Resource.Name + "Expense");
		RegisterAlias(Fields, Resource.Name, "Turnover", "Оборот", Resource.Name + "Turnover");
		RegisterAlias(Fields, Resource.Name, "ClosingBalance", "КонечныйОстаток",
			Resource.Name + "ClosingBalance");

		ZeroNames.Add(Resource.Name + "Receipt");
		ZeroNames.Add(Resource.Name + "Expense");
		ZeroNames.Add(Resource.Name + "Turnover");
	EndDo;

	// Бакет начала интервала существует и без движений: в нём копится входящий
	// остаток. Строкой результата он становится только по методу дополнения, поэтому
	// питающий запрос помечает, было ли движение внутри интервала.
	Inside = Both(FromStart, ToEnd, "");
	// Движение - ненулевой приход или расход за период, а не ненулевая запись: месяц, где они
	// гасят друг друга записями одного вида, строки не даёт (battery35: BankAccountCash, 08-09.2024).
	Turned = New Array;
	If Not ByRecord Then
		For Each Resource In Resources Do
			If Used = Undefined Or ResourceUsed(Used, Resource.Name, Resources) Then
				Column = VirtualColumn(Resource.Physical, Context);
				Turned.Add("SUM(" + Guarded(Column, Both(FromStart, ToEnd, Kind + " = 0")) + ") <> 0");
				Turned.Add("SUM(" + Guarded(Column, Both(FromStart, ToEnd, Kind + " = 1")) + ") <> 0");
			EndIf;
		EndDo;
	EndIf;
	If Turned.Count() > 0 Then
		Feed.Add("    CASE WHEN " + StrConcat(Turned, " OR ") + " THEN 1 ELSE 0 END AS "
			+ QuoteIdentifier("Moved", Context));
	Else
		Feed.Add("    " + ?(IsBlankString(Inside), "1",
			"MAX(CASE WHEN " + Inside + " THEN 1 ELSE 0 END)")
			+ " AS " + QuoteIdentifier("Moved", Context));
	EndIf;

	Where = New Array;
	Active = ActiveCondition(Base, Context);
	If Not IsBlankString(Active) Then
		Where.Add(Active);
	EndIf;
	If Not IsBlankString(ToEnd) Then
		Where.Add(ToEnd);
	EndIf;
	If Not IsBlankString(Condition) Then
		Where.Add(Condition);
	EndIf;

	FeedLines = New Array;
	FeedLines.Add("  SELECT");
	FeedLines.Add(StrConcat(Feed, "," + Chars.LF));
	FeedLines.Add(VirtualFrom(Base, Context, VirtualJoins));
	If Where.Count() > 0 Then
		FeedLines.Add("  WHERE " + StrConcat(Where, Chars.LF + "    AND "));
	EndIf;
	FeedLines.Add("  GROUP BY " + StrConcat(Group, ", "));

	FeedName = RegisterCommonTable(StrConcat(FeedLines, Chars.LF), Context, "VTF");

	Lines = New Array;
	Lines.Add("    SELECT");
	Lines.Add(StrConcat(Outer, "," + Chars.LF));
	Lines.Add("    FROM (");
	Lines.Add("      SELECT");

	If ByRecord And (Detail.Kind = "RECORDER" Or Detail.Kind = "RECORD") Then
		// Строки по записям - только с движением спрошенного ресурса: запись регистратора
		// с нулевым оборотом платформа не показывает. При дополнении границами к ним
		// добавляются строки начала и конца интервала с пустым регистратором и ненулевым
		// остатком (сверка battery34/dbg35b: 1С 5444 и 466 строк, прежний перевод 5554 и 465).
		Prefixed = New Array;
		For Each Alias In PeriodAliases Do
			Prefixed.Add("        F." + Alias + " AS " + Alias);
		EndDo;
		For Each Alias In DimensionAliases Do
			Prefixed.Add("        F." + Alias + " AS " + Alias);
		EndDo;
		Moves = New Array;
		Balances = New Array;
		Asked = New Array;
		For Each Resource In Resources Do
			If Used <> Undefined And ResourceUsed(Used, Resource.Name, Resources) Then
				Asked.Add(Resource);
			EndIf;
		EndDo;
		If Asked.Count() = 0 Then
			Asked = Resources;
		EndIf;
		For Each Resource In Asked Do
			Moves.Add("R." + QuoteIdentifier(Resource.Name + "Receipt", Context) + " <> 0");
			Moves.Add("R." + QuoteIdentifier(Resource.Name + "Expense", Context) + " <> 0");
			Balances.Add("SUM(F." + QuoteIdentifier(Resource.Name + "Delta", Context) + ") <> 0");
		EndDo;
		Records = New Array;
		Records.Add("SELECT * FROM (SELECT");
		Records.Add(StrConcat(Prefixed, "," + Chars.LF) + ",");
		Records.Add(StrConcat(Carried, "," + Chars.LF) + ",");
		Records.Add(StrConcat(Window, "," + Chars.LF));
		Records.Add("      FROM " + FeedName + " AS F) AS R");
		Filter = New Array;
		If Not IsBlankString(StartPeriod) Then
			// Движения до начала интервала нужны были только ради остатка.
			Filter.Add("R." + SortAlias + " >= " + StartPeriod);
		EndIf;
		Filter.Add("(" + StrConcat(Moves, " OR ") + ")");
		Records.Add("      WHERE " + StrConcat(Filter, " AND "));
		Union = New Array;
		Union.Add(StrConcat(Records, Chars.LF));
		If Completion <> "MOVEMENTS" Then
			Bounds = New Array;
			If Not IsBlankString(StartPeriod) Then
				Bounds.Add(New Structure("Value, Guard", StartPeriod, "F." + SortAlias + " < " + StartPeriod));
			EndIf;
			If Not IsBlankString(EndPeriod) Then
				Bounds.Add(New Structure("Value, Guard", EndPeriod, ""));
			EndIf;
			For Each Bound In Bounds Do
				Row = New Array;
				For Index = 0 To PeriodAliases.Count() - 1 Do
					Row.Add(?(Index = 0, Bound.Value, "NULL") + " AS " + PeriodAliases[Index]);
				EndDo;
				For Each Alias In DimensionAliases Do
					Row.Add("F." + Alias + " AS " + Alias);
				EndDo;
				For Each Resource In Resources Do
					Row.Add("0 AS " + QuoteIdentifier(Resource.Name + "Receipt", Context));
					Row.Add("0 AS " + QuoteIdentifier(Resource.Name + "Expense", Context));
					Row.Add("0 AS " + QuoteIdentifier(Resource.Name + "Turnover", Context));
				EndDo;
				For Each Resource In Resources Do
					Row.Add("SUM(F." + QuoteIdentifier(Resource.Name + "Delta", Context) + ") AS "
						+ QuoteIdentifier(Resource.Name + "Running", Context));
				EndDo;
				Text = "      SELECT " + StrConcat(Row, ", ") + " FROM " + FeedName + " AS F";
				If Not IsBlankString(Bound.Guard) Then
					Text = Text + " WHERE " + Bound.Guard;
				EndIf;
				If DimensionAliases.Count() > 0 Then
					Grouped = New Array;
					For Each Alias In DimensionAliases Do
						Grouped.Add("F." + Alias);
					EndDo;
					Text = Text + " GROUP BY " + StrConcat(Grouped, ", ");
				EndIf;
				Text = Text + " HAVING " + StrConcat(Balances, " OR ");
				Union.Add(Text);
			EndDo;
		EndIf;
		// Внешний уровень ждёт подзапрос «SELECT … FROM (…) AS W»: строки собираются
		// объединением, а наружу идут через тот же W.
		Lines.Delete(Lines.Count() - 1);
		Lines.Add("      SELECT * FROM (" + StrConcat(Union, Chars.LF + "      UNION ALL" + Chars.LF) + ") AS U");
		Lines.Add("    ) AS W");
	ElsIf ByRecord Then
		// Авто: каждая строка - запись регистра, достраивать нечего.
		Prefixed = New Array;
		For Each Alias In PeriodAliases Do
			Prefixed.Add("        F." + Alias + " AS " + Alias);
		EndDo;
		For Each Alias In DimensionAliases Do
			Prefixed.Add("        F." + Alias + " AS " + Alias);
		EndDo;
		Lines.Add(StrConcat(Prefixed, "," + Chars.LF) + ",");
		Lines.Add(StrConcat(Carried, "," + Chars.LF) + ",");
		Lines.Add(StrConcat(Window, "," + Chars.LF));
		Lines.Add("      FROM " + FeedName + " AS F");
		Lines.Add("    ) AS W");
		If Not IsBlankString(StartPeriod) Then
			// Движения до начала интервала нужны были только ради остатка.
			Lines.Add("    WHERE W." + SortAlias + " >= " + StartPeriod);
		EndIf;
	Else
		// Платформа не дополняет интервал всеми периодами: строку даёт период, в котором
		// было движение, а метод дополнения добавляет к ним границы интервала. Опорный
		// набор строится из питающего запроса, поэтому накопленный остаток не теряется
		// и в тех периодах, которые наружу не идут.
		Shown = QuoteIdentifier("Shown", Context);
		Anchor = BalanceAnchor(FeedName, PeriodAliases[0], DimensionAliases, New Array, Detail,
			PeriodPhysical, StartPeriod, EndPeriod, Completion, Context);

		Prefixed = New Array;
		For Each Alias In PeriodAliases Do
			Prefixed.Add("        P." + Alias + " AS " + Alias);
		EndDo;
		For Each Alias In DimensionAliases Do
			Prefixed.Add("        P." + Alias + " AS " + Alias);
		EndDo;
		Prefixed.Add("        P." + Shown + " AS " + Shown);
		Lines.Add(StrConcat(Prefixed, "," + Chars.LF) + ",");
		Lines.Add(StrConcat(Carried, "," + Chars.LF) + ",");
		Lines.Add(StrConcat(Window, "," + Chars.LF));
		Lines.Add("      FROM " + Anchor + " AS P");
		Join = New Array;
		Join.Add("F." + PeriodAliases[0] + " = P." + PeriodAliases[0]);
		For Each Item In JoinOn Do
			Join.Add(Item);
		EndDo;
		Lines.Add("      LEFT JOIN " + FeedName + " AS F ON " + StrConcat(Join, " AND "));
		Lines.Add("    ) AS W");
		// При дополнении только движениями платформа показывает период с движениями
		// как есть, даже когда все спрошенные поля нулевые. При дополнении границами
		// строку решает ненулевое значение спрошенного ресурса.
		If BalanceUsed And Completion <> "MOVEMENTS" Then
			Lines.Add("    WHERE W." + Shown + " >= 1 AND ("
				+ StrConcat(BalanceChecks, Chars.LF + "      OR ") + ")");
		Else
			Lines.Add("    WHERE W." + Shown + " >= 1");
		EndIf;
	EndIf;

	If BalanceUsed And Dimensions.Count() = 0 Then
		PeriodUsed = False;
		For Each Column In Detail.Columns Do
			If Used.Get(Upper(Column.Alias)) <> Undefined Then
				PeriodUsed = True;
			EndIf;
		EndDo;
		If Not PeriodUsed Then
			// Без разрезов и без поля периода у пустого набора платформа отдаёт одну строку
			// (УХ, n27b.py, РасчетыСКонтрагентамиФакт с отбором ЛОЖЬ: остаток без даты начала - NULL,
			// с датой начала - 0, при пустой периодичности и при Период одинаково), а эта сборка
			// строит строки из периодов движений и на пустом наборе не отдаёт ни одной (УХ,
			// ВерсияСоглашенияКредит: 1С 1, SQL 0). На непустом наборе периодичность без поля периода
			// не замерена.
			Raise StrTemplate(
				"Virtual table %1.BalanceAndTurnovers is given a periodicity, and neither a dimension nor a"
				+ " period field is selected, only a balance. On an empty set the platform then returns one"
				+ " row, and whether it keeps one row per period on a non-empty set has not been measured."
				+ " Leave the periodicity empty, or select the period field.", BaseName);
		EndIf;
	EndIf;
	If BalanceUsed Then
		ZeroNames = New Array;
	EndIf;

	Descriptor = DerivedDescriptor(BaseName + ".BalanceAndTurnovers", Fields, StrConcat(Lines, Chars.LF));
	Descriptor.Columns = PartColumns;
	Descriptor.ZeroFilter = ZeroNames;
	RegisterColumnSources(Descriptor, BaseName, Dimensions, Resources);
	// С периодичностью все колонки - ресурс +6 целых, и начальный, и конечный остаток (замеры
	// 841405-841409, 841415-841419, 841609-841613, 841421).
	PeriodRegister = MetadataOf(BaseName);
	If PeriodRegister <> Undefined Then
		RegisterAggregatedResources(Descriptor, PeriodRegister, "OpeningBalance", "НачальныйОстаток", 6);
		RegisterAggregatedResources(Descriptor, PeriodRegister, "Receipt", "Приход", 6);
		RegisterAggregatedResources(Descriptor, PeriodRegister, "Expense", "Расход", 6);
		RegisterAggregatedResources(Descriptor, PeriodRegister, "Turnover", "Оборот", 6);
		RegisterAggregatedResources(Descriptor, PeriodRegister, "ClosingBalance", "КонечныйОстаток", 6);
	EndIf;
	RegisterRecorderSource(Descriptor, BaseName, Detail);
	Return Descriptor;

EndFunction

// Опорный набор строк результата: период, в котором было движение, плюс - при
// дополнении границами - начальный и конечный периоды интервала на каждый набор
// измерений. Признак Shown отделяет строки, которые видны снаружи, от служебных:
// бакет входящего остатка нужен оконной функции, но строкой результата не является.
Function BalanceAnchor(FeedName, PeriodAlias, DimensionAliases, RecordAliases, Detail,
	PeriodPhysical, StartPeriod, EndPeriod, Completion, Context)

	Shown = QuoteIdentifier("Shown", Context);
	Moved = QuoteIdentifier("Moved", Context);

	Columns = New Array;
	Columns.Add(PeriodAlias);
	For Each Alias In DimensionAliases Do
		Columns.Add(Alias);
	EndDo;
	// У строки-границы своей записи нет: регистратор там пустой, как и у платформы.
	For Each Alias In RecordAliases Do
		Columns.Add(Alias);
	EndDo;

	Bounds = New Array;
	If Completion = "BOUNDARIES" Then
		If Not IsBlankString(StartPeriod) Then
			Bounds.Add(StrReplace(Detail.Columns[0].Expression, PeriodPhysical, StartPeriod));
		EndIf;
		If Not IsBlankString(EndPeriod) Then
			Bounds.Add(StrReplace(Detail.Columns[0].Expression, PeriodPhysical, EndPeriod));
		EndIf;
	EndIf;

	Movements = "SELECT " + StrConcat(Columns, ", ") + ", " + Moved + " * 2 AS " + Shown
		+ " FROM " + FeedName;
	If Bounds.Count() = 0 Then
		Return "(" + Movements + ")";
	EndIf;

	Parts = New Array;
	Parts.Add("  " + Movements);
	For Each Bound In Bounds Do
		Select = New Array;
		Select.Add(Bound + " AS " + PeriodAlias);
		For Each Alias In DimensionAliases Do
			Select.Add("D." + Alias + " AS " + Alias);
		EndDo;
		For Each Alias In RecordAliases Do
			Select.Add("NULL AS " + Alias);
		EndDo;
		Select.Add("1 AS " + Shown);
		Source = ?(DimensionAliases.Count() = 0,
			"(SELECT 1 AS " + QuoteIdentifier("Any", Context) + ") AS D",
			"(SELECT DISTINCT " + StrConcat(DimensionAliases, ", ") + " FROM " + FeedName + ") AS D");
		Parts.Add("  SELECT " + StrConcat(Select, ", ") + " FROM " + Source);
	EndDo;

	Grouped = New Array;
	For Each Alias In Columns Do
		Grouped.Add("A." + Alias);
	EndDo;

	Lines = New Array;
	Lines.Add("  SELECT " + StrConcat(Grouped, ", ") + ", MAX(A." + Shown + ") AS " + Shown);
	Lines.Add("  FROM (");
	Lines.Add(StrConcat(Parts, Chars.LF + "  UNION ALL" + Chars.LF));
	Lines.Add("  ) AS A");
	Lines.Add("  GROUP BY " + StrConcat(Grouped, ", "));

	Return RegisterCommonTable(StrConcat(Lines, Chars.LF), Context, "VTA");

EndFunction

// Поле периода виртуальной таблицы 1С называет и по периодичности тоже.
Procedure RegisterPeriodAliases(Fields)

	English = New Array;
	English.Add("Second");
	English.Add("Minute");
	English.Add("Hour");
	English.Add("Day");
	English.Add("Week");
	English.Add("TenDays");
	English.Add("Month");
	English.Add("Quarter");
	English.Add("HalfYear");
	English.Add("Year");
	For Each Name In English Do
		Fields.Insert(Upper(Name + "Period"), "Period");
	EndDo;

	Russian = New Array;
	Russian.Add("Секунда");
	Russian.Add("Минута");
	Russian.Add("Час");
	Russian.Add("День");
	Russian.Add("Неделя");
	Russian.Add("Декада");
	Russian.Add("Месяц");
	Russian.Add("Квартал");
	Russian.Add("Полугодие");
	Russian.Add("Год");
	For Each Name In Russian Do
		Fields.Insert(Upper("Период" + Name), "Period");
	EndDo;

EndProcedure

Function AddAggregate(Select, Fields, ResourceName, EnglishSuffix, RussianSuffix, Expression, Context)

	Alias = ResourceName + EnglishSuffix;
	Aggregate = "SUM(" + Expression + ")";
	Select.Add("      " + Aggregate + " AS " + QuoteIdentifier(Alias, Context));
	RegisterAlias(Fields, ResourceName, EnglishSuffix, RussianSuffix, Alias);
	Return Aggregate;

EndFunction

Function Guarded(Value, Condition)

	If IsBlankString(Condition) Then
		Return Value;
	EndIf;
	Return "CASE WHEN " + Condition + " THEN " + Value + " ELSE 0 END";

EndFunction

Function Both(First, Second, Third)

	Parts = New Array;
	If Not IsBlankString(First) Then
		Parts.Add(First);
	EndIf;
	If Not IsBlankString(Second) Then
		Parts.Add(Second);
	EndIf;
	If Not IsBlankString(Third) Then
		Parts.Add(Third);
	EndIf;
	Return StrConcat(Parts, " AND ");

EndFunction

Function BalanceSubquery(BaseName, Base, Register, Arguments, Used, Context)

	Period = ArgumentAt(Arguments, 0);
	VirtualJoins = New Array;
	Condition = ConditionSql(ArgumentAt(Arguments, 1), Base, Context, VirtualJoins);

	Dimensions = NarrowDimensions(RegisterColumns(Register, Base, "Dimensions"), Used);
	Resources = RegisterColumns(Register, Base, "Resources");
	RecordKind = RecordKindColumn(Base);

	Fields = New Map;
	Select = New Array;
	Group = New Array;
	Having = New Array;
	ZeroNames = New Array;
	PartColumns = New Map;

	For Each Dimension In Dimensions Do
		Column = VirtualColumn(Dimension.Physical, Context);
		Select.Add("      " + Column + " AS " + QuoteIdentifier(Dimension.Name, Context));
		Group.Add(Column);
		Fields.Insert(Upper(Dimension.Name), Dimension.Name);
		AddCompositeColumns(Select, Group, PartColumns, Dimension, Context);
	EndDo;

	For Each Resource In Resources Do
		Column = VirtualColumn(Resource.Physical, Context);
		If RecordKind = Undefined Then
			Expression = "SUM(" + Column + ")";
		Else
			Expression = "SUM(CASE WHEN " + VirtualColumn(RecordKind, Context)
				+ " = 0 THEN " + Column + " ELSE -" + Column + " END)";
		EndIf;
		Alias = Resource.Name + "Balance";
		// Замерено по SQL самой платформы из кеша планов: ресурс остатка она оборачивает
		// ISNULL(..., 0.0), и в итоговой строке пустого остатка стоит ноль, а не NULL.
		// У остатков с оборотами правило обратное - там замер дал NULL во всех колонках, -
		// поэтому обёртка только здесь. Отбор по <> 0 от неё не зависит: ни NULL, ни ноль
		// его не проходят, поэтому ИМЕЮЩИЕ остаётся на исходном выражении.
		WithZero = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL")
			+ "(" + Expression + ", 0)";
		Select.Add("      " + WithZero + " AS " + QuoteIdentifier(Alias, Context));
		Having.Add(Expression + " <> 0");
		RegisterAlias(Fields, Resource.Name, "Balance", "Остаток", Alias);
		ZeroNames.Add(Alias);
	EndDo;

	If Select.Count() = 0 Then
		Raise StrTemplate("Register %1 has neither dimensions nor resources.", BaseName);
	EndIf;

	Where = New Array;
	Active = ActiveCondition(Base, Context);
	If Not IsBlankString(Active) Then
		Where.Add(Active);
	EndIf;
	If Not IsBlankString(Period) Then
		Bound = PeriodBound(Period, False, Base, Context);
		If Bound = Undefined Then
			// Balance at a moment does not include the movements of that moment itself.
			Where.Add(VirtualColumn(PeriodColumn(Base), Context) + " < " + TranslateArgument(Period, Context));
		Else
			Where.Add(Bound.UpToBound);
		EndIf;
	EndIf;
	If Not IsBlankString(Condition) Then
		Where.Add(Condition);
	EndIf;

	Lines = New Array;
	Lines.Add("    SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add(VirtualFrom(Base, Context, VirtualJoins));
	If Where.Count() > 0 Then
		Lines.Add("    WHERE " + StrConcat(Where, Chars.LF + "      AND "));
	EndIf;
	If Group.Count() > 0 Then
		Lines.Add("    GROUP BY " + StrConcat(Group, ", "));
	EndIf;
	If Having.Count() > 0 And Group.Count() > 0 Then
		Lines.Add("    HAVING " + StrConcat(Having, Chars.LF + "       OR "));
	EndIf;

	Descriptor = DerivedDescriptor(BaseName + ".Balance", Fields, StrConcat(Lines, Chars.LF));
	Descriptor.Columns = PartColumns;
	Descriptor.ZeroFilter = ZeroNames;
	// Замерено на CustomersARAPAccounting с условием, под которое не попало ни одной
	// записи: когда снаружи спросили только ресурс, 1С отдаёт одну итоговую строку с
	// нулём, а когда спросили измерение - ни одной. Отсев нулей поэтому применяется
	// только при группировке. У оборотов правило другое: там и без разрезов пустой
	// запрос даёт ноль строк, - и у периодичности тоже, поэтому тронуты только эти два
	// места. Без этого отчёт показывал «нет данных» там, где 1С показывает ноль.
	Descriptor.ZeroGrouped = Group.Count() > 0;
	// Ноль, а не NULL суммы по пустому набору (УХ, n27b.py, РасчетыСКонтрагентамиФакт с отбором
	// ЛОЖЬ: Остатки(, …) и Остатки(дата, …) - одна строка, 0).
	Descriptor.Insert("ZeroTotals", Group.Count() = 0);
	RegisterColumnSources(Descriptor, BaseName, Dimensions, Resources);
	// Без даты остаток +12 целых (замер 7890), на дату - +18, как начальный остаток: делимое
	// Число(15, 3) на дату - NUMERIC(38, 8), то есть ровно 30 целых (замеры 841500, 841615).
	If IsBlankString(TrimAll(Period)) Then
		RegisterAggregatedResources(Descriptor, Register, "Balance", "Остаток", 12);
	Else
		RegisterAggregatedResources(Descriptor, Register, "Balance", "Остаток", 18);
	EndIf;
	// Спрошены все измерения - платформа не сворачивает итоги, и остаток уже: без даты +6, на дату
	// +12. Только у регистра без разделения итогов: с разделением строк итогов на одну комбинацию
	// несколько, и ширина обычная (замер 17.11.2026, УХ: ПартииТоваровПереданныеНаКомиссию - +18 / +12,
	// ТоварыПереданныеПереработчику - +12 / +6).
	If Not TotalsSplitting(Register) Then
		RegisterAggregatedResources(Descriptor, Register, "Balance", "Остаток",
			?(IsBlankString(TrimAll(Period)), 6, 12), , "AllDimensions");
		RegisterDimensionNames(Descriptor, RegisterColumns(Register, Base, "Dimensions"));
	EndIf;
	Return Descriptor;

EndFunction

Function TurnoversSubquery(BaseName, Base, Register, Arguments, Used, Context)

	StartPeriod = ArgumentAt(Arguments, 0);
	EndPeriod = ArgumentAt(Arguments, 1);
	VirtualJoins = New Array;
	Condition = ConditionSql(ArgumentAt(Arguments, 3), Base, Context, VirtualJoins);

	Dimensions = NarrowDimensions(RegisterColumns(Register, Base, "Dimensions"), Used);
	Resources = RegisterColumns(Register, Base, "Resources");
	RecordKind = RecordKindColumn(Base);

	Fields = New Map;
	Select = New Array;
	Group = New Array;
	Having = New Array;
	ZeroNames = New Array;
	PartColumns = New Map;

	Detail = DetailForUsedFields(PeriodDetail(ArgumentAt(Arguments, 2), Base, Context), Used, Base,
		Context);
	For Each Column In Detail.Columns Do
		Expression = Column.Expression;
		If Detail.Kind = "UNIT" And Column.Alias = "Period" And Not IsBlankString(StartPeriod) Then
			// Первый период при начале внутри него платформа показывает датой начала, как у
			// ОстаткиИОбороты (сверка 13.11.2026, ERP WE: BankAccountCash.Turnovers с 15.02.2024
			// по месяцу - Период 15.02, а не 01.02; по дню с 15.02 12:00 - 15.02 12:00; по неделе -
			// 15.02, а не 12.02).
			Start = TranslateArgument(StartPeriod, Context);
			Expression = "CASE WHEN " + Expression + " < " + Start + " THEN " + Start
				+ " ELSE " + Expression + " END";
		EndIf;
		Select.Add("      " + Expression + " AS " + QuoteIdentifier(Column.Alias, Context));
		Group.Add(Expression);
	EndDo;
	For Each Item In Detail.Aliases Do
		Fields.Insert(Item.Key, Item.Value);
	EndDo;
	For Each Item In Detail.Parts Do
		PartColumns.Insert(Item.Key, Item.Value);
	EndDo;

	For Each Dimension In Dimensions Do
		Column = VirtualColumn(Dimension.Physical, Context);
		Select.Add("      " + Column + " AS " + QuoteIdentifier(Dimension.Name, Context));
		Group.Add(Column);
		Fields.Insert(Upper(Dimension.Name), Dimension.Name);
		AddCompositeColumns(Select, Group, PartColumns, Dimension, Context);
	EndDo;

	For Each Resource In Resources Do
		Column = VirtualColumn(Resource.Physical, Context);
		If RecordKind = Undefined Then
			Turnover = "SUM(" + Column + ")";
		Else
			Kind = VirtualColumn(RecordKind, Context);
			Turnover = "SUM(CASE WHEN " + Kind + " = 0 THEN " + Column + " ELSE -" + Column + " END)";
			Receipt = "SUM(CASE WHEN " + Kind + " = 0 THEN " + Column + " ELSE 0 END)";
			Expense = "SUM(CASE WHEN " + Kind + " = 1 THEN " + Column + " ELSE 0 END)";
			Select.Add("      " + Receipt + " AS " + QuoteIdentifier(Resource.Name + "Receipt", Context));
			Select.Add("      " + Expense + " AS " + QuoteIdentifier(Resource.Name + "Expense", Context));
			RegisterAlias(Fields, Resource.Name, "Receipt", "Приход", Resource.Name + "Receipt");
			RegisterAlias(Fields, Resource.Name, "Expense", "Расход", Resource.Name + "Expense");
		EndIf;
		Select.Add("      " + Turnover + " AS " + QuoteIdentifier(Resource.Name + "Turnover", Context));
		RegisterAlias(Fields, Resource.Name, "Turnover", "Оборот", Resource.Name + "Turnover");
		// Платформа отсеивает строки, где все выбранные ресурсы нулевые.
		// Отсев нулей идёт по всем агрегатам ресурса: пара приход = расход даёт
		// нулевой оборот, но строкой платформа её оставляет.
		Having.Add(Turnover + " <> 0");
		ZeroNames.Add(Resource.Name + "Turnover");
		If RecordKind <> Undefined Then
			Having.Add(Receipt + " <> 0");
			Having.Add(Expense + " <> 0");
			ZeroNames.Add(Resource.Name + "Receipt");
			ZeroNames.Add(Resource.Name + "Expense");
		EndIf;
	EndDo;

	Where = New Array;
	Active = ActiveCondition(Base, Context);
	If Not IsBlankString(Active) Then
		Where.Add(Active);
	EndIf;
	PeriodPhysical = VirtualColumn(PeriodColumn(Base), Context);
	If Not IsBlankString(StartPeriod) Then
		Bound = PeriodBound(StartPeriod, True, Base, Context);
		If Bound = Undefined Then
			Where.Add(PeriodPhysical + " >= " + TranslateArgument(StartPeriod, Context));
		Else
			Where.Add(Bound.FromBound);
		EndIf;
	EndIf;
	If Not IsBlankString(EndPeriod) Then
		Bound = PeriodBound(EndPeriod, True, Base, Context);
		If Bound = Undefined Then
			Where.Add(PeriodPhysical + " <= " + TranslateArgument(EndPeriod, Context));
		Else
			Where.Add(Bound.UpToBound);
		EndIf;
	EndIf;
	If Not IsBlankString(Condition) Then
		Where.Add(Condition);
	EndIf;

	Lines = New Array;
	Lines.Add("    SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add(VirtualFrom(Base, Context, VirtualJoins));
	If Where.Count() > 0 Then
		Lines.Add("    WHERE " + StrConcat(Where, Chars.LF + "      AND "));
	EndIf;
	If Group.Count() > 0 Then
		Lines.Add("    GROUP BY " + StrConcat(Group, ", "));
	EndIf;
	If Having.Count() > 0 And Group.Count() > 0 Then
		Lines.Add("    HAVING " + StrConcat(Having, Chars.LF + "       OR "));
	EndIf;

	Descriptor = DerivedDescriptor(BaseName + ".Turnovers", Fields, StrConcat(Lines, Chars.LF));
	Descriptor.Columns = PartColumns;
	Descriptor.ZeroFilter = ZeroNames;
	RegisterColumnSources(Descriptor, BaseName, Dimensions, Resources);
	RegisterAggregatedResources(Descriptor, Register, "Turnover", "Оборот", 6);
	RegisterAggregatedResources(Descriptor, Register, "Receipt", "Приход", 6);
	RegisterAggregatedResources(Descriptor, Register, "Expense", "Расход", 6);
	RegisterRecorderSource(Descriptor, BaseName, Detail);
	Return Descriptor;

EndFunction

// A slice keeps one record per set of dimensions: the last one up to the moment,
// or the first one from it.
// СрезПоследних на МоментВремени - значение параметра (SubstituteParameters). Замеры pc20, pc22 (21.11.2026, УХ): у
// независимого регистра - одна дата, `_Period <= <дата>` (КурсыВалют); у подчинённого регистратору - записи по момент
// включительно, `(_Period < <дата> OR _Period = <дата> AND (_RecorderTRef < <таблица> OR _RecorderTRef = <таблица> AND
// _RecorderRRef <= <ссылка>))`, а из записей одного периода - последняя по регистратору, как и без момента (добивка
// в SliceSubquery). Undefined - аргумент не параметр-МоментВремени; Граница и СрезПервых не замерены - отказывает
// ValueLiteral.
Function SliceLastPointInTime(Argument, Base, Context)

	Text = TrimAll(Argument);
	If Left(Text, 1) <> "&" Or StrFind(Text, " ") > 0 Or Not Context.Options.SubstituteParameters Then
		Return Undefined;
	EndIf;
	Value = HierarchyParameterValue(Mid(Text, 2), Context);
	If TypeOf(Value) <> Type("PointInTime") Then
		Return Undefined;
	EndIf;
	Period = VirtualColumn(PeriodColumn(Base), Context);
	MomentDate = ValueLiteral(Value.Date, Context);
	Names = New Array;
	Names.Add("Recorder");
	Names.Add("Регистратор");
	RecorderField = FirstExistingField(Base, Names);
	If IsBlankString(RecorderField) Then
		Return Period + " <= " + MomentDate;
	EndIf;
	Info = CompositeInfo(Base, RecorderField);
	Target = Undefined;
	If Value.Ref <> Undefined Then
		Target = Metadata.FindByType(TypeOf(Value.Ref));
	EndIf;
	If Target = Undefined Or Info = Undefined Or IsBlankString(Info.RefTypeColumn) Or IsBlankString(Info.RefColumn) Then
		Raise StrTemplate(
			"Parameter %1 of SliceLast is a point in time without a reference, or the register keeps no recorder parts"
			+ " to compare it with. That form is not measured, so it is not translated. Pass the point in time of a"
			+ " document, or a date.", Text);
	EndIf;
	Return PointInTimeBoundTest(Period, VirtualColumn(Info.RefTypeColumn, Context),
		VirtualColumn(Info.RefColumn, Context), "<", "<=", MomentDate, ReferenceTypeIdLiteral(Target.FullName(), Context),
		ReferenceLiteral(Value.Ref, Context));

EndFunction

Function SliceSubquery(BaseName, Base, Register, Arguments, Kind, Context)

	Period = ArgumentAt(Arguments, 0);
	VirtualJoins = New Array;
	Condition = ConditionSql(ArgumentAt(Arguments, 1), Base, Context, VirtualJoins);

	PeriodStored = PeriodColumn(Base);
	If PeriodStored = Undefined Then
		Raise StrTemplate("Register %1 is not periodic, a slice is meaningless.", BaseName);
	EndIf;
	PeriodPhysical = VirtualColumn(PeriodStored, Context);

	Dimensions = RegisterColumns(Register, Base, "Dimensions");

	Fields = New Map;
	Select = New Array;
	Partition = New Array;

	For Each Dimension In Dimensions Do
		Partition.Add(VirtualColumn(Dimension.Physical, Context));
	EndDo;
	// Без измерений срез - записи последнего (первого) периода целиком: замер p49x s1 (20.11.2026, УХ,
	// РегистрСведений.МинимальнаяОплатаТрудаРФ): `(SELECT MAX(_Period) …) INNER JOIN регистр ON MAXPERIOD =
	// _Period` - все записи этого периода, без добивки регистратором. Здесь - RANK по периоду.
	Undivided = Partition.Count() = 0;

	// Поля регистра выходят в срез как есть, а составные - всеми своими колонками:
	// одно значение без байта типа и номера таблицы - это уже не ссылка, по нему
	// не пройти ни точкой, ни ВЫРАЗИТЬ.
	Columns = New Map;
	For Each Item In Base.Fields Do
		ColumnList = Base.Columns.Get(Item.Key);
		If ColumnList = Undefined Then
			Continue;
		EndIf;
		Name = OriginalFieldName(Base, Item.Key);
		If Name = Undefined Then
			Continue;
		EndIf;
		Select.Add("        " + VirtualColumn(ColumnList[ColumnList.Count() - 1], Context)
			+ " AS " + QuoteIdentifier(Name, Context));
		Fields.Insert(Item.Key, Name);

		If ColumnList.Count() < 2 Then
			Continue;
		EndIf;
		Aliases = New Array;
		For Each Column In ColumnList Do
			Alias = PartAlias(Name, Column);
			Select.Add("        " + VirtualColumn(Column, Context)
				+ " AS " + QuoteIdentifier(Alias, Context));
			Aliases.Add(Alias);
		EndDo;
		Columns.Insert(Item.Key, Aliases);
	EndDo;

	Direction = ?(Kind = "SLICELAST", "DESC", "ASC");
	Comparison = ?(Kind = "SLICELAST", " <= ", " >= ");

	// Подчинённый регистратору регистр допускает несколько записей одного ключа в одном
	// периоде, и платформа берёт из них определённую: срез последних - с наибольшими типом
	// и ссылкой регистратора и номером строки, срез первых - с наименьшими (d34.py, ERP WE,
	// ItemsPricesOfVendor: 32 таких ключа, 1363 строки совпали только с этой добивкой).
	Tiebreak = New Array;
	RecorderList = Base.Columns.Get("RECORDER");
	If RecorderList = Undefined Then
		RecorderList = Base.Columns.Get(Upper("Регистратор"));
	EndIf;
	If RecorderList = Undefined And RecorderColumn(Base) <> Undefined Then
		RecorderList = New Array;
		RecorderList.Add(RecorderColumn(Base));
	EndIf;
	If RecorderList <> Undefined Then
		For Each Part In RecorderList Do
			If StrFind(Upper(Part), "TREF") > 0 Then
				Tiebreak.Add(VirtualColumn(Part, Context) + " " + Direction);
			EndIf;
		EndDo;
		For Each Part In RecorderList Do
			If StrFind(Upper(Part), "TREF") = 0 Then
				Tiebreak.Add(VirtualColumn(Part, Context) + " " + Direction);
			EndIf;
		EndDo;
		LineNumber = Base.Fields.Get("LINENUMBER");
		If LineNumber = Undefined Then
			LineNumber = Base.Fields.Get(Upper("НомерСтроки"));
		EndIf;
		If LineNumber <> Undefined Then
			Tiebreak.Add(VirtualColumn(LineNumber, Context) + " " + Direction);
		EndIf;
	EndIf;

	Where = New Array;
	Active = ActiveCondition(Base, Context);
	If Not IsBlankString(Active) Then
		Where.Add(Active);
	EndIf;
	SliceBound = Undefined;
	If Not IsBlankString(Period) And Kind = "SLICELAST" Then
		SliceBound = SliceLastPointInTime(Period, Base, Context);
	EndIf;
	If SliceBound <> Undefined Then
		Where.Add(SliceBound);
	ElsIf Not IsBlankString(Period) Then
		Bound = TranslateArgument(Period, Context);
		Restriction = PeriodPhysical + Comparison + Bound;
		// Период-параметр со значением Неопределено платформа не ограничивает: срез берётся
		// по всем записям (негативная батарея 13.11.2026, p08k: СрезПоследних(&Д) при
		// Д = Неопределено - 1 строка у 1С, 0 у SQL). Неопределено приходит в SQL как NULL
		// заглушки; подставленное значение заглушки не оставляет.
		// Пустая дата - тоже «без ограничения»: СрезПоследних(&Д) при Д = ДАТАВРЕМЯ(1, 1, 1)
		// отдаёт те же строки, что и без периода (замер 14.11.2026, УХ КурсыВалют: 8 = 8;
		// полная сверка УХ, РегистрацииВНалоговомОргане: 1С 1 строка, SQL 0).
		EmptyDate = ValueLiteral(Date(1, 1, 1), Context);
		If Not IsBlankString(LoneParameterName(Period))
			And (StrStartsWith(Bound, "@") Or StrStartsWith(Bound, ":")) Then
			Restriction = "(" + Bound + " IS NULL OR " + Bound + " = " + EmptyDate + " OR "
				+ Restriction + ")";
		ElsIf TrimAll(Bound) = EmptyDate Then
			Restriction = "";
		EndIf;
		If Not IsBlankString(Restriction) Then
			Where.Add(Restriction);
		EndIf;
	EndIf;
	If Not IsBlankString(Condition) Then
		Where.Add(Condition);
	EndIf;

	Lines = New Array;
	Lines.Add("    SELECT * FROM (");
	Lines.Add("      SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	If Undivided Then
		Lines.Add("        , RANK() OVER (ORDER BY " + PeriodPhysical + " " + Direction + ") AS SliceRowNumber");
	Else
		Lines.Add("        , ROW_NUMBER() OVER (PARTITION BY " + StrConcat(Partition, ", ")
			+ " ORDER BY " + PeriodPhysical + " " + Direction
			+ ?(Tiebreak.Count() > 0, ", " + StrConcat(Tiebreak, ", "), "") + ") AS SliceRowNumber");
	EndIf;
	Lines.Add("  " + VirtualFrom(Base, Context, VirtualJoins));
	If Where.Count() > 0 Then
		Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));
	EndIf;
	Lines.Add("    ) AS SliceRows WHERE SliceRowNumber = 1");

	Descriptor = DerivedDescriptor(BaseName + "." + Kind, Fields, StrConcat(Lines, Chars.LF));
	For Each Item In Columns Do
		Descriptor.Columns.Insert(Item.Key, Item.Value);
	EndDo;
	// Срез отдаёт все поля регистра, а не только измерения.
	For Each Item In Fields Do
		Entry = New Structure;
		Entry.Insert("LogicalName", BaseName);
		Entry.Insert("FieldName", Item.Value);
		Descriptor.ColumnSources.Insert(Item.Key, Entry);
	EndDo;
	Return Descriptor;

EndFunction

#EndRegion

#Region Parameters

// Names of the parameters the query needs. The form shows them so the analyst
// knows what to fill in.
Function QueryParameterNames(QueryText) Export

	Names = New Array;
	Schema = New QuerySchema;
	Try
		Schema.SetQueryText(QueryText);
	Except
		Return Names;
	EndTry;

	For Each Parameter In Schema.FindParameters() Do
		Names.Add(Parameter.Name);
	EndDo;
	Return Names;

EndFunction

// Values are typed in as plain lines "Name = value"; the kind is inferred from the
// text itself, which keeps the form simple and unambiguous enough in practice.
//
//   Period  = 2026-09-01           -> date
//   Company = 8c90720a-7f45-...    -> reference by uuid
//   Limit   = 100.5                -> number
//   OnlyNew = true                 -> boolean
//   Prefix  = ABC                  -> string
//
Function ParseParameterValues(Text) Export

	Values = New Map;
	If IsBlankString(Text) Then
		Return Values;
	EndIf;

	For Each Line In StrSplit(Text, Chars.LF, False) Do
		Position = StrFind(Line, "=");
		If Position = 0 Then
			Continue;
		EndIf;
		Name = TrimAll(Left(Line, Position - 1));
		Raw = TrimAll(Mid(Line, Position + 1));
		If IsBlankString(Name) Then
			Continue;
		EndIf;
		Values.Insert(Name, ParameterValueFromText(Raw));
	EndDo;

	Return Values;

EndFunction

Function ParameterValueFromText(Raw)

	If IsBlankString(Raw) Then
		Return Undefined;
	EndIf;

	// Параметром передают и список: виды субконто, набор организаций для В (&Список).
	If StrFind(Raw, ",") > 0 And DateFromText(Raw) = Undefined And NumberFromText(Raw) = Undefined Then
		Items = New Array;
		For Each Part In StrSplit(Raw, ",", False) Do
			If Not IsBlankString(Part) Then
				Items.Add(ParameterValueFromText(TrimAll(Part)));
			EndIf;
		EndDo;
		If Items.Count() > 1 Then
			Return Items;
		EndIf;
	EndIf;

	Normalized = Upper(Raw);
	If Normalized = "TRUE" Or Normalized = Upper("Истина") Then
		Return True;
	ElsIf Normalized = "FALSE" Or Normalized = Upper("Ложь") Then
		Return False;
	ElsIf Normalized = "NULL" Or Normalized = "UNDEFINED" Or Normalized = Upper("Неопределено") Then
		Return Undefined;
	EndIf;

	Date = DateFromText(Raw);
	If Date <> Undefined Then
		Return Date;
	EndIf;

	If IsUuid(Raw) Then
		Structure = New Structure;
		Structure.Insert("Uuid", Raw);
		Return Structure;
	EndIf;

	// Ссылку удобнее задавать значением метаданных, а не голым uuid: по uuid тип
	// неизвестен, и такое значение нельзя ни передать платформе, ни проверить.
	Reference = PredefinedValueFromText(Raw);
	If Reference <> Undefined Then
		Return Reference;
	EndIf;

	Number = NumberFromText(Raw);
	If Number <> Undefined Then
		Return Number;
	EndIf;

	Return Raw;

EndFunction

// Значение вида «ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура»
// или «Справочник.Валюты.ПустаяСсылка». Undefined означает «это не путь значения».
Function PredefinedValueFromText(Raw)

	Parts = StrSplit(TrimAll(Raw), ".", False);
	If Parts.Count() < 2 Or Parts.Count() > 3 Then
		Return Undefined;
	EndIf;

	Collection = ManagerCollection(TrimAll(Parts[0]));
	If Collection = Undefined Then
		Return Undefined;
	EndIf;

	Expression = Collection + "." + TrimAll(Parts[1]);
	If Parts.Count() < 3 Or IsEmptyRefName(Parts[2]) Then
		Expression = Expression + ".EmptyRef()";
	Else
		Expression = Expression + "." + TrimAll(Parts[2]);
	EndIf;

	Try
		Return Eval(Expression);
	Except
		Return Undefined;
	EndTry;

EndFunction

Function DateFromText(Raw)

	Digits = StrReplace(StrReplace(StrReplace(StrReplace(Raw, "-", ""), ":", ""), " ", ""), ".", "");
	If StrLen(Digits) <> 8 And StrLen(Digits) <> 14 Then
		Return Undefined;
	EndIf;
	For Index = 1 To StrLen(Digits) Do
		If Not IsDigit(Mid(Digits, Index, 1)) Then
			Return Undefined;
		EndIf;
	EndDo;
	If StrLen(Digits) = 8 Then
		Digits = Digits + "000000";
	EndIf;

	Result = Undefined;
	Try
		Result = Date(Digits);
	Except
		Result = Undefined;
	EndTry;
	Return Result;

EndFunction

Function NumberFromText(Raw)

	// Number() читает текст по локали сеанса: на ERP WE Number("1.5") = 15 (точка там -
	// разделитель групп; негативная батарея ss06). Поэтому части числа собираются из цифр.
	Candidate = TrimAll(StrReplace(Raw, ",", "."));
	Sign = 1;
	If StrStartsWith(Candidate, "-") Or StrStartsWith(Candidate, "+") Then
		Sign = ?(Left(Candidate, 1) = "-", -1, 1);
		Candidate = Mid(Candidate, 2);
	EndIf;
	Parts = StrSplit(Candidate, ".", True);
	If Parts.Count() > 2 Or IsBlankString(Candidate) Then
		Return Undefined;
	EndIf;
	For Each Part In Parts Do
		For Index = 1 To StrLen(Part) Do
			If Not IsDigit(Mid(Part, Index, 1)) Then
				Return Undefined;
			EndIf;
		EndDo;
	EndDo;
	Whole = ?(IsBlankString(Parts[0]), 0, Number(Parts[0]));
	Fraction = 0;
	If Parts.Count() = 2 And Not IsBlankString(Parts[1]) Then
		Fraction = Number(Parts[1]) / Pow(10, StrLen(Parts[1]));
	ElsIf Parts.Count() = 2 And IsBlankString(Parts[0]) Then
		Return Undefined;
	EndIf;
	Return Sign * (Whole + Fraction);

EndFunction

Function IsUuid(Raw)

	If StrLen(Raw) <> 36 Then
		Return False;
	EndIf;
	For Index = 1 To 36 Do
		Char = Lower(Mid(Raw, Index, 1));
		If Index = 9 Or Index = 14 Or Index = 19 Or Index = 24 Then
			If Char <> "-" Then
				Return False;
			EndIf;
		ElsIf Not IsDigit(Char) And StrFind("abcdef", Char) = 0 Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// A reference is stored with its uuid groups rearranged - measured on a live base.
Function ReferenceLiteralFromUuid(Uuid, Context)

	Clean = StrReplace(Uuid, "-", "");
	Hex = Mid(Clean, 17, 4) + Mid(Clean, 21, 12) + Mid(Clean, 13, 4) + Mid(Clean, 9, 4) + Left(Clean, 8);
	Return BinaryLiteral(Hex, Context);

EndFunction

#EndRegion

#Region AccountingRegisters

// Регистр бухгалтерии устроен иначе, чем регистр накопления. У регистра с
// корреспонденцией одна запись - это проводка, и она хранит обе стороны сразу: счёт и
// небалансовые измерения лежат парами колонок Дт и Кт. Виртуальные таблицы, наоборот,
// отдают по строке на сторону, без суффиксов. Поэтому движения сначала раскладываются
// на стороны, а дальше считается как обычно.
//
// Подзапрос собирается не сразу, а когда известно, какие поля спросил внешний запрос:
// платформа урезает группировку до выбранных полей, и без этого корреспонденция
// раздробила бы обороты на строки, которых в 1С нет.
Function IsAccountingRegister(Register)

	Try
		Return Register.ChartOfAccounts <> Undefined;
	Except
		Return False;
	EndTry;

EndFunction

Function HasCorrespondence(Register)

	Try
		Return Register.Correspondence;
	Except
		Return False;
	EndTry;

EndFunction

// Разрешено разделение итогов регистра. Свойство не прочитано - считаем, что разрешено: тогда
// ширина итога обычная, без сужения «спрошены все измерения».
Function TotalsSplitting(Register)

	Try
		Return Register.EnableTotalsSplitting;
	Except
		Return True;
	EndTry;

EndFunction

Function AccountingSides(Register)

	Sides = New Array;
	If HasCorrespondence(Register) Then
		Sides.Add("Dr");
		Sides.Add("Cr");
	Else
		Sides.Add("");
	EndIf;
	Return Sides;

EndFunction

// Балансовые измерения и ресурсы суффикса стороны не имеют. Сам суффикс зависит от
// языка конфигурации: Dr/Cr в английской, Дт/Кт в русской - берём тот, что есть в базе.
Function SideFieldName(Name, Side, IsBalance, Base = Undefined)

	If IsBalance Or IsBlankString(Side) Then
		Return Name;
	EndIf;
	If Base = Undefined Then
		Return Name + Side;
	EndIf;

	Candidates = New Array;
	Candidates.Add(Name + Side);
	Candidates.Add(Name + ?(Side = "Dr", "Дт", "Кт"));
	For Each Candidate In Candidates Do
		If Base.Fields.Get(Upper(Candidate)) <> Undefined Then
			Return Candidate;
		EndIf;
	EndDo;
	Return Name + Side;

EndFunction

// Сторона проводки у регистра без корреспонденции. Имя поля зависит от языка
// конфигурации так же, как имя счёта: ВидДвижения на русской, RecordType на английской.
Function RecordTypeFieldName(Base)

	Candidates = New Array;
	Candidates.Add("RecordType");
	Candidates.Add("ВидДвижения");
	For Each Candidate In Candidates Do
		If Base.Fields.Get(Upper(Candidate)) <> Undefined Then
			Return Candidate;
		EndIf;
	EndDo;
	Return "RecordType";

EndFunction

// Имя поля «счёт» тоже зависит от языка.
Function AccountFieldName(Base, Side)

	Candidates = New Array;
	If IsBlankString(Side) Then
		Candidates.Add("Account");
		Candidates.Add("Счет");
		Candidates.Add("Счёт");
	Else
		Candidates.Add("Account" + Side);
		Candidates.Add("Счет" + ?(Side = "Dr", "Дт", "Кт"));
		Candidates.Add("Счёт" + ?(Side = "Dr", "Дт", "Кт"));
	EndIf;

	For Each Candidate In Candidates Do
		If Base.Fields.Get(Upper(Candidate)) <> Undefined Then
			Return Candidate;
		EndIf;
	EndDo;
	Return Candidates[0];

EndFunction

// Первое из имён, которое действительно есть в таблице.
Function FirstExistingField(Descriptor, Names)

	For Each Name In Names Do
		If Descriptor.Fields.Get(Upper(Name)) <> Undefined Then
			Return Name;
		EndIf;
	EndDo;
	Return "";

EndFunction

Function AccountingColumn(Base, Name, Context)

	Stored = Base.Fields.Get(Upper(TrimAll(Name)));
	If Stored = Undefined Then
		Raise StrTemplate("Field %1 of table %2 has no physical storage.", Name, Base.LogicalName);
	EndIf;
	Return VirtualColumn(Stored, Context);

EndFunction

Function AccountingColumns(Register, Collection)

	Result = New Array;
	Source = Undefined;
	Try
		Source = ?(Collection = "Dimensions", Register.Dimensions, Register.Resources);
	Except
		Source = Undefined;
	EndTry;
	If Source = Undefined Then
		Return Result;
	EndIf;

	For Each Item In Source Do
		Column = New Structure;
		Column.Insert("Name", Item.Name);
		Balance = True;
		Try
			Balance = Item.Balance;
		Except
			Balance = True;
		EndTry;
		Column.Insert("IsBalance", Balance);
		Result.Add(Column);
	EndDo;
	Return Result;

EndFunction

// Слот субконто. Логических имён у этих колонок структура хранения не даёт, поэтому
// они ищутся по физическому имени: _ValueDt1_RRRef, _KindDt1RRef и родня.
Function ExtDimensionSlot(Base, Side, Number)

	Slot = New Structure;
	Slot.Insert("Value", "");
	Slot.Insert("Type", "");
	Slot.Insert("RefType", "");
	Slot.Insert("Kind", "");

	// В именах колонок сторона обозначена Dt и Ct, хотя поля называются Dr и Cr.
	Physical = ?(Side = "Dr", "Dt", ?(Side = "Cr", "Ct", Side));
	ValuePrefix = Upper("_Value" + Physical + Format(Number, "NG=0; NZ=0") + "_");
	KindName = Upper("_Kind" + Physical + Format(Number, "NG=0; NZ=0") + "RRef");

	For Each Column In Base.Unnamed Do
		Upper_ = Upper(Column);
		If Upper_ = KindName Then
			Slot.Kind = Column;
		ElsIf Not StrStartsWith(Upper_, ValuePrefix) Then
			Continue;
		ElsIf StrEndsWith(Upper_, "_RRREF") Then
			Slot.Value = Column;
		ElsIf StrEndsWith(Upper_, "_RTREF") Then
			Slot.RefType = Column;
		ElsIf StrEndsWith(Upper_, "_TYPE") Then
			Slot.Type = Column;
		EndIf;
	EndDo;
	Return Slot;

EndFunction

// Состав типов субконто: тип значения плана видов характеристик, подключённого
// к плану счетов. У самого регистра такого реквизита нет.
// Имя поля-значения субконто: Субконто1, СубконтоДт2, КорСубконто1, ExtDimension1, ExtDimensionCr2,
// BalancedExtDimension1. Вид субконто (ВидСубконто…, ExtDimensionType…) сюда не относится.
Function IsExtDimensionValueName(FieldName)

	Name = Upper(TrimAll(FieldName));
	For Each Head In StrSplit(Upper("Субконто,КорСубконто,ExtDimension,BalancedExtDimension"), ",") Do
		If StrStartsWith(Name, Head) And StrFind(Name, "TYPE") = 0 Then
			Tail = Mid(Name, StrLen(Head) + 1);
			For Each Side In StrSplit(Upper("Дт,Кт,Dr,Cr"), ",") Do
				If StrStartsWith(Tail, Side) Then
					Tail = Mid(Tail, StrLen(Side) + 1);
					Break;
				EndIf;
			EndDo;
			If StrLen(Tail) = 1 And StrFind("123456789", Tail) > 0 Then
				Return True;
			EndIf;
		EndIf;
	EndDo;
	Return False;

EndFunction

Function ExtDimensionValueType(Register)

	Try
		Return Register.ChartOfAccounts.ExtDimensionTypes.Type;
	Except
		Return Undefined;
	EndTry;

EndFunction

Function ExtDimensionCount(Register)

	Try
		Return Register.ChartOfAccounts.MaxExtDimensionCount;
	Except
		Return 0;
	EndTry;

EndFunction

Function ChartOfAccountsInfo(Register, Context)

	Chart = Undefined;
	Try
		Chart = Register.ChartOfAccounts;
	Except
		Chart = Undefined;
	EndTry;
	If Chart = Undefined Then
		Raise "Register has no chart of accounts.";
	EndIf;

	Target = TableDescriptor(Chart.FullName());
	// Логическое имя вида счёта зависит от варианта языка конфигурации, а физическое
	// всегда _Kind - на него и опираемся, если по имени не нашли.
	Kind = Target.Fields.Get("TYPE");
	If Kind = Undefined Then
		Kind = Target.Fields.Get(Upper("Вид"));
	EndIf;
	If Kind = Undefined Then
		For Each Item In Target.Fields Do
			If Upper(Item.Value) = "_KIND" Then
				Kind = Item.Value;
				Break;
			EndIf;
		EndDo;
	EndIf;
	If Kind = Undefined Then
		Raise StrTemplate("Chart of accounts %1 keeps no account kind.", Chart.FullName());
	EndIf;

	Info = New Structure;
	Info.Insert("Table", QualifiedTableName(Target.PhysicalName, Context));
	Info.Insert("Key", PhysicalName(PrimaryKeyColumn(Target), Context));
	Info.Insert("Kind", PhysicalName(Kind, Context));
	Return Info;

EndFunction

// Обороты читают корреспонденцию: КорСчет или КорСубконто есть в аргументах таблицы или в выборке
// текущего оператора. Выборку видно только текстом полей, поэтому поле другого источника с тем же
// именем тоже засчитывается - тогда меняется только разрядность итога, не значения.
Function CorrespondenceUsed(Arguments, Context)

	Texts = New Array;
	For Each Argument In Arguments Do
		Texts.Add(String(Argument));
	EndDo;
	Try
		For Each Field In Context.Operator.SelectedFields Do
			Texts.Add(String(Field));
		EndDo;
	Except
		// Описание строится и вне оператора (разбор состава полей) - тогда только аргументы.
	EndTry;
	Marks = StrSplit(Upper("КорСчет,КорСчёт,КорСубконто,BalancedAccount,BalancedExtDimension"), ",");
	For Each Text In Texts Do
		Upper_ = Upper(Text);
		For Each Mark In Marks Do
			If StrFind(Upper_, Mark) > 0 Then
				Return True;
			EndIf;
		EndDo;
	EndDo;
	Return False;

EndFunction

// Описание виртуальной таблицы регистра бухгалтерии. Текст подзапроса здесь не
// собирается - только состав полей и всё, что понадобится при сборке.
Function AccountingDescriptor(BaseName, Base, Register, Kind, Arguments, Context)

	Dimensions = AccountingColumns(Register, "Dimensions");
	Resources = AccountingColumns(Register, "Resources");
	Slots = ExtDimensionCount(Register);

	// Виды субконто перенумеровывают колонки: Субконто1 - это первый заказанный вид.
	Roles = AccountingArguments(Kind);
	TypeList = ExtDimensionTypeList(RoleArgument(Arguments, Roles.ExtDimensionTypes), Context);
	CorrTypeList = ExtDimensionTypeList(RoleArgument(Arguments, Roles.CorrExtDimensionTypes), Context);
	Exposed = Slots;
	If TypeList <> Undefined And TypeList.Count() > 0
		And Kind <> "RECORDS" And Kind <> "DRCRTURNOVERS" Then
		Exposed = TypeList.Count();
	EndIf;

	Fields = New Map;
	Fields.Insert("ACCOUNT", "Account");
	Fields.Insert(Upper("Счет"), "Account");
	Fields.Insert(Upper("Счёт"), "Account");

	For Each Dimension In Dimensions Do
		Fields.Insert(Upper(Dimension.Name), Dimension.Name);
	EndDo;
	// Состав колонок ищут по тому имени, которым поле назвали в запросе, поэтому
	// части составной ссылки регистрируются под обоими именами субконто.
	SubcontoColumns = New Map;
	For Number = 1 To Exposed Do
		Name = "ExtDimension" + Format(Number, "NG=0; NZ=0");
		Russian = "Субконто" + Format(Number, "NG=0; NZ=0");
		Fields.Insert(Upper(Name), Name);
		Fields.Insert(Upper(Russian), Name);
		SubcontoColumns.Insert(Upper(Name), ExtDimensionPartNames(Name));
		SubcontoColumns.Insert(Upper(Russian), ExtDimensionPartNames(Name));
	EndDo;

	If Kind = "RECORDS" Then
		// Движения с субконто отдают таблицу движений как есть плюс раскрытые слоты.
		Fields = New Map;
		For Each Item In Base.Fields Do
			Fields.Insert(Item.Key, OriginalFieldName(Base, Item.Key));
		EndDo;
		SubcontoColumns = New Map;
		// Составное поле регистра - регистратор - выходит и частями (тип и ссылка): без них
		// УПОРЯДОЧИТЬ ПО Регистратор шёл по одной ссылке, а платформа - по типу, затем по ссылке
		// (замер ord o1, 19.11.2026, УХ: ORDER BY Period_, RecorderTRef, RecorderRRef, LineNo_);
		// с ПЕРВЫЕ N отбирались другие строки.
		For Each Item In Base.Fields Do
			ColumnList = Base.Columns.Get(Item.Key);
			Name = OriginalFieldName(Base, Item.Key);
			If ColumnList = Undefined Or ColumnList.Count() < 2 Or Name = Undefined Then
				Continue;
			EndIf;
			Aliases = New Array;
			For Each Column In ColumnList Do
				Aliases.Add(PartAlias(Name, Column));
			EndDo;
			SubcontoColumns.Insert(Item.Key, Aliases);
		EndDo;
		For Each Side In AccountingSides(Register) Do
			For Number = 1 To Slots Do
				RegisterExtDimensionNames(Fields, SubcontoColumns,
					ExtDimensionSlot(Base, Side, Number),
					"ExtDimension" + Side + Format(Number, "NG=0; NZ=0"), Side, Number);
			EndDo;
		EndDo;
	EndIf;

	If Kind = "DRCRTURNOVERS" Then
		Fields = New Map;
		SubcontoColumns = New Map;
		For Each Side In AccountingSides(Register) Do
			Fields.Insert(Upper("Account" + Side), "Account" + Side);
			Fields.Insert(Upper("Счет" + ?(Side = "Dr", "Дт", "Кт")), "Account" + Side);
			For Number = 1 To Slots Do
				RegisterExtDimensionNames(Fields, SubcontoColumns,
					ExtDimensionSlot(Base, Side, Number),
					"ExtDimension" + Side + Format(Number, "NG=0; NZ=0"), Side, Number);
			EndDo;
		EndDo;
		For Each Dimension In Dimensions Do
			For Each Side In AccountingSides(Register) Do
				Name = SideFieldName(Dimension.Name, Side, Dimension.IsBalance, Base);
				Fields.Insert(Upper(Name), Name);
			EndDo;
		EndDo;
	EndIf;

	If Kind = "TURNOVERS" And HasCorrespondence(Register) Then
		// Корреспондирующая сторона проводки: у оборотов она видна отдельными полями.
		Fields.Insert(Upper("BalancedAccount"), "BalancedAccount");
		Fields.Insert(Upper("КорСчет"), "BalancedAccount");
		Fields.Insert(Upper("КорСчёт"), "BalancedAccount");
		For Number = 1 To Slots Do
			Suffix = Format(Number, "NG=0; NZ=0");
			Name = "BalancedExtDimension" + Suffix;
			Fields.Insert(Upper(Name), Name);
			Fields.Insert(Upper("КорСубконто" + Suffix), Name);
			SubcontoColumns.Insert(Upper(Name), ExtDimensionPartNames(Name));
			SubcontoColumns.Insert(Upper("КорСубконто" + Suffix), ExtDimensionPartNames(Name));
		EndDo;
		For Each Dimension In Dimensions Do
			If Dimension.IsBalance Then
				Continue;
			EndIf;
			Fields.Insert(Upper(Dimension.Name + "Balanced"), Dimension.Name + "Balanced");
			Fields.Insert(Upper(Dimension.Name + "Кор"), Dimension.Name + "Balanced");
			Fields.Insert(Upper("Кор" + Dimension.Name), Dimension.Name + "Balanced");
		EndDo;
	EndIf;

	ZeroNames = New Array;
	For Each Resource In Resources Do
		If Kind = "RECORDS" Then
			Break;
		ElsIf Kind = "DRCRTURNOVERS" Then
			If Resource.IsBalance Then
				RegisterAlias(Fields, Resource.Name, "Turnover", "Оборот", Resource.Name + "Turnover");
				ZeroNames.Add(Resource.Name + "Turnover");
			Else
				RegisterAlias(Fields, Resource.Name, "TurnoverDr", "ОборотДт",
					Resource.Name + "TurnoverDr");
				RegisterAlias(Fields, Resource.Name, "TurnoverCr", "ОборотКт",
					Resource.Name + "TurnoverCr");
				ZeroNames.Add(Resource.Name + "TurnoverDr");
				ZeroNames.Add(Resource.Name + "TurnoverCr");
			EndIf;
			Continue;
		ElsIf Kind = "TURNOVERS" Then
			RegisterAlias(Fields, Resource.Name, "Turnover", "Оборот", Resource.Name + "Turnover");
			RegisterAlias(Fields, Resource.Name, "TurnoverDr", "ОборотДт", Resource.Name + "TurnoverDr");
			RegisterAlias(Fields, Resource.Name, "TurnoverCr", "ОборотКт", Resource.Name + "TurnoverCr");
			ZeroNames.Add(Resource.Name + "Turnover");
			ZeroNames.Add(Resource.Name + "TurnoverDr");
			ZeroNames.Add(Resource.Name + "TurnoverCr");
			If HasCorrespondence(Register) And Not Resource.IsBalance Then
				RegisterAlias(Fields, Resource.Name, "BalancedTurnover", "КорОборот",
					Resource.Name + "BalancedTurnover");
				RegisterAlias(Fields, Resource.Name, "BalancedTurnoverDr", "КорОборотДт",
					Resource.Name + "BalancedTurnoverDr");
				RegisterAlias(Fields, Resource.Name, "BalancedTurnoverCr", "КорОборотКт",
					Resource.Name + "BalancedTurnoverCr");
				ZeroNames.Add(Resource.Name + "BalancedTurnover");
				ZeroNames.Add(Resource.Name + "BalancedTurnoverDr");
				ZeroNames.Add(Resource.Name + "BalancedTurnoverCr");
			EndIf;
		ElsIf Kind = "BALANCE" Then
			RegisterAlias(Fields, Resource.Name, "Balance", "Остаток", Resource.Name + "Balance");
			RegisterAlias(Fields, Resource.Name, "BalanceDr", "ОстатокДт", Resource.Name + "BalanceDr");
			RegisterAlias(Fields, Resource.Name, "BalanceCr", "ОстатокКт", Resource.Name + "BalanceCr");
			RegisterAlias(Fields, Resource.Name, "SplittedBalanceDr", "РазвернутыйОстатокДт",
				Resource.Name + "SplittedBalanceDr");
			RegisterAlias(Fields, Resource.Name, "SplittedBalanceCr", "РазвернутыйОстатокКт",
				Resource.Name + "SplittedBalanceCr");
			ZeroNames.Add(Resource.Name + "Balance");
			ZeroNames.Add(Resource.Name + "BalanceDr");
			ZeroNames.Add(Resource.Name + "BalanceCr");
			ZeroNames.Add(Resource.Name + "SplittedBalanceDr");
			ZeroNames.Add(Resource.Name + "SplittedBalanceCr");
		Else
			RegisterAlias(Fields, Resource.Name, "OpeningBalance", "НачальныйОстаток",
				Resource.Name + "OpeningBalance");
			RegisterAlias(Fields, Resource.Name, "OpeningBalanceDr", "НачальныйОстатокДт",
				Resource.Name + "OpeningBalanceDr");
			RegisterAlias(Fields, Resource.Name, "OpeningBalanceCr", "НачальныйОстатокКт",
				Resource.Name + "OpeningBalanceCr");
			RegisterAlias(Fields, Resource.Name, "Turnover", "Оборот", Resource.Name + "Turnover");
			RegisterAlias(Fields, Resource.Name, "TurnoverDr", "ОборотДт", Resource.Name + "TurnoverDr");
			RegisterAlias(Fields, Resource.Name, "TurnoverCr", "ОборотКт", Resource.Name + "TurnoverCr");
			RegisterAlias(Fields, Resource.Name, "ClosingBalance", "КонечныйОстаток",
				Resource.Name + "ClosingBalance");
			RegisterAlias(Fields, Resource.Name, "ClosingBalanceDr", "КонечныйОстатокДт",
				Resource.Name + "ClosingBalanceDr");
			RegisterAlias(Fields, Resource.Name, "ClosingBalanceCr", "КонечныйОстатокКт",
				Resource.Name + "ClosingBalanceCr");
			RegisterAlias(Fields, Resource.Name, "OpeningSplittedBalanceDr",
				"НачальныйРазвернутыйОстатокДт", Resource.Name + "OpeningSplittedBalanceDr");
			RegisterAlias(Fields, Resource.Name, "OpeningSplittedBalanceCr",
				"НачальныйРазвернутыйОстатокКт", Resource.Name + "OpeningSplittedBalanceCr");
			RegisterAlias(Fields, Resource.Name, "ClosingSplittedBalanceDr",
				"КонечныйРазвернутыйОстатокДт", Resource.Name + "ClosingSplittedBalanceDr");
			RegisterAlias(Fields, Resource.Name, "ClosingSplittedBalanceCr",
				"КонечныйРазвернутыйОстатокКт", Resource.Name + "ClosingSplittedBalanceCr");
			ZeroNames.Add(Resource.Name + "OpeningSplittedBalanceDr");
			ZeroNames.Add(Resource.Name + "OpeningSplittedBalanceCr");
			ZeroNames.Add(Resource.Name + "ClosingSplittedBalanceDr");
			ZeroNames.Add(Resource.Name + "ClosingSplittedBalanceCr");
			ZeroNames.Add(Resource.Name + "OpeningBalance");
			ZeroNames.Add(Resource.Name + "OpeningBalanceDr");
			ZeroNames.Add(Resource.Name + "OpeningBalanceCr");
			ZeroNames.Add(Resource.Name + "Turnover");
			ZeroNames.Add(Resource.Name + "TurnoverDr");
			ZeroNames.Add(Resource.Name + "TurnoverCr");
			ZeroNames.Add(Resource.Name + "ClosingBalance");
			ZeroNames.Add(Resource.Name + "ClosingBalanceDr");
			ZeroNames.Add(Resource.Name + "ClosingBalanceCr");
		EndIf;
	EndDo;

	Periodicity = RoleArgument(Arguments, AccountingArguments(Kind).Periodicity);
	Detail = Undefined;
	If Not IsBlankString(Periodicity) Then
		Detail = PeriodDetail(Periodicity, Base, Context);
		If Kind = "BALANCEANDTURNOVERS" Then
			AddRecorderTypePart(Detail, Context);
		EndIf;
		// Сначала общие имена периода, потом имена периодичности: при Авто ПериодМесяц и
		// прочие - свои колонки, и общее «Period» их затирало (сверка battery28: 1С 39
		// строк, SQL 3450).
		RegisterPeriodAliases(Fields);
		For Each Item In Detail.Aliases Do
			Fields.Insert(Item.Key, Item.Value);
		EndDo;
	EndIf;

	Descriptor = DerivedDescriptor(BaseName + "." + Kind, Fields, "");
	// Отсев нулевых строк идёт по тем ресурсам, которые выбраны снаружи: у регистра
	// их несколько, и ненулевое количество при нулевой сумме - обычное дело.
	Descriptor.ZeroFilter = ZeroNames;
	// Отсев идёт ровно по тем полям, которые спросили: вид счёта известен всегда,
	// поэтому ненулевое сальдо обязательно видно в одной из половин.

	Plan = New Structure;
	Plan.Insert("BaseName", BaseName);
	Plan.Insert("Base", Base);
	Plan.Insert("Register", Register);
	Plan.Insert("Kind", Kind);
	Plan.Insert("Dimensions", Dimensions);
	Plan.Insert("Resources", Resources);
	Plan.Insert("Slots", Slots);
	Plan.Insert("Exposed", Exposed);
	Plan.Insert("TypeList", TypeList);
	Plan.Insert("CorrTypeList", CorrTypeList);
	Plan.Insert("ExtDimensionTypes", New Array);
	Plan.Insert("CorrExtDimensionTypes", New Array);
	Plan.Insert("Arguments", Arguments);
	Descriptor.Insert("AccountingPlan", Plan);

	// Итоги бухрегистра платформа приводит сама: CAST(SUM(...) AS NUMERIC(p + 12 / p + 13, s)),
	// ссылка на колонку переводится в том же типе (AggregatedResourceSql). Замер 16.11.2026, УХ
	// Хозрасчетный, ресурс Число(15, 2): обороты Дт и Кт, остатки, начальный остаток - +12; оборот
	// и конечный остаток - +13; ОборотыДтКт - +12; с субконто и периодичностью так же. Не замерены
	// корреспондирующие обороты, развёрнутые начальный и конечный остатки - их тип прежний.
	// С корреспонденцией (КорСчет или КорСубконто в условии или в выборке) все обороты - +6, и
	// сальдовый тоже (замер 17.11.2026, УХ, kcorp k1, k2, k4; СУММА поверх - ещё +6, k5).
	If Kind = "TURNOVERS" And HasCorrespondence(Register) And CorrespondenceUsed(Arguments, Context) Then
		RegisterAggregatedResources(Descriptor, Register, "TurnoverDr", "ОборотДт", 6);
		RegisterAggregatedResources(Descriptor, Register, "TurnoverCr", "ОборотКт", 6);
		RegisterAggregatedResources(Descriptor, Register, "Turnover", "Оборот", 6);
	ElsIf Kind = "TURNOVERS" Then
		RegisterAggregatedResources(Descriptor, Register, "TurnoverDr", "ОборотДт", 12);
		RegisterAggregatedResources(Descriptor, Register, "TurnoverCr", "ОборотКт", 12);
		RegisterAggregatedResources(Descriptor, Register, "Turnover", "Оборот", 13);
	ElsIf Kind = "BALANCE" Then
		RegisterAggregatedResources(Descriptor, Register, "Balance", "Остаток", 12);
		RegisterAggregatedResources(Descriptor, Register, "BalanceDr", "ОстатокДт", 12);
		RegisterAggregatedResources(Descriptor, Register, "BalanceCr", "ОстатокКт", 12);
		RegisterAggregatedResources(Descriptor, Register, "SplittedBalanceDr", "РазвернутыйОстатокДт", 12);
		RegisterAggregatedResources(Descriptor, Register, "SplittedBalanceCr", "РазвернутыйОстатокКт", 12);
	ElsIf Kind = "DRCRTURNOVERS" Then
		RegisterAggregatedResources(Descriptor, Register, "Turnover", "Оборот", 12);
	ElsIf Kind <> "RECORDS" Then
		RegisterAggregatedResources(Descriptor, Register, "OpeningBalance", "НачальныйОстаток", 12);
		RegisterAggregatedResources(Descriptor, Register, "OpeningBalanceDr", "НачальныйОстатокДт", 12);
		RegisterAggregatedResources(Descriptor, Register, "OpeningBalanceCr", "НачальныйОстатокКт", 12);
		RegisterAggregatedResources(Descriptor, Register, "TurnoverDr", "ОборотДт", 12);
		RegisterAggregatedResources(Descriptor, Register, "TurnoverCr", "ОборотКт", 12);
		RegisterAggregatedResources(Descriptor, Register, "Turnover", "Оборот", 13);
		RegisterAggregatedResources(Descriptor, Register, "ClosingBalance", "КонечныйОстаток", 13);
		RegisterAggregatedResources(Descriptor, Register, "ClosingBalanceDr", "КонечныйОстатокДт", 13);
		RegisterAggregatedResources(Descriptor, Register, "ClosingBalanceCr", "КонечныйОстатокКт", 13);
	EndIf;

	For Each Item In SubcontoColumns Do
		Descriptor.Columns.Insert(Item.Key, Item.Value);
	EndDo;
	If Detail <> Undefined Then
		For Each Item In Detail.Parts Do
			Descriptor.Columns.Insert(Item.Key, Item.Value);
		EndDo;
		RegisterRecorderSource(Descriptor, BaseName, Detail);
	EndIf;

	// Поля виртуальной таблицы - это поля регистра, по ним можно идти через точку.
	RegisterColumnSources(Descriptor, BaseName, Dimensions, Resources);
	For Each Item In Fields Do
		If Base.Fields.Get(Upper(Item.Value)) = Undefined Then
			Continue;
		EndIf;
		Origin = New Structure;
		Origin.Insert("LogicalName", BaseName);
		Origin.Insert("FieldName", Item.Value);
		Descriptor.ColumnSources.Insert(Item.Key, Origin);
	EndDo;

	// Счёт ведёт на план счетов; регистрируем происхождение под всеми его именами.
	Origin = New Structure;
	Origin.Insert("LogicalName", BaseName);
	Origin.Insert("FieldName", AccountFieldName(Base, ?(HasCorrespondence(Register), "Dr", "")));
	For Each Item In Fields Do
		// Корреспондирующий счёт ведёт на тот же план счетов, что и свой.
		If StrStartsWith(Upper(Item.Value), "ACCOUNT")
			Or StrStartsWith(Upper(Item.Value), "BALANCEDACCOUNT") Then
			Descriptor.ColumnSources.Insert(Item.Key, Origin);
		EndIf;
	EndDo;

	// Субконто - не поле регистра, а значение вида характеристики. Замерено: состав
	// типов у него один и тот же при любых видах субконто, платформа его не сужает.
	ExtType = ExtDimensionValueType(Register);
	If ExtType <> Undefined Then
		For Each Item In Fields Do
			Canonical = Upper(Item.Value);
			If StrStartsWith(Canonical, "EXTDIMENSIONTYPE")
				Or StrStartsWith(Canonical, "BALANCEDEXTDIMENSIONTYPE") Then
				// Вид субконто - обычная ссылка на план видов характеристик, не составная.
				Continue;
			EndIf;
			If Not StrStartsWith(Canonical, "EXTDIMENSION")
				And Not StrStartsWith(Canonical, "BALANCEDEXTDIMENSION") Then
				Continue;
			EndIf;
			SubcontoOrigin = New Structure;
			SubcontoOrigin.Insert("LogicalName", BaseName);
			SubcontoOrigin.Insert("FieldName", Item.Value);
			SubcontoOrigin.Insert("Type", ExtType);
			SubcontoOrigin.Insert("Characteristic", True);
			Descriptor.ColumnSources.Insert(Item.Key, SubcontoOrigin);
		EndDo;
	EndIf;

	Return Descriptor;

EndFunction

// Движения с субконто: таблица движений как есть, слоты субконто выведены отдельными
// колонками. Ничего не агрегируется - это просто движения.
Function AccountingRecords(Plan, Base, Register, Start, Finish, Context)

	Limit = RecordsLimit(RoleArgument(Plan.Arguments, 4), Context);
	OrderBy = "";
	If Limit > 0 Then
		OrderBy = RecordsOrder(RoleArgument(Plan.Arguments, 3), Base, Context);
		If IsBlankString(OrderBy) Then
			AddOnce(Context.Warnings, "RecordsWithExtDimensions has a row limit and no ordering: the platform"
				+ " writes TOP without ORDER BY too, so which records come back is up to the DBMS.");
		EndIf;
	EndIf;

	Select = New Array;
	For Each Item In Base.Fields Do
		Name = OriginalFieldName(Base, Item.Key);
		If Name = Undefined Then
			Continue;
		EndIf;
		Select.Add("    " + VirtualColumn(Item.Value, Context) + " AS " + QuoteIdentifier(Name, Context));
		// Части составного поля (регистратор) - как их регистрирует AccountingDescriptor.
		ColumnList = Base.Columns.Get(Item.Key);
		If ColumnList <> Undefined And ColumnList.Count() > 1 Then
			For Each Column In ColumnList Do
				Select.Add("    " + VirtualColumn(Column, Context) + " AS "
					+ QuoteIdentifier(PartAlias(Name, Column), Context));
			EndDo;
		EndIf;
	EndDo;

	For Each Side In AccountingSides(Register) Do
		For Number = 1 To Plan.Slots Do
			Slot = ExtDimensionSlot(Base, Side, Number);
			Suffix = Side + Format(Number, "NG=0; NZ=0");
			AddExtDimensionColumns(Select, Undefined, Slot, "ExtDimension" + Suffix, Context);
			If Not IsBlankString(Slot.Kind) Then
				Select.Add("    " + VirtualColumn(Slot.Kind, Context)
					+ " AS " + QuoteIdentifier("ExtDimensionType" + Suffix, Context));
			EndIf;
		EndDo;
	EndDo;

	Where = New Array;
	Joins = New Array;
	// В условии движений субконто называются со стороной - СубконтоДт1, СубконтоКт1,
	// как в ОборотыДтКт: слоты ставятся в соответствие тем же описателем.
	AddCondition(Where, RecordsExtDimensionCondition(RoleArgument(Plan.Arguments,
		AccountingArguments("RECORDS").Condition), Plan, Base, Context, Joins));
	Period = VirtualColumn(PeriodColumn(Base), Context);
	If Not IsBlankString(Start) Then
		Where.Add(Period + " >= " + Start);
	EndIf;
	If Not IsBlankString(Finish) Then
		Where.Add(Period + " <= " + Finish);
	EndIf;

	Postgres = Context.Options.Dialect = "PostgreSQL";
	Lines = New Array;
	Lines.Add("  SELECT" + ?(Limit > 0 And Not Postgres, " TOP " + Format(Limit, "NG=0"), ""));
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("  FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS " + VirtualAlias());
	AddNavigationJoins(Lines, Joins, "  ");
	If Where.Count() > 0 Then
		Lines.Add("  WHERE " + StrConcat(Where, Chars.LF + "    AND "));
	EndIf;
	If Not IsBlankString(OrderBy) Then
		Lines.Add("  ORDER BY " + OrderBy);
	EndIf;
	If Limit > 0 And Postgres Then
		Lines.Add("  LIMIT " + Format(Limit, "NG=0"));
	EndIf;
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Условие ДвиженияССубконто. Поля субконто (СубконтоДтN, СубконтоКтN) платформа проверяет по таблице значений субконто
// _AccRgED: на каждое упомянутое поле - своё соединение по ключам строки и стороне (_Correspond: 0 - Дт, 1 - Кт), номер
// слота не учитывается, условие целиком - над соединёнными строками, DISTINCT ключей (замер sk01, sm01-sm07, se01-se04,
// 22.11.2026, УХ). Здесь то же - EXISTS: условие переводится как обычно, колонками слота, и колонки слота каждого поля
// (VT._ValueCt1_*) заменяются колонками значения его псевдонима. Без полей субконто - прежний перевод.
Function RecordsExtDimensionCondition(Condition, Plan, Base, Context, Joins)

	DrCrBase = DrCrConditionBase(Plan, Base, Context);
	If IsBlankString(Condition) Then
		Return "";
	EndIf;
	Mentioned = New Array;
	For Each Token In Tokenize(Condition) Do
		If Token.Kind <> "Name" Then
			Continue;
		EndIf;
		Head = Upper(StrSplit(Token.Value, ".")[0]);
		Slot = SidedExtDimension(Head);
		If Slot <> Undefined And Mentioned.Find(Slot.Key) = Undefined Then
			Mentioned.Add(Slot.Key);
		EndIf;
	EndDo;
	If Mentioned.Count() = 0 Then
		Return ConditionSql(Condition, DrCrBase, Context, Joins);
	EndIf;
	If Context.Options.Dialect = "PostgreSQL" Then
		Raise "RecordsWithExtDimensions is given a condition on an ext dimension; the platform checks it over the"
			+ " ext dimensions table of the register, and that is translated for MS SQL only.";
	EndIf;
	// Таблица значений субконто - под своим логическим именем (виртуальная таблица Субконто: cg22).
	Storage = StorageStructure();
	Values = Undefined;
	For Each Suffix In StrSplit(".Субконто,.ExtDimensions", ",") Do
		For Each Owner In StrSplit(Plan.Register.FullName() + "," + Plan.BaseName, ",") Do
			If Values = Undefined Then
				Values = Storage.Get(Upper(Owner + Suffix));
			EndIf;
		EndDo;
	EndDo;
	If Values = Undefined Then
		Raise StrTemplate("RecordsWithExtDimensions of %1 is given a condition on an ext dimension: the platform checks"
			+ " it over the ext dimensions table of the register, and that table is not found in the storage structure"
			+ " of this infobase.", Plan.BaseName);
	EndIf;

	Local = New Array;
	Saved = Context.Options.Property("ExtDimensionValuesTable");
	Context.Options.Insert("ExtDimensionValuesTable", True);
	Try
		Sql = ConditionSql(Condition, DrCrBase, Context, Local);
	Except
		If Not Saved Then
			Context.Options.Delete("ExtDimensionValuesTable");
		EndIf;
		Raise;
	EndTry;
	If Not Saved Then
		Context.Options.Delete("ExtDimensionValuesTable");
	EndIf;
	Lines = New Array;
	For Each Navigation In Local Do
		Lines.Add("LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias + " ON " + JoinCondition(Navigation));
	EndDo;
	Inner = StrConcat(Lines, " ");

	Keys = StrSplit("_RecorderTRef,_RecorderRRef,_LineNo,_Period,_PeriodAdjustment", ",");
	From = New Array;
	Links = New Array;
	Number = 0;
	For Each Key_ In Mentioned Do
		Number = Number + 1;
		Alias = VirtualAlias() + "E" + Format(Number, "NG=0");
		Parts = StrSplit(Key_, ":");
		Prefix = Upper(VirtualAlias() + "._Value" + Parts[0] + Parts[1] + "_");
		For Each Physical In DescriptorPhysicals(Values) Do
			If StrStartsWith(Upper(Physical), "_VALUE_") Then
				Suffix = Mid(Physical, StrLen("_Value_") + 1);
				Sql = ReplaceIgnoringCase(Sql, Prefix + Suffix, Alias + "." + Physical);
				Inner = ReplaceIgnoringCase(Inner, Prefix + Suffix, Alias + "." + Physical);
			EndIf;
		EndDo;
		If StrFind(Upper(Sql + " " + Inner), Prefix) > 0 Then
			Raise StrTemplate("RecordsWithExtDimensions is given a condition on %1, whose value part is not stored in the"
				+ " ext dimensions table of the register; the platform checks the condition over that table.",
				"ExtDimension" + Parts[0] + Parts[1]);
		EndIf;
		From.Add(QualifiedTableName(Values.PhysicalName, Context) + " AS " + Alias);
		For Each Column In Keys Do
			Links.Add(Alias + "." + Column + " = " + VirtualAlias() + "." + Column);
		EndDo;
		Links.Add(Alias + "._Correspond = " + ?(Parts[0] = "Dt", "0", "1"));
	EndDo;
	Return "EXISTS (SELECT 1 FROM " + StrConcat(From, " CROSS JOIN ") + ?(IsBlankString(Inner), "", " " + Inner)
		+ " WHERE " + StrConcat(Links, " AND ") + " AND " + Sql + ")";

EndFunction

// Все физические колонки описания таблицы: Physicals у таблиц итогов, иначе Fields, Columns и Unnamed.
Function DescriptorPhysicals(Descriptor)

	Result = New Array;
	If Descriptor.Property("Physicals") And Descriptor.Physicals <> Undefined Then
		For Each Physical In Descriptor.Physicals Do
			Result.Add(Physical);
		EndDo;
		Return Result;
	EndIf;
	For Each Pair In Descriptor.Fields Do
		If Result.Find(Pair.Value) = Undefined Then
			Result.Add(Pair.Value);
		EndIf;
	EndDo;
	For Each Pair In Descriptor.Columns Do
		For Each Physical In Pair.Value Do
			If Result.Find(Physical) = Undefined Then
				Result.Add(Physical);
			EndIf;
		EndDo;
	EndDo;
	For Each Physical In Descriptor.Unnamed Do
		If Result.Find(Physical) = Undefined Then
			Result.Add(Physical);
		EndIf;
	EndDo;
	Return Result;

EndFunction

// Поле субконто со стороной (СубконтоДт2, ExtDimensionCr1): ключ «Dt:2» / «Ct:1», иначе Undefined.
Function SidedExtDimension(UpperName)

	For Each Head In StrSplit(Upper("Субконто,ExtDimension"), ",") Do
		If Not StrStartsWith(UpperName, Head) Then
			Continue;
		EndIf;
		Tail = Mid(UpperName, StrLen(Head) + 1);
		Side = "";
		If StrStartsWith(Tail, Upper("Дт")) Or StrStartsWith(Tail, "DR") Then
			Side = "Dt";
		ElsIf StrStartsWith(Tail, Upper("Кт")) Or StrStartsWith(Tail, "CR") Then
			Side = "Ct";
		EndIf;
		If IsBlankString(Side) Then
			Return Undefined;
		EndIf;
		Tail = Mid(Tail, 3);
		If StrLen(Tail) = 1 And StrFind("123456789", Tail) > 0 Then
			Return New Structure("Key", Side + ":" + Tail);
		EndIf;
	EndDo;
	Return Undefined;

EndFunction

// Замена подстроки без учёта регистра.
Function ReplaceIgnoringCase(Text, Old, New_)

	Result = "";
	Rest = Text;
	Position = StrFind(Upper(Rest), Upper(Old));
	While Position > 0 Do
		Result = Result + Left(Rest, Position - 1) + New_;
		Rest = Mid(Rest, Position + StrLen(Old));
		Position = StrFind(Upper(Rest), Upper(Old));
	EndDo;
	Return Result + Rest;

EndFunction

// Пятый параметр ДвиженияССубконто - «Первые». Замеры sm_ds1-sm_ds15 (21.11.2026, УХ): платформа пишет
// `SELECT TOP N` в подзапросе движений; без него (пусто или 0) - ни TOP, ни ORDER BY, четвёртый параметр
// тогда отбрасывается (sm_ds4, sm_ds7). Прежде оба параметра давали отказ (УХ ПолучитьОтборРСБУ). Ноль - нет
// ограничения.
Function RecordsLimit(Raw, Context)

	Text = TrimAll(Raw);
	If IsBlankString(Text) Then
		Return 0;
	EndIf;
	Tokens = Tokenize(Text);
	Value = Undefined;
	If Tokens.Count() = 1 And Tokens[0].Kind = "Number" Then
		Value = Number(Tokens[0].Value);
	ElsIf Tokens.Count() = 1 And Tokens[0].Kind = "Parameter" Then
		If Context.Options.SubstituteParameters Then
			Value = Context.Options.ParameterValues.Get(TrimAll(Tokens[0].Value));
		EndIf;
		If TypeOf(Value) <> Type("Number") Then
			Raise StrTemplate("RecordsWithExtDimensions takes the number of records from parameter &%1, and it"
				+ " has no numeric value here, so the row limit is unknown. Supply the value of &%1 above.",
				TrimAll(Tokens[0].Value));
		EndIf;
	Else
		Raise StrTemplate("RecordsWithExtDimensions is given the number of records as %1; a number or a"
			+ " parameter with a value is translated.", Text);
	EndIf;
	Return Max(Int(Value), 0);

EndFunction

// Четвёртый параметр ДвиженияССубконто - одно поле с ВОЗР/УБЫВ (два поля через запятую платформа не
// принимает, sm_ds5). Замеры: Период - `ORDER BY T2._Period DESC` (sm_ds2), Регистратор - `ORDER BY
// T2._RecorderTRef, T2._RecorderRRef` (sm_ds9), счёт - `T2._AccountDtRRef DESC` (sm_ds10), измерение -
// его колонка (sm_ds11), НомерСтроки ВОЗР - `T2._LineNo` (sm_ds12). Субконто и составное измерение не
// замерены - отказ. Пустая строка - порядка нет.
Function RecordsOrder(Raw, Base, Context)

	Tokens = Tokenize(TrimAll(Raw));
	If Tokens.Count() = 0 Then
		Return "";
	EndIf;
	Suffix = "";
	If Tokens.Count() = 2 And Tokens[1].Kind = "Name" Then
		Word = Upper(Tokens[1].Value);
		If Word = "DESC" Or Word = Upper("Убыв") Then
			Suffix = " DESC";
		ElsIf Word <> "ASC" And Word <> Upper("Возр") Then
			Suffix = Undefined;
		EndIf;
	ElsIf Tokens.Count() <> 1 Then
		Suffix = Undefined;
	EndIf;
	FieldKey = ?(Tokens[0].Kind = "Name", Upper(TrimAll(Tokens[0].Value)), "");
	Stored = ?(IsBlankString(FieldKey), Undefined, Base.Fields.Get(FieldKey));
	ColumnList = ?(IsBlankString(FieldKey), Undefined, Base.Columns.Get(FieldKey));
	Columns = New Array;
	If Suffix <> Undefined And Stored <> Undefined Then
		If ColumnList = Undefined Or ColumnList.Count() < 2 Then
			Columns.Add(VirtualColumn(Stored, Context) + Suffix);
		ElsIf ColumnList.Count() = 2 Then
			// Регистратор: таблица ссылки, затем сама ссылка (у составного с _TYPE колонок три).
			For Each Ending In StrSplit("TREF,RREF", ",") Do
				For Each Column In ColumnList Do
					If StrEndsWith(Upper(Column), Ending) Then
						Columns.Add(VirtualColumn(Column, Context) + Suffix);
					EndIf;
				EndDo;
			EndDo;
		EndIf;
	EndIf;
	If Columns.Count() = 0 Then
		Raise StrTemplate("RecordsWithExtDimensions is ordered by %1, and that ordering is not measured: the"
			+ " platform form is known for the period, the recorder, the line number, an account and a dimension"
			+ " of one type. Order by one of those, or use ORDER BY and TOP in the outer query.", TrimAll(Raw));
	EndIf;
	Return StrConcat(Columns, ", ");

EndFunction

// Обороты между счетами: одна проводка - это уже пара счетов, стороны разносить не надо.
Function AccountingDrCrTurnovers(Descriptor, Plan, Base, Register, Start, Finish, Context, Detail = Undefined)

	If Not HasCorrespondence(Register) Then
		Raise StrTemplate("Register %1 keeps no correspondence, DrCrTurnovers is meaningless.",
			Plan.BaseName);
	EndIf;

	Select = New Array;
	Group = New Array;
	ListFilters = New Array;

	For Each Side In AccountingSides(Register) Do
		Name = "Account" + Side;
		If Used(Descriptor, Name) Then
			// Наружу поле зовётся AccountDr/AccountCr всегда, а в самом регистре оно
			// называется на языке конфигурации - СчетДт на русской.
			Column = AccountingColumn(Base, AccountFieldName(Base, Side), Context);
			Select.Add("    " + Column + " AS " + QuoteIdentifier(Name, Context));
			Group.Add(Column);
		EndIf;
		For Number = 1 To Plan.Slots Do
			Suffix = Side + Format(Number, "NG=0; NZ=0");
			If Not Used(Descriptor, "ExtDimension" + Suffix) Then
				Continue;
			EndIf;
			// Со списком видов субконто стороны поле N - значение N-го вида списка, в каком бы слоте
			// проводки он ни стоял (замеры z1-z5, 21.11.2026, УХ): CASE WHEN T2._KindCt1RRef = <вид> THEN
			// T2._ValueCt1_… WHEN T2._KindCt2RRef = <вид> THEN T2._ValueCt2_… … ELSE NULL END - частью типа,
			// таблицы и ссылки, и по ним же идёт группировка.
			Listed = ?(Side = "Dr", Plan.ExtDimensionTypes, Plan.CorrExtDimensionTypes);
			If Listed.Count() > 0 Then
				If Number > Listed.Count() Then
					// Замер ac97: со списком из одного вида по кредиту СубконтоКт2 платформа отвергает -
					// «Field not found (СубконтоКт2)»: полей субконто стороны столько, сколько видов в списке.
					Raise StrTemplate(
						"Virtual table %1 is given a list of %3 extra dimension type(s) for the %4 side, so it"
						+ " has only that many ext dimension fields of that side, and the platform refuses the"
						+ " query: Field not found (%2). Stop selecting %2 or extend the list.", Plan.BaseName,
						"ExtDimension" + Suffix, Format(Listed.Count(), "NG=0; NZ=0"), Side);
				EndIf;
				If Listed.Count() > 1 Then
					Raise StrTemplate(
						"Virtual table %1 is given a list of %3 extra dimension types for the %4 side, and %2 is"
						+ " selected. With the selected ext dimension the platform keeps only the entries that"
						+ " carry the listed type, and for a list of several types it is not measured whether"
						+ " every listed type is required or only the selected one. Leave one type in the list.",
						Plan.BaseName, "ExtDimension" + Suffix, Format(Listed.Count(), "NG=0; NZ=0"), Side);
				EndIf;
				// Вместе с выбранным субконто списка остаются только проводки, у стороны которых этот вид
				// есть с непустым значением: <CASE по слотам> IS NOT NULL у каждой из трёх частей (замеры
				// z1, z2, z4: за IV квартал 2016 без списка 84 строки, с «Основные средства» по кредиту и
				// СубконтоКт1 - 7). Без выбранного субконто список проводки не отбирает (сверка ac94: 57
				// строк, как без списка).
				For Each Part In StrSplit("Type,RefType,Value", ",") Do
					ListFilters.Add(ExtDimensionByType(Plan, Base, Side, Listed[Number - 1], Context, Part)
						+ " IS NOT NULL");
				EndDo;
				Pairs = New Structure;
				Pairs.Insert("ExtDimension" + Suffix, "Value");
				Pairs.Insert("ExtDimension" + Suffix + "_TYPE", "Type");
				Pairs.Insert("ExtDimension" + Suffix + "_RTRef", "RefType");
				Pairs.Insert("ExtDimension" + Suffix + "_RRRef", "Value");
				For Each Pair In Pairs Do
					Column = ExtDimensionByType(Plan, Base, Side, Listed[Number - 1], Context, Pair.Value);
					Select.Add("    " + Column + " AS " + QuoteIdentifier(Pair.Key, Context));
					If Group.Find(Column) = Undefined Then
						Group.Add(Column);
					EndIf;
				EndDo;
				Continue;
			EndIf;
			Slot = ExtDimensionSlot(Base, Side, Number);
			If IsBlankString(Slot.Value) Then
				Continue;
			EndIf;
			AddExtDimensionColumns(Select, Group, Slot, "ExtDimension" + Suffix, Context);
		EndDo;
		For Each Dimension In Plan.Dimensions Do
			Name = SideFieldName(Dimension.Name, Side, Dimension.IsBalance, Base);
			If Not Used(Descriptor, Name) Or Group.Find(AccountingColumn(Base, Name, Context)) <> Undefined Then
				Continue;
			EndIf;
			Column = AccountingColumn(Base, Name, Context);
			Select.Add("    " + Column + " AS " + QuoteIdentifier(Name, Context));
			Group.Add(Column);
		EndDo;
	EndDo;

	// Замерено (9412, 9419): начало периода - колонка подзапроса и ключ группировки, даже
	// когда Период снаружи не выбран: строка на каждый период, а не один итог.
	If Detail <> Undefined And Detail.Kind = "UNIT" Then
		For Each Column In Detail.Columns Do
			Expression = Column.Expression;
			If Column.Alias = "Period" And Not IsBlankString(Start) Then
				// Первый период при начале внутри него - дата начала, как у Обороты (AccountingAggregate).
				Expression = "CASE WHEN " + Expression + " < " + Start + " THEN " + Start
					+ " ELSE " + Expression + " END";
			EndIf;
			Select.Add("    " + Expression + " AS " + QuoteIdentifier(Column.Alias, Context));
			Group.Add(Expression);
		EndDo;
	EndIf;
	// Периодичность Регистратор и Запись (замер g_rg1-g_rg5, 21.11.2026, УХ, Хозрасчетный): платформа
	// группирует по периоду, уточнению периода и регистратору, у Записи ещё и по номеру строки -
	// GROUP BY T2._Period, T2._PeriodAdjustment, T2._RecorderTRef, T2._RecorderRRef[, T2._LineNo] - и
	// тогда, когда ни одно из этих полей не выбрано (за декабрь 2016 по счёту 26: без периодичности
	// 11 строк, по регистратору 13, по записи 22). Период остаётся моментом записи, к дате начала
	// не подтягивается.
	ByRecord = Detail <> Undefined And (Detail.Kind = "RECORDER" Or Detail.Kind = "RECORD");
	If ByRecord Then
		For Each Column In Detail.Columns Do
			Select.Add("    " + Column.Expression + " AS " + QuoteIdentifier(Column.Alias, Context));
			If Group.Find(Column.Expression) = Undefined Then
				Group.Add(Column.Expression);
			EndIf;
		EndDo;
	EndIf;
	// Периодичность Авто (замеры a1-a14, 21.11.2026, УХ): платформа группирует ровно по выбранным
	// полям записи и периода - один Регистратор: GROUP BY T2._RecorderTRef, T2._RecorderRRef; один
	// НомерСтроки: GROUP BY T2._LineNo; ПериодМесяц: по началу месяца; УточнениеПериода: по нему
	// одному; без таких полей - как без периодичности (DetailForUsedFields). Поле периода крупнее
	// начала интервала показывается датой начала (a13: ПериодГод с 01.11.2016 - 01.11.2016).
	Coarse = True;
	If Detail <> Undefined And Detail.Kind = "UNIT" Then
		Coarse = CoarsePeriodName(RoleArgument(Plan.Arguments, AccountingArguments(Plan.Kind).Periodicity));
	EndIf;
	If Detail <> Undefined And Detail.Kind = "AUTO" Then
		RecorderParts = Detail.Parts.Get("RECORDER");
		For Each Column In Detail.Columns Do
			If Column.Alias = "SortKey" Then
				Continue;
			EndIf;
			Asked = Used(Descriptor, Column.Alias);
			If Not Asked And RecorderParts <> Undefined And RecorderParts.Find(Column.Alias) <> Undefined Then
				Asked = Used(Descriptor, "Recorder");
			EndIf;
			If Not Asked Then
				Continue;
			EndIf;
			Expression = Column.Expression;
			UnitName = ?(StrEndsWith(Column.Alias, "Period"),
				Left(Column.Alias, StrLen(Column.Alias) - StrLen("Period")), "");
			If Not IsBlankString(UnitName) And Not IsBlankString(Start) Then
				Expression = "CASE WHEN " + Expression + " < " + Start + " THEN " + Start
					+ " ELSE " + Expression + " END";
			EndIf;
			If IsBlankString(UnitName) Or Not CoarsePeriodName(UnitName) Then
				Coarse = False;
			EndIf;
			Select.Add("    " + Expression + " AS " + QuoteIdentifier(Column.Alias, Context));
			If Group.Find(Expression) = Undefined Then
				Group.Add(Expression);
			EndIf;
		EndDo;
	EndIf;

	Having = New Array;
	For Each Resource In Plan.Resources Do
		If Resource.IsBalance Then
			Column = AccountingColumn(Base, SideFieldName(Resource.Name, "Dr", True, Base), Context);
			Total = "SUM(" + Column + ")";
			Select.Add("    " + Total + " AS " + QuoteIdentifier(Resource.Name + "Turnover", Context));
			Having.Add(Total + " <> 0");
			Continue;
		EndIf;
		// У небалансового ресурса значение своё на каждой стороне проводки, и наружу
		// они выходят двумя полями - общего оборота у него нет. У односторонней проводки
		// противоположная сторона в хранении пуста, а платформа показывает ноль.
		For Each Side In AccountingSides(Register) Do
			Column = AccountingColumn(Base, SideFieldName(Resource.Name, Side, False, Base), Context);
			If ByRecord Or Not Coarse Then
				// По регистратору и записи пустая сторона остаётся NULL: платформа читает таблицу
				// движений как есть - CAST(SUM(T2._Fld1601Ct) AS NUMERIC(21, 3)), без замены на ноль
				// (замер g_rg5: КоличествоОборотКт - NULL; без периодичности и по месяцу - 0, u_q0, u_q1).
				// Так же при любой группировке мельче месяца - таблица оборотов итогов помесячная, и
				// платформа читает проводки: периодичность День и Авто с ПериодДень, ПериодСекунда,
				// НомерСтроки - NULL (замеры a8, a9, a11-a13); Авто с ПериодМесяц или ПериодГод - итоги
				// и 0 (a7, a14). Неделя и декада не замерены, отнесены к мелким по тому же основанию.
				Total = "SUM(" + Column + ")";
				Select.Add("    " + Total + " AS "
					+ QuoteIdentifier(Resource.Name + "Turnover" + Side, Context));
				Having.Add(Total + " <> 0");
				Continue;
			EndIf;
			Total = "SUM(COALESCE(" + Column + ", 0))";
			Select.Add("    " + Total + " AS "
				+ QuoteIdentifier(Resource.Name + "Turnover" + Side, Context));
			Having.Add(Total + " <> 0");
		EndDo;
	EndDo;

	Roles = AccountingArguments(Plan.Kind);
	// Список видов с известным значением раскрыт выше; без значения перенумерация неизвестна.
	If Plan.TypeList = Undefined Then
		CheckExtDimensionTypes(Descriptor, Plan,
			RoleArgument(Plan.Arguments, Roles.ExtDimensionTypes), "Dr");
	EndIf;
	If Plan.CorrTypeList = Undefined Then
		CheckExtDimensionTypes(Descriptor, Plan,
			RoleArgument(Plan.Arguments, Roles.CorrExtDimensionTypes), "Cr");
	EndIf;

	Where = New Array;
	Joins = New Array;
	Active = ActiveCondition(Base, Context);
	If Not IsBlankString(Active) Then
		Where.Add(Active);
	EndIf;
	For Each Filter In ListFilters Do
		Where.Add(Filter);
	EndDo;
	CheckConditionExtDimensionTypes(Plan, RoleArgument(Plan.Arguments, Roles.Condition),
		RoleArgument(Plan.Arguments, Roles.ExtDimensionTypes), "Dr");
	CheckConditionExtDimensionTypes(Plan, RoleArgument(Plan.Arguments, Roles.Condition),
		RoleArgument(Plan.Arguments, Roles.CorrExtDimensionTypes), "Cr");
	Conditional = DrCrConditionBase(Plan, Base, Context);
	AddCondition(Where, ConditionSql(RoleArgument(Plan.Arguments, Roles.Condition),
		Conditional, Context, Joins));
	AddCondition(Where, AccountConditionSql(RoleArgument(Plan.Arguments, Roles.AccountCondition),
		Conditional, "Dr", AccountConditionNames(""), Context, Joins));
	AddCondition(Where, AccountConditionSql(RoleArgument(Plan.Arguments, Roles.CorrAccountCondition),
		Conditional, "Cr", AccountConditionNames(""), Context, Joins));
	Period = VirtualColumn(PeriodColumn(Base), Context);
	If Not IsBlankString(Start) Then
		Where.Add(Period + " >= " + Start);
	EndIf;
	If Not IsBlankString(Finish) Then
		Where.Add(Period + " <= " + Finish);
	EndIf;

	Lines = New Array;
	Lines.Add("  SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("  FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS " + VirtualAlias());
	AddNavigationJoins(Lines, Joins, "  ");
	If Where.Count() > 0 Then
		Lines.Add("  WHERE " + StrConcat(Where, Chars.LF + "    AND "));
	EndIf;
	If Group.Count() > 0 Then
		Lines.Add("  GROUP BY " + StrConcat(Group, ", "));
		If Having.Count() > 0 Then
			Lines.Add("  HAVING " + StrConcat(Having, Chars.LF + "     OR "));
		EndIf;
	EndIf;
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Период из целых месяцев (месяц, квартал, полугодие, год): обороты за него платформа берёт из
// помесячной таблицы оборотов итогов. Принимает имя периодичности и имя единицы поля Авто.
Function CoarsePeriodName(Name)

	Normalized = Upper(TrimAll(Name));
	Return Normalized = "MONTH" Or Normalized = Upper("Месяц")
		Or Normalized = "QUARTER" Or Normalized = Upper("Квартал")
		Or Normalized = "HALFYEAR" Or Normalized = Upper("Полугодие")
		Or Normalized = "YEAR" Or Normalized = Upper("Год");

EndFunction

// Ресурс считается спрошенным, если внешний запрос взял хоть одно его поле.
Function ResourceUsed(Used, ResourceName, Resources = Undefined)

	If Used = Undefined Then
		Return False;
	EndIf;
	Prefix = Upper(ResourceName);
	For Each Item In Used Do
		If Not StrStartsWith(Item.Key, Prefix) Then
			Continue;
		EndIf;
		// «Количество» - префикс и «КоличествоУпаковок»: поле принадлежит самому длинному
		// ресурсу, с имени которого начинается.
		Longer = False;
		If Resources <> Undefined Then
			For Each Other In Resources Do
				OtherName = Upper(Other.Name);
				If StrLen(OtherName) > StrLen(Prefix) And StrStartsWith(OtherName, Prefix)
					And StrStartsWith(Item.Key, OtherName) Then
					Longer = True;
					Break;
				EndIf;
			EndDo;
		EndIf;
		If Not Longer Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

Function Used(Descriptor, Name)

	Return Descriptor.Used.Get(Upper(TrimAll(Name))) <> Undefined;

EndFunction

// Колонка стороны: счёт, измерение или слот субконто.
Function OppositeSide(Side)

	Return ?(Side = "Dr", "Cr", ?(Side = "Cr", "Dr", Side));

EndFunction

// Условие «у счёта N-й вид субконто есть и учитывается в остатках» по табличной части
// видов субконто плана счетов (строка N, «Только обороты» = ложь). Пустая строка - табличную
// часть или её реквизиты найти не удалось; тогда значение слота берётся как есть.
Function ExtDimensionBalanceTracked(Plan, Account, Number, Context)

	Section = ExtDimensionSection(Plan, Context);
	If Section = Undefined Then
		Raise StrTemplate(
			"Virtual table %1 selects an ext dimension, and the tabular section of ext dimension types of"
			+ " its chart of accounts (line number, turnovers-only flag) is not found in the storage structure."
			+ " Without it the balance cannot be kept apart from ext dimensions that are tracked as"
			+ " turnovers only.", Plan.BaseName);
	EndIf;
	Return "EXISTS (SELECT 1 FROM " + Section.Table + " AS EDT"
		+ " WHERE EDT." + Section.Owner + " = " + Account
		+ " AND EDT." + Section.Line + " = " + Format(Number, "NG=0; NZ=0")
		+ " AND EDT." + Section.Only + " = " + BooleanLiteral(False, Context) + ")";

EndFunction

// Условие «у счёта есть вид субконто TypeLiteral и учитывается в остатках» - как
// ExtDimensionBalanceTracked, но по виду, а не по номеру строки: так колонку задаёт список видов.
Function ExtDimensionTypeTracked(Plan, Account, TypeLiteral, Context)

	Section = ExtDimensionSection(Plan, Context);
	If Section = Undefined Or IsBlankString(Section.Kind) Then
		Raise StrTemplate(
			"Virtual table %1 selects an ext dimension by a list of ext dimension types, and the tabular"
			+ " section of ext dimension types of its chart of accounts (type, turnovers-only flag) is not"
			+ " found in the storage structure. Without it the balance cannot be kept apart from ext"
			+ " dimensions that are tracked as turnovers only.", Plan.BaseName);
	EndIf;
	Return "EXISTS (SELECT 1 FROM " + Section.Table + " AS EDT"
		+ " WHERE EDT." + Section.Owner + " = " + Account
		+ " AND EDT." + Section.Kind + " = " + TypeLiteral
		+ " AND EDT." + Section.Only + " = " + BooleanLiteral(False, Context) + ")";

EndFunction

// Расщепление ленты ОстаткиИОбороты по субконто «только обороты». Slots: имя колонки ленты ->
// условие «у счёта строки этот вид субконто в остатках не учитывается»; Untracked - такое
// условие хотя бы для одного непустого субконто строки; Joins - соединения с табличной частью
// видов субконто (по одному на номер). Undefined - расщеплять нечего: субконто не выбраны.
Function TurnoverOnlySplit(Plan, Grouping, Context)

	If Plan.Kind <> "BALANCEANDTURNOVERS" Then
		Return Undefined;
	EndIf;
	Types = Plan.ExtDimensionTypes;
	Numbers = New Map;
	For Each Name In Grouping Do
		If Not StrStartsWith(Upper(Name), "EXTDIMENSION") Then
			Continue;
		EndIf;
		Tail = Mid(Name, StrLen("ExtDimension") + 1);
		Position = StrFind(Tail, "_");
		Digits = ?(Position = 0, Tail, Left(Tail, Position - 1));
		Number = Undefined;
		Try
			Number = Number(Digits);
		Except
			Number = Undefined;
		EndTry;
		If Number = Undefined Or Number < 1 Then
			Continue;
		EndIf;
		Names = Numbers.Get(Number);
		If Names = Undefined Then
			Names = New Array;
			Numbers.Insert(Number, Names);
		EndIf;
		Names.Add(Name);
	EndDo;
	If Numbers.Count() = 0 Then
		Return Undefined;
	EndIf;
	Section = ExtDimensionSection(Plan, Context);
	If Section = Undefined Or (Types.Count() > 0 And IsBlankString(Section.Kind)) Then
		Raise StrTemplate(
			"Virtual table %1 selects an ext dimension, and the tabular section of"
			+ " ext dimension types of its chart of accounts (line number, type, turnovers-only flag) is not"
			+ " found in the storage structure. Without it the balance cannot be kept apart from ext"
			+ " dimensions that are tracked as turnovers only.", Plan.BaseName);
	EndIf;

	Account = "F." + QuoteIdentifier("Account", Context);
	Slots = New Map;
	Joins = New Array;
	Untracked = New Array;
	For Each Item In Numbers Do
		Text = Format(Item.Key, "NG=0; NZ=0");
		Alias = "ED" + Text;
		// Со списком видов колонка N - это N-й вид списка, в каком бы слоте он у счёта ни стоял.
		// Остаток по оборотному виду и тогда идёт по NULL (rev26.py, УХ, счёт 51 со списком из
		// СтатьиДвиженияДенежныхСредств: без периода 1С 1 строка, по значению 2; по месяцам 2 и 4).
		Match = ?(Types.Count() >= Item.Key,
			Alias + "." + Section.Kind + " = " + Types[Item.Key - 1],
			Alias + "." + Section.Line + " = " + Text);
		Joins.Add("LEFT JOIN " + Section.Table + " AS " + Alias
			+ " ON " + Alias + "." + Section.Owner + " = " + Account
			+ " AND " + Match
			+ " AND " + Alias + "." + Section.Only + " = " + BooleanLiteral(False, Context));
		Missing = Alias + "." + Section.Owner + " IS NULL";
		Filled = New Array;
		For Each Name In Item.Value Do
			Slots.Insert(Name, Missing);
			Filled.Add("F." + QuoteIdentifier(Name, Context) + " IS NOT NULL");
		EndDo;
		Untracked.Add("(" + Missing + " AND (" + StrConcat(Filled, " OR ") + "))");
	EndDo;

	Result = New Structure;
	Result.Insert("Slots", Slots);
	Result.Insert("Joins", Joins);
	Result.Insert("Untracked", "(" + StrConcat(Untracked, " OR ") + ")");
	Return Result;

EndFunction

// Есть ли в условии виртуальной таблицы проверка на NULL (ЕСТЬ NULL, ЕСТЬNULL, ВЫБОР): такое условие
// может быть истинным на NULL, который стоит в итогах на месте оборотного субконто.
Function ConditionTestsNull(Condition)

	If IsBlankString(Condition) Then
		Return False;
	EndIf;
	For Each Token In Tokenize(Condition) Do
		If Token.Kind <> "Name" Then
			Continue;
		EndIf;
		Word = Upper(TrimAll(Token.Value));
		If Word = "NULL" Or Word = "ISNULL" Or Word = Upper("ЕстьNULL") Or Word = "CASE" Or Word = Upper("Выбор") Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Номера субконто, названных в условии виртуальной таблицы (Субконто1, ExtDimension2.Код …).
Function ConditionExtDimensionNumbers(Condition, Slots)

	Numbers = New Array;
	If IsBlankString(Condition) Then
		Return Numbers;
	EndIf;
	For Each Token In Tokenize(Condition) Do
		If Token.Kind <> "Name" Then
			Continue;
		EndIf;
		Head = Upper(TrimAll(StrSplit(Token.Value, ".")[0]));
		For Number = 1 To Slots Do
			Digits = Format(Number, "NG=0; NZ=0");
			If (Head = Upper("Субконто" + Digits) Or Head = Upper("ExtDimension" + Digits))
				And Numbers.Find(Number) = Undefined Then
				Numbers.Add(Number);
			EndIf;
		EndDo;
	EndDo;
	Return Numbers;

EndFunction

// Условие «у счёта строки субконто, названное в условии виртуальной таблицы, учитывается только
// оборотами». Пустая строка - условие субконто не называет. Замеры 21.11.2026, УХ (s_17, s_ob, x3,
// t01-t19, u1-u5; счета 90.01.1 и 26 с оборотным Субконто1): у такого счёта платформа читает остаток
// только из строк итогов, где на месте оборотного субконто NULL, а проводки отбирает по самому значению
// субконто и считает их одним оборотом - остаток они не двигают (CASE WHEN T7._BRF1 = 0x01 THEN
// -T6._Fld1599 ELSE 0 END при нулевом флаге). Отсюда: условие «Субконто1 = значение» даёт у
// ОстаткиИОбороты нулевые остатки и оборот по значению (t03: 0, -115 500, 0), у Остатков - ноль;
// условие, истинное на NULL («Субконто1 ЕСТЬ NULL»), даёт у Остатков остаток на период итогов, а не на
// дату (t01: на 10.03.2017 - 9 420 948,80, остаток на 01.04.2017). Субконто в одной выборке, без
// условия, остаток не трогает (u2: 929 627,28, как без субконто).
Function ConditionUntracked(Plan, Base, Side, Condition, Context)

	Numbers = ConditionExtDimensionNumbers(Condition, Plan.Slots);
	If Numbers.Count() = 0 Then
		Return "";
	EndIf;
	Section = ExtDimensionSection(Plan, Context);
	If Section = Undefined Or (Plan.ExtDimensionTypes.Count() > 0 And IsBlankString(Section.Kind)) Then
		Raise StrTemplate(
			"Virtual table %1 names an ext dimension in its condition, and the tabular section of ext"
			+ " dimension types of its chart of accounts (line number, type, turnovers-only flag) is not found"
			+ " in the storage structure. Without it the accounts that keep this ext dimension as turnovers"
			+ " only cannot be told apart, and their balance is computed differently.", Plan.BaseName);
	EndIf;
	Account = AccountingColumn(Base, AccountFieldName(Base, Side), Context);
	Parts = New Array;
	For Each Number In Numbers Do
		Match = ?(Plan.ExtDimensionTypes.Count() >= Number,
			"EDO." + Section.Kind + " = " + Plan.ExtDimensionTypes[Number - 1],
			"EDO." + Section.Line + " = " + Format(Number, "NG=0; NZ=0"));
		Parts.Add("EXISTS (SELECT 1 FROM " + Section.Table + " AS EDO WHERE EDO." + Section.Owner + " = "
			+ Account + " AND " + Match + " AND EDO." + Section.Only + " = " + BooleanLiteral(True, Context) + ")");
	EndDo;
	Return "(" + StrConcat(Parts, " OR ") + ")";

EndFunction

// Ветка остатка ОстаткиИОбороты по строкам итогов, где оборотное субконто NULL (замер nb, 22.11.2026, УХ): записи
// счетов с оборотным субконто в условии, условие - с субконто NULL, до точки конца - позднейшей из точки итогов от начала
// и начала месяца конца (за краем рассчитанных итогов - все записи); записи до точки начала идут периодом до начала
// интервала (начальный остаток), прочие - началом (только конечный); субконто NULL, BalanceOff 0, NullBalance 1.
Function NullBalanceBranch(Plan, Base, Side, MainSelect, Grouping, Arguments, Roles, Conditional, Untracked, Start, Finish,
	Context)

	NullBase = New Structure;
	For Each Item In Conditional Do
		NullBase.Insert(Item.Key, Item.Value);
	EndDo;
	Computed = New Map;
	For Each Item In Conditional.Computed Do
		Computed.Insert(Item.Key, Item.Value);
	EndDo;
	For Number = 1 To Plan.Exposed Do
		Name = "ExtDimension" + Format(Number, "NG=0; NZ=0");
		Names = New Array;
		Names.Add(Name);
		For Each Part In ExtDimensionPartNames(Name) Do
			Names.Add(Part);
		EndDo;
		For Each PartName In Names Do
			If Computed.Get(Upper(PartName)) <> Undefined Then
				Computed.Insert(Upper(PartName), "NULL");
			EndIf;
		EndDo;
	EndDo;
	NullBase.Insert("Computed", Computed);

	Joins = New Array;
	Where = New Array;
	Active = ActiveCondition(Base, Context);
	If Not IsBlankString(Active) Then
		Where.Add(Active);
	EndIf;
	AddCondition(Where, ConditionSql(RoleArgument(Arguments, Roles.Condition), NullBase, Context, Joins));
	AddCondition(Where, AccountConditionSql(RoleArgument(Arguments, Roles.AccountCondition), Conditional, Side,
		AccountConditionNames(""), Context, Joins));
	Where.Add(Untracked);
	Period = VirtualColumn(PeriodColumn(Base), Context);
	StartPoint = BalanceTotalsPoint(Plan, Start, Context);
	FinishPoint = BalanceTotalsPoint(Plan, Finish, Context);
	Month = TruncateToUnit("month", Finish, Context);
	Present = New Array;
	Present.Add("3999");
	Present.Add("11");
	Present.Add("1");
	FinalPoint = "CASE WHEN " + FinishPoint + " = " + DateLiteralFromArguments(Present, Context) + " THEN " + FinishPoint
		+ " WHEN " + Month + " > " + StartPoint + " THEN " + Month + " ELSE " + StartPoint + " END";
	Where.Add(Period + " < " + FinalPoint);
	Where.Add(AccountingColumn(Base, AccountFieldName(Base, Side), Context)
		+ " <> " + BinaryLiteral("00000000000000000000000000000000", Context));
	AddCondition(Where, AccountKindsFilter(Plan, Plan.ExtDimensionTypes,
		AccountingColumn(Base, AccountFieldName(Base, Side), Context), Context));

	ExtNames = New Map;
	For Each Name In Grouping Do
		If StrStartsWith(Upper(Name), "EXTDIMENSION") Then
			ExtNames.Insert(QuoteIdentifier(Name, Context), True);
		EndIf;
	EndDo;
	PeriodAlias = QuoteIdentifier("Period", Context);
	Select = New Array;
	For Each Item In MainSelect Do
		Position = StrFind(Item, " AS ", SearchDirection.FromEnd);
		Alias = TrimAll(Mid(Item, Position + 4));
		If ExtNames.Get(Alias) <> Undefined Then
			Select.Add("      NULL AS " + Alias);
		ElsIf Alias = PeriodAlias Then
			Select.Add("      CASE WHEN " + Period + " < " + StartPoint + " THEN " + ShiftedDate(Start, "-1", "second", Context)
				+ " ELSE " + Start + " END AS " + Alias);
		ElsIf Alias = QuoteIdentifier("BalanceOff", Context) Then
			Select.Add("      0 AS " + Alias);
		ElsIf Alias = QuoteIdentifier("NullBalance", Context) Then
			Select.Add("      1 AS " + Alias);
		Else
			Select.Add(Item);
		EndIf;
	EndDo;
	Lines = New Array;
	Lines.Add("      SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("      FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS " + VirtualAlias());
	AddNavigationJoins(Lines, Joins, "      ");
	Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Период итогов, на который платформа читает остаток на дату Finish (замеры b60dt..c2030, s_17, t01,
// t08, t14): начало месяца, не меньшее даты; если дата позже месяца, следующего за последним
// рассчитанным, - текущие итоги, то есть все проводки. Последний рассчитанный месяц - колонка _Period
// таблицы настроек итогов. Решение пользователя 21.11.2026 (query-to-sql-totals-decision): ответ
// платформы здесь зависит от итогов базы, и перевод читает их период.
Function BalanceTotalsPoint(Plan, Finish, Context)

	Storage = StorageStructure();
	Options = Storage.Get(AccountingTotalsKey(Plan.Register.FullName(), "OPT"));
	If Options = Undefined Then
		Options = Storage.Get(AccountingTotalsKey(Plan.BaseName, "OPT"));
	EndIf;
	OptionsPeriod = ?(Options = Undefined Or Not Options.Property("Physicals"), "",
		TotalsPhysical(Options, "_Period"));
	If IsBlankString(OptionsPeriod) Then
		Raise StrTemplate(
			"Virtual table %1 names in its condition an ext dimension that some accounts keep as turnovers"
			+ " only. For such an account the platform returns the balance as of the totals period, not as of"
			+ " the balance date, and the table of totals settings of the register is not found in the storage"
			+ " structure of this infobase. Move the ext dimension filter to WHERE of the query.", Plan.BaseName);
	EndIf;
	Calculated = "(SELECT MAX(O." + PhysicalName(OptionsPeriod, Context) + ") FROM "
		+ QualifiedTableName(Options.PhysicalName, Context) + " AS O)";
	Edge = ShiftedDate(Calculated, "1", "month", Context);
	Month = TruncateToUnit("month", Finish, Context);
	PresentArguments = New Array;
	PresentArguments.Add("3999");
	PresentArguments.Add("11");
	PresentArguments.Add("1");
	Return "CASE WHEN " + Finish + " > " + Edge + " THEN " + DateLiteralFromArguments(PresentArguments, Context)
		+ " WHEN " + Month + " = " + Finish + " THEN " + Month
		+ " ELSE " + ShiftedDate(Month, "1", "month", Context) + " END";

EndFunction

// Остаток строки ленты ОстаткиИОбороты: у счёта с оборотным субконто в условии проводка остаток не
// двигает (ConditionUntracked) - колонку BalanceOff ставит AccountingSubquery.
Function GuardedBalance(Plan, Value, Context)

	If Not Plan.Property("BalanceOff") Or Plan.BalanceOff <> True Then
		Return Value;
	EndIf;
	Return "(CASE WHEN F." + QuoteIdentifier("BalanceOff", Context) + " = 0 THEN " + Value + " ELSE 0 END)";

EndFunction

// Отбор счетов списком видов субконто: у счёта есть каждый вид списка (Остатки, Обороты,
// ОстаткиИОбороты; у ОборотыДтКт список счета не отбирает - замер 17.11.2026, УХ). Пустая строка -
// списка нет.
Function AccountKindsFilter(Plan, Types, Account, Context)

	If Types = Undefined Or Types.Count() = 0 Then
		Return "";
	EndIf;
	Section = ExtDimensionSection(Plan, Context);
	If Section = Undefined Then
		Raise StrTemplate("The list of extra dimension types of %1 keeps only the accounts that have every"
			+ " listed kind, and the table of kinds of its chart of accounts was not found.", Plan.BaseName);
	EndIf;
	Conditions = New Array;
	For Each Kind In Types Do
		Conditions.Add("EXISTS (SELECT 1 FROM " + Section.Table + " AS XK WHERE XK." + Section.Owner
			+ " = " + Account + " AND XK." + Section.Kind + " = " + Kind + ")");
	EndDo;
	Return StrConcat(Conditions, " AND ");

EndFunction

// Табличная часть видов субконто плана счетов: таблица и физические колонки владельца,
// номера строки и признака «Только обороты». Undefined - не нашлась.
Function ExtDimensionSection(Plan, Context)

	Chart = Undefined;
	Try
		Chart = Plan.Register.ChartOfAccounts;
	Except
		Return Undefined;
	EndTry;
	If Chart = Undefined Then
		Return Undefined;
	EndIf;
	Section = Undefined;
	For Each Name In StrSplit("ExtDimensionTypes," + "ВидыСубконто", ",") Do
		Try
			Section = TableDescriptor(Chart.FullName() + "." + Name);
		Except
			Section = Undefined;
		EndTry;
		If Section <> Undefined Then
			Break;
		EndIf;
	EndDo;
	If Section = Undefined Then
		Return Undefined;
	EndIf;
	Line = Undefined;
	Only = Undefined;
	Owner = Undefined;
	For Each Item In Section.Fields Do
		Key_ = Upper(Item.Key);
		If Key_ = "LINENUMBER" Or Key_ = Upper("НомерСтроки") Then
			Line = Item.Value;
		ElsIf Key_ = "TURNOVERSONLY" Or Key_ = Upper("ТолькоОбороты") Then
			Only = Item.Value;
		ElsIf Key_ = "REF" Or Key_ = Upper("Ссылка") Then
			Owner = Item.Value;
		EndIf;
	EndDo;
	If Line = Undefined Or Only = Undefined Or Owner = Undefined Then
		Return Undefined;
	EndIf;
	// Вид субконто строки - ссылка; из колонок поля берётся сама ссылка.
	Kind = "";
	For Each Name In StrSplit("ExtDimensionType," + "ВидСубконто", ",") Do
		ColumnList = Section.Columns.Get(Upper(Name));
		If ColumnList = Undefined Then
			Continue;
		EndIf;
		For Each Column In ColumnList Do
			If IsBlankString(Kind) Or StrEndsWith(Upper(Column), "RREF") Then
				Kind = Column;
			EndIf;
		EndDo;
	EndDo;
	Result = New Structure;
	Result.Insert("Table", QualifiedTableName(Section.PhysicalName, Context));
	Result.Insert("Kind", ?(IsBlankString(Kind), "", PhysicalName(Kind, Context)));
	Result.Insert("Owner", PhysicalName(Owner, Context));
	Result.Insert("Line", PhysicalName(Line, Context));
	Result.Insert("Only", PhysicalName(Only, Context));
	Return Result;

EndFunction

Function AccountingSourceColumn(Plan, Base, Name, Side, Context, Corr = False)

	// Корреспондирующее поле - это то же поле, но с противоположной стороны проводки.
	Effective = Name;
	Actual = Side;
	If StrStartsWith(Upper(Name), "BALANCED") Then
		Effective = Mid(Name, StrLen("Balanced") + 1);
		Actual = OppositeSide(Side);
	ElsIf StrEndsWith(Upper(Name), "BALANCED") Then
		Effective = Left(Name, StrLen(Name) - StrLen("Balanced"));
		Actual = OppositeSide(Side);
	EndIf;
	If Effective <> Name Then
		Return AccountingSourceColumn(Plan, Base, Effective, Actual, Context, True);
	EndIf;

	If Upper(Name) = "ACCOUNT" Then
		Return AccountingColumn(Base, AccountFieldName(Base, Side), Context);
	EndIf;

	If StrStartsWith(Upper(Name), "EXTDIMENSION") Then
		Tail = Mid(Name, StrLen("ExtDimension") + 1);
		Part = "Value";
		If StrEndsWith(Upper(Tail), "_TYPE") Then
			Part = "Type";
			Tail = Left(Tail, StrLen(Tail) - StrLen("_TYPE"));
		ElsIf StrEndsWith(Upper(Tail), "_RTREF") Then
			Part = "RefType";
			Tail = Left(Tail, StrLen(Tail) - StrLen("_RTRef"));
		ElsIf StrEndsWith(Upper(Tail), "_RRREF") Then
			Tail = Left(Tail, StrLen(Tail) - StrLen("_RRRef"));
		EndIf;
		Number = Number(Tail);
		Types = ?(Corr And Plan.CorrExtDimensionTypes.Count() > 0,
			Plan.CorrExtDimensionTypes, Plan.ExtDimensionTypes);
		If Types.Count() >= Number Then
			Value = ExtDimensionByType(Plan, Base, Side, Types[Number - 1], Context, Part);
			If Plan.Kind = "BALANCE" Then
				// Со списком видов - то же, что со слотом ниже: у счёта, где вид учитывается
				// «только оборотами», остаток идёт по NULL (сверка 13.11.2026, УХ: Остатки на
				// 01.01.2018 по счёту 51 со списком из СтатьиДвиженияДенежныхСредств - 1С одна
				// строка 5 955 485.40 с Субконто1 = NULL, SQL - две строки по значениям).
				Account = AccountingColumn(Base, AccountFieldName(Base, Side), Context);
				Value = "(CASE WHEN " + ExtDimensionTypeTracked(Plan, Account, Types[Number - 1], Context)
					+ " THEN " + Value + " END)";
			EndIf;
			Return Value;
		EndIf;
		Slot = ExtDimensionSlot(Base, Side, Number);
		Column = SlotPart(Slot, Part);
		If IsBlankString(Column) Then
			Raise StrTemplate("Register %1 keeps no ext dimension slot %2.",
				Plan.BaseName, Format(Number, "NG=0; NZ=0"));
		EndIf;
		If Plan.Kind = "BALANCE" Then
			// Замерено (9480): в остатках платформа берёт значение слота только у счёта, где
			// N-й вид субконто есть и учитывается не «только оборотами» (флаг _ED<N> её
			// временной таблицы счетов); иначе - NULL. Без этого остаток делился по значениям
			// субконто, которых в остатках нет (сверка battery28b: 1С 537 строк, SQL 591).
			Account = AccountingColumn(Base, AccountFieldName(Base, Side), Context);
			Tracked = ExtDimensionBalanceTracked(Plan, Account, Number, Context);
			If Not IsBlankString(Tracked) Then
				Return "(CASE WHEN " + Tracked + " THEN " + VirtualColumn(Column, Context) + " END)";
			EndIf;
		EndIf;
		Return VirtualColumn(Column, Context);
	EndIf;

	For Each Dimension In Plan.Dimensions Do
		If Upper(Dimension.Name) = Upper(Name) Then
			Return AccountingColumn(Base,
				SideFieldName(Dimension.Name, Side, Dimension.IsBalance, Base), Context);
		EndIf;
	EndDo;

	Raise StrTemplate("Field %1 is not a field of %2.", Name, Plan.BaseName);

EndFunction

// Сборка подзапроса. Вызывается из FROM, когда уже известно, какие поля запрошены.
// Позиции параметров бухгалтерских виртуальных таблиц. Порядок проверен на самой
// платформе перебором: она принимает выражение только в той позиции, которой оно
// по смыслу соответствует. У Оборотов Условие стоит раньше корреспондирующих
// параметров - это единственное место, где порядок неочевиден.
// Список видов субконто. Разбирается только когда он записан выражениями:
// значение параметра во время трансляции неизвестно, и подменять слоты вслепую нельзя.
// Виды субконто приходят либо выражениями в самом тексте, либо параметром. Значение
// параметра во время трансляции известно только если аналитик задал его на форме -
// тогда список раскрывается, иначе подменять слоты вслепую нельзя.
Function ExtDimensionTypeList(RawArgument, Context)

	Parts = New Array;
	If IsBlankString(RawArgument) Then
		Return Parts;
	EndIf;

	If StrStartsWith(TrimAll(RawArgument), "&") Then
		Return ExtDimensionTypesFromParameter(Mid(TrimAll(RawArgument), 2), Context);
	EndIf;

	Tokens = Tokenize(RawArgument);
	Depth = 0;
	Start = 0;
	For Index = 0 To Tokens.Count() - 1 Do
		Token = Tokens[Index];
		If Token.Kind = "Parameter" Then
			Return Undefined;
		EndIf;
		If Token.Value = "(" Then
			Depth = Depth + 1;
		ElsIf Token.Value = ")" Then
			Depth = Depth - 1;
		ElsIf Token.Value = "," And Depth = 0 Then
			Parts.Add(TokensText(Tokens, Start, Index - 1));
			Start = Index + 1;
		EndIf;
	EndDo;
	Parts.Add(TokensText(Tokens, Start, Tokens.Count() - 1));

	For Each Part In Parts Do
		If IsBlankString(Part) Then
			Return Undefined;
		EndIf;
	EndDo;

	Result = New Array;
	For Each Part In Parts Do
		Result.Add(TranslateArgument(Part, Context));
	EndDo;
	Return Result;

EndFunction

// Значение параметра-списка, заданное на форме. Каждый элемент становится литералом
// ссылки на вид характеристики - ровно тем, с чем сравнивается колонка вида субконто.
Function ExtDimensionTypesFromParameter(Name, Context)

	Value = Context.Options.ParameterValues.Get(TrimAll(Name));
	If Value = Undefined Then
		Return Undefined;
	EndIf;

	Items = New Array;
	If TypeOf(Value) = Type("Array") Then
		For Each Item In Value Do
			Items.Add(Item);
		EndDo;
	ElsIf TypeOf(Value) = Type("ValueList") Then
		// В схеме компоновки список видов субконто хранят списком значений.
		For Each Item In Value Do
			Items.Add(Item.Value);
		EndDo;
	Else
		Items.Add(Value);
	EndIf;

	Result = New Array;
	For Each Item In Items Do
		Literal = "";
		Try
			Literal = ValueLiteral(Item, Context);
		Except
			Return Undefined;
		EndTry;
		If IsBlankString(Literal) Then
			Return Undefined;
		EndIf;
		Result.Add(Literal);
	EndDo;
	Return Result;

EndFunction

// Субконто заданного вида: слоты хранения перебираются, пока не найдётся нужный вид.
Function ExtDimensionByType(Plan, Base, Side, TypeLiteral, Context, Part = "Value")

	Branches = New Array;
	For Number = 1 To Plan.Slots Do
		Slot = ExtDimensionSlot(Base, Side, Number);
		Column = SlotPart(Slot, Part);
		If IsBlankString(Column) Or IsBlankString(Slot.Kind) Then
			Continue;
		EndIf;
		Branches.Add("WHEN " + VirtualColumn(Slot.Kind, Context) + " = " + TypeLiteral
			+ " THEN " + VirtualColumn(Column, Context));
	EndDo;
	If Branches.Count() = 0 Then
		Raise StrTemplate("Register %1 keeps no ext dimension slots.", Plan.BaseName);
	EndIf;
	Return "CASE " + StrConcat(Branches, " ") + " END";

EndFunction

Function SlotPart(Slot, Part)

	If Part = "Type" Then
		Return Slot.Type;
	ElsIf Part = "RefType" Then
		Return Slot.RefType;
	EndIf;
	Return Slot.Value;

EndFunction

// Имена слота субконто. Наружу он выходит и по-английски, и по-русски, а стороны
// проводки в русской конфигурации зовутся Дт и Кт, а не Dr и Cr.
Procedure RegisterExtDimensionNames(Fields, Columns, Slot, Name, Side, Number)

	Digits = Format(Number, "NG=0; NZ=0");
	Russian = ?(Side = "Dr", "Дт", ?(Side = "Cr", "Кт", Side));
	KindName = "ExtDimensionType" + Side + Digits;

	Fields.Insert(Upper(Name), Name);
	Fields.Insert(Upper("Субконто" + Russian + Digits), Name);
	Fields.Insert(Upper(KindName), KindName);
	Fields.Insert(Upper("ВидСубконто" + Russian + Digits), KindName);

	// Без байта типа разбирать нечего: колонка тогда не составная.
	If IsBlankString(Slot.Type) Or IsBlankString(Slot.Value) Then
		Return;
	EndIf;
	Columns.Insert(Upper(Name), ExtDimensionPartNames(Name));
	Columns.Insert(Upper("Субконто" + Russian + Digits), ExtDimensionPartNames(Name));

EndProcedure

// Колонки слота субконто в тексте подзапроса. Само значение плюс части составной
// ссылки: без них наружу не работают ни ВЫРАЗИТЬ, ни представление, ни точка.
Procedure AddExtDimensionColumns(Select, Group, Slot, Name, Context)

	Pairs = New Array;
	Pairs.Add(New Structure("Column, Alias", Slot.Value, Name));
	Pairs.Add(New Structure("Column, Alias", Slot.Type, Name + "_TYPE"));
	Pairs.Add(New Structure("Column, Alias", Slot.RefType, Name + "_RTRef"));
	Pairs.Add(New Structure("Column, Alias", Slot.Value, Name + "_RRRef"));

	For Each Pair In Pairs Do
		If IsBlankString(Pair.Column) Then
			Continue;
		EndIf;
		Column = VirtualColumn(Pair.Column, Context);
		Select.Add("    " + Column + " AS " + QuoteIdentifier(Pair.Alias, Context));
		If Group <> Undefined And Group.Find(Column) = Undefined Then
			Group.Add(Column);
		EndIf;
	EndDo;

EndProcedure

// Субконто - составная ссылка, и наружу она выходит теми же тремя колонками, что и
// составное измерение: без них не работают ни ВЫРАЗИТЬ, ни ТИПЗНАЧЕНИЯ.
Function ExtDimensionPartNames(Name)

	Names = New Array;
	Names.Add(Name + "_TYPE");
	Names.Add(Name + "_RTRef");
	Names.Add(Name + "_RRRef");
	Return Names;

EndFunction

// Копия описателя таблицы движений для условия ОборотовДтКт. Эта таблица отдаёт обе
// стороны проводки сразу, и субконто в ней называются со стороной: ExtDimensionDr1,
// СубконтоДт1, СубконтоКт1. Полями таблицы движений такие имена не являются - слоты
// субконто логических имён не имеют вовсе, - поэтому каждое ставится в соответствие
// своему слоту хранения, как обычное Субконто в остальных виртуальных таблицах.
Function DrCrConditionBase(Plan, Base, Context)

	Fields = New Map;
	For Each Item In Base.Fields Do
		Fields.Insert(Item.Key, Item.Value);
	EndDo;
	Columns = New Map;
	For Each Item In Base.Columns Do
		Columns.Insert(Item.Key, Item.Value);
	EndDo;
	Computed = New Map;

	For Each Side In AccountingSides(Plan.Register) Do
		For Number = 1 To Plan.Slots Do
			Digits = Format(Number, "NG=0; NZ=0");
			Slot = ExtDimensionSlot(Base, Side, Number);
			If IsBlankString(Slot.Value) Then
				Continue;
			EndIf;
			Name = "ExtDimension" + Side + Digits;
			RegisterExtDimensionNames(Fields, Columns, Slot, Name, Side, Number);
			Computed.Insert(Upper(Name), VirtualColumn(Slot.Value, Context));
			Computed.Insert(Upper(Name + "_RRRef"), VirtualColumn(Slot.Value, Context));
			If Not IsBlankString(Slot.Type) Then
				Computed.Insert(Upper(Name + "_TYPE"), VirtualColumn(Slot.Type, Context));
			EndIf;
			If Not IsBlankString(Slot.RefType) Then
				Computed.Insert(Upper(Name + "_RTRef"), VirtualColumn(Slot.RefType, Context));
			EndIf;
			If Not IsBlankString(Slot.Kind) Then
				Computed.Insert(Upper("ExtDimensionType" + Side + Digits),
					VirtualColumn(Slot.Kind, Context));
			EndIf;
		EndDo;
	EndDo;

	If Computed.Count() = 0 Then
		Return Base;
	EndIf;

	Copy = New Structure;
	For Each Item In Base Do
		Copy.Insert(Item.Key, Item.Value);
	EndDo;
	Copy.Insert("Fields", Fields);
	Copy.Insert("Columns", Columns);
	Copy.Insert("Computed", Computed);
	Return Copy;

EndFunction

// Копия описателя таблицы движений с полями субконто. Сам описатель лежит в общем
// кеше структуры хранения и менять его нельзя, поэтому копия.
Function ConditionBase(Plan, Base, Side, Context)

	Fields = New Map;
	For Each Item In Base.Fields Do
		Fields.Insert(Item.Key, Item.Value);
	EndDo;
	Columns = New Map;
	For Each Item In Base.Columns Do
		Columns.Insert(Item.Key, Item.Value);
	EndDo;
	Computed = New Map;

	Corresponding = HasCorrespondence(Plan.Register);
	For Number = 1 To Plan.Exposed Do
		Suffix = Format(Number, "NG=0; NZ=0");
		AddConditionExtDimension(Plan, Base, Side, Context, Fields, Columns, Computed,
			"ExtDimension" + Suffix, "Субконто" + Suffix);
		If Plan.Kind = "TURNOVERS" And Corresponding Then
			AddConditionExtDimension(Plan, Base, Side, Context, Fields, Columns, Computed,
				"BalancedExtDimension" + Suffix, "КорСубконто" + Suffix);
		EndIf;
	EndDo;

	// Небалансовое измерение хранится по стороне проводки: ПодразделениеДт и
	// ПодразделениеКт. Имени без стороны в структуре хранения нет, а в условии пишут
	// именно его - и означает оно измерение той стороны, которую собирает эта ветвь.
	For Each Dimension In Plan.Dimensions Do
		If Dimension.IsBalance Or Fields.Get(Upper(Dimension.Name)) <> Undefined Then
			Continue;
		EndIf;
		Try
			Column = AccountingSourceColumn(Plan, Base, Dimension.Name, Side, Context);
		Except
			// Такого измерения у этой стороны нет - пусть падает на «поле не разрешается».
			Continue;
		EndTry;
		Fields.Insert(Upper(Dimension.Name), Dimension.Name);
		Computed.Insert(Upper(Dimension.Name), Column);
	EndDo;

	// Корреспондирующее измерение (ПодразделениеКор, КорПодразделение) в условии Оборотов - колонка другой
	// стороны проводки: в ветви дебета _Fld…CtRRef, в ветви кредита _Fld…DtRRef (замер kr1, kr2, 21.11.2026, УХ).
	If Plan.Kind = "TURNOVERS" And Corresponding Then
		For Each Dimension In Plan.Dimensions Do
			If Dimension.IsBalance Then
				Continue;
			EndIf;
			Try
				Column = AccountingSourceColumn(Plan, Base, Dimension.Name, OppositeSide(Side), Context);
			Except
				Continue;
			EndTry;
			For Each Alias In StrSplit(Dimension.Name + "Кор," + "Кор" + Dimension.Name + "," + Dimension.Name
				+ "Balanced", ",") Do
				If Fields.Get(Upper(Alias)) = Undefined Then
					Fields.Insert(Upper(Alias), Alias);
					Computed.Insert(Upper(Alias), Column);
				EndIf;
			EndDo;
		EndDo;
	EndIf;

	If Computed.Count() = 0 Then
		Return Base;
	EndIf;

	Copy = New Structure;
	For Each Item In Base Do
		Copy.Insert(Item.Key, Item.Value);
	EndDo;
	Copy.Insert("Fields", Fields);
	Copy.Insert("Columns", Columns);
	Copy.Insert("Computed", Computed);
	Return Copy;

EndFunction

Procedure AddConditionExtDimension(Plan, Base, Side, Context, Fields, Columns, Computed,
	Name, Russian)

	Parts = New Array;
	Values = New Map;
	Try
		Values.Insert(Upper(Name), AccountingSourceColumn(Plan, Base, Name, Side, Context));
		For Each Part In ExtDimensionPartNames(Name) Do
			Values.Insert(Upper(Part), AccountingSourceColumn(Plan, Base, Part, Side, Context));
			Parts.Add(Part);
		EndDo;
	Except
		// Слота с таким номером у регистра нет - поле просто не появляется, и запрос
		// упадёт на понятном «поле не разрешается», а не на внутренней ошибке.
		Return;
	EndTry;

	For Each Item In Values Do
		Computed.Insert(Item.Key, Item.Value);
	EndDo;
	Fields.Insert(Upper(Name), Name);
	Fields.Insert(Upper(Russian), Name);
	Columns.Insert(Upper(Name), Parts);
	Columns.Insert(Upper(Russian), Parts);

EndProcedure

Procedure AddCondition(Where, Condition)

	If Not IsBlankString(Condition) Then
		Where.Add(Condition);
	EndIf;

EndProcedure

Procedure AddNavigationJoins(Lines, Joins, Indent)

	For Each Navigation In Joins Do
		Lines.Add(Indent + "  LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias
			+ " ON " + JoinCondition(Navigation));
	EndDo;

EndProcedure

Function AccountingArguments(Kind)

	Roles = New Structure;
	Roles.Insert("Periodicity", -1);
	Roles.Insert("Completion", -1);
	Roles.Insert("AccountCondition", -1);
	Roles.Insert("ExtDimensionTypes", -1);
	Roles.Insert("CorrAccountCondition", -1);
	Roles.Insert("CorrExtDimensionTypes", -1);
	Roles.Insert("Condition", -1);

	If Kind = "BALANCE" Then
		Roles.AccountCondition = 1;
		Roles.ExtDimensionTypes = 2;
		Roles.Condition = 3;
	ElsIf Kind = "TURNOVERS" Then
		Roles.Periodicity = 2;
		Roles.AccountCondition = 3;
		Roles.ExtDimensionTypes = 4;
		Roles.Condition = 5;
		Roles.CorrAccountCondition = 6;
		Roles.CorrExtDimensionTypes = 7;
	ElsIf Kind = "DRCRTURNOVERS" Then
		Roles.Periodicity = 2;
		Roles.AccountCondition = 3;
		Roles.ExtDimensionTypes = 4;
		Roles.CorrAccountCondition = 5;
		Roles.CorrExtDimensionTypes = 6;
		Roles.Condition = 7;
	ElsIf Kind = "RECORDS" Then
		Roles.Condition = 2;
	Else
		Roles.Periodicity = 2;
		Roles.Completion = 3;
		Roles.AccountCondition = 4;
		Roles.ExtDimensionTypes = 5;
		Roles.Condition = 6;
	EndIf;
	Return Roles;

EndFunction

Function RoleArgument(Arguments, Index)
	Return ?(Index < 0, "", ArgumentAt(Arguments, Index));
EndFunction

// В условии счёта слово "Счет" (или "КорСчет") означает счёт своей стороны проводки,
// а поля с таким именем у таблицы движений нет. Подменяем само имя, а не готовую
// колонку: тогда дальше работают и В ИЕРАРХИИ, и обращение через точку.
Function AccountConditionSql(Condition, Base, Side, Names, Context, Joins)

	If IsBlankString(Condition) Then
		Return "";
	EndIf;

	Return ConditionSql(ReplaceIdentifier(Condition, Names, AccountFieldName(Base, Side)),
		Base, Context, Joins);

EndFunction

Function ReplaceIdentifier(Text, Names, Replacement)

	Wanted = New Map;
	For Each Name In Names Do
		Wanted.Insert(Upper(Name), True);
	EndDo;

	Tokens = Tokenize(Text);
	Changed = False;
	For Index = 0 To Tokens.Count() - 1 Do
		Token = Tokens[Index];
		If Token.Kind <> "Name" Then
			Continue;
		EndIf;
		// Обращение через точку лексер отдаёт одним токеном, поэтому подменяется
		// первый сегмент пути: Счет.Код - это тоже счёт своей стороны проводки.
		Parts = StrSplit(Token.Value, ".", True);
		If Wanted.Get(Upper(TrimAll(Parts[0]))) = Undefined Then
			Continue;
		EndIf;
		Parts[0] = Replacement;
		Token.Value = StrConcat(Parts, ".");
		Changed = True;
	EndDo;
	If Not Changed Then
		Return Text;
	EndIf;
	Return TokensText(Tokens, 0, Tokens.Count() - 1);

EndFunction

Function AccountConditionNames(Prefix)

	Names = New Array;
	If IsBlankString(Prefix) Then
		Names.Add("Account");
	Else
		Names.Add("BalancedAccount");
		Names.Add("CorrAccount");
	EndIf;
	Names.Add(Prefix + "Счет");
	Names.Add(Prefix + "Счёт");
	Return Names;

EndFunction

// Виды субконто меняют не отбор, а сам состав колонок: Субконто1 становится первым
// из заказанных видов, а не первым слотом хранения. Пока это не разобрано, молча
// отдавать чужие субконто нельзя.
Procedure CheckExtDimensionTypes(Descriptor, Plan, Types, Suffix, FiltersAccounts = False)

	If IsBlankString(Types) Then
		Return;
	EndIf;
	// У Остатков, Оборотов и ОстаткиИОбороты список ещё и отбирает счета: остаются только те, у
	// которых есть каждый вид списка (замер 17.11.2026, УХ: [A] - 2 счёта, [B] - 13, [A, B] - 1 из 115).
	// Без значения списка неизвестны сами строки, а не только колонки.
	If FiltersAccounts Then
		Raise StrTemplate(
			"Virtual table %1 is given the list of extra dimension types %2. The list keeps only the accounts that have every listed kind and renumbers the ExtDimension columns, so without its value the rows themselves are unknown. Set the value of that parameter above and translate again.",
			Plan.BaseName, TrimAll(Types));
	EndIf;
	For Number = 1 To Plan.Slots Do
		Name = "ExtDimension" + Suffix + Format(Number, "NG=0; NZ=0");
		If Used(Descriptor, Name) Then
			Raise StrTemplate(
				"Virtual table %1 is given the list of extra dimension types %3 for one side of the entry. In this table the list does not filter accounts: it makes %2 the value of the listed kind in that position, in whichever slot the entry keeps it, and with %2 selected only the entries that carry that kind remain. Without the value of the list it is unknown which kind %2 is. Set the value of that parameter above and translate again, or stop selecting %2.",
				Plan.BaseName, Name, TrimAll(Types));
		EndIf;
	EndDo;

EndProcedure

// То же для условия ОборотыДтКт: DrCrConditionBase ставит СубконтоДт1 в первый слот
// хранения, а список видов перенумеровывает слоты. Пока перенумерация в условии не
// сделана, такое условие отбирало бы молча по чужому субконто.
Procedure CheckConditionExtDimensionTypes(Plan, Condition, Types, Side)

	If IsBlankString(Types) Or IsBlankString(Condition) Then
		Return;
	EndIf;
	Russian = ?(Side = "Dr", "Дт", "Кт");
	For Each Token In Tokenize(Condition) Do
		If Token.Kind <> "Name" Then
			Continue;
		EndIf;
		Head = Upper(StrSplit(Token.Value, ".")[0]);
		For Number = 1 To Plan.Slots Do
			Digits = Format(Number, "NG=0; NZ=0");
			If Head = Upper("ExtDimension" + Side + Digits) Or Head = Upper("Субконто" + Russian + Digits) Then
				Raise StrTemplate(
					"Virtual table %1 is given the list of extra dimension types %3, and its condition names %2. The list renumbers the ExtDimension columns, so it is unknown which stored slot %2 means. Move that filter to WHERE of the query or drop the list of types.",
					Plan.BaseName, Token.Value, TrimAll(Types));
			EndIf;
		EndDo;
	EndDo;

EndProcedure

Function AccountingSubquery(Descriptor, Context)

	Plan = Descriptor.AccountingPlan;
	Base = Plan.Base;
	Register = Plan.Register;
	Arguments = Plan.Arguments;

	If Plan.Kind = "BALANCE" Then
		Start = "";
		Finish = TranslateArgument(ArgumentAt(Arguments, 0), Context);
	Else
		Start = TranslateArgument(ArgumentAt(Arguments, 0), Context);
		Finish = TranslateArgument(ArgumentAt(Arguments, 1), Context);
	EndIf;

	Sides = AccountingSides(Register);
	Correspondence = HasCorrespondence(Register);
	Roles = AccountingArguments(Plan.Kind);
	// У ОборотыДтКт список видов счета не отбирает (замер 17.11.2026) - там он проверяется по
	// сторонам и только для выбранных субконто (AccountingDrCrTurnovers).
	If Plan.TypeList = Undefined And Plan.Kind <> "DRCRTURNOVERS" Then
		CheckExtDimensionTypes(Descriptor, Plan,
			RoleArgument(Arguments, Roles.ExtDimensionTypes), "", True);
	EndIf;
	If Plan.CorrTypeList = Undefined And Plan.Kind <> "DRCRTURNOVERS" Then
		CheckExtDimensionTypes(Descriptor, Plan,
			RoleArgument(Arguments, Roles.CorrExtDimensionTypes), "", True);
	EndIf;
	Plan.ExtDimensionTypes = ?(Plan.TypeList = Undefined, New Array, Plan.TypeList);
	Plan.CorrExtDimensionTypes = ?(Plan.CorrTypeList = Undefined, New Array, Plan.CorrTypeList);

	Detail = DetailForUsedFields(PeriodDetail(RoleArgument(Arguments, Roles.Periodicity), Base,
		Context), Descriptor.Used, Base, Context);
	If Plan.Kind = "BALANCEANDTURNOVERS" Then
		AddRecorderTypePart(Detail, Context);
	EndIf;
	If Detail.Kind = "AUTO" And Plan.Kind <> "DRCRTURNOVERS" And Not Used(Descriptor, "Period")
		And Not Used(Descriptor, "Recorder") And Not Used(Descriptor, "LineNumber") Then
		// При Авто платформа берёт периодичность по самому мелкому выбранному полю периода:
		// выбран один ПериодМесяц - таблица помесячная (сверка battery28: 1С 39 строк, SQL 3450
		// по записям). Здесь Авто строится по записям, поэтому без поля уровня записи - отказ.
		Raise StrTemplate(
			"Virtual table %1 is given periodicity Auto, and no record-level field (Period, Recorder,"
			+ " LineNumber) is selected. The platform then groups by the finest selected period field,"
			+ " and this translation builds Auto per record. Give the periodicity explicitly, such as"
			+ " Month.", Plan.BaseName);
	EndIf;
	If Detail.Kind = "AUTO" And Plan.Kind = "BALANCEANDTURNOVERS" Then
		If Used(Descriptor, "Recorder") And Not Used(Descriptor, "LineNumber") Then
			// Сверка ak121 (21.11.2026, УХ, 26 в иерархии за декабрь 2016): 1С 9 строк - по регистратору,
			// перевод по записям давал 23.
			Raise StrTemplate(
				"Virtual table %1 is given periodicity Auto, and Recorder is selected without LineNumber. The"
				+ " platform then builds the table per recorder, and this translation builds Auto per record"
				+ " (9 rows against 23 on the measured query). Give the periodicity Recorder explicitly, or"
				+ " select LineNumber as well.", Plan.BaseName);
		EndIf;
		For Each Column In Detail.Columns Do
			If StrEndsWith(Column.Alias, "Period") And Column.Alias <> Detail.Columns[0].Alias
				And Used(Descriptor, Column.Alias) Then
				// Сверка ak123: у строки без записи ПериодДень - дата начала интервала, перевод отдавал NULL.
				Raise StrTemplate(
					"Virtual table %1 is given periodicity Auto, and a period field coarser than a second is"
					+ " selected next to the record fields. For the row without a record (the opening balance,"
					+ " a period boundary) the platform fills that field from the boundary date, and this is not"
					+ " translated. Select PeriodSecond and truncate it in the query, or give the periodicity"
					+ " explicitly.", Plan.BaseName);
			EndIf;
		EndDo;
	EndIf;
	If Plan.Kind = "RECORDS" Then
		Return AccountingRecords(Plan, Base, Register, Start, Finish, Context);
	ElsIf Plan.Kind = "DRCRTURNOVERS" Then
		// Замерено (9412, 9419): с периодичностью платформа группирует ОборотыДтКт по
		// периоду и тогда, когда Период не выбран, - строка на каждый период. Построены
		// период-единица (День ... Год), Регистратор и Запись (замер g_rg1-g_rg5) и Авто (замер
		// a1-a14; поля Период у Авто нет вовсе - замер g_rg6).
		If Detail.Kind <> "NONE" And Detail.Kind <> "UNIT" And Detail.Kind <> "RECORDER"
			And Detail.Kind <> "RECORD" And Detail.Kind <> "AUTO" Then
			Raise StrTemplate(
				"Virtual table %1 is given periodicity %2. The platform groups its turnovers by that period even when Period is not selected, and this translation builds only a calendar unit (Day to Year), Recorder and Record for this table.",
				Plan.BaseName, TrimAll(RoleArgument(Arguments, Roles.Periodicity)));
		EndIf;
		Return AccountingDrCrTurnovers(Descriptor, Plan, Base, Register, Start, Finish, Context, Detail);
	EndIf;

	// Состав группировки урезается до полей, которые спросил внешний запрос, - так же
	// поступает платформа. Счёт при остатках нужен всегда: по нему берётся вид счёта.
	Requested = New Array;
	If Used(Descriptor, "Account") Then
		Requested.Add("Account");
	EndIf;
	For Each Dimension In Plan.Dimensions Do
		If Used(Descriptor, Dimension.Name) Then
			Requested.Add(Dimension.Name);
		EndIf;
	EndDo;
	For Number = 1 To Plan.Exposed Do
		Name = "ExtDimension" + Format(Number, "NG=0; NZ=0");
		If Used(Descriptor, Name) Then
			Requested.Add(Name);
			For Each Part In ExtDimensionPartNames(Name) Do
				Requested.Add(Part);
			EndDo;
		EndIf;
	EndDo;
	If Plan.Kind = "TURNOVERS" And Correspondence Then
		If Used(Descriptor, "BalancedAccount") Then
			Requested.Add("BalancedAccount");
		EndIf;
		For Number = 1 To Plan.Slots Do
			Name = "BalancedExtDimension" + Format(Number, "NG=0; NZ=0");
			If Used(Descriptor, Name) Then
				Requested.Add(Name);
				For Each Part In ExtDimensionPartNames(Name) Do
					Requested.Add(Part);
				EndDo;
			EndIf;
		EndDo;
		For Each Dimension In Plan.Dimensions Do
			If Dimension.IsBalance Then
				Continue;
			EndIf;
			If Used(Descriptor, Dimension.Name + "Balanced") Then
				Requested.Add(Dimension.Name + "Balanced");
			EndIf;
		EndDo;
	EndIf;

	// Развёрнутый остаток собирается отдельной свёрткой поверх остатка (AccountingExpandedFold).
	Expanded = False;
	For Each Resource In Plan.Resources Do
		For Each Suffix In SplittedBalanceSuffixes() Do
			If Used(Descriptor, Resource.Name + Suffix) Then
				Expanded = True;
			EndIf;
		EndDo;
	EndDo;

	// Свёрнутый остаток одной стороны без счёта и аналитики. С условием счёта платформа знает вид
	// счетов заранее, и сторона, которой у этого вида не бывает, - константа без агрегата: строк
	// столько, сколько строк читает запрос (OneSidedBalanceUnion). Без условия счёта вид всегда 2,
	// сторона раскладывается по знаку суммы - одна строка итога, прежний перевод (замеры bnoacc,
	// u_bt0, u_bt1, 21.11.2026, УХ). Дт одного ресурса рядом с Кт другого - тоже одна строка.
	OneSide = "";
	If Plan.Kind <> "TURNOVERS" And Requested.Count() = 0 And Detail.Kind = "NONE"
		And Not IsBlankString(RoleArgument(Arguments, Roles.AccountCondition)) Then
		OneSide = OneSidedBalanceSide(Descriptor, Plan);
	EndIf;
	If Not IsBlankString(OneSide) Then
		CheckOneSidedBalance(Plan, Context);
	EndIf;

	// Счёт не добавляем принудительно: платформа при невыбранном счёте не знает его вида
	// и отдаёт по дебету и кредиту нули. Повторяем это буквально.
	// Развёрнутый остаток платформа раскладывает по знаку остатка строки на уровне выбранных
	// полей, а не по полной аналитике (nap6, УХ: при Счет, Счет+Организация, Организация,
	// Счет+Субконто1 - 110/265/3/537 строк, ни в одной нет и дебета, и кредита сразу).
	Grouping = Requested;

	PeriodAlias = QuoteIdentifier("Period", Context);
	SideAlias = QuoteIdentifier("Side", Context);

	Branches = New Array;
	BalanceOff = False;
	NullBalance = False;
	For SideIndex = 0 To Sides.Count() - 1 Do
		Side = Sides[SideIndex];
		Select = New Array;

		For Each Name In Grouping Do
			Select.Add("      " + AccountingSourceColumn(Plan, Base, Name, Side, Context)
				+ " AS " + QuoteIdentifier(Name, Context));
		EndDo;
		If Plan.Kind <> "TURNOVERS" And Grouping.Find("Account") = Undefined Then
			// Счёт наружу не спросили, но без него неизвестен вид счёта, а он решает,
			// в какую половину - дебет или кредит - попадёт сальдо.
			Select.Add("      " + AccountingSourceColumn(Plan, Base, "Account", Side, Context)
				+ " AS " + QuoteIdentifier("Account", Context));
		EndIf;
		For Each Resource In Plan.Resources Do
			Select.Add("      " + AccountingColumn(Base,
				SideFieldName(Resource.Name, Side, Resource.IsBalance, Base), Context)
				+ " AS " + QuoteIdentifier(Resource.Name, Context));
			If Plan.Kind = "TURNOVERS" And Correspondence And Not Resource.IsBalance Then
				// Корреспондирующий оборот - это значение той же проводки с другой стороны.
				Select.Add("      " + AccountingColumn(Base,
					SideFieldName(Resource.Name, OppositeSide(Side), Resource.IsBalance, Base), Context)
					+ " AS " + QuoteIdentifier("Balanced" + Resource.Name, Context));
			EndIf;
		EndDo;
		Select.Add("      " + VirtualColumn(PeriodColumn(Base), Context) + " AS " + PeriodAlias);
		Select.Add("      " + ?(Correspondence, Format(SideIndex, "NG=0; NZ=0"),
			AccountingColumn(Base, RecordTypeFieldName(Base), Context)) + " AS " + SideAlias);
		For Each Column In Detail.Columns Do
			If DerivedFromPeriod(Column.Expression, Base, Context) Then
				Continue;
			EndIf;
			Select.Add("      " + Column.Expression + " AS " + QuoteIdentifier(Column.Alias, Context));
		EndDo;

		Where = New Array;
		Joins = New Array;
		Active = ActiveCondition(Base, Context);
		If Not IsBlankString(Active) Then
			Where.Add(Active);
		EndIf;
		Conditional = ConditionBase(Plan, Base, Side, Context);
		AddCondition(Where, ConditionSql(RoleArgument(Arguments, Roles.Condition),
			Conditional, Context, Joins));
		AddCondition(Where, AccountConditionSql(RoleArgument(Arguments, Roles.AccountCondition),
			Conditional, Side, AccountConditionNames(""), Context, Joins));
		AddCondition(Where, AccountConditionSql(RoleArgument(Arguments, Roles.CorrAccountCondition),
			Conditional, OppositeSide(Side), AccountConditionNames("Кор"), Context, Joins));
		Period = VirtualColumn(PeriodColumn(Base), Context);
		Untracked = "";
		If Plan.Kind <> "TURNOVERS" Then
			Untracked = ConditionUntracked(Plan, Base, Side, RoleArgument(Arguments, Roles.Condition), Context);
		EndIf;
		If Plan.Kind = "BALANCEANDTURNOVERS" And Not IsBlankString(Untracked) Then
			NullFeed = ConditionTestsNull(RoleArgument(Arguments, Roles.Condition))
				And Detail.Kind = "NONE" And IsBlankString(OneSide) And Not IsBlankString(Start) And Not IsBlankString(Finish)
				And Context.Options.Dialect <> "PostgreSQL";
			If NullFeed Then
				NullBalance = True;
			ElsIf ConditionTestsNull(RoleArgument(Arguments, Roles.Condition)) Then
				// Условие, истинное на NULL, у счёта с оборотным субконто (замеры x03, x04, 21.11.2026, УХ):
				// остатки платформа берёт из строк итогов на период итогов, обороты - по проводкам. Счёт 26
				// за 10.03-20.03.2017 с «Субконто1 ЕСТЬ NULL» - начальный и конечный остаток 929 085,61,
				// это остаток на 01.04.2017. У Остатков это переведено (BalanceTotalsPoint), здесь - нет.
				Raise StrTemplate(
					"Virtual table %1 names an ext dimension in its condition together with a NULL test (IS NULL,"
					+ " ISNULL or CASE). For an account that keeps this ext dimension as turnovers only the platform"
					+ " takes the balances of BalanceAndTurnovers from the stored totals rows, where that ext"
					+ " dimension is NULL, as of the totals period, and the turnovers from the entries; the result"
					+ " depends on the calculated totals of the infobase, and that reading is not translated for"
					+ " this table. Move the NULL test to WHERE of the query, or use the Balance table - it is"
					+ " translated.", Plan.BaseName);
			EndIf;
			BalanceOff = True;
			Select.Add("      CASE WHEN " + Untracked + " THEN 1 ELSE 0 END AS "
				+ QuoteIdentifier("BalanceOff", Context));
		EndIf;
		If Plan.Kind = "BALANCE" And Not IsBlankString(Finish) And Not IsBlankString(Untracked) Then
			// Счёт с оборотным субконто в условии: остаток у платформы - строки итогов на период
			// итогов, а проводки от даты до него отбираются по самому значению субконто и остатка не
			// двигают (ConditionUntracked). Поэтому у такого счёта остаток берётся не на дату, а на
			// период итогов (BalanceTotalsPoint).
			Where.Add(Period + " < CASE WHEN " + Untracked + " THEN "
				+ BalanceTotalsPoint(Plan, Finish, Context) + " ELSE " + Finish + " END");
		ElsIf Plan.Kind = "BALANCE" And Not IsBlankString(Finish) Then
			Where.Add(Period + " < " + Finish);
		ElsIf Plan.Kind = "TURNOVERS" Then
			If Not IsBlankString(Start) Then
				Where.Add(Period + " >= " + Start);
			EndIf;
			If Not IsBlankString(Finish) Then
				Where.Add(Period + " <= " + Finish);
			EndIf;
		ElsIf Not IsBlankString(Finish) Then
			Where.Add(Period + " <= " + Finish);
		EndIf;
		Where.Add(AccountingColumn(Base, AccountFieldName(Base, Side), Context)
			+ " <> " + BinaryLiteral("00000000000000000000000000000000", Context));
		AddCondition(Where, AccountKindsFilter(Plan, Plan.ExtDimensionTypes,
			AccountingColumn(Base, AccountFieldName(Base, Side), Context), Context));
		If Correspondence Then
			AddCondition(Where, AccountKindsFilter(Plan, Plan.CorrExtDimensionTypes,
				AccountingColumn(Base, AccountFieldName(Base, OppositeSide(Side)), Context), Context));
		EndIf;

		If NullBalance Then
			Select.Add("      0 AS " + QuoteIdentifier("NullBalance", Context));
		EndIf;
		Lines = New Array;
		Lines.Add("      SELECT");
		Lines.Add(StrConcat(Select, "," + Chars.LF));
		Lines.Add("      FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS " + VirtualAlias());
		AddNavigationJoins(Lines, Joins, "      ");
		Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));
		Branches.Add(StrConcat(Lines, Chars.LF));
		If NullBalance Then
			Branches.Add(NullBalanceBranch(Plan, Base, Side, Select, Grouping, Arguments, Roles, Conditional, Untracked,
				Start, Finish, Context));
		EndIf;
	EndDo;
	Plan.Insert("NullBalance", NullBalance);

	Descriptor.ZeroGrouped = Grouping.Count() > 0;
	// Итоговая строка пустого набора несёт 0, а не NULL суммы (УХ, n27.py, Хозрасчетный с отбором
	// ЛОЖЬ или несуществующим счётом: Остатки - 0; Обороты и ОстаткиИОбороты с датой начала - 0).
	// Без даты начала Обороты и ОстаткиИОбороты не замерены и остаются прежними.
	Descriptor.Insert("ZeroTotals", Grouping.Count() = 0 And Detail.Kind = "NONE"
		And (Plan.Kind = "BALANCE" Or Not IsBlankString(Start)));

	Feed = StrConcat(Branches, Chars.LF + "      UNION ALL" + Chars.LF);
	Plan.Insert("BalanceOff", BalanceOff);

	If Not IsBlankString(OneSide) Then
		Return OneSidedBalanceUnion(Descriptor, Plan, Base, OneSide, Feed, Grouping, Start, Finish,
			Detail, Context);
	EndIf;

	If Detail.Kind <> "NONE" And Plan.Kind <> "TURNOVERS" Then
		// Развёрнутый остаток с периодичностью - по знаку остатка строки на уровне выбранных полей,
		// как и без периодичности (AccountingByPeriod, замер f_sp2).
		Return AccountingByPeriod(Descriptor, Plan, Base, Feed, Grouping, Detail,
			Start, Finish, PeriodCompletion(RoleArgument(Arguments, Roles.Completion)), Context);
	EndIf;

	Inner = AccountingAggregate(Plan, Feed, Grouping, Start, Finish, Detail, Context, Descriptor);
	If Not Expanded Then
		Return Inner;
	EndIf;
	Return AccountingExpandedFold(Plan, Inner, Requested, Context);

EndFunction

// Свёртка детального уровня к запрошенному. Свёрнутый остаток раскладывается заново
// по виду счёта, развёрнутый - складывается из уже разложенных частей детализации.
// Колонка детализации считается из периода (усечение, сортировочный ключ) или берётся
// из самой записи (регистратор, номер строки). Первые переписываются на питающий
// запрос, вторые должны в нём лежать готовыми.
Function DerivedFromPeriod(Expression, Base, Context)

	Return WholeColumnPosition(Expression, VirtualColumn(PeriodColumn(Base), Context), 1) > 0;

EndFunction

Function FeedPeriodExpression(Expression, Plan, Context)

	Source = VirtualColumn(PeriodColumn(Plan.Base), Context);
	Target = "F." + QuoteIdentifier("Period", Context);
	Result = Expression;
	From = 1;
	Position = WholeColumnPosition(Result, Source, From);
	While Position > 0 Do
		Result = Left(Result, Position - 1) + Target + Mid(Result, Position + StrLen(Source));
		From = Position + StrLen(Target);
		Position = WholeColumnPosition(Result, Source, From);
	EndDo;
	Return Result;

EndFunction

// Вхождение имени колонки целиком. Имя периода - префикс имён вроде _PeriodAdjustment,
// и подстановка по подстроке рвала бы такой идентификатор пополам.
Function WholeColumnPosition(Expression, Column, From)

	Shift = From;
	While Shift <= StrLen(Expression) Do
		Found = StrFind(Mid(Expression, Shift), Column);
		If Found = 0 Then
			Return 0;
		EndIf;
		Position = Shift + Found - 1;
		Next = Mid(Expression, Position + StrLen(Column), 1);
		If IsBlankString(Next) Or (Not IsDigit(Next)
			And StrFind("ABCDEFGHIJKLMNOPQRSTUVWXYZ_", Upper(Next)) = 0) Then
			Return Position;
		EndIf;
		Shift = Position + StrLen(Column);
	EndDo;
	Return 0;

EndFunction

// Остатки и обороты бухгалтерского регистра с периодичностью. Остаток переносится
// между периодами оконной суммой - так же, как у регистра накопления, - а дебет
// с кредитом раскладываются по виду счёта уже после переноса.
// Спросили ли снаружи оборот этого ресурса.
Function TurnoverRequested(Descriptor, ResourceName)

	Return Used(Descriptor, ResourceName + "Turnover")
		Or Used(Descriptor, ResourceName + "TurnoverDr")
		Or Used(Descriptor, ResourceName + "TurnoverCr")
		Or Used(Descriptor, ResourceName + "BalancedTurnover")
		Or Used(Descriptor, ResourceName + "BalancedTurnoverDr")
		Or Used(Descriptor, ResourceName + "BalancedTurnoverCr");

EndFunction

// Спросили ли снаружи хоть какой-нибудь остаток.
Function BalanceRequested(Descriptor, Plan)

	Suffixes = New Array;
	Suffixes.Add("Balance");
	Suffixes.Add("BalanceDr");
	Suffixes.Add("BalanceCr");
	Suffixes.Add("OpeningBalance");
	Suffixes.Add("OpeningBalanceDr");
	Suffixes.Add("OpeningBalanceCr");
	Suffixes.Add("ClosingBalance");
	Suffixes.Add("ClosingBalanceDr");
	Suffixes.Add("ClosingBalanceCr");
	For Each Item In SplittedBalanceSuffixes() Do
		Suffixes.Add(Item);
	EndDo;

	For Each Resource In Plan.Resources Do
		For Each Suffix In Suffixes Do
			If Used(Descriptor, Resource.Name + Suffix) Then
				Return True;
			EndIf;
		EndDo;
	EndDo;
	Return False;

EndFunction

Function AccountingByPeriod(Descriptor, Plan, Base, Feed, Grouping, Detail,
	Start, Finish, Completion, Context)

	PeriodAlias = QuoteIdentifier("Period", Context);
	SideColumn = "F." + QuoteIdentifier("Side", Context);
	RawPeriod = "F." + PeriodAlias;
	PeriodPhysical = VirtualColumn(PeriodColumn(Base), Context);

	Bucket = FeedPeriodExpression(Detail.Columns[0].Expression, Plan, Context);
	If Not IsBlankString(Start) Then
		// Всё, что раньше интервала, сливается в бакет начала: остаток не с чего начать.
		Bucket = "CASE WHEN " + RawPeriod + " < " + Start + " THEN "
			+ StrReplace(Detail.Columns[0].Expression, PeriodPhysical, Start)
			+ " ELSE " + Bucket + " END";
	EndIf;
	Inside = ?(IsBlankString(Start), "", RawPeriod + " >= " + Start);

	Chart = ChartOfAccountsInfo(Plan.Register, Context);

	// Субконто «только обороты» (сверка nap1 на УХ, счёт 08.04.2): обороты платформа группирует
	// по значению субконто, а остаток - по NULL на его месте; строки оборотов несут нулевой
	// остаток, строка остатка - нулевые обороты. Лента удваивается: часть 0 даёт обороты, часть 1 -
	// остаток с обнулённым субконто; часть 1 остаётся только там, где обнуление что-то меняет.
	// Без остатков в выборке строк с NULL в периодах движений нет (nap3: 90.01.1 за 2000-2030 -
	// 17 строк, все со значением), и расщепа тогда нет. Границы без остатков в выборке не
	// переводятся: за полгода 2017 обе границы платформа отдала по NULL и ни одной по значению, а
	// за 2000-2030 границу конца - по значению (nap1 --bnd, один СуммаОборотДт; rev26.py, счёт 51,
	// Субконто2: 1С 2 строки, SQL 4). Из запроса эти два случая не различить.
	BalanceSelected = False;
	For Each Resource In Plan.Resources Do
		For Each Suffix In StrSplit("OpeningBalance,OpeningBalanceDr,OpeningBalanceCr,"
			+ "ClosingBalance,ClosingBalanceDr,ClosingBalanceCr,OpeningSplittedBalanceDr,"
			+ "OpeningSplittedBalanceCr,ClosingSplittedBalanceDr,ClosingSplittedBalanceCr", ",") Do
			If Used(Descriptor, Resource.Name + Suffix) Then
				BalanceSelected = True;
			EndIf;
		EndDo;
	EndDo;
	// Без полей остатка в выборке, с границами (сверка ac61-ac72, 21.11.2026, УХ: счёт 26 с оборотным
	// Субконто1 по месяцам, дням, записи и регистратору, 08.04.2 с оборотным Субконто2, список видов
	// «Основные средства»; интервалы внутри рассчитанных итогов, через их конец и шире данных): остаток до начала интервала лежит под NULL на месте оборотного субконто, движения
	// интервала - под значением, и остаток строки-границы копится по своему ключу. Граница начала
	// поэтому идёт по NULL, граница конца - по NULL, если был остаток на начало, и по значению, если
	// чистый оборот значения за интервал не нулевой. Прежние наблюдения - «за полгода 2017 обе
	// границы по NULL» и «за 2000-2030 граница конца по значению» - два случая этого правила, а не
	// состояние итогов базы.
	BoundarySplit = Not BalanceSelected And Completion <> "MOVEMENTS"
		And Not (IsBlankString(Start) And IsBlankString(Finish));
	Split = ?(BalanceSelected Or BoundarySplit, TurnoverOnlySplit(Plan, Grouping, Context), Undefined);
	PartColumn = "X." + QuoteIdentifier("Part", Context);

	Select = New Array;
	Group = New Array;
	Keys = New Array;
	For Each Name In Grouping Do
		Quoted = QuoteIdentifier(Name, Context);
		Expression = "F." + Quoted;
		If Split <> Undefined And Split.Slots.Get(Name) <> Undefined Then
			Expression = "CASE WHEN " + PartColumn + " = 1 AND " + Split.Slots.Get(Name)
				+ " THEN NULL ELSE " + Expression + " END";
		EndIf;
		Select.Add("    " + Expression + " AS " + Quoted);
		Group.Add(Expression);
		Keys.Add(Quoted);
	EndDo;
	Select.Add("    " + Bucket + " AS " + PeriodAlias);
	Group.Add(Bucket);

	// Детализация до записи добавляет к периоду сам регистратор: корзиной становится
	// запись, а не отрезок времени. Остальные колонки детализации собираются так же.
	RecordAliases = New Array;
	For Index = 1 To Detail.Columns.Count() - 1 Do
		Column = Detail.Columns[Index];
		Quoted = QuoteIdentifier(Column.Alias, Context);
		Expression = ?(DerivedFromPeriod(Column.Expression, Base, Context),
			FeedPeriodExpression(Column.Expression, Plan, Context),
			"F." + Quoted);
		// Всё, что раньше интервала, сливается в одну строку начального остатка: своей
		// записи у неё нет, и платформа показывает пустой регистратор.
		If Not IsBlankString(Inside) Then
			Expression = "CASE WHEN " + Inside + " THEN " + Expression + " ELSE NULL END";
		EndIf;
		Select.Add("    " + Expression + " AS " + Quoted);
		Group.Add(Expression);
		RecordAliases.Add(Quoted);
	EndDo;

	TurnoverPart = ?(Split = Undefined, "", PartColumn + " = 0");
	For Each Resource In Plan.Resources Do
		Value = "F." + QuoteIdentifier(Resource.Name, Context);
		Select.Add("    SUM(" + Guarded(Value, Both(Inside, Both(SideColumn + " = 0", TurnoverPart, ""), ""))
			+ ") AS " + QuoteIdentifier(Resource.Name + "TurnoverDr", Context));
		Select.Add("    SUM(" + Guarded(Value, Both(Inside, Both(SideColumn + " = 1", TurnoverPart, ""), ""))
			+ ") AS " + QuoteIdentifier(Resource.Name + "TurnoverCr", Context));
		BalanceValue = ?(Split = Undefined, Value,
			"(CASE WHEN " + PartColumn + " = 1 OR NOT " + Split.Untracked + " THEN " + Value + " ELSE 0 END)");
		If Split <> Undefined And BoundarySplit Then
			// Часть 1 (субконто обнулено) несёт остаток до начала интервала, часть 0 - движения интервала.
			BalanceValue = "(CASE WHEN NOT " + Split.Untracked + " OR " + PartColumn + " = 0"
				+ ?(IsBlankString(Inside), "", " AND " + Inside + " OR " + PartColumn + " = 1 AND NOT (" + Inside + ")")
				+ " THEN " + Value + " ELSE 0 END)";
		EndIf;
		BalanceValue = GuardedBalance(Plan, BalanceValue, Context);
		Select.Add("    " + SignedSum(SideColumn, BalanceValue, "") + " AS "
			+ QuoteIdentifier(Resource.Name + "Delta", Context));
		// Сдвиг остатка внутри интервала: начальный остаток - нарастающий итог без него. С оборотом
		// он совпадает, пока остаток и обороты лежат в одной строке; у субконто «только обороты» - нет.
		Select.Add("    " + SignedSum(SideColumn, BalanceValue, Inside) + " AS "
			+ QuoteIdentifier(Resource.Name + "Shift", Context));
	EndDo;
	// Движение периода решает ненулевой ОБОРОТ спрошенного ресурса: проводка, двинувшая
	// только количество, при запросе оборота суммы в результат не попадает. Если оборот
	// не спрашивали вовсе, движением считается сама запись - замерено на обоих методах
	// дополнения.
	Moves = New Array;
	For Each Resource In Plan.Resources Do
		If TurnoverRequested(Descriptor, Resource.Name) Then
			Moves.Add("F." + QuoteIdentifier(Resource.Name, Context) + " <> 0");
		EndIf;
	EndDo;
	// Движение - ненулевой оборот за период по ключу, а не ненулевая запись: сторно -X и +X по
	// одному субконто в одном месяце строки не дают (nap4: 62.02, апрель 2017).
	Checks = New Array;
	For Each Resource In Plan.Resources Do
		If Moves.Count() > 0 And TurnoverRequested(Descriptor, Resource.Name) Then
			Value = "F." + QuoteIdentifier(Resource.Name, Context);
			Checks.Add("SUM(" + Guarded(Value, Both(Inside, SideColumn + " = 0", TurnoverPart)) + ") <> 0");
			Checks.Add("SUM(" + Guarded(Value, Both(Inside, SideColumn + " = 1", TurnoverPart)) + ") <> 0");
		EndIf;
	EndDo;
	If Checks.Count() = 0 Then
		// Оборот не спрошен: движение - ненулевой оборот за период по любому ресурсу. Запись,
		// двинувшая только количество, строку даёт, а сторно -X/+X - нет (nap1 --mov: 62.02,
		// апрель 2017, только остатки суммы).
		For Each Resource In Plan.Resources Do
			Value = "F." + QuoteIdentifier(Resource.Name, Context);
			Checks.Add("SUM(" + Guarded(Value, Both(Inside, SideColumn + " = 0", TurnoverPart)) + ") <> 0");
			Checks.Add("SUM(" + Guarded(Value, Both(Inside, SideColumn + " = 1", TurnoverPart)) + ") <> 0");
		EndDo;
	EndIf;
	If Split <> Undefined And BalanceSelected Then
		// Строка остатка с обнулённым субконто движется, только если её остаток сдвинулся: приход
		// и расход на одну сумму по разным значениям субконто строки за месяц не дают (nap1, 08.04.2).
		For Each Resource In Plan.Resources Do
			If Moves.Count() = 0 Or TurnoverRequested(Descriptor, Resource.Name) Then
				Checks.Add(SignedSum(SideColumn, "F." + QuoteIdentifier(Resource.Name, Context),
					Both(Inside, PartColumn + " = 1", "")) + " <> 0");
			EndIf;
		EndDo;
	EndIf;
	Select.Add("    " + ?(Checks.Count() = 0, "1",
		"CASE WHEN " + StrConcat(Checks, " OR ") + " THEN 1 ELSE 0 END")
		+ " AS " + QuoteIdentifier("Moved", Context));
	// Счёт не выбран - вид счёта один на весь запрос, как его заранее читает платформа
	// (UnselectedAccountKind; сверка ak06, ak07: 51 и 86 по годам и по регистратору).
	GivenKind = ?(Grouping.Find("Account") = Undefined, UnselectedAccountKind(Plan, Context), "");
	If IsBlankString(GivenKind) Then
		Select.Add("    MIN(K." + Chart.Kind + ") AS " + QuoteIdentifier("AccountKindLow", Context));
		Select.Add("    MAX(K." + Chart.Kind + ") AS " + QuoteIdentifier("AccountKindHigh", Context));
	Else
		Select.Add("    MIN(KO." + QuoteIdentifier("Kind", Context) + ") AS "
			+ QuoteIdentifier("AccountKindLow", Context));
		Select.Add("    MAX(KO." + QuoteIdentifier("Kind", Context) + ") AS "
			+ QuoteIdentifier("AccountKindHigh", Context));
	EndIf;

	Lines = New Array;
	Lines.Add("  SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("  FROM (");
	Lines.Add(Feed);
	Lines.Add("  ) AS F");
	Lines.Add("  INNER JOIN " + Chart.Table + " AS K ON K." + Chart.Key
		+ " = F." + QuoteIdentifier("Account", Context));
	If Not IsBlankString(GivenKind) Then
		Lines.Add("  CROSS JOIN (SELECT " + GivenKind + " AS " + QuoteIdentifier("Kind", Context) + ") AS KO");
	EndIf;
	If Split <> Undefined Then
		Lines.Add("  CROSS JOIN (SELECT 0 AS " + QuoteIdentifier("Part", Context)
			+ " UNION ALL SELECT 1) AS X");
		For Each Join In Split.Joins Do
			Lines.Add("  " + Join);
		EndDo;
		If BoundarySplit Then
			// Часть 1 здесь - только остаток до начала интервала: внутри интервала у неё нет ни оборотов,
			// ни остатка, а её пустые строки записей гасили бы границу конца по NULL (замер y71: по
			// регистратору за декабрь 2016 у счёта 26 граница конца с NULL есть).
			Lines.Add("  WHERE " + PartColumn + " = 0"
				+ ?(IsBlankString(Inside), "", " OR " + Split.Untracked + " AND NOT (" + Inside + ")"));
		Else
			Lines.Add("  WHERE " + PartColumn + " = 0 OR " + Split.Untracked);
		EndIf;
	EndIf;
	Lines.Add("  GROUP BY " + StrConcat(Group, ", "));

	FeedName = RegisterCommonTable(StrConcat(Lines, Chars.LF), Context, "VTF");
	// Состав строк от выбранных полей не зависит: и с одними оборотами платформа отдаёт те же
	// строки, что с остатком (сверка battery28c: ОстаткиИОбороты(…, Месяц) со Счет, Период,
	// СуммаОборотДт - 1С 853, а прежнее «ведёт себя как Обороты» давало 478; с конечным
	// остатком 853 = 853).
	Anchor = BalanceAnchor(FeedName, PeriodAlias, Keys, RecordAliases, Detail, PeriodPhysical,
		Start, Finish, Completion, Context);

	Shown = QuoteIdentifier("Shown", Context);
	KindAlias = QuoteIdentifier("AccountKind", Context);
	Partition = New Array;
	For Each Slot In Keys Do
		Partition.Add("P." + Slot);
	EndDo;
	Frame = ?(Partition.Count() = 0, "", "PARTITION BY " + StrConcat(Partition, ", "));

	Ordering = New Array;
	Ordering.Add("P." + PeriodAlias);
	RecorderAlias = QuoteIdentifier("Recorder", Context);
	If RecordAliases.Find(RecorderAlias) <> Undefined Then
		// Строка без регистратора - это входящий остаток (момент начала) или граница конца. Первая
		// должна встать раньше записей своего момента, вторая - позже, а NULL у MS SQL сортируется
		// первым, у PostgreSQL последним. Без явного ранга граница конца на MS SQL теряла записи
		// момента конца (rev26.py, УХ, 26 в иерархии, январь 2017 по регистратору: 1С 17 строк,
		// SQL 18; причина выведена из порядка сортировки, построчно лишняя строка не снималась).
		EndBucket = ?(IsBlankString(Finish), "",
			StrReplace(Detail.Columns[0].Expression, PeriodPhysical, Finish));
		Ordering.Add("CASE WHEN P." + RecorderAlias + " IS NOT NULL THEN 1"
			+ ?(IsBlankString(EndBucket), "", " WHEN P." + PeriodAlias + " = " + EndBucket + " THEN 2")
			+ " ELSE 0 END");
	EndIf;
	// Внутри одного момента - сначала вид регистратора, потом ссылка (сверка dbg36 на
	// регистре накопления: приход другим документом платформа ставит раньше).
	For Each Slot In RecordAliases Do
		If StrFind(Upper(Slot), "_RTREF") > 0 Then
			Ordering.Add("P." + Slot);
		EndIf;
	EndDo;
	For Each Slot In RecordAliases Do
		If StrFind(Upper(Slot), "_RTREF") = 0 Then
			Ordering.Add("P." + Slot);
		EndIf;
	EndDo;

	Middle = New Array;
	For Each Slot In Keys Do
		Middle.Add("      P." + Slot + " AS " + Slot);
	EndDo;
	Middle.Add("      P." + PeriodAlias + " AS " + PeriodAlias);
	For Each Slot In RecordAliases Do
		Middle.Add("      P." + Slot + " AS " + Slot);
	EndDo;
	Middle.Add("      P." + Shown + " AS " + Shown);
	// Граница конца по ключу не выводится, если у ключа есть запись ровно в момент конца: её
	// заменяет последняя запись (dbg5b.py, УХ, 26 по регистратору: конец 31.01 23:59:59 и 29.01
	// 12:00:00 - строки границы нет, конец 23:59:58, 30.01 и 29.01 11:00 - есть; граница начала
	// есть всегда, и при записи в момент начала). По ключу, а не по таблице (dbg5c.py: строка
	// остатка оборотного субконто с NULL без записей в конце свою границу получает).
	EndTaken = QuoteIdentifier("EndTaken", Context);
	EndMoment = ?(IsBlankString(Finish), "", StrReplace(Detail.Columns[0].Expression, PeriodPhysical, Finish));
	If (Detail.Kind = "RECORDER" Or Detail.Kind = "RECORD" Or Detail.Kind = "AUTO") And Not IsBlankString(EndMoment)
		And RecordAliases.Find(QuoteIdentifier("Recorder", Context)) <> Undefined Then
		Middle.Add("      MAX(CASE WHEN P." + QuoteIdentifier("Recorder", Context) + " IS NOT NULL AND P."
			+ PeriodAlias + " = " + EndMoment + " THEN 1 ELSE 0 END) OVER (" + Frame + ") AS " + EndTaken);
	Else
		EndMoment = "";
	EndIf;
	// Вид счёта один на весь набор, но у строки-границы своей записи нет.
	Middle.Add("      " + AccountKindExpression(
		"MIN(F." + QuoteIdentifier("AccountKindLow", Context) + ") OVER (" + Frame + ")",
		"MAX(F." + QuoteIdentifier("AccountKindHigh", Context) + ") OVER (" + Frame + ")")
		+ " AS " + KindAlias);

	Join = New Array;
	Join.Add("F." + PeriodAlias + " = P." + PeriodAlias);
	For Each Slot In Keys Do
		// Субконто у счёта без такого вида - NULL с обеих сторон. Простое «=» такую пару
		// не находит, и строка теряла обороты и остаток (сверка battery28: 1С 2227 строк,
		// SQL 1093). Сравнение - как у записи ниже.
		Join.Add("(F." + Slot + " = P." + Slot
			+ " OR (F." + Slot + " IS NULL AND P." + Slot + " IS NULL))");
	EndDo;
	For Each Slot In RecordAliases Do
		// У строки начального остатка запись пустая с обеих сторон, а NULL = NULL
		// в T-SQL не совпадение: сравнение приходится писать явно.
		Join.Add("(F." + Slot + " = P." + Slot
			+ " OR (F." + Slot + " IS NULL AND P." + Slot + " IS NULL))");
	EndDo;

	Outer = New Array;
	For Each Slot In Keys Do
		Outer.Add("    W." + Slot + " AS " + Slot);
	EndDo;
	// Первый период при начале внутри него платформа показывает датой начала, а не началом
	// периода (nap1: ОстаткиИОбороты(15.03.2017, …, Месяц) - строки марта с Период = 15.03.2017).
	Outer.Add("    " + ?(IsBlankString(Start), "W." + PeriodAlias,
		"CASE WHEN W." + PeriodAlias + " < " + Start + " THEN " + Start + " ELSE W." + PeriodAlias + " END")
		+ " AS " + PeriodAlias);
	If Detail.Columns[0].Alias <> "Period" Then
		// Авто: корзина - самое мелкое поле периода (ПериодСекунда), оно же выходит под своим именем
		// (замер r6: у строки без записи ПериодСекунда - начало интервала).
		Outer.Add("    W." + PeriodAlias + " AS " + QuoteIdentifier(Detail.Columns[0].Alias, Context));
	EndIf;
	// У строки без записи (начальный остаток, граница) платформа отдаёт регистратор значением
	// НЕОПРЕДЕЛЕНО, а не NULL (BoundaryRecordValue).
	For Each Slot In RecordAliases Do
		Outer.Add("    " + BoundaryRecordValue(Detail, Slot, Context) + " AS " + Slot);
	EndDo;

	KindColumn = "W." + KindAlias;
	BalanceUsed = False;
	BalanceChecks = New Array;
	ZeroNames = New Array;

	NullFallback = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL");
	SelectedTurnovers = New Array;
	AnyResourceChecks = New Array;
	For Each Resource In Plan.Resources Do
		Debit = QuoteIdentifier(Resource.Name + "TurnoverDr", Context);
		Credit = QuoteIdentifier(Resource.Name + "TurnoverCr", Context);
		Delta = QuoteIdentifier(Resource.Name + "Delta", Context);
		Running = QuoteIdentifier(Resource.Name + "Running", Context);
		Shift = QuoteIdentifier(Resource.Name + "Shift", Context);
		If Used(Descriptor, Resource.Name + "Turnover") Then
			SelectedTurnovers.Add("W." + Debit + " <> W." + Credit);
		EndIf;
		If Used(Descriptor, Resource.Name + "TurnoverDr") Then
			SelectedTurnovers.Add("W." + Debit + " <> 0");
		EndIf;
		If Used(Descriptor, Resource.Name + "TurnoverCr") Then
			SelectedTurnovers.Add("W." + Credit + " <> 0");
		EndIf;

		Middle.Add("      " + NullFallback + "(F." + Debit + ", 0) AS " + Debit);
		Middle.Add("      " + NullFallback + "(F." + Credit + ", 0) AS " + Credit);
		Middle.Add("      " + NullFallback + "(F." + Shift + ", 0) AS " + Shift);
		Middle.Add("      SUM(" + NullFallback + "(F." + Delta + ", 0)) OVER (" + Frame
			+ ?(IsBlankString(Frame), "", " ") + "ORDER BY " + StrConcat(Ordering, ", ")
			+ " ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS " + Running);

		Turnover = "(W." + Debit + " - W." + Credit + ")";
		Opening = "(W." + Running + " - W." + Shift + ")";
		Closing = "W." + Running;

		AddBalanceFields(Outer, Resource.Name, "OpeningBalance", Opening, KindColumn, Context);
		AddAccountingField(Outer, Resource.Name + "Turnover", Turnover, Context);
		AddAccountingField(Outer, Resource.Name + "TurnoverDr", "W." + Debit, Context);
		AddAccountingField(Outer, Resource.Name + "TurnoverCr", "W." + Credit, Context);
		AddBalanceFields(Outer, Resource.Name, "ClosingBalance", Closing, KindColumn, Context);
		// Развёрнутый остаток с периодичностью - по знаку остатка строки на уровне выбранных полей,
		// как и без периодичности (замер f_sp2, 21.11.2026, УХ: 60.01 и 62.01 по месяцам без счёта в
		// выборке - конечный развёрнутый Дт 0 и Кт 5 373 222,60 при свёрнутом остатке -5 373 222,60;
		// по строкам аналитики было бы Дт 128 869,20 и Кт 5 502 091,80; со счётом - f_sp1, по
		// регистратору - f_sp3). Поля добавляются, только когда их спросили.
		AddSplittedFields(Outer, Descriptor, Resource.Name + "OpeningSplittedBalance", Opening, Context);
		AddSplittedFields(Outer, Descriptor, Resource.Name + "ClosingSplittedBalance", Closing, Context);

		If Used(Descriptor, Resource.Name + "OpeningBalance")
			Or Used(Descriptor, Resource.Name + "OpeningBalanceDr")
			Or Used(Descriptor, Resource.Name + "OpeningBalanceCr") Then
			BalanceUsed = True;
			BalanceChecks.Add(Opening + " <> 0");
		EndIf;
		If Used(Descriptor, Resource.Name + "ClosingBalance")
			Or Used(Descriptor, Resource.Name + "ClosingBalanceDr")
			Or Used(Descriptor, Resource.Name + "ClosingBalanceCr") Then
			BalanceUsed = True;
			BalanceChecks.Add(Closing + " <> 0");
		EndIf;
		If ResourceUsed(Descriptor.Used, Resource.Name, Plan.Resources) Then
			// Состав строк от выбранных полей не зависит (сверка battery28c: с одними
			// оборотами 1С отдаёт те же 853 строки, что и с конечным остатком), поэтому
			// остаток спрошенного ресурса проверяется, даже если его не выбрали.
			// Оба остатка проверяются всегда: у строки остатка с обнулённым субконто «только обороты»
			// бывает начальный остаток при нулевых конечном и оборотах (nap4: 99.01.1, декабрь 2016).
			If BalanceChecks.Find(Opening + " <> 0") = Undefined Then
				BalanceChecks.Add(Opening + " <> 0");
			EndIf;
			If BalanceChecks.Find(Closing + " <> 0") = Undefined Then
				BalanceChecks.Add(Closing + " <> 0");
			EndIf;
			BalanceUsed = True;
			BalanceChecks.Add("W." + Debit + " <> 0");
			BalanceChecks.Add("W." + Credit + " <> 0");
		EndIf;
		AnyResourceChecks.Add(Opening + " <> 0");
		AnyResourceChecks.Add(Closing + " <> 0");
		AnyResourceChecks.Add("W." + Debit + " <> 0");
		AnyResourceChecks.Add("W." + Credit + " <> 0");
		ZeroNames.Add(Resource.Name + "Turnover");
		ZeroNames.Add(Resource.Name + "TurnoverDr");
		ZeroNames.Add(Resource.Name + "TurnoverCr");
	EndDo;
	If Not BalanceUsed Then
		// Ни одного поля ресурса не выбрано, а строка-граница без остатка и без оборота в результат
		// всё равно не идёт (rev26.py, УХ, Счет и Период за 2018 по месяцам, оба метода с границами:
		// 1С 318 строк, без отсева 334). Допущение: остаток и оборот здесь - любого ресурса, как у
		// движения без спрошенного оборота; по одному ресурсу платформа не замерялась.
		For Each Check In AnyResourceChecks Do
			BalanceChecks.Add(Check);
		EndDo;
		BalanceUsed = True;
	EndIf;

	// Период с движениями виден всегда, период-граница - при ненулевом остатке; таблица
	// не превращается в обороты и тогда, когда остатков в запросе нет (сверка battery28c).
	Descriptor.ZeroFilter = ?(BalanceUsed, New Array, ZeroNames);

	Result = New Array;
	Result.Add("  SELECT");
	Result.Add(StrConcat(Outer, "," + Chars.LF));
	Result.Add("  FROM (");
	Result.Add("    SELECT");
	Result.Add(StrConcat(Middle, "," + Chars.LF));
	Result.Add("    FROM " + Anchor + " AS P");
	Result.Add("    LEFT JOIN " + FeedName + " AS F ON " + StrConcat(Join, " AND "));
	Result.Add("  ) AS W");
	If Detail.Kind = "RECORDER" Or Detail.Kind = "RECORD" Or Detail.Kind = "AUTO" Then
		// По записям (и при Авто с полем уровня записи - замер r6) строку даёт ненулевое движение
		// спрошенного ресурса, строку-границу -
		// ненулевой остаток (сверка dbg35b на регистре накопления; у бухрегистра лишними были
		// записи с нулевым оборотом суммы).
		Moves = New Array;
		Balances = New Array;
		For Each Resource In Plan.Resources Do
			If ResourceUsed(Descriptor.Used, Resource.Name, Plan.Resources) Then
				Debit = QuoteIdentifier(Resource.Name + "TurnoverDr", Context);
				Credit = QuoteIdentifier(Resource.Name + "TurnoverCr", Context);
				Running = QuoteIdentifier(Resource.Name + "Running", Context);
				Moves.Add("W." + Debit + " <> 0 OR W." + Credit + " <> 0");
				If Split <> Undefined And BalanceSelected Then
					// Строка остатка с обнулённым субконто «только обороты» оборотов не несёт:
					// запись видна по сдвигу остатка (nap1 --rec: 90.01.1 по регистратору).
					Moves.Add("W." + QuoteIdentifier(Resource.Name + "Shift", Context) + " <> 0");
				EndIf;
				Balances.Add("W." + Running + " <> 0");
			EndIf;
		EndDo;
		If Moves.Count() = 0 And Completion <> "MOVEMENTS" Then
			// Ни одного поля ресурса: движение и остаток - любого ресурса, как у отсева без полей
			// ресурса ниже, и граница конца так же уступает записи в момент конца (замер h_on1,
			// 21.11.2026, УХ: по Записи за 01.10-31.12.2016 у ключа с записью 31.12 23:59:59 строка
			// одна, без отдельной границы - 18 строк, с границей было 19).
			For Each Resource In Plan.Resources Do
				Moves.Add("W." + QuoteIdentifier(Resource.Name + "TurnoverDr", Context) + " <> 0 OR W."
					+ QuoteIdentifier(Resource.Name + "TurnoverCr", Context) + " <> 0");
				Balances.Add("W." + QuoteIdentifier(Resource.Name + "Running", Context) + " <> 0");
			EndDo;
		EndIf;
		If Moves.Count() > 0 Then
			Result.Add("  WHERE (W." + Shown + " >= 2 AND (" + StrConcat(Moves, " OR ") + "))"
				+ ?(Completion = "MOVEMENTS", "",
					" OR (W." + Shown + " = 1 AND (" + StrConcat(Balances, " OR ") + ")"
					+ ?(IsBlankString(EndMoment), "", " AND NOT (W." + PeriodAlias + " = " + EndMoment
						+ " AND W." + EndTaken + " = 1)") + ")"));
			Return StrConcat(Result, Chars.LF);
		EndIf;
	EndIf;
	If Completion = "MOVEMENTS" And Detail.Kind <> "RECORDER" And Detail.Kind <> "RECORD"
		And Detail.Kind <> "AUTO" Then
		// Явный метод «Движения» у бухрегистра с датой начала зависит от итогов базы (nap1 --mov4/5 на
		// УХ, итоги по 28.02.2019, по Счет с одним СуммаОборотДт): конец интервала до периода итогов -
		// строки только с ненулевым выбранным оборотом (2017 - 267 из 409, 2017-2018 - 348 из 543), позже
		// или без начала - любое движение (2017-2020 - 552, 2000-2030 - 743). Без полей оборота
		// платформа выводит каждый период с ненулевым остатком и без проводок (58.01.1, полгода 2017).
		// Оба поведения совпадают, если у каждого спрошенного ресурса выбраны и Дт, и Кт.
		// Без конца интервала итоги не участвуют - это всегда «любое движение» (rev26.py, УХ, один
		// СуммаОборотДт с 2017: без конца 557 строк, с концом в 2030 - те же 557).
		If SelectedTurnovers.Count() = 0 Then
			Raise "BalanceAndTurnovers of an accounting register with the RegisterRecords completion and"
				+ " no turnover field: the platform then returns every period of the interval with a"
				+ " nonzero balance, even without entries, and that enumeration is not translated.";
		EndIf;
		BothSides = True;
		For Each Resource In Plan.Resources Do
			If ResourceUsed(Descriptor.Used, Resource.Name, Plan.Resources)
				And Not (Used(Descriptor, Resource.Name + "TurnoverDr")
					And Used(Descriptor, Resource.Name + "TurnoverCr")) Then
				BothSides = False;
			EndIf;
		EndDo;
		If Not IsBlankString(Start) And Not IsBlankString(Finish) And Not BothSides Then
			Raise "BalanceAndTurnovers of an accounting register with a start date, an end date, the RegisterRecords"
				+ " completion and not both TurnoverDr and TurnoverCr of every resource: while the"
				+ " interval ends within the calculated totals period the platform keeps only rows with a"
				+ " nonzero selected turnover, past it - every row with a movement. The totals period is"
				+ " the state of the infobase, not of the query.";
		EndIf;
	EndIf;
	If BalanceUsed And Completion <> "MOVEMENTS" Then
		Result.Add("  WHERE W." + Shown + " >= 1 AND ("
			+ StrConcat(BalanceChecks, Chars.LF + "    OR ") + ")");
	Else
		Result.Add("  WHERE W." + Shown + " >= 1");
	EndIf;
	Return StrConcat(Result, Chars.LF);

EndFunction

// Регистратор ОстаткиИОбороты бухрегистра по регистратору, записи и Авто - составное значение с тегом
// типа: таблица платформы несёт _Recorder_TYPE, _Recorder_RTRef, _Recorder_RRRef, у строки записи тег
// 0x08 (замеры r1-r3, r5, r6, 21.11.2026, УХ). Таблица движений хранит регистратор без тега, поэтому
// часть типа добавляется константой.
Procedure AddRecorderTypePart(Detail, Context)

	If Detail.Kind <> "RECORDER" And Detail.Kind <> "RECORD" And Detail.Kind <> "AUTO" Then
		Return;
	EndIf;
	Names = Detail.Parts.Get("RECORDER");
	If Names = Undefined Or Names.Find("Recorder_TYPE") <> Undefined Then
		Return;
	EndIf;
	AddDetailColumn(Detail, "Recorder_TYPE", BinaryLiteral("08", Context), "");
	Names.Insert(0, "Recorder_TYPE");

EndProcedure

// Колонка записи в строке результата ОстаткиИОбороты. У строки без записи (начальный остаток до
// интервала, граница периода) платформа отдаёт не NULL, а НЕОПРЕДЕЛЕНО: тег 0x01 с нулевыми
// идентификатором таблицы и ссылкой, номер строки и уточнение периода - 0 (замеры r1-r3, r5, r6:
// ЕСТЬNULL(Регистратор, 1) - Неопределено, Регистратор ЕСТЬ NULL - ложь, Регистратор = НЕОПРЕДЕЛЕНО -
// истина, отбор ГДЕ Регистратор = НЕОПРЕДЕЛЕНО оставляет одну строку границы).
Function BoundaryRecordValue(Detail, Slot, Context)

	Value = "W." + Slot;
	If Detail.Kind <> "RECORDER" And Detail.Kind <> "RECORD" And Detail.Kind <> "AUTO" Then
		Return Value;
	EndIf;
	Empty = "";
	If Slot = QuoteIdentifier("Recorder_TYPE", Context) Then
		Empty = BinaryLiteral("01", Context);
	ElsIf Slot = QuoteIdentifier("Recorder_RTRef", Context) Then
		Empty = BinaryLiteral("00000000", Context);
	ElsIf Slot = QuoteIdentifier("Recorder", Context) Or Slot = QuoteIdentifier("Recorder_RRRef", Context) Then
		Empty = BinaryLiteral("00000000000000000000000000000000", Context);
	ElsIf Slot = QuoteIdentifier("LineNumber", Context) Or Slot = QuoteIdentifier("PeriodAdjustment", Context) Then
		Empty = "0";
	EndIf;
	If IsBlankString(Empty) Then
		Return Value;
	EndIf;
	Return "COALESCE(" + Value + ", " + Empty + ")";

EndFunction

// Поля развёрнутого остатка по знаку остатка строки: Дт - положительный остаток, Кт - отрицательный.
Procedure AddSplittedFields(Select, Descriptor, Name, Saldo, Context)

	If Used(Descriptor, Name + "Dr") Then
		AddAccountingField(Select, Name + "Dr", "CASE WHEN " + Saldo + " > 0 THEN " + Saldo + " ELSE 0 END",
			Context);
	EndIf;
	If Used(Descriptor, Name + "Cr") Then
		AddAccountingField(Select, Name + "Cr", "CASE WHEN " + Saldo + " < 0 THEN -(" + Saldo + ") ELSE 0 END",
			Context);
	EndIf;

EndProcedure

// Суффиксы развёрнутого остатка. У Остатков он один, у ОстаткиИОбороты - начальный
// и конечный; любой из них требует считать на полной детализации.
// Истина - из полей остатка взяты только свёрнутые одной стороны: ни у одного ресурса нет
// обычного или развёрнутого остатка и нет пары Дт и Кт одного момента. Без счёта и аналитики
// платформа отдаёт тогда по пустой стороне не итог, а 0..7 нулевых строк в зависимости от данных
// (УХ, Хозрасчетный.Остатки и ОстаткиИОбороты, счета 41.01, 44.02, 60.01, 62.01, 15.11.2026);
// с парой сторон, обычным или развёрнутым остатком и с любым измерением - одна строка итога.
Function OneSidedBalanceOnly(Descriptor, Plan)

	OneSided = False;
	For Each Resource In Plan.Resources Do
		For Each Moment In StrSplit(",Opening,Closing", ",") Do
			Name = Resource.Name + Moment + "Balance";
			Debit = Used(Descriptor, Name + "Dr");
			Credit = Used(Descriptor, Name + "Cr");
			If Used(Descriptor, Name) Or (Debit And Credit) Then
				Return False;
			EndIf;
			OneSided = OneSided Or Debit Or Credit;
		EndDo;
		For Each Suffix In SplittedBalanceSuffixes() Do
			If Used(Descriptor, Resource.Name + Suffix) Then
				Return False;
			EndIf;
		EndDo;
		// Оборот того же ресурса рядом - тоже одна строка итога, и при пустой стороне
		// (ОстаткиИОбороты, счета 41.01, 44.02, 60.01, 62.01: 16 наборов совпали с переводом).
		For Each Suffix In TurnoverSuffixes() Do
			If Used(Descriptor, Resource.Name + Suffix) Then
				Return False;
			EndIf;
		EndDo;
	EndDo;
	Return OneSided;

EndFunction

Function SplittedBalanceSuffixes()

	Suffixes = New Array;
	Suffixes.Add("SplittedBalanceDr");
	Suffixes.Add("SplittedBalanceCr");
	Suffixes.Add("OpeningSplittedBalanceDr");
	Suffixes.Add("OpeningSplittedBalanceCr");
	Suffixes.Add("ClosingSplittedBalanceDr");
	Suffixes.Add("ClosingSplittedBalanceCr");
	Return Suffixes;

EndFunction

Function TurnoverSuffixes()

	Suffixes = New Array;
	Suffixes.Add("Turnover");
	Suffixes.Add("TurnoverDr");
	Suffixes.Add("TurnoverCr");
	Return Suffixes;

EndFunction

// Свёртка остатка на запрошенный уровень. Свёрнутый остаток раскладывается по виду счёта,
// развёрнутый - по знаку остатка строки.
Procedure AddFoldedBalance(Select, ResourceName, Suffix, SplitSuffix, Kind, Context)

	Balance = "SUM(G." + QuoteIdentifier(ResourceName + Suffix, Context) + ")";
	Positive = "CASE WHEN " + Kind + " = 0 OR " + Kind + " = 2 AND " + Balance
		+ " > 0 THEN " + Balance + " ELSE 0 END";
	Negative = "CASE WHEN " + Kind + " = 1 OR " + Kind + " = 2 AND " + Balance
		+ " < 0 THEN -(" + Balance + ") ELSE 0 END";

	AddAccountingField(Select, ResourceName + Suffix, Balance, Context);
	AddAccountingField(Select, ResourceName + Suffix + "Dr", Positive, Context);
	AddAccountingField(Select, ResourceName + Suffix + "Cr", Negative, Context);
	// Развёрнутый остаток раскладывается по знаку остатка строки аналитики, а не по виду счёта:
	// у пассивного 90.01.1 с дебетовым сальдо платформа даёт развёрнутый Дт 30 945 222,83, у
	// активного 19.05 с кредитовым - развёрнутый Кт (nap1 --exp, УХ).
	Detailed = "G." + QuoteIdentifier(ResourceName + Suffix, Context);
	AddAccountingField(Select, ResourceName + SplitSuffix + "Dr",
		"SUM(CASE WHEN " + Detailed + " > 0 THEN " + Detailed + " ELSE 0 END)", Context);
	AddAccountingField(Select, ResourceName + SplitSuffix + "Cr",
		"SUM(CASE WHEN " + Detailed + " < 0 THEN -" + Detailed + " ELSE 0 END)", Context);

EndProcedure

Function AccountingExpandedFold(Plan, Inner, Requested, Context)

	Select = New Array;
	Group = New Array;
	For Each Name In Requested Do
		Select.Add("    G." + QuoteIdentifier(Name, Context) + " AS " + QuoteIdentifier(Name, Context));
		Group.Add("G." + QuoteIdentifier(Name, Context));
	EndDo;

	Kind = AccountKindExpression(
		"MIN(G." + QuoteIdentifier("AccountKind", Context) + ")",
		"MAX(G." + QuoteIdentifier("AccountKind", Context) + ")");

	For Each Resource In Plan.Resources Do
		If Plan.Kind = "BALANCEANDTURNOVERS" Then
			AddFoldedBalance(Select, Resource.Name, "OpeningBalance", "OpeningSplittedBalance",
				Kind, Context);
			For Each Suffix In TurnoverSuffixes() Do
				AddAccountingField(Select, Resource.Name + Suffix,
					"SUM(G." + QuoteIdentifier(Resource.Name + Suffix, Context) + ")", Context);
			EndDo;
			AddFoldedBalance(Select, Resource.Name, "ClosingBalance", "ClosingSplittedBalance",
				Kind, Context);
			Continue;
		EndIf;
		AddFoldedBalance(Select, Resource.Name, "Balance", "SplittedBalance", Kind, Context);
	EndDo;

	Lines = New Array;
	Lines.Add("  SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("  FROM (");
	Lines.Add(Inner);
	Lines.Add("  ) AS G");
	If Group.Count() > 0 Then
		Lines.Add("  GROUP BY " + StrConcat(Group, ", "));
	EndIf;
	Return StrConcat(Lines, Chars.LF);

EndFunction

Function AccountingAggregate(Plan, Feed, Grouping, Start, Finish, Detail, Context, Descriptor = Undefined,
	KindOverride = "")

	Select = New Array;
	Group = New Array;
	Having = New Array;
	// Отсев нулевых строк - по тем ресурсам, о которых спросил запрос: месяц, где двигалось
	// только количество, в оборотах суммы не показывается (сверка battery28: 1С 7 строк,
	// SQL 38). Если ресурса не спросили ни одного, отсев по всем - как было.
	Asked = New Map;
	If Descriptor <> Undefined Then
		For Each Resource In Plan.Resources Do
			If ResourceUsed(Descriptor.Used, Resource.Name, Plan.Resources) Then
				Asked.Insert(Resource.Name, True);
			EndIf;
		EndDo;
	EndIf;

	// Субконто «только обороты» - как в AccountingByPeriod: остаток по NULL на его месте, обороты
	// по значению (nap1: без периода 1С 687 строк, SQL 682, остаток стоял на строках значений).
	Split = Undefined;
	If Descriptor <> Undefined Then
		For Each Resource In Plan.Resources Do
			For Each Suffix In StrSplit("OpeningBalance,OpeningBalanceDr,OpeningBalanceCr,"
				+ "ClosingBalance,ClosingBalanceDr,ClosingBalanceCr,OpeningSplittedBalanceDr,"
				+ "OpeningSplittedBalanceCr,ClosingSplittedBalanceDr,ClosingSplittedBalanceCr", ",") Do
				If Split = Undefined And Used(Descriptor, Resource.Name + Suffix) Then
					Split = TurnoverOnlySplit(Plan, Grouping, Context);
				EndIf;
			EndDo;
		EndDo;
	EndIf;
	PartColumn = "X." + QuoteIdentifier("Part", Context);
	TurnoverPart = ?(Split = Undefined, "", " AND " + PartColumn + " = 0");
	If Plan.Property("NullBalance") And Plan.NullBalance = True Then
		// Ветка остатка по NULL (NullBalanceBranch) оборотов не даёт.
		TurnoverPart = TurnoverPart + " AND F." + QuoteIdentifier("NullBalance", Context) + " = 0";
	EndIf;

	For Each Name In Grouping Do
		Expression = "F." + QuoteIdentifier(Name, Context);
		If Split <> Undefined And Split.Slots.Get(Name) <> Undefined Then
			Expression = "CASE WHEN " + PartColumn + " = 1 AND " + Split.Slots.Get(Name)
				+ " THEN NULL ELSE " + Expression + " END";
		EndIf;
		Select.Add("    " + Expression + " AS " + QuoteIdentifier(Name, Context));
		Group.Add(Expression);
	EndDo;
	For Each Column In Detail.Columns Do
		Expression = ?(DerivedFromPeriod(Column.Expression, Plan.Base, Context),
			FeedPeriodExpression(Column.Expression, Plan, Context),
			"F." + QuoteIdentifier(Column.Alias, Context));
		If Detail.Kind = "UNIT" And Column.Alias = "Period" And Not IsBlankString(Start) Then
			// Первый период при начале внутри него платформа показывает датой начала - как у
			// ОстаткиИОбороты в AccountingByPeriod (сверка 13.11.2026, УХ: Хозрасчетный.Обороты
			// с 15.03.2017 по месяцу, счёт 26 - Период 15.03, а не 01.03; с 15.02 по кварталу -
			// 15.02, а не 01.01). Записи раньше начала лента не несёт, сдвигается только первый.
			Expression = "CASE WHEN " + Expression + " < " + Start + " THEN " + Start
				+ " ELSE " + Expression + " END";
		EndIf;
		Select.Add("    " + Expression + " AS " + QuoteIdentifier(Column.Alias, Context));
		Group.Add(Expression);
	EndDo;

	Chart = Undefined;
	KindColumn = "NULL";
	GivenKind = KindOverride;
	If Plan.Kind <> "TURNOVERS" Then
		Chart = ChartOfAccountsInfo(Plan.Register, Context);
		KindColumn = AccountKindExpression("MIN(K." + Chart.Kind + ")", "MAX(K." + Chart.Kind + ")");
		If IsBlankString(GivenKind) And Grouping.Find("Account") = Undefined Then
			// Счёт не выбран: вид один на весь запрос, как его заранее читает платформа.
			GivenKind = UnselectedAccountKind(Plan, Context);
		EndIf;
		If Not IsBlankString(GivenKind) Then
			// Вид счёта задан одним значением на весь набор (OneSidedBalanceUnion, UnselectedAccountKind).
			KindColumn = "MIN(KO." + QuoteIdentifier("Kind", Context) + ")";
		EndIf;
	EndIf;

	Side = "F." + QuoteIdentifier("Side", Context);
	Period = "F." + QuoteIdentifier("Period", Context);

	For Each Resource In Plan.Resources Do
		Value = "F." + QuoteIdentifier(Resource.Name, Context);
		If Not Resource.IsBalance Then
			// Небалансовый ресурс (Количество) по стороне без такого учёта хранится пустым, и SUM
			// одних NULL - NULL, а платформа отдаёт 0: CASE WHEN CAST(SUM(...)) IS NULL THEN 0.0
			// (замер 16.11.2026, УХ Хозрасчетный, КоличествоОборотДт и КоличествоОстатокДт).
			Value = "COALESCE(" + Value + ", 0)";
		EndIf;

		If Plan.Kind = "TURNOVERS" Then
			Debit = "SUM(CASE WHEN " + Side + " = 0 THEN " + Value + " ELSE 0 END)";
			Credit = "SUM(CASE WHEN " + Side + " = 1 THEN " + Value + " ELSE 0 END)";
			AddAccountingField(Select, Resource.Name + "Turnover", Debit + " - " + Credit, Context);
			AddAccountingField(Select, Resource.Name + "TurnoverDr", Debit, Context);
			AddAccountingField(Select, Resource.Name + "TurnoverCr", Credit, Context);
			If Not Resource.IsBalance And HasCorrespondence(Plan.Register) Then
				// Односторонняя проводка корреспондирующего значения не имеет: в хранении
				// там пусто, а платформа показывает ноль.
				Balanced = "COALESCE(F." + QuoteIdentifier("Balanced" + Resource.Name, Context) + ", 0)";
				BalancedDebit = "SUM(CASE WHEN " + Side + " = 0 THEN " + Balanced + " ELSE 0 END)";
				BalancedCredit = "SUM(CASE WHEN " + Side + " = 1 THEN " + Balanced + " ELSE 0 END)";
				AddAccountingField(Select, Resource.Name + "BalancedTurnover",
					BalancedDebit + " - " + BalancedCredit, Context);
				AddAccountingField(Select, Resource.Name + "BalancedTurnoverDr", BalancedDebit, Context);
				AddAccountingField(Select, Resource.Name + "BalancedTurnoverCr", BalancedCredit, Context);
			EndIf;
			If Asked.Count() = 0 Or Asked.Get(Resource.Name) <> Undefined Then
				// Отсев - по выбранному полю: у СуммаОборот это Дт - Кт, и месяц, где обороты
				// по сторонам равны, платформа не показывает (сверка battery28: 1С 7, SQL 38).
				Checks = New Array;
				If Descriptor <> Undefined Then
					If Used(Descriptor, Resource.Name + "Turnover") Then
						Checks.Add(Debit + " - " + Credit + " <> 0");
					EndIf;
					If Used(Descriptor, Resource.Name + "TurnoverDr") Then
						Checks.Add(Debit + " <> 0");
					EndIf;
					If Used(Descriptor, Resource.Name + "TurnoverCr") Then
						Checks.Add(Credit + " <> 0");
					EndIf;
				EndIf;
				If Checks.Count() = 0 Then
					Checks.Add(Debit + " <> 0 OR " + Credit + " <> 0");
				EndIf;
				Having.Add(StrConcat(Checks, " OR "));
			EndIf;
			Continue;
		EndIf;

		If Plan.Kind = "BALANCE" Then
			Saldo = SignedSum(Side, Value, "");
			AddBalanceFields(Select, Resource.Name, "Balance", Saldo, KindColumn, Context);
			If Asked.Count() = 0 Or Asked.Get(Resource.Name) <> Undefined Then
				Having.Add(Saldo + " <> 0");
			EndIf;
			Continue;
		EndIf;

		Inside = ?(IsBlankString(Start), "", Period + " >= " + Start);
		BalanceValue = ?(Split = Undefined, Value,
			"(CASE WHEN " + PartColumn + " = 1 OR NOT " + Split.Untracked + " THEN " + Value + " ELSE 0 END)");
		BalanceValue = GuardedBalance(Plan, BalanceValue, Context);
		// Без даты начала начальный остаток - это остаток до начала времён, то есть ноль.
		Opening = ?(IsBlankString(Start), "0",
			SignedSum(Side, BalanceValue, Period + " < " + Start));
		Closing = SignedSum(Side, BalanceValue, "");
		Debit = "SUM(CASE WHEN " + Side + " = 0" + TurnoverPart
			+ ?(IsBlankString(Inside), "", " AND " + Inside) + " THEN " + Value + " ELSE 0 END)";
		Credit = "SUM(CASE WHEN " + Side + " = 1" + TurnoverPart
			+ ?(IsBlankString(Inside), "", " AND " + Inside) + " THEN " + Value + " ELSE 0 END)";

		AddBalanceFields(Select, Resource.Name, "OpeningBalance", Opening, KindColumn, Context);
		AddAccountingField(Select, Resource.Name + "Turnover", Debit + " - " + Credit, Context);
		AddAccountingField(Select, Resource.Name + "TurnoverDr", Debit, Context);
		AddAccountingField(Select, Resource.Name + "TurnoverCr", Credit, Context);
		AddBalanceFields(Select, Resource.Name, "ClosingBalance", Closing, KindColumn, Context);
		If Asked.Count() = 0 Or Asked.Get(Resource.Name) <> Undefined Then
			Having.Add(Opening + " <> 0 OR " + Debit + " <> 0 OR " + Credit + " <> 0 OR "
				+ Closing + " <> 0");
		EndIf;
	EndDo;

	If Chart <> Undefined Then
		Select.Add("    " + KindColumn + " AS " + QuoteIdentifier("AccountKind", Context));
	EndIf;

	Lines = New Array;
	Lines.Add("  SELECT");
	Lines.Add(StrConcat(Select, "," + Chars.LF));
	Lines.Add("  FROM (");
	Lines.Add(Feed);
	Lines.Add("  ) AS F");
	If Chart <> Undefined Then
		Lines.Add("  INNER JOIN " + Chart.Table + " AS K ON K." + Chart.Key
			+ " = F." + QuoteIdentifier("Account", Context));
	EndIf;
	If Chart <> Undefined And Not IsBlankString(GivenKind) Then
		Lines.Add("  CROSS JOIN (SELECT " + GivenKind + " AS " + QuoteIdentifier("Kind", Context) + ") AS KO");
	EndIf;
	If Split <> Undefined Then
		Lines.Add("  CROSS JOIN (SELECT 0 AS " + QuoteIdentifier("Part", Context)
			+ " UNION ALL SELECT 1) AS X");
		For Each Join In Split.Joins Do
			Lines.Add("  " + Join);
		EndDo;
		Lines.Add("  WHERE " + PartColumn + " = 0 OR " + Split.Untracked);
	EndIf;
	If Group.Count() > 0 Then
		Lines.Add("  GROUP BY " + StrConcat(Group, ", "));
		If Having.Count() > 0 Then
			Lines.Add("  HAVING " + StrConcat(Having, Chars.LF + "     OR "));
		EndIf;
	EndIf;
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Сторона свёрнутого остатка, если из полей остатка выбраны только поля одной стороны
// (OneSidedBalanceOnly) и сторона у всех одна: "Dr" или "Cr"; иначе пустая строка. Дт одного ресурса
// рядом с Кт другого (или начальный Дт рядом с конечным Кт) - у любого вида счёта одно из полей
// остаётся суммой, агрегат в запросе платформы есть, и строка итога одна.
Function OneSidedBalanceSide(Descriptor, Plan)

	If Not OneSidedBalanceOnly(Descriptor, Plan) Then
		Return "";
	EndIf;
	Debit = False;
	Credit = False;
	For Each Resource In Plan.Resources Do
		For Each Moment In StrSplit(",Opening,Closing", ",") Do
			Name = Resource.Name + Moment + "Balance";
			Debit = Debit Or Used(Descriptor, Name + "Dr");
			Credit = Credit Or Used(Descriptor, Name + "Cr");
		EndDo;
	EndDo;
	If Debit = Credit Then
		Return "";
	EndIf;
	Return ?(Debit, "Dr", "Cr");

EndFunction

// Упоминает ли текст параметра виртуальной таблицы субконто.
Function ExtDimensionMentioned(Text)

	If IsBlankString(Text) Then
		Return False;
	EndIf;
	For Each Token In Tokenize(Text) Do
		If Token.Kind <> "Name" Then
			Continue;
		EndIf;
		Head = Upper(TrimAll(StrSplit(Token.Value, ".")[0]));
		If StrStartsWith(Head, Upper("Субконто")) Or StrStartsWith(Head, "EXTDIMENSION") Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Формы свёрнутого остатка одной стороны с условием счёта, которые не переведены: отказ называет,
// что именно читает платформа. Переведены Остатки регистра с корреспонденцией без субконто в
// параметрах (OneSidedBalanceUnion).
Procedure CheckOneSidedBalance(Plan, Context)

	Arguments = Plan.Arguments;
	Roles = AccountingArguments(Plan.Kind);
	Lead = StrTemplate(
		"Virtual table %1 is asked only for one side (Dr or Cr) of a collapsed balance and for no"
		+ " account, dimension or ext dimension, and it is given an account condition. When every account"
		+ " of that condition is of the kind for which this side is always zero (Dr of a passive account,"
		+ " Cr of an active one), the platform puts a constant in place of the sum and returns one row of"
		+ " zeros per row it reads - the rows of the stored totals and the entries between the balance date"
		+ " and the totals period - instead of a single total.", Plan.BaseName);
	Advice = " Select the account or a dimension, or take both sides or the plain balance of the resource.";

	If Plan.Kind <> "BALANCE" And ExtDimensionMentioned(RoleArgument(Arguments, Roles.Condition)) Then
		// ОстаткиИОбороты без субконто в условии переведены (OneSidedTurnoverRows). С субконто в
		// условии платформа читает итоги с субконто по числу видов счёта (замер q35: 55 строк против
		// 28 без условия) - эта раскладка для ОстаткиИОбороты не снята.
		Raise Lead + " For BalanceAndTurnovers with an ext dimension in the condition the platform reads"
			+ " the totals kept by ext dimensions, and that reading is measured for the Balance table only."
			+ Advice;
	EndIf;
	If Not HasCorrespondence(Plan.Register) Then
		Raise Lead + " The rows read by the platform are measured for a register with correspondence only;"
			+ " this register keeps none, and its form is not translated." + Advice;
	EndIf;
	If Not IsBlankString(RoleArgument(Arguments, Roles.ExtDimensionTypes))
		Or ExtDimensionMentioned(RoleArgument(Arguments, Roles.AccountCondition)) Then
		// Замер d_types: со списком видов субконто платформа читает итоги с субконто через временную
		// таблицу счетов с номерами строк заказанных видов (_LineNo1 …) - эта раскладка не построена.
		// Субконто в условии (без списка видов) переведено - OneSidedBalanceRows.
		Raise Lead + " With a list of ext dimension types the platform reads the totals kept by ext"
			+ " dimensions through a temporary table of accounts with the line numbers of the listed"
			+ " types, and that reading is not translated." + Advice;
	EndIf;
	Present = True;
	Try
		Present = AccountingRegisters[Plan.Register.Name].GetPresentTotalsUsing();
	Except
		Present = True;
	EndTry;
	If Not Present Then
		Raise Lead + " In this infobase the present totals of the register are switched off, the platform"
			+ " then reads other totals rows, and that case is not measured." + Advice;
	EndIf;

EndProcedure

// Таблица итогов по счетам ("AT0") или настроек итогов ("OPT") регистра из структуры хранения.
Function AccountingTotalsTable(Plan, Role)

	Storage = StorageStructure();
	Found = Storage.Get(AccountingTotalsKey(Plan.Register.FullName(), Role));
	If Found = Undefined Then
		Found = Storage.Get(AccountingTotalsKey(Plan.BaseName, Role));
	EndIf;
	If Found = Undefined Or Not Found.Property("Physicals") Then
		Raise StrTemplate(
			"Virtual table %1 is asked only for one side (Dr or Cr) of a collapsed balance and for no"
			+ " account, dimension or ext dimension, and it is given an account condition. The platform"
			+ " then returns one row of zeros per row of the stored totals it reads, and the %2 table of the"
			+ " register is not found in the storage structure of this infobase. Select the account or a"
			+ " dimension, or take both sides or the plain balance of the resource.", Plan.BaseName,
			?(Role = "OPT", "totals settings", "totals by accounts"));
	EndIf;
	Return Found;

EndFunction

// Колонка таблицы итогов по имени колонки хранения; пустая строка - такой нет.
Function TotalsPhysical(Totals, Name)

	For Each Physical In Totals.Physicals Do
		If Upper(Physical) = Upper(Name) Then
			Return Physical;
		EndIf;
	EndDo;
	Return "";

EndFunction

// Колонка ресурса в таблице итогов по счетам. Балансовый ресурс хранится в итогах под тем же именем
// колонки, что в движениях, небалансовый - без суффикса стороны (_Fld1601Dt -> _Fld1601).
Function TotalsResourceColumn(Totals, Base, Resource)

	Stored = Totals.Fields.Get(Upper(Resource.Name));
	If Stored <> Undefined Then
		Return Stored;
	EndIf;
	Own = Base.Fields.Get(Upper(SideFieldName(Resource.Name, "Dr", Resource.IsBalance, Base)));
	If Own = Undefined Then
		Return "";
	EndIf;
	Candidate = Own;
	If Not Resource.IsBalance And StrEndsWith(Upper(Candidate), "DT") Then
		Candidate = Left(Candidate, StrLen(Candidate) - 2);
	EndIf;
	Return TotalsPhysical(Totals, Candidate);

EndFunction

// Колонка сальдового оборота ресурса в таблице итогов: стоит следом за ресурсом и его оборотами
// по дебету и кредиту (_Fld1599, _TurnoverDt1610, _TurnoverCt1611, _Turnover1612).
Function TotalsTurnoverColumn(Totals, Stored)

	Position = -1;
	For Index = 0 To Totals.Physicals.Count() - 1 Do
		If Upper(Totals.Physicals[Index]) = Upper(Stored) Then
			Position = Index;
			Break;
		EndIf;
	EndDo;
	If Position < 0 Then
		Return "";
	EndIf;
	For Index = Position + 1 To Min(Position + 3, Totals.Physicals.Count() - 1) Do
		Candidate = Upper(Totals.Physicals[Index]);
		If StrStartsWith(Candidate, "_TURNOVER") And Not StrStartsWith(Candidate, "_TURNOVERDT")
			And Not StrStartsWith(Candidate, "_TURNOVERCT") Then
			Return Totals.Physicals[Index];
		EndIf;
	EndDo;
	Return "";

EndFunction

// Описатель для условий виртуальной таблицы, прочитанных по таблице итогов по счетам: измерения
// регистра и счёт. Счёт зовётся именем стороны Дт таблицы движений - по нему метаданные знают тип, -
// а колонка берётся из итогов. Остальные поля регистра в итогах не хранятся: условие по ним не
// разрешится.
Function TotalsConditionBase(Plan, Base, Totals, Context, Count = 0)

	Fields = New Map;
	Columns = New Map;
	Computed = New Map;
	// Субконто: у таблицы итогов с Count субконто первые Count - её колонки _Value<N>_…, остальных у
	// счёта нет, и платформа ставит на их место NULL (замер x7: CAST(NULL AS BINARY(1)) <> 0x01).
	Widths = New Structure("_TYPE, _RTRef, _RRRef", "1", "4", "16");
	For Number = 1 To Plan.Slots Do
		Digits = Format(Number, "NG=0; NZ=0");
		Name = "ExtDimension" + Digits;
		Parts = New Array;
		For Each Width In Widths Do
			Part = Name + Width.Key;
			Stored = ?(Number <= Count, TotalsPhysical(Totals, "_Value" + Digits + Width.Key), "");
			Value = ?(IsBlankString(Stored),
				?(Context.Options.Dialect = "PostgreSQL", "CAST(NULL AS BYTEA)",
					"CAST(NULL AS BINARY(" + Width.Value + "))"),
				VirtualColumn(Stored, Context));
			Computed.Insert(Upper(Part), Value);
			If Width.Key = "_RRRef" Then
				Computed.Insert(Upper(Name), Value);
			EndIf;
			Parts.Add(Part);
		EndDo;
		Fields.Insert(Upper(Name), Name);
		Fields.Insert(Upper("Субконто" + Digits), Name);
		Columns.Insert(Upper(Name), Parts);
		Columns.Insert(Upper("Субконто" + Digits), Parts);
	EndDo;
	For Each Dimension In Plan.Dimensions Do
		ItemKey = Upper(Dimension.Name);
		Stored = Totals.Fields.Get(ItemKey);
		ColumnList = Totals.Columns.Get(ItemKey);
		If Stored = Undefined Or ColumnList = Undefined Then
			// Балансовое измерение лежит в итогах под теми же колонками, что в движениях.
			Stored = Base.Fields.Get(ItemKey);
			ColumnList = Base.Columns.Get(ItemKey);
			If Stored = Undefined Or ColumnList = Undefined Then
				Continue;
			EndIf;
			Kept = True;
			For Each Column In ColumnList Do
				If IsBlankString(TotalsPhysical(Totals, Column)) Then
					Kept = False;
				EndIf;
			EndDo;
			If Not Kept Then
				Continue;
			EndIf;
		EndIf;
		Fields.Insert(ItemKey, Stored);
		Columns.Insert(ItemKey, ColumnList);
	EndDo;

	AccountName = AccountFieldName(Base, "Dr");
	AccountStored = Totals.Fields.Get(Upper(AccountFieldName(Totals, "")));
	If AccountStored = Undefined Then
		AccountStored = TotalsPhysical(Totals, "_AccountRRef");
	EndIf;
	If IsBlankString(AccountStored) Then
		Raise StrTemplate("The table of totals by accounts of %1 has an unexpected structure: no account"
			+ " column.", Plan.BaseName);
	EndIf;
	// Имя поля - стороны Дт, колонка - счёта в итогах: и условие, и переход через точку (Счет.Код)
	// читают её как обычную колонку таблицы.
	AccountColumns = New Array;
	AccountColumns.Add(AccountStored);
	Fields.Insert(Upper(AccountName), AccountStored);
	Columns.Insert(Upper(AccountName), AccountColumns);

	Copy = New Structure;
	For Each Item In Base Do
		Copy.Insert(Item.Key, Item.Value);
	EndDo;
	Copy.Insert("PhysicalName", Totals.PhysicalName);
	Copy.Insert("Fields", Fields);
	Copy.Insert("Columns", Columns);
	Copy.Insert("Computed", Computed);
	Return Copy;

EndFunction

// Вид счетов условия счёта - так, как его заранее читает платформа:
// SELECT MAX(T1._Kind), MIN(T1._Kind) FROM <план счетов> T1 WHERE T1._IDRRef IN (<условие счёта>)
// (замеры b60dt, bmix, d_hier, d_dot, d_par, 21.11.2026, УХ). Один вид - он сам; разные виды или
// ни одного счёта - 2 (замеры bmix, d_none). Вид берётся по плану счетов, а не по данным регистра.
Function AccountKindByCondition(Plan, Condition, Context)

	Chart = ChartOfAccountsInfo(Plan.Register, Context);
	Target = TableDescriptor(Plan.Register.ChartOfAccounts.FullName());
	Names = New Array;
	Names.Add("Ref");
	Names.Add("Ссылка");
	Reference = FirstExistingField(Target, Names);
	If IsBlankString(Reference) Then
		Raise StrTemplate("The chart of accounts of %1 keeps no reference field.", Plan.BaseName);
	EndIf;
	Joins = New Array;
	Where = ConditionSql(ReplaceIdentifier(Condition, AccountConditionNames(""), Reference),
		Target, Context, Joins, "KC");
	Parts = New Array;
	Parts.Add("COALESCE((SELECT CASE WHEN MIN(KC." + Chart.Kind + ") = MAX(KC." + Chart.Kind
		+ ") THEN MAX(KC." + Chart.Kind + ") ELSE 2 END FROM " + Chart.Table + " AS KC");
	For Each Navigation In Joins Do
		Parts.Add(" LEFT JOIN " + Navigation.Table + " AS " + Navigation.Alias
			+ " ON " + JoinCondition(Navigation));
	EndDo;
	Parts.Add(" WHERE " + Where + "), 2)");
	Return StrConcat(Parts, "");

EndFunction

// Вид счёта строки, в которой счёт не выбран. Платформа берёт его не по счетам с данными, а заранее -
// по плану счетов и условию счёта, одной константой на весь запрос (@P AS AccKind_): замеры k2, k5,
// k8a, k9a, v1-v3, 21.11.2026, УХ - Остатки и ОстаткиИОбороты без счёта в выборке, с измерением, с
// субконто, с периодичностью. Без условия счёта вид всегда 2 (bnoacc, v1); список видов субконто
// на вид не влияет (v2, v3: предзапрос идёт по одному условию счёта). Условие самой виртуальной
// таблицы счёт назвать не может - «Field not found "Счет.Код"» (k1). Прежний перевод брал вид по
// счетам с данными в строке: у 51 (активный) и 86 (пассивный) с данными только на 51 кредитовое
// сальдо 188 500 выходило отрицательным дебетом, а платформа отдаёт его в ОстатокКт (сверка ak04).
Function UnselectedAccountKind(Plan, Context)

	Roles = AccountingArguments(Plan.Kind);
	Condition = RoleArgument(Plan.Arguments, Roles.AccountCondition);
	If IsBlankString(Condition) Then
		Return "2";
	EndIf;
	Return AccountKindByCondition(Plan, Condition, Context);

EndFunction

// Свёрнутый остаток одной стороны без счёта и аналитики (Остатки с условием счёта). Замеры ac
// (21.11.2026, УХ, Хозрасчетный, кэш планов со значениями параметров): вид счетов условия платформа
// подставляет константой (AccountKindByCondition). У стороны, которой у этого вида не бывает (Дт
// пассивного, Кт активного), на месте суммы стоит константа 0 (@P1 AS Fld1599BalanceDt_). Если так
// со всеми выбранными полями, агрегата в запросе нет, и строк столько, сколько строк читает запрос
// (OneSidedBalanceRows): 60.01 СуммаОстатокДт - 7 и 36 строк, 44.02 СуммаОстатокКт - 2,
// КоличествоОстатокКт - 0. При другом виде (и при виде 2) - одна строка итога; вид для неё тот же,
// что читает платформа, а не вид счетов с данными.
Function OneSidedBalanceUnion(Descriptor, Plan, Base, Side, Feed, Grouping, Start, Finish, Detail, Context)

	Roles = AccountingArguments(Plan.Kind);
	Kind = AccountKindByCondition(Plan, RoleArgument(Plan.Arguments, Roles.AccountCondition), Context);
	// Вид, при котором выбранной стороны не бывает: Дт - у пассивного (1), Кт - у активного (0).
	Constant = ?(Side = "Dr", "1", "0");

	Inner = AccountingAggregate(Plan, Feed, Grouping, Start, Finish, Detail, Context, Descriptor, Kind);
	If Plan.Kind = "BALANCE" Then
		Rows = OneSidedBalanceRows(Descriptor, Plan, Base, Finish, Context);
		Suffixes = "Balance,BalanceDr,BalanceCr";
	Else
		Rows = OneSidedTurnoverRows(Descriptor, Plan, Base, Start, Finish, Context);
		Suffixes = "OpeningBalance,OpeningBalanceDr,OpeningBalanceCr,Turnover,TurnoverDr,TurnoverCr,"
			+ "ClosingBalance,ClosingBalanceDr,ClosingBalanceCr";
	EndIf;

	Totals = New Array;
	Zeros = New Array;
	For Each Resource In Plan.Resources Do
		For Each Suffix In StrSplit(Suffixes, ",") Do
			Quoted = QuoteIdentifier(Resource.Name + Suffix, Context);
			Totals.Add("G." + Quoted + " AS " + Quoted);
			Zeros.Add("0 AS " + Quoted);
		EndDo;
	EndDo;

	Lines = New Array;
	Lines.Add("  SELECT");
	Lines.Add("    " + StrConcat(Totals, ", "));
	Lines.Add("  FROM (");
	Lines.Add(Inner);
	Lines.Add("  ) AS G");
	Lines.Add("  WHERE " + Kind + " <> " + Constant);
	Lines.Add("  UNION ALL");
	Lines.Add("  SELECT");
	Lines.Add("    " + StrConcat(Zeros, ", "));
	Lines.Add("  FROM (");
	Lines.Add(Rows);
	Lines.Add("  ) AS R");
	Lines.Add("  WHERE " + Kind + " = " + Constant);
	Return StrConcat(Lines, Chars.LF);

EndFunction

// Строки, которые читает запрос платформы за свёрнутым остатком на дату (замеры b60dt..c2030,
// 21.11.2026, УХ): строки таблицы итогов по счетам на период итогов с ненулевым выбранным ресурсом и
// проводки по дебету и по кредиту от даты остатка до периода итогов. Период итогов и отрезок проводок:
//   даты нет                        - текущие итоги (01.11.3999), проводок нет;
//   дата позже конца рассчитанных   - текущие итоги, проводки от даты и позже;
//   дата не позже                   - итоги на начало месяца, не меньшее даты, проводки от даты до
//                                     него; у месяца за последним рассчитанным записи итогов нет -
//                                     берётся последний рассчитанный месяц с ненулевым ресурсом или
//                                     оборотом (T3._Fld1599 <> 0 OR T3._Turnover1612 <> 0).
// Последний рассчитанный месяц читается из таблицы настроек итогов (_AccRgOpt…, колонка _Period).
Function OneSidedBalanceRows(Descriptor, Plan, Base, Finish, Context)

	Arguments = Plan.Arguments;
	Roles = AccountingArguments(Plan.Kind);
	// С субконто в условии платформа читает итоги по числу видов субконто счёта: у счёта с N видами -
	// таблицу _AccRgAT<N> (замеры u_sub, x1-x8, 21.11.2026, УХ: временная таблица счетов
	// «счёт, число видов» и INNER JOIN … AND _Cnt = N у каждой таблицы от 0 до 3). Без субконто в
	// условии - одна таблица без субконто, без деления по счетам. Колонки ресурсов и периода зовутся
	// одинаково во всех таблицах итогов регистра.
	ByExtDimensions = ExtDimensionMentioned(RoleArgument(Arguments, Roles.Condition));
	Totals = AccountingTotalsTable(Plan, "AT0");
	Options = AccountingTotalsTable(Plan, "OPT");
	TotalsPeriod = TotalsPhysical(Totals, "_Period");
	OptionsPeriod = TotalsPhysical(Options, "_Period");
	If IsBlankString(TotalsPeriod) Or IsBlankString(OptionsPeriod) Then
		Raise StrTemplate("The tables of totals of %1 have an unexpected structure: no period column.",
			Plan.BaseName);
	EndIf;

	NonZero = New Array;
	Moved = New Array;
	For Each Resource In Plan.Resources Do
		If Not Used(Descriptor, Resource.Name + "BalanceDr")
			And Not Used(Descriptor, Resource.Name + "BalanceCr") Then
			Continue;
		EndIf;
		Stored = TotalsResourceColumn(Totals, Base, Resource);
		Turnover = ?(IsBlankString(Stored), "", TotalsTurnoverColumn(Totals, Stored));
		If IsBlankString(Stored) Or IsBlankString(Turnover) Then
			Raise StrTemplate("The table of totals by accounts of %1 has an unexpected structure: resource"
				+ " %2 or its turnover is not found.", Plan.BaseName, Resource.Name);
		EndIf;
		NonZero.Add(VirtualColumn(Stored, Context) + " <> 0");
		Moved.Add(VirtualColumn(Stored, Context) + " <> 0");
		Moved.Add(VirtualColumn(Turnover, Context) + " <> 0");
	EndDo;

	PresentArguments = New Array;
	PresentArguments.Add("3999");
	PresentArguments.Add("11");
	PresentArguments.Add("1");
	Present = DateLiteralFromArguments(PresentArguments, Context);

	Bounded = Not IsBlankString(Finish);
	Period = VirtualColumn(TotalsPeriod, Context);
	Settings = "";
	Range = "";
	If Bounded Then
		Calculated = "TP." + QuoteIdentifier("Calculated", Context);
		Edge = ShiftedDate(Calculated, "1", "month", Context);
		Month = TruncateToUnit("month", Finish, Context);
		Ceiling = "CASE WHEN " + Month + " = " + Finish + " THEN " + Month
			+ " ELSE " + ShiftedDate(Month, "1", "month", Context) + " END";
		Pick = "(" + Finish + " > " + Edge + " AND " + Period + " = " + Present
			+ " AND (" + StrConcat(NonZero, " OR ") + ")"
			+ Chars.LF + "          OR " + Finish + " <= " + Edge + " AND " + Ceiling + " <= " + Calculated
			+ " AND " + Period + " = " + Ceiling + " AND (" + StrConcat(NonZero, " OR ") + ")"
			+ Chars.LF + "          OR " + Finish + " <= " + Edge + " AND " + Ceiling + " > " + Calculated
			+ " AND " + Period + " = " + Calculated + " AND (" + StrConcat(Moved, " OR ") + "))";
		Settings = "      CROSS JOIN (SELECT MAX(O." + PhysicalName(OptionsPeriod, Context) + ") AS "
			+ QuoteIdentifier("Calculated", Context) + " FROM "
			+ QualifiedTableName(Options.PhysicalName, Context) + " AS O) AS TP";
		Range = " < CASE WHEN " + Finish + " > " + Edge + " THEN " + Present + " ELSE " + Ceiling + " END";
	Else
		Pick = Period + " = " + Present + " AND (" + StrConcat(NonZero, " OR ") + ")";
	EndIf;

	One = "1 AS " + QuoteIdentifier("One", Context);
	Branches = New Array;

	Section = ?(ByExtDimensions, ExtDimensionSection(Plan, Context), Undefined);
	If ByExtDimensions And Section = Undefined Then
		Raise StrTemplate("Virtual table %1 names an ext dimension in its condition, and the tabular section of"
			+ " ext dimension types of its chart of accounts is not found in the storage structure.",
			Plan.BaseName);
	EndIf;
	AccountKey = Upper(AccountFieldName(Base, "Dr"));
	For Count = 0 To ?(ByExtDimensions, Plan.Slots, 0) Do
		Table = ?(Count = 0, Totals, AccountingTotalsTable(Plan, "AT" + Format(Count, "NG=0; NZ=0")));
		Where = New Array;
		Joins = New Array;
		Conditional = TotalsConditionBase(Plan, Base, Table, Context, Count);
		AddCondition(Where, ConditionSql(RoleArgument(Arguments, Roles.Condition), Conditional, Context, Joins));
		AddCondition(Where, AccountConditionSql(RoleArgument(Arguments, Roles.AccountCondition),
			Conditional, "Dr", AccountConditionNames(""), Context, Joins));
		If ByExtDimensions Then
			Where.Add("(SELECT COUNT(*) FROM " + Section.Table + " AS EDC WHERE EDC." + Section.Owner + " = "
				+ VirtualColumn(Conditional.Fields.Get(AccountKey), Context) + ") = "
				+ Format(Count, "NG=0; NZ=0"));
		EndIf;
		Where.Add(Pick);
		Lines = New Array;
		Lines.Add("      SELECT " + One);
		Lines.Add("      FROM " + QualifiedTableName(Table.PhysicalName, Context) + " AS " + VirtualAlias());
		AddNavigationJoins(Lines, Joins, "      ");
		If Bounded Then
			Lines.Add(Settings);
		EndIf;
		Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));
		Branches.Add(StrConcat(Lines, Chars.LF));
	EndDo;

	// В ветках проводок условие по субконто идёт по самому значению, без обнуления субконто «только
	// обороты», которое делает остаток (замер x3: 90.01.1, все три субконто оборотные, за 10-31.03.2017
	// семь проводок по кредиту - семь строк). Описатель условий строится как у остатков с оборотами.
	Records = Plan;
	If ByExtDimensions Then
		Records = New Structure;
		For Each Item In Plan Do
			Records.Insert(Item.Key, Item.Value);
		EndDo;
		Records.Insert("Kind", "BALANCEANDTURNOVERS");
	EndIf;

	If Bounded Then
		Moment = VirtualColumn(PeriodColumn(Base), Context);
		For Each Side In AccountingSides(Plan.Register) Do
			Where = New Array;
			Joins = New Array;
			Active = ActiveCondition(Base, Context);
			If Not IsBlankString(Active) Then
				Where.Add(Active);
			EndIf;
			Conditional = ConditionBase(Records, Base, Side, Context);
			AddCondition(Where, ConditionSql(RoleArgument(Arguments, Roles.Condition),
				Conditional, Context, Joins));
			AddCondition(Where, AccountConditionSql(RoleArgument(Arguments, Roles.AccountCondition),
				Conditional, Side, AccountConditionNames(""), Context, Joins));
			Where.Add(AccountingColumn(Base, AccountFieldName(Base, Side), Context)
				+ " <> " + BinaryLiteral("00000000000000000000000000000000", Context));
			Where.Add(Moment + " >= " + Finish);
			Where.Add(Moment + Range);
			Lines = New Array;
			Lines.Add("      SELECT " + One);
			Lines.Add("      FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS " + VirtualAlias());
			AddNavigationJoins(Lines, Joins, "      ");
			Lines.Add(Settings);
			Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));
			Branches.Add(StrConcat(Lines, Chars.LF));
		EndDo;
	EndIf;

	Return StrConcat(Branches, Chars.LF + "      UNION ALL" + Chars.LF);

EndFunction

// Строки, которые читает запрос платформы за свёрнутым остатком одной стороны у ОстаткиИОбороты
// (замеры q01-q34, 21.11.2026, УХ, итоги рассчитаны по 01.02.2019). Обозначения: Н, К - начало и конец
// интервала; Р - последний рассчитанный месяц итогов (колонка _Period таблицы настроек итогов),
// Край = Р + месяц; НМ - начало месяца, не меньшее Н; КМ - начало месяца, не большее К, но не позже
// Края (без К - Край).
//   Без Н или при НМ < КМ - «лента»: строки итогов месяцев от НМ до КМ (без Н - все раньше КМ),
//     проводки от Н до НМ и проводки от КМ до К.
//   Иначе - «точка»: строки итогов одного месяца и проводки от Н до К и от К до точки. Точка - НМ;
//     если НМ = Край, записи итогов там нет и берётся месяц Р; если НМ позже Края - текущие итоги
//     (01.11.3999).
// Отбор строк итогов: в ленте - ненулевой ресурс, а когда выбран конечный остаток - ресурс или его
// оборот (у каждого выбранного ресурса, q34); в точке - ненулевой ресурс; у месяца Р - ресурс или
// оборот (и при одном начальном остатке, q30). Уточнение периода не учитывается, как и у остатков.
// Решение пользователя 21.11.2026 (query-to-sql-totals-decision): число строк этой ветки зависит от
// итогов базы у самой платформы, поэтому она читает таблицы итогов.
Function OneSidedTurnoverRows(Descriptor, Plan, Base, Start, Finish, Context)

	Arguments = Plan.Arguments;
	Roles = AccountingArguments(Plan.Kind);
	Totals = AccountingTotalsTable(Plan, "AT0");
	Options = AccountingTotalsTable(Plan, "OPT");
	TotalsPeriod = TotalsPhysical(Totals, "_Period");
	OptionsPeriod = TotalsPhysical(Options, "_Period");
	If IsBlankString(TotalsPeriod) Or IsBlankString(OptionsPeriod) Then
		Raise StrTemplate("The tables of totals of %1 have an unexpected structure: no period column.",
			Plan.BaseName);
	EndIf;

	ClosingUsed = False;
	For Each Resource In Plan.Resources Do
		If Used(Descriptor, Resource.Name + "ClosingBalanceDr")
			Or Used(Descriptor, Resource.Name + "ClosingBalanceCr") Then
			ClosingUsed = True;
		EndIf;
	EndDo;
	NonZero = New Array;
	Moved = New Array;
	For Each Resource In Plan.Resources Do
		If Not Used(Descriptor, Resource.Name + "OpeningBalanceDr")
			And Not Used(Descriptor, Resource.Name + "OpeningBalanceCr")
			And Not Used(Descriptor, Resource.Name + "ClosingBalanceDr")
			And Not Used(Descriptor, Resource.Name + "ClosingBalanceCr") Then
			Continue;
		EndIf;
		Stored = TotalsResourceColumn(Totals, Base, Resource);
		Turnover = ?(IsBlankString(Stored), "", TotalsTurnoverColumn(Totals, Stored));
		If IsBlankString(Stored) Or IsBlankString(Turnover) Then
			Raise StrTemplate("The table of totals by accounts of %1 has an unexpected structure: resource"
				+ " %2 or its turnover is not found.", Plan.BaseName, Resource.Name);
		EndIf;
		NonZero.Add(VirtualColumn(Stored, Context) + " <> 0");
		Moved.Add(VirtualColumn(Stored, Context) + " <> 0");
		Moved.Add(VirtualColumn(Turnover, Context) + " <> 0");
	EndDo;
	NonZeroFilter = "(" + StrConcat(NonZero, " OR ") + ")";
	MovedFilter = "(" + StrConcat(Moved, " OR ") + ")";

	PresentArguments = New Array;
	PresentArguments.Add("3999");
	PresentArguments.Add("11");
	PresentArguments.Add("1");
	Present = DateLiteralFromArguments(PresentArguments, Context);

	Calculated = "TP." + QuoteIdentifier("Calculated", Context);
	Edge = ShiftedDate(Calculated, "1", "month", Context);
	Settings = "      CROSS JOIN (SELECT MAX(O." + PhysicalName(OptionsPeriod, Context) + ") AS "
		+ QuoteIdentifier("Calculated", Context) + " FROM "
		+ QualifiedTableName(Options.PhysicalName, Context) + " AS O) AS TP";

	HasStart = Not IsBlankString(Start);
	HasFinish = Not IsBlankString(Finish);
	Ceiling = "";
	If HasStart Then
		StartMonth = TruncateToUnit("month", Start, Context);
		Ceiling = "CASE WHEN " + StartMonth + " = " + Start + " THEN " + StartMonth
			+ " ELSE " + ShiftedDate(StartMonth, "1", "month", Context) + " END";
	EndIf;
	Bottom = Edge;
	If HasFinish Then
		FinishMonth = TruncateToUnit("month", Finish, Context);
		Bottom = "CASE WHEN " + FinishMonth + " > " + Edge + " THEN " + Edge + " ELSE " + FinishMonth + " END";
	EndIf;
	Tape = ?(HasStart, Ceiling + " < " + Bottom, "");
	TotalsPoint = ?(HasStart, "CASE WHEN " + Ceiling + " <= " + Edge + " THEN " + Ceiling + " ELSE " + Present + " END", "");

	Period = VirtualColumn(TotalsPeriod, Context);
	Glue = Chars.LF + "          OR ";
	If HasStart Then
		Pick = "(" + Tape + " AND " + Period + " >= " + Ceiling + " AND " + Period + " < " + Bottom
			+ " AND " + ?(ClosingUsed, MovedFilter, NonZeroFilter)
			+ Glue + "NOT (" + Tape + ") AND " + Ceiling + " < " + Edge + " AND " + Period + " = " + Ceiling
			+ " AND " + NonZeroFilter
			+ Glue + "NOT (" + Tape + ") AND " + Ceiling + " = " + Edge + " AND " + Period + " = " + Calculated
			+ " AND " + MovedFilter
			+ Glue + "NOT (" + Tape + ") AND " + Ceiling + " > " + Edge + " AND " + Period + " = " + Present
			+ " AND " + NonZeroFilter + ")";
	Else
		Pick = Period + " < " + Bottom + " AND " + ?(ClosingUsed, MovedFilter, NonZeroFilter);
	EndIf;

	One = "1 AS " + QuoteIdentifier("One", Context);
	Branches = New Array;

	Where = New Array;
	Joins = New Array;
	Conditional = TotalsConditionBase(Plan, Base, Totals, Context, 0);
	AddCondition(Where, ConditionSql(RoleArgument(Arguments, Roles.Condition), Conditional, Context, Joins));
	AddCondition(Where, AccountConditionSql(RoleArgument(Arguments, Roles.AccountCondition),
		Conditional, "Dr", AccountConditionNames(""), Context, Joins));
	Where.Add(Pick);
	Lines = New Array;
	Lines.Add("      SELECT " + One);
	Lines.Add("      FROM " + QualifiedTableName(Totals.PhysicalName, Context) + " AS " + VirtualAlias());
	AddNavigationJoins(Lines, Joins, "      ");
	Lines.Add(Settings);
	Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));
	Branches.Add(StrConcat(Lines, Chars.LF));

	Moment = VirtualColumn(PeriodColumn(Base), Context);
	Till = ?(HasFinish, " AND " + Moment + " <= " + Finish, "");
	If HasStart Then
		Span = "(" + Tape + " AND (" + Moment + " >= " + Start + " AND " + Moment + " < " + Ceiling
			+ " OR " + Moment + " >= " + Bottom + Till + ")"
			+ Glue + "NOT (" + Tape + ") AND (" + Moment + " >= " + Start + Till
			+ ?(HasFinish, " OR " + Moment + " > " + Finish + " AND " + Moment + " < " + TotalsPoint, "") + "))";
	Else
		Span = Moment + " >= " + Bottom + Till;
	EndIf;
	For Each Side In AccountingSides(Plan.Register) Do
		Where = New Array;
		Joins = New Array;
		Active = ActiveCondition(Base, Context);
		If Not IsBlankString(Active) Then
			Where.Add(Active);
		EndIf;
		Conditional = ConditionBase(Plan, Base, Side, Context);
		AddCondition(Where, ConditionSql(RoleArgument(Arguments, Roles.Condition),
			Conditional, Context, Joins));
		AddCondition(Where, AccountConditionSql(RoleArgument(Arguments, Roles.AccountCondition),
			Conditional, Side, AccountConditionNames(""), Context, Joins));
		Where.Add(AccountingColumn(Base, AccountFieldName(Base, Side), Context)
			+ " <> " + BinaryLiteral("00000000000000000000000000000000", Context));
		Where.Add(Span);
		Lines = New Array;
		Lines.Add("      SELECT " + One);
		Lines.Add("      FROM " + QualifiedTableName(Base.PhysicalName, Context) + " AS " + VirtualAlias());
		AddNavigationJoins(Lines, Joins, "      ");
		Lines.Add(Settings);
		Lines.Add("      WHERE " + StrConcat(Where, Chars.LF + "        AND "));
		Branches.Add(StrConcat(Lines, Chars.LF));
	EndDo;

	Return StrConcat(Branches, Chars.LF + "      UNION ALL" + Chars.LF);

EndFunction

Function SignedSum(Side, Value, Condition)

	Guard = ?(IsBlankString(Condition), "", Condition + " AND ");
	Return "SUM(CASE WHEN " + Guard + Side + " = 0 THEN " + Value
		+ " WHEN " + ?(IsBlankString(Condition), "", Condition + " AND ") + Side + " = 1 THEN -"
		+ Value + " ELSE 0 END)";

EndFunction

// Вид счёта для набора строк. Когда счёт не выбран наружу, набор накрывает несколько
// счетов. Замерено на живой базе: у счетов одного вида берётся их вид, у смеси разных
// платформа раскладывает сальдо по знаку, то есть ведёт себя как с активно-пассивным.
Function AccountKindExpression(Low, High)

	Return "CASE WHEN " + Low + " = " + High + " THEN " + High + " ELSE 2 END";

EndFunction

// Знаковое сальдо раскладывается на дебет и кредит по виду счёта: активный даёт остаток
// только по дебету, пассивный только по кредиту, активно-пассивный - по знаку сальдо.
Procedure AddBalanceFields(Select, ResourceName, Suffix, Saldo, KindColumn, Context)

	Positive = "CASE WHEN " + KindColumn + " = 0 OR " + KindColumn + " = 2 AND " + Saldo
		+ " > 0 THEN " + Saldo + " ELSE 0 END";
	Negative = "CASE WHEN " + KindColumn + " = 1 OR " + KindColumn + " = 2 AND " + Saldo
		+ " < 0 THEN -(" + Saldo + ") ELSE 0 END";

	AddAccountingField(Select, ResourceName + Suffix, Saldo, Context);
	AddAccountingField(Select, ResourceName + Suffix + "Dr", Positive, Context);
	AddAccountingField(Select, ResourceName + Suffix + "Cr", Negative, Context);

EndProcedure

Procedure AddAccountingField(Select, Name, Expression, Context)

	Select.Add("    " + Expression + " AS " + QuoteIdentifier(Name, Context));

EndProcedure

#EndRegion

#Region Types

// Идентификатор типа таблицы. Замерено на живой базе 2026-09-16 на 30 типах в семи
// видах метаданных: _RTRef - это числовой суффикс физического имени таблицы,
// записанный как binary(4). Catalog.Companies -> _Reference118 -> 0x00000076.
// Ничего кроме структуры хранения для этого не нужно, СУБД не опрашивается.
Function TypeIdentifier(Descriptor, Context)

	Physical = TrimAll(Descriptor.PhysicalName);
	Digits = "";
	Position = StrLen(Physical);
	While Position >= 1 Do
		Char = Mid(Physical, Position, 1);
		If Not IsDigit(Char) Then
			Break;
		EndIf;
		Digits = Char + Digits;
		Position = Position - 1;
	EndDo;

	// Объект расширения получает суффикс X<N>: номер типа стоит перед ним.
	If Position >= 1 And Upper(Mid(Physical, Position, 1)) = "X" Then
		AddOnce(Context.Warnings, StrTemplate(
			"Table %1 is stored as %2: it comes from an extension, and its type identifier is taken from the part before X.",
			Descriptor.LogicalName, Physical));
		Digits = "";
		Position = Position - 1;
		While Position >= 1 Do
			Char = Mid(Physical, Position, 1);
			If Not IsDigit(Char) Then
				Break;
			EndIf;
			Digits = Char + Digits;
			Position = Position - 1;
		EndDo;
	EndIf;

	If IsBlankString(Digits) Then
		Raise StrTemplate(
			"Table %1 is stored as %2 and has no numeric identifier, so its type cannot be compared.",
			Descriptor.LogicalName, Physical);
	EndIf;
	Return Number(Digits);

EndFunction

Function HexLiteral(Value, Digits)

	Alphabet = "0123456789ABCDEF";
	Rest = Int(Value);
	Text = "";
	While Rest > 0 Do
		Text = Mid(Alphabet, (Rest % 16) + 1, 1) + Text;
		Rest = Int(Rest / 16);
	EndDo;
	While StrLen(Text) < Digits Do
		Text = "0" + Text;
	EndDo;
	Return Text;

EndFunction

// Двоичный литерал по диалекту. В MS SQL это 0x..., в PostgreSQL - строка в формате
// hex с обязательным префиксом \x: без него текст читается как набор символов,
// а не как байты, и сравнение со ссылкой не совпадёт никогда.
// Тип строки по диалекту: NVARCHAR существует только в MS SQL.
Function TextTypeName(Precision, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return "VARCHAR" + ?(Upper(Precision) = "(MAX)", "", Precision);
	EndIf;
	Return "NVARCHAR" + Precision;

EndFunction

Function BinaryLiteral(Hex, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return "'\x" + Lower(Hex) + "'::bytea";
	EndIf;
	Return "0x" + Upper(Hex);

EndFunction

// Код в колонке _TYPE. Замерено: 0x01 НЕОПРЕДЕЛЕНО, 0x02 булево, 0x03 число,
// 0x04 дата, 0x05 строка, 0x08 ссылка.
Function PrimitiveTypeCode(UpperName)

	If UpperName = "BOOLEAN" Or UpperName = Upper("Булево") Then
		Return 2;
	ElsIf UpperName = "NUMBER" Or UpperName = Upper("Число") Then
		Return 3;
	ElsIf UpperName = "DATE" Or UpperName = Upper("Дата") Then
		Return 4;
	ElsIf UpperName = "STRING" Or UpperName = Upper("Строка") Then
		Return 5;
	EndIf;
	Return Undefined;

EndFunction

// Пятибайтовый литерал типа: склейка _TYPE и _RTRef, как её пишет платформа.
Function TypeLiteral(TypeName, Context)

	Normalized = Upper(StrReplace(TrimAll(TypeName), " ", ""));
	Code = PrimitiveTypeCode(Normalized);
	If Code <> Undefined Then
		Return BinaryLiteral(HexLiteral(Code, 2) + "00000000", Context);
	EndIf;

	Descriptor = TableDescriptor(TypeName);
	Return BinaryLiteral("08" + HexLiteral(TypeIdentifier(Descriptor, Context), 8), Context);

EndFunction

Function ReferenceTypeIdLiteral(LogicalName, Context)
	Return BinaryLiteral(HexLiteral(TypeIdentifier(TableDescriptor(LogicalName), Context), 8), Context);
EndFunction

// Подколонки составного поля. Структура хранения отдаёт их отдельными строками
// с одним и тем же именем поля, поэтому суффиксы не додумываются, а читаются.
Function CompositeInfo(Descriptor, FieldName)

	If Descriptor = Undefined Then
		Return Undefined;
	EndIf;

	ColumnList = Descriptor.Columns.Get(Upper(TrimAll(FieldName)));
	If ColumnList = Undefined Or ColumnList.Count() < 2 Then
		Return Undefined;
	EndIf;

	// Сравнение типов берёт только подколонки, а не само поле. Если не пометить поле
	// использованным здесь, виртуальная таблица соберётся без него, и подколонок
	// в ней тоже не окажется.
	If Descriptor.Property("Used") And Descriptor.Used <> Undefined Then
		Canonical = Descriptor.Fields.Get(Upper(TrimAll(FieldName)));
		If Canonical <> Undefined Then
			Descriptor.Used.Insert(Upper(Canonical), True);
		EndIf;
	EndIf;

	Info = New Structure;
	Info.Insert("TypeColumn", "");
	Info.Insert("RefTypeColumn", "");
	Info.Insert("RefColumn", "");
	Info.Insert("StringColumn", "");
	Info.Insert("NumberColumn", "");
	Info.Insert("DateColumn", "");
	Info.Insert("BooleanColumn", "");

	For Each Column In ColumnList Do
		Upper_ = Upper(Column);
		If StrEndsWith(Upper_, "_TYPE") Then
			Info.TypeColumn = Column;
		ElsIf StrEndsWith(Upper_, "_RTREF") Then
			Info.RefTypeColumn = Column;
		ElsIf StrEndsWith(Upper_, "_RRREF") Then
			Info.RefColumn = Column;
		ElsIf StrEndsWith(Upper_, "TREF") Then
			// Регистратор хранится двумя колонками, без байта типа: он всегда ссылка.
			Info.RefTypeColumn = Column;
		ElsIf StrEndsWith(Upper_, "RREF") Then
			Info.RefColumn = Column;
		ElsIf StrEndsWith(Upper_, "_S") Then
			Info.StringColumn = Column;
		ElsIf StrEndsWith(Upper_, "_N") Then
			Info.NumberColumn = Column;
		ElsIf StrEndsWith(Upper_, "_T") Then
			Info.DateColumn = Column;
		ElsIf StrEndsWith(Upper_, "_L") Then
			Info.BooleanColumn = Column;
		EndIf;
	EndDo;

	If IsBlankString(Info.TypeColumn)
		And (IsBlankString(Info.RefTypeColumn) Or IsBlankString(Info.RefColumn)) Then
		Return Undefined;
	EndIf;
	Return Info;

EndFunction

// Проверка типа составного поля. У поля с байтом типа это два условия, у регистратора -
// одно: байта типа там нет, потому что регистратор всегда ссылка.
// Базовое имя составного поля: имя подколонки без суффикса. Суффиксы и их порядок -
// те же, по которым CompositeInfo части и разбирает: длинный вариант раньше короткого.
Function CompositeBaseName(Info)

	Source = ?(IsBlankString(Info.RefColumn), Info.TypeColumn, Info.RefColumn);
	If IsBlankString(Source) Then
		Return "";
	EndIf;

	Upper_ = Upper(Source);
	For Each Suffix In StrSplit("_RRREF,_RTREF,_TYPE,RREF,TREF", ",", False) Do
		If StrEndsWith(Upper_, Suffix) And StrLen(Source) > StrLen(Suffix) Then
			Return Left(Source, StrLen(Source) - StrLen(Suffix));
		EndIf;
	EndDo;
	Return "";

EndFunction

// Чем определяется подколонка составного поля: остальными его частями и самим полем.
Function CompositeDeterminants(Descriptor, Alias, Info, Context)

	Names = New Array;
	Names.Add(Info.RefColumn);
	Names.Add(Info.RefTypeColumn);
	Names.Add(Info.TypeColumn);
	Names.Add(CompositeBaseName(Info));

	Columns = New Array;
	For Each Name In Names Do
		If IsBlankString(Name) Then
			Continue;
		EndIf;
		Column = FieldColumn(Descriptor, Alias, Name, Context);
		If Not IsBlankString(Column) And Columns.Find(Column) = Undefined Then
			Columns.Add(Column);
		EndIf;
	EndDo;
	Return Columns;

EndFunction

Function CompositeTypeTest(Descriptor, Alias, Info, TypeId, Context)

	Determinants = CompositeDeterminants(Descriptor, Alias, Info, Context);

	If IsBlankString(Info.RefTypeColumn) Then
		// У поля из примитивов и одной ссылки колонки типа таблицы нет: ссылочный тип
		// там ровно один, и достаточно проверить, что в поле лежит ссылка.
		SoleTypeColumn = FieldColumn(Descriptor, Alias, Info.TypeColumn, Context);
		RegisterDeterminedColumns(Context, SoleTypeColumn, Determinants);
		Return SoleTypeColumn + " = " + BinaryLiteral("08", Context);
	EndIf;

	RefTypeColumn = FieldColumn(Descriptor, Alias, Info.RefTypeColumn, Context);
	// Колонки, по которым различается тип: в выборке они стоят в условии ВЫБОРа, и T-SQL
	// требует их в GROUP BY наравне с самой ссылкой.
	RegisterDeterminedColumns(Context, RefTypeColumn, Determinants);
	Test = RefTypeColumn + " = " + TypeId;
	If Not IsBlankString(Info.TypeColumn) Then
		TypeColumn = FieldColumn(Descriptor, Alias, Info.TypeColumn, Context);
		RegisterDeterminedColumns(Context, TypeColumn, Determinants);
		Test = TypeColumn + " = " + BinaryLiteral("08", Context) + " AND " + Test;
	EndIf;
	Return Test;

EndFunction

// Составное поле, сравниваемое со значением известного типа. Платформа сверяет три
// колонки, а не одну: байт типа, идентификатор таблицы и саму ссылку. Без этого
// условие шире, чем в 1С, - у пустой ссылки колонка ссылки нулевая у любого типа,
// и под "= ЗНАЧЕНИЕ(Справочник.X.ПустаяСсылка)" попадает вся таблица.
//
// Образец распознаётся узко: слева путь к составному полю, справа ЗНАЧЕНИЕ(...) либо
// список из них. Тип любого другого операнда при трансляции неизвестен, и такие места
// остаются как были, но с предупреждением.
// Роли колонок значения, одной строкой. Нужны, чтобы сверить состав двух составных
// полей, не собирая самих значений: состав переменный - у поля с одним ссылочным типом
// нет RTREF, у регистратора нет TYPE, - а сравнивать по-колоночно можно только
// одинаковые составы. Порядок перечисления здесь не важен, важно лишь совпадение строк.
Function CompositeRoleSet(Info)

	Roles = New Array;
	If Not IsBlankString(Info.TypeColumn) Then
		Roles.Add("TYPE");
	EndIf;
	If Not IsBlankString(Info.RefTypeColumn) Then
		Roles.Add("RTREF");
	EndIf;
	If Not IsBlankString(Info.RefColumn) Then
		Roles.Add("RRREF");
	EndIf;
	If Not IsBlankString(Info.StringColumn) Then
		Roles.Add("S");
	EndIf;
	If Not IsBlankString(Info.NumberColumn) Then
		Roles.Add("N");
	EndIf;
	If Not IsBlankString(Info.DateColumn) Then
		Roles.Add("T");
	EndIf;
	If Not IsBlankString(Info.BooleanColumn) Then
		Roles.Add("L");
	EndIf;
	Return StrConcat(Roles, "|");

EndFunction

// Операнд сравнения, если это составное поле. Путь разрешается здесь, а значение
// собирается потом и один раз: решение «сравнивать по частям или нет» принимается по
// составу колонок, и до этого решения считать значение незачем.
Function CompositeComparisonOperand(Token, Context)

	If Token.Kind <> "Name" Then
		Return Undefined;
	EndIf;

	Path = TrimAll(Token.Value);
	If StrFind(Path, ".") = 0 And Context.BareFields.Get(Upper(Path)) = Undefined Then
		// Ни пути с точкой, ни голого поля из параметров виртуальной таблицы: не поле.
		Return Undefined;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		// Имя, похожее на путь, полем быть не обязано - пусть разбирает общий путь.
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		// Путь идёт дальше составной ссылки: там значение собирают ветви ВЫБОРа, и
		// сравнивать по колонкам хранения нечего.
		Return Undefined;
	EndIf;

	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Then
		Return Undefined;
	EndIf;

	Operand = New Structure;
	Operand.Insert("Path", Path);
	Operand.Insert("Resolved", Resolved);
	Operand.Insert("Info", Info);
	Operand.Insert("Roles", CompositeRoleSet(Info));
	Return Operand;

EndFunction

// Сравнение двух составных полей. Платформа сверяет все колонки значения, а не одну
// ссылку: замерено «ГДЕ A.Contract = A.Terms» и «ПО A.Contract = B.Terms» - и там, и
// там три условия подряд, по колонке типа, по идентификатору таблицы и по самой ссылке
// (composite-reference2.json, замеры 9923 и 9926). Одного uuid мало: он совпадает у
// ссылок разных таблиц, а у пустой ссылки нулевой сразу у всех типов, - поэтому
// сравнение по одной колонке соединяет и отбирает шире, чем 1С.
//
// Образец узкий намеренно: слева и справа поле, операция ровно «=», сравнение стоит
// самостоятельным условием, составы колонок совпадают. «В», выражение вместо поля и разные
// составы остаются прежнему разбору: формы платформы для них не замерены. «<>» разбирается
// только у хранимого составного против ссылки одного типа (замеры r03, r04: те же части через OR).
Function CompositeValueComparisonSpan(Tokens, Index, Context)

	If Index + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Sign = Tokens[Index + 1].Value;
	If Tokens[Index + 1].Kind <> "Symbol" Or (Sign <> "=" And Sign <> "<>") Then
		Return Undefined;
	EndIf;
	// Группа из трёх условий заменяет собой целое сравнение, поэтому сравнение обязано
	// быть самостоятельным: внутри арифметики или другого сравнения её ставить нельзя.
	If Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Index + 2) Then
		Return Undefined;
	EndIf;

	First = CompositeComparisonOperand(Tokens[Index], Context);
	If First = Undefined Then
		Second = CompositeComparisonOperand(Tokens[Index + 2], Context);
		Return ?(Second = Undefined, Undefined,
			SignedReferenceSpan(SingleReferenceComparisonSpan(Second, Tokens[Index], Context), Sign, True));
	EndIf;
	Second = CompositeComparisonOperand(Tokens[Index + 2], Context);
	If Second = Undefined Then
		Return SignedReferenceSpan(SingleReferenceComparisonSpan(First, Tokens[Index + 2], Context), Sign, False);
	EndIf;
	Span = New Structure;
	Span.Insert("First", First);
	Span.Insert("Second", Second);
	If Sign <> "=" Or Second.Roles <> First.Roles Then
		If HoldsOnlyParts(First.Resolved.Descriptor, First.Resolved.FieldName, Context)
			Or HoldsOnlyParts(Second.Resolved.Descriptor, Second.Resolved.FieldName, Context) Then
			Return Undefined;
		EndIf;
		Span.Insert("Unequal", Sign);
	EndIf;
	Return Span;

EndFunction

// Сравнение составного со ссылкой одного типа: знак и порядок сторон. «<>» - только у хранимого составного
// (ветвь Single): у колонки из частей его разбирает PartsPairComparisonSql.
Function SignedReferenceSpan(Span, Sign, ReferenceFirst)

	If Span = Undefined Or Sign <> "=" And Not Span.Property("Single") Then
		Return Undefined;
	EndIf;
	Span.Insert("Sign", Sign);
	Span.Insert("ReferenceFirst", ReferenceFirst);
	Return Span;

EndFunction

// Колонки значения, разложенные по ролям. Undefined - если роли колонок не различают:
// тогда пару колонке не найти, и сравнивать по частям нечем.
Function ValuePartsByRole(Value)

	Result = New Map;
	For Each Part In Value.Parts Do
		If IsBlankString(Part.Role) Or Result.Get(Part.Role) <> Undefined Then
			Return Undefined;
		EndIf;
		Result.Insert(Part.Role, Part.Text);
	EndDo;
	Return Result;

EndFunction

// Колонки сравниваемого поля - кандидаты в группировку. Сравнение бывает и в списке
// выборки: в 1С это значение типа Булево, и тогда T-SQL требует в GROUP BY каждую
// колонку условия. Определители те же, по которым это уже делает проверка типа
// составного поля, - CompositeTypeTest.
Procedure RegisterComparisonColumns(Operand, Value, Context)

	Determinants = CompositeDeterminants(Operand.Resolved.Descriptor, Operand.Resolved.Alias,
		Operand.Info, Context);
	For Each Part In Value.Parts Do
		RegisterDeterminedColumns(Context, Part.Text, Determinants);
	EndDo;

EndProcedure

// Хранимое составное поле против ссылки одного типа: все части значения в порядке хранения - тег, примитивные
// части с пустыми значениями, идентификатор таблицы, сама ссылка (замеры m08, n10, r01, 21.11.2026, УХ:
// `_TYPE = 0x08 AND _L = 0x00 AND _N = 0 AND _T = {ts '2001-01-01'} AND _S = N'' AND _RRRef = T2._IDRRef`,
// у регистратора `_RecorderTRef = 0x… AND _RecorderRRef = …`). Ссылка, которая бывает NULL (ReferenceMayBeNull),
// у платформы стоит под проверкой «значение есть» во всех частях, кроме самой ссылки (m02, n11, n13, r01, r02):
// `_TYPE = CASE WHEN T2._IDRRef IS NOT NULL THEN 0x08 END`. Константа давала другой ответ под НЕ и в значении-
// условии: при ссылке NULL и значении другого типа в поле `тег = 0x08` - Ложь, а не NULL, и `НЕ С.Контрагент =
// К.Ссылка` пропускало строки, которых 1С не выдаёт (m02: 1С 0 строк, перевод 17). «<>» - те же части через OR
// (r03, r04). Стороны - в порядке текста (n20). У колонки производной таблицы примитивные части не сверяются: в
// ветви объединения они бывают NULL (см. PartsOnlyReferenceSql).
Function StoredReferenceComparisonSql(Span, Context)

	Operand = Span.First;
	Descriptor = Operand.Resolved.Descriptor;
	Reference = TranslateValue(Span.Single, Context);
	MayBeNull = ReferenceMayBeNull(Span.Single, Context);
	Columns = InfoPartColumns(Operand.Info);
	Determinants = CompositeDeterminants(Descriptor, Operand.Resolved.Alias, Operand.Info, Context);
	Tests = New Array;
	For Each Suffix In PartRoleOrder() Do
		Column = Columns.Get(Suffix);
		If Column = Undefined Then
			Continue;
		EndIf;
		If Suffix = "_RRRef" Then
			Part = Reference;
		ElsIf Suffix = "_TYPE" Or Suffix = "_RTRef" Then
			Part = PartOfReference(Suffix, Span.Target, Reference, Context);
		ElsIf Descriptor.IsDerived Then
			Continue;
		Else
			Part = EmptyPartLiteral(Suffix, Context);
		EndIf;
		If MayBeNull And Suffix <> "_RRRef" Then
			Part = "CASE WHEN " + Reference + " IS NOT NULL THEN " + Part + " END";
		EndIf;
		Stored = FieldColumn(Descriptor, Operand.Resolved.Alias, Column, Context);
		RegisterDeterminedColumns(Context, Stored, Determinants);
		Tests.Add(?(Span.ReferenceFirst, Part + " " + Span.Sign + " " + Stored, Stored + " " + Span.Sign + " " + Part));
	EndDo;
	Return "(" + StrConcat(Tests, ?(Span.Sign = "=", " AND ", " OR ")) + ")";

EndFunction

// Ссылка второй стороны может быть NULL так, как это видит платформа: поле стороны внешнего соединения, временной
// таблицы или вложенного запроса (NullableSourceAlias) либо поле через переход - его соединение левое (замер r02).
// Псевдоним не из источников запроса (поле внешнего запроса у вложенного) - тоже: проверка «значение есть» при
// ненулевой ссылке ничего не меняет, а при NULL нужна.
Function ReferenceMayBeNull(Path, Context)

	Segments = StrSplit(TrimAll(Path), ".", False);
	If Segments.Count() <> 2 Or Not Context.Property("Operator") Or Context.Operator = Undefined Then
		Return True;
	EndIf;
	Wanted = Upper(TrimAll(Segments[0]));
	Known = False;
	For Each Source In Context.Operator.Sources Do
		For Each Item In AliasedSourceTables(Source) Do
			If SourceAlias(Item) = Wanted Then
				Known = True;
			EndIf;
		EndDo;
	EndDo;
	Return Not Known Or NullableSourceAlias(Wanted, Context);

EndFunction

// Таблица ссылки одного типа по объявленному типу колонки производной таблицы - типу модели запроса платформы.
// Пустая строка - типов несколько, тип не ссылочный или сведений нет.
Function DeclaredReferenceTable(Descriptor, FieldName)

	If Descriptor = Undefined Or Not Descriptor.IsDerived Or Not Descriptor.Property("DeclaredTypes")
		Or Descriptor.DeclaredTypes = Undefined Then
		Return "";
	EndIf;
	Declared = Descriptor.DeclaredTypes.Get(Upper(TrimAll(FieldName)));
	If Declared = Undefined Then
		Return "";
	EndIf;
	Found = "";
	For Each Item In Declared.Types() Do
		If Item = Type("Null") Then
			Continue;
		EndIf;
		Target = Metadata.FindByType(Item);
		If Target = Undefined Or Not IsBlankString(Found) Then
			Return "";
		EndIf;
		Found = Target.FullName();
	EndDo;
	Return Found;

EndFunction

// Собранное условие, либо Undefined - тогда вызывающий оставляет общий разбор.
// Составное поле против хранимой ссылки одного типа. Тип второй стороны известен, и платформа
// сверяет тег и идентификатор таблицы составного, а не одни байты ссылки (УХ, ПроблемыПроверки-
// Контрагентов: «ПО С.Контрагент = К.Ссылка» - у одного uuid строки с RTRef 0xBC и 0xE6, 1С 155,
// SQL по одной ссылке 156). Сторона из производной таблицы не берётся: тип её колонки по
// источнику первой ветви объединения не доказан. Поле из примитивов и одной ссылки (идентификатора таблицы
// нет) сравнивается так же, по всем частям (замеры m10, m12, n10, n13, 21.11.2026, УХ): ссылочный тип у него один,
// и вторая сторона должна быть ссылкой этого типа - тогда годится и колонка временной таблицы (её тип - тип модели).
Function SingleReferenceComparisonSpan(Composite, Token, Context)

	If HoldsOnlyParts(Composite.Resolved.Descriptor, Composite.Resolved.FieldName, Context) Then
		Return PartsOnlyReferenceSpan(Composite, Token, Context);
	EndIf;
	Info = Composite.Info;
	If Token.Kind <> "Name" Or StrFind(Token.Value, ".") = 0 Or IsBlankString(Info.RefColumn) Then
		Return Undefined;
	EndIf;
	OwnTable = "";
	If IsBlankString(Info.RefTypeColumn) Then
		If IsBlankString(Info.TypeColumn) Then
			Return Undefined;
		EndIf;
		OwnTable = SoleReferenceTable(ResolvedTypeDescription(Composite.Resolved));
		If IsBlankString(OwnTable) Then
			Return Undefined;
		EndIf;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(TrimAll(Token.Value), Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment)
		Or Resolved.Descriptor.IsDerived And IsBlankString(OwnTable)
		Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
		Return Undefined;
	EndIf;
	Target = "";
	If Resolved.Descriptor.IsDerived Then
		Target = DeclaredReferenceTable(Resolved.Descriptor, Resolved.FieldName);
	EndIf;
	If IsBlankString(Target) Then
		Target = SingleReferenceTarget(TrimAll(Token.Value), Context);
	EndIf;
	If IsBlankString(Target) Or Not IsBlankString(OwnTable) And OwnTable <> Target Then
		Return Undefined;
	EndIf;

	Span = New Structure;
	Span.Insert("First", Composite);
	Span.Insert("Single", TrimAll(Token.Value));
	Span.Insert("Target", Target);
	Return Span;

EndFunction

Function CompositeValueComparisonSql(Span, Context)

	If Span.Property("PartsOnly") Then
		Return PartsOnlyReferenceSql(Span, Context);
	EndIf;
	If Span.Property("Single") Then
		Return StoredReferenceComparisonSql(Span, Context);
	EndIf;
	If Span.Property("Unequal") Then
		Return StoredCompositePairSql(Span, Context);
	EndIf;

	FirstValue = FieldValue(Span.First.Path, Context);
	SecondValue = FieldValue(Span.Second.Path, Context);

	FirstParts = ValuePartsByRole(FirstValue);
	SecondParts = ValuePartsByRole(SecondValue);
	If FirstParts = Undefined Or SecondParts = Undefined
		Or FirstParts.Count() <> SecondParts.Count() Then
		Return Undefined;
	EndIf;

	// Порядок условий - порядок колонок первого операнда, то есть порядок хранения:
	// в нём их и выводит платформа.
	Tests = New Array;
	For Each Part In FirstValue.Parts Do
		Mate = SecondParts.Get(Part.Role);
		If Mate = Undefined Then
			Return Undefined;
		EndIf;
		Tests.Add(Part.Text + " = " + Mate);
	EndDo;

	RegisterComparisonColumns(Span.First, FirstValue, Context);
	RegisterComparisonColumns(Span.Second, SecondValue, Context);
	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

// Колонки частей хранимого составного поля по ролям.
Function StoredCompositeParts(Operand, Context)

	Result = New Map;
	For Each Pair In InfoPartColumns(Operand.Info) Do
		Result.Insert(Pair.Key, FieldColumn(Operand.Resolved.Descriptor, Operand.Resolved.Alias, Pair.Value, Context));
	EndDo;
	Return Result;

EndFunction

// Два составных поля с разным составом частей либо под «<>». Замеры db16-db21, de1-de3b (21.11.2026, УХ): «=» - тег
// с тегом, идентификатор таблицы и ссылка попарно, а часть, которой у другой стороны нет, - с пустым значением
// своего вида (`T1._Fld31548_TYPE = T1._Fld31546_TYPE AND T1._Fld31548_L = 0x00 AND T1._Fld31548_N = @P2 AND …_T =
// @P3 AND …_S = @P4 AND …_RTRef = …_RTRef AND …_RRRef = …_RRRef`); «<>» - общие части через OR (`T1._Fld24028_TYPE
// <> T2._Fld24028_TYPE OR …_RTRef <> …_RTRef OR …_RRRef <> …_RRRef`); у регистратора тега нет, на его месте 0x08
// (`T1._Fld24028_TYPE = 0x08 AND T1._Fld24028_RTRef = T2._RecorderTRef AND …`, под «<>» - `<> 0x08 OR …`). Прежде
// сравнивалась одна колонка ссылки, и значения разных типов с одним uuid, пустые ссылки разных таблиц и
// НЕОПРЕДЕЛЕНО считались равными - молча. Undefined - у стороны нет идентификатора таблицы: не замерено.
Function StoredCompositePairSql(Span, Context)

	LeftParts = StoredCompositeParts(Span.First, Context);
	RightParts = StoredCompositeParts(Span.Second, Context);
	For Each Suffix In StrSplit("_RTRef,_RRRef", ",", False) Do
		If LeftParts.Get(Suffix) = Undefined Or RightParts.Get(Suffix) = Undefined Then
			Return Undefined;
		EndIf;
	EndDo;
	Equal = Span.Unequal = "=";
	Tests = New Array;
	For Each Suffix In PartRoleOrder() Do
		LeftPart = LeftParts.Get(Suffix);
		RightPart = RightParts.Get(Suffix);
		If LeftPart = Undefined And RightPart = Undefined Then
			Continue;
		EndIf;
		If Suffix = "_TYPE" Then
			LeftPart = ?(LeftPart = Undefined, BinaryLiteral(HexLiteral(8, 2), Context), LeftPart);
			RightPart = ?(RightPart = Undefined, BinaryLiteral(HexLiteral(8, 2), Context), RightPart);
		ElsIf LeftPart = Undefined Or RightPart = Undefined Then
			If Not Equal Then
				Continue;
			EndIf;
			LeftPart = ?(LeftPart = Undefined, EmptyPartLiteral(Suffix, Context), LeftPart);
			RightPart = ?(RightPart = Undefined, EmptyPartLiteral(Suffix, Context), RightPart);
		EndIf;
		Tests.Add(LeftPart + ?(Equal, " = ", " <> ") + RightPart);
	EndDo;
	RegisterComparisonColumns(Span.First, FieldValue(Span.First.Path, Context), Context);
	RegisterComparisonColumns(Span.Second, FieldValue(Span.Second.Path, Context), Context);
	Return "(" + StrConcat(Tests, ?(Equal, " AND ", " OR ")) + ")";

EndFunction

// `Составное [НЕ] В (Поле, …)` и `Составное [НЕ] В (ВЫБРАТЬ ссылку одной таблицы …)`, слева - составное поле из
// одних ссылок с идентификатором таблицы. Замеры r05, dc10-dc14, de11-de13, de15, df4, df5, df10 (21.11.2026, УХ):
// `T1._Fld34510_TYPE = 0x08 AND T1._Fld34510_RTRef = 0x000000BC AND T1._Fld34510_RRRef IN (SELECT …)`, со списком -
// `… IN (T2._IDRRef, 0x00…)`; у регистратора без тега - `T1._RecorderTRef = 0x000002D7 AND T1._RecorderRRef IN (…)`;
// поля разных таблиц - `_TYPE = 0x08 AND _RTRef + _RRRef IN (CASE WHEN T2._IDRRef IS NOT NULL THEN 0x000000BC END +
// T2._IDRRef, …)`; НЕ - отрицание всей группы. Прежде сравнивалась одна ссылка: под НЕ при NULL в списке строка с
// значением другого типа пропадала (dc12: у 1С 17 строк, у одной ссылки 0), а пустая ссылка и НЕОПРЕДЕЛЕНО
// совпадали с пустой ссылкой списка. Список из одних ЗНАЧЕНИЕ и параметров разбирает TypedReferenceComparisonSql,
// колонку подзапроса из частей и составную - PartsOnlyInSubquerySql и общий путь. Undefined - не этот случай.
Function StoredCompositeInSql(Tokens, Index, Context, Consumed)

	If Context.Property("CompositeInGuard") And Context.CompositeInGuard = True Then
		Return Undefined;
	EndIf;
	Token = Tokens[Index];
	If Token.Kind <> "Name" Or StrFind(Token.Value, ".") = 0 Or Index + 3 > Tokens.Count() - 1
		Or Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Position = Index + 1;
	Negated = False;
	Word = Upper(Tokens[Position].Value);
	If Tokens[Position].Kind = "Name" And (Word = "NOT" Or Word = Upper("Не")) Then
		Negated = True;
		Position = Position + 1;
		Word = Upper(Tokens[Position].Value);
	EndIf;
	If Tokens[Position].Kind <> "Name" Or (Word <> "IN" And Word <> Upper("В"))
		Or Position + 2 > Tokens.Count() - 1 Or Tokens[Position + 1].Value <> "(" Then
		Return Undefined;
	EndIf;
	Closing = MatchingParen(Tokens, Position + 1);
	If Closing = Undefined Or Not RightIsBoundary(Tokens, Closing) Then
		Return Undefined;
	EndIf;
	Operand = CompositeComparisonOperand(Token, Context);
	If Operand = Undefined Or IsBlankString(Operand.Info.RefColumn) Or IsBlankString(Operand.Info.RefTypeColumn)
		Or Not IsBlankString(Operand.Info.BooleanColumn + Operand.Info.NumberColumn + Operand.Info.DateColumn
			+ Operand.Info.StringColumn)
		Or HoldsOnlyParts(Operand.Resolved.Descriptor, Operand.Resolved.FieldName, Context) Then
		Return Undefined;
	EndIf;
	Descriptor = Operand.Resolved.Descriptor;
	Alias = Operand.Resolved.Alias;
	TypeTest = ?(IsBlankString(Operand.Info.TypeColumn), "",
		FieldColumn(Descriptor, Alias, Operand.Info.TypeColumn, Context) + " = "
		+ BinaryLiteral(HexLiteral(8, 2), Context) + " AND ");
	TableColumn = FieldColumn(Descriptor, Alias, Operand.Info.RefTypeColumn, Context);
	RefColumn = FieldColumn(Descriptor, Alias, Operand.Info.RefColumn, Context);
	Sql = "";
	Word = Upper(Tokens[Position + 2].Value);
	If Tokens[Position + 2].Kind = "Name" And (Word = "SELECT" Or Word = Upper("Выбрать")) Then
		Schema = New QuerySchema;
		Try
			Schema.SetQueryText(WithoutOuterReferences(TokensText(Tokens, Position + 2, Closing - 1), Context));
		Except
			Return Undefined;
		EndTry;
		If Schema.QueryBatch.Count() <> 1 Or Schema.QueryBatch[0].Columns.Count() <> 1 Then
			Return Undefined;
		EndIf;
		Kind = SubqueryColumnKind(Schema.QueryBatch[0], 0, Context);
		If Kind = Undefined Or Kind.Role <> "_RRRef" Or IsBlankString(Kind.Target) Then
			Return Undefined;
		EndIf;
		Context.Insert("CompositeInGuard", True);
		Try
			Inner = TranslateExpression(TrimAll(Token.Value) + " IN (" + TokensText(Tokens, Position + 2, Closing - 1)
				+ ")", Context);
		Except
			Context.CompositeInGuard = False;
			Raise;
		EndTry;
		Context.CompositeInGuard = False;
		If Not StrStartsWith(Inner, RefColumn + " IN") Then
			Return Undefined;
		EndIf;
		Sql = "(" + TypeTest + TableColumn + " = " + ReferenceTypeIdLiteral(Kind.Target, Context) + " AND " + Inner + ")";
	Else
		Items = New Array;
		Tables = New Array;
		Fields = 0;
		Start = Position + 2;
		While Start < Closing Do
			Finish = Start;
			Depth = 0;
			While Finish < Closing Do
				If Tokens[Finish].Kind = "Symbol" Then
					If Tokens[Finish].Value = "(" Then
						Depth = Depth + 1;
					ElsIf Tokens[Finish].Value = ")" Then
						Depth = Depth - 1;
					ElsIf Tokens[Finish].Value = "," And Depth = 0 Then
						Break;
					EndIf;
				EndIf;
				Finish = Finish + 1;
			EndDo;
			Target = "";
			ItemSql = "";
			If Finish - Start = 1 And Tokens[Start].Kind = "Name" And StrFind(Tokens[Start].Value, ".") > 0 Then
				Path = TrimAll(Tokens[Start].Value);
				Resolved = Undefined;
				Try
					Resolved = ResolveField(Path, Context);
				Except
					Return Undefined;
				EndTry;
				If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined
					Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
					Return Undefined;
				EndIf;
				If Resolved.Descriptor.IsDerived Then
					Target = DeclaredReferenceTable(Resolved.Descriptor, Resolved.FieldName);
				EndIf;
				If IsBlankString(Target) Then
					Target = SingleReferenceTarget(Path, Context);
				EndIf;
				If IsBlankString(Target) Then
					Return Undefined;
				EndIf;
				Copy = Path;
				ItemSql = TranslateValue(Copy, Context);
				Fields = Fields + 1;
			Else
				Taken = ValueCallPath(Tokens, Start);
				If Taken = Undefined Or Taken.Next <> Finish Then
					Return Undefined;
				EndIf;
				Segments = StrSplit(Taken.Path, ".", False);
				If Segments.Count() <> 3 Then
					Return Undefined;
				EndIf;
				Owner = MetadataOf(Segments[0] + "." + Segments[1]);
				If Owner = Undefined Then
					Return Undefined;
				EndIf;
				Target = Owner.FullName();
				Copy = TokensText(Tokens, Start, Finish - 1);
				ItemSql = TranslateValue(Copy, Context);
			EndIf;
			TableId = ReferenceTypeIdLiteral(Target, Context);
			If Tables.Find(TableId) = Undefined Then
				Tables.Add(TableId);
			EndIf;
			Items.Add(New Structure("Sql, TableId", ItemSql, TableId));
			Start = Finish + 1;
		EndDo;
		If Fields = 0 Or Items.Count() = 0 Then
			Return Undefined;
		EndIf;
		Listed = New Array;
		If Tables.Count() = 1 Then
			For Each Item In Items Do
				Listed.Add(Item.Sql);
			EndDo;
			Sql = "(" + TypeTest + TableColumn + " = " + Tables[0] + " AND " + RefColumn + " IN ("
				+ StrConcat(Listed, ", ") + "))";
		ElsIf Fields = Items.Count() Then
			For Each Item In Items Do
				Listed.Add("CASE WHEN " + Item.Sql + " IS NOT NULL THEN " + Item.TableId + " END + " + Item.Sql);
			EndDo;
			Sql = "(" + TypeTest + TableColumn + " + " + RefColumn + " IN (" + StrConcat(Listed, ", ") + "))";
		Else
			Return Undefined;
		EndIf;
	EndIf;
	Consumed = Closing - Index + 1;
	Return ?(Negated, "NOT ", "") + Sql;

EndFunction

// Элемент `(Составное, …) В (ВЫБРАТЬ ссылку одной таблицы, …)`: тег и идентификатор таблицы составного поля
// перед сравнением ссылки. Замер dc15 (21.11.2026, УХ): `EXISTS(SELECT 1 FROM … T2 WHERE … (T1._Fld34510_TYPE = 0x08
// AND T1._Fld34510_RTRef = 0x000000BC AND T1._Fld34510_RRRef = T2._IDRRef) AND (T1._Fld34511RRef = …))`. По одной
// ссылке вхождение шире (сверка dp145: у 1С 5, у одной ссылки 6). Пустая строка - элемент не такой.
Function CompositeTupleInTests(LeftText, Query, Index, Context)

	Path = TrimAll(LeftText);
	If StrFind(Path, "(") > 0 Or StrFind(Path, " ") > 0 Or StrFind(Path, ".") = 0 Then
		Return "";
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return "";
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined Then
		Return "";
	EndIf;
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Or IsBlankString(Info.RefColumn) Or IsBlankString(Info.RefTypeColumn)
		Or Not IsBlankString(Info.BooleanColumn + Info.NumberColumn + Info.DateColumn + Info.StringColumn)
		Or HoldsOnlyParts(Resolved.Descriptor, Resolved.FieldName, Context) Then
		Return "";
	EndIf;
	Kind = SubqueryColumnKind(Query, Index, Context);
	If Kind = Undefined Or Kind.Role <> "_RRRef" Or IsBlankString(Kind.Target) Then
		Return "";
	EndIf;
	Tests = "";
	If Not IsBlankString(Info.TypeColumn) Then
		Tests = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context) + " = "
			+ BinaryLiteral(HexLiteral(8, 2), Context) + " AND ";
	EndIf;
	Return Tests + FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context) + " = "
		+ ReferenceTypeIdLiteral(Kind.Target, Context) + " AND ";

EndFunction

// ЕСТЬNULL(поле, литерал) =/<> литерал, когда поле и литерал - разных видов. Замерено
// (9401-9404): платформа держит такое ЕСТЬNULL составным значением и сравнивает его с
// литералом по всем частям - тег, роль литерала, пустые остальные роли. У составного поля
// тег и части берутся из хранения, у примитивного тег - константа его вида. Поле того же
// вида, что литерал, сюда не попадает: там ЕСТЬNULL - обычное значение одного вида.
Function IsNullLiteralComparisonSpan(Tokens, Index, Context)

	If Index + 7 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index].Value);
	If Word <> "ISNULL" And Word <> Upper("ЕстьNULL") Then
		Return Undefined;
	EndIf;
	If Tokens[Index + 1].Value <> "(" Or Tokens[Index + 2].Kind <> "Name"
		Or Tokens[Index + 3].Value <> "," Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Substitute = LiteralPartRole(Tokens, Index + 4, Context);
	// Ссылка вторым аргументом - только у составного поля с идентификатором таблицы: там прежний
	// разбор сравнивал одну колонку ссылки, и пустые ссылки других типов, НЕОПРЕДЕЛЕНО и примитивы
	// (их колонка ссылки нулевая) выпадали (polish27b isnullne, «ЕСТЬNULL(составное, Пустая1) <>
	// Пустая1» и «<> Пустая2»: ERP WE 1С 1487, SQL 1379; УХ 256 и 8).
	ReferenceSubstitute = Substitute = Undefined;
	If ReferenceSubstitute Then
		Substitute = LiteralPartRole(Tokens, Index + 4, Context, True);
	EndIf;
	If Substitute = Undefined Then
		Return Undefined;
	EndIf;
	Close = Index + 4 + Substitute.Width;
	If Close + 2 > Tokens.Count() - 1 Or Tokens[Close].Value <> ")"
		Or Tokens[Close + 1].Kind <> "Symbol"
		Or (Tokens[Close + 1].Value <> "=" And Tokens[Close + 1].Value <> "<>") Then
		Return Undefined;
	EndIf;
	Operator = Tokens[Close + 1].Value;
	Compared = LiteralPartRole(Tokens, Close + 2, Context, True);
	If Compared = Undefined Then
		Return Undefined;
	EndIf;
	Last = Close + 2 + Compared.Width - 1;
	If Not RightIsBoundary(Tokens, Last) Then
		Return Undefined;
	EndIf;

	Path = TrimAll(Tokens[Index + 2].Value);
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;

	Field = New Structure("Tag, NullTest, Parts", "", "", New Map);
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If ReferenceSubstitute And (Info = Undefined Or IsBlankString(Info.TypeColumn)
		Or IsBlankString(Info.RefTypeColumn)) Then
		Return Undefined;
	EndIf;
	If Info <> Undefined And Not IsBlankString(Info.TypeColumn) Then
		Field.Tag = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);
		Field.NullTest = Field.Tag;
		Columns = New Map;
		Columns.Insert("_L", Info.BooleanColumn);
		Columns.Insert("_N", Info.NumberColumn);
		Columns.Insert("_T", Info.DateColumn);
		Columns.Insert("_S", Info.StringColumn);
		Columns.Insert("_RTRef", Info.RefTypeColumn);
		Columns.Insert("_RRRef", Info.RefColumn);
		For Each Entry In Columns Do
			If Not IsBlankString(Entry.Value) Then
				Field.Parts.Insert(Entry.Key,
					FieldColumn(Resolved.Descriptor, Resolved.Alias, Entry.Value, Context));
			EndIf;
		EndDo;
		Determinants = CompositeDeterminants(Resolved.Descriptor, Resolved.Alias, Info, Context);
		For Each Entry In Field.Parts Do
			RegisterDeterminedColumns(Context, Entry.Value, Determinants);
		EndDo;
		RegisterDeterminedColumns(Context, Field.Tag, Determinants);
		If Compared.Parts.Count() > 0 And IsBlankString(Info.RefTypeColumn)
			And Not IsBlankString(Info.RefColumn) Then
			// Составное поле с одним ссылочным типом: идентификатора таблицы в хранении нет,
			// и пустые ссылки разных таблиц совпадают байтами. Как платформа сравнивает такое
			// поле со ссылкой другой таблицы, не замерено.
			Raise StrTemplate(
				"ISNULL(%1, ...) is compared with a reference, and %1 holds primitives and one reference"
				+ " type without a table id column. How the platform compares that with a reference has"
				+ " not been measured.", Path);
		EndIf;
	ElsIf Info = Undefined And Not IsBlankString(SingleReferenceTarget(Path, Context)) Then
		// Замерено (9407, 9418): односоставную ссылку платформа держит тем же составным
		// значением - тег 0x08, идентификатор её таблицы и сама ссылка. Таблица берётся до
		// TranslateExpression: тот присваивает своему параметру, и Path после него - текст SQL.
		Field.Parts.Insert("_RTRef", ReferenceTypeIdLiteral(SingleReferenceTarget(Path, Context), Context));
		Saved = Context.BooleanContext;
		Context.BooleanContext = False;
		Column = TranslateExpression(Path, Context);
		Context.BooleanContext = Saved;
		Field.Tag = BinaryLiteral("08", Context);
		Field.NullTest = Column;
		Field.Parts.Insert("_RRRef", Column);
	ElsIf Info = Undefined Then
		SqlType = "";
		Try
			SqlType = Upper(TrimAll(SqlTypeOfPath(Path, Context)));
		Except
			Return Undefined;
		EndTry;
		Role = "";
		Tag = "";
		If SqlType = "DATETIME2" Then
			Role = "_T";
			Tag = "04";
		ElsIf StrFind(SqlType, "CHAR") > 0 Then
			Role = "_S";
			Tag = "05";
		ElsIf StrFind(SqlType, "NUMERIC") > 0 Or StrFind(SqlType, "INT") > 0 Then
			Role = "_N";
			Tag = "03";
		ElsIf SqlType = "BINARY(1)" Then
			Role = "_L";
			Tag = "02";
		EndIf;
		If IsBlankString(Role) Or Role = Substitute.Role Then
			Return Undefined;
		EndIf;
		Saved = Context.BooleanContext;
		Context.BooleanContext = False;
		Column = TranslateExpression(Path, Context);
		Context.BooleanContext = Saved;
		Field.Tag = BinaryLiteral(Tag, Context);
		Field.NullTest = Column;
		Field.Parts.Insert(Role, Column);
	Else
		Return Undefined;
	EndIf;

	Span = New Structure;
	Span.Insert("Field", Field);
	Span.Insert("Substitute", Substitute);
	Span.Insert("Compared", Compared);
	Span.Insert("Operator", Operator);
	Span.Insert("Consumed", Last - Index + 1);
	Return Span;

EndFunction

// Литерал как часть составного значения: роль, тег вида, текст SQL и число токенов.
// Undefined - не литерал. ДАТАВРЕМЯ(...) занимает несколько токенов.
Function LiteralPartRole(Tokens, Position, Context, AllowReference = False)

	If Position > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Token = Tokens[Position];
	Result = New Structure("Role, Tag, Literal, Width, Parts", "", "", "", 1, New Map);
	// ЗНАЧЕНИЕ(...) справа от сравнения - ссылка известного типа: тег 0x08, идентификатор
	// её таблицы и сама ссылка (замер 9464). Только по запросу вызывающего: вторым
	// аргументом ЕСТЬNULL ссылка рядом со ссылкой - не смешение видов.
	If AllowReference And Token.Kind = "Name"
		And (Upper(Token.Value) = "VALUE" Or Upper(Token.Value) = Upper("Значение"))
		And Position + 3 <= Tokens.Count() - 1 And Tokens[Position + 1].Value = "("
		And Tokens[Position + 2].Kind = "Name" And Tokens[Position + 3].Value = ")" Then
		Inside = TrimAll(Tokens[Position + 2].Value);
		Origin = Undefined;
		Try
			Origin = TypeOrigin(Inside, True);
		Except
			Origin = Undefined;
		EndTry;
		If Origin = Undefined Then
			Return Undefined;
		EndIf;
		Result.Role = "_RRRef";
		Result.Tag = "08";
		Result.Literal = PredefinedValueLiteral(Inside, Context);
		Result.Width = 4;
		Result.Parts.Insert("_RTRef", ReferenceTypeIdLiteral(Origin.LogicalName, Context));
		Result.Parts.Insert("_RRRef", Result.Literal);
		Return Result;
	EndIf;
	If Token.Kind = "String" Then
		Result.Role = "_S";
		Result.Tag = "05";
		Result.Literal = StringLiteral(Token.Value, Context);
	ElsIf Token.Kind = "Number" Then
		Result.Role = "_N";
		Result.Tag = "03";
		Result.Literal = TrimAll(Token.Value);
	ElsIf Token.Kind = "Name" Then
		Word = Upper(Token.Value);
		If Word = "TRUE" Or Word = Upper("Истина") Then
			Result.Role = "_L";
			Result.Tag = "02";
			Result.Literal = BooleanLiteral(True, Context);
		ElsIf Word = "FALSE" Or Word = Upper("Ложь") Then
			Result.Role = "_L";
			Result.Tag = "02";
			Result.Literal = BooleanLiteral(False, Context);
		ElsIf (Word = "DATETIME" Or Word = Upper("ДатаВремя"))
			And Position + 1 <= Tokens.Count() - 1 And Tokens[Position + 1].Value = "(" Then
			Taken = 0;
			Arguments = CollectArguments(Tokens, Position, Taken);
			If Taken = 0 Then
				Return Undefined;
			EndIf;
			Try
				Result.Literal = DateLiteralFromArguments(Arguments, Context);
			Except
				Return Undefined;
			EndTry;
			Result.Role = "_T";
			Result.Tag = "04";
			Result.Width = Taken + 1;
		EndIf;
	EndIf;
	Return ?(IsBlankString(Result.Role), Undefined, Result);

EndFunction

Function IsNullLiteralComparisonSql(Span, Context)

	Field = Span.Field;
	Substitute = Span.Substitute;
	Compared = Span.Compared;
	Missing = "CASE WHEN " + Field.NullTest + " IS NULL THEN ";

	Tests = New Array;
	Tests.Add(Missing + BinaryLiteral(Substitute.Tag, Context) + " ELSE " + Field.Tag + " END = "
		+ BinaryLiteral(Compared.Tag, Context));
	For Each Suffix In PartRoleOrder() Do
		If Suffix = "_TYPE" Then
			Continue;
		EndIf;
		Own = Field.Parts.Get(Suffix);
		Expected = Compared.Parts.Get(Suffix);
		If Own = Undefined And Suffix <> Substitute.Role And Expected = Undefined Then
			Continue;
		EndIf;
		If Own = Undefined And Suffix = "_RTRef" And Field.Parts.Get("_RRRef") = Undefined Then
			// Ссылок в поле нет вовсе: тег 0x08 у него не бывает, и сравнение решает тег.
			// Составное поле с одним ссылочным типом сюда не доходит - его отсекает разбор.
			Continue;
		EndIf;
		Inner = ?(Suffix = Substitute.Role, Substitute.Literal, EmptyPartLiteral(Suffix, Context));
		If Substitute.Parts.Get(Suffix) <> Undefined Then
			Inner = Substitute.Parts.Get(Suffix);
		EndIf;
		Outer = ?(Own = Undefined, EmptyPartLiteral(Suffix, Context), Own);
		If Expected = Undefined Then
			Expected = ?(Suffix = Compared.Role, Compared.Literal, EmptyPartLiteral(Suffix, Context));
		EndIf;
		Tests.Add(Missing + Inner + " ELSE " + Outer + " END = " + Expected);
	EndDo;
	If Span.Operator = "<>" And Compared.Parts.Count() > 0 Then
		// Ссылку платформа сравнивает по нескольким частям; «<>» для неё не замерено, и
		// пишется отрицанием всей конъюнкции - части здесь не бывают NULL, ЕСТЬNULL их
		// заполнил, поэтому это то же самое.
		Return "(NOT (" + StrConcat(Tests, " AND ") + "))";
	EndIf;
	If Span.Operator = "<>" Then
		// Замерено (9406, 9416, 9422, 9428): «<>» платформа пишет не отрицанием всей
		// конъюнкции, а дизъюнкцией двух проверок - тег не тот или роль литерала не та.
		Role = Compared.Role;
		Own = Field.Parts.Get(Role);
		Inner = ?(Role = Substitute.Role, Substitute.Literal, EmptyPartLiteral(Role, Context));
		Outer = ?(Own = Undefined, EmptyPartLiteral(Role, Context), Own);
		Return "(" + Missing + BinaryLiteral(Substitute.Tag, Context) + " ELSE " + Field.Tag + " END <> "
			+ BinaryLiteral(Compared.Tag, Context) + " OR " + Missing + Inner + " ELSE " + Outer
			+ " END <> " + Compared.Literal + ")";
	EndIf;
	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

// Сравнение составного поля с примитивным литералом. Замерено (30202): платформа
// разворачивает его в конъюнкцию по всем частям - тег равен виду литерала, своя
// примитивная часть равна значению, остальные части равны пустым значениям своих видов.
// Отрицание - отрицание всей конъюнкции.
//
// Без этого сравнивалась колонка ссылки с датой или строкой, и MS SQL отвергал запрос:
// binary and datetime2 are incompatible.
// Упорядоченное сравнение составного поля: >, <, >=, <=, МЕЖДУ, ПОДОБНО. Замер 18.11.2026 (УХ, cmp_uh
// c1-c5, cmp2_probe p1-p4): платформа сравнивает тег первым - с литералом вида K
// (_TYPE > K OR _TYPE = K AND часть op литерал), для < и <= - _TYPE < K; МЕЖДУ - пара таких проверок;
// ПОДОБНО - тег 0x05, прочие части пустые, _S LIKE образец; с параметром-ссылкой K = 0x08, затем
// _RTRef против таблицы значения и _RRRef против параметра; два составных значения - теги, при обоих
// 0x01 равенство (только у >=, <=), при обоих 0x08 - таблица и ссылка. Неопределено - форма не замерена.
// МЕЖДУ - пара проверок «>=» и «<=» через И с любым операндом порядка (замер ocp4, q4c, q4d, 20-21.11.2026, УХ:
// `МЕЖДУ ЗНАЧЕНИЕ(…) И ЗНАЧЕНИЕ(…)`, `МЕЖДУ &А И &Б`). У составного «примитивы и один ссылочный тип» колонки
// таблицы нет: таблица - константа (_Table), и платформа сворачивает её сравнение (OrderedReferenceTest).
Function OrderedCompositeSpan(Tokens, Index, Resolved, Info, Context)

	Lookahead = Tokens[Index + 1];
	Column = New Map;
	Column.Insert("_TYPE", CompositeTagSql(Resolved, Info, Context));
	Names = New Map;
	Names.Insert("_RTRef", Info.RefTypeColumn);
	Names.Insert("_RRRef", Info.RefColumn);
	Names.Insert("_S", Info.StringColumn);
	Names.Insert("_N", Info.NumberColumn);
	Names.Insert("_T", Info.DateColumn);
	Names.Insert("_L", Info.BooleanColumn);
	For Each Pair In Names Do
		If Not IsBlankString(Pair.Value) Then
			Column.Insert(Pair.Key, FieldColumn(Resolved.Descriptor, Resolved.Alias, Pair.Value, Context));
		EndIf;
	EndDo;
	If IsBlankString(Info.RefTypeColumn) And Not IsBlankString(Info.RefColumn) Then
		Single = SingleReferenceTypeName(Resolved, Context);
		If Not IsBlankString(Single) Then
			Column.Insert("_Table", Single);
		EndIf;
	EndIf;
	Span = New Structure("Sql, Consumed", "", 0);

	If Lookahead.Kind = "Symbol" Then
		Operand = OrderedOperandTest(Column, Lookahead.Value, Tokens, Index + 2, Context);
		If Operand <> Undefined Then
			Span.Sql = Operand.Sql;
			Span.Consumed = 2 + Operand.Taken;
		EndIf;
	Else
		Word = Upper(Lookahead.Value);
		If Word = "BETWEEN" Or Word = Upper("Между") Then
			Low = OrderedOperandTest(Column, ">=", Tokens, Index + 2, Context);
			If Low <> Undefined And Index + 2 + Low.Taken < Tokens.Count() Then
				Joint = Upper(Tokens[Index + 2 + Low.Taken].Value);
				High = Undefined;
				If Joint = "AND" Or Joint = Upper("И") Then
					High = OrderedOperandTest(Column, "<=", Tokens, Index + 3 + Low.Taken, Context);
				EndIf;
				If High <> Undefined Then
					Span.Sql = "(" + Low.Sql + " AND " + High.Sql + ")";
					Span.Consumed = 3 + Low.Taken + High.Taken;
				EndIf;
			EndIf;
		ElsIf (Word = "LIKE" Or Word = Upper("Подобно")) And Tokens[Index + 2].Kind = "String" Then
			Escaped = Index + 3 < Tokens.Count()
				And (Upper(Tokens[Index + 3].Value) = "ESCAPE" Or Upper(Tokens[Index + 3].Value) = Upper("Спецсимвол"));
			StringColumn = Column.Get("_S");
			If Not Escaped And StringColumn <> Undefined Then
				Tests = New Array;
				Tests.Add(Column.Get("_TYPE") + " = " + BinaryLiteral("05", Context));
				For Each Suffix In PartRoleOrder() Do
					If Suffix = "_TYPE" Or Suffix = "_S" Or Column.Get(Suffix) = Undefined Then
						Continue;
					EndIf;
					Tests.Add(Column.Get(Suffix) + " = " + EmptyPartLiteral(Suffix, Context));
				EndDo;
				Tests.Add(StringColumn + " LIKE " + StringLiteral(Tokens[Index + 2].Value, Context));
				Span.Sql = "(" + StrConcat(Tests, " AND ") + ")";
				Span.Consumed = 3;
			EndIf;
		EndIf;
	EndIf;
	If IsBlankString(Span.Sql) Or Not RightIsBoundary(Tokens, Index + Span.Consumed - 1) Then
		Return Undefined;
	EndIf;
	Return Span;

EndFunction

// Составное против одного операнда порядка на позиции Position: литерал, параметр, НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(…), поле.
// Структура Sql, Taken (сколько токенов занимает операнд); Undefined - операнд не разобран.
Function OrderedOperandTest(Column, Op, Tokens, Position, Context)

	If Position > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Right = Tokens[Position];
	Result = New Structure("Sql, Taken", "", 1);
	Literal = PrimitiveLiteralAt(Tokens, Position, Context);
	If Literal <> Undefined Then
		Result.Sql = OrderedLiteralTest(Column, Op, Literal, Context, True);
		Result.Taken = Literal.Taken;
	ElsIf Right.Kind = "Parameter" Then
		Result.Sql = OrderedParameterTest(Column, Op, Right.Value, Context);
	ElsIf IsUndefinedLiteralToken(Right) Then
		// НЕОПРЕДЕЛЕНО - тег 0x01 без частей, и платформа сравнивает один тег тем же оператором
		// (замер agents\cmp c05-c07, УХ 19.11.2026: «> НЕОПРЕДЕЛЕНО» - _TYPE > 0x01, «>=», «<» и
		// НЕ «<=» так же; NULL из внешнего соединения отдельно не обрабатывается).
		Result.Sql = "(" + Column.Get("_TYPE") + " " + Op + " " + BinaryLiteral("01", Context) + ")";
	ElsIf Right.Kind = "Name" And (Upper(Right.Value) = "VALUE" Or Upper(Right.Value) = Upper("Значение"))
		And Position + 1 < Tokens.Count() And Tokens[Position + 1].Value = "(" Then
		// Ссылка ЗНАЧЕНИЕ(...): тег 0x08, затем таблица, затем ссылка (замер or1, 20.11.2026, УХ:
		// `Регистратор > ЗНАЧЕНИЕ(Документ.X.ПустаяСсылка)` - `_RecorderTRef > 0x000002D7 OR
		// _RecorderTRef = 0x000002D7 AND _RecorderRRef > 0x00…`).
		Close = MatchingParen(Tokens, Position + 1);
		If Close > 0 Then
			Inside = TrimAll(TokensText(Tokens, Position + 2, Close - 1));
			Origin = TypeOrigin(Inside, True);
			If Origin <> Undefined Then
				Test = OrderedReferenceTest(Column, Op, Origin.LogicalName, PredefinedValueLiteral(Inside, Context), Context);
				If Not IsBlankString(Test) Then
					Tag = Column.Get("_TYPE");
					Kind = BinaryLiteral("08", Context);
					Result.Sql = "((" + Tag + " " + OrderedDirection(Op) + " " + Kind + " OR " + Tag + " = " + Kind + " AND "
						+ Test + "))";
					Result.Taken = Close - Position + 1;
				EndIf;
			EndIf;
		EndIf;
	ElsIf Right.Kind = "Name" Then
		Result.Sql = OrderedCompositeTest(Column, Op, Right.Value, Context);
	EndIf;
	If IsBlankString(Result.Sql) Then
		Return Undefined;
	EndIf;
	Return Result;

EndFunction

// Таблица и ссылка значения-ссылки таблицы TableName против составного: ((_RTRef op' T OR _RTRef = T AND _RRRef op V)).
// У составного без колонки таблицы (примитивы и один ссылочный тип) таблица - константа, и платформа сворачивает её
// сравнение (замер ocp8, q4a, q4d, 20-21.11.2026, УХ): та же таблица - одна ссылка (`_RRRef > @P`), другая - постоянная
// истина или ложь по номерам таблиц (`1=1`, `1=0`). Пустая строка - нет ссылочной части.
Function OrderedReferenceTest(Column, Op, TableName, Value, Context)

	ReferenceColumn = Column.Get("_RRRef");
	If ReferenceColumn = Undefined Then
		Return "";
	EndIf;
	Direction = OrderedDirection(Op);
	TableColumn = Column.Get("_RTRef");
	If TableColumn <> Undefined Then
		Table = ReferenceTypeIdLiteral(TableName, Context);
		Return "((" + TableColumn + " " + Direction + " " + Table + " OR " + TableColumn + " = " + Table + " AND "
			+ ReferenceColumn + " " + Op + " " + Value + "))";
	EndIf;
	Own = Column.Get("_Table");
	If Own = Undefined Then
		Return "";
	EndIf;
	OwnId = TypeIdentifier(TableDescriptor(Own), Context);
	OtherId = TypeIdentifier(TableDescriptor(TableName), Context);
	If OwnId = OtherId Then
		Return ReferenceColumn + " " + Op + " " + Value;
	EndIf;
	Return ?((Direction = ">") = (OwnId > OtherId), "1=1", "1=0");

EndFunction

// Параметр без значения среди правых операндов сравнения на позиции Index (после знака или НЕ, оба конца МЕЖДУ),
// либо пустая строка. Параметр, переданный со значением НЕОПРЕДЕЛЕНО, сюда не считается.
Function UnvaluedComparisonParameter(Tokens, Index, Context)

	Position = Index + 1;
	If Position > Tokens.Count() - 1 Then
		Return "";
	EndIf;
	If Tokens[Position].Kind = "Name" And (Upper(Tokens[Position].Value) = "NOT" Or Upper(Tokens[Position].Value) = Upper("Не")) Then
		Position = Position + 1;
	EndIf;
	If Position > Tokens.Count() - 1 Then
		Return "";
	EndIf;
	Word = Upper(Tokens[Position].Value);
	Between = Word = "BETWEEN" Or Word = Upper("Между");
	Candidates = New Array;
	Candidates.Add(Position + 1);
	If Between Then
		Depth = 0;
		For Probe = Position + 1 To Min(Position + 60, Tokens.Count() - 1) Do
			Value = Tokens[Probe].Value;
			If Value = "(" Then
				Depth = Depth + 1;
			ElsIf Value = ")" Then
				Depth = Depth - 1;
			ElsIf Depth = 0 And Probe > Position + 1 And Tokens[Probe].Kind = "Name"
				And (Upper(Value) = "AND" Or Upper(Value) = Upper("И")) Then
				Candidates.Add(Probe + 1);
				Break;
			EndIf;
		EndDo;
	EndIf;
	Supplied = New Map;
	If Context.Options.Property("ParameterValues") And TypeOf(Context.Options.ParameterValues) = Type("Map") Then
		For Each Pair In Context.Options.ParameterValues Do
			Supplied.Insert(Upper(TrimAll(Pair.Key)), True);
		EndDo;
	EndIf;
	For Each Candidate In Candidates Do
		If Candidate <= Tokens.Count() - 1 And Tokens[Candidate].Kind = "Parameter"
			And Supplied.Get(Upper(TrimAll(Tokens[Candidate].Value))) = Undefined Then
			Return TrimAll(Tokens[Candidate].Value);
		EndIf;
	EndDo;
	Return "";

EndFunction

// Отказ сравнения составного с параметром без значения: SQL платформы зависит от вида значения.
Function UnvaluedComparisonRefusal(Field, Name)

	Return StrTemplate("%1 is of a composite type and is compared with parameter &%2, which has no value. The"
		+ " platform writes this comparison from the kind of the value - the type tag first, then the part of that"
		+ " kind, and for a reference its table as well - so the SQL cannot be built before the value is known."
		+ " Supply the value of &%2.", TrimAll(Field), Name);

EndFunction

Function MirroredOrderedSpan(Tokens, Index, Context)

	RightResolved = Undefined;
	Try
		RightResolved = ResolveField(Tokens[Index + 2].Value, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(RightResolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	RightInfo = CompositeInfo(RightResolved.Descriptor, RightResolved.FieldName);
	If RightInfo = Undefined Or Not HasCompositeTag(RightInfo) Then
		Return Undefined;
	EndIf;
	If Not RightIsBoundary(Tokens, Index + 2) Then
		Return Undefined;
	EndIf;
	Reverse = New Map;
	Reverse.Insert(">", "<");
	Reverse.Insert("<", ">");
	Reverse.Insert(">=", "<=");
	Reverse.Insert("<=", ">=");
	Op = Reverse.Get(Tokens[Index + 1].Value);
	If Op = Undefined Then
		Return Undefined;
	EndIf;
	Column = New Map;
	Column.Insert("_TYPE", CompositeTagSql(RightResolved, RightInfo, Context));
	Names = New Map;
	Names.Insert("_RTRef", RightInfo.RefTypeColumn);
	Names.Insert("_RRRef", RightInfo.RefColumn);
	Names.Insert("_S", RightInfo.StringColumn);
	Names.Insert("_N", RightInfo.NumberColumn);
	Names.Insert("_T", RightInfo.DateColumn);
	Names.Insert("_L", RightInfo.BooleanColumn);
	For Each Pair In Names Do
		If Not IsBlankString(Pair.Value) Then
			Column.Insert(Pair.Key, FieldColumn(RightResolved.Descriptor, RightResolved.Alias, Pair.Value, Context));
		EndIf;
	EndDo;
	Sql = OrderedPlainFieldTest(Column, Op, Tokens[Index].Value, Context);
	If IsBlankString(Sql) Then
		Return Undefined;
	EndIf;
	Return New Structure("Sql, Consumed", Sql, 3);

EndFunction

// Примитивный литерал в позиции: роль части, тег, текст SQL, число токенов. Неопределено - не литерал.
Function PrimitiveLiteralAt(Tokens, Position, Context)

	If Position >= Tokens.Count() Then
		Return Undefined;
	EndIf;
	Token = Tokens[Position];
	Result = New Structure("Role, Tag, Literal, Taken", "", "", "", 1);
	If Token.Kind = "String" Then
		Result.Role = "_S";
		Result.Tag = "05";
		Result.Literal = StringLiteral(Token.Value, Context);
	ElsIf Token.Kind = "Number" Then
		Result.Role = "_N";
		Result.Tag = "03";
		Result.Literal = TrimAll(Token.Value);
	ElsIf Token.Kind = "Name" Then
		Word = Upper(Token.Value);
		If Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь") Then
			Result.Role = "_L";
			Result.Tag = "02";
			Result.Literal = BooleanLiteral(Word = "TRUE" Or Word = Upper("Истина"), Context);
		ElsIf Word = "DATETIME" Or Word = Upper("ДатаВремя") Then
			Taken = 0;
			Arguments = CollectArguments(Tokens, Position, Taken);
			If Taken = 0 Then
				Return Undefined;
			EndIf;
			Result.Role = "_T";
			Result.Tag = "04";
			Result.Literal = DateLiteralFromArguments(Arguments, Context);
			Result.Taken = 1 + Taken;
		Else
			Return Undefined;
		EndIf;
	Else
		Return Undefined;
	EndIf;
	Return Result;

EndFunction

// Есть ли у составного значения тег типа: хранимый (_TYPE) или постоянный 0x08 у составного из одних
// ссылок, которое хранит таблицу и ссылку (Регистратор).
Function HasCompositeTag(Info)

	Return Not IsBlankString(Info.TypeColumn)
		Or (Not IsBlankString(Info.RefTypeColumn) And Not IsBlankString(Info.RefColumn));

EndFunction

// Тег типа составного значения: колонка _TYPE или константа 0x08 у составного без тега (замер or2,
// 20.11.2026, УХ: платформа пишет `0x08 < T._Fld_TYPE OR 0x08 = 0x08 AND …`).
Function CompositeTagSql(Resolved, Info, Context)

	If IsBlankString(Info.TypeColumn) Then
		Return BinaryLiteral("08", Context);
	EndIf;
	Return FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);

EndFunction

Function OrderedDirection(Op)
	Return ?(Op = ">" Or Op = ">=", ">", "<");
EndFunction

// (_TYPE op' K OR _TYPE = K AND часть op литерал). Части такого вида у поля нет - пустая строка,
// а с AbsentKind - сравнение одного тега.
Function OrderedLiteralTest(Column, Op, Literal, Context, AbsentKind = False)

	Part = Column.Get(Literal.Role);
	If Part = Undefined Then
		If Not AbsentKind Then
			Return "";
		EndIf;
		// Части этого вида у поля нет: платформа сравнивает один тег с тегом вида значения тем же
		// оператором (замер agents\cmp c01-c03, УХ 19.11.2026): «> ""» - _TYPE > 0x05, «<= ЛОЖЬ» -
		// _TYPE <= 0x02, «< &Число» - _TYPE < 0x03, МЕЖДУ 0 И 100 - _TYPE >= 0x03 AND _TYPE <= 0x03.
		// Так БСП листает регистры порциями: первая порция - «Поле > &Смещение» при Смещение = "".
		Return "(" + Column.Get("_TYPE") + " " + Op + " " + BinaryLiteral(Literal.Tag, Context) + ")";
	EndIf;
	Tag = Column.Get("_TYPE");
	Kind = BinaryLiteral(Literal.Tag, Context);
	Return "((" + Tag + " " + OrderedDirection(Op) + " " + Kind + " OR " + Tag + " = " + Kind + " AND " + Part + " "
		+ Op + " " + Literal.Literal + "))";

EndFunction

// С параметром - по виду его значения; без значения вид неизвестен, и это вход, которого нет.
Function OrderedParameterTest(Column, Op, Name, Context)

	Value = Context.Options.ParameterValues.Get(TrimAll(Name));
	If Value = Undefined Then
		Return "";
	EndIf;
	Parameter = TranslateValue("&" + TrimAll(Name), Context);
	Tag = Column.Get("_TYPE");
	Direction = OrderedDirection(Op);
	ValueType = TypeOf(Value);
	Literal = Undefined;
	If ValueType = Type("Number") Then
		Literal = New Structure("Role, Tag, Literal", "_N", "03", Parameter);
	ElsIf ValueType = Type("String") Then
		Literal = New Structure("Role, Tag, Literal", "_S", "05", Parameter);
	ElsIf ValueType = Type("Date") Then
		Literal = New Structure("Role, Tag, Literal", "_T", "04", Parameter);
	ElsIf ValueType = Type("Boolean") Then
		Literal = New Structure("Role, Tag, Literal", "_L", "02", Parameter);
	EndIf;
	If Literal <> Undefined Then
		Return OrderedLiteralTest(Column, Op, Literal, Context, True);
	EndIf;
	FullName = "";
	Try
		FullName = Value.Metadata().FullName();
	Except
		Return "";
	EndTry;
	Test = OrderedReferenceTest(Column, Op, FullName, Parameter, Context);
	If IsBlankString(Test) Then
		Return "";
	EndIf;
	Kind = BinaryLiteral("08", Context);
	Return "((" + Tag + " " + Direction + " " + Kind + " OR " + Tag + " = " + Kind + " AND " + Test + "))";

EndFunction

// Составное против обычного поля. Замер 18.11.2026 (УХ, cmp3_uh d4, d5): ссылку одного типа платформа
// сравнивает как составное с постоянными частями - тег 0x08, _RTRef её таблицы; примитивное поле - как
// литерал своего вида. Неопределено типа поля - пустая строка.
Function OrderedPlainFieldTest(Column, Op, Path, Context)

	Exact = True;
	FieldType = NumericFieldType(Path, Context, Exact);
	Kinds = New Array;
	If FieldType <> Undefined Then
		For Each Item In FieldType.Types() Do
			If Item <> Type("Null") Then
				Kinds.Add(Item);
			EndIf;
		EndDo;
	EndIf;
	If Kinds.Count() > 1 Then
		Return "";
	EndIf;
	Value = ValueExpression(Path, Context);
	Roles = New Map;
	Roles.Insert(Type("Number"), "_N:03");
	Roles.Insert(Type("String"), "_S:05");
	Roles.Insert(Type("Date"), "_T:04");
	Roles.Insert(Type("Boolean"), "_L:02");
	Role = ?(Kinds.Count() = 1, Roles.Get(Kinds[0]), Undefined);
	If Role <> Undefined Then
		Pair = StrSplit(Role, ":");
		Return OrderedLiteralTest(Column, Op, New Structure("Role, Tag, Literal", Pair[0], Pair[1], Value), Context);
	EndIf;
	Target = SingleReferenceTarget(Path, Context);
	If IsBlankString(Target) Then
		Return "";
	EndIf;
	Test = OrderedReferenceTest(Column, Op, Target, Value, Context);
	If IsBlankString(Test) Then
		Return "";
	EndIf;
	Tag = Column.Get("_TYPE");
	Kind = BinaryLiteral("08", Context);
	If Column.Get("_RTRef") = Undefined Then
		// Таблица - константа: платформа пишет и тег поля-ссылки (замер q4a: `_TYPE = 0x08 AND 0x08 = 0x08 AND 1=0`).
		Test = Kind + " = " + Kind + " AND " + Test;
	EndIf;
	Return "((" + Tag + " " + OrderedDirection(Op) + " " + Kind + " OR " + Tag + " = " + Kind + " AND " + Test + "))";

EndFunction

// Два составных значения: общими у них должны быть только НЕОПРЕДЕЛЕНО и ссылка - сравнение общих
// примитивных видов не замерено.
Function OrderedCompositeTest(Column, Op, Path, Context)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return "";
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Or Not HasCompositeTag(Info) Then
		Return OrderedPlainFieldTest(Column, Op, Path, Context);
	EndIf;
	Other = New Map;
	Names = New Map;
	Names.Insert("_RTRef", Info.RefTypeColumn);
	Names.Insert("_RRRef", Info.RefColumn);
	Names.Insert("_S", Info.StringColumn);
	Names.Insert("_N", Info.NumberColumn);
	Names.Insert("_T", Info.DateColumn);
	Names.Insert("_L", Info.BooleanColumn);
	For Each Pair In Names Do
		If Not IsBlankString(Pair.Value) Then
			If Column.Get(Pair.Key) <> Undefined And Pair.Key <> "_RTRef" And Pair.Key <> "_RRRef" Then
				Return "";
			EndIf;
			Other.Insert(Pair.Key, FieldColumn(Resolved.Descriptor, Resolved.Alias, Pair.Value, Context));
		EndIf;
	EndDo;
	Tag = Column.Get("_TYPE");
	OtherTag = CompositeTagSql(Resolved, Info, Context);
	Direction = OrderedDirection(Op);
	Tests = New Array;
	Tests.Add(Tag + " " + Direction + " " + OtherTag);
	If Op = ">=" Or Op = "<=" Then
		Tests.Add(Tag + " = " + BinaryLiteral("01", Context) + " AND " + OtherTag + " = " + BinaryLiteral("01", Context));
	EndIf;
	If Column.Get("_RRRef") <> Undefined And Other.Get("_RRRef") <> Undefined
		And Column.Get("_RTRef") <> Undefined And Other.Get("_RTRef") <> Undefined Then
		Kind = BinaryLiteral("08", Context);
		Tests.Add(Tag + " = " + Kind + " AND " + OtherTag + " = " + Kind + " AND ((" + Column.Get("_RTRef") + " "
			+ Direction + " " + Other.Get("_RTRef") + " OR " + Column.Get("_RTRef") + " = " + Other.Get("_RTRef")
			+ " AND " + Column.Get("_RRRef") + " " + Op + " " + Other.Get("_RRRef") + "))");
	EndIf;
	Return "((" + StrConcat(Tests, " OR ") + "))";

EndFunction

// Поле одного примитивного вида, сравниваемое с литералом другого вида: платформа решает сравнение до SQL
// (замер xk, 48 проб, и nd01-nd06, 22.11.2026, УХ): «=» - ложь, «<>» - истина, «<», «>», «<=», «>=» - по порядку
// видов булево < число < дата < строка, тот же, что у тегов составного. Так в ГДЕ, в условии виртуальной таблицы
// и в ВЫБОР. СУБД же приводит одно к другому: ошибка либо молча другой ответ. Голое имя условия виртуальной
// таблицы - поле регистра (BareFields). Справа может стоять и поле другого вида, в том числе ссылка - тег 0x08
// после всех примитивов (замер ff01-ff08, 22.11.2026, УХ: `Валюта < Период` - `1=0`, в ГДЕ и в ПО).
Function ForeignKindLiteralComparisonSpan(Tokens, Index, Context)

	If Index + 2 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Operator = Tokens[Index + 1];
	If Operator.Kind <> "Symbol" Or StrSplit("=,<>,<,>,<=,>=", ",").Find(Operator.Value) = Undefined Then
		Return Undefined;
	EndIf;
	Path = Tokens[Index].Value;
	If StrFind(Path, ".") = 0 Then
		If Not Context.Property("BareAlias") Or IsBlankString(Context.BareAlias) Or Context.BareDescriptor = Undefined
			Or Context.BareFields.Get(Upper(Path)) = Undefined Then
			Return Undefined;
		EndIf;
		Path = Context.BareAlias + "." + Path;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;

	Right = Tokens[Index + 2];
	Consumed = 3;
	Tag = "";
	OtherPath = "";
	If Right.Kind = "String" Then
		Tag = "05";
	ElsIf Right.Kind = "Number" Then
		Tag = "03";
	ElsIf Right.Kind = "Name" Then
		Word = Upper(Right.Value);
		If Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь") Then
			Tag = "02";
		ElsIf Word = "DATETIME" Or Word = Upper("ДатаВремя") Then
			Taken = 0;
			CollectArguments(Tokens, Index + 2, Taken);
			If Taken = 0 Then
				Return Undefined;
			EndIf;
			Tag = "04";
			Consumed = 3 + Taken;
		ElsIf StrFind(Right.Value, ".") > 0 Then
			OtherPath = Right.Value;
		ElsIf Context.Property("BareAlias") And Not IsBlankString(Context.BareAlias)
			And Context.BareDescriptor <> Undefined And Context.BareFields.Get(Word) <> Undefined Then
			OtherPath = Context.BareAlias + "." + Right.Value;
		EndIf;
	EndIf;
	If (IsBlankString(Tag) And IsBlankString(OtherPath)) Or Not RightIsBoundary(Tokens, Index + Consumed - 1) Then
		Return Undefined;
	EndIf;

	// Ссылка против литерала не замерена: ссылочный вид слева - только против поля.
	Own = ResolvedPathTag(Path, Context, Not IsBlankString(OtherPath));
	If IsBlankString(Own) Then
		Return Undefined;
	EndIf;
	If Not IsBlankString(OtherPath) Then
		Tag = ResolvedPathTag(OtherPath, Context, True);
	EndIf;
	If IsBlankString(Tag) Or Own = Tag Then
		Return Undefined;
	EndIf;

	If Operator.Value = "=" Then
		Holds = False;
	ElsIf Operator.Value = "<>" Then
		Holds = True;
	ElsIf Operator.Value = "<" Or Operator.Value = "<=" Then
		Holds = Own < Tag;
	Else
		Holds = Own > Tag;
	EndIf;
	Return New Structure("Sql, Consumed", ?(Holds, "(1 = 1)", "(1 = 0)"), Consumed);

EndFunction

// Сравнение, где хотя бы одна сторона - параметр известного примитивного вида, а другая - литерал, параметр или поле
// примитивного вида другого вида: платформа решает его до SQL по порядку видов, как ForeignKindLiteralComparisonSpan (замер
// sd1-sd11, 23.11.2026, УХ). Вид параметра - по значению, иначе по типу шапки; ссылка и неизвестный - Undefined.
Function ForeignKindParameterComparisonSpan(Tokens, Index, Context)

	// Дешёвый отбор по токенам: левый операнд - один токен или ДАТАВРЕМЯ(...), за ним оператор сравнения, и с одной из
	// сторон параметр.
	Token = Tokens[Index];
	LeftTaken = 1;
	If Token.Kind = "Name" And (Upper(Token.Value) = "DATETIME" Or Upper(Token.Value) = Upper("ДатаВремя")) Then
		LeftTaken = 0;
		CollectArguments(Tokens, Index, LeftTaken);
		If LeftTaken = 0 Then
			Return Undefined;
		EndIf;
		LeftTaken = LeftTaken + 1;
	EndIf;
	If Index + LeftTaken + 1 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Sign = Tokens[Index + LeftTaken];
	If Sign.Kind <> "Symbol" Or StrSplit("=,<>,<,>,<=,>=", ",").Find(Sign.Value) = Undefined Then
		Return Undefined;
	EndIf;
	If Token.Kind <> "Parameter" And Tokens[Index + LeftTaken + 1].Kind <> "Parameter" Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Left = ComparisonOperandTag(Tokens, Index, Context);
	If Left = Undefined Then
		Return Undefined;
	EndIf;
	OperatorIndex = Index + Left.Taken;
	If OperatorIndex + 1 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Operator = Tokens[OperatorIndex];
	If Operator.Kind <> "Symbol" Or StrSplit("=,<>,<,>,<=,>=", ",").Find(Operator.Value) = Undefined Then
		Return Undefined;
	EndIf;
	Right = ComparisonOperandTag(Tokens, OperatorIndex + 1, Context);
	If Right = Undefined Or Not (Left.Parameter Or Right.Parameter) Then
		Return Undefined;
	EndIf;
	Consumed = Left.Taken + 1 + Right.Taken;
	If Not RightIsBoundary(Tokens, Index + Consumed - 1) Or Left.Tag = Right.Tag Then
		Return Undefined;
	EndIf;
	If Operator.Value = "=" Then
		Holds = False;
	ElsIf Operator.Value = "<>" Then
		Holds = True;
	ElsIf Operator.Value = "<" Or Operator.Value = "<=" Then
		Holds = Left.Tag < Right.Tag;
	Else
		Holds = Left.Tag > Right.Tag;
	EndIf;
	Return New Structure("Sql, Consumed", ?(Holds, "(1 = 1)", "(1 = 0)"), Consumed);

EndFunction

// Тег вида операнда сравнения (02 булево, 03 число, 04 дата, 05 строка), число его токенов и признак параметра.
// Undefined - вид неизвестен или не примитивный.
Function ComparisonOperandTag(Tokens, Index, Context)

	If Index > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Token = Tokens[Index];
	Result = New Structure("Tag, Taken, Parameter", "", 1, False);
	If Token.Kind = "String" Then
		Result.Tag = "05";
	ElsIf Token.Kind = "Number" Then
		Result.Tag = "03";
	ElsIf Token.Kind = "Parameter" Then
		If IsOuterColumnStub(Token.Value, Context) Then
			Return Undefined;
		EndIf;
		SqlType = ParameterValueSqlType(Token.Value, Context);
		If IsBlankString(SqlType) Then
			SqlType = DeclaredParameterSqlType(Token.Value, Context);
		EndIf;
		SqlType = Upper(TrimAll(SqlType));
		If SqlType = "DATETIME2" Then
			Result.Tag = "04";
		ElsIf StrFind(SqlType, "CHAR") > 0 Then
			Result.Tag = "05";
		ElsIf StrStartsWith(SqlType, "NUMERIC") Then
			Result.Tag = "03";
		ElsIf SqlType = "BINARY(1)" Then
			Result.Tag = "02";
		Else
			Return Undefined;
		EndIf;
		Result.Parameter = True;
	ElsIf Token.Kind = "Name" Then
		Word = Upper(Token.Value);
		If Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь") Then
			Result.Tag = "02";
		ElsIf Word = "DATETIME" Or Word = Upper("ДатаВремя") Then
			Taken = 0;
			CollectArguments(Tokens, Index, Taken);
			If Taken = 0 Then
				Return Undefined;
			EndIf;
			Result.Tag = "04";
			Result.Taken = 1 + Taken;
		ElsIf StrFind(Token.Value, ".") > 0 Then
			// Ссылочный вид против параметра не замерен - только примитивы.
			Result.Tag = ResolvedPathTag(Token.Value, Context, False);
		ElsIf Context.Property("BareAlias") And Not IsBlankString(Context.BareAlias)
			And Context.BareDescriptor <> Undefined And Context.BareFields.Get(Word) <> Undefined Then
			Result.Tag = ResolvedPathTag(Context.BareAlias + "." + Token.Value, Context, False);
		EndIf;
	EndIf;
	If IsBlankString(Result.Tag) Then
		Return Undefined;
	EndIf;
	Return Result;

EndFunction

// Колонка производной таблицы - агрегат КОЛИЧЕСТВО: Истина - во всех ветвях, Ложь - только в части ветвей,
// Undefined - ни в одной или таблица не производная (тогда вид даёт объявленный тип).
Function DerivedCountColumn(Resolved)

	Descriptor = Resolved.Descriptor;
	If Not Descriptor.IsDerived Or Not Descriptor.Property("NumericSource") Or Descriptor.NumericSource = Undefined Then
		Return Undefined;
	EndIf;
	Definition = Descriptor.NumericSource.Definition;
	Index = -1;
	Wanted = Upper(TrimAll(Resolved.FieldName));
	For Position = 0 To Definition.Columns.Count() - 1 Do
		If Upper(TrimAll(Definition.Columns[Position].Alias)) = Wanted Then
			Index = Position;
			Break;
		EndIf;
	EndDo;
	If Index < 0 Then
		Return Undefined;
	EndIf;
	Counted = 0;
	Others = 0;
	For Each Operator In Definition.Operators Do
		If Index >= BranchFieldCount(Definition, Operator) Then
			Continue;
		EndIf;
		Tokens = Tokenize(TrimAll(ColumnFieldText(Definition, Operator, Index)));
		If Tokens.Count() > 2 And Tokens[0].Kind = "Name" And Tokens[1].Value = "("
			And (Upper(Tokens[0].Value) = "COUNT" Or Upper(Tokens[0].Value) = Upper("Количество"))
			And MatchingParen(Tokens, 1) = Tokens.Count() - 1 Then
			Counted = Counted + 1;
		Else
			Others = Others + 1;
		EndIf;
	EndDo;
	If Counted = 0 Then
		Return Undefined;
	EndIf;
	Return Others = 0;

EndFunction

// Тег вида значений поля по пути: 02-05 у поля одного примитивного типа, 08 у поля из одних ссылок (только если
// References), пустая строка - видов несколько, вид не выведен или путь не поле.
Function ResolvedPathTag(Path, Context, References)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return "";
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return "";
	EndIf;
	Counted = DerivedCountColumn(Resolved);
	If Counted <> Undefined Then
		// КОЛИЧЕСТВО - число, а модель объявляет такую колонку типом аргумента (rg03). Ветви не все
		// КОЛИЧЕСТВО - вид не выводится.
		Return ?(Counted, "03", "");
	EndIf;
	Description = ResolvedTypeDescription(Resolved);
	Kind = PrimitiveKindOfType(Description);
	If Kind <> Undefined Then
		Return ?(Kind.Property("Binary"), "", Kind.Tag);
	EndIf;
	If Not References Or Description = Undefined Then
		Return "";
	EndIf;
	Count = 0;
	For Each Item In Description.Types() Do
		If Item = Type("Null") Then
			Continue;
		EndIf;
		If Metadata.FindByType(Item) = Undefined Then
			Return "";
		EndIf;
		Count = Count + 1;
	EndDo;
	Return ?(Count > 0, "08", "");

EndFunction

Function PrimitiveLiteralComparisonSpan(Tokens, Index, Context)

	If Index + 2 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	If StrFind(Tokens[Index].Value, ".") = 0 Then
		Return Undefined;
	EndIf;
	Lookahead = Tokens[Index + 1];
	Word = Upper(Lookahead.Value);
	If Lookahead.Kind = "Name" And (Word = "NOT" Or Word = Upper("НЕ")) Then
		Word = Upper(Tokens[Index + 2].Value);
	EndIf;
	Ordering = (Lookahead.Kind = "Symbol"
			And (Lookahead.Value = ">" Or Lookahead.Value = "<" Or Lookahead.Value = ">=" Or Lookahead.Value = "<="))
		Or (Lookahead.Kind = "Name" And (Word = "LIKE" Or Word = Upper("Подобно")
			Or Word = "BETWEEN" Or Word = Upper("Между")));
	If Not Ordering And (Lookahead.Kind <> "Symbol" Or (Lookahead.Value <> "=" And Lookahead.Value <> "<>")) Then
		Return Undefined;
	EndIf;
	// Группа условий заменяет собой целое сравнение, поэтому оно обязано быть
	// самостоятельным: внутри арифметики её ставить нельзя.
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Tokens[Index].Value, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Ordering And Info <> Undefined And IsBlankString(Info.TypeColumn) And HasCompositeTag(Info) Then
		// Составное без тега (Регистратор: таблица и ссылка): платформа подставляет тег 0x08 и
		// сравнивает таблицу, потом ссылку (замер or1, or2, 20.11.2026, УХ). Прежде сравнивались
		// одни 16 байт ссылки - молча другой ответ.
		Ordered = OrderedCompositeSpan(Tokens, Index, Resolved, Info, Context);
		If Ordered <> Undefined Then
			Return Ordered;
		EndIf;
		Unvalued = UnvaluedComparisonParameter(Tokens, Index, Context);
		If Not IsBlankString(Unvalued) Then
			Raise UnvaluedComparisonRefusal(Tokens[Index].Value, Unvalued);
		EndIf;
		Raise StrTemplate(
			"%1 holds references of several types (the table and the reference, without a type tag) and is"
			+ " compared with >, <, BETWEEN or LIKE in a form whose SQL has not been measured. The platform"
			+ " compares the table first and the reference second; comparing the reference bytes alone gives"
			+ " another answer silently. Compare it with another such field, a reference field, VALUE(...) or"
			+ " a parameter that has a value.", Tokens[Index].Value);
	EndIf;
	If Info = Undefined Or IsBlankString(Info.TypeColumn) Then
		// Обычное поле слева, составное справа: платформа сравнивает теги первым (cmp3_uh d7) - то же,
		// что составное слева с обратным знаком. Прежде сравнивались одни ссылки, молча.
		If Ordering And Lookahead.Kind = "Symbol" And Tokens[Index + 2].Kind = "Name" Then
			Mirrored = MirroredOrderedSpan(Tokens, Index, Context);
			If Mirrored <> Undefined Then
				Return Mirrored;
			EndIf;
		EndIf;
		Return Undefined;
	EndIf;
	If Ordering Then
		Ordered = OrderedCompositeSpan(Tokens, Index, Resolved, Info, Context);
		If Ordered <> Undefined Then
			Return Ordered;
		EndIf;
		// Прежде сравнивалась колонка ссылки, и ответ был мусором либо ошибкой СУБД (УХ, polish27b
		// primcmp: «f > 0» - 1С 177, SQL 27; «f МЕЖДУ 1 И 100» - 68 и 0; «f ПОДОБНО "%а%"» - 49 и 0;
		// дата - «binary and datetime2 are incompatible»). Для строк своего вида платформа сравнивает
		// свою часть: «Составное > 0» по «_TYPE = 0x03 AND _N > 0» дало 5 = 5 (УХ, КонкурентныйЛист).
		// Что она отвечает у строк другого вида - Ложь или неизвестность, и не упорядочивает ли
		// она виды по тегу, - не выведено: в замере все 181 строка были числами.
		Unvalued = UnvaluedComparisonParameter(Tokens, Index, Context);
		If Not IsBlankString(Unvalued) Then
			Raise UnvaluedComparisonRefusal(Tokens[Index].Value, Unvalued);
		EndIf;
		Raise StrTemplate(
			"%1 is of a composite type and is compared with >, <, BETWEEN or LIKE against an operand whose"
			+ " platform SQL has not been measured here (an expression, a LIKE pattern that is not a string, a"
			+ " composite value without the table part of its references). Narrow the field first, as in"
			+ " CAST(%1 AS NUMBER(15, 2)) > 0.", TrimAll(Tokens[Index].Value));
	EndIf;

	Right = Tokens[Index + 2];
	Consumed = 3;
	Role = "";
	Tag = "";
	Literal = "";
	If Right.Kind = "String" Then
		Role = "_S";
		Tag = "05";
		Literal = StringLiteral(Right.Value, Context);
	ElsIf Right.Kind = "Number" Then
		Role = "_N";
		Tag = "03";
		Literal = TrimAll(Right.Value);
	ElsIf Right.Kind = "Name" Then
		Word = Upper(Right.Value);
		If Word = "TRUE" Or Word = Upper("Истина") Then
			Role = "_L";
			Tag = "02";
			Literal = BooleanLiteral(True, Context);
		ElsIf Word = "FALSE" Or Word = Upper("Ложь") Then
			Role = "_L";
			Tag = "02";
			Literal = BooleanLiteral(False, Context);
		ElsIf Word = "DATETIME" Or Word = Upper("ДатаВремя") Then
			Taken = 0;
			Arguments = CollectArguments(Tokens, Index + 2, Taken);
			If Taken = 0 Then
				Return Undefined;
			EndIf;
			Role = "_T";
			Tag = "04";
			Literal = DateLiteralFromArguments(Arguments, Context);
			// CollectArguments отдаёт расстояние до закрывающей скобки, саму скобку надо
			// прибавить: без этого она оставалась в потоке и ломала синтаксис.
			Consumed = 3 + Taken;
		EndIf;
	EndIf;
	If IsBlankString(Role) Then
		Return Undefined;
	EndIf;
	If Not RightIsBoundary(Tokens, Index + Consumed - 1) Then
		Return Undefined;
	EndIf;

	ValueColumn = "";
	If Role = "_S" Then
		ValueColumn = Info.StringColumn;
	ElsIf Role = "_N" Then
		ValueColumn = Info.NumberColumn;
	ElsIf Role = "_T" Then
		ValueColumn = Info.DateColumn;
	ElsIf Role = "_L" Then
		ValueColumn = Info.BooleanColumn;
	EndIf;
	If IsBlankString(ValueColumn) Then
		// Такого вида поле не держит вовсе. Что делает платформа - не замерено, поэтому
		// оставляем общий разбор, а не сворачиваем в ложь.
		Return Undefined;
	EndIf;

	Span = New Structure;
	Span.Insert("Resolved", Resolved);
	Span.Insert("Info", Info);
	Span.Insert("Operator", Lookahead.Value);
	Span.Insert("Role", Role);
	Span.Insert("Tag", Tag);
	Span.Insert("Literal", Literal);
	Span.Insert("ValueColumn", ValueColumn);
	Span.Insert("Consumed", Consumed);
	Return Span;

EndFunction

Function PrimitiveLiteralComparisonSql(Span, Context)

	If Span.Property("Sql") Then
		Return Span.Sql;
	EndIf;
	Resolved = Span.Resolved;
	Info = Span.Info;

	TagColumn = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);
	ValueColumn = FieldColumn(Resolved.Descriptor, Resolved.Alias, Span.ValueColumn, Context);

	If Span.Operator = "<>" Then
		// Замерено (30201): отрицание платформа пишет короче - тег не тот либо значение
		// не то. Проверок пустоты остальных частей там нет, и они не нужны: при согласованном
		// хранении тег уже решает, в какой части лежит значение.
		Determinants = CompositeDeterminants(Resolved.Descriptor, Resolved.Alias, Info, Context);
		RegisterDeterminedColumns(Context, TagColumn, Determinants);
		RegisterDeterminedColumns(Context, ValueColumn, Determinants);
		Return "(" + TagColumn + " <> " + BinaryLiteral(Span.Tag, Context)
			+ " OR " + ValueColumn + " <> " + Span.Literal + ")";
	EndIf;

	Tests = New Array;
	Tests.Add(TagColumn + " = " + BinaryLiteral(Span.Tag, Context));
	Tests.Add(ValueColumn + " = " + Span.Literal);

	// Остальные части обязаны быть пустыми: значение одно и лежит в своей части.
	Others = New Map;
	Others.Insert("_RTRef", Info.RefTypeColumn);
	Others.Insert("_RRRef", Info.RefColumn);
	Others.Insert("_S", Info.StringColumn);
	Others.Insert("_N", Info.NumberColumn);
	Others.Insert("_T", Info.DateColumn);
	Others.Insert("_L", Info.BooleanColumn);
	For Each Suffix In PartRoleOrder() Do
		If Suffix = "_TYPE" Or Suffix = Span.Role Then
			Continue;
		EndIf;
		Column = Others.Get(Suffix);
		If Column = Undefined Or IsBlankString(Column) Then
			Continue;
		EndIf;
		Tests.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, Column, Context)
			+ " = " + EmptyPartLiteral(Suffix, Context));
	EndDo;

	Determinants = CompositeDeterminants(Resolved.Descriptor, Resolved.Alias, Info, Context);
	For Each Test In Tests Do
		RegisterDeterminedColumns(Context, Left(Test, StrFind(Test, " = ") - 1), Determinants);
	EndDo;

	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

Function TypedReferenceComparisonSpan(Tokens, Index, Context)

	If Index + 2 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;

	Path = Tokens[Index].Value;
	If StrFind(Path, ".") = 0 Then
		Return Undefined;
	EndIf;

	Lookahead = Tokens[Index + 1];
	Operator = "";
	First = 0;
	If Lookahead.Kind = "Symbol" And (Lookahead.Value = "=" Or Lookahead.Value = "<>") Then
		Operator = Lookahead.Value;
		First = Index + 2;
	ElsIf Lookahead.Kind = "Name" And (Upper(Lookahead.Value) = "IN" Or Upper(Lookahead.Value) = Upper("В"))
		And Tokens[Index + 2].Kind = "Symbol" And Tokens[Index + 2].Value = "(" Then
		Operator = "IN";
		First = Index + 3;
	Else
		Return Undefined;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;

	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Or IsBlankString(Info.RefColumn) Then
		Return Undefined;
	EndIf;

	Values = New Array;
	Parameters = New Array;
	Position = First;
	While True Do
		Taken = ValueCallPath(Tokens, Position);
		If Taken = Undefined Then
			// Операнд не ЗНАЧЕНИЕ(...). Параметр здесь разбирается: тип его значения при
			// трансляции обычно неизвестен, но ссылкой он объявлен в шапке, и байт типа
			// прижать можно уже этим.
			Name = UntypedComparisonParameter(Tokens, Position, Values, Path, Context);
			If IsBlankString(Name) Then
				Return Undefined;
			EndIf;
			Parameters.Add(Name);
			Position = Position + 1;
		Else
			If Parameters.Count() > 0 Then
				WarnAboutUntypedCompositeComparison(Path, Context);
				Return Undefined;
			EndIf;
			Values.Add(Taken.Path);
			Position = Taken.Next;
		EndIf;
		If Operator <> "IN" Then
			Break;
		EndIf;
		If Position > Tokens.Count() - 1 Then
			Return Undefined;
		EndIf;
		If Tokens[Position].Kind = "Symbol" And Tokens[Position].Value = "," Then
			Position = Position + 1;
			Continue;
		EndIf;
		If Tokens[Position].Kind = "Symbol" And Tokens[Position].Value = ")" Then
			Position = Position + 1;
			Break;
		EndIf;
		Return Undefined;
	EndDo;

	Result = New Structure;
	Result.Insert("Resolved", Resolved);
	Result.Insert("Info", Info);
	Result.Insert("Operator", Operator);
	Result.Insert("Values", Values);
	Result.Insert("Parameters", Parameters);
	Result.Insert("Consumed", Position - Index);
	Return Result;

EndFunction

// ЗНАЧЕНИЕ(путь) начиная с позиции: отдаёт сам путь и позицию за закрывающей скобкой.
Function ValueCallPath(Tokens, Index)

	If Index + 2 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index].Value);
	If Word <> "VALUE" And Word <> Upper("Значение") Then
		Return Undefined;
	EndIf;
	If Tokens[Index + 1].Kind <> "Symbol" Or Tokens[Index + 1].Value <> "(" Then
		Return Undefined;
	EndIf;

	Pieces = New Array;
	Position = Index + 2;
	While Position <= Tokens.Count() - 1 Do
		Token = Tokens[Position];
		If Token.Kind = "Symbol" And Token.Value = ")" Then
			If Pieces.Count() = 0 Then
				Return Undefined;
			EndIf;
			Result = New Structure;
			Result.Insert("Path", StrConcat(Pieces, ""));
			Result.Insert("Next", Position + 1);
			Return Result;
		EndIf;
		If Token.Kind <> "Name" And Not (Token.Kind = "Symbol" And Token.Value = ".") Then
			Return Undefined;
		EndIf;
		Pieces.Add(Token.Value);
		Position = Position + 1;
	EndDo;
	Return Undefined;

EndFunction

// Ссылка, тип которой известен статически, против ЗНАЧЕНИЕ(...) и примитивных литералов: «=»,
// «<>», «В», «НЕ В». Значение другого типа платформа ссылке не приравнивает, а пустые ссылки
// разных таблиц и литерал ЛОЖЬ (0x00) совпадают с ней байтами:
// - поле одного типа: операнды другого типа выбрасываются, без операндов сравнение постоянно
//   (УХ, СверкаВГО: «РазделПланаСчетов В (ЗНАЧЕНИЕ(…), ЛОЖЬ)» - 1С 109, с 0x00 в списке 136, без
//   него 109; АналитикаУчетаПартий: «ссылка <> ""» - 1С 194, «binary <> N''» 0; Корректировки-
//   ЗначенийПоказателей32: поле СчетаБД против пустой ссылки СоответствияСчетов - у 1С Ложь);
// - переход через составную ссылку: тип у каждой ветви свой, сравнение идёт по частям
//   (УХ, ПланыСчетовБД: «СчетСсылка.Родитель = ЗНАЧЕНИЕ(ПланСчетов.МСФО.ПустаяСсылка)», все 447
//   счетов в плане 0x17 - 1С 0 строк, по одной ссылке 67).
// Постоянное значение держит колонку поля: группировка по такому выражению иначе отвергается СУБД.
// Undefined - сравнение не наше или менять в нём нечего.
Function KnownTypeReferenceComparisonSql(Tokens, Index, Context, Consumed)

	If Index + 2 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name"
		Or StrFind(Tokens[Index].Value, ".") = 0 Or Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Operator = "";
	Position = 0;
	Lookahead = Tokens[Index + 1];
	If Lookahead.Kind = "Symbol" And (Lookahead.Value = "=" Or Lookahead.Value = "<>") Then
		Operator = Lookahead.Value;
		Position = Index + 2;
	ElsIf Lookahead.Kind = "Name" And (Upper(Lookahead.Value) = "IN" Or Upper(Lookahead.Value) = Upper("В"))
		And Tokens[Index + 2].Value = "(" Then
		Operator = "IN";
		Position = Index + 3;
	ElsIf Lookahead.Kind = "Name" And (Upper(Lookahead.Value) = "NOT" Or Upper(Lookahead.Value) = Upper("НЕ"))
		And Index + 3 <= Tokens.Count() - 1
		And (Upper(Tokens[Index + 2].Value) = "IN" Or Upper(Tokens[Index + 2].Value) = Upper("В"))
		And Tokens[Index + 3].Value = "(" Then
		Operator = "NOT IN";
		Position = Index + 4;
	Else
		Return Undefined;
	EndIf;

	// Операнды: ЗНАЧЕНИЕ(...) - литерал и идентификатор таблицы, примитив - пустой идентификатор.
	Literals = New Array;
	TypeIds = New Array;
	Primitives = 0;
	While True Do
		Taken = ValueCallPath(Tokens, Position);
		If Taken <> Undefined Then
			TypeId = "";
			Try
				Descriptor = ValuePathDescriptor(Taken.Path);
				If Descriptor <> Undefined Then
					TypeId = BinaryLiteral(HexLiteral(TypeIdentifier(Descriptor, Context), 8), Context);
				EndIf;
			Except
				TypeId = "";
			EndTry;
			If IsBlankString(TypeId) Then
				// Системное перечисление или таблица без хранения: тега типа у неё нет.
				Return Undefined;
			EndIf;
			Literals.Add(PredefinedValueLiteral(Taken.Path, Context));
			TypeIds.Add(TypeId);
			Position = Taken.Next;
		Else
			Primitive = LiteralPartRole(Tokens, Position, Context);
			If Primitive = Undefined Then
				Return Undefined;
			EndIf;
			Literals.Add(Primitive.Literal);
			TypeIds.Add("");
			Primitives = Primitives + 1;
			Position = Position + Primitive.Width;
		EndIf;
		If Operator = "=" Or Operator = "<>" Then
			Break;
		EndIf;
		If Position > Tokens.Count() - 1 Then
			Return Undefined;
		EndIf;
		If Tokens[Position].Value = "," Then
			Position = Position + 1;
			Continue;
		EndIf;
		If Tokens[Position].Value <> ")" Then
			Return Undefined;
		EndIf;
		Position = Position + 1;
		Break;
	EndDo;
	Last = Position - 1;
	If Not RightIsBoundary(Tokens, Last) Then
		Return Undefined;
	EndIf;

	Path = TrimAll(Tokens[Index].Value);
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;

	If Not IsBlankString(Resolved.CompositeSegment) Then
		// Переход через составную ссылку: тип значения у каждой ветви свой.
		If Primitives > 0 Or Operator = "NOT IN" Then
			Return Undefined;
		EndIf;
		Target = NavigatedReferenceTarget(Path, Context);
		Own = "";
		Try
			Own = ?(IsBlankString(Target), "", ReferenceTypeIdLiteral(Target, Context));
		Except
			Own = "";
		EndTry;
		If Not IsBlankString(Own) And TypeIds.Count() = 1 And Own = TypeIds[0] Then
			// Тип у всех ветвей один и тот же: одной ссылки достаточно.
			Return Undefined;
		EndIf;
		Parts = NavigatedCompositeParts(Path, Context);
		If Parts = Undefined Or Parts.Get("_RTRef") = Undefined Or Parts.Get("_RRRef") = Undefined Then
			Return Undefined;
		EndIf;
		Tag = BinaryLiteral("08", Context);
		Alternatives = New Array;
		For Position = 0 To Literals.Count() - 1 Do
			If Operator = "<>" Then
				Alternatives.Add("(" + Parts.Get("_TYPE") + " <> " + Tag + " OR " + Parts.Get("_RTRef") + " <> "
					+ TypeIds[Position] + " OR " + Parts.Get("_RRRef") + " <> " + Literals[Position] + ")");
			Else
				Alternatives.Add("(" + Parts.Get("_TYPE") + " = " + Tag + " AND " + Parts.Get("_RTRef") + " = "
					+ TypeIds[Position] + " AND " + Parts.Get("_RRRef") + " = " + Literals[Position] + ")");
			EndIf;
		EndDo;
		Consumed = Last - Index + 1;
		Return ?(Alternatives.Count() = 1, Alternatives[0], "(" + StrConcat(Alternatives, " OR ") + ")");
	EndIf;

	If Resolved.Descriptor.IsDerived Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
		Return Undefined;
	EndIf;
	Target = SingleReferenceTarget(Path, Context);
	If IsBlankString(Target) Then
		Return Undefined;
	EndIf;
	Own = "";
	Try
		Own = ReferenceTypeIdLiteral(Target, Context);
	Except
		Return Undefined;
	EndTry;
	Kept = New Array;
	For Position = 0 To Literals.Count() - 1 Do
		If TypeIds[Position] = Own Then
			Kept.Add(Literals[Position]);
		EndIf;
	EndDo;
	If Kept.Count() = Literals.Count() Then
		Return Undefined;
	EndIf;

	Column = TranslateValue(Path, Context);
	Negated = Operator = "<>" Or Operator = "NOT IN";
	Consumed = Last - Index + 1;
	If Kept.Count() = 0 Then
		Return ?(Negated, "(" + Column + " IS NULL OR 1 = 1)", "(" + Column + " IS NULL AND 1 = 0)");
	EndIf;
	Return "(" + Column + ?(Negated, " NOT IN (", " IN (") + StrConcat(Kept, ", ") + "))";

EndFunction

// Собранное условие, либо Undefined - тогда вызывающий оставляет старый разбор.
Function TypedReferenceComparisonSql(Span, Context)

	Resolved = Span.Resolved;
	Info = Span.Info;
	RefColumn = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context);

	If Span.Parameters.Count() > 0 Then
		Return UntypedCompositeComparisonSql(Span, RefColumn, Context);
	EndIf;

	// Ссылки раскладываются по типам: в условии платформы каждый тип - своя группа.
	Groups = New Map;
	Order = New Array;
	For Each Path In Span.Values Do
		Descriptor = ValuePathDescriptor(Path);
		If Descriptor = Undefined Then
			// Системное перечисление или таблица без хранения: тега типа у неё нет.
			Return Undefined;
		EndIf;
		// Идентификатор типа сравнивается с двоичной колонкой, и литерал обязан быть
		// двоичным: на PostgreSQL сравнение bytea с числом не выполнится вовсе.
		TypeId = BinaryLiteral(HexLiteral(TypeIdentifier(Descriptor, Context), 8), Context);
		Literal = PredefinedValueLiteral(Path, Context);
		Bucket = Groups.Get(TypeId);
		If Bucket = Undefined Then
			Bucket = New Array;
			Groups.Insert(TypeId, Bucket);
			Order.Add(TypeId);
		EndIf;
		Bucket.Add(Literal);
	EndDo;

	ReferenceTag = BinaryLiteral("08", Context);
	If Span.Operator = "<>" Then
		Tests = New Array;
		If Not IsBlankString(Info.TypeColumn) Then
			Tests.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context)
				+ " <> " + ReferenceTag);
		EndIf;
		If Not IsBlankString(Info.RefTypeColumn) Then
			Tests.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context)
				+ " <> " + Order[0]);
		EndIf;
		Tests.Add(RefColumn + " <> " + Groups.Get(Order[0])[0]);
		Return "(" + StrConcat(Tests, " OR ") + ")";
	EndIf;

	Alternatives = New Array;
	For Each TypeId In Order Do
		Tests = New Array;
		If Not IsBlankString(Info.TypeColumn) Then
			Tests.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context)
				+ " = " + ReferenceTag);
		EndIf;
		If Not IsBlankString(Info.RefTypeColumn) Then
			Tests.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context)
				+ " = " + TypeId);
		EndIf;
		Literals = Groups.Get(TypeId);
		If Span.Operator = "IN" Then
			Tests.Add(RefColumn + " IN (" + StrConcat(Literals, ", ") + ")");
		Else
			Tests.Add(RefColumn + " = " + Literals[0]);
		EndIf;
		Alternatives.Add("(" + StrConcat(Tests, " AND ") + ")");
	EndDo;

	If Alternatives.Count() = 1 Then
		Return Alternatives[0];
	EndIf;
	Return "(" + StrConcat(Alternatives, " OR ") + ")";

EndFunction

// Имя параметра-операнда, по которому сравнение можно прижать к типу. Пустая
// строка означает «не наш операнд», и тогда разбор остаётся прежним: это выражение
// вместо параметра, смешанный список ЗНАЧЕНИЕ(...) с параметром, либо параметр, тип
// которого другое сравнение уже вывело как недвоичный - дату, число, строку.
Function UntypedComparisonParameter(Tokens, Position, Values, Path, Context)

	If Values.Count() > 0 Or Tokens[Position].Kind <> "Parameter" Then
		// Формы платформы для таких операндов не замерены, поэтому предупреждение.
		WarnAboutUntypedCompositeComparison(Path, Context);
		Return "";
	EndIf;

	Inferred = InferredParameterType(Tokens[Position].Value, Context);
	// Примитивное значение параметра известно - сравнение по части его вида строит
	// UntypedCompositeComparisonSql; общий разбор сравнивал колонку ссылки со строкой (УХ, polish27b
	// primref: «f = &P», P = 'Марка' - 1С 3, SQL 0).
	If Not IsBlankString(Inferred) And Inferred <> "BINARY(16)"
		And ParameterPrimitiveRole(Tokens[Position].Value, Context) = Undefined Then
		// Сравнение не ссылочное - прижимать байт ссылки нельзя.
		Return "";
	EndIf;

	Return Tokens[Position].Value;

EndFunction

// Сравнение составного поля с параметром. Колонки те же три, что и у сравнения со
// ЗНАЧЕНИЕ(...), и собираются той же формой - иначе отрицание и список разъехались бы
// между двумя путями одного сравнения.
//
// Байт типа прижимается всегда: в шапке параметр объявлен ссылкой, значит и условие
// обязано быть ссылочным. Без него условие ловит строки, где значения нет вовсе, -
// колонка ссылки у них такая же, как у пустой ссылки. Номер таблицы прижимается
// только когда значение параметра задано: тогда его тип известен при трансляции.
Function UntypedCompositeComparisonSql(Span, RefColumn, Context)

	Resolved = Span.Resolved;
	Info = Span.Info;
	ReferenceTag = BinaryLiteral("08", Context);

	// Значение параметра известно и оно примитив: сравнивается тег его вида и своя часть
	// поля, как у литерала (30202). Прежде тег прижимался к 0x08 - число 12 не находило ни
	// одной строки (сверка dbg33, УХ: 1С 8, SQL 0; «<>» - 173 против 181).
	If Span.Parameters.Count() = 1 Then
		Kind = ParameterPrimitiveRole(Span.Parameters[0], Context);
		If Kind <> Undefined Then
			Columns = New Map;
			Columns.Insert("_L", Info.BooleanColumn);
			Columns.Insert("_N", Info.NumberColumn);
			Columns.Insert("_T", Info.DateColumn);
			Columns.Insert("_S", Info.StringColumn);
			Own = Columns.Get(Kind.Role);
			Equals = Span.Operator <> "<>";
			If IsBlankString(Own) Or IsBlankString(Info.TypeColumn) Then
				// Такого вида поле не держит: равенства нет ни у одной строки.
				Return ?(Equals, "(1 = 0)", "(1 = 1)");
			EndIf;
			Tag = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);
			Part = FieldColumn(Resolved.Descriptor, Resolved.Alias, Own, Context);
			Operand = ParameterReference(Span.Parameters[0], Context);
			If Equals Then
				Return "(" + Tag + " = " + BinaryLiteral(Kind.Tag, Context) + " AND " + Part + " = " + Operand + ")";
			EndIf;
			Return "(" + Tag + " <> " + BinaryLiteral(Kind.Tag, Context) + " OR " + Part + " <> " + Operand + ")";
		EndIf;
	EndIf;
	For Each Name In Span.Parameters Do
		If ParameterPrimitiveRole(Name, Context) <> Undefined Then
			// Список с примитивным значением - прежний общий разбор.
			Return Undefined;
		EndIf;
	EndDo;

	TypeColumn = "";
	If Not IsBlankString(Info.TypeColumn) Then
		TypeColumn = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);
	EndIf;
	RefTypeColumn = "";
	If Not IsBlankString(Info.RefTypeColumn) Then
		RefTypeColumn = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context);
	EndIf;

	Operands = New Array;
	Comparisons = New Array;
	TypeIds = New Array;
	Unknown = False;
	For Each Name In Span.Parameters Do
		Items = Undefined;
		If Span.Operator = "IN" And Context.Options.SubstituteParameters Then
			Items = ParameterListItems(Context.Options.ParameterValues.Get(Name));
		EndIf;
		If Items <> Undefined Then
			AddListComparisons(Comparisons, TypeIds, Items, Resolved.FieldName, Name, Context);
			If IsBlankString(RefTypeColumn) Then
				Unknown = True;
			EndIf;
			Continue;
		EndIf;
		Operand = ParameterReference(Name, Context);
		Operands.Add(Operand);
		Comparisons.Add(" = " + Operand);
		TypeId = ParameterTypeIdLiteral(Name, Context);
		TypeIds.Add(TypeId);
		If IsBlankString(TypeId) Or IsBlankString(RefTypeColumn) Then
			Unknown = True;
		EndIf;
	EndDo;
	If Comparisons.Count() = 0 Then
		// Одни пустые списки: у платформы (0x00) = 0x01 (замер a3), у отрицания условия нет (a10).
		Return "(1 = 0)";
	EndIf;

	If Unknown Then
		WarnAboutUntypedCompositeTable(Resolved.FieldName, Context);
	EndIf;

	// Отрицание - отрицание всей тройки, а не каждой части: строка, у которой значения
	// нет вовсе, отличается от параметра, и 1С её отбирает.
	If Span.Operator = "<>" Then
		Tests = New Array;
		If Not IsBlankString(TypeColumn) Then
			Tests.Add(TypeColumn + " <> " + ReferenceTag);
		EndIf;
		If Not IsBlankString(RefTypeColumn) And Not IsBlankString(TypeIds[0]) Then
			Tests.Add(RefTypeColumn + " <> " + TypeIds[0]);
		EndIf;
		Tests.Add(RefColumn + " <> " + Operands[0]);
		Return "(" + StrConcat(Tests, " OR ") + ")";
	EndIf;

	Alternatives = New Array;
	For Index = 0 To Comparisons.Count() - 1 Do
		Tests = New Array;
		If Not IsBlankString(TypeColumn) Then
			Tests.Add(TypeColumn + " = " + ReferenceTag);
		EndIf;
		If Not IsBlankString(RefTypeColumn) And Not IsBlankString(TypeIds[Index]) Then
			Tests.Add(RefTypeColumn + " = " + TypeIds[Index]);
		EndIf;
		Tests.Add(RefColumn + Comparisons[Index]);
		Alternatives.Add("(" + StrConcat(Tests, " AND ") + ")");
	EndDo;

	If Alternatives.Count() = 1 Then
		Return Alternatives[0];
	EndIf;
	Return "(" + StrConcat(Alternatives, " OR ") + ")";

EndFunction

// Элементы параметра-списка в сравнении составного поля: по группе на таблицу - тег, номер таблицы
// и IN по ссылкам, как у платформы (замеры a1, a2, a7, a8: пустая ссылка в списке остаётся, таблица
// вне состава поля - тоже своя группа). Значение не ссылка - отказ: форма не замерена.
Procedure AddListComparisons(Comparisons, TypeIds, Items, Field, Name, Context)

	Groups = New Map;
	Order = New Array;
	For Each Item In Items Do
		Found = Undefined;
		Try
			Found = Metadata.FindByType(TypeOf(Item));
		Except
			Found = Undefined;
		EndTry;
		If Found = Undefined Then
			Raise StrTemplate("Field %1 is of a composite type and is compared with list parameter &%2,"
				+ " which holds a value of type %3. Only lists of references have a measured SQL form here;"
				+ " compare the field with the references separately.", Field, Name, String(TypeOf(Item)));
		EndIf;
		TypeId = ReferenceTypeIdLiteral(Found.FullName(), Context);
		Bucket = Groups.Get(TypeId);
		If Bucket = Undefined Then
			Bucket = New Array;
			Groups.Insert(TypeId, Bucket);
			Order.Add(TypeId);
		EndIf;
		Bucket.Add(ValueLiteral(Item, Context));
	EndDo;
	For Each TypeId In Order Do
		TypeIds.Add(TypeId);
		Comparisons.Add(" IN (" + StrConcat(Groups.Get(TypeId), ", ") + ")");
	EndDo;

EndProcedure

// Номер таблицы типа значения параметра. Пустая строка - значение не задано, и тип
// при трансляции неизвестен. Правило то же, что у ЗНАЧЕНИЕ(...): номер типа - числовой
// суффикс физического имени таблицы, и берётся он из структуры хранения.
// Вид примитивного значения параметра (роль части и тег) по переданному значению.
// Undefined - значения нет или оно не примитив.
Function ParameterPrimitiveRole(Name, Context)

	If Not Context.Options.Property("ParameterValues")
		Or TypeOf(Context.Options.ParameterValues) <> Type("Map") Then
		Return Undefined;
	EndIf;
	Value = Context.Options.ParameterValues.Get(Name);
	Kind = TypeOf(Value);
	If Kind = Type("Number") Then
		Return New Structure("Role, Tag", "_N", "03");
	ElsIf Kind = Type("String") Then
		Return New Structure("Role, Tag", "_S", "05");
	ElsIf Kind = Type("Date") Then
		Return New Structure("Role, Tag", "_T", "04");
	ElsIf Kind = Type("Boolean") Then
		Return New Structure("Role, Tag", "_L", "02");
	EndIf;
	Return Undefined;

EndFunction

Function ParameterTypeIdLiteral(Name, Context)

	If Not Context.Options.Property("SubstituteParameters")
		Or Not Context.Options.SubstituteParameters Then
		Return "";
	EndIf;
	If Not Context.Options.Property("ParameterValues")
		Or TypeOf(Context.Options.ParameterValues) <> Type("Map") Then
		Return "";
	EndIf;
	Value = Context.Options.ParameterValues.Get(Name);
	If Value = Undefined Then
		Return "";
	EndIf;

	// У значения непредметного типа объекта метаданных нет, у структуры с уникальным
	// идентификатором - тоже: в обоих случаях тип остаётся неизвестным.
	Descriptor = Undefined;
	Try
		Target = Metadata.FindByType(TypeOf(Value));
		If Target <> Undefined Then
			Descriptor = TableDescriptor(Target.FullName());
		EndIf;
	Except
		Return "";
	EndTry;
	If Descriptor = Undefined Then
		Return "";
	EndIf;

	Try
		Return BinaryLiteral(HexLiteral(TypeIdentifier(Descriptor, Context), 8), Context);
	Except
		Return "";
	EndTry;

EndFunction

// Байт типа прижат, номер таблицы - нет. Молчать нельзя: у поля, где все значения суть
// пустые ссылки разных типов, одного байта не хватает, и условие остаётся шире, чем
// в 1С. Так устроены виды доступа БСП.
Procedure WarnAboutUntypedCompositeTable(Field, Context)

	Message = StrTemplate(
		"Field %1 is of a composite type and is compared with a parameter. The condition"
		+ " pins the type byte, so it no longer matches rows that hold no value at all,"
		+ " but the table of the reference type is only known once a value is supplied."
		+ " Where every stored value is an empty reference - access kinds, for instance -"
		+ " the reference column carries no information and the condition stays wider than"
		+ " the platform's. Supply the parameter value, compare with VALUE(...), or add a"
		+ " VALUETYPE(...) condition.", Field);
	AddOnce(Context.Warnings, Message);

EndProcedure

// Таблица, на которую ссылается ЗНАЧЕНИЕ(Коллекция.Имя.Значение).
Function ValuePathDescriptor(Path)

	Parts = StrSplit(TrimAll(Path), ".", False);
	If Parts.Count() < 2 Then
		Return Undefined;
	EndIf;
	// Точка маршрута - своя таблица типа (TypeOrigin).
	If Parts.Count() = 4 And IsRoutePointSegment(Parts[2]) Then
		Return StorageStructure().Get(RoutePointsKey(Parts[1]));
	EndIf;
	Return TableDescriptor(Parts[0] + "." + Parts[1]);

EndFunction

// Имя поля для сообщения - как оно написано в запросе: голое имя из условия виртуальной таблицы
// дополнено псевдонимом таблицы подзапроса (QualifyBareCompositeFields), а в тексте запроса его нет.
Function WrittenFieldName(Field, Context)

	Prefix = Context.BareAlias + ".";
	If Not IsBlankString(Context.BareAlias) And StrStartsWith(Upper(Field), Upper(Prefix)) Then
		Return Mid(Field, StrLen(Prefix) + 1);
	EndIf;
	Return Field;

EndFunction

Procedure WarnAboutUntypedCompositeComparison(Field, Context)

	Message = StrTemplate(
		"Field %1 is of a composite type, and the value it is compared with has a type"
		+ " that is only known at run time. The comparison is emitted on the reference"
		+ " column alone, so it also matches values of the other types stored in that"
		+ " field - an empty reference in particular. Compare with VALUE(...) instead,"
		+ " or add a VALUETYPE(...) condition.", WrittenFieldName(Field, Context));
	For Each Existing In Context.Warnings Do
		If Existing = Message Then
			Return;
		EndIf;
	EndDo;
	Context.Warnings.Add(Message);

EndProcedure

Function IsUndefinedLiteralToken(Token)

	If Token.Kind <> "Name" Then
		Return False;
	EndIf;
	Word = Upper(TrimAll(Token.Value));
	Return Word = "UNDEFINED" Or Word = Upper("Неопределено");

EndFunction

// Образец «поле = НЕОПРЕДЕЛЕНО» в потоке токенов. Путь к полю - один токен, поэтому
// образец ровно из трёх; порядок операндов любой. Undefined, если это не он.
// Последний сегмент пути - именно имя предопределённых данных, а не что-то, внутри чего
// это слово встретилось. Проверяются оба языка платформы, как в PredefinedColumn.
Function IsPredefinedNameSegment(Segment)

	Normalized = Upper(TrimAll(Segment));
	Return Normalized = "PREDEFINEDDATANAME" Or Normalized = Upper("ИмяПредопределенныхДанных");

EndFunction

// Таблица, в которой объявлены предопределённые элементы, и колонка со ссылкой на них.
// У пути из двух сегментов это сама таблица источника и её первичный ключ, у пути из трёх -
// то, на что указывает ссылочное поле, и само это поле.
Function PredefinedNameOwner(Path, Context)

	OwnerPath = PresentationSourcePath(Path, Context);
	Owner = Undefined;
	Try
		Owner = ResolveField(OwnerPath, Context);
	Except
		Raise StrTemplate(
			"The predefined data name is read from %1, and that field could not be resolved: the"
			+ " name lives in the metadata of the table the field points to.", OwnerPath);
	EndTry;

	Target = ReferenceTargetOf(Owner);
	If Target = Undefined Then
		Raise StrTemplate(
			"The predefined data name needs a single reference type at %1: predefined items are"
			+ " declared per table, and a composite reference has no single list of them. Cast the"
			+ " field to one table first.", OwnerPath);
	EndIf;

	Result = New Structure;
	Result.Insert("Path", OwnerPath);
	Result.Insert("Target", Target);
	Return Result;

EndFunction

// Пары «имя предопределённого элемента -> литерал его ссылки». Имена объявлены в
// метаданных, значения даёт Eval - тот же способ, которым разрешается ЗНАЧЕНИЕ(...).
// Кеш на запрос обязателен: у MetadataObjectIDs имён почти пять сотен, а поле встречается
// в запросе не один раз.
Function PredefinedNamePairs(Target, Context)

	FullName = Target.FullName();
	If Not Context.Options.Property("PredefinedNameCache")
		Or Context.Options.PredefinedNameCache = Undefined Then
		Context.Options.Insert("PredefinedNameCache", New Map);
	EndIf;

	Cached = Context.Options.PredefinedNameCache.Get(Upper(FullName));
	If Cached = Undefined Then
		Cached = BuildPredefinedNamePairs(Target, FullName, Context);
		Context.Options.PredefinedNameCache.Insert(Upper(FullName), Cached);
	EndIf;

	// Предупреждения выдаются на каждом обращении, а не только при наполнении кеша:
	// AddOnce всё равно не повторит их в одном запросе.
	If Cached.Skipped.Count() > 0 Then
		AddOnce(Context.Warnings, StrTemplate(
			"Predefined item(s) of %1 are declared in the metadata but could not be resolved to a"
			+ " reference, so they get no branch and rows holding them show an empty name: %2.",
			FullName, StrConcat(Cached.Skipped, ", ")));
	EndIf;
	If Cached.Pairs.Count() > 100 Then
		AddOnce(Context.Warnings, StrTemplate(
			"The predefined data name of %1 expands to %2 CASE branches. Such an expression cannot"
			+ " use an index: filtering by it scans the table. Compare with a literal name, or"
			+ " filter by the reference, wherever the query allows it.",
			FullName, Format(Cached.Pairs.Count(), "NG=0; NZ=0")));
	EndIf;

	Return Cached.Pairs;

EndFunction

Function BuildPredefinedNamePairs(Target, FullName, Context)

	Names = Undefined;
	Try
		Names = Target.GetPredefinedNames();
	Except
		Raise StrTemplate(
			"Metadata object %1 does not report its predefined names, so the name cannot be"
			+ " rebuilt from the identifier stored in the database: %2", FullName, ErrorDescription());
	EndTry;

	Collection = ManagerCollection(StrSplit(FullName, ".", False)[0]);
	If Collection = Undefined Then
		Raise StrTemplate("%1 is a metadata kind that keeps no predefined data.", FullName);
	EndIf;

	Pairs = New Array;
	Skipped = New Array;
	For Each Name In Names Do
		Literal = Undefined;
		Try
			Literal = ReferenceLiteral(Eval(Collection + "." + Target.Name + "." + Name), Context);
		Except
			// Элемент объявлен, но значения у него в этой ИБ нет. Ветвь пропускается, а
			// перевод продолжается: падать из-за одного имени нельзя.
			Skipped.Add(Name);
			Continue;
		EndTry;
		Pair = New Structure;
		Pair.Insert("Name", Name);
		Pair.Insert("Literal", Literal);
		Pairs.Add(Pair);
	EndDo;

	Result = New Structure;
	Result.Insert("Pairs", Pairs);
	Result.Insert("Skipped", Skipped);
	Return Result;

EndFunction

// Имя предопределённых данных как выражение. Сравнения со ссылкой перечисляются ветвями:
// пары берутся из метаданных на этапе трансляции, поэтому СУБД остаётся только выбрать.
// У непредопределённого элемента ни одна ветвь не совпадает, и ИНАЧЕ даёт пустую строку -
// то же, что показывает платформа.
Function PredefinedNameExpression(Path, Context)

	Owner = PredefinedNameOwner(Path, Context);
	Pairs = PredefinedNamePairs(Owner.Target, Context);
	Empty = TextLiteral("", Context);

	Column = FieldReference(Owner.Path, Context);
	Branches = New Array;
	Branches.Add("CASE");
	For Each Pair In Pairs Do
		Branches.Add("WHEN " + Column + " = " + Pair.Literal
			+ " THEN " + TextLiteral(Pair.Name, Context));
	EndDo;
	// Элемент с идентификатором предопределённого, которого нет в метаданных (удалён из
	// конфигурации, пришёл обменом), платформа называет "#" и этим идентификатором (полная
	// сверка ERP WE, HardwareDrivers: 93 строки из 98). Идентификатор лежит в порядке байт
	// ссылки: группы uuid - байты 12-15, 10-11, 8-9, 0-1, 2-7.
	IdColumn = Undefined;
	Try
		IdColumn = PredefinedIdColumn(Path, Context);
	Except
		IdColumn = Undefined;
	EndTry;
	If IdColumn <> Undefined Then
		If Context.Options.Dialect = "PostgreSQL" Then
			Hex = "encode(" + IdColumn + ", 'hex')";
			Piece = "substr(" + Hex + ", %1, %2)";
			Glue = " || ";
		Else
			Hex = "LOWER(CONVERT(varchar(32), " + IdColumn + ", 2))";
			Piece = "SUBSTRING(" + Hex + ", %1, %2)";
			Glue = " + ";
		EndIf;
		Uuid = StrTemplate(Piece, 25, 8) + Glue + "'-'" + Glue + StrTemplate(Piece, 21, 4) + Glue + "'-'"
			+ Glue + StrTemplate(Piece, 17, 4) + Glue + "'-'" + Glue + StrTemplate(Piece, 1, 4)
			+ Glue + "'-'" + Glue + StrTemplate(Piece, 5, 12);
		Branches.Add("WHEN " + IdColumn + " <> " + BinaryLiteral("00000000000000000000000000000000", Context)
			+ " THEN " + TextLiteral("#", Context) + Glue + Uuid);
	ElsIf Pairs.Count() = 0 Then
		Return Empty;
	EndIf;
	// У строки внешнего соединения без пары имени нет вовсе - NULL, а не пустая строка
	// (сверка battery27: ЕСТЬ NULL - 1С 25, SQL 0). Признак строки - идентификатор предопределённого целевой строки:
	// у пустой ссылки (Родитель элемента верхнего уровня) строки нет, а сама ссылка не NULL (замер pd1).
	Branches.Add("WHEN " + ?(IdColumn = Undefined, Column, IdColumn) + " IS NOT NULL THEN " + Empty + " END");
	Return "(" + StrConcat(Branches, " ") + ")";

EndFunction

// «путь.ИмяПредопределенныхДанных = "литерал"». Образец ловится до общего разбора, как и
// сравнение с НЕОПРЕДЕЛЕНО: имя разрешается в ссылку при трансляции, и вместо ВЫБОРа из
// сотен ветвей выходит одно сравнение по первичному ключу.
Function PredefinedNameComparisonSpan(Tokens, Index)

	If Index + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;

	Operator = Tokens[Index + 1];
	If Operator.Kind <> "Symbol" Or (Operator.Value <> "=" And Operator.Value <> "<>") Then
		Return Undefined;
	EndIf;

	Left = Tokens[Index];
	Right = Tokens[Index + 2];
	If Left.Kind = "Name" And Right.Kind = "String" Then
		Path = Left.Value;
		Literal = Right.Value;
	ElsIf Left.Kind = "String" And Right.Kind = "Name" Then
		Path = Right.Value;
		Literal = Left.Value;
	Else
		Return Undefined;
	EndIf;

	Parts = StrSplit(Path, ".", False);
	If Parts.Count() < 2 Or Not IsPredefinedNameSegment(Parts[Parts.Count() - 1]) Then
		Return Undefined;
	EndIf;

	Result = New Structure;
	Result.Insert("Path", Path);
	// Лексер держит строку вместе с кавычками, а удвоенная кавычка внутри означает одну.
	Result.Insert("Name", StrReplace(Mid(Literal, 2, StrLen(Literal) - 2), """""", """"));
	Result.Insert("Equals", Operator.Value = "=");
	Return Result;

EndFunction

Function PredefinedNameComparisonSql(Span, Context)

	// Пустое имя значит «элемент не предопределён», и в хранении этому есть прямое
	// соответствие: нулевой идентификатор, как у признака Предопределенный.
	If IsBlankString(Span.Name) Then
		Return "(" + PredefinedIdColumn(Span.Path, Context)
			+ ?(Span.Equals, " = ", " <> ")
			+ BinaryLiteral("00000000000000000000000000000000", Context) + ")";
	EndIf;

	Owner = PredefinedNameOwner(Span.Path, Context);
	Literal = "";
	Try
		Literal = PredefinedValueLiteral(Owner.Target.FullName() + "." + Span.Name, Context);
	Except
		Raise StrTemplate(
			"%1 declares no predefined item named ""%2"", so the filter cannot be translated. The"
			+ " name is resolved against the metadata of the connected infobase: check the"
			+ " spelling, or that the item still exists in this configuration.",
			Owner.Target.FullName(), Span.Name);
	EndTry;

	Return "(" + FieldReference(Owner.Path, Context)
		+ ?(Span.Equals, " = ", " <> ") + Literal + ")";

EndFunction

// Колонка идентификатора предопределённых данных по пути к полю: берётся так же, как её
// берёт признак Предопределенный, поэтому навигация через точку работает и здесь.
Function PredefinedIdColumn(Path, Context)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Raise StrTemplate("Field %1 could not be resolved.", Path);
	EndTry;

	If Not IsBlankString(Resolved.CompositeSegment) Then
		Raise StrTemplate(
			"The predefined data name is read through a composite reference (%1), and the"
			+ " identifier column differs per table behind it.", Path);
	EndIf;

	Stored = PredefinedColumn(Resolved.Descriptor);
	If Stored = Undefined Then
		Raise StrTemplate("Table %1 keeps no predefined data identifier.",
			Resolved.Descriptor.LogicalName);
	EndIf;

	Return FieldColumn(Resolved.Descriptor, Resolved.Alias, Stored, Context);

EndFunction

// Сравнение с НЕОПРЕДЕЛЕНО там, где слева не путь к полю: результат ВЫБОРа, результат
// функции, параметр. Отдаёт готовый хвост условия или Undefined - тогда разбор идёт
// прежним путём и литерал станет NULL.
//
// «что-то = NULL» в T-SQL не ложь, а неизвестность: такое условие не выполняется
// никогда. Там, где у выражения нет набора типов, значение отсутствует именно как
// NULL - и в 1С, и в SQL, - поэтому IS NULL выражает сравнение, а не подменяет его.
//
// Образец узкий намеренно. Слева допускаются КОНЕЦ, закрывающая скобка и параметр:
// проверено по корпусам, других форм там практически нет. Имя без точки оставлено
// прежнему разбору - это колонка временной таблицы, и решение её не трогать принято
// в UndefinedComparisonSpan. Обратная форма «НЕОПРЕДЕЛЕНО = выражение» не разбирается:
// правый операнд ещё не выведен, приписать хвост некуда.
// ЕСТЬNULL(…), ВЫБОР … КОНЕЦ или скобка, сравниваемые с НЕОПРЕДЕЛЕНО. Если у выражения
// есть части составного значения (хотя бы одна ветвь составная), сравнение идёт по тегу,
// как у поля (UndefinedComparisonSql): хранимое НЕОПРЕДЕЛЕНО - тег 0x01, а не NULL, и
// через IS NULL оно терялось (сверка battery25: ЕСТЬNULL(f, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО -
// 1С 37 строк, SQL 0). Без частей - Undefined, и остаётся прежний путь UndefinedNullnessSpan.
// Index - первый токен выражения; Consumed - сколько токенов разобрано вместе с литералом.
Function UndefinedExpressionComparisonSql(Tokens, Index, Context, Consumed)

	Token = Tokens[Index];
	Word = ?(Token.Kind = "Name", Upper(Token.Value), "");
	Finish = Undefined;
	Inner = Index;
	If (Word = "ISNULL" Or Word = Upper("ЕстьNULL")) And Index + 1 < Tokens.Count()
		And Tokens[Index + 1].Value = "(" Then
		Finish = MatchingParen(Tokens, Index + 1);
	ElsIf Token.Kind = "Symbol" And Token.Value = "(" Then
		Finish = MatchingParen(Tokens, Index);
		Inner = Index + 1;
	ElsIf Word = "CASE" Or Word = Upper("Выбор") Then
		Depth = 0;
		Parens = 0;
		For Position = Index To Tokens.Count() - 1 Do
			Value = Tokens[Position].Value;
			If Value = "(" Then
				Parens = Parens + 1;
			ElsIf Value = ")" Then
				Parens = Parens - 1;
			ElsIf Parens = 0 And Tokens[Position].Kind = "Name" Then
				Keyword = Upper(Value);
				If Keyword = "CASE" Or Keyword = Upper("Выбор") Then
					Depth = Depth + 1;
				ElsIf Keyword = "END" Or Keyword = Upper("Конец") Then
					Depth = Depth - 1;
					If Depth = 0 Then
						Finish = Position;
						Break;
					EndIf;
				EndIf;
			EndIf;
		EndDo;
	EndIf;
	If Finish = Undefined Or Finish < Index + 1 Or Finish + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Operator = Tokens[Finish + 1];
	If Operator.Kind <> "Symbol" Or (Operator.Value <> "=" And Operator.Value <> "<>")
		Or Not IsUndefinedLiteralToken(Tokens[Finish + 2]) Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Finish + 2) Then
		Return Undefined;
	EndIf;

	Text = TokensText(Tokens, Inner, ?(Inner > Index, Finish - 1, Finish));
	Parts = Undefined;
	// Части - значения, а не условия: в логическом контексте ГДЕ ссылка обернулась бы в
	// «= 0x01», и СУБД не приняла бы текст (короткие ворота 26, запрос 12002).
	Saved = Context.BooleanContext;
	Context.BooleanContext = False;
	Try
		Parts = BranchedCompositeParts(Text, Context);
	Except
		Parts = Undefined;
	EndTry;
	Context.BooleanContext = Saved;
	If Parts = Undefined Or Parts.Get("_TYPE") = Undefined Then
		Return Undefined;
	EndIf;

	Consumed = Finish + 3 - Index;
	If Operator.Value = "<>" Then
		Return "(" + Parts.Get("_TYPE") + " <> " + BinaryLiteral("01", Context) + ")";
	EndIf;
	Tests = New Array;
	Tests.Add(Parts.Get("_TYPE") + " = " + BinaryLiteral("01", Context));
	If Parts.Get("_RTRef") <> Undefined Then
		Tests.Add(Parts.Get("_RTRef") + " = " + BinaryLiteral("00000000", Context));
	EndIf;
	If Parts.Get("_RRRef") <> Undefined Then
		Tests.Add(Parts.Get("_RRRef") + " = " + BinaryLiteral("00000000000000000000000000000000", Context));
	EndIf;
	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

// ЕСТЬNULL(поле, НЕОПРЕДЕЛЕНО) <> литерал. У платформы при NULL в поле значение - НЕОПРЕДЕЛЕНО,
// и оно не равно литералу: условие истинно. Литерал НЕОПРЕДЕЛЕНО без набора типов становится
// NULL, а «NULL <> x» в T-SQL - неизвестность, и строка терялась (полная сверка ERP WE:
// InventoryRecount.ReflectStockDistribution - 1С 574, SQL 0). Справа - только литерал: у поля
// справа NULL дал бы неизвестность и у платформы. «=» не трогается: там ложь с обеих сторон.
Function IsNullUndefinedInequalitySql(Tokens, Index, Context, Consumed)

	If Index + 7 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index].Value);
	If Word <> "ISNULL" And Word <> Upper("ЕстьNULL") Then
		Return Undefined;
	EndIf;
	If Tokens[Index + 1].Value <> "(" Or Tokens[Index + 2].Kind <> "Name"
		Or Tokens[Index + 3].Value <> "," Or Not IsUndefinedLiteralToken(Tokens[Index + 4])
		Or Tokens[Index + 5].Value <> ")" Then
		Return Undefined;
	EndIf;
	If Tokens[Index + 6].Kind <> "Symbol" Or Tokens[Index + 6].Value <> "<>" Then
		Return Undefined;
	EndIf;
	Compared = LiteralPartRole(Tokens, Index + 7, Context, True);
	If Compared = Undefined Then
		Return Undefined;
	EndIf;
	Last = Index + 7 + Compared.Width - 1;
	If Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Last) Then
		Return Undefined;
	EndIf;

	Path = TrimAll(Tokens[Index + 2].Value);
	Literal = TokensText(Tokens, Index + 7, Last);
	Saved = Context.BooleanContext;
	Context.BooleanContext = True;
	Try
		Sql = TranslateExpression("(" + Path + " IS NULL OR " + Path + " <> " + Literal + ")", Context);
	Except
		Context.BooleanContext = Saved;
		Return Undefined;
	EndTry;
	Context.BooleanContext = Saved;
	Consumed = Last - Index + 1;
	Return Sql;

EndFunction

// ЕСТЬNULL(поле, НЕОПРЕДЕЛЕНО) = литерал при NULL в поле - ложь, а не неизвестность: в списке
// выборки у 1С Ложь, у «ISNULL(поле, NULL) = x» - NULL (УХ, ИзменениеУсловийДоговораАренды:
// ПринятКУчетуУУ). Различать условие и значение здесь нечем и незачем: условие в списке выборки
// переводится тем же булевым контекстом, а под НЕ в ГДЕ неизвестность теряла бы строку так же.
Function IsNullUndefinedEqualitySql(Tokens, Index, Context, Consumed)

	If Index + 7 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index].Value);
	If Word <> "ISNULL" And Word <> Upper("ЕстьNULL") Then
		Return Undefined;
	EndIf;
	If Tokens[Index + 1].Value <> "(" Or Tokens[Index + 2].Kind <> "Name"
		Or Tokens[Index + 3].Value <> "," Or Not IsUndefinedLiteralToken(Tokens[Index + 4])
		Or Tokens[Index + 5].Value <> ")" Then
		Return Undefined;
	EndIf;
	If Tokens[Index + 6].Kind <> "Symbol" Or Tokens[Index + 6].Value <> "=" Then
		Return Undefined;
	EndIf;
	Compared = LiteralPartRole(Tokens, Index + 7, Context, True);
	If Compared = Undefined Then
		Return Undefined;
	EndIf;
	Last = Index + 7 + Compared.Width - 1;
	If Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Last) Then
		Return Undefined;
	EndIf;

	Path = TrimAll(Tokens[Index + 2].Value);
	Literal = TokensText(Tokens, Index + 7, Last);
	Saved = Context.BooleanContext;
	Context.BooleanContext = True;
	Try
		Sql = TranslateExpression("(NOT " + Path + " IS NULL AND " + Path + " = " + Literal + ")", Context);
	Except
		Context.BooleanContext = Saved;
		Return Undefined;
	EndTry;
	Context.BooleanContext = Saved;
	Consumed = Last - Index + 1;
	Return Sql;

EndFunction

// `V.X ЕСТЬ [НЕ] NULL` над составной колонкой подзапроса или временной таблицы - по тегу
// _TYPE, а не по базовой колонке. У колонки-заглушки базовая колонка в ветви НЕОПРЕДЕЛЕНО
// NULL, а само значение не NULL: тег там 0x01 (сверка 13.11.2026, ERP WE: `ВЫБОР КОГДА
// T.ПометкаУдаления ТОГДА T.Ссылка ИНАЧЕ НЕОПРЕДЕЛЕНО КОНЕЦ` у Currencies - 1С 4 × Ложь,
// SQL 4 × Истина). Тег NULL ровно тогда, когда NULL всё значение. Undefined - не наш случай.
Function DerivedCompositeNullnessSql(Tokens, Index, Context, Consumed)

	If Index + 2 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name"
		Or StrFind(Tokens[Index].Value, ".") = 0 Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index + 1].Value);
	If Tokens[Index + 1].Kind <> "Name" Or (Word <> "IS" And Word <> Upper("Есть")) Then
		Return Undefined;
	EndIf;
	Last = Index + 2;
	Negated = False;
	Word = Upper(Tokens[Last].Value);
	If Word = "NOT" Or Word = Upper("Не") Then
		Negated = True;
		Last = Last + 1;
		If Last > Tokens.Count() - 1 Then
			Return Undefined;
		EndIf;
	EndIf;
	If Upper(Tokens[Last].Value) <> "NULL" Then
		Return Undefined;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(TrimAll(Tokens[Index].Value), Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Or Resolved.Descriptor = Undefined
		Or Not Resolved.Descriptor.IsDerived Then
		Return Undefined;
	EndIf;
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Or IsBlankString(Info.TypeColumn) Then
		Return Undefined;
	EndIf;

	Consumed = Last - Index + 1;
	Return FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context)
		+ ?(Negated, " IS NOT NULL", " IS NULL");

EndFunction

// `ВЫБОР … КОНЕЦ ЕСТЬ [НЕ] NULL`, в том числе в скобках, - по ветвям. Значение NULL ровно
// тогда, когда NULL выбранная ветвь, а без ИНАЧЕ - у непокрытой строки. Замерено (9702,
// 9708, УХ): платформа проверяет на NULL все части значения сразу, тег и значение, а у
// ветви НЕОПРЕДЕЛЕНО тег 0x01 и пустое значение своего вида - не NULL. Одной колонкой CASE
// этого не выразить: НЕОПРЕДЕЛЕНО в ней NULL, и проверка отвечала Истина там, где у 1С Ложь;
// ветви разных видов СУБД к тому же приводит к одному типу и падает (ошибка 245). Поэтому
// NULL-ность считается по каждой ветви отдельно (ArmNullnessSql), и CASE отдаёт 1 или 0.
// Undefined - не наш случай, разбор идёт прежним путём.
Function CaseNullnessSql(Tokens, Index, Context, Consumed)

	Token = Tokens[Index];
	Inner = Index;
	Finish = Undefined;
	If Token.Kind = "Symbol" And Token.Value = "(" Then
		Finish = MatchingParen(Tokens, Index);
		Inner = Index + 1;
		If Inner >= Finish Or Tokens[Inner].Kind <> "Name" Then
			Return Undefined;
		EndIf;
		Word = Upper(Tokens[Inner].Value);
		If Word <> "CASE" And Word <> Upper("Выбор") Then
			Return Undefined;
		EndIf;
	ElsIf Token.Kind = "Name" And (Upper(Token.Value) = "CASE" Or Upper(Token.Value) = Upper("Выбор")) Then
		Finish = CaseEndIndex(Tokens, Index);
	EndIf;
	If Finish = Undefined Or Finish + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;

	Word = Upper(Tokens[Finish + 1].Value);
	If Tokens[Finish + 1].Kind <> "Name" Or (Word <> "IS" And Word <> Upper("Есть")) Then
		Return Undefined;
	EndIf;
	Last = Finish + 2;
	Negated = False;
	Word = Upper(Tokens[Last].Value);
	If Word = "NOT" Or Word = Upper("Не") Then
		Negated = True;
		Last = Last + 1;
		If Last > Tokens.Count() - 1 Then
			Return Undefined;
		EndIf;
	EndIf;
	If Upper(Tokens[Last].Value) <> "NULL" Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Last) Then
		Return Undefined;
	EndIf;

	Text = TokensText(Tokens, Inner, ?(Inner > Index, Finish - 1, Finish));
	Branches = ExpressionBranches(Text);
	If Branches = Undefined Or Branches.Kind <> "CASE" Then
		Return Undefined;
	EndIf;

	Nullness = BranchesNullnessSql(Branches, Context);
	Consumed = Last - Index + 1;
	If Nullness = "1" Or Nullness = "0" Then
		Return ?((Nullness = "1") <> Negated, "(1 = 1)", "(1 = 0)");
	EndIf;
	Return "(" + Nullness + ?(Negated, " = 0)", " = 1)");

EndFunction

// NULL-ность значения ветвей: SQL-выражение со значением 1 или 0, либо сама константа
// "1" или "0", когда ответ от строки не зависит. Условия переводятся, только если ответ
// от них зависит: перевод условия регистрирует соединения.
Function BranchesNullnessSql(Branches, Context)

	Values = New Array;
	For Each Arm In Branches.Arms Do
		Values.Add(ArmNullnessSql(Arm, Context));
	EndDo;

	If Branches.Kind = "ISNULL" Then
		// ЕСТЬNULL(a, b) - NULL, только когда NULL и a, и b.
		If Values[0] = "0" Or Values[1] = "0" Then
			Return "0";
		ElsIf Values[0] = "1" Then
			Return Values[1];
		ElsIf Values[1] = "1" Then
			Return Values[0];
		EndIf;
		Return "(CASE WHEN " + Values[0] + " = 1 THEN " + Values[1] + " ELSE 0 END)";
	EndIf;

	// Без ИНАЧЕ непокрытая строка получает NULL.
	Values.Add(?(IsBlankString(Branches.Else_), "1", ArmNullnessSql(Branches.Else_, Context)));
	Same = True;
	For Each Value In Values Do
		If Value <> Values[0] Then
			Same = False;
			Break;
		EndIf;
	EndDo;
	If Same And (Values[0] = "1" Or Values[0] = "0") Then
		Return Values[0];
	EndIf;

	Pieces = New Array;
	Pieces.Add("(CASE");
	Saved = Context.BooleanContext;
	For Index = 0 To Branches.Conditions.Count() - 1 Do
		Condition = Branches.Conditions[Index];
		Context.BooleanContext = True;
		Pieces.Add("WHEN " + TranslateExpression(Condition, Context) + " THEN " + Values[Index]);
		Context.BooleanContext = Saved;
	EndDo;
	Pieces.Add("ELSE " + Values[Values.UBound()] + " END)");
	Return StrConcat(Pieces, " ");

EndFunction

// NULL-ность одной ветви: "1", "0" или SQL-выражение со значением 1 или 0. НЕОПРЕДЕЛЕНО и
// литерал - значения, не NULL. Вложенный ВЫБОР и ЕСТЬNULL разбираются по своим ветвям: в
// них НЕОПРЕДЕЛЕНО бывает так же. Остальное проверяется своим «ЕСТЬ NULL» - там колонка
// временной таблицы проверяется по тегу (DerivedCompositeNullnessSql).
Function ArmNullnessSql(Arm, Context)

	Trimmed = TrimAll(Arm);
	If Upper(Trimmed) = "NULL" Then
		Return "1";
	EndIf;
	If IsUndefinedLiteralText(Trimmed) Or IsLiteralExpression(Trimmed) Then
		Return "0";
	EndIf;

	Tokens = Tokenize(Trimmed);
	If Tokens.Count() > 2 And Tokens[0].Value = "(" And MatchingParen(Tokens, 0) = Tokens.Count() - 1 Then
		Return ArmNullnessSql(TokensText(Tokens, 1, Tokens.Count() - 2), Context);
	EndIf;
	Branches = ExpressionBranches(Trimmed);
	If Branches <> Undefined Then
		Return BranchesNullnessSql(Branches, Context);
	EndIf;

	Probe = ?(Tokens.Count() = 1, Trimmed, "(" + Trimmed + ")") + " IS NULL";
	Saved = Context.BooleanContext;
	Context.BooleanContext = True;
	Try
		Sql = TranslateExpression(Probe, Context);
	Except
		Context.BooleanContext = Saved;
		Raise;
	EndTry;
	Context.BooleanContext = Saved;
	Return "(CASE WHEN " + Sql + " THEN 1 ELSE 0 END)";

EndFunction

// Индекс КОНЕЦ, закрывающего ВЫБОР на позиции Index, либо Undefined.
Function CaseEndIndex(Tokens, Index)

	Depth = 0;
	Parens = 0;
	For Position = Index To Tokens.Count() - 1 Do
		Value = Tokens[Position].Value;
		If Value = "(" Then
			Parens = Parens + 1;
		ElsIf Value = ")" Then
			Parens = Parens - 1;
		ElsIf Parens = 0 And Tokens[Position].Kind = "Name" Then
			Keyword = Upper(Value);
			If Keyword = "CASE" Or Keyword = Upper("Выбор") Then
				Depth = Depth + 1;
			ElsIf Keyword = "END" Or Keyword = Upper("Конец") Then
				Depth = Depth - 1;
				If Depth = 0 Then
					Return Position;
				EndIf;
			EndIf;
		EndIf;
	EndDo;
	Return Undefined;

EndFunction

// Сравнение `ВЫБОР … КОНЕЦ`, у которого ветви разных видов (строка рядом с числом, ссылка
// рядом с примитивом, НЕОПРЕДЕЛЕНО рядом с ними), с литералом, полем или параметром одного
// примитивного вида. Одной колонкой CASE такое значение не выражается: СУБД приводит ветви к
// одному типу и падает (ошибка 245) или молча подменяет значение. Платформа сравнивает по
// частям (замерено на ERP WE, метки в скобках):
// - «=» и ПОДОБНО - тег и каждая часть с частью значения, недостающие роли значения пустые:
//   `_TYPE = 0x03 AND _N = 0 AND _S = ''` (9771, 9772), у ПОДОБНО часть вида - LIKE (9863);
// - «<>» - тег или часть вида значения: `_TYPE <> 0x03 OR _N <> 0` (9777, 9778);
// - порядок - сначала тег, потом часть: `_TYPE > 0x03 OR _TYPE = 0x03 AND _N >= 0` (9834,
//   9852-9855), МЕЖДУ - два таких сравнения через И (9864);
// - В - по видам литералов списка: `_TYPE = 0x03 AND _N IN (0) OR _TYPE = 0x05 AND _S IN
//   ('USD')` (9860, 9861), НЕ В - отрицание (9862);
// - ВЫБОР справа - то же с зеркальным знаком (9856-9859, 9866).
// Остальное не замерено - отказ. Undefined - ветви одного вида или вид не выводится: прежний
// путь. Index - ВЫБОР или операнд перед ним; Consumed - сколько токенов разобрано.
Function MixedCaseComparisonSql(Tokens, Index, Context, Consumed)

	Token = Tokens[Index];
	IsCase = Token.Kind = "Name" And (Upper(Token.Value) = "CASE" Or Upper(Token.Value) = Upper("Выбор"));
	Operand = Undefined;
	PathParts = Undefined;
	If Not IsCase Then
		PathParts = CompositePathParts(Tokens, Index, Context);
	EndIf;
	If PathParts <> Undefined Then
		// Составное поле с примитивными частями (хранимое, колонка временной таблицы или
		// подзапроса): по частям, как ВЫБОР, - платформа так же сравнивает части подзапроса
		// (9869, 9870). «=» и «<>» здесь не разбираются: их ведёт PrimitiveLiteralComparisonSpan.
		Finish = Index;
		Mirrored = False;
		Negated = Upper(Tokens[Index + 1].Value) = "NOT" Or Upper(Tokens[Index + 1].Value) = Upper("Не");
		OperatorIndex = Index + ?(Negated, 2, 1);
		Operator = Upper(Tokens[OperatorIndex].Value);
	ElsIf IsCase Then
		CaseIndex = Index;
		Finish = CaseEndIndex(Tokens, CaseIndex);
		If Finish = Undefined Then
			Return Undefined;
		EndIf;
		Before = ?(Index > 0, Upper(Tokens[Index - 1].Value), "");
		After = ?(Finish < Tokens.Count() - 1, Upper(Tokens[Finish + 1].Value), "");
		Mirrored = Index > 0 And Tokens[Index - 1].Kind = "Symbol" And IsComparison(Before);
		Negated = (After = "NOT" Or After = Upper("Не")) And Finish + 2 <= Tokens.Count() - 1;
		OperatorIndex = Finish + ?(Negated, 2, 1);
		Operator = ?(OperatorIndex <= Tokens.Count() - 1, Upper(Tokens[OperatorIndex].Value), "");
		Compared = Not Negated And IsComparison(After) And After <> "IS" And After <> Upper("Есть")
			Or Negated And (Operator = "IN" Or Operator = Upper("В")
				Or Operator = "LIKE" Or Operator = Upper("Подобно"));
		If Not Mirrored And Not Compared Then
			Return Undefined;
		EndIf;
	Else
		// Операнд перед ВЫБОРом: литерал, поле или параметр, знак сравнения, ВЫБОР.
		Operand = MixedOperand(Tokens, Index, Context);
		If Operand = Undefined Or Operand.Last + 2 > Tokens.Count() - 1 Then
			Return Undefined;
		EndIf;
		OperatorIndex = Operand.Last + 1;
		Operator = Tokens[OperatorIndex].Value;
		CaseIndex = OperatorIndex + 1;
		Word = Upper(Tokens[CaseIndex].Value);
		If Tokens[OperatorIndex].Kind <> "Symbol" Or MirroredOperator(Operator) = ""
			Or Tokens[CaseIndex].Kind <> "Name" Or (Word <> "CASE" And Word <> Upper("Выбор")) Then
			Return Undefined;
		EndIf;
		Finish = CaseEndIndex(Tokens, CaseIndex);
		If Finish = Undefined Or Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Finish) Then
			Return Undefined;
		EndIf;
		Operator = MirroredOperator(Operator);
		Mirrored = False;
		Negated = False;
	EndIf;

	Text = TokensText(Tokens, ?(PathParts = Undefined, CaseIndex, Index), Finish);
	Kinds = New Map;
	If PathParts <> Undefined Then
		// Без разбора по частям поле читалось колонкой ссылки - прежний путь, без отказа.
		Kinds.Insert("_U", True);
	ElsIf Not CaseArmKinds(Text, Context, Kinds) Or Kinds.Count() < 2 Then
		Return Undefined;
	EndIf;
	// НЕОПРЕДЕЛЕНО рядом с одним видом отказа не требует: в одной колонке CASE оно NULL, и
	// приведения видов, на котором падает СУБД, там нет. По частям такое сравнение идёт,
	// только когда справа литерал или поле: у «<>» одна колонка теряла строки НЕОПРЕДЕЛЕНО
	// (`ТОГДА 1 ИНАЧЕ НЕОПРЕДЕЛЕНО КОНЕЦ <> 0` - 1С 4 строки, SQL 1; платформа, 9841, условие
	// свернула в истину). Иначе - прежний путь, без отказа.
	Soft = Kinds.Count() - ?(Kinds.Get("_U") = Undefined, 0, 1) < 2;

	Refusal = "CASE returns values of different kinds - " + TrimAll(Text) + " - and is compared"
		+ " here in a form whose platform SQL has not been measured. The platform compares such a"
		+ " value part by part, a single SQL CASE converts its branches to one type and fails or"
		+ " returns another value. Compare it with a literal, a field or a parameter of one"
		+ " primitive kind, or make the branches one kind.";
	If Mirrored Then
		// Операнд перед ВЫБОРом разбирается на своей позиции; раз дошли сюда, он не такой.
		If Soft Then
			Return Undefined;
		EndIf;
		Raise Refusal;
	EndIf;

	// Правые операнды: один, два у МЕЖДУ, список у В.
	Operands = New Array;
	Last = Undefined;
	Escape = "";
	If Operand <> Undefined Then
		Operands.Add(Operand);
		Last = Finish;
	ElsIf Operator = "IN" Or Operator = Upper("В") Then
		Position = OperatorIndex + 1;
		If Position <= Tokens.Count() - 1 And Tokens[Position].Value = "(" Then
			Closing = MatchingParen(Tokens, Position);
			Position = Position + 1;
			While Position < Closing Do
				Item = MixedOperand(Tokens, Position, Context);
				If Item = Undefined Or Item.Literal = Undefined
					Or (Tokens[Item.Last + 1].Value <> "," And Item.Last + 1 <> Closing) Then
					Operands.Clear();
					Break;
				EndIf;
				Operands.Add(Item);
				Position = Item.Last + 2;
			EndDo;
			Last = Closing;
		EndIf;
	ElsIf Operator = "BETWEEN" Or Operator = Upper("Между") Then
		Low = MixedOperand(Tokens, OperatorIndex + 1, Context);
		If Low <> Undefined And Low.Last + 2 <= Tokens.Count() - 1
			And (Upper(Tokens[Low.Last + 1].Value) = "AND" Or Upper(Tokens[Low.Last + 1].Value) = Upper("И")) Then
			High = MixedOperand(Tokens, Low.Last + 2, Context);
			If High <> Undefined Then
				Operands.Add(Low);
				Operands.Add(High);
				Last = High.Last;
			EndIf;
		EndIf;
	ElsIf Operator = "LIKE" Or Operator = Upper("Подобно") Then
		// У составного поля образец - ещё и параметр со строкой или строковое поле, и за ним бывает СПЕЦСИМВОЛ (замер
		// ocp1, ocp3, q4e, 20-21.11.2026, УХ): `_TYPE = 0x05 AND … AND _S LIKE <образец> [ESCAPE '~'] AND …`. Вид
		// образца сверяется ниже по его частям.
		Item = MixedOperand(Tokens, OperatorIndex + 1, Context);
		If Item <> Undefined And (Item.Literal <> Undefined And Item.Literal.Role = "_S"
			Or Item.Literal = Undefined And PathParts <> Undefined) Then
			Operands.Add(Item);
			Last = Item.Last;
			If PathParts <> Undefined And Last + 2 <= Tokens.Count() - 1 And Tokens[Last + 2].Kind = "String"
				And (Upper(Tokens[Last + 1].Value) = "ESCAPE" Or Upper(Tokens[Last + 1].Value) = Upper("Спецсимвол")) Then
				Escape = StringLiteral(Tokens[Last + 2].Value, Context);
				Last = Last + 2;
			EndIf;
		EndIf;
	ElsIf MirroredOperator(Operator) <> "" Then
		Item = MixedOperand(Tokens, OperatorIndex + 1, Context);
		If Item <> Undefined Then
			Operands.Add(Item);
			Last = Item.Last;
		EndIf;
	EndIf;
	If Operands.Count() = 0 And PathParts <> Undefined And OperatorIndex + 1 <= Tokens.Count() - 1 Then
		// Замер d14 (21.11.2026, УХ): `Реквизит В (&К)` со строкой в параметре - `тег = 0x05 AND строковая
		// часть IN (@P)`. Какую часть сравнивать, решает вид значения, поэтому без значения перевода нет.
		Missing = "";
		For Position = OperatorIndex + 1 To Min(OperatorIndex + 2, Tokens.Count() - 1) Do
			If Tokens[Position].Kind = "Parameter" And IsBlankString(Missing)
				And IsBlankString(SuppliedParameterKind(Tokens[Position].Value, Context)) Then
				Missing = Tokens[Position].Value;
			EndIf;
		EndDo;
		If Not IsBlankString(Missing) And NavigatedMixedParts(Tokens[Index].Value, Context) <> Undefined Then
			Raise StrTemplate("%1 is of different kinds in the types of the reference it is read through, and it"
				+ " is compared with parameter &%2, whose value is not given (or is a list). The platform compares"
				+ " such a value part by part - the type tag and the part of the kind of the parameter value -"
				+ " so the kind of the value decides the SQL. Give parameter &%2 a single value of a primitive"
				+ " type (ParameterValues), or compare the field with a literal.",
				TrimAll(Tokens[Index].Value), Missing);
		EndIf;
	EndIf;
	If Operands.Count() = 0 Or (Operand = Undefined And Not RightIsBoundary(Tokens, Last)) Then
		If Soft Then
			Return Undefined;
		EndIf;
		Raise Refusal;
	EndIf;

	// Части - значения, а не условия: в логическом контексте поле обернулось бы в «= 0x01».
	Saved = Context.BooleanContext;
	Context.BooleanContext = False;
	Try
		Rights = New Array;
		For Each Item In Operands Do
			Parts = MixedOperandParts(Item, Context);
			If Parts = Undefined And PathParts <> Undefined And Item.Literal = Undefined
				And Left(Item.Text, 1) <> "&" And (Operator = "=" Or Operator = "<>")
				And NavigatedMixedParts(Tokens[Index].Value, Context) <> Undefined Then
				// Реквизит разного вида слева, ссылочное поле справа - то же сравнение частей (de2).
				Parts = ArmCompositeParts(Item.Text, Context);
				If Parts <> Undefined And Parts.Get("_RRRef") = Undefined Then
					Parts = Undefined;
				EndIf;
			EndIf;
			If Parts = Undefined Then
				Rights.Clear();
				Break;
			EndIf;
			Rights.Add(Parts);
		EndDo;
		LeftParts = PathParts;
		If Rights.Count() > 0 And LeftParts = Undefined Then
			LeftParts = BranchedCompositeParts(Text, Context);
		EndIf;
	Except
		Context.BooleanContext = Saved;
		If Soft Then
			Return Undefined;
		EndIf;
		Raise;
	EndTry;
	Context.BooleanContext = Saved;
	If Rights.Count() = 0 Or LeftParts = Undefined Or LeftParts.Get("_TYPE") = Undefined Then
		If Soft Then
			Return Undefined;
		EndIf;
		Raise Refusal;
	EndIf;

	Consumed = Last - Index + 1;
	If Operator = "IN" Or Operator = Upper("В") Then
		// Литералы списка группируются по видам: у каждого вида свой тег и своя часть.
		Groups = New Map;
		RoleOrder = New Array;
		For Each Parts In Rights Do
			Role = MixedPartsRole(Parts);
			Group = Groups.Get(Role);
			If Group = Undefined Then
				Group = New Structure("Tag, Items", Parts.Get("_TYPE"), New Array);
				Groups.Insert(Role, Group);
				RoleOrder.Add(Role);
			EndIf;
			Group.Items.Add(Parts.Get(Role));
		EndDo;
		Tests = New Array;
		For Each Role In RoleOrder Do
			Group = Groups.Get(Role);
			Tests.Add(ArmPart(LeftParts, "_TYPE", Context) + " = " + Group.Tag + " AND "
				+ ArmPart(LeftParts, Role, Context) + " IN (" + StrConcat(Group.Items, ", ") + ")");
		EndDo;
		Sql = "(" + StrConcat(Tests, " OR ") + ")";
	ElsIf Operator = "BETWEEN" Or Operator = Upper("Между") Then
		Low = MixedPartsComparison(LeftParts, ">=", Rights[0], Context, PathParts <> Undefined);
		High = MixedPartsComparison(LeftParts, "<=", Rights[1], Context, PathParts <> Undefined);
		Sql = ?(IsBlankString(Low) Or IsBlankString(High), "", "(" + Low + " AND " + High + ")");
	ElsIf Operator = "LIKE" Or Operator = Upper("Подобно") Then
		Sql = "";
		If Rights[0].Count() = 2 And MixedPartsRole(Rights[0]) = "_S" Then
			Pattern = New Map;
			For Each Part In Rights[0] Do
				Pattern.Insert(Part.Key, Part.Value);
			EndDo;
			If Not IsBlankString(Escape) Then
				Pattern.Insert("_S", Pattern.Get("_S") + " ESCAPE " + Escape);
			EndIf;
			Sql = MixedPartsComparison(LeftParts, "LIKE", Pattern, Context);
		EndIf;
	Else
		Sql = MixedPartsComparison(LeftParts, Operator, Rights[0], Context, PathParts <> Undefined);
	EndIf;
	If IsBlankString(Sql) Then
		If Soft Then
			Return Undefined;
		EndIf;
		Raise Refusal;
	EndIf;
	Return ?(Negated, "(NOT " + Sql + ")", Sql);

EndFunction

// Части составного поля с примитивными частями, если за путём на позиции Index стоит
// сравнение порядка, ПОДОБНО, МЕЖДУ или В (в том числе с НЕ); иначе Undefined.
Function CompositePathParts(Tokens, Index, Context)

	If Index + 2 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Or StrFind(Tokens[Index].Value, ".") = 0 Then
		Return Undefined;
	EndIf;
	Next = Upper(Tokens[Index + 1].Value);
	If Next = "NOT" Or Next = Upper("Не") Then
		Next = Upper(Tokens[Index + 2].Value);
		If Next <> "IN" And Next <> Upper("В") And Next <> "LIKE" And Next <> Upper("Подобно") Then
			Return Undefined;
		EndIf;
	ElsIf Next = "=" Or Next = "<>" Then
		// «=» и «<>» с литералом ведёт PrimitiveLiteralComparisonSpan; здесь - только с полем. У
		// реквизита разного вида за составной ссылкой хранимых частей нет, и с литералом его
		// сравнивает этот же разбор.
		If Tokens[Index + 2].Kind <> "Name" Or StrFind(Tokens[Index + 2].Value, ".") = 0 Then
			If Not LeftIsBoundary(Tokens, Index) Then
				Return Undefined;
			EndIf;
			Return NavigatedMixedParts(Tokens[Index].Value, Context);
		EndIf;
	ElsIf Next <> "<" And Next <> ">" And Next <> "<=" And Next <> ">=" And Next <> "IN" And Next <> Upper("В")
		And Next <> "LIKE" And Next <> Upper("Подобно") And Next <> "BETWEEN" And Next <> Upper("Между") Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Result = CompositeFieldParts(Tokens[Index].Value, Context);
	If Result = Undefined And (Next = "=" Or Next = "<>")
		And NavigatedMixedParts(Tokens[Index + 2].Value, Context) <> Undefined Then
		// Слева ссылка (одного типа или составная), справа реквизит разного вида за составной
		// ссылкой. Замер de2 (21.11.2026, УХ, условие соединения): части попарно - тег, пустая
		// строка против строковой части, таблица, ссылка.
		Try
			Result = ArmCompositeParts(Tokens[Index].Value, Context);
		Except
			Result = Undefined;
		EndTry;
		If Result <> Undefined And Result.Get("_RRRef") = Undefined Then
			Result = Undefined;
		EndIf;
	EndIf;
	Return Result;

EndFunction

// Части реквизита за составной ссылкой, если у типов ссылки он разного вида (есть примитивные
// части); иначе Undefined. Состав спрашивается пробной ролью - соединений она не строит, и путь
// со ссылочным значением остаётся прежней дорогой нетронутым.
Function NavigatedMixedParts(Path, Context)

	Trimmed = TrimAll(Path);
	If StrFind(Trimmed, "(") > 0 Or StrFind(Trimmed, " ") > 0 Or StrFind(Trimmed, ".") = 0 Then
		Return Undefined;
	EndIf;
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Trimmed, Context);
	Except
		Return Undefined;
	EndTry;
	If IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	Roles = "";
	Try
		Roles = CompositeNavigation(Resolved, Resolved.CompositeSegment, Resolved.FieldName, Context, "?");
	Except
		Roles = "";
	EndTry;
	If IsBlankString(Roles) Then
		Return Undefined;
	EndIf;
	Return NavigatedCompositeParts(Trimmed, Context);

EndFunction

// Части составного поля по пути, если среди них есть примитивные; иначе Undefined.
Function CompositeFieldParts(Path, Context)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		// Замеры d2, d2n, d2ne, d2in, d12, d15 (21.11.2026, УХ): сравнение реквизита разного вида за
		// составной ссылкой - по тем же правилам, что у хранимого составного поля: «=» - тег и все
		// части, «<>» - тег или часть вида, В - тег и часть, порядок - тег, потом часть.
		Return NavigatedMixedParts(Path, Context);
	EndIf;
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Or IsBlankString(Info.TypeColumn) Then
		Return Undefined;
	EndIf;
	Columns = New Map;
	Columns.Insert("_TYPE", Info.TypeColumn);
	Columns.Insert("_L", Info.BooleanColumn);
	Columns.Insert("_N", Info.NumberColumn);
	Columns.Insert("_T", Info.DateColumn);
	Columns.Insert("_S", Info.StringColumn);
	Columns.Insert("_RTRef", Info.RefTypeColumn);
	Columns.Insert("_RRRef", Info.RefColumn);
	Parts = New Map;
	Primitive = False;
	For Each Pair In Columns Do
		If Not IsBlankString(Pair.Value) Then
			Parts.Insert(Pair.Key, FieldColumn(Resolved.Descriptor, Resolved.Alias, Pair.Value, Context));
			Primitive = Primitive Or (Pair.Key <> "_TYPE" And Pair.Key <> "_RTRef" And Pair.Key <> "_RRRef");
		EndIf;
	EndDo;
	Return ?(Primitive, Parts, Undefined);

EndFunction

// Сравнение частей с частями составного поля. Замерено (9901-9903, ERP WE, колонки временной
// таблицы): «=» - все части попарно через И, «<>» - через ИЛИ, порядок - сначала тег, потом
// часть того вида, который у обеих строк один (`L._TYPE > R._TYPE OR L._TYPE = 0x03 AND
// R._TYPE = 0x03 AND L._N > R._N OR …`). ПОДОБНО с полем не замерено - пустая строка, и вызывающий отказывает.
// Fields - обе стороны составные поля (хранимые или колонки таблицы), не ВЫБОР: замер ocp7, q4b (20-21.11.2026, УХ) -
// у >= и <= после тегов ветвь «оба НЕОПРЕДЕЛЕНО», у обоих 0x08 - таблица, потом ссылка; ссылка только с одной
// стороны ветви 0x08 не даёт (теги различаются), ссылка без части таблицы не замерена. У ВЫБОРа ссылки - отказ.
Function CompositePartsComparison(LeftParts, Operator, RightParts, Context, Fields = False)

	Tags = New Map;
	Tags.Insert("_L", "02");
	Tags.Insert("_N", "03");
	Tags.Insert("_T", "04");
	Tags.Insert("_S", "05");
	If Operator = "=" Or Operator = "<>" Then
		Tests = New Array;
		For Each Suffix In PartRoleOrder() Do
			If LeftParts.Get(Suffix) <> Undefined Or RightParts.Get(Suffix) <> Undefined Then
				Tests.Add(ArmPart(LeftParts, Suffix, Context) + " " + Operator + " " + ArmPart(RightParts, Suffix, Context));
			EndIf;
		EndDo;
		Return "(" + StrConcat(Tests, ?(Operator = "=", " AND ", " OR ")) + ")";
	EndIf;
	LeftReference = LeftParts.Get("_RRRef") <> Undefined Or LeftParts.Get("_RTRef") <> Undefined;
	RightReference = RightParts.Get("_RRRef") <> Undefined Or RightParts.Get("_RTRef") <> Undefined;
	Both = LeftReference And RightReference;
	If Operator = "LIKE" Or ((LeftReference Or RightReference) And Not Fields)
		Or (Both And (LeftParts.Get("_RTRef") = Undefined Or RightParts.Get("_RTRef") = Undefined
			Or LeftParts.Get("_RRRef") = Undefined Or RightParts.Get("_RRRef") = Undefined)) Then
		Return "";
	EndIf;
	Strict = ?(Operator = ">" Or Operator = ">=", ">", "<");
	LeftTag = ArmPart(LeftParts, "_TYPE", Context);
	RightTag = ArmPart(RightParts, "_TYPE", Context);
	Tests = New Array;
	Tests.Add(LeftTag + " " + Strict + " " + RightTag);
	If Fields And (Operator = ">=" Or Operator = "<=") Then
		Undefined_ = BinaryLiteral("01", Context);
		Tests.Add(LeftTag + " = " + Undefined_ + " AND " + RightTag + " = " + Undefined_);
	EndIf;
	For Each Suffix In PartRoleOrder() Do
		If Tags.Get(Suffix) = Undefined Or LeftParts.Get(Suffix) = Undefined Or RightParts.Get(Suffix) = Undefined Then
			Continue;
		EndIf;
		Tag = BinaryLiteral(Tags.Get(Suffix), Context);
		Tests.Add(LeftTag + " = " + Tag + " AND " + RightTag + " = " + Tag + " AND "
			+ LeftParts.Get(Suffix) + " " + Operator + " " + RightParts.Get(Suffix));
	EndDo;
	If Both Then
		Kind = BinaryLiteral("08", Context);
		Tests.Add(LeftTag + " = " + Kind + " AND " + RightTag + " = " + Kind + " AND ((" + LeftParts.Get("_RTRef") + " "
			+ Strict + " " + RightParts.Get("_RTRef") + " OR " + LeftParts.Get("_RTRef") + " = " + RightParts.Get("_RTRef")
			+ " AND " + LeftParts.Get("_RRRef") + " " + Operator + " " + RightParts.Get("_RRRef") + "))");
	EndIf;
	Return "(" + StrConcat(Tests, " OR ") + ")";

EndFunction

// Знак сравнения, если ВЫБОР стоит справа: «0 < ВЫБОР» - это «ВЫБОР > 0». Пустая строка -
// знак не из разбираемых здесь.
Function MirroredOperator(Operator)

	If Operator = "=" Or Operator = "<>" Then
		Return Operator;
	ElsIf Operator = "<" Then
		Return ">";
	ElsIf Operator = ">" Then
		Return "<";
	ElsIf Operator = "<=" Then
		Return ">=";
	ElsIf Operator = ">=" Then
		Return "<=";
	EndIf;
	Return "";

EndFunction

// Операнд сравнения с разнотипным ВЫБОРом: литерал примитива, путь к полю или параметр.
// Структура Last (последний токен), Literal (LiteralPartRole либо Undefined), Text; Undefined -
// операнд не такой. Перевода здесь нет - только разбор.
Function MixedOperand(Tokens, Position, Context)

	If Position > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Literal = LiteralPartRole(Tokens, Position, Context);
	If Literal <> Undefined Then
		Last = Position + Literal.Width - 1;
		Return New Structure("Last, Literal, Text", Last, Literal, TokensText(Tokens, Position, Last));
	EndIf;
	Token = Tokens[Position];
	If Token.Kind = "Parameter" Then
		Return New Structure("Last, Literal, Text", Position, Undefined, "&" + Token.Value);
	EndIf;
	If Token.Kind = "Name" And StrFind(Token.Value, ".") > 0 Then
		Return New Structure("Last, Literal, Text", Position, Undefined, Token.Value);
	EndIf;
	Return Undefined;

EndFunction

// Части операнда: тег и часть его вида, либо все части составного поля с примитивными
// частями. Undefined - вид не выводится или операнд - ссылка (не замерено).
Function MixedOperandParts(Operand, Context)

	If Operand.Literal <> Undefined Then
		Parts = New Map;
		Parts.Insert("_TYPE", BinaryLiteral(Operand.Literal.Tag, Context));
		Parts.Insert(Operand.Literal.Role, Operand.Literal.Literal);
	ElsIf Left(Operand.Text, 1) = "&" Then
		Parts = ParameterArmParts(Operand.Text, Context);
	Else
		// Составное поле с примитивными частями сравнивается частью с частью (9901-9903).
		Parts = CompositeFieldParts(Operand.Text, Context);
		If Parts <> Undefined Then
			Return Parts;
		EndIf;
		Parts = PrimitiveArmParts(Operand.Text, Context);
	EndIf;
	If Parts = Undefined Or Parts.Count() <> 2 Or IsBlankString(MixedPartsRole(Parts)) Then
		Return Undefined;
	EndIf;
	Return Parts;

EndFunction

// Роль примитивной части: ключ, отличный от _TYPE.
Function MixedPartsRole(Parts)

	For Each Part In Parts Do
		If Part.Key <> "_TYPE" Then
			Return Part.Key;
		EndIf;
	EndDo;
	Return "";

EndFunction

// Сравнение частей ВЫБОРа с частями операнда одного примитивного вида (правила - у
// MixedCaseComparisonSql). Operator: =, <>, <, >, <=, >=, LIKE.
Function MixedPartsComparison(LeftParts, Operator, RightParts, Context, Fields = False)

	If RightParts.Count() > 2 Then
		Return CompositePartsComparison(LeftParts, Operator, RightParts, Context, Fields);
	EndIf;
	Role = MixedPartsRole(RightParts);
	LeftTag = ArmPart(LeftParts, "_TYPE", Context);
	RightTag = RightParts.Get("_TYPE");
	LeftValue = ArmPart(LeftParts, Role, Context);
	RightValue = RightParts.Get(Role);
	If Operator = "<>" Then
		Return "(" + LeftTag + " <> " + RightTag + " OR " + LeftValue + " <> " + RightValue + ")";
	ElsIf Operator = "=" Or Operator = "LIKE" Then
		Tests = New Array;
		For Each Suffix In PartRoleOrder() Do
			If LeftParts.Get(Suffix) = Undefined And RightParts.Get(Suffix) = Undefined Then
				Continue;
			EndIf;
			Sign = ?(Suffix = Role And Operator = "LIKE", " LIKE ", " = ");
			Tests.Add(ArmPart(LeftParts, Suffix, Context) + Sign + ArmPart(RightParts, Suffix, Context));
		EndDo;
		Return "(" + StrConcat(Tests, " AND ") + ")";
	EndIf;
	Strict = ?(Operator = ">" Or Operator = ">=", ">", "<");
	Return "(" + LeftTag + " " + Strict + " " + RightTag + " OR " + LeftTag + " = " + RightTag
		+ " AND " + LeftValue + " " + Operator + " " + RightValue + ")";

EndFunction

// Виды значений ветвей ВЫБОРа и ЕСТЬNULL, с вложенными: _S, _N, _T, _L, _RRRef у ссылки,
// _U у НЕОПРЕДЕЛЕНО; NULL вида не имеет. Вид берётся по тексту, без перевода ветвей: перевод
// регистрирует соединения. False - вид какой-то ветви не выводится.
Function CaseArmKinds(Text, Context, Kinds)

	Branches = Undefined;
	Try
		Branches = ExpressionBranches(TrimAll(Text));
	Except
		Return False;
	EndTry;
	If Branches = Undefined Then
		Return False;
	EndIf;
	Arms = New Array;
	For Each Arm In Branches.Arms Do
		Arms.Add(Arm);
	EndDo;
	If Not IsBlankString(Branches.Else_) Then
		Arms.Add(Branches.Else_);
	EndIf;
	For Each Arm In Arms Do
		Trimmed = TrimAll(Arm);
		If Upper(Trimmed) = "NULL" Then
			Continue;
		EndIf;
		If IsUndefinedLiteralText(Trimmed) Then
			Kinds.Insert("_U", True);
			Continue;
		EndIf;
		Nested = Undefined;
		Try
			Nested = ExpressionBranches(Trimmed);
		Except
			Nested = Undefined;
		EndTry;
		If Nested <> Undefined Then
			If Not CaseArmKinds(Trimmed, Context, Kinds) Then
				Return False;
			EndIf;
			Continue;
		EndIf;
		Kind = PrimitiveLiteralRole(Trimmed);
		If IsBlankString(Kind) Then
			Upper_ = Upper(Trimmed);
			If StrStartsWith(Upper_, "DATETIME(") Or StrStartsWith(Upper_, Upper("ДатаВремя(")) Then
				Kind = "_T";
			EndIf;
		EndIf;
		If IsBlankString(Kind) Then
			SqlType = "";
			Try
				SqlType = SqlTypeOfExpression(Trimmed, Context, False);
			Except
				SqlType = "";
			EndTry;
			If IsBlankString(SqlType) Then
				SqlType = FunctionResultSqlType(Trimmed);
			EndIf;
			If IsBlankString(SqlType) Then
				Return False;
			EndIf;
			Kind = SqlTypeKind(SqlType);
		EndIf;
		Kinds.Insert(Kind, True);
	EndDo;
	Return True;

EndFunction

Function UndefinedNullnessSpan(Tokens, Index, Parts)

	// Левый операнд обязан быть уже выведен: хвост приписывается к нему.
	If Index < 1 Or Index + 1 > Tokens.Count() - 1 Or Parts.Count() = 0 Then
		Return Undefined;
	EndIf;

	Operator = Tokens[Index];
	If Operator.Kind <> "Symbol"
		Or (Operator.Value <> "=" And Operator.Value <> "<>") Then
		Return Undefined;
	EndIf;
	If Not IsUndefinedLiteralToken(Tokens[Index + 1]) Then
		Return Undefined;
	EndIf;

	Left = Tokens[Index - 1];
	Suitable = Left.Kind = "Parameter"
		Or (Left.Kind = "Symbol" And Left.Value = ")")
		Or (Left.Kind = "Name"
			And (Upper(Left.Value) = "END" Or Upper(Left.Value) = Upper("Конец")));
	If Not Suitable Then
		Return Undefined;
	EndIf;

	Return ?(Operator.Value = "=", "IS NULL", "IS NOT NULL");

EndFunction

Function UndefinedComparisonSpan(Tokens, Index, Context)

	If Index + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;

	Operator = Tokens[Index + 1];
	If Operator.Kind <> "Symbol" Or (Operator.Value <> "=" And Operator.Value <> "<>") Then
		Return Undefined;
	EndIf;

	Left = Tokens[Index];
	Right = Tokens[Index + 2];
	If Left.Kind = "Name" And Not IsUndefinedLiteralToken(Left) And IsUndefinedLiteralToken(Right) Then
		Path = Left.Value;
	ElsIf IsUndefinedLiteralToken(Left) And Right.Kind = "Name" And Not IsUndefinedLiteralToken(Right) Then
		Path = Right.Value;
	ElsIf IsUndefinedLiteralToken(Left) And IsUndefinedLiteralToken(Right) Then
		// Два литерала: набора типов спрашивать не у кого, сравнение решается на месте.
		// Замерено (9251, 9252): у равенства платформа условие вовсе не выводит, у
		// неравенства выводит заведомо ложное `(0x00) = 0x01`.
		Both = New Structure;
		Both.Insert("Path", "");
		Both.Insert("Equals", Operator.Value = "=");
		Return Both;
	Else
		Return Undefined;
	EndIf;

	If StrFind(Path, ".") = 0
		And (IsBlankString(Context.BareAlias)
			Or Context.BareFields.Get(Upper(TrimAll(Path))) = Undefined) Then
		// Без точки это не путь к полю, а имя - например колонка временной таблицы.
		// Набор типов такого выражения здесь неизвестен, и правило не применимо.
		//
		// Исключение - условие виртуальной таблицы: там поля пишутся без псевдонима, и
		// набор типов у них известен, он берётся из регистра (BareFields). Без этого
		// исключения «МестоУчета = НЕОПРЕДЕЛЕНО» в параметрах среза последних
		// переводилось в «_RRRef = NULL», то есть в UNKNOWN: срез не отдавал ни одной
		// строки на любых данных. Замерено на УХ
		// (ПКО_Документ_ОстаткиБезналичныхДС_Отправка_ПриОтправкеДанных): 1С отдаёт
		// 4 строки, обработка - ни одной, потому что внешнее ГДЕ отсеивало всё
		// после пустого счёта из цепочки ЕСТЬNULL.
		Return Undefined;
	EndIf;

	Result = New Structure;
	Result.Insert("Path", Path);
	Result.Insert("Equals", Operator.Value = "=");
	Return Result;

EndFunction

// Сравнение с НЕОПРЕДЕЛЕНО. Замерено на 8.3.24 по кешу планов MS SQL: платформа решает
// его по набору типов выражения, а не средствами СУБД. У поля составного типа
// НЕОПРЕДЕЛЕНО в набор входит, и сверяется байт типа 0x01; у поля одного типа значения
// в наборе нет, и условие сворачивается в константу - даже если колонка физически NULL
// после левого соединения. Прежний перевод в "X = NULL" давал UNKNOWN, то есть пустую
// выборку на любых данных.
Function UndefinedComparisonSql(Path, Equals, Context)

	If IsBlankString(Path) Then
		// Оба операнда - литерал НЕОПРЕДЕЛЕНО. Прежде это переводилось в `NULL = NULL`,
		// то есть в UNKNOWN: запрос не отдавал ни одной строки на любых данных, тогда
		// как 1С отдаёт все.
		Return ?(Equals, "(1 = 1)", "(1 = 0)");
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		Raise StrTemplate(
			"Comparison with UNDEFINED needs the type set of %1, and that field could not be"
			+ " resolved. The platform decides such a comparison by the declared types, so it"
			+ " cannot be translated without them.", Path);
	EndTry;

	Info = Undefined;
	If IsBlankString(Resolved.CompositeSegment) Then
		Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	Else
		// Реквизит разного вида за составной ссылкой: сверяется один тег. Замеры d2u, de1
		// (21.11.2026, УХ): `<тег перехода> <> 0x01` и `<тег перехода> = 0x01`; строка, где переход
		// значения не дал, не проходит ни то, ни другое (тег NULL).
		Navigated = NavigatedMixedParts(Path, Context);
		If Navigated <> Undefined Then
			Return "(" + Navigated.Get("_TYPE") + ?(Equals, " = ", " <> ") + BinaryLiteral("01", Context) + ")";
		EndIf;
	EndIf;

	If Info = Undefined Or IsBlankString(Info.TypeColumn) Then
		// Колонка, заполненная литералом НЕОПРЕДЕЛЕНО, тега не лишена - она из него и
		// состоит. Константой такое сравнение решать нельзя: после левого соединения тега
		// в строке нет вовсе, и платформа отвечает иначе (замеры 9226, 9241).
		Tag = TagOnlyColumnSql(Resolved, Context);
		If Not IsBlankString(Tag) Then
			Return "(" + Tag + ?(Equals, " = ", " <> ")
				+ BinaryLiteral("01", Context) + ")";
		EndIf;
		Return ?(Equals, "(1 = 0)", "(1 = 1)");
	EndIf;

	TypeColumn = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);
	If Not Equals Then
		// Платформа сверяет только байт типа: различается он - различается и значение.
		Return "(" + TypeColumn + " <> " + BinaryLiteral("01", Context) + ")";
	EndIf;

	Tests = New Array;
	Tests.Add(TypeColumn + " = " + BinaryLiteral("01", Context));
	If Not IsBlankString(Info.RefTypeColumn) Then
		Tests.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context)
			+ " = " + BinaryLiteral("00000000", Context));
	EndIf;
	If Not IsBlankString(Info.RefColumn) Then
		Tests.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context)
			+ " = " + BinaryLiteral("00000000000000000000000000000000", Context));
	EndIf;
	Return "(" + StrConcat(Tests, " AND ") + ")";

EndFunction

// ТИПЗНАЧЕНИЯ(поле). У составного поля это склейка _TYPE и _RTRef - ровно то, что
// пишет платформа. У односоставного колонок типа нет, и значение известно заранее:
// сравнение с ТИП() платформа сворачивает в истину или ложь ещё при разборе.
// Тип значения параметра известен только по самому значению: в тексте запроса его нет.
Function ParameterTypeLiteral(Name, Context)

	// Заглушка поля внешнего запроса (коррелированный подзапрос) - не параметр: тип у неё
	// тот же, что у поля, и выводится во внешнем контексте. УХ ГруппыДоступа
	// ОбработкаПроверкиЗаполненияНаСервере: ТИПЗНАЧЕНИЯ(ВнешниеПользователи.ОбъектАвторизации).
	If Context.Options.Property("OuterColumnSources") And Context.Options.OuterColumnSources <> Undefined Then
		Outer = Context.Options.OuterColumnSources.Get(Name);
		If Outer <> Undefined Then
			Return ValueTypeExpression(Outer.Path, Outer.Context);
		EndIf;
	EndIf;

	Value = Undefined;
	If Context.Options.SubstituteParameters Then
		Value = Context.Options.ParameterValues.Get(Name);
	EndIf;
	If Value = Undefined Then
		Raise StrTemplate(
			"VALUETYPE of parameter %1 can only be resolved from the value: supply it above, otherwise the type is unknown.",
			Name);
	EndIf;

	Meta = Metadata.FindByType(TypeOf(Value));
	If Meta <> Undefined Then
		Return TypeLiteral(Meta.FullName(), Context);
	EndIf;

	If TypeOf(Value) = Type("Boolean") Then
		Return BinaryLiteral(HexLiteral(2, 2) + "00000000", Context);
	ElsIf TypeOf(Value) = Type("Number") Then
		Return BinaryLiteral(HexLiteral(3, 2) + "00000000", Context);
	ElsIf TypeOf(Value) = Type("Date") Then
		Return BinaryLiteral(HexLiteral(4, 2) + "00000000", Context);
	ElsIf TypeOf(Value) = Type("String") Then
		Return BinaryLiteral(HexLiteral(5, 2) + "00000000", Context);
	EndIf;

	Raise StrTemplate("The type of parameter %1 has no representation in storage.", Name);

EndFunction

// Значение типа NULL. Вынесено в одно место: это же значение платформа подставляет
// там, где переход по составной ссылке не дал значения.
Function NullTypeLiteral(Context)

	Return BinaryLiteral(HexLiteral(0, 2) + "00000000", Context);

EndFunction

Function ValueTypeExpression(Path, Context)

	If StrStartsWith(TrimAll(Path), "&") Then
		Return ParameterTypeLiteral(Mid(TrimAll(Path), 2), Context);
	EndIf;

	// Аргументом бывает литерал, и тогда значение типа - константа. Замерено: у
	// НЕОПРЕДЕЛЕНО это тег 0x01 и нулевой идентификатор таблицы (20002), у ЗНАЧЕНИЕ(...) -
	// 0x08 и идентификатор таблицы (20003). Платформа пишет 20002 через ВЫБОР, обе ветви
	// которого дают нули; сворачиваем в тот же литерал.
	UpperPath = Upper(TrimAll(Path));
	If UpperPath = "UNDEFINED" Or UpperPath = Upper("Неопределено") Then
		Return BinaryLiteral(HexLiteral(1, 2) + "00000000", Context);
	EndIf;
	If UpperPath = "NULL" Then
		// Тип NULL - отдельный от Неопределено: замерено, что у платформы
		// ТИПЗНАЧЕНИЯ(переход, не давший значения) равно ТИПЗНАЧЕНИЯ(NULL) и НЕ равно
		// ТИПЗНАЧЕНИЯ(НЕОПРЕДЕЛЕНО) - 1020 строк против нуля на срезе ARAPObjects.
		// Сам байт тега не наблюдаем: платформа передаёт этот литерал параметром, в текст
		// плана он не попадает. Берём 0x00 по той же схеме, что остальные примитивы;
		// наблюдаемо и воспроизведено то, что он отличен от 0x01 и совпадает с подстановкой.
		Return NullTypeLiteral(Context);
	EndIf;
	// Литерал примитива: тип - константа. Замер sm_vt1, sm_vt2 (21.11.2026, УХ; sm_wvt1 - ERP WE):
	// `ТИПЗНАЧЕНИЯ("")` - `0x05 + 0x00000000`, число - 0x03, булево - 0x02, ДАТАВРЕМЯ(...) - 0x04. Прежде
	// строковый литерал уходил в разбор пути: «Cannot resolve field ""» (УХ ВсеДополнительныеРеквизиты,
	// ERP WE AllAdditionalDetails_).
	LiteralType = PrimitiveLiteralTypeName(Tokenize(TrimAll(Path)));
	If Not IsBlankString(LiteralType) Then
		Return TypeLiteral(LiteralType, Context);
	EndIf;
	Inside = PredefinedValueArgument(TrimAll(Path));
	If Not IsBlankString(Inside) Then
		Origin = TypeOrigin(Inside, True);
		If Origin <> Undefined Then
			Return TypeLiteral(Origin.LogicalName, Context);
		EndIf;
	EndIf;

	// Аргументом бывает не путь, а ВЫРАЗИТЬ(...) с обращением через точку.
	Parsed = SplitCastPath(Path);
	If Parsed <> Undefined Then
		Return CastValueType(Parsed, Path, Context);
	EndIf;

	// ЕСТЬNULL(а, б): тип а, где а есть, иначе тип б. Замеры vxp1-vxp5 (20.11.2026, УХ): платформа
	// пишет это по частям типа - `ISNULL(T2._Fld_TYPE, 0x01) + ISNULL(T2._Fld_RTRef, 0x00000000)` у
	// составного с НЕОПРЕДЕЛЕНО, `CASE WHEN T2._FldRRef IS NULL THEN 0x01 ELSE 0x08 END + …` у ссылки одного
	// типа, `CASE WHEN _TYPE IS NULL THEN <тип б> ELSE _TYPE END + …` у составного со ссылкой другой
	// таблицы. Здесь то же значение одним ВЫБОРом над значением типа а: ТИПЗНАЧЕНИЯ(а) пуст (NULL у
	// колонок составного, тип NULL у прочих) ровно там, где а есть NULL. Прежде отказ (УХ 4).
	IsNullPair = IsNullArguments(Path);
	If IsNullPair <> Undefined Then
		Own = ValueTypeExpression(IsNullPair.First, Context);
		Other = ValueTypeExpression(IsNullPair.Second, Context);
		Fallback = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL");
		Return "(CASE WHEN " + Fallback + "(" + Own + ", " + NullTypeLiteral(Context) + ") = "
			+ NullTypeLiteral(Context) + " THEN " + Other + " ELSE " + Own + " END)";
	EndIf;

	Aggregated = AggregatedValueType(Path, Context);
	If Aggregated <> Undefined Then
		Return Aggregated;
	EndIf;

	If StrFind(Path, "(") > 0 Or StrFind(TrimAll(Path), " ") > 0 Then
		// ВЫБОР, агрегат: прежде текст шёл в разбор пути - «Unknown table alias in …». Формы платформы
		// не сняты. Поэтому отказ, но с причиной.
		Raise StrTemplate(
			"VALUETYPE(%1) takes an expression. The platform SQL is measured for a field, a parameter with a"
			+ " value, UNDEFINED, NULL, VALUE(...), CAST(...) with a field after it, ISNULL over those and"
			+ " MIN/MAX over a field; CASE and other aggregates are not translated yet. Select the expression"
			+ " into a temporary table and apply VALUETYPE to its column.", TrimAll(Path));
	EndIf;

	Resolved = ResolveField(Path, Context);
	Return ValueTypeOfResolved(Resolved, Path, Context);

EndFunction

// Вид литерала примитива: строка, число (со знаком), ИСТИНА/ЛОЖЬ, ДАТАВРЕМЯ(...) из чисел. Пустая строка -
// не литерал.
Function PrimitiveLiteralTypeName(Tokens)

	If Tokens.Count() = 0 Then
		Return "";
	EndIf;
	If Tokens.Count() = 1 And Tokens[0].Kind = "String" Then
		Return "String";
	EndIf;
	First = ?(Tokens.Count() = 2 And (Tokens[0].Value = "-" Or Tokens[0].Value = "+"), 1, 0);
	If Tokens.Count() = First + 1 And Tokens[First].Kind = "Number" Then
		Return "Number";
	EndIf;
	If Tokens.Count() = 1 And Tokens[0].Kind = "Name" Then
		Word = Upper(Tokens[0].Value);
		If Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь") Then
			Return "Boolean";
		EndIf;
	EndIf;
	If DateLiteralValue(Tokens) <> Undefined Then
		Return "Date";
	EndIf;
	Return "";

EndFunction

// Значение литерала ДАТАВРЕМЯ(г, м, д[, ч, м, с]) из числовых аргументов; Undefined - не такой литерал.
Function DateLiteralValue(Tokens)

	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or Tokens[Tokens.Count() - 1].Value <> ")" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "DATETIME" And Word <> Upper("ДатаВремя") Then
		Return Undefined;
	EndIf;
	Numbers = New Array;
	For Index = 2 To Tokens.Count() - 2 Do
		If Index % 2 = 0 Then
			If Tokens[Index].Kind <> "Number" Then
				Return Undefined;
			EndIf;
			Numbers.Add(Number(Tokens[Index].Value));
		ElsIf Tokens[Index].Value <> "," Then
			Return Undefined;
		EndIf;
	EndDo;
	If Numbers.Count() <> 3 And Numbers.Count() <> 6 Then
		Return Undefined;
	EndIf;
	While Numbers.Count() < 6 Do
		Numbers.Add(0);
	EndDo;
	Try
		Return Date(Numbers[0], Numbers[1], Numbers[2], Numbers[3], Numbers[4], Numbers[5]);
	Except
		Return Undefined;
	EndTry;

EndFunction

// ТИПЗНАЧЕНИЯ(МАКСИМУМ(поле)) и ТИПЗНАЧЕНИЯ(МИНИМУМ(поле)). Замеры vep1, vep2 (21.11.2026, УХ):
// - поле одного типа: `ISNULL(CASE WHEN MAX(T1._FldRRef) IS NOT NULL THEN 0x08 END + CASE WHEN
//   MAX(T1._FldRRef) IS NOT NULL THEN 0x000000BC END, 0x0000000000)` - тип поля под проверкой «агрегат дал
//   значение», как у самого поля (ValueTypeOfResolved), здесь одним литералом;
// - составное поле: `ISNULL(MAX(_TYPE) + CASE WHEN MAX(_TYPE) = 0x08 THEN SUBSTRING(MAX(_RTRef + _RRRef),1,4)
//   ELSE CASE WHEN MAX(_TYPE) IS NOT NULL THEN 0x00000000 END END, 0x0000000000)`.
// - только ссылки разных таблиц (колонка ВТ над объединением справочников, vep3): ниже.
// Undefined - выражение не такое; составное поле без колонки таблицы - отказ: его форма не снята.
Function AggregatedValueType(Path, Context)

	Tokens = Tokenize(TrimAll(Path));
	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or MatchingParen(Tokens, 1) <> Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word = "MAX" Or Word = Upper("Максимум") Then
		Aggregate = "MAX";
	ElsIf Word = "MIN" Or Word = Upper("Минимум") Then
		Aggregate = "MIN";
	Else
		Return Undefined;
	EndIf;
	Inner = TrimAll(TokensText(Tokens, 2, Tokens.Count() - 2));
	If StrFind(Inner, "(") > 0 Or StrFind(Inner, ".") = 0 Or Left(Inner, 1) = "&" Then
		Return Undefined;
	EndIf;
	Resolved = ResolveField(Inner, Context);
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	Fallback = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL");
	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Then
		Literal = SingleTypeLiteral(Resolved, Inner, Context);
		Copy = Inner;
		Column = FieldReference(Copy, Context);
		Return Fallback + "((CASE WHEN " + Aggregate + "(" + Column + ") IS NOT NULL THEN " + Literal + " END), "
			+ NullTypeLiteral(Context) + ")";
	EndIf;
	If IsBlankString(Info.RefTypeColumn) Or IsBlankString(Info.RefColumn) Then
		Raise StrTemplate(
			"VALUETYPE(%1): the platform SQL of VALUETYPE over MIN/MAX is measured for a field of one type and"
			+ " for a composite field with a table column; %2 is stored otherwise, and its form is not"
			+ " measured. Select %3(...) into a temporary table and apply VALUETYPE to its column.",
			TrimAll(Path), Inner, Tokens[0].Value);
	EndIf;
	Glue = ?(Context.Options.Dialect = "PostgreSQL", " || ", " + ");
	Joined = Aggregate + "(" + FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context) + Glue
		+ FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context) + ")";
	Table = ?(Context.Options.Dialect = "PostgreSQL", "SUBSTRING(" + Joined + " FROM 1 FOR 4)",
		"SUBSTRING(" + Joined + ",1,4)");
	If IsBlankString(Info.TypeColumn) Then
		// Только ссылки (регистратор, колонка объединения ссылок): замер vep3 - `ISNULL(CASE WHEN
		// SUBSTRING(MAX(_TRef + _RRef),1,4) IS NOT NULL THEN 0x08 END + SUBSTRING(MAX(_TRef + _RRef),1,4),
		// 0x0000000000)`.
		Return Fallback + "((CASE WHEN " + Table + " IS NOT NULL THEN " + BinaryLiteral(HexLiteral(8, 2), Context)
			+ " END)" + Glue + Table + ", " + NullTypeLiteral(Context) + ")";
	EndIf;
	Tag = Aggregate + "(" + FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context) + ")";
	Return Fallback + "(" + Tag + Glue + "CASE WHEN " + Tag + " = " + BinaryLiteral(HexLiteral(8, 2), Context)
		+ " THEN " + Table + " ELSE CASE WHEN " + Tag + " IS NOT NULL THEN " + BinaryLiteral("00000000", Context)
		+ " END END, " + NullTypeLiteral(Context) + ")";

EndFunction

// Аргументы ЕСТЬNULL(а, б) текстом: структура First, Second, либо Undefined - выражение не такое.
Function IsNullArguments(Path)

	Tokens = Tokenize(TrimAll(Path));
	If Tokens.Count() < 6 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or MatchingParen(Tokens, 1) <> Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "ISNULL" And Word <> Upper("ЕстьNULL") Then
		Return Undefined;
	EndIf;
	Depth = 0;
	Comma = 0;
	For Index = 2 To Tokens.Count() - 2 Do
		If Tokens[Index].Value = "(" Then
			Depth = Depth + 1;
		ElsIf Tokens[Index].Value = ")" Then
			Depth = Depth - 1;
		ElsIf Depth = 0 And Tokens[Index].Value = "," Then
			If Comma > 0 Then
				Return Undefined;
			EndIf;
			Comma = Index;
		EndIf;
	EndDo;
	If Comma = 0 Then
		Return Undefined;
	EndIf;
	Return New Structure("First, Second", TrimAll(TokensText(Tokens, 2, Comma - 1)),
		TrimAll(TokensText(Tokens, Comma + 1, Tokens.Count() - 2)));

EndFunction

// Единственный ссылочный тип поля, либо пустая строка. Нужен там, где колонки
// идентификатора таблицы в хранении нет: один ссылочный тип - значит константа.
Function SingleReferenceTypeName(Resolved, Context)

	Descriptor = Resolved.Descriptor;
	FieldName = Resolved.FieldName;
	If Descriptor.IsDerived Then
		Origin = Undefined;
		If Descriptor.Property("ColumnSources") And Descriptor.ColumnSources <> Undefined Then
			Origin = Descriptor.ColumnSources.Get(Upper(FieldName));
		EndIf;
		If Origin = Undefined Then
			// Вычисляемая колонка (`ВЫБОР … ТОГДА Д.Контрагент ИНАЧЕ "нет" КОНЕЦ`): поля-источника у
			// неё нет, а состав типов знает модель запроса. Замер vxp8 (20.11.2026, УХ): у колонки
			// «строка или ссылка одного типа» платформа пишет таблицу константой -
			// `_TYPE + CASE WHEN _TYPE = 0x08 THEN 0x000000BC WHEN _TYPE <> 0x08 THEN 0x00000000 END`.
			// Прежде отказ «keeps a single reference type and has no table-type column» (УХ 1).
			Return DeclaredSingleReference(Descriptor, FieldName);
		EndIf;
		Declared = DeclaredSingleReference(Descriptor, FieldName);
		Descriptor = TableDescriptor(Origin.LogicalName);
		FieldName = Origin.FieldName;
		Traced = SingleReferenceOfField(Descriptor, FieldName);
		// Источник вычисляемой колонки - поле одной из ветвей ВЫБОР (строковое у «строка или ссылка»):
		// состав колонки тогда знает модель запроса (УХ 10325).
		Return ?(IsBlankString(Traced), Declared, Traced);
	EndIf;
	Return SingleReferenceOfField(Descriptor, FieldName);

EndFunction

Function SingleReferenceOfField(Descriptor, FieldName)

	Owner = MetadataOf(Descriptor.LogicalName);
	If Owner = Undefined Then
		Return "";
	EndIf;
	FieldType = FieldTypeDescription(Owner, FieldName);
	If FieldType = Undefined Then
		Return "";
	EndIf;

	Found = "";
	For Each Item In FieldType.Types() Do
		Meta = Metadata.FindByType(Item);
		If Meta = Undefined Then
			Continue;
		EndIf;
		If Not IsBlankString(Found) Then
			// Ссылочных типов больше одного - идентификатор не константа.
			Return "";
		EndIf;
		Found = Meta.FullName();
	EndDo;
	Return Found;

EndFunction

// Единственный ссылочный тип колонки производной таблицы по типу, объявленному моделью запроса
// (DeclaredTypes). Пустая строка - тип не объявлен, ссылочных типов нет или их несколько.
Function DeclaredSingleReference(Descriptor, FieldName)

	If Not Descriptor.Property("DeclaredTypes") Or Descriptor.DeclaredTypes = Undefined Then
		Return "";
	EndIf;
	Declared = Descriptor.DeclaredTypes.Get(Upper(TrimAll(FieldName)));
	If Declared = Undefined Then
		Return "";
	EndIf;
	Found = "";
	Try
		For Each Item In Declared.Types() Do
			Meta = Metadata.FindByType(Item);
			If Meta = Undefined Then
				Continue;
			EndIf;
			If Not IsBlankString(Found) Then
				Return "";
			EndIf;
			Found = Meta.FullName();
		EndDo;
	Except
		Return "";
	EndTry;
	Return Found;

EndFunction

// ТИПЗНАЧЕНИЯ составного поля, взятого через составную ссылку, если у всех типов ссылки, где это поле есть,
// оно составное (с колонкой тега) и ссылочная таблица у него одна на все ветви или её нет. Замер vep4
// (21.11.2026, УХ, `ТИПЗНАЧЕНИЯ(Г.Этап.ПланироватьНеРанее)` - «документ одного типа или дата» у одного из
// типов ссылки): `ISNULL(T2._Fld_TYPE + CASE WHEN T2._Fld_TYPE = 0x08 THEN 0x00019255 WHEN T2._Fld_TYPE <> 0x08
// THEN 0x00000000 END, <тип NULL>)`. Тег здесь - роль _TYPE перехода (ВЫБОР по типам ссылки, у типа без поля -
// NULL), таблица - литерал. Прежде отказ (УХ 1, ERP WE 1 - Этап.ПланироватьНеРанее). Undefined - иначе.
Function NavigatedCompositeValueType(Resolved, Context)

	FieldType = CompositeFieldType(Resolved.Descriptor, Resolved.CompositeSegment);
	If FieldType = Undefined Then
		Return Undefined;
	EndIf;
	Tail = New Array;
	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined Then
		For Each Item In Resolved.CompositeTail Do
			Tail.Add(Item);
		EndDo;
	EndIf;
	Tail.Add(Resolved.FieldName);
	Tables = New Array;
	Found = False;
	For Each ItemType In FieldType.Types() Do
		Target = Metadata.FindByType(ItemType);
		If Target = Undefined Then
			Continue;
		EndIf;
		Branch = BranchFieldType(Target.FullName(), Tail);
		If Branch = Undefined Then
			Continue;
		EndIf;
		If Branch.Types().Count() < 2 Then
			// Поле ветви одного типа: колонки тега у него нет.
			Return Undefined;
		EndIf;
		Found = True;
		For Each Item In Branch.Types() Do
			Meta = Metadata.FindByType(Item);
			If Meta <> Undefined And Tables.Find(Meta.FullName()) = Undefined Then
				Tables.Add(Meta.FullName());
			EndIf;
		EndDo;
	EndDo;
	If Not Found Or Tables.Count() > 1 Then
		Return Undefined;
	EndIf;
	Tag = "";
	Try
		Tag = CompositeNavigation(Resolved, Resolved.CompositeSegment, Resolved.FieldName, Context, "_TYPE");
	Except
		Return Undefined;
	EndTry;
	If IsBlankString(Tag) Then
		Return Undefined;
	EndIf;
	Table = ?(Tables.Count() = 1, ReferenceTypeIdLiteral(Tables[0], Context), BinaryLiteral("00000000", Context));
	Glue = ?(Context.Options.Dialect = "PostgreSQL", " || ", " + ");
	Fallback = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL");
	Reference = BinaryLiteral(HexLiteral(8, 2), Context);
	Return Fallback + "((" + Tag + ")" + Glue + "CASE WHEN (" + Tag + ") = " + Reference + " THEN " + Table
		+ " WHEN (" + Tag + ") <> " + Reference + " THEN " + BinaryLiteral("00000000", Context) + " END, "
		+ NullTypeLiteral(Context) + ")";

EndFunction

// Литерал типа примитивного поля, взятого через составную ссылку, если у всех типов ссылки, где это
// поле есть, оно одного примитивного вида. Undefined - вид не один, не примитив или не выводится.
Function NavigatedPrimitiveTypeLiteral(Resolved, Context)

	Origin = Undefined;
	Try
		Origin = CompositeTailOrigin(Resolved);
	Except
		Return Undefined;
	EndTry;
	If Origin = Undefined Then
		Return Undefined;
	EndIf;
	Kinds = Origin.Type.Types();
	If Kinds.Count() <> 1 Then
		Return Undefined;
	EndIf;
	Tag = "";
	If Kinds[0] = Type("Boolean") Then
		Tag = "02";
	ElsIf Kinds[0] = Type("Number") Then
		Tag = "03";
	ElsIf Kinds[0] = Type("Date") Then
		Tag = "04";
	ElsIf Kinds[0] = Type("String") Then
		Tag = "05";
	Else
		Return Undefined;
	EndIf;
	Return BinaryLiteral(Tag + "00000000", Context);

EndFunction

Function ValueTypeOfResolved(Resolved, Path, Context)

	If Not IsBlankString(Resolved.CompositeSegment) Then
		// Переход по составной ссылке. Замерено (20004): платформа строит идентификатор
		// целевой таблицы ВЫБОРом по тегу источника, в ветвях - идентификатор под проверкой
		// «переход дал значение», и склеивает его с тегом 0x08, закрытым той же проверкой.
		// Это ровно роль _RTRef, которую обработка уже собирает для частей, поэтому своего
		// построения здесь не нужно.
		IdExpression = "";
		Try
			IdExpression = CompositeNavigation(Resolved, Resolved.CompositeSegment,
				Resolved.FieldName, Context, "_RTRef");
		Except
			IdExpression = "";
		EndTry;
		If IsBlankString(IdExpression) Then
			// Поле за составной ссылкой - не ссылка, а примитив одного вида. Замер vxp7 (20.11.2026, УХ,
			// `ТИПЗНАЧЕНИЯ(Д.ДокументВыдачи.Дата) = ТИП(ДАТА)`): платформа берёт значение перехода (ВЫБОР
			// по типам ссылки) и закрывает тег вида проверкой «переход дал значение» -
			// `ISNULL(CASE WHEN <переход> IS NOT NULL THEN 0x04 END + CASE WHEN <переход> IS NOT NULL
			// THEN 0x00000000 END, <тип NULL>)`. Здесь тег и нулевая таблица - одним литералом, как у
			// одиночного поля ниже. Прежде отказ (перепись 49u: УХ 1, ERP WE 1 - Этап.ПланироватьНеРанее).
			KindLiteral = NavigatedPrimitiveTypeLiteral(Resolved, Context);
			If KindLiteral = Undefined Then
				Composed = NavigatedCompositeValueType(Resolved, Context);
				If Composed <> Undefined Then
					Return Composed;
				EndIf;
				Raise StrTemplate(
					"VALUETYPE(%1) reads a field through a composite reference, and that field is neither a"
					+ " reference nor of one primitive kind in every type of the reference (or its type cannot"
					+ " be derived). The platform SQL is measured for those two cases only. Narrow the"
					+ " reference with CAST(... AS <table>) and take the field from it.", Path);
			EndIf;
			Navigated = CompositeNavigation(Resolved, Resolved.CompositeSegment, Resolved.FieldName, Context);
			Return ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL") + "((CASE WHEN " + Navigated
				+ " IS NOT NULL THEN " + KindLiteral + " END), " + NullTypeLiteral(Context) + ")";
		EndIf;
		Glue = ?(Context.Options.Dialect = "PostgreSQL", " || ", " + ");
		Fallback = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL");
		Return Fallback + "((CASE WHEN " + IdExpression + " IS NOT NULL THEN "
			+ BinaryLiteral(HexLiteral(8, 2), Context) + " END)" + Glue + IdExpression + ", "
			+ NullTypeLiteral(Context) + ")";
	EndIf;

	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info <> Undefined Then
		If IsBlankString(Info.RefTypeColumn) Then
			// Колонки идентификатора таблицы нет, потому что ссылочный тип один - значит
			// идентификатор константен. Замерено (20103, 20104): платформа так и пишет -
			// тег берётся из колонки, а идентификатор подставляется литералом под проверкой
			// «тег ссылочный».
			Target = SingleReferenceTypeName(Resolved, Context);
			If IsBlankString(Target) Or IsBlankString(Info.TypeColumn) Then
				Raise StrTemplate(
					"Field %1 keeps a single reference type and has no table-type column, so VALUETYPE cannot be compared.",
					Path);
			EndIf;
			Tag = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context);
			Glue = ?(Context.Options.Dialect = "PostgreSQL", " || ", " + ");
			SingleTyped = "(" + Tag + Glue + "CASE WHEN " + Tag + " = "
				+ BinaryLiteral(HexLiteral(8, 2), Context) + " THEN "
				+ ReferenceTypeIdLiteral(Target, Context) + " ELSE "
				+ BinaryLiteral("00000000", Context) + " END)";
			If HoldsOnlyParts(Resolved.Descriptor, Resolved.FieldName, Context) Then
				// Колонка временной таблицы из одних частей: у строки без значения тип NULL. Замер vxp8
				// (20.11.2026, УХ): `ISNULL(_TYPE + CASE WHEN _TYPE = 0x08 THEN <таблица> WHEN _TYPE <> 0x08
				// THEN 0x00000000 END, <тип NULL>)`.
				SingleTyped = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL") + "(" + SingleTyped
					+ ", " + NullTypeLiteral(Context) + ")";
			EndIf;
			Return SingleTyped;
		EndIf;
		// Значение сравнивают с пятибайтовым литералом типа, поэтому у регистратора
		// недостающий байт дописывается литералом.
		Head = ?(IsBlankString(Info.TypeColumn), BinaryLiteral("08", Context),
			FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context));
		Glue = ?(Context.Options.Dialect = "PostgreSQL", " || ", " + ");
		TypeValue = "(" + Head + Glue
			+ FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefTypeColumn, Context) + ")";
		If HoldsOnlyParts(Resolved.Descriptor, Resolved.FieldName, Context) Then
			// Колонка из одних частей: у строки без значения тип NULL - ISNULL(_TYPE + _RTRef, …),
			// замер mk_pttype_1, 2, 20.11.2026, УХ.
			TypeValue = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL") + "(" + TypeValue
				+ ", " + NullTypeLiteral(Context) + ")";
		EndIf;
		Return TypeValue;
	EndIf;

	// Тип односоставного поля известен заранее, но у строки внешнего соединения без пары
	// значения нет вовсе: её тип - NULL, и «ССЫЛКА …» или «ТИПЗНАЧЕНИЯ(…) = ТИП(…)» ложно.
	// Голая константа делала условие истинным и на таких строках (сверка battery27: 1С 91,
	// SQL 116). Проверка - та же, что у перехода по составной ссылке выше.
	Literal = SingleTypeLiteral(Resolved, Path, Context);
	If StrFind(Path, "(") > 0 Then
		// Поле после ВЫРАЗИТЬ(...): его таблицу уже присоединил вызывающий (CastValueType), а текст пути -
		// выражение, которое FieldReference не разбирает: «Unknown table alias in ВЫРАЗИТЬ ( … )»
		// (батарея vx03 на 49z4; замер vxp6, 20.11.2026, УХ - ССЫЛКА над ВЫРАЗИТЬ(…).Поле). Колонка
		// берётся из разрешённой таблицы тем же способом, что у поля после ВЫРАЗИТЬ в выборке.
		CastFailure = "";
		Column = BranchValue(Resolved.Alias, Resolved.Descriptor, New Array, Resolved.FieldName, Context,
			CastFailure);
		If IsBlankString(Column) Then
			Raise StrTemplate("VALUETYPE(%1): the field after CAST cannot be read: %2.", Path, CastFailure);
		EndIf;
	Else
		Copy = Path;
		Column = FieldReference(Copy, Context);
	EndIf;
	Fallback = ?(Context.Options.Dialect = "PostgreSQL", "COALESCE", "ISNULL");
	Return Fallback + "((CASE WHEN " + Column + " IS NOT NULL THEN " + Literal + " END), "
		+ NullTypeLiteral(Context) + ")";

EndFunction

Function SingleTypeLiteral(Resolved, Path, Context)

	If Resolved.Descriptor.IsDerived Then
		Origin = Undefined;
		If Resolved.Descriptor.Property("ColumnSources") And Resolved.Descriptor.ColumnSources <> Undefined Then
			Origin = Resolved.Descriptor.ColumnSources.Get(Upper(Resolved.FieldName));
		EndIf;
		If Origin = Undefined Then
			Names = Undefined;
			If Resolved.Descriptor.Property("ParameterColumns") And Resolved.Descriptor.ParameterColumns <> Undefined Then
				Names = Resolved.Descriptor.ParameterColumns.Get(Upper(TrimAll(Resolved.FieldName)));
			EndIf;
			If Names <> Undefined And Names.Count() = 1 Then
				// Колонка - параметр: её тип - тип переданного значения (УХ 22282).
				Value = HierarchyParameterValue(Names[0], Context);
				If Value = Undefined Then
					Raise StrTemplate("VALUETYPE(%1): the column is filled with parameter &%2, so its type is the type of the"
						+ " value of &%2, and no value is supplied. Supply the value of &%2.", Path, Names[0]);
				EndIf;
				Found = Metadata.FindByType(TypeOf(Value));
				If Found <> Undefined Then
					Return TypeLiteral(Found.FullName(), Context);
				EndIf;
				Kinds = New Map;
				Kinds.Insert(Type("Boolean"), 2);
				Kinds.Insert(Type("Number"), 3);
				Kinds.Insert(Type("Date"), 4);
				Kinds.Insert(Type("String"), 5);
				Kind = Kinds.Get(TypeOf(Value));
				If Kind <> Undefined Then
					Return BinaryLiteral(HexLiteral(Kind, 2) + "00000000", Context);
				EndIf;
			EndIf;
			Raise StrTemplate(
				"The type of column %1 of a temporary table is not known from metadata, so VALUETYPE cannot be translated.", Path);
		EndIf;
		Substitute = New Structure;
		Substitute.Insert("Alias", Resolved.Alias);
		Substitute.Insert("Descriptor", TableDescriptor(Origin.LogicalName));
		Substitute.Insert("FieldName", Origin.FieldName);
		Substitute.Insert("CompositeSegment", "");
		Return SingleTypeLiteral(Substitute, Path, Context);
	EndIf;

	Owner = MetadataOf(Resolved.Descriptor.LogicalName);
	If Owner = Undefined Then
		Raise StrTemplate("Metadata object %1 not found.", Resolved.Descriptor.LogicalName);
	EndIf;

	Special = SpecialReferenceTarget(Owner, Resolved.FieldName, Resolved.Descriptor.LogicalName);
	If Special <> Undefined Then
		Return TypeLiteral(Special, Context);
	EndIf;

	FieldType = FieldTypeDescription(Owner, Resolved.FieldName);
	If FieldType = Undefined Then
		Raise StrTemplate("Cannot determine the type of %1, so VALUETYPE cannot be translated.", Path);
	EndIf;

	Types = FieldType.Types();
	If Types.Count() <> 1 Then
		Raise StrTemplate("Field %1 has %2 types but no type column in storage.",
			Path, Format(Types.Count(), "NG=0; NZ=0"));
	EndIf;

	Target = Metadata.FindByType(Types[0]);
	If Target <> Undefined Then
		Return TypeLiteral(Target.FullName(), Context);
	EndIf;

	If Types[0] = Type("Boolean") Then
		Return BinaryLiteral(HexLiteral(2, 2) + "00000000", Context);
	ElsIf Types[0] = Type("Number") Then
		Return BinaryLiteral(HexLiteral(3, 2) + "00000000", Context);
	ElsIf Types[0] = Type("Date") Then
		Return BinaryLiteral(HexLiteral(4, 2) + "00000000", Context);
	ElsIf Types[0] = Type("String") Then
		Return BinaryLiteral(HexLiteral(5, 2) + "00000000", Context);
	EndIf;

	Raise StrTemplate("The type of %1 has no representation in storage.", Path);

EndFunction

// Обращение через точку к значению выражения в скобках: `(ВЫБОР ... КОНЕЦ).Поле`. Замерено
// (9411): платформа соединяет таблицу ссылки по самому выражению - LEFT JOIN ... ON
// <выражение> = T._IDRRef - и берёт поле из неё. Это та же форма, что у
// ВЫРАЗИТЬ(<выражение> КАК Т).Поле, поэтому и соединение строится тем же CastTargetHop.
// Замерено для выражения, все ветви которого - ссылки одной таблицы; для нескольких
// ссылочных типов форма не замерена, и там отказ.
Function ExpressionDereferenceSql(Tokens, Index, Closing, Consumed, Context)

	Tail = New Array;
	Next = Closing + 1;
	While Next + 1 < Tokens.Count() And Tokens[Next].Value = "."
		And Tokens[Next + 1].Kind = "Name" Do
		AddPathSegments(Tail, Tokens[Next + 1].Value);
		Consumed = Consumed + 2;
		Next = Next + 2;
	EndDo;

	// Ключевые слова, после которых скобка - операнд, а не вызов функции.
	Leads = StrSplit("WHEN,THEN,ELSE,AND,OR,NOT,CASE,LIKE,BETWEEN,DISTINCT,SELECT,WHERE,HAVING,BY,ON,"
		+ Upper("Когда,Тогда,Иначе,И,Или,Не,Выбор,Подобно,Между,Различные,Выбрать,Где,Имеющие,По"),
		",", False);
	If Index > 0 And Tokens[Index - 1].Kind = "Name"
		And Leads.Find(Upper(Tokens[Index - 1].Value)) = Undefined Then
		Raise StrTemplate(
			"%1(...).%2 addresses a field through a dot on the result of a function, and the platform"
			+ " form of that has not been measured. Put the function into ВЫРАЗИТЬ(... КАК <table>) and translate again.",
			Tokens[Index - 1].Value, StrConcat(Tail, "."));
	EndIf;

	Inner = TokensText(Tokens, Index + 1, Closing - 1);
	Target = ExpressionReferenceTarget(Inner, Context);
	If IsBlankString(Target) Or Target = "*" Then
		Raise StrTemplate(
			"(%1).%2 addresses a field through a dot on an expression that does not give a reference"
			+ " of one table. The platform joins the table of the reference on the expression itself;"
			+ " that is measured for one table, and for several reference types the form is unknown.",
			TrimAll(Inner), StrConcat(Tail, "."));
	EndIf;

	Hop = CastTargetHop(Inner, Target, Context);
	Failure = "";
	Value = BranchValue(Hop.Alias, Hop.Descriptor, TailWithoutLast(Tail),
		Tail[Tail.Count() - 1], Context, Failure);
	If IsBlankString(Value) Then
		Raise StrTemplate("Path %1 after (%2) cannot be resolved: %3.",
			StrConcat(Tail, "."), TrimAll(Inner), Failure);
	EndIf;
	Return Value;

EndFunction

// Таблица из условия ветви «X ССЫЛКА Т», если ветвь - сам X; пустая строка - условие не такое.
Function RefsGuardedTarget(Condition, Arm)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Condition));
	Except
		Return "";
	EndTry;
	While Tokens.Count() > 2 And Tokens[0].Value = "(" And MatchingParen(Tokens, 0) = Tokens.Count() - 1 Do
		Tokens = Tokenize(TokensText(Tokens, 1, Tokens.Count() - 2));
	EndDo;
	If Tokens.Count() <> 3 Or Tokens[0].Kind <> "Name" Or Tokens[2].Kind <> "Name" Then
		Return "";
	EndIf;
	Word = Upper(Tokens[1].Value);
	If Word <> "REFS" And Word <> Upper("Ссылка") Then
		Return "";
	EndIf;
	If Upper(TrimAll(Tokens[0].Value)) <> Upper(TrimAll(Arm)) Then
		Return "";
	EndIf;
	Origin = TypeOrigin(Tokens[2].Value, False);
	Return ?(Origin = Undefined, "", Origin.LogicalName);

EndFunction

// Таблица ссылки, которую даёт выражение: путь к ссылке одного типа, ЗНАЧЕНИЕ(...),
// ВЫРАЗИТЬ к ссылочному типу (с полем после точки - таблица этого поля), ВЫБОР и ЕСТЬNULL,
// если все ветви дают одну таблицу. Ветвь NULL или Неопределено таблицы не задаёт - для
// неё возвращается «*». Пустая строка - таблица не одна или не выводится.
Function ExpressionReferenceTarget(Text, Context)

	Trimmed = TrimAll(Text);
	Tokens = Undefined;
	Try
		Tokens = Tokenize(Trimmed);
	Except
		Return "";
	EndTry;
	If Tokens.Count() = 0 Then
		Return "";
	EndIf;
	If Tokens[0].Value = "(" And MatchingParen(Tokens, 0) = Tokens.Count() - 1 Then
		Return ExpressionReferenceTarget(TokensText(Tokens, 1, Tokens.Count() - 2), Context);
	EndIf;

	Word = Upper(Trimmed);
	If Word = "NULL" Or Word = "UNDEFINED" Or Word = Upper("Неопределено") Then
		Return "*";
	EndIf;

	Inside = PredefinedValueArgument(Trimmed);
	If Not IsBlankString(Inside) Then
		Origin = TypeOrigin(Inside, True);
		Return ?(Origin = Undefined, "", Origin.LogicalName);
	EndIf;

	Parsed = SplitCastPath(Trimmed);
	If Parsed <> Undefined Then
		Split = Undefined;
		Try
			Split = SplitCast(Parsed.Cast);
		Except
			Return "";
		EndTry;
		Origin = TypeOrigin(Split.TypeText, False);
		If Origin = Undefined Then
			Return "";
		ElsIf Parsed.Tail.Count() = 0 Then
			Return Origin.LogicalName;
		ElsIf Parsed.Tail.Count() > 1 Then
			Return "";
		EndIf;
		Try
			Return ReferencedTableName(Origin.LogicalName, Parsed.Tail[0]);
		Except
			Return "";
		EndTry;
	EndIf;

	Branches = Undefined;
	Try
		Branches = ExpressionBranches(Trimmed);
	Except
		Branches = Undefined;
	EndTry;
	If Branches <> Undefined Then
		Arms = New Array;
		For Each Arm In Branches.Arms Do
			Arms.Add(Arm);
		EndDo;
		If Not IsBlankString(Branches.Else_) Then
			Arms.Add(Branches.Else_);
		EndIf;
		Found = "*";
		Position = -1;
		For Each Arm In Arms Do
			Position = Position + 1;
			Target = ExpressionReferenceTarget(Arm, Context);
			If IsBlankString(Target) And Position < Branches.Conditions.Count() Then
				// Ветвь X под условием «X ССЫЛКА Т» - ссылка таблицы Т (замер cr01, cr02).
				Target = RefsGuardedTarget(Branches.Conditions[Position], Arm);
			EndIf;
			If IsBlankString(Target) Then
				Return "";
			ElsIf Target = "*" Then
				Continue;
			ElsIf Found = "*" Then
				Found = Target;
			ElsIf Upper(Found) <> Upper(Target) Then
				Return "";
			EndIf;
		EndDo;
		Return Found;
	EndIf;

	Return SingleReferenceTarget(Trimmed, Context);

EndFunction

// ВЫРАЗИТЬ(<что-то> КАК Тип) с последующей точкой: соединение с таблицей типа.
// Приводят и поле, и параметр - у параметра источником соединения служит литерал ссылки.
Function CastTargetHop(Expression, TypeText, Context)

	Target = TableDescriptor(TypeText);
	PrefixKey = Upper("CAST:" + TrimAll(Expression) + "->" + Target.LogicalName);
	Existing = Context.NavigationAliases.Get(PrefixKey);
	If Existing <> Undefined Then
		Return Existing;
	EndIf;

	Source = "";
	Extra = "";
	Resolved = Undefined;
	If Not StrStartsWith(TrimAll(Expression), "&") Then
		Try
			Resolved = ResolveField(TrimAll(Expression), Context);
		Except
			// Приводят выражение, а не поле: соединяться придётся прямо по нему.
			Resolved = Undefined;
		EndTry;
	EndIf;

	If Resolved = Undefined Then
		Source = TranslateValue(TrimAll(Expression), Context);
	Else
		Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
		If Info = Undefined Then
			Source = FieldReference(TrimAll(Expression), Context);
		Else
			Extra = CompositeTypeTest(Resolved.Descriptor, Resolved.Alias, Info,
				ReferenceTypeIdLiteral(TypeText, Context), Context);
			Source = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context);
		EndIf;
	EndIf;

	Context.AliasCounter = Context.AliasCounter + 1;
	Alias = Context.AliasPrefix + Format(Context.AliasCounter, "NG=0");

	Join = New Structure;
	Join.Insert("Alias", Alias);
	Join.Insert("Table", QualifiedTableName(Target.PhysicalName, Context));
	Join.Insert("KeyColumn", PhysicalName(PrimaryKeyColumn(Target), Context));
	Join.Insert("Source", Source);
	Join.Insert("Extra", Extra);
	Context.NavigationJoins.Add(Join);

	Hop = New Structure;
	Hop.Insert("Alias", Alias);
	Hop.Insert("Descriptor", Target);
	// Проверка типа нужна и снаружи: у неудавшегося приведения значение пустое,
	// и тип такого значения тоже пустой, а не тип, к которому приводили.
	Hop.Insert("Extra", Extra);
	Context.NavigationAliases.Insert(PrefixKey, Hop);
	Context.HopAliases.Insert(Alias, True);
	Return Hop;

EndFunction

// Условие «значение действительно этого типа». Пустая строка означает, что проверять
// нечего: у параметра или односоставного поля приведение либо всегда проходит,
// либо всегда нет, и платформа сворачивает его так же.
Function CastTypeTest(Expression, TypeText, Context)

	If StrStartsWith(TrimAll(Expression), "&") Then
		Return "";
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(TrimAll(Expression), Context);
	Except
		Return "";
	EndTry;

	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info = Undefined Then
		Return "";
	EndIf;
	Return CompositeTypeTest(Resolved.Descriptor, Resolved.Alias, Info,
		ReferenceTypeIdLiteral(TypeText, Context), Context);

EndFunction

// Текст вида ВЫРАЗИТЬ(<аргумент>).Поле.Поле разбирается на само приведение и хвост.
// Undefined означает «это не приведение», и тогда текст разбирается как обычный путь.
Function SplitCastPath(Text)

	Tokens = Tokenize(TrimAll(Text));
	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "CAST" And Word <> Upper("Выразить") Then
		Return Undefined;
	EndIf;
	If Tokens[1].Value <> "(" Then
		Return Undefined;
	EndIf;

	Finish = MatchingParen(Tokens, 1);
	If Tokens[Finish].Value <> ")" Then
		Return Undefined;
	EndIf;

	Tail = New Array;
	Index = Finish + 1;
	While Index + 1 < Tokens.Count() Do
		If Tokens[Index].Value <> "." Or Tokens[Index + 1].Kind <> "Name" Then
			Return Undefined;
		EndIf;
		AddPathSegments(Tail, Tokens[Index + 1].Value);
		Index = Index + 2;
	EndDo;
	If Index <> Tokens.Count() Then
		Return Undefined;
	EndIf;

	Result = New Structure;
	Result.Insert("Cast", TokensText(Tokens, 2, Finish - 1));
	Result.Insert("Tail", Tail);
	Return Result;

EndFunction

// Тип значения выражения ВЫРАЗИТЬ(...).Поле: без хвоста это сам тип приведения,
// с хвостом - тип поля таблицы этого типа.
Function CastValueType(Parsed, Path, Context)

	Split = SplitCast(Parsed.Cast);
	If Parsed.Tail.Count() = 0 Then
		Literal = TypeLiteral(Split.TypeText, Context);
		Test = CastTypeTest(Split.Expression, Split.TypeText, Context);
		Return ?(IsBlankString(Test), Literal, "(CASE WHEN " + Test + " THEN " + Literal + " END)");
	EndIf;

	Hop = CastTargetHop(Split.Expression, Split.TypeText, Context);
	Alias = Hop.Alias;
	Descriptor = Hop.Descriptor;
	Prefix = Alias;
	For Index = 0 To Parsed.Tail.Count() - 2 Do
		Prefix = Prefix + "." + Parsed.Tail[Index];
		Step = NavigationHop(Prefix, Descriptor, Alias, Parsed.Tail[Index], Context);
		Alias = Step.Alias;
		Descriptor = Step.Descriptor;
	EndDo;

	Resolved = New Structure;
	Resolved.Insert("Alias", Alias);
	Resolved.Insert("Descriptor", Descriptor);
	Resolved.Insert("FieldName", Parsed.Tail[Parsed.Tail.Count() - 1]);
	Resolved.Insert("CompositeSegment", "");
	Resolved.Insert("CompositeTail", New Array);

	// Поле односоставное - его тип известен статически, но если приведение не удалось,
	// значения нет вовсе, и тип у платформы пустой. Поэтому константа под условием.
	Value = ValueTypeOfResolved(Resolved, Path, Context);
	If IsBlankString(Hop.Extra) Then
		Return Value;
	EndIf;
	Return "(CASE WHEN " + Hop.Extra + " THEN " + Value + " END)";

EndFunction

// ССЫЛКА, слева от которой не поле, а ВЫРАЗИТЬ(...).Поле. Замер vxp6 (20.11.2026, УХ):
// `ВЫРАЗИТЬ(Р.Регистратор КАК Документ.X).ДокументВыдачи ССЫЛКА Документ.Y` - платформа соединяет таблицу X
// по таблице и ссылке регистратора и проверяет части поля: `T2._Fld_TYPE = 0x08 AND T2._Fld_RTRef = <Y>`.
// Это ответ `ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(...).Поле) = ТИП(Y)`, который CastValueType уже строит. Прежде имя
// типа после ССЫЛКА разбиралось как поле: «Unknown table alias in Документ.Y» (перепись 49u: УХ 2,
// ERP WE 1). ВЫРАЗИТЬ без поля после точки - прежний путь.
// ЕСТЬNULL(а, б) слева - замер vxp5 (20.11.2026, УХ): `ISNULL(T2._Fld_TYPE,0x01) = 0x08 AND
// ISNULL(T2._Fld_RTRef,0x00000000) = <Y>` у составного, `ISNULL(CASE WHEN T2._FldRRef IS NOT NULL THEN <X> END,
// <таблица б>) = <Y>` у ссылки одного типа - то же, что `ТИПЗНАЧЕНИЯ(ЕСТЬNULL(а, б)) = ТИП(Y)`
// (ValueTypeExpression). Прежде отказ «REFS (ССЫЛКА) here is applied to an expression» (УХ 4, ERP WE 2).
// Параметр слева платформа сворачивает по значению. Замер vxp9a (20.11.2026, УХ): `&П ССЫЛКА Документ.X`
// при значении-ссылке на X - `(0x000002D7 = 0x000002D7)`, таблица значения против таблицы типа. Замер
// vxp9b: при значении-ссылке другого типа платформа запрос не исполняет («Incompatible types») - отказ
// законен. Без значения тип неизвестен - отказ. Undefined - форма не такая.
Function CastReferenceTestSql(Tokens, Index, Context, Consumed)

	Token = Tokens[Index];
	Last = 0;
	If Token.Kind = "Parameter" Then
		Last = Index;
	ElsIf Token.Kind = "Name" And (Upper(Token.Value) = "ISNULL" Or Upper(Token.Value) = Upper("ЕстьNULL"))
		And Index + 1 < Tokens.Count() And Tokens[Index + 1].Value = "(" Then
		Last = MatchingParen(Tokens, Index + 1);
		If Tokens[Last].Value <> ")" Then
			Return Undefined;
		EndIf;
	ElsIf Token.Kind = "Name" And (Upper(Token.Value) = "CAST" Or Upper(Token.Value) = Upper("Выразить"))
		And Index + 1 < Tokens.Count() And Tokens[Index + 1].Value = "(" Then
		Last = MatchingParen(Tokens, Index + 1);
		If Tokens[Last].Value <> ")" Then
			Return Undefined;
		EndIf;
		Tailed = False;
		While Last + 2 < Tokens.Count() And Tokens[Last + 1].Value = "." And Tokens[Last + 2].Kind = "Name" Do
			Last = Last + 2;
			Tailed = True;
		EndDo;
		If Not Tailed Then
			Return Undefined;
		EndIf;
	Else
		Return Undefined;
	EndIf;
	If Last + 2 > Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Last + 1].Value);
	TypeToken = Tokens[Last + 2];
	If Tokens[Last + 1].Kind <> "Name" Or (Word <> "REFS" And Word <> Upper("Ссылка"))
		Or TypeToken.Kind <> "Name" Or StrFind(TypeToken.Value, ".") = 0
		Or Metadata.FindByFullName(TypeToken.Value) = Undefined Then
		Return Undefined;
	EndIf;
	If Token.Kind = "Parameter" Then
		If Context.Options.Property("OuterColumnSources") And Context.Options.OuterColumnSources <> Undefined
			And Context.Options.OuterColumnSources.Get(TrimAll(Token.Value)) <> Undefined Then
			// Заглушка поля внешнего запроса - не параметр: проверка типа того поля во внешнем контексте, как у
			// ТИПЗНАЧЕНИЯ от заглушки (ParameterTypeLiteral). Замер sm_or1 (21.11.2026, УХ): в подзапросе
			// `ИСТИНА В (ВЫБРАТЬ … ГДЕ Г.Этап ССЫЛКА Документ.X …)` платформа пишет `T1._Fld_TYPE = 0x08 AND
			// T1._Fld_RTRef = <X>` по колонкам внешней таблицы. Прежде имя типа разбиралось как поле - «Unknown
			// table alias in Документ.ЭтапПроизводства2_2» (УХ и ERP WE ПланированиеГрафикаПроизводства2_2).
			Outer = Context.Options.OuterColumnSources.Get(TrimAll(Token.Value));
			Consumed = 3;
			Return ReferenceTypeTest(Outer.Path, TypeToken.Value, Outer.Context);
		EndIf;
		ValueTable = ParameterTypeIdLiteral(TrimAll(Token.Value), Context);
		If IsBlankString(ValueTable) Then
			Raise StrTemplate(
				"REFS (ССЫЛКА) is applied to parameter &%1. The platform turns this test into a constant by the"
				+ " type of the value - the table of the value against the table of %2 - and the parameter has"
				+ " no reference value here, so the SQL cannot be written. Supply the value of &%1 above.",
				TrimAll(Token.Value), TypeToken.Value);
		EndIf;
		WantedTable = ReferenceTypeIdLiteral(Metadata.FindByFullName(TypeToken.Value).FullName(), Context);
		If ValueTable <> WantedTable Then
			Raise StrTemplate(
				"&%1 REFS %2: the value of the parameter is a reference of another type. The platform itself"
				+ " rejects such a query (Incompatible types), so there is nothing to translate.",
				TrimAll(Token.Value), TypeToken.Value);
		EndIf;
		Consumed = 3;
		Return "(" + ValueTable + " = " + WantedTable + ")";
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;

	Consumed = Last - Index + 3;
	Return "(" + ValueTypeExpression(TokensText(Tokens, Index, Last), Context) + " = "
		+ TypeLiteral(TypeToken.Value, Context) + ")";

EndFunction

// Ссылочный тип поля, взятого через составную ссылку прямо за ней (без остатка пути), если у каждого
// типа составной ссылки, где это поле есть, оно ссылка одного и того же типа. Holders - у скольких
// типов поле есть. Иначе пустая строка.
Function NavigatedSameReference(Resolved, Holders)

	Holders = 0;
	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined
		And Resolved.CompositeTail.Count() > 0 Then
		Return "";
	EndIf;
	FieldType = CompositeFieldType(Resolved.Descriptor, Resolved.CompositeSegment);
	If FieldType = Undefined Then
		Return "";
	EndIf;
	Tail = New Array;
	Tail.Add(Resolved.FieldName);
	Found = "";
	For Each ItemType In FieldType.Types() Do
		Holder = Metadata.FindByType(ItemType);
		If Holder = Undefined Then
			Continue;
		EndIf;
		Branch = BranchFieldType(Holder.FullName(), Tail);
		If Branch = Undefined Then
			Continue;
		EndIf;
		Kinds = Branch.Types();
		If Kinds.Count() <> 1 Then
			Return "";
		EndIf;
		Meta = Metadata.FindByType(Kinds[0]);
		If Meta = Undefined Then
			Return "";
		EndIf;
		If Holders > 0 And Upper(Found) <> Upper(Meta.FullName()) Then
			Return "";
		EndIf;
		Found = Meta.FullName();
		Holders = Holders + 1;
	EndDo;
	Return Found;

EndFunction

// Короткая форма `ТИПЗНАЧЕНИЯ(Путь) = ТИП(Т)`: когда аргумент - ссылка известного типа Т, платформа
// сравнивает одну таблицу под проверкой «значение есть», без тега и без ISNULL, и NULL распространяется
// (замеры 20.11.2026, УХ):
// - поле за составной ссылкой, есть у одного её типа (vxp7, vxp11) -
//   `CASE WHEN (T2._Fld25920RRef) IS NOT NULL THEN 0x000000AA END = 0x000000AA`;
// - поле за составной ссылкой, есть у нескольких её типов, везде ссылка на Т (vxp12) -
//   `CASE WHEN <ВЫБОР по типам … ELSE CAST(NULL AS BINARY(16)) END> IS NOT NULL THEN 0x000000E6 END = 0x000000E6`;
// - одиночная ссылка хранимой таблицы, в том числе со стороны внешнего соединения (vxp13) -
//   `CASE WHEN T2._Fld24009RRef IS NOT NULL THEN 0x000000BC END = 0x000000BC`.
// Под НЕ - `NOT (… = <таблица>)`: у строки без значения сравнение NULL. Прежняя форма
// `ISNULL(тег + таблица, тип NULL) = литерал` под НЕ давала на таких строках истину (vxp11: 1С 0, SQL 1).
// Оставлено прежним путём (Undefined): другой тип справа (платформа сворачивает в постоянную ложь,
// vxp12 - ответ тот же); «<>», примитив и список типов (ISNULL-форма у самой платформы, vxp11, vxp14);
// составное с тегом без перехода (платформа: `_TYPE = 0x08 AND _RTRef = <таблица>`, vxp13 - склейка
// `_TYPE + _RTRef` даёт тот же ответ и тот же NULL); колонка производной таблицы (vxp10: платформа
// сворачивает в постоянную); разные типы поля у разных типов составной ссылки, путь длиннее одного шага -
// не замерены. ForRefs - вызов от оператора ССЫЛКА: он замерен только для поля у одного типа составной
// ссылки (vxp12, `НЕ Д.ДокументВыдачи.Касса ССЫЛКА Справочник.Кассы` - тот же SQL, что у vxp11).
Function ShortReferenceTypeTest(Path, TypeName, Context, ForRefs = False)

	Wanted = Metadata.FindByFullName(TypeName);
	If Wanted = Undefined Then
		Return Undefined;
	EndIf;
	Tested = "";
	Target = "";
	Try
		Resolved = ResolveField(Path, Context);
		If IsBlankString(Resolved.CompositeSegment) Then
			If ForRefs Or Resolved.Descriptor.IsDerived
				Or CompositeInfo(Resolved.Descriptor, Resolved.FieldName) <> Undefined Then
				Return Undefined;
			EndIf;
			Target = ReferencedTableName(Resolved.Descriptor.LogicalName, Resolved.FieldName);
			If IsBlankString(Target) Or Upper(Target) <> Upper(Wanted.FullName()) Then
				Return Undefined;
			EndIf;
			Copy = Path;
			Tested = "(CASE WHEN " + FieldReference(Copy, Context) + " IS NOT NULL THEN "
				+ ReferenceTypeIdLiteral(Target, Context) + " END)";
		Else
			Holders = 0;
			Target = NavigatedSameReference(Resolved, Holders);
			If IsBlankString(Target) Or Upper(Target) <> Upper(Wanted.FullName())
				Or (ForRefs And Holders <> 1) Then
				Return Undefined;
			EndIf;
			Tested = CompositeNavigation(Resolved, Resolved.CompositeSegment, Resolved.FieldName, Context,
				"_RTRef");
		EndIf;
	Except
		Return Undefined;
	EndTry;
	If IsBlankString(Tested) Then
		Return Undefined;
	EndIf;
	Return "(" + Tested + " = " + ReferenceTypeIdLiteral(Target, Context) + ")";

EndFunction

// `ТИПЗНАЧЕНИЯ(Путь) = ТИП(Тип)` самостоятельным условием - короткой формой, где она замерена
// (ShortReferenceTypeTest). Undefined - форма не такая, прежний разбор по токенам.
Function ShortTypeTestSql(Tokens, Index, Context, Consumed)

	If Index + 8 > Tokens.Count() - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[Index].Value);
	TypeWord = Upper(Tokens[Index + 5].Value);
	If (Word <> "VALUETYPE" And Word <> Upper("ТипЗначения"))
		Or Tokens[Index + 1].Value <> "(" Or Tokens[Index + 2].Kind <> "Name"
		Or StrFind(Tokens[Index + 2].Value, ".") = 0 Or Tokens[Index + 3].Value <> ")"
		Or Tokens[Index + 4].Kind <> "Symbol" Or Tokens[Index + 4].Value <> "="
		Or Tokens[Index + 5].Kind <> "Name" Or (TypeWord <> "TYPE" And TypeWord <> Upper("Тип"))
		Or Tokens[Index + 6].Value <> "(" Or Tokens[Index + 7].Kind <> "Name"
		Or StrFind(Tokens[Index + 7].Value, ".") = 0 Or Tokens[Index + 8].Value <> ")" Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Or Not RightIsBoundary(Tokens, Index + 8) Then
		Return Undefined;
	EndIf;
	Sql = ShortReferenceTypeTest(Tokens[Index + 2].Value, Tokens[Index + 7].Value, Context);
	If Sql = Undefined Then
		Return Undefined;
	EndIf;
	Consumed = 9;
	Return Sql;

EndFunction

// Оператор ССЫЛКА: платформа выдаёт тот же SQL, что и ТИПЗНАЧЕНИЯ(...) = ТИП(...).
Function ReferenceTypeTest(Path, TypeName, Context)

	Short = ShortReferenceTypeTest(Path, TypeName, Context, True);
	If Short <> Undefined Then
		Return Short;
	EndIf;
	Return "(" + ValueTypeExpression(Path, Context) + " = " + TypeLiteral(TypeName, Context) + ")";

EndFunction

// Приведение выражения, а не поля: ЕСТЬNULL(а, б) или ВЫБОР с ветвями разных типов.
// Составной ссылкой наружу выражение уже не выходит - в SQL от него остаётся одна
// колонка значения, - и проверить, того ли типа результат, нечем. Платформа в таком
// случае вернула бы NULL, здесь значение идёт как есть, о чём сказано предупреждением.
Function CastOfExpression(Expression, TypeText, Tail, Context)

	AddOnce(Context.Warnings, StrTemplate(
		"CAST is applied to expression %1, not to a field. The SQL cannot check the type of the result,"
		+ " so a value of another type comes out as is instead of NULL.", TrimAll(Expression)));

	If Tail.Count() = 0 Then
		Return TranslateValue(TrimAll(Expression), Context);
	EndIf;

	Hop = CastTargetHop(Expression, TypeText, Context);
	Failure = "";
	Value = BranchValue(Hop.Alias, Hop.Descriptor, TailWithoutLast(Tail),
		Tail[Tail.Count() - 1], Context, Failure);
	If IsBlankString(Value) Then
		Raise StrTemplate("Path %2 after CAST to %1 cannot be resolved: %3.",
			TypeText, StrConcat(Tail, "."), Failure);
	EndIf;
	Return Value;

EndFunction

// ВЫРАЗИТЬ. Без точки - CASE, отдающий колонку ссылки только для нужного типа;
// с точкой - соединение с таблицей типа, предикат типа уезжает в ON.
Function CastExpression(Tokens, Index, Arguments, Consumed, Context)

	If Arguments.Count() <> 1 Then
		Raise "CAST takes one argument of the form <expression> AS <type>.";
	EndIf;

	Split = SplitCast(Arguments[0]);
	TypeText = Split.TypeText;
	Normalized = Upper(StrReplace(TypeText, " ", ""));

	// Примитив: приведение как в T-SQL. Приведение к тому типу, который у поля и так
	// есть, платформа выбрасывает - здесь оно безвредно и оставлено как есть.
	Role = "";
	Tag = "";
	If StrStartsWith(Normalized, "STRING") Or StrStartsWith(Normalized, Upper("Строка")) Then
		Role = "_S";
		Tag = "05";
	ElsIf StrStartsWith(Normalized, "NUMBER") Or StrStartsWith(Normalized, Upper("Число")) Then
		Role = "_N";
		Tag = "03";
	ElsIf Normalized = "DATE" Or Normalized = Upper("Дата") Then
		Role = "_T";
		Tag = "04";
	ElsIf Normalized = "BOOLEAN" Or Normalized = Upper("Булево") Then
		Role = "_L";
		Tag = "02";
	EndIf;
	CheckCastOperand(Split.Expression, Role, Context);
	If Not IsBlankString(Role) Then
		// Составное поле приводится к примитиву частью своего вида под проверкой тега:
		// значение другого вида приведения не переживает. Прежде бралась колонка ссылки -
		// байты ссылки становились числом или строкой (короткие ворота 27, запрос 17438:
		// СУММА(ВЫРАЗИТЬ(составное КАК ЧИСЛО))).
		Copy = Split.Expression;
		Composite = CompositePartsOfExpression(Copy, Context);
		If Composite.Parts.Count() > 0 Then
			TypeColumn = "";
			RoleColumn = "";
			For Each Part In Composite.Parts Do
				Suffix = Upper(PartAlias("", Part));
				If Suffix = "_TYPE" Then
					TypeColumn = FieldColumn(Composite.Descriptor, Composite.Alias, Part, Context);
				ElsIf Suffix = Upper(Role) Then
					RoleColumn = FieldColumn(Composite.Descriptor, Composite.Alias, Part, Context);
				EndIf;
			EndDo;
			Value = "NULL";
			If Not IsBlankString(TypeColumn) And Not IsBlankString(RoleColumn) Then
				Value = "(CASE WHEN " + TypeColumn + " = " + BinaryLiteral(Tag, Context)
					+ " THEN " + RoleColumn + " END)";
			EndIf;
		Else
			Value = TranslateValue(Split.Expression, Context);
		EndIf;
	EndIf;
	If Role = "_S" Then
		Return "CAST(" + Value + " AS "
			+ TextTypeName(CastPrecision(Normalized, "(MAX)"), Context) + ")";
	ElsIf Role = "_N" Then
		// ЧИСЛО без длины - число без ограничений: значение не меняется. Умолчание
		// NUMERIC(15, 2) округляло его (сверка battery27: 1С 143.202, SQL 142.68).
		If StrFind(Normalized, "(") = 0 Then
			Return Value;
		EndIf;
		Return "CAST(" + Value + " AS NUMERIC" + CastPrecision(Normalized, "(15, 2)") + ")";
	ElsIf Not IsBlankString(Role) Then
		Return Value;
	EndIf;

	Target = TableDescriptor(TypeText);

	// Обращение через точку сразу после ВЫРАЗИТЬ. Хвост бывает и длиннее одного поля:
	// ВЫРАЗИТЬ(...).Организация.Наименование - это ещё один переход по ссылке.
	FollowingTail = New Array;
	Next = Index + Consumed + 1;
	While Next + 1 < Tokens.Count() And Tokens[Next].Value = "."
		And Tokens[Next + 1].Kind = "Name" Do
		AddPathSegments(FollowingTail, Tokens[Next + 1].Value);
		Consumed = Consumed + 2;
		Next = Next + 2;
	EndDo;
	FollowingField = ?(FollowingTail.Count() = 0, "", FollowingTail[0]);

	Distributed = CastIntoCaseBranches(Split.Expression, TypeText, Context);
	If Distributed <> Undefined Then
		// ВЫБОР: приведение внесено в ветви, тип каждой ветви проверен там (замер cx1-cx4).
		If FollowingTail.Count() = 0 Then
			Return TranslateValue(Distributed, Context);
		EndIf;
		Hop = CastTargetHop(Distributed, TypeText, Context);
		Failure = "";
		Value = BranchValue(Hop.Alias, Hop.Descriptor, TailWithoutLast(FollowingTail),
			FollowingTail[FollowingTail.Count() - 1], Context, Failure);
		If IsBlankString(Value) Then
			Raise StrTemplate("Path %2 after CAST to %1 cannot be resolved: %3.",
				TypeText, StrConcat(FollowingTail, "."), Failure);
		EndIf;
		Return Value;
	EndIf;

	If StrStartsWith(TrimAll(Split.Expression), "&") Then
		// Приводят параметр: само приведение ничего не меняет, а точка после него
		// становится соединением с таблицей типа по литералу ссылки.
		If FollowingTail.Count() = 0 Then
			Return TranslateValue(TrimAll(Split.Expression), Context);
		EndIf;
		Hop = CastTargetHop(Split.Expression, TypeText, Context);
		Failure = "";
		Value = BranchValue(Hop.Alias, Hop.Descriptor, TailWithoutLast(FollowingTail),
			FollowingTail[FollowingTail.Count() - 1], Context, Failure);
		If IsBlankString(Value) Then
			Raise StrTemplate("Path %2 after CAST to %1 cannot be resolved: %3.",
				TypeText, StrConcat(FollowingTail, "."), Failure);
		EndIf;
		Return Value;
	EndIf;

	Resolved = Undefined;
	Try
		Resolved = ResolveField(TrimAll(Split.Expression), Context);
	Except
		Resolved = Undefined;
	EndTry;
	If Resolved = Undefined Then
		Return CastOfExpression(Split.Expression, TypeText, FollowingTail, Context);
	EndIf;

	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);

	If Info = Undefined Then
		// Поле односоставное: приведение ничего не меняет, платформа его снимает.
		If FollowingTail.Count() = 0 Then
			Return FieldReference(TrimAll(Split.Expression), Context);
		EndIf;
		Return FieldReference(TrimAll(Split.Expression) + "."
			+ StrConcat(FollowingTail, "."), Context);
	EndIf;

	TypeTest = CompositeTypeTest(Resolved.Descriptor, Resolved.Alias, Info,
		ReferenceTypeIdLiteral(TypeText, Context), Context);

	// Колонки типа и ссылки читаются мимо общего пути поля.
	StoredColumns = Resolved.Descriptor.Columns.Get(Upper(TrimAll(Resolved.FieldName)));
	If StoredColumns <> Undefined Then
		For Each StoredColumn In StoredColumns Do
			RegisterKeyDeterminedColumn(Context, Resolved.Descriptor, Resolved.Alias,
				FieldColumn(Resolved.Descriptor, Resolved.Alias, StoredColumn, Context));
		EndDo;
	EndIf;

	If IsBlankString(FollowingField) Then
		Return "(CASE WHEN " + TypeTest + " THEN "
			+ FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context) + " END)";
	EndIf;

	Alias = CompositeHop(Resolved, Info, Target, TypeTest, Context);
	Failure = "";
	Value = BranchValue(Alias, TableDescriptor(Target.LogicalName), TailWithoutLast(FollowingTail),
		FollowingTail[FollowingTail.Count() - 1], Context, Failure);
	If IsBlankString(Value) Then
		Raise StrTemplate("Path %2 after CAST to %1 cannot be resolved: %3.",
			Target.LogicalName, StrConcat(FollowingTail, "."), Failure);
	EndIf;
	Return Value;

EndFunction

// ВЫРАЗИТЬ(ВЫБОР ... КАК <ссылка>): текст ВЫБОРа с приведением, внесённым в ветви, или Undefined - выражение не ВЫБОР.
// Платформа держит ВЫБОР с ветвями разного вида составным и берёт при приведении ссылку только у ветви нужной таблицы,
// у прочих - NULL (замер cx1-cx4, 23.11.2026, УХ).
Function CastIntoCaseBranches(Expression, TypeText, Context)

	Tokens = Undefined;
	Try
		Tokens = Tokenize(TrimAll(Expression));
	Except
		Return Undefined;
	EndTry;
	If Tokens = Undefined Or Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	First = Upper(Tokens[0].Value);
	If First <> "CASE" And First <> Upper("Выбор") Then
		Return Undefined;
	EndIf;
	Last = Tokens.Count() - 1;
	If CaseEnd(Tokens, 0) <> Last Or Tokens[Last].Kind <> "Name"
		Or (Upper(Tokens[Last].Value) <> "END" And Upper(Tokens[Last].Value) <> Upper("Конец")) Then
		Return Undefined;
	EndIf;
	Target = MetadataOf(TableDescriptor(TypeText).LogicalName);
	If Target = Undefined Then
		Return Undefined;
	EndIf;

	Pieces = New Array;
	Position = 0;
	For Each Arm In CaseArmSpans(Tokens, 0) Do
		If Arm.From > Position Then
			Pieces.Add(TokensText(Tokens, Position, Arm.From - 1));
		EndIf;
		Branch = CastCaseBranchText(Tokens, Arm.From, Arm.Till, TypeText, Target, Context);
		If Branch = Undefined Then
			Return Undefined;
		EndIf;
		Pieces.Add(Branch);
		Position = Arm.Till + 1;
	EndDo;
	If Position <= Last Then
		Pieces.Add(TokensText(Tokens, Position, Last));
	EndIf;
	Return StrConcat(Pieces, " ");

EndFunction

// Одна ветвь ВЫБОРа под приведением к ссылке Target (метаданные).
Function CastCaseBranchText(Tokens, From, Till, TypeText, Target, Context)

	Text = TokensText(Tokens, From, Till);
	Wrapped = "ВЫРАЗИТЬ(" + Text + " КАК " + TypeText + ")";
	Token = Tokens[From];
	Word = ?(Token.Kind = "Name", Upper(Token.Value), "");
	If From = Till Then
		If Token.Kind = "String" Or Token.Kind = "Number" Then
			Return "NULL";
		EndIf;
		If Word = "NULL" Or Word = "TRUE" Or Word = "FALSE" Or Word = Upper("Истина") Or Word = Upper("Ложь")
			Or Word = "UNDEFINED" Or Word = Upper("Неопределено") Then
			Return "NULL";
		EndIf;
		If Token.Kind <> "Name" Then
			Return Wrapped;
		EndIf;
		Resolved = Undefined;
		Try
			Resolved = ResolveField(Text, Context);
		Except
			Return Wrapped;
		EndTry;
		If Resolved.Property("CompositeSegment") And Not IsBlankString(Resolved.CompositeSegment) Then
			// Путь через составное поле: приведение такого пути не переводится по ветвям.
			Return Undefined;
		EndIf;
		Description = ResolvedTypeDescription(Resolved);
		If Description = Undefined Then
			Return Wrapped;
		EndIf;
		Own = False;
		Others = False;
		For Each Kind In Description.Types() Do
			Found = Undefined;
			Try
				Found = Metadata.FindByType(Kind);
			Except
				Found = Undefined;
			EndTry;
			If Found <> Undefined And Found = Target Then
				Own = True;
			Else
				Others = True;
			EndIf;
		EndDo;
		If Not Own Then
			Return "NULL";
		EndIf;
		Return ?(Others, Wrapped, Text);
	EndIf;
	If Word = "DATETIME" Or Word = Upper("ДатаВремя") Then
		If MatchingParen(Tokens, From + 1) = Till Then
			Return "NULL";
		EndIf;
	ElsIf (Word = "VALUE" Or Word = Upper("Значение")) And Till = From + 3 And Tokens[From + 2].Kind = "Name"
		And MatchingParen(Tokens, From + 1) = Till Then
		Segments = StrSplit(Tokens[From + 2].Value, ".");
		If Segments.Count() = 3 Then
			Owner = MetadataOf(Segments[0] + "." + Segments[1]);
			If Owner <> Undefined Then
				Return ?(Owner = Target, Text, "NULL");
			EndIf;
		EndIf;
	EndIf;
	Return Wrapped;

EndFunction

// ВЫРАЗИТЬ(НЕОПРЕДЕЛЕНО КАК …) и ВЫРАЗИТЬ(&П КАК …) при значении другого вида платформа
// отвергает («Incompatible types»), ВЫРАЗИТЬ(NULL КАК …) - принимает (негативная батарея
// 13.11.2026: sc17 и cr11 НЕОПРЕДЕЛЕНО, sc11 число КАК СТРОКА(2), cr12 число КАК ссылка).
// Role - роль примитива из CastExpression, пустая - приведение к ссылке.
Procedure CheckCastOperand(Expression, Role, Context)

	Operand = Upper(TrimAll(Expression));
	If Operand = "UNDEFINED" Or Operand = Upper("Неопределено") Then
		Raise "CAST(UNDEFINED AS ...) is refused by the platform (""Incompatible types""), and the SQL"
			+ " would return NULL instead. Write NULL in place of UNDEFINED.";
	EndIf;
	Name = LoneParameterName(Expression);
	If IsBlankString(Name) Then
		Return;
	EndIf;
	Expected = "Reference";
	If Role = "_S" Then
		Expected = "String";
	ElsIf Role = "_N" Then
		Expected = "Number";
	ElsIf Role = "_T" Then
		Expected = "Date";
	ElsIf Role = "_L" Then
		Expected = "Boolean";
	EndIf;
	RefuseParameterKind(Name, SuppliedParameterKind(Name, Context), Expected, "CAST");

EndProcedure

Function CastPrecision(Normalized, Default)

	Open = StrFind(Normalized, "(");
	If Open = 0 Then
		Return Default;
	EndIf;
	Close = StrFind(Normalized, ")");
	If Close <= Open Then
		Return Default;
	EndIf;
	Return "(" + StrReplace(Mid(Normalized, Open + 1, Close - Open - 1), ",", ", ") + ")";

EndFunction

Function SplitCast(Argument)

	Tokens = Tokenize(Argument);
	Depth = 0;
	Left = New Array;
	Right = New Array;
	Found = False;

	For Each Token In Tokens Do
		Value = Token.Value;
		If Value = "(" Then
			Depth = Depth + 1;
		ElsIf Value = ")" Then
			Depth = Depth - 1;
		EndIf;
		If Not Found And Depth = 0 And Token.Kind = "Name"
			And (Upper(Value) = "AS" Or Upper(Value) = Upper("Как")) Then
			Found = True;
			Continue;
		EndIf;
		// Лексер держит имя параметра без амперсанда; без него приводимый параметр
		// превращается в поле с таким именем, и путь перестаёт разрешаться.
		If Token.Kind = "Parameter" Then
			Value = "&" + Value;
		EndIf;
		If Found Then
			Right.Add(Value);
		Else
			Left.Add(Value);
		EndIf;
	EndDo;

	If Not Found Then
		Raise "CAST needs the keyword AS between the expression and the type.";
	EndIf;

	Result = New Structure;
	Result.Insert("Expression", TrimAll(StrConcat(Left, " ")));
	Result.Insert("TypeText", TrimAll(StrConcat(Right, "")));
	Return Result;

EndFunction

// Соединение с таблицей одного из типов составной ссылки. Ключ переиспользования -
// пара (поле, целевой тип): два разных ВЫРАЗИТЬ по одному полю дают два соединения.
Function CompositeHop(Resolved, Info, Target, TypeTest, Context)

	PrefixKey = Upper(Resolved.Alias + "." + Resolved.FieldName + "->" + Target.LogicalName);
	Existing = Context.NavigationAliases.Get(PrefixKey);
	If Existing <> Undefined Then
		Return Existing.Alias;
	EndIf;

	Context.AliasCounter = Context.AliasCounter + 1;
	Alias = Context.AliasPrefix + Format(Context.AliasCounter, "NG=0");

	Join = New Structure;
	Join.Insert("Alias", Alias);
	Join.Insert("Table", QualifiedTableName(Target.PhysicalName, Context));
	Join.Insert("KeyColumn", PhysicalName(PrimaryKeyColumn(Target), Context));
	Join.Insert("Source", FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context));
	Join.Insert("Extra", TypeTest);
	Context.NavigationJoins.Add(Join);

	Hop = New Structure;
	Hop.Insert("Alias", Alias);
	Hop.Insert("Descriptor", Target);
	Context.NavigationAliases.Insert(PrefixKey, Hop);
	Context.HopAliases.Insert(Alias, True);

	Return Alias;

EndFunction

// Обращение через точку по составной ссылке: соединение на каждый тип состава,
// у которого есть такое поле, и ВЫБОР с ветвью на каждый тип в том же порядке.
// Остаток пути внутри одной ветки состава. Пустая строка означает «у этого типа
// такого пути нет» - ветка тогда не строится, ровно как у платформы.
// Лексер держит точку частью имени, поэтому хвост после скобки приходит одним куском
// вида «Организация.Наименование» - его надо разложить на сегменты.
Procedure AddPathSegments(Tail, Value)

	For Each Part In StrSplit(TrimAll(Value), ".", False) Do
		If Not IsBlankString(Part) Then
			Tail.Add(TrimAll(Part));
		EndIf;
	EndDo;

EndProcedure

Function TailWithoutLast(Tail)

	Result = New Array;
	For Index = 0 To Tail.Count() - 2 Do
		Result.Add(Tail[Index]);
	EndDo;
	Return Result;

EndFunction

// Псевдополе таблицы, присоединённой под Alias: Предопределенный - по идентификатору
// предопределённых данных (как FieldValue), Представление - через точку, то есть без
// пустой строки на месте NULL (PresentationEmptyRule): у справочника - поле показа, у
// документа - шаблон DocumentPresentationText. Undefined - поле не такое или не выводится.
Function BranchPseudoField(Descriptor, Alias, FieldName, Context, Failure)

	If IsPointInTimeField(FieldName) Then
		// Замер pfp2 (20.11.2026, УХ, `ВЫРАЗИТЬ(Д.ДокументВыдачи КАК Документ.X).МоментВремени`):
		// платформа отдаёт пару колонок присоединённой таблицы - `T2._Date_Time, T2._IDRRef`. Пары это
		// место не возвращает; причина уходит в текст отказа вызывающего (перепись 49u: УХ 2 -
		// «Path МоментВремени after CAST … has no field»).
		Failure = "POINTINTIME is a pair of the document date and the reference, and a pair is not"
			+ " returned here; take the Date of the document instead";
		Return Undefined;
	EndIf;
	If IsPredefinedFlag(FieldName) Then
		Stored = PredefinedColumn(Descriptor);
		If Stored = Undefined Then
			Return Undefined;
		EndIf;
		Column = FieldColumn(Descriptor, Alias, Stored, Context);
		RegisterKeyDeterminedColumn(Context, Descriptor, Alias, Column);
		Empty = BinaryLiteral("00000000000000000000000000000000", Context);
		Return "(CASE WHEN " + Column + " <> " + Empty + " THEN " + BooleanLiteral(True, Context)
			+ " WHEN " + Column + " = " + Empty + " THEN " + BooleanLiteral(False, Context) + " END)";
	EndIf;
	If Not IsPresentationField(FieldName) Then
		Return Undefined;
	EndIf;
	Target = MetadataOf(Descriptor.LogicalName);
	If Target = Undefined Then
		Return Undefined;
	EndIf;
	FullName = Target.FullName();
	Shown = PresentationFieldOf(Descriptor, Target);
	If Not IsBlankString(Shown) Then
		AddOnce(Context.Warnings, StrTemplate(
			"PRESENTATION of %1 returns the stored %2. If the configuration builds the presentation "
			+ "in the manager module, the platform shows something else.", FullName, Shown));
		Stored = Descriptor.Fields.Get(Upper(Shown));
		If Stored = Undefined Then
			Return Undefined;
		EndIf;
		Value = Alias + "." + PhysicalName(Stored, Context);
		RegisterStoredColumn(Context, Descriptor, Alias, Value);
		If IsCodeFieldName(Shown) And IsNumericCode(Target) Then
			Value = GroupedNumberText(Value, Context);
		EndIf;
		If EmptyShownAsBrackets(FullName, Shown) Then
			Value = "(CASE WHEN " + Value + " = " + TextLiteral("", Context) + " THEN "
				+ TextLiteral("<>", Context) + " ELSE " + Value + " END)";
		EndIf;
		Return Value;
	EndIf;
	If IsDocumentLike(FullName) Then
		Formats = Context.SessionFormats;
		If IsBlankString(Formats.DatePattern) Or IsBlankString(Formats.DateWord) Then
			Failure = "the regional settings of this infobase are not among the measured ones";
			Return Undefined;
		EndIf;
		AddOnce(Context.Warnings, StrTemplate(
			"PRESENTATION of %1 reproduces the platform template <object presentation> <number>"
			+ " %2 <date>. A configuration can redefine the presentation in the manager module,"
			+ " and such a redefinition is not reproduced in SQL.", FullName, Formats.DateWord));
		Return "(" + DocumentPresentationText(Descriptor, Alias, Target, Context) + ")";
	EndIf;
	Return Undefined;

EndFunction

Function BranchValue(Alias, Descriptor, Tail, TargetField, Context, Failure = "", Role = "")

	CurrentAlias = Alias;
	Current = Descriptor;
	Prefix = Alias;

	For Index = 0 To Tail.Count() - 1 Do
		Segment = Tail[Index];

		If CompositeInfo(Current, Segment) <> Undefined Then
			// Составная ссылка внутри составной: остаток разбирается рекурсивно.
			Rest = New Array;
			For Next = Index + 1 To Tail.Count() - 1 Do
				Rest.Add(Tail[Next]);
			EndDo;
			Inner = New Structure;
			Inner.Insert("Alias", CurrentAlias);
			Inner.Insert("Descriptor", Current);
			Inner.Insert("FieldName", TargetField);
			Inner.Insert("CompositeSegment", Segment);
			Inner.Insert("CompositeTail", Rest);
			Try
				Return CompositeNavigation(Inner, Segment, TargetField, Context, Role);
			Except
				Failure = ErrorDescription();
				Return "";
			EndTry;
		EndIf;

		Prefix = Prefix + "." + Segment;
		Hop = Undefined;
		Try
			Hop = NavigationHop(Prefix, Current, CurrentAlias, Segment, Context);
		Except
			Failure = ErrorDescription();
			Return "";
		EndTry;
		CurrentAlias = Hop.Alias;
		Current = Hop.Descriptor;
	EndDo;

	If Not IsBlankString(Role) Then
		// Запрошена часть значения, а не само значение. Отдать её можно только у составного
		// поля: у односоставного части константны, и считает их тот, кто знает, удался ли
		// переход. Поэтому здесь - только составное, иначе отступаем.
		Info = CompositeInfo(Current, TargetField);
		If Info = Undefined Then
			// Поле односоставное: тег и идентификатор таблицы - константы, но значения может
			// не быть, если переход не удался. Замерено (9985): платформа закрывает их
			// проверкой «переход дал значение».
			Stored = Current.Fields.Get(Upper(TrimAll(TargetField)));
			If Stored = Undefined Then
				Failure = StrTemplate("table %1 has no field %2", Current.LogicalName, TargetField);
				Return "";
			EndIf;
			Own = CurrentAlias + "." + ?(Current.IsDerived,
				QuoteIdentifier(Stored, Context), PhysicalName(Stored, Context));
			If MixedNavigationRoles(Context) Then
				Return NavigatedBranchPart(Current, TargetField, Own, Role, Context);
			EndIf;
			If Role = "_RRRef" Then
				Return Own;
			EndIf;
			If Role = "_TYPE" Then
				Return "(CASE WHEN " + Own + " IS NOT NULL THEN "
					+ BinaryLiteral(HexLiteral(8, 2), Context) + " END)";
			EndIf;
			Target = "";
			Try
				Target = ReferencedTableName(Current.LogicalName, TargetField);
			Except
				Failure = ErrorDescription();
				Return "";
			EndTry;
			Return "(CASE WHEN " + Own + " IS NOT NULL THEN "
				+ ReferenceTypeIdLiteral(Target, Context) + " END)";
		EndIf;
		Column = "";
		If Role = "_TYPE" Then
			Column = Info.TypeColumn;
		ElsIf Role = "_RTRef" Then
			Column = Info.RefTypeColumn;
		ElsIf Role = "_RRRef" Then
			Column = Info.RefColumn;
		EndIf;
		If MixedNavigationRoles(Context) Then
			// Реквизит этой ветви сам составной: своя часть - колонка, части, которой у него нет, -
			// пустое значение под проверкой его тега (замер d8: `CASE WHEN T4._Fld87621_TYPE IS NOT NULL
			// THEN @P END` в строковой части у ветви с составным реквизитом из ссылок).
			Own = InfoPartColumns(Info).Get(Role);
			If Own <> Undefined Then
				Return FieldColumn(Current, CurrentAlias, Own, Context);
			EndIf;
			If Role = "_RTRef" And Not IsBlankString(Info.TypeColumn) And Not IsBlankString(Info.RefColumn) Then
				// У составного реквизита ссылочный тип один - идентификатора таблицы в хранении нет.
				// Замер qd1a (21.11.2026, УХ, `Ж.Ссылка.ВидДокумента`, ветвь справочника с реквизитом
				// «ссылка одного типа или строка»): `CASE WHEN T23._Fld4021_TYPE = 0x08 THEN 0x000003AD
				// WHEN T23._Fld4021_TYPE <> 0x08 THEN 0x00000000 END`.
				Sole = "";
				Owner = MetadataOf(Current.LogicalName);
				If Owner <> Undefined Then
					Sole = SoleReferenceTable(FieldTypeDescription(Owner, TargetField));
				EndIf;
				If Not IsBlankString(Sole) Then
					Return TableIdByTag(FieldColumn(Current, CurrentAlias, Info.TypeColumn, Context), Sole, Context);
				EndIf;
			EndIf;
			If IsBlankString(Info.TypeColumn) Or (Role = "_RTRef" And Not IsBlankString(Info.RefColumn)) Then
				Raise StrTemplate("field %1.%2 has no part %3", Current.LogicalName, TargetField, Role);
			EndIf;
			Return "(CASE WHEN " + FieldColumn(Current, CurrentAlias, Info.TypeColumn, Context)
				+ " IS NOT NULL THEN " + EmptyPartLiteral(Role, Context) + " END)";
		EndIf;
		If IsBlankString(Column) Then
			Failure = StrTemplate("field %1.%2 has no part %3", Current.LogicalName, TargetField, Role);
			Return "";
		EndIf;
		Return FieldColumn(Current, CurrentAlias, Column, Context);
	EndIf;

	Stored = Current.Fields.Get(Upper(TrimAll(TargetField)));
	If Stored = Undefined And Not Current.IsDerived Then
		// Псевдополя после ВЫРАЗИТЬ и в ветви составной ссылки - те же, что у прямого пути
		// (FieldValue): в хранении их нет (перепись 49u: УХ 8 + 3, ERP WE 3 + 3 отказа
		// «Path Представление/Предопределенный after CAST … cannot be resolved»).
		Pseudo = BranchPseudoField(Current, CurrentAlias, TargetField, Context, Failure);
		If Pseudo <> Undefined Then
			Return Pseudo;
		EndIf;
	EndIf;
	If Stored = Undefined Then
		If IsBlankString(Failure) Then
			Failure = StrTemplate("table %1 has no field %2", Current.LogicalName, TargetField);
		EndIf;
		Return "";
	EndIf;
	Column = CurrentAlias + "." + ?(Current.IsDerived,
		QuoteIdentifier(Stored, Context), PhysicalName(Stored, Context));
	If Context.HopAliases.Get(CurrentAlias) <> Undefined Then
		// Колонка взята через точку - после ВЫРАЗИТЬ или в ветви составной ссылки. В 1С
		// группировки по ней не требуется, а платформа дописывает её в GROUP BY сама
		// (замеры 9602-9604), как и у обычного пути через точку.
		Context.NavigationColumns.Add(Column);
	EndIf;
	// ЭтоГруппа хранится инвертированным, как и у прямого пути (FieldValue): иначе после
	// ВЫРАЗИТЬ или (ВЫБОР ...).ЭтоГруппа группа читалась бы элементом.
	If Not Current.IsDerived And IsFolderField(TargetField) Then
		Return InvertedBoolean(Column, Context);
	EndIf;
	Return Column;

EndFunction

Function CompositeNavigation(Resolved, Segment, TargetField, Context, Role = "", ThroughDot = False)

	Info = CompositeInfo(Resolved.Descriptor, Segment);
	OwnerName = Resolved.Descriptor.LogicalName;
	FieldName = Segment;
	// Вычисляемая колонка полем метаданных не является: за субконто виртуальной таблицы
	// стоит не реквизит регистра, а план видов характеристик. Такое происхождение несёт
	// состав типов с собой, и метаданные для него уже не спрашиваются.
	ReadyType = Undefined;
	If Resolved.Descriptor.IsDerived Then
		Origin = Undefined;
		If Resolved.Descriptor.Property("ColumnSources") And Resolved.Descriptor.ColumnSources <> Undefined Then
			Origin = Resolved.Descriptor.ColumnSources.Get(Upper(TrimAll(Segment)));
		EndIf;
		If Origin = Undefined Then
			Raise StrTemplate("The composition of column %1 of a derived table is unknown.", Segment);
		EndIf;
		OwnerName = Origin.LogicalName;
		FieldName = Origin.FieldName;
		If Origin.Property("UnionType") And Origin.UnionType <> Undefined Then
			// Колонка собрана ОБЪЕДИНЕНИЕМ: ветви надо строить по всем её типам, а не по
			// типам первой ветви.
			ReadyType = Origin.UnionType;
		ElsIf Origin.Property("Type") Then
			ReadyType = Origin.Type;
		EndIf;
	EndIf;

	FieldType = ReadyType;
	If FieldType = Undefined Then
		Owner = MetadataOf(OwnerName);
		If Owner <> Undefined Then
			FieldType = FieldTypeDescription(Owner, FieldName);
			If FieldType = Undefined And IsExtDimensionValueName(FieldName)
				And Context.Options.Property("ExtDimensionValuesTable") And Context.Options.ExtDimensionValuesTable Then
				// Условие ДвиженияССубконто переводится по таблице значений (RecordsExtDimensionCondition): переход
				// строится от колонок слота, которые потом заменяются колонками значения.
				FieldType = ExtDimensionValueType(Owner);
			EndIf;
			If FieldType = Undefined And IsExtDimensionValueName(FieldName) Then
				// Субконто - не реквизит регистра, а значение вида характеристики плана счетов. Переход от него
				// в условии виртуальной таблицы платформа строит по таблице значений субконто _AccRgED (INNER JOIN,
				// SELECT DISTINCT; замер xn1, 21.11.2026, УХ); тип из плана счетов с колонками слотов дал другое
				// число строк (2252 у 1С против 1860) - поэтому честный отказ.
				Raise StrTemplate("%1.%2 is an ext dimension value, and a path through it in the condition of a"
					+ " virtual table is built by the platform over the ext dimensions table of the register"
					+ " (an inner join and SELECT DISTINCT), which is not translated. Move the condition to"
					+ " WHERE over the selected ext dimension.", OwnerName, FieldName);
			EndIf;
		ElsIf ChangeTableOwner(OwnerName) <> Undefined Then
			FieldType = ChangeTableFieldType(OwnerName, FieldName);
		Else
			Raise StrTemplate("Metadata object %1 not found.", OwnerName);
		EndIf;
	EndIf;
	If FieldType = Undefined Then
		Raise StrTemplate("Cannot determine the composition of %1.%2.", OwnerName, FieldName);
	EndIf;

	Base = New Structure;
	Base.Insert("Alias", Resolved.Alias);
	Base.Insert("FieldName", Segment);
	Base.Insert("Descriptor", Resolved.Descriptor);

	Tail = New Array;
	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined Then
		Tail = Resolved.CompositeTail;
	EndIf;

	// Значение собрано из колонок ссылки и из присоединённых колонок каждой ветви.
	If Info <> Undefined Then
		Parts = New Array;
		Parts.Add(Info.TypeColumn);
		Parts.Add(Info.RefTypeColumn);
		Parts.Add(Info.RefColumn);
		For Each Part In Parts Do
			If Not IsBlankString(Part) Then
				AddGroupColumn(Context,
					FieldColumn(Resolved.Descriptor, Resolved.Alias, Part, Context));
			EndIf;
		EndDo;
	EndIf;

	Branches = New Array;
	Kinds = New Map;
	NativeRoles = New Map;
	For Each ItemType In FieldType.Types() Do
		Target = Metadata.FindByType(ItemType);
		If Target = Undefined Then
			Continue;
		EndIf;
		TargetDescriptor = TableDescriptor(Target.FullName());

		BranchField = TargetField;
		Composed = "";
		If IsBlankString(BranchField) And Tail.Count() = 0 And Info <> Undefined Then
			// Представление ветви-документа и ветви-перечисления - те же шаблоны, что у
			// одиночной ссылки (DocumentPresentation, EnumPresentation): у документа -
			// синоним, номер, слово и дата из присоединённой таблицы ветви, у перечисления -
			// ВЫБОР по ссылке. Прежде отказ: 29 запросов УХ и 12 ERP WE (перепись 49q).
			FullName = Target.FullName();
			If IsDocumentLike(FullName) And IsBlankString(PresentationFieldOf(TargetDescriptor, Target)) Then
				Composed = "Document";
			ElsIf StrStartsWith(Upper(FullName), "ENUM.") Or StrStartsWith(Upper(FullName), Upper("Перечисление.")) Then
				Composed = "Enum";
			EndIf;
		EndIf;
		If IsBlankString(BranchField) And IsBlankString(Composed) Then
			// Представление составной ссылки: у каждого типа своё поле показа.
			BranchField = PresentationFieldOf(TargetDescriptor, Target);
			If IsBlankString(BranchField) Then
				// Прежде здесь подставлялся первичный ключ, то есть сама ссылка, и об этом
				// писалось предупреждение. Замерено, что получалось: колонка приходит
				// строкой, а в ней байты ссылки - «辎Ⓖḑ쥙…» вместо
				// «Allocation of income by lines of business LS00-000001 dated 31/01/25».
				// Предупреждение читатель SQL не видит, а колонку видит, поэтому отказ.
				//
				// Размер класса измерен по корпусу: 8 запросов ERP и 27 УХ выдавали такой
				// мусор. Остальные представления переводятся как надо - у справочника это
				// наименование или код (PresentationFieldName), у перечисления ВЫБОР по
				// значениям, - и их 364 на ERP и 827 на УХ.
				//
				// Чтобы перевести представление документа, нужны синоним объекта, номер,
				// дата и локализованное слово между ними («dated», «от»); это отдельная
				// работа и отдельный замер.
				Raise StrTemplate(
					"The presentation of type %1 cannot be produced in SQL: it has no single"
					+ " presentation field, and the platform composes such a presentation after"
					+ " the query - for a document that is the object presentation, the number"
					+ " and the date. Returning the reference instead would come back as a"
					+ " string of unreadable bytes. Select the reference itself and resolve the"
					+ " presentation on the receiving side, or select the fields the"
					+ " presentation is built from - the number and the date.",
					Target.FullName());
			EndIf;
		EndIf;

		If Composed = "Enum" Then
			Reference = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context);
			TypeTest = CompositeTypeTest(Resolved.Descriptor, Resolved.Alias, Info,
				ReferenceTypeIdLiteral(Target.FullName(), Context), Context);
			Cases = New Array;
			For Each EnumValue In Target.EnumValues Do
				Shown = ?(IsBlankString(EnumValue.Synonym), EnumValue.Name, EnumValue.Synonym);
				Cases.Add("WHEN " + Reference + " = " + PredefinedValueLiteral(Target.FullName() + "."
					+ EnumValue.Name, Context) + " THEN " + TextLiteral(Shown, Context));
			EndDo;
			If Cases.Count() = 0 Then
				Continue;
			EndIf;
			Value = "(CASE " + StrConcat(Cases, " ") + " END)";
			If Not ThroughDot Then
				Value = "COALESCE(" + Value + ", " + TextLiteral("", Context) + ")";
			EndIf;
			Branches.Add("WHEN " + TypeTest + " THEN " + Value);
			Continue;
		EndIf;

		If Tail.Count() = 0 And IsBlankString(Composed)
			And TargetDescriptor.Fields.Get(Upper(TrimAll(BranchField))) = Undefined
			And Not (IsBlankString(Role) And IsPredefinedFlag(BranchField)
				And PredefinedColumn(TargetDescriptor) <> Undefined) Then
			// Без остатка пути нехватку поля видно сразу - лишнее соединение не строим. Исключение -
			// псевдополе Предопределенный: в хранении его нет, значение считает BranchPseudoField по
			// идентификатору предопределённых данных таблицы ветви. Замер pfp7 (20.11.2026, УХ,
			// `Б.Владелец.Предопределенный`): `CASE WHEN <тип 1> THEN CASE WHEN T2._PredefinedID IS NULL
			// THEN NULL WHEN T2._PredefinedID > @P THEN 0x01 ELSE 0x00 END WHEN <тип 2> THEN … ELSE NULL END`
			// - ветвь на каждый тип ссылки. При непустом остатке пути это работало и прежде (BranchValue).
			Continue;
		EndIf;

		If Role = "?" Or Role = "?1" Then
			// Пробный вызов NavigatedCompositeParts: состав частей по видам реквизита, без соединений.
			NoteNavigatedRoles(NativeRoles, ?(Tail.Count() = 0 And Not IsBlankString(TargetField),
				BranchFieldKind(Target, BranchField), Undefined), TargetDescriptor, BranchField);
			Continue;
		EndIf;

		If Tail.Count() = 0 And Not IsBlankString(TargetField) Then
			Kind = BranchFieldKind(Target, BranchField);
			If Kind <> Undefined And Kinds.Get(Kind) = Undefined Then
				Kinds.Insert(Kind, Target.FullName());
			EndIf;
		EndIf;

		TypeTest = CompositeTypeTest(Resolved.Descriptor, Resolved.Alias, Info,
			ReferenceTypeIdLiteral(Target.FullName(), Context), Context);

		Alias = CompositeHop(Base, Info, TargetDescriptor, TypeTest, Context);
		If Composed = "Document" Then
			Formats = Context.SessionFormats;
			If IsBlankString(Formats.DatePattern) Or IsBlankString(Formats.DateWord) Then
				Raise StrTemplate(
					"PRESENTATION of %1 cannot be translated: the platform builds the text from the"
					+ " regional settings of this infobase, and they are not among the measured"
					+ " ones. This session renders a date as %2 and True as %3. Select the number"
					+ " and the date instead, or build the presentation on the receiving side.",
					Target.FullName(), Formats.DateRendered, Formats.BooleanRendered);
			EndIf;
			AddOnce(Context.Warnings, StrTemplate(
				"PRESENTATION of %1 reproduces the platform template <object presentation> <number>"
				+ " %2 <date>. A configuration can redefine the presentation in the manager module,"
				+ " and such a redefinition is not reproduced in SQL.",
				Target.FullName(), Formats.DateWord));
			Value = DocumentPresentationText(TargetDescriptor, Alias, Target, Context);
			If Not ThroughDot Then
				Value = "COALESCE(" + Value + ", " + TextLiteral("", Context) + ")";
			EndIf;
			Branches.Add("WHEN " + TypeTest + " THEN " + Value);
			Continue;
		EndIf;
		Failure = "";
		Value = BranchValue(Alias, TargetDescriptor, Tail, BranchField, Context, Failure, Role);
		If IsBlankString(Value) Then
			// У этого типа такого пути нет - платформа его ветку тоже не строит.
			Continue;
		EndIf;
		AddGroupColumn(Context, Value);
		If IsBlankString(TargetField) And Not ThroughDot Then
			// Ветвь выбрана, значит тип ссылки известен: пустая ссылка даёт пустую
			// строку, а не NULL. NULL остаётся только там, где не подошла ни одна ветвь.
			Value = "COALESCE(" + Value + ", " + TextLiteral("", Context) + ")";
		EndIf;
		Branches.Add("WHEN " + TypeTest + " THEN " + Value);
	EndDo;

	If Role = "?" Or Role = "?1" Then
		Return NavigatedRolesText(NativeRoles, Role = "?1");
	EndIf;
	If Branches.Count() = 0 And IsPointInTimeField(TargetField) Then
		// Замеры pfp2-pfp5 (20.11.2026, УХ): МоментВремени через составную ссылку - не одно значение, а
		// набор колонок: дата документа ветви (`CASE WHEN <тип> THEN T2._Date_Time … END`), таблица
		// (`… THEN CASE WHEN T2._IDRRef IS NOT NULL THEN <таблица> END …`), ссылка (`… THEN T2._IDRRef …`)
		// и номер ветви. Сравнивает платформа пару: `дата <= дата AND (дата < дата OR дата = дата AND
		// (таблица < таблица OR таблица = таблица AND ссылка < ссылка))` (pfp4), группирует по всем
		// колонкам (pfp3). Одной датой, как у прямого пути, это не выразить: группировка и сравнение
		// на одной секунде разошлись бы молча. Поэтому отказ, но с причиной (перепись 49u: УХ 3, ERP WE 3).
		Raise StrTemplate(
			"%1.%2.%3 reads the point in time through a composite reference. The platform returns it as a"
			+ " pair - the date of the document and its reference, each taken by a CASE over the types of"
			+ " the reference - and compares, orders and groups by that pair. This translation gives a"
			+ " point in time as the date alone, which would group and compare differently for documents of"
			+ " one second, so it is not translated here. Select the reference itself, or the date of the"
			+ " document through CAST(%2 AS <document>).Date for each type.",
			Resolved.Descriptor.LogicalName, Segment, TargetField);
	EndIf;
	If Branches.Count() = 0 Then
		Raise StrTemplate("None of the types of composite field %1.%2 has field %3.",
			Resolved.Descriptor.LogicalName, Segment, TargetField);
	EndIf;
	// Поле одного имени у разных типов бывает разного вида: у одного владельца «Основание» -
	// ссылка, у другого - строка (УХ, ГИСМПрисоединенныеФайлы.ВладелецФайла.Основание,
	// Документ769 - nvarchar(300)). Платформа отдаёт тогда составное значение с частью под
	// каждый вид, а ветви здесь строят одну колонку: СУБД приводит её к строке, и байты
	// ссылок приходят текстом. Части по видам собирает NavigatedCompositeParts (колонка выборки,
	// ветвь ВЫБОРа и ЕСТЬNULL, сравнение со ссылкой); одной колонкой значение не выразить - отказ.
	If Kinds.Count() > 1 And Not (Not IsBlankString(Role) And MixedNavigationRoles(Context))
		And (Kinds.Get("String") <> Undefined Or Kinds.Get("Number") <> Undefined
		Or Kinds.Get("Date") <> Undefined Or Kinds.Get("Boolean") <> Undefined
		Or Kinds.Get("Other") <> Undefined) Then
		Described = New Array;
		For Each Pair In Kinds Do
			Described.Add(Pair.Key + " (" + Pair.Value + ")");
		EndDo;
		Raise StrTemplate("Field %3 of composite field %1.%2 is of different kinds in its types: %4."
			+ " The platform returns a composite value with a part for each kind, while this"
			+ " translation builds one column, and the DBMS would read the references as text."
			+ " Select the field of each type separately through ВЫРАЗИТЬ.",
			Resolved.Descriptor.LogicalName, Segment, TargetField, StrConcat(Described, ", "));
	EndIf;
	If IsBlankString(TargetField) And Not ThroughDot And Info <> Undefined
		And Not IsBlankString(Info.TypeColumn) And Resolved.Descriptor.IsDerived
		And (OriginOfResolved(Resolved) = Undefined Or IsCharacteristicValue(Resolved)) Then
		// Значение с тегом НЕОПРЕДЕЛЕНО, собранное ветвями, - не NULL: его представление пустая
		// строка (ERP WE, PostingTemplatesSetupForFinancialAccounting: FinancialAccountingGroup из
		// ветвей с UNDEFINED, тег 0x01 - у 1С "", без ветви - NULL; УХ gu4). У хранимого поля и у
		// колонки, взятой из него, НЕОПРЕДЕЛЕНО даёт NULL (замер gu1-gu3, 20.11.2026, УХ:
		// ДокументОснование с тегом 0x01 - ПРЕДСТАВЛЕНИЕ и .Представление у 1С NULL), и ветви 0x01
		// там нет. Литерал НЕОПРЕДЕЛЕНО без составной колонки сюда не попадает: он переводится в NULL.
		// Субконто виртуальной таблицы бухгалтерского регистра - значение вида характеристики, и
		// НЕОПРЕДЕЛЕНО у него тоже "" (замер px_dvsu, pn02a-c, 20.11.2026, УХ: ДвиженияССубконто,
		// Остатки, ОстаткиИОбороты - ""; обычное составное измерение регистра накопления в таблице
		// и в Оборотах - NULL, pa_1-pa_4).
		Branches.Add("WHEN " + FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.TypeColumn, Context)
			+ " = " + BinaryLiteral("01", Context) + " THEN " + TextLiteral("", Context));
	EndIf;

	Return "(CASE " + StrConcat(Branches, " ") + " END)";

EndFunction

// Вид значения поля у одного типа составной ссылки: Reference, String, Number, Date, Boolean,
// Other или Composite; Undefined, если тип поля по метаданным не прочитать.
// Вид значения по описанию типа - как BranchFieldKind.
Function KindOfTypeDescription(FieldType)

	Types = FieldType.Types();
	If Types.Count() <> 1 Then
		Return "Composite";
	EndIf;
	If Metadata.FindByType(Types[0]) <> Undefined Then
		Return "Reference";
	ElsIf Types[0] = Type("String") Then
		Return "String";
	ElsIf Types[0] = Type("Number") Then
		Return "Number";
	ElsIf Types[0] = Type("Date") Then
		Return "Date";
	ElsIf Types[0] = Type("Boolean") Then
		Return "Boolean";
	EndIf;
	Return "Other";

EndFunction

Function BranchFieldKind(Target, FieldName)

	FieldType = FieldTypeDescription(Target, FieldName);
	If FieldType = Undefined Then
		Return Undefined;
	EndIf;
	Types = FieldType.Types();
	If Types.Count() <> 1 Then
		Return "Composite";
	EndIf;
	If Metadata.FindByType(Types[0]) <> Undefined Then
		Return "Reference";
	ElsIf Types[0] = Type("String") Then
		Return "String";
	ElsIf Types[0] = Type("Number") Then
		Return "Number";
	ElsIf Types[0] = Type("Date") Then
		Return "Date";
	ElsIf Types[0] = Type("Boolean") Then
		Return "Boolean";
	EndIf;
	Return "Other";

EndFunction

// Внутри вызова функции булево поле остаётся полем, а не условием. Контекст здесь
// не копируется: в нём лежит счётчик псевдонимов, и копия развела бы нумерацию
// соединений, построенных внутри аргумента, с нумерацией внешнего запроса.
Function TranslateValue(Text, Context)

	Saved = Context.BooleanContext;
	Context.BooleanContext = False;
	Try
		Result = TranslateExpression(Text, Context);
	Except
		Context.BooleanContext = Saved;
		Raise;
	EndTry;
	Context.BooleanContext = Saved;
	Return Result;

EndFunction

// ПРЕДСТАВЛЕНИЕ. Замерено: в SQL представления нет вообще - платформа вытаскивает
// сырые части и склеивает строку у себя после чтения. Точного аналога поэтому не
// существует, и здесь выдаётся лучшее, что выражается в SQL: для справочника с
// представлением по наименованию или коду это ровно то же значение, для перечисления -
// ВЫБОР по ссылке с синонимами из метаданных, для документа - суррогат с предупреждением.
// ПРЕДСТАВЛЕНИЕ от параметра. У примитива представление - сам параметр, и перевод
// остаётся прежним. У ссылки представление берётся из таблицы-цели, а какая это таблица,
// по тексту запроса не видно: типа параметра в тексте нет, и схема его не знает - потому
// он и объявлен BINARY(16). Подставить сам параметр значило бы вернуть байты
// идентификатора там, где запрос ждёт наименование, поэтому здесь отказ с пояснением -
// так же поступает ParameterTypeLiteral с ТИПЗНАЧЕНИЯ от параметра без значения.
Procedure RefuseNonPrimitivePresentation(Path, Context)

	Trimmed = TrimAll(Path);
	If Not StrStartsWith(Trimmed, "&") Then
		Return;
	EndIf;

	Name = TrimAll(Mid(Trimmed, 2));
	Value = Undefined;
	If Context.Options.SubstituteParameters Then
		Value = Context.Options.ParameterValues.Get(Name);
	EndIf;

	If Value <> Undefined And IsPrimitiveValue(Value) Then
		Return;
	EndIf;

	Raise StrTemplate(
		"PRESENTATION of parameter %1 cannot be translated: the presentation is built from the"
		+ " target table, and the parameter carries no type in the query text. Supply a primitive"
		+ " value above, or select PRESENTATION of a field instead of the parameter.", Name);

EndProcedure

// ПРЕДСТАВЛЕНИЕ(&Параметр), когда значение параметра передано и это ссылка: таблица-цель
// известна по типу значения, само значение в SQL не зашивается - параметр остаётся
// параметром. Замер 17.11.2026 (УХ): у ссылки на справочник платформа соединяет таблицу
// по параметру - LEFT OUTER JOIN _Reference47 T2 ON (@P2 = T2._IDRRef) - и читает
// _Description; у перечисления передаёт сам параметр, а синоним подставляет после чтения.
// Документ и прочие виды - прежний отказ (шаблон по параметру не замерен). Undefined -
// значения нет или это не ссылка.
Function ParameterPresentation(Path, Context)

	Trimmed = TrimAll(Path);
	If Not StrStartsWith(Trimmed, "&") Then
		Return Undefined;
	EndIf;
	Name = TrimAll(Mid(Trimmed, 2));
	Value = Undefined;
	If Context.Options.Property("ParameterValues") And TypeOf(Context.Options.ParameterValues) = Type("Map") Then
		Value = Context.Options.ParameterValues.Get(Name);
	EndIf;
	Target = Undefined;
	If Value = Undefined Then
		// Значения нет, но тот же параметр сравнивается с полем-ссылкой одного типа
		// (`Т.Статус = &Статус`, УХ и ERP WE СформироватьЗапросПроверкиПриСменеСтатуса -
		// 100 запросов). Шаблон представления зависит только от таблицы-цели, поэтому
		// цель берётся из этого сравнения, а расхождение с ним оговаривается.
		Compared = ParameterComparedTarget(Name, Context);
		If IsBlankString(Compared) Then
			Return Undefined;
		EndIf;
		Target = Metadata.FindByFullName(Compared);
		If Target = Undefined Then
			Return Undefined;
		EndIf;
		AddOnce(Context.Warnings, StrTemplate(
			"PRESENTATION of parameter &%1 is built for %2: no value is supplied, and the query compares"
			+ " the parameter with a field of that type. If the value is of another type, the platform"
			+ " shows its presentation instead: supply the parameter value to be sure.",
			Name, Compared));
	ElsIf IsPrimitiveValue(Value) Then
		Return Undefined;
	Else
		Try
			Target = Value.Metadata();
		Except
			Return Undefined;
		EndTry;
	EndIf;
	If Target = Undefined Then
		Return Undefined;
	EndIf;
	FullName = Target.FullName();
	Column = TranslateValue(Trimmed, Context);

	If StrStartsWith(Upper(FullName), "ENUM.") Or StrStartsWith(Upper(FullName), Upper("Перечисление.")) Then
		Branches = New Array;
		For Each Item In Target.EnumValues Do
			Text = ?(IsBlankString(Item.Synonym), Item.Name, Item.Synonym);
			Branches.Add("WHEN " + Column + " = " + PredefinedValueLiteral(FullName + "." + Item.Name, Context)
				+ " THEN " + TextLiteral(Text, Context));
		EndDo;
		Branches.Add("WHEN " + Column + " = " + EmptyPartLiteral("_RRRef", Context)
			+ " THEN " + TextLiteral("", Context));
		Return "(CASE " + StrConcat(Branches, " ") + " END)";
	EndIf;

	If Not IsCatalogLike(FullName) Then
		Return Undefined;
	EndIf;
	FieldName = PresentationFieldOf(TableDescriptor(FullName), Target);
	If IsBlankString(FieldName) Then
		Return Undefined;
	EndIf;
	AddOnce(Context.Warnings, StrTemplate(
		"PRESENTATION of %1 returns the stored %2. If the configuration builds the presentation "
		+ "in the manager module, the platform shows something else.", FullName, FieldName));
	Stored = TranslateValue("CAST(" + Trimmed + " AS " + FullName + ")." + FieldName, Context);
	If IsCodeFieldName(FieldName) And IsNumericCode(Target) Then
		Stored = GroupedNumberText(Stored, Context);
	EndIf;
	If EmptyShownAsBrackets(FullName, FieldName) Then
		Stored = "(CASE WHEN " + Stored + " = " + TextLiteral("", Context) + " THEN "
			+ TextLiteral("<>", Context) + " ELSE " + Stored + " END)";
	EndIf;
	// Пустая ссылка строки цели не находит, а платформа показывает пустую строку; NULL - NULL.
	Return "(CASE WHEN " + Column + " IS NULL THEN NULL ELSE COALESCE(" + Stored + ", "
		+ TextLiteral("", Context) + ") END)";

EndFunction

// Таблица-цель параметра по его сравнению с полем-ссылкой одного типа в условиях
// текущего запроса - выборка, ГДЕ и условия соединений: `Поле = &П`, `&П = Поле`, `Поле <> &П`,
// `Поле В (&П)`. Цели всех таких сравнений должны совпасть. Пустая строка - сравнения
// нет или цели разные.
Function ParameterComparedTarget(Name, Context)

	If Not Context.Property("Operator") Or Context.Operator = Undefined Then
		Return "";
	EndIf;
	Texts = New Array;
	Try
		For Each Expression In Context.Operator.SelectedFields Do
			Texts.Add(String(Expression));
		EndDo;
		For Each Expression In Context.Operator.Filter Do
			Texts.Add(String(Expression));
		EndDo;
		For Each Source In Context.Operator.Sources Do
			For Each Join In Source.Joins Do
				Texts.Add(JoinConditionText(Join));
			EndDo;
		EndDo;
	Except
		Return "";
	EndTry;
	Found = "";
	Wanted = Upper(TrimAll(Name));
	For Each Text In Texts Do
		Tokens = Undefined;
		Try
			Tokens = Tokenize(Text);
		Except
			Continue;
		EndTry;
		Last = Tokens.Count() - 1;
		For Index = 0 To Last Do
			If Tokens[Index].Kind <> "Parameter" Or Upper(TrimAll(Tokens[Index].Value)) <> Wanted Then
				Continue;
			EndIf;
			Path = "";
			If Index >= 2 And (Tokens[Index - 1].Value = "=" Or Tokens[Index - 1].Value = "<>")
				And Tokens[Index - 2].Kind = "Name" Then
				Path = Tokens[Index - 2].Value;
			ElsIf Index + 2 <= Last And (Tokens[Index + 1].Value = "=" Or Tokens[Index + 1].Value = "<>")
				And Tokens[Index + 2].Kind = "Name" Then
				Path = Tokens[Index + 2].Value;
			ElsIf Index >= 3 And Tokens[Index - 1].Value = "(" And Index + 1 <= Last
				And Tokens[Index + 1].Value = ")" And Tokens[Index - 3].Kind = "Name"
				And (Upper(Tokens[Index - 2].Value) = "IN" Or Upper(Tokens[Index - 2].Value) = Upper("В")) Then
				Path = Tokens[Index - 3].Value;
			EndIf;
			If IsBlankString(Path) Or StrFind(Path, ".") = 0 Then
				Continue;
			EndIf;
			Target = Undefined;
			Try
				Resolved = ResolveField(Path, Context);
				If IsBlankString(Resolved.CompositeSegment)
					And CompositeInfo(Resolved.Descriptor, Resolved.FieldName) = Undefined Then
					Target = ReferenceTargetOf(Resolved);
				EndIf;
			Except
				Target = Undefined;
			EndTry;
			If Target = Undefined Then
				Return "";
			EndIf;
			If Not IsBlankString(Found) And Found <> Target.FullName() Then
				Return "";
			EndIf;
			Found = Target.FullName();
		EndDo;
	EndDo;
	Return Found;

EndFunction

Function IsPrimitiveValue(Value)

	Kind = TypeOf(Value);
	Return Kind = Type("String") Or Kind = Type("Number")
		Or Kind = Type("Date") Or Kind = Type("Boolean");

EndFunction

// ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(поле)). Замер mk_prtype_1, 2 (20.11.2026, УХ): в SQL платформа отдаёт
// только значение типа (`0x08 + _RecorderTRef`, `_TYPE + _RTRef`), имя типа подставляет после
// чтения - «Списание безналичных ДС», у пустого составного «Undefined». Здесь - ВЫБОР по значению
// типа с именами всех типов поля, как их даёт String(Тип) в этом сеансе. Undefined - аргумент не
// ТИПЗНАЧЕНИЯ от поля с известным составом типов.
Function ValueTypePresentation(Path, Context)

	Tokens = Tokenize(TrimAll(Path));
	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or Tokens[Tokens.Count() - 1].Value <> ")" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "VALUETYPE" And Word <> Upper("ТипЗначения") Then
		Return Undefined;
	EndIf;
	Inner = TrimAll(TokensText(Tokens, 2, Tokens.Count() - 2));
	Resolved = Undefined;
	Try
		Resolved = ResolveField(Inner, Context);
	Except
		Return Undefined;
	EndTry;
	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return Undefined;
	EndIf;
	FieldType = Undefined;
	If Resolved.Descriptor.IsDerived Then
		If Resolved.Descriptor.Property("DeclaredTypes") And Resolved.Descriptor.DeclaredTypes <> Undefined Then
			FieldType = Resolved.Descriptor.DeclaredTypes.Get(Upper(TrimAll(Resolved.FieldName)));
		EndIf;
		If FieldType = Undefined And Not (Resolved.Descriptor.Property("NumericSource")
			And Resolved.Descriptor.NumericSource <> Undefined) Then
			// Колонка виртуальной таблицы (описания типов и наполняющего запроса у неё нет): состав типов -
			// у поля регистра, из которого она взята. Замер qd3 (21.11.2026, УХ, `ПРЕДСТАВЛЕНИЕ(
			// ТИПЗНАЧЕНИЯ(Х.Регистратор))` над ОборотыДтКт): платформа отдаёт `0x08 + RecorderTRef`, имя
			// типа подставляет после чтения - та же форма, что у поля таблицы (mk_prtype_1).
			Origin = OriginOfResolved(Resolved);
			Owner = ?(Origin = Undefined, Undefined, MetadataOf(Origin.LogicalName));
			If Owner <> Undefined Then
				FieldType = FieldTypeDescription(Owner, Origin.FieldName);
			EndIf;
		EndIf;
	Else
		Owner = MetadataOf(Resolved.Descriptor.LogicalName);
		If Owner <> Undefined Then
			FieldType = FieldTypeDescription(Owner, Resolved.FieldName);
		EndIf;
	EndIf;
	If FieldType = Undefined Then
		Return Undefined;
	EndIf;
	Value = ValueTypeExpression(Inner, Context);
	Branches = New Array;
	Primitive = New Map;
	Primitive.Insert(Type("Boolean"), "02");
	Primitive.Insert(Type("Number"), "03");
	Primitive.Insert(Type("Date"), "04");
	Primitive.Insert(Type("String"), "05");
	For Each ItemType In FieldType.Types() Do
		If ItemType = Type("Null") Then
			Continue;
		EndIf;
		Literal = "";
		Meta = Metadata.FindByType(ItemType);
		If Meta <> Undefined Then
			Literal = TypeLiteral(Meta.FullName(), Context);
		ElsIf Primitive.Get(ItemType) <> Undefined Then
			Literal = BinaryLiteral(Primitive.Get(ItemType) + "00000000", Context);
		Else
			Return Undefined;
		EndIf;
		Branches.Add("WHEN " + Literal + " THEN " + TextLiteral(String(ItemType), Context));
	EndDo;
	If Branches.Count() = 0 Then
		Return Undefined;
	EndIf;
	Branches.Add("WHEN " + BinaryLiteral("0100000000", Context) + " THEN "
		+ TextLiteral(String(Type("Undefined")), Context));
	AddOnce(Context.Warnings, StrTemplate(
		"PRESENTATION(%1) is the name of the type, which the platform puts in after reading the rows;"
		+ " the SQL gives the names in the language of this session (%2 for UNDEFINED).",
		TrimAll(Path), String(Type("Undefined"))));
	Return "(CASE " + Value + " " + StrConcat(Branches, " ") + " END)";

EndFunction

// ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(Поле, Замена)). Замер mk_prisnlit_1-4, mk_prisn_1 (20.11.2026, УХ): платформа
// отдаёт значение частями и показывает представление того, что вышло, - строка «НеЗаполнен» сама,
// НЕОПРЕДЕЛЕНО пустой строкой, ТИПЗНАЧЕНИЯ - именем типа, ссылка - наименованием. Здесь - «Поле есть -
// его представление, иначе - представление замены». Undefined - форма не такая.
Function IsNullPresentation(Path, Context)

	Tokens = Tokenize(TrimAll(Path));
	If Tokens.Count() < 6 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or Tokens[Tokens.Count() - 1].Value <> ")" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "ISNULL" And Word <> Upper("ЕстьNULL") Then
		Return Undefined;
	EndIf;
	Depth = 0;
	Comma = 0;
	For Index = 2 To Tokens.Count() - 2 Do
		If Tokens[Index].Value = "(" Then
			Depth = Depth + 1;
		ElsIf Tokens[Index].Value = ")" Then
			Depth = Depth - 1;
		ElsIf Depth = 0 And Tokens[Index].Value = "," Then
			If Comma > 0 Then
				Return Undefined;
			EndIf;
			Comma = Index;
		EndIf;
	EndDo;
	If Comma = 0 Then
		Return Undefined;
	EndIf;
	First = TrimAll(TokensText(Tokens, 2, Comma - 1));
	Second = TrimAll(TokensText(Tokens, Comma + 1, Tokens.Count() - 2));
	If StrFind(First, "(") > 0 Or StrFind(First, ".") = 0 Then
		Return Undefined;
	EndIf;
	Shown = "";
	Literal = Tokenize(Second);
	If Literal.Count() = 1 And Literal[0].Kind = "String" Then
		Shown = TranslateExpression(Second, Context);
	ElsIf IsUndefinedLiteralText(Second) Then
		Shown = TextLiteral("", Context);
	ElsIf Not IsBlankString(PredefinedValueArgument(Second)) Then
		// ЗНАЧЕНИЕ(…) заменой: замер p15a, p15b (21.11.2026, УХ) - платформа соединяет таблицу по ISNULL(поле, ссылка)
		// и берёт поле показа; у пустой ссылки пары нет, и 1С показывает "", у предопределённого - его поле показа.
		Shown = PredefinedValuePresentation(Second, Context);
		If Shown = Undefined Then
			Return Undefined;
		EndIf;
	Else
		OfType = ValueTypePresentation(Second, Context);
		If OfType <> Undefined Then
			Shown = OfType;
		ElsIf StrFind(Second, "(") = 0 And StrFind(Second, ".") > 0 And Left(Second, 1) <> "&" Then
			Shown = PresentationExpression(Second, Context);
		ElsIf Left(Second, 1) = "&" Then
			// Представление замены-параметра - по виду его значения (замер pi01-pi03: соединение по ISNULL(поле,
			// @P), как у ЗНАЧЕНИЕ(...)); без значения вида нет.
			Name = TrimAll(Mid(Second, 2));
			If HierarchyParameterValue(Name, Context) = Undefined Then
				Raise StrTemplate(
					"PRESENTATION(%1): the presentation of the replacement %2 depends on the type of the parameter"
					+ " value, and no value is supplied. Supply the value of %2.", TrimAll(Path), Second);
			EndIf;
			Shown = ParameterPresentation(Second, Context);
			If Shown = Undefined Then
				Raise StrTemplate(
					"PRESENTATION(%1): the value of %2 is of a kind whose presentation as a replacement is not measured."
					+ " Select ISNULL(%3, %2) and PRESENTATION(%3) as separate columns.", TrimAll(Path), Second, First);
			EndIf;
		Else
			Return Undefined;
		EndIf;
	EndIf;
	Own = PresentationExpression(First, Context);
	Reference = FieldReference(First, Context);
	Return "(CASE WHEN " + Reference + " IS NULL THEN " + Shown + " ELSE " + Own + " END)";

EndFunction

// Представление ЗНАЧЕНИЕ(…): пустая ссылка - "", предопределённый элемент справочника, плана видов характеристик,
// счетов или видов расчёта - его поле показа, соединением по самой ссылке, как у ParameterPresentation (замер p15b).
// Undefined - значение другого вида (перечисление, документ, точка маршрута - не замерено).
Function PredefinedValuePresentation(Text, Context)

	Inside = PredefinedValueArgument(Text);
	If IsBlankString(Inside) Then
		Return Undefined;
	EndIf;
	Tail = Upper(Mid(Inside, StrFind(Inside, ".", SearchDirection.FromEnd) + 1));
	If Tail = "EMPTYREF" Or Tail = Upper("ПустаяСсылка") Then
		Return TextLiteral("", Context);
	EndIf;
	Origin = TypeOrigin(Inside, True);
	If Origin = Undefined Then
		Return Undefined;
	EndIf;
	Target = MetadataOf(Origin.LogicalName);
	If Target = Undefined Then
		Return Undefined;
	EndIf;
	FullName = Target.FullName();
	If Not IsCatalogLike(FullName) Or StrStartsWith(Upper(FullName), "EXCHANGEPLAN.")
		Or StrStartsWith(Upper(FullName), Upper("ПланОбмена.")) Then
		Return Undefined;
	EndIf;
	FieldName = PresentationFieldOf(TableDescriptor(FullName), Target);
	If IsBlankString(FieldName) Then
		Return Undefined;
	EndIf;
	Stored = TranslateValue("CAST(" + TrimAll(Text) + " AS " + FullName + ")." + FieldName, Context);
	If IsCodeFieldName(FieldName) And IsNumericCode(Target) Then
		Stored = GroupedNumberText(Stored, Context);
	EndIf;
	If EmptyShownAsBrackets(FullName, FieldName) Then
		Stored = "(CASE WHEN " + Stored + " = " + TextLiteral("", Context) + " THEN "
			+ TextLiteral("<>", Context) + " ELSE " + Stored + " END)";
	EndIf;
	Return "COALESCE(" + Stored + ", " + TextLiteral("", Context) + ")";

EndFunction

// ПРЕДСТАВЛЕНИЕ(ВЫБОР …) без параметров. Замер pv1, p15c-p15e (20-21.11.2026, УХ): значение ВЫБОР платформа отдаёт
// частями, соединяет таблицу каждой ссылочной ветви по её ссылке и берёт поле показа (`CASE WHEN … = 0x000000E6 THEN
// T2._Description WHEN … = 0x000000BC THEN T3._Description END`), строку отдаёт саму, прочие виды показывает после
// чтения. Здесь - ВЫБОР с теми же условиями, в ветви - представление её значения (ArmPresentation). Undefined - ветвь
// не такая (параметр, выражение): прежний отказ.
Function CasePresentation(Path, Context)

	Text = TrimAll(Path);
	Branches = Undefined;
	Try
		Branches = ExpressionBranches(Text);
	Except
		Return Undefined;
	EndTry;
	If Branches = Undefined Or Branches.Kind = "ISNULL" Or Branches.Conditions.Count() <> Branches.Arms.Count() Then
		Return Undefined;
	EndIf;
	Values = New Array;
	For Each Arm In Branches.Arms Do
		Shown = ArmPresentation(Arm, Context);
		If Shown = Undefined Then
			Return Undefined;
		EndIf;
		Values.Add(Shown);
	EndDo;
	ElseShown = "";
	If Not IsBlankString(Branches.Else_) Then
		ElseShown = ArmPresentation(Branches.Else_, Context);
		If ElseShown = Undefined Then
			Return Undefined;
		EndIf;
	EndIf;
	Pieces = New Array;
	Pieces.Add("(CASE");
	Saved = Context.BooleanContext;
	For Index = 0 To Branches.Conditions.Count() - 1 Do
		Condition = Branches.Conditions[Index];
		Context.BooleanContext = True;
		Try
			ConditionSql = TranslateExpression(Condition, Context);
		Except
			Context.BooleanContext = Saved;
			Raise;
		EndTry;
		Context.BooleanContext = Saved;
		Pieces.Add("WHEN " + ConditionSql + " THEN " + Values[Index]);
	EndDo;
	If Not IsBlankString(ElseShown) Then
		Pieces.Add("ELSE " + ElseShown);
	EndIf;
	Pieces.Add("END)");
	Return StrConcat(Pieces, " ");

EndFunction

// Представление значения ветви ВЫБОР: строковый литерал - он сам, НЕОПРЕДЕЛЕНО - "" (как у IsNullPresentation), NULL -
// NULL, поле - его ПРЕДСТАВЛЕНИЕ, ЗНАЧЕНИЕ(…) - PredefinedValuePresentation, вложенный ВЫБОР - CasePresentation.
// Undefined - ветвь другого вида.
Function ArmPresentation(Arm, Context)

	Trimmed = TrimAll(Arm);
	If Upper(Trimmed) = "NULL" Then
		Return "NULL";
	EndIf;
	If IsUndefinedLiteralText(Trimmed) Then
		Return TextLiteral("", Context);
	EndIf;
	ArmTokens = Tokenize(Trimmed);
	If ArmTokens.Count() = 0 Then
		Return Undefined;
	EndIf;
	If ArmTokens.Count() = 1 And ArmTokens[0].Kind = "String" Then
		Copy = Trimmed;
		Return TranslateExpression(Copy, Context);
	EndIf;
	If ArmTokens[0].Kind = "Name" And (Upper(ArmTokens[0].Value) = "CASE" Or Upper(ArmTokens[0].Value) = Upper("Выбор")) Then
		Return CasePresentation(Trimmed, Context);
	EndIf;
	If Not IsBlankString(PredefinedValueArgument(Trimmed)) Then
		Return PredefinedValuePresentation(Trimmed, Context);
	EndIf;
	If ArmTokens.Count() = 1 And ArmTokens[0].Kind = "Name" And StrFind(Trimmed, ".") > 0 Then
		Copy = Trimmed;
		Return PresentationExpression(Copy, Context);
	EndIf;
	Return Undefined;

EndFunction

// МИНИМУМ/МАКСИМУМ ссылки или составного значения со ссылками целиком: ПРЕДСТАВЛЕНИЕ такого агрегата платформа строит
// после чтения (замер mk_pragg_1). Перечисление одного типа сюда не относится - его переводит ReferenceExpressionPresentation.
Function IsAggregatedReference(Path, Context)

	Name = TopLevelAggregate(Path);
	If Name <> "MAX" And Name <> "MIN" And Name <> Upper("Максимум") And Name <> Upper("Минимум") Then
		Return False;
	EndIf;
	Tokens = Tokenize(TrimAll(Path));
	If Tokens.Count() < 4 Or Tokens[1].Value <> "(" Or MatchingParen(Tokens, 1) <> Tokens.Count() - 1 Then
		Return False;
	EndIf;
	Argument = TrimAll(TokensText(Tokens, 2, Tokens.Count() - 2));
	Try
		Copy = Argument;
		If CompositePartsOfExpression(Copy, Context).Parts.Count() > 0 Then
			Return True;
		EndIf;
		Copy = Argument;
		Target = SingleReferenceTarget(Copy, Context);
	Except
		Return False;
	EndTry;
	Return Not IsBlankString(Target) And Not StrStartsWith(Upper(Target), "ENUM.")
		And Not StrStartsWith(Upper(Target), Upper("Перечисление."));

EndFunction

// ПРЕДСТАВЛЕНИЕ выражения, которое даёт ссылку одной таблицы. Замеры 20.11.2026, УХ: mk_pragg_2 -
// `ПРЕДСТАВЛЕНИЕ(МАКСИМУМ(ЕСТЬNULL(перечисление, ЗНАЧЕНИЕ(…))))` платформа пишет как `MAX(ISNULL(T2._Fld…RRef,
// 0x…))`, синоним подставляет после чтения; mk_prcast_1 - `ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Д.Регистратор КАК
// Документ.Т).Валюта)`: соединение с документом по регистратору, со справочником по реквизиту и
// `T3._Description`, у строк другого типа - NULL. Здесь: МИНИМУМ/МАКСИМУМ над перечислением - ВЫБОР по
// значению агрегата с синонимами, как EnumPresentation; реквизит-ссылка на справочник после ВЫРАЗИТЬ -
// поле показа из той же цепочки соединений, по правилу PresentationEmptyRule. Агрегат над ссылкой на
// справочник (mk_pragg_1: `MIN(T1._Fld…RRef)`, наименование - после чтения) соединением в той же выборке
// не выражается. Undefined - выражение не такое.
Function ReferenceExpressionPresentation(Path, Context)

	Trimmed = TrimAll(Path);
	Tokens = Tokenize(Trimmed);
	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "(" Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	Aggregated = (Word = "MIN" Or Word = "MAX" Or Word = Upper("Минимум") Or Word = Upper("Максимум"))
		And MatchingParen(Tokens, 1) = Tokens.Count() - 1;
	If Aggregated Then
		TargetName = ExpressionReferenceTarget(TokensText(Tokens, 2, Tokens.Count() - 2), Context);
	Else
		Parsed = SplitCastPath(Trimmed);
		If Parsed = Undefined Or Parsed.Tail.Count() <> 1 Then
			Return Undefined;
		EndIf;
		TargetName = ExpressionReferenceTarget(Trimmed, Context);
	EndIf;
	If IsBlankString(TargetName) Or TargetName = "*" Then
		Return Undefined;
	EndIf;
	Target = MetadataOf(TargetName);
	If Target = Undefined Then
		Return Undefined;
	EndIf;
	FullName = Target.FullName();

	If Aggregated Then
		If Not StrStartsWith(Upper(FullName), "ENUM.") And Not StrStartsWith(Upper(FullName), Upper("Перечисление.")) Then
			// Замер mk_pragg_1 (20.11.2026, УХ): платформа читает в SQL только агрегат ссылки
			// (`MIN(T1._Fld…RRef)`), а представление достраивает после чтения - в SQL его нет.
			Raise StrTemplate(
				"PRESENTATION(%1) is not translated: the platform reads only the aggregate of the reference"
				+ " (MIN/MAX of its column) and builds the presentation of %2 after reading the rows - there is"
				+ " no SQL to reproduce. Select the aggregate of the reference and join its Description.",
				Trimmed, FullName);
		EndIf;
		Copy = Trimmed;
		Value = TranslateExpression(Copy, Context);
		Branches = New Array;
		For Each EnumValue In Target.EnumValues Do
			Shown = ?(IsBlankString(EnumValue.Synonym), EnumValue.Name, EnumValue.Synonym);
			Branches.Add("WHEN " + PredefinedValueLiteral(FullName + "." + EnumValue.Name, Context)
				+ " THEN " + TextLiteral(Shown, Context));
		EndDo;
		If Branches.Count() = 0 Then
			Return Undefined;
		EndIf;
		// Пустая ссылка - пустая строка, как у ПРЕДСТАВЛЕНИЕ поля (EnumPresentation).
		Branches.Add("WHEN " + EmptyPartLiteral("_RRRef", Context) + " THEN " + TextLiteral("", Context));
		Return "(CASE " + Value + " " + StrConcat(Branches, " ") + " END)";
	EndIf;

	If Not IsCatalogLike(FullName) Or StrStartsWith(Upper(FullName), "EXCHANGEPLAN.")
		Or StrStartsWith(Upper(FullName), Upper("ПланОбмена.")) Then
		Return Undefined;
	EndIf;
	FieldName = PresentationFieldOf(TableDescriptor(FullName), Target);
	If IsBlankString(FieldName) Then
		Return Undefined;
	EndIf;
	AddOnce(Context.Warnings, StrTemplate(
		"PRESENTATION of %1 returns the stored %2. If the configuration builds the presentation "
		+ "in the manager module, the platform shows something else.", FullName, FieldName));
	Copy = Trimmed;
	Reference = TranslateExpression(Copy, Context);
	Copy = Trimmed + "." + FieldName;
	Stored = TranslateExpression(Copy, Context);
	If IsCodeFieldName(FieldName) And IsNumericCode(Target) Then
		Stored = GroupedNumberText(Stored, Context);
	EndIf;
	Result = "(CASE WHEN " + Reference + " IS NULL THEN NULL ELSE COALESCE("
		+ Stored + ", " + TextLiteral("", Context) + ") END)";
	Context.PresentationGrouping.Insert(Result, Reference);
	NotePresentationFacts(Context, Result, FullName, False, False);
	Return Result;

EndFunction

// ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ссылка)). Замер pu2, pu3 (20.11.2026, УХ): в SQL платформа
// выбирает только колонку ссылки (`T1._ParentIDRRef`, `T2._IDRRef`), строку 8-4-4-4-12 строит после
// чтения; у пустой ссылки - «00000000-0000-0000-0000-000000000000», у NULL со стороны соединения - NULL.
// Ту же строку уже даёт перевод УНИКАЛЬНЫЙИДЕНТИФИКАТОР (UuidFunction), и NULL он сохраняет. Undefined -
// выражение не такое.
Function UuidPresentation(Path, Context)

	Tokens = Tokenize(TrimAll(Path));
	If Tokens.Count() < 4 Or Tokens[0].Kind <> "Name" Or Tokens[1].Value <> "("
		Or MatchingParen(Tokens, 1) <> Tokens.Count() - 1 Then
		Return Undefined;
	EndIf;
	Word = Upper(Tokens[0].Value);
	If Word <> "UUID" And Word <> Upper("УникальныйИдентификатор") Then
		Return Undefined;
	EndIf;
	Return TranslateValue(TrimAll(Path), Context);

EndFunction

// Все значения ветвей ВЫБОР верхнего уровня (после ТОГДА и ИНАЧЕ) - строковые литералы, NULL или поля строкового
// типа. Представление строки - она сама (замер px1, px2, 20.11.2026, УХ), поэтому такой ВЫБОР переводится своим
// значением; иначе Ложь.
Function CaseBranchesAreStrings(Tokens, Context)

	Values = New Array;
	Depth = 0;
	Nesting = 0;
	Start = -1;
	For Index = 1 To Tokens.Count() - 1 Do
		Token = Tokens[Index];
		Word = ?(Token.Kind = "Name", Upper(Token.Value), "");
		If Token.Kind = "Symbol" And Token.Value = "(" Then
			Depth = Depth + 1;
			Continue;
		ElsIf Token.Kind = "Symbol" And Token.Value = ")" Then
			Depth = Depth - 1;
			Continue;
		EndIf;
		If Word = "CASE" Or Word = Upper("Выбор") Then
			Nesting = Nesting + 1;
			Continue;
		EndIf;
		IsEnd = (Word = "END" Or Word = Upper("Конец"));
		If IsEnd And Nesting > 0 Then
			Nesting = Nesting - 1;
			Continue;
		EndIf;
		If Depth > 0 Or Nesting > 0 Then
			Continue;
		EndIf;
		IsElse = (Word = "ELSE" Or Word = Upper("Иначе"));
		If (IsEnd Or IsElse Or Word = "WHEN" Or Word = Upper("Когда")) And Start >= 0 Then
			If Index - 1 < Start Then
				Return False;
			EndIf;
			Values.Add(TrimAll(TokensText(Tokens, Start, Index - 1)));
			Start = -1;
		EndIf;
		If IsElse Or Word = "THEN" Or Word = Upper("Тогда") Then
			Start = Index + 1;
		EndIf;
	EndDo;
	If Values.Count() = 0 Then
		Return False;
	EndIf;
	For Each Value In Values Do
		ValueTokens = Tokenize(Value);
		If ValueTokens.Count() = 1 And (ValueTokens[0].Kind = "String" Or Upper(ValueTokens[0].Value) = "NULL") Then
			Continue;
		EndIf;
		Copy = Value;
		SqlType = Upper(TrimAll(SqlTypeOfPath(Copy, Context)));
		If StrStartsWith(SqlType, "NVARCHAR") Or StrStartsWith(SqlType, "NCHAR") Or StrStartsWith(SqlType, "NTEXT") Then
			Continue;
		EndIf;
		Return False;
	EndDo;
	Return True;

EndFunction

// Показывает ли платформа пустое поле показа как «<>». Узел плана обмена - замерено (polish27b
// prestpl); элемент справочника с полем показа Наименование - замер em1 (20.11.2026, УХ): SQL
// читает пустое `_Description`, «<>» подставляется после чтения. Код и прочие виды объектов не
// замерены - там пустая строка, как прежде.
Function EmptyShownAsBrackets(FullName, FieldName)

	Name = Upper(FullName);
	If StrStartsWith(Name, "EXCHANGEPLAN.") Or StrStartsWith(Name, Upper("ПланОбмена.")) Then
		Return True;
	EndIf;
	Return (StrStartsWith(Name, "CATALOG.") Or StrStartsWith(Name, Upper("Справочник.")))
		And (Upper(FieldName) = "DESCRIPTION" Or Upper(FieldName) = Upper("Наименование"));

EndFunction

// ThroughDot - поле Представление через точку, а не функция ПРЕДСТАВЛЕНИЕ: см. PresentationEmptyRule.
Function PresentationExpression(Path, Context, ThroughDot = False)

	Resolved = Undefined;
	Try
		Resolved = ResolveField(Path, Context);
	Except
		// Аргументом бывает не поле, а параметр, литерал или псевдоним выборки.
		// Для примитивного значения представление - оно само; у ссылки представление
		// собирается из таблицы-цели, а её по параметру без значения не узнать.
		OfParameter = ParameterPresentation(Path, Context);
		If OfParameter <> Undefined Then
			Return OfParameter;
		EndIf;
		RefuseNonPrimitivePresentation(Path, Context);
		OfType = ValueTypePresentation(Path, Context);
		If OfType <> Undefined Then
			Return OfType;
		EndIf;
		OfIsNull = IsNullPresentation(Path, Context);
		If OfIsNull <> Undefined Then
			Return OfIsNull;
		EndIf;
		OfUuid = UuidPresentation(Path, Context);
		If OfUuid <> Undefined Then
			Return OfUuid;
		EndIf;
		OfReference = ReferenceExpressionPresentation(Path, Context);
		If OfReference <> Undefined Then
			Return OfReference;
		EndIf;
		CaseTokens = Tokenize(TrimAll(Path));
		IsCaseExpression = CaseTokens.Count() > 0 And CaseTokens[0].Kind = "Name"
			And (Upper(CaseTokens[0].Value) = "CASE" Or Upper(CaseTokens[0].Value) = Upper("Выбор"));
		If IsCaseExpression And (StrFind(Path, "(") > 0 Or Not CaseBranchesAreStrings(CaseTokens, Context)) Then
			OfCase = CasePresentation(Path, Context);
			If OfCase <> Undefined Then
				Return OfCase;
			EndIf;
		EndIf;
		If StrFind(Path, "(") = 0 And CaseTokens.Count() > 0 And CaseTokens[0].Kind = "Name"
			And (Upper(CaseTokens[0].Value) = "CASE" Or Upper(CaseTokens[0].Value) = Upper("Выбор"))
			And Not CaseBranchesAreStrings(CaseTokens, Context) Then
			// ВЫБОР без скобок шёл ниже в TranslateValue - значение вместо представления: у ветви-ссылки
			// байты ссылки, у даты и числа - не формат сеанса. Замер pv1, px3-px5 (20.11.2026, УХ): платформа
			// отдаёт значение и строит представление вида после чтения. Строка и NULL - прежний перевод.
			Raise StrTemplate(
				"PRESENTATION(%1) is not translated: a branch of the CASE is not a string, and the platform"
				+ " builds the presentation of a reference, a date, a number or a boolean after reading the"
				+ " rows - the value itself would come back instead. Select PRESENTATION of each branch field"
				+ " in its own CASE branch.", TrimAll(Path));
		EndIf;
		If StrFind(Path, "(") > 0 And CaseTokens.Count() > 0 And CaseTokens[0].Kind = "Name"
			And (Upper(CaseTokens[0].Value) = "CASE" Or Upper(CaseTokens[0].Value) = Upper("Выбор")) Then
			// Замер pv1 (20.11.2026, УХ): значение ВЫБОР платформа отдаёт частями (тег, строка, ссылка), а
			// представление каждого вида строит после чтения. Перевод этой формы не сделан; без значения
			// параметра в ветви неизвестен даже вид ветви - тогда отказ законен. Условие «есть скобка» -
			// то же, что у прежнего отказа ниже: меняется только текст.
			Missing = "";
			For Each Token In CaseTokens Do
				If Token.Kind <> "Parameter" Then
					Continue;
				EndIf;
				Supplied = Undefined;
				If Context.Options.Property("ParameterValues")
					And TypeOf(Context.Options.ParameterValues) = Type("Map") Then
					Supplied = Context.Options.ParameterValues.Get(TrimAll(Token.Value));
				EndIf;
				If Supplied = Undefined Then
					Missing = TrimAll(Token.Value);
					Break;
				EndIf;
			EndDo;
			Raise StrTemplate(
				"PRESENTATION(%1) is not translated: the platform returns the value of the CASE in parts"
				+ " (type tag, string, reference) and builds the presentation of each kind after reading the"
				+ " rows.%2 Select the branches as separate columns, or PRESENTATION of the field itself.",
				TrimAll(Path), ?(IsBlankString(Missing), "", " Parameter &" + Missing + " has no value, so even"
				+ " the kind of value of its branch is unknown."));
		EndIf;
		If StrFind(Path, "(") > 0 And IsAggregatedReference(Path, Context) Then
			Raise StrTemplate(
				"PRESENTATION(%1) is not translated: the platform reads only the aggregate of the value (MIN/MAX of its"
				+ " columns) and builds its presentation after reading the rows (measured) - there is no SQL to"
				+ " reproduce. Select the aggregate and take its presentation in a following query.", TrimAll(Path));
		EndIf;
		If StrFind(Path, "(") > 0 Then
			// Выражение (ЕСТЬNULL, ВЫРАЗИТЬ, ВЫБОР) чаще всего даёт ссылку, и тогда
			// перевод отдавал бы байты ссылки вместо наименования (сверка battery27:
			// значения не совпали). Таблицу-цель выражения здесь не выводим - отказ.
			Raise StrTemplate(
				"PRESENTATION(%1) takes an expression, and its presentation is built from the table"
				+ " the value refers to, which is not derived for an expression here. Select the"
				+ " field itself, or narrow the expression with CAST to one table and take a field"
				+ " of it, such as Description.", TrimAll(Path));
		EndIf;
		// Число и булево показываются строкой по формату сеанса, как и у поля ниже (polish27b pres:
		// «ПРЕДСТАВЛЕНИЕ(1234.5)» - ERP WE "1.234,5", УХ "1,234.5"; «ПРЕДСТАВЛЕНИЕ(ИСТИНА)» - "Yes";
		// перевод отдавал само значение). Булево - словом сеанса, как у булева поля; число - отказ,
		// как у числового поля.
		Literal = Tokenize(TrimAll(Path));
		If Literal.Count() = 2 And Literal[0].Value = "-" Then
			Literal.Delete(0);
		EndIf;
		If Literal.Count() = 1 And Literal[0].Kind = "Number" Then
			// Замер sm_pr7, sm_wpr1 (21.11.2026): платформа шлёт в СУБД само число (`@P1` numeric(38,8)) и
			// складывает «1 234,5» после запроса.
			Raise StrTemplate(
				"PRESENTATION(%1) of a number: the platform sends the number itself to the DBMS and turns it"
				+ " into text after the query, by the session settings (measured), so the SQL has no such"
				+ " column. Put the text you need as a string literal.", TrimAll(Path));
		EndIf;
		If Literal.Count() = 1 And Literal[0].Kind = "Name" Then
			Word = Upper(Literal[0].Value);
			If Word = "TRUE" Or Word = Upper("Истина") Or Word = "FALSE" Or Word = Upper("Ложь") Then
				Return TextLiteral(String(Word = "TRUE" Or Word = Upper("Истина")), Context);
			EndIf;
		EndIf;
		Return TranslateValue(Path, Context);
	EndTry;

	If Not IsBlankString(Resolved.CompositeSegment) Then
		Return CompositeTailPresentation(Path, Resolved, Context, ThroughDot);
	EndIf;

	Info = CompositeInfo(Resolved.Descriptor, Resolved.FieldName);
	If Info <> Undefined Then
		Result = CompositeNavigation(Resolved, Resolved.FieldName, "", Context, "", ThroughDot);
		// Замер gp1, gp2 (20.11.2026, УХ): СГРУППИРОВАТЬ ПО ПРЕДСТАВЛЕНИЕ(составное) - группировка по частям
		// ссылки, представление платформа строит после чтения. Заявляется первая часть (тег, у поля без тега -
		// таблица ссылки); остальные части и колонки ветвей добирает OperatorBlock как определяемые ею.
		// Колонки частей ссылки: по ним РАЗЛИЧНЫЕ различает строки (замер op8), DistinctPresentationColumns
		// проверяет, что они все выбраны.
		CompositeParts = New Array;
		For Each PartColumn In StrSplit(Info.TypeColumn + "," + Info.RefTypeColumn + "," + Info.RefColumn, ",", False) Do
			CompositeParts.Add(FieldColumn(Resolved.Descriptor, Resolved.Alias, PartColumn, Context));
		EndDo;
		Context.CompositePresentations.Insert(Result, CompositeParts);
		NotePresentationFacts(Context, Result, "", ThroughDot, Not IsBlankString(Info.BooleanColumn + Info.NumberColumn
			+ Info.DateColumn + Info.StringColumn));
		Claim = ?(IsBlankString(Info.TypeColumn), Info.RefTypeColumn, Info.TypeColumn);
		If Not IsBlankString(Claim) Then
			Context.PresentationGrouping.Insert(Result,
				FieldColumn(Resolved.Descriptor, Resolved.Alias, Claim, Context));
		EndIf;
		Return Result;
	EndIf;

	Target = ReferenceTargetOf(Resolved);
	If Target = Undefined Then
		// Булево: в результате 1С - слово языка интерфейса («Yes»/«No»), а не 0x01/0x00
		// (сверка battery27: значения не совпали). Слова берутся из сеанса, как и слово
		// между номером и датой в представлении документа.
		Copy = Path;
		SqlType = Upper(TrimAll(SqlTypeOfPath(Copy, Context, False)));
		If IsPointInTimeField(Resolved.FieldName) Then
			// У 1С это «дата; представление документа» (сверка dbg32), здесь была бы одна дата.
			Raise StrTemplate(
				"PRESENTATION(%1) of a point in time is the date and the document presentation"
				+ " joined by «; », and this translation does not build it. Select the date and"
				+ " PRESENTATION of the document separately.", TrimAll(Path));
		EndIf;
		If SqlType = "DATETIME2" Then
			// Дата: в результате 1С - строка в формате сеанса («02.10.2023 12:50:20»), а не
			// значение даты (сверка dbg32). У пустой даты представление пустое.
			Column = FieldReference(Path, Context);
			Return "(CASE WHEN " + Column + " = " + EmptyPartLiteral("_T", Context) + " THEN "
				+ TextLiteral("", Context) + " ELSE " + SessionDateText(Column, Context) + " END)";
		EndIf;
		If StrStartsWith(SqlType, "NUMERIC") Then
			// Число: в результате 1С - строка с разделителями разрядов по формату сеанса. Замер sm_pr1
			// (21.11.2026, УХ): платформа читает само поле (`T1._Fld24008`) и строку складывает после
			// запроса; в ГДЕ и УПОРЯДОЧИТЬ такое выражение она отвергает сама (sm_pr2, sm_pr4, sm_pr6).
			Raise StrTemplate(
				"PRESENTATION(%1) of a number: the platform reads the number itself and turns it into text"
				+ " after the query, by the session settings (measured), so the SQL has no such column."
				+ " Select the number itself, or STRING(%1), which the DBMS formats.", TrimAll(Path));
		EndIf;
		If SqlType = "BINARY(1)" Then
			Column = FieldReference(Path, Context);
			Return "(CASE WHEN " + Column + " = " + BooleanLiteral(True, Context) + " THEN "
				+ TextLiteral(String(True), Context) + " WHEN " + Column + " = "
				+ BooleanLiteral(False, Context) + " THEN " + TextLiteral(String(False), Context) + " END)";
		EndIf;
		// Прочий примитив: представление вырождается в само поле, так делает и платформа.
		Return FieldReference(Path, Context);
	EndIf;

	Return PresentationOfTarget(Path, Resolved, Target, Context, ThroughDot);

EndFunction

// ПРЕДСТАВЛЕНИЕ поля, взятого через составную ссылку: `ПРЕДСТАВЛЕНИЕ(Т.Распоряжение.Организация)`,
// `ПРЕДСТАВЛЕНИЕ(Т.Распоряжение.Организация.Префикс)`. Замер ppr8 (21.11.2026, УХ): значение поля платформа берёт
// ВЫБОРом по типам составной ссылки (тип без такого поля ветви не получает), а представление строит после чтения - у
// ссылки по присоединённой таблице цели (`LEFT JOIN … ON CASE … END = T11._IDRRef`, `T11._Description`). Здесь -
// представление поля одной таблицы (PresentationOfTarget), когда у всех типов поле - ссылка на одну и ту же таблицу,
// и само значение, когда оно у всех типов строка. Прочие сочетания не замерены - отказ.
Function CompositeTailPresentation(Path, Resolved, Context, ThroughDot)

	FieldType = CompositeFieldType(Resolved.Descriptor, Resolved.CompositeSegment);
	Tail = New Array;
	If Resolved.Property("CompositeTail") And Resolved.CompositeTail <> Undefined Then
		For Each Item In Resolved.CompositeTail Do
			Tail.Add(Item);
		EndDo;
	EndIf;
	Tail.Add(Resolved.FieldName);
	Kinds = New Map;
	Target = Undefined;
	If FieldType <> Undefined Then
		For Each ItemType In FieldType.Types() Do
			Owner = Metadata.FindByType(ItemType);
			If Owner = Undefined Then
				Continue;
			EndIf;
			For Each Branch In BranchFieldTypes(Owner.FullName(), Tail) Do
				Types = Branch.Types();
				If Types.Count() <> 1 Then
					Kinds.Insert("Composite", True);
				ElsIf Types[0] = Type("String") Then
					Kinds.Insert("String", True);
				Else
					Target = Metadata.FindByType(Types[0]);
					Kinds.Insert(?(Target = Undefined, "Other", Upper(Target.FullName())), True);
				EndIf;
			EndDo;
		EndDo;
	EndIf;
	If Kinds.Count() = 1 And Kinds.Get("String") <> Undefined Then
		Return FieldReference(Path, Context);
	EndIf;
	If Kinds.Count() = 1 And Target <> Undefined And Kinds.Get(Upper(Target.FullName())) <> Undefined
		And Not IsDocumentLike(Target.FullName()) Then
		Return PresentationOfTarget(Path, Resolved, Target, Context, ThroughDot);
	EndIf;
	Raise StrTemplate(
		"PRESENTATION(%1) reads a field through a composite reference, and that field is not a reference to one and the"
		+ " same table, nor a string, in every type of the reference (or its type cannot be derived). The platform builds"
		+ " such a presentation after reading the rows, for each kind of value separately; that is not measured. Select"
		+ " PRESENTATION of the field of each type through CAST.", TrimAll(Path));

EndFunction

Function PresentationOfTarget(Path, Resolved, Target, Context, ThroughDot = False)

	FullName = Target.FullName();

	If StrStartsWith(Upper(FullName), "ENUM.") Or StrStartsWith(Upper(FullName), Upper("Перечисление.")) Then
		Return EnumPresentation(Path, Target, Context, ThroughDot);
	EndIf;

	FieldName = PresentationFieldOf(TableDescriptor(Target.FullName()), Target);
	If Not IsBlankString(FieldName) Then
		// Конфигурация может собирать представление в модуле менеджера
		// (ОбработкаПолученияПредставления). Такой код в SQL не переводится, и тогда
		// запрос вернёт только то, что лежит в базе. Молчать об этом нельзя.
		AddOnce(Context.Warnings, StrTemplate(
			"PRESENTATION of %1 returns the stored %2. If the configuration builds the presentation "
			+ "in the manager module, the platform shows something else.", Target.FullName(), FieldName));
		// Пустая ссылка ни на что не указывает, соединение строки не находит, а
		// платформа показывает пустую строку.
		Stored = FieldReference(Path + "." + FieldName, Context);
		// Числовой код платформа показывает с разделителями разрядов, а не цифрами
		// подряд: замерено на справочнике с основным представлением «в виде кода».
		If IsCodeFieldName(FieldName) And IsNumericCode(Target) Then
			Stored = GroupedNumberText(Stored, Context);
		EndIf;
		If EmptyShownAsBrackets(FullName, FieldName) Then
			// Узел с пустым наименованием платформа показывает «<>», и через точку тоже (polish27b
			// prestpl: ERP WE ApplicationsMigration и DataSynchronizationViaUniversalFormat, УХ
			// ЗапросыНалоговогоМонитора - 1С "<>", перевод ""). Элемент справочника - так же
			// (замер em1, 20.11.2026, УХ: Контрагенты с пустым наименованием - «<>» у
			// .Представление и ПРЕДСТАВЛЕНИЕ()).
			Stored = "(CASE WHEN " + Stored + " = " + TextLiteral("", Context) + " THEN "
				+ TextLiteral("<>", Context) + " ELSE " + Stored + " END)";
		EndIf;
		Shown = PresentationEmptyRule(Path, Stored, Context, ThroughDot);
		NotePresentationFacts(Context, Shown, FullName, ThroughDot, False);
		Return Shown;
	EndIf;

	If IsDocumentLike(FullName) Then
		Return DocumentPresentation(Path, Target, Context, ThroughDot);
	EndIf;

	If IsCatalogLike(FullName) Then
		// Поля показа нет - платформа показывает «<>» на каждой строке. Это не заглушка
		// вместо перевода, а измеренный ответ платформы.
		AddOnce(Context.Warnings, StrTemplate(
			"PRESENTATION of %1 is the literal <>: the type has no presentation field."
			+ " If the configuration builds the presentation in the manager module,"
			+ " the platform shows something else.", Target.FullName()));
		Return TextLiteral("<>", Context);
	EndIf;

	Raise StrTemplate(
		"PRESENTATION of %1 cannot be translated: the platform composes it after the query,"
		+ " and the template for this kind of object has not been measured. Select the"
		+ " fields the presentation is built from, or build the presentation on the"
		+ " receiving side.", Target.FullName());

EndFunction

// Документ: вид, номер и дата. Деловой процесс и задача сюда не входят - их шаблон
// не замерен, и подставлять им шаблон документа нельзя.
Function IsDocumentLike(FullName)

	Normalized = Upper(FullName);
	Return StrStartsWith(Normalized, "DOCUMENT.")
		Or StrStartsWith(Normalized, Upper("Документ."));

EndFunction

// Типы, у которых представление - поле базы: там работает правило «наименование, код
// или «<>»».
Function IsCatalogLike(FullName)

	Normalized = Upper(FullName);
	Prefixes = New Array;
	Prefixes.Add("CATALOG.");
	Prefixes.Add(Upper("Справочник."));
	Prefixes.Add("CHARTOFCHARACTERISTICTYPES.");
	Prefixes.Add(Upper("ПланВидовХарактеристик."));
	Prefixes.Add("CHARTOFACCOUNTS.");
	Prefixes.Add(Upper("ПланСчетов."));
	Prefixes.Add("CHARTOFCALCULATIONTYPES.");
	Prefixes.Add(Upper("ПланВидовРасчета."));
	Prefixes.Add("EXCHANGEPLAN.");
	Prefixes.Add(Upper("ПланОбмена."));
	For Each Prefix In Prefixes Do
		If StrStartsWith(Normalized, Prefix) Then
			Return True;
		EndIf;
	EndDo;
	Return False;

EndFunction

// Имя поля - код: PresentationFieldOf отдаёт имя на языке конфигурации, "Код" или "Code".
Function IsCodeFieldName(Name)

	Return Upper(Name) = "CODE" Or Upper(Name) = Upper("Код");

EndFunction

// Поле показа с учётом языка конфигурации: наименование или код.
Function PresentationFieldOf(Descriptor, Target)

	Wanted = PresentationFieldName(Target);
	If IsBlankString(Wanted) Then
		Return "";
	EndIf;

	Names = New Array;
	If Wanted = "Code" Then
		Names.Add("Code");
		Names.Add("Код");
	Else
		Names.Add("Description");
		Names.Add("Наименование");
	EndIf;

	Actual = FirstExistingField(Descriptor, Names);
	Return ?(IsBlankString(Actual), Wanted, Actual);

EndFunction

// Какое поле показывает 1С вместо ссылки. Справочник с основным представлением
// "в виде кода" отдаёт код, остальные - наименование.
Function PresentationFieldName(Target)

	// Свойство называется DefaultPresentation, а перечисление - своё на каждый вид
	// объекта; значения разных перечислений сравниваются молча как неравные, поэтому
	// перебор безопасен. Прежний код спрашивал MainPresentation и перечисление
	// ChartOfCharacteristicTypesMainPresentation - таких имён в платформе нет, Try их
	// проглатывал, и эта ветка не срабатывала никогда.
	Presentation = Undefined;
	Try
		Presentation = Target.DefaultPresentation;
	Except
	EndTry;
	// «В виде кода» при нулевой длине кода означает не код, а отсутствие поля показа:
	// платформа и там показывает «<>» - замерено.
	CodeLength = 0;
	Try
		CodeLength = Target.CodeLength;
	Except
	EndTry;
	If Presentation <> Undefined And CodeLength > 0 Then
		Variants = New Array;
		Variants.Add(Metadata.ObjectProperties.CatalogMainPresentation.AsCode);
		Variants.Add(Metadata.ObjectProperties.CharacteristicTypeMainPresentation.AsCode);
		Variants.Add(Metadata.ObjectProperties.AccountMainPresentation.AsCode);
		Variants.Add(Metadata.ObjectProperties.CalculationTypeMainPresentation.AsCode);
		Variants.Add(Metadata.ObjectProperties.DataExchangeMainPresentation.AsCode);
		For Each Variant In Variants Do
			If Presentation = Variant Then
				Return "Code";
			EndIf;
		EndDo;
	EndIf;

	// Нулевая длина наименования означает не «возьмём код», а «поля показа нет»:
	// платформа показывает «<>» даже тогда, когда код есть и заполнен. Замерено на
	// одноразовой базе двумя справочниками - без кода и с числовым кодом.
	Try
		If Target.DescriptionLength > 0 Then
			Return "Description";
		EndIf;
		Return "";
	Except
	EndTry;

	Return "";

EndFunction

// У перечисления текст живёт в метаданных, а в базе лежит ссылка. Список значений
// известен офлайн, поэтому представление собирается точно - ВЫБОРом по ссылке.
Function EnumPresentation(Path, Target, Context, ThroughDot = False)

	Column = FieldReference(Path, Context);
	FullName = Target.FullName();

	Branches = New Array;
	For Each Value In Target.EnumValues Do
		Text = ?(IsBlankString(Value.Synonym), Value.Name, Value.Synonym);
		Branches.Add("WHEN " + Column + " = " + PredefinedValueLiteral(FullName + "." + Value.Name, Context)
			+ " THEN " + TextLiteral(Text, Context));
	EndDo;

	If Branches.Count() = 0 Then
		Return Column;
	EndIf;
	// Пустая ссылка перечисления - пустая строка, как у любой пустой ссылки известного типа
	// (УХ, АктВыполненныхРаботЛокализация и ОтчетКомитентуЛокализация: ПРЕДСТАВЛЕНИЕ(ФормаОплаты)
	// при реквизите 0x00… - у 1С "", без ветви - NULL). Через точку значения нет, там NULL.
	If Not ThroughDot Then
		Branches.Add("WHEN " + Column + " = " + EmptyPartLiteral("_RRRef", Context)
			+ " THEN " + TextLiteral("", Context));
	EndIf;
	Return "(CASE " + StrConcat(Branches, " ") + " END)";

EndFunction

// Представление документа платформа складывает после чтения, по измеренному шаблону:
// «<представление объекта, иначе синоним> <номер> <слово> <дата>». Дата стоит всегда -
// непериодическая нумерация её не убирает, это проверено на одноразовой базе. Формат
// даты, разделитель разрядов числового номера и само слово приходят из региональных
// установок базы, и обработка снимает их в своём сеансе.
//
// Чего здесь нет: переопределения представления в модуле менеджера. Такой код в SQL не
// повторяется, типов с ним на замере от десятой части до трети, и об этом говорится
// предупреждением, а не умолчанием.
Function DocumentPresentation(Path, Target, Context, ThroughDot = False)

	Formats = Context.SessionFormats;
	If IsBlankString(Formats.DatePattern) Or IsBlankString(Formats.DateWord) Then
		Raise StrTemplate(
			"PRESENTATION of %1 cannot be translated: the platform builds the text from the"
			+ " regional settings of this infobase, and they are not among the measured"
			+ " ones. This session renders a date as %2 and True as %3. Select the number"
			+ " and the date instead, or build the presentation on the receiving side.",
			Target.FullName(), Formats.DateRendered, Formats.BooleanRendered);
	EndIf;

	AddOnce(Context.Warnings, StrTemplate(
		"PRESENTATION of %1 reproduces the platform template <object presentation> <number>"
		+ " %2 <date>. A configuration can redefine the presentation in the manager module,"
		+ " and such a redefinition is not reproduced in SQL.",
		Target.FullName(), Formats.DateWord));

	Resolved = ResolveField(Path + ".Ref", Context);
	Shown = PresentationEmptyRule(Path, DocumentPresentationText(Resolved.Descriptor, Resolved.Alias, Target,
		Context), Context, ThroughDot);
	NotePresentationFacts(Context, Shown, Target.FullName(), ThroughDot, False);
	Return Shown;

EndFunction

// Текст шаблона представления документа по его таблице, уже присоединённой под Alias:
// одиночная ссылка (DocumentPresentation) и ветвь составной (CompositeNavigation).
Function DocumentPresentationText(Descriptor, Alias, Target, Context)

	Formats = Context.SessionFormats;
	Kind = "";
	Try
		Kind = Target.ObjectPresentation;
	Except
	EndTry;
	If IsBlankString(Kind) Then
		Kind = ?(IsBlankString(Target.Synonym), Target.Name, Target.Synonym);
	EndIf;

	Parts = New Array;
	Parts.Add(TextLiteral(Kind, Context));

	NumberColumn = Descriptor.Fields.Get("NUMBER");
	If NumberColumn = Undefined Then
		NumberColumn = Descriptor.Fields.Get(Upper("Номер"));
	EndIf;
	If NumberColumn <> Undefined Then
		Stored = Alias + "." + PhysicalName(NumberColumn, Context);
		// Номер и дата читаются мимо общего пути поля, и в группировку их записывает
		// этот вызов: представление сгруппированной ссылки СУБД иначе не принимает.
		RegisterStoredColumn(Context, Descriptor, Alias, Stored);
		Parts.Add(TextLiteral(" ", Context));
		// Номер фиксированной длины хранится дополненным пробелами, а в представлении
		// платформа их обрезает - замерено. У наименования не обрезает, поэтому обрезка
		// стоит только здесь.
		Parts.Add(?(IsNumericNumber(Target), GroupedNumberText(Stored, Context),
			"RTRIM(CAST(" + Stored + " AS " + TextTypeName("(50)", Context) + "))"));
	EndIf;

	DateColumn = Descriptor.Fields.Get("DATE");
	If DateColumn = Undefined Then
		DateColumn = Descriptor.Fields.Get(Upper("Дата"));
	EndIf;
	If DateColumn <> Undefined Then
		// Формат стандартного реквизита «Дата» решает, идёт ли время: пусто - полный
		// шаблон сеанса, DLF=D - только дата. Замерено на двух базах.
		DateFormat = StandardDateFormat(Target);
		Normalized = Upper(StrReplace(TrimAll(DateFormat), " ", ""));
		DateOnly = Normalized = "DLF=D" Or Normalized = Upper("ДЛФ=D");
		If Not IsBlankString(DateFormat) And Not DateOnly Then
			Raise StrTemplate(
				"PRESENTATION of %1 cannot be translated: the standard attribute Date carries"
				+ " the format %2, and only an empty format and DLF=D have been measured."
				+ " Select the number and the date instead, or build the presentation on the"
				+ " receiving side.", Target.FullName(), DateFormat);
		EndIf;
		Parts.Add(TextLiteral(" " + Formats.DateWord + " ", Context));
		RegisterStoredColumn(Context, Descriptor, Alias,
			Alias + "." + PhysicalName(DateColumn, Context));
		Parts.Add(SessionDateText(Alias + "." + PhysicalName(DateColumn, Context),
			Context, DateOnly));
	EndIf;

	Return StrConcat(Parts, " + ");

EndFunction

// Пустая ссылка и NULL - разные вещи, и платформа различает их замеренно: у пустой
// ссылки известного типа представление - пустая строка, а у NULL - NULL. Склейка с NULL
// даёт NULL целиком, поэтому пустую строку надо подставлять, но только там, где ссылка
// действительно есть.
//
// Поле Представление через точку - другое дело: это переход, и у пустой ссылки строки цели
// нет, значение NULL (УХ, ПроизводственнаяОперация2_2: Операция.ЕдиницаИзмерения.Представление
// при пустой единице - у 1С NULL, у COALESCE - "").
Function PresentationEmptyRule(Path, Expression, Context, ThroughDot = False)

	Reference = FieldReference(Path, Context);
	If ThroughDot Then
		Result = "(" + Expression + ")";
		Context.PresentationGrouping.Insert(Result, Reference);
		Return Result;
	EndIf;
	Result = "(CASE WHEN " + Reference + " IS NULL THEN NULL ELSE COALESCE("
		+ Expression + ", " + TextLiteral("", Context) + ") END)";
	Context.PresentationGrouping.Insert(Result, Reference);
	Return Result;

EndFunction

// Формат, заданный стандартному реквизиту «Дата». Пусто - формата нет.
Function StandardDateFormat(Target)

	Try
		For Each Attribute In Target.StandardAttributes Do
			If Attribute.Name = "Date" Or Attribute.Name = "Дата" Then
				Return TrimAll(Attribute.Format);
			EndIf;
		EndDo;
	Except
	EndTry;
	Return "";

EndFunction

// Числовой номер документа платформа показывает с разделителями разрядов.
Function IsNumericNumber(Target)

	Try
		Return Target.NumberType = Metadata.ObjectProperties.DocumentNumberType.Number;
	Except
	EndTry;
	Return False;

EndFunction

// Числовой код справочника - тоже с разделителями разрядов.
Function IsNumericCode(Target)

	Try
		Return Target.CodeType = Metadata.ObjectProperties.CatalogCodeType.Number;
	Except
	EndTry;
	Try
		Return Target.CodeType
			= Metadata.ObjectProperties.ChartOfCalculationTypesCodeType.Number;
	Except
	EndTry;
	Return False;

EndFunction

// Число с разделителями разрядов, как его показывает платформа. Разделитель снят в
// сеансе; когда он совпадает с тем, что даёт СУБД, замена не ставится.
Function GroupedNumberText(Expression, Context)

	Separator = Context.SessionFormats.GroupSeparator;
	// Не IsBlankString: русские установки разделяют разряды неразрывным пробелом, а его
	// IsBlankString считает пустотой - представление числового кода отвергалось ложно.
	If Separator = "" Then
		Raise StrTemplate(
			"A numeric code or number cannot be put into a presentation: the platform groups"
			+ " digits by the regional settings of this infobase, and this session renders"
			+ " 471481544 as %1, which is not among the measured ones.",
			Context.SessionFormats.NumberRendered);
	EndIf;

	If Context.Options.Dialect = "PostgreSQL" Then
		Grouped = "to_char(" + Expression + ", 'FM999,999,999,999,999')";
	Else
		Money = "CONVERT(" + TextTypeName("(40)", Context) + ", CAST(" + Expression
			+ " AS MONEY), 1)";
		Grouped = "LEFT(" + Money + ", LEN(" + Money + ") - 3)";
	EndIf;
	If Separator = "," Then
		Return Grouped;
	EndIf;
	Return "REPLACE(" + Grouped + ", " + TextLiteral(",", Context) + ", "
		+ SeparatorText(Separator, Context) + ")";

EndFunction

// Разделитель разрядов в тексте SQL. Неразрывный пробел литералом - невидимый байт в
// запросе, который потом правят руками; поэтому всё, что вне печатного ASCII, пишется
// кодом символа.
Function SeparatorText(Separator, Context)

	Code = CharCode(Separator);
	If Code >= 32 And Code <= 126 Then
		Return TextLiteral(Separator, Context);
	EndIf;
	If Context.Options.Dialect = "PostgreSQL" Then
		Return "CHR(" + Format(Code, "NG=") + ")";
	EndIf;
	Return "NCHAR(" + Format(Code, "NG=") + ")";

EndFunction

// Дата в том же виде, в каком её показывает платформа. Образец опознан калибровкой, здесь
// он только раскрывается в выражение диалекта.
Function SessionDateText(Column, Context, DateOnly = False)

	Shift = Format(Context.Options.DateOffset, "NG=0; NZ=0");
	Pattern = Context.SessionFormats.DatePattern;
	Postgres = Context.Options.Dialect = "PostgreSQL";
	If Postgres Then
		Moment = "(" + Column + " - INTERVAL '" + Shift + " years')";
	Else
		Moment = "DATEADD(YEAR, -" + Shift + ", " + Column + ")";
	EndIf;

	If Pattern = "dd/MM/yy HH:mm:ss" Then
		If Postgres Then
			Return "to_char(" + Moment + ?(DateOnly, ", 'DD/MM/YY')",
				", 'DD/MM/YY HH24:MI:SS')");
		EndIf;
		DatePart = "CONVERT(" + TextTypeName("(8)", Context) + ", " + Moment + ", 3)";
		If DateOnly Then
			Return DatePart;
		EndIf;
		Return "(" + DatePart + " + " + TextLiteral(" ", Context) + " + CONVERT("
			+ TextTypeName("(8)", Context) + ", " + Moment + ", 108))";
	EndIf;

	If Pattern = "dd.MM.yyyy HH:mm:ss" Then
		If Postgres Then
			Return "to_char(" + Moment + ?(DateOnly, ", 'DD.MM.YYYY')", ", 'DD.MM.YYYY HH24:MI:SS')");
		EndIf;
		DatePart = "CONVERT(" + TextTypeName("(10)", Context) + ", " + Moment + ", 104)";
		If DateOnly Then
			Return DatePart;
		EndIf;
		// Стиль 108 - hh:mi:ss с ведущим нулём у часа.
		Return "(" + DatePart + " + " + TextLiteral(" ", Context) + " + CONVERT("
			+ TextTypeName("(8)", Context) + ", " + Moment + ", 108))";
	EndIf;

	If Pattern = "dd.MM.yyyy H:mm:ss" Then
		If Postgres Then
			Return "to_char(" + Moment + ?(DateOnly, ", 'DD.MM.YYYY')",
				", 'DD.MM.YYYY FMHH24:MI:SS')");
		EndIf;
		// Стиль 104 даёт ровно dd.mm.yyyy. Час - без ведущего нуля: платформа пишет
		// `0:00:00` (замерено на представлениях документов), поэтому CONVERT(..., 108)
		// здесь не годится, он даёт `00:00:00`.
		DatePart = "CONVERT(" + TextTypeName("(10)", Context) + ", " + Moment + ", 104)";
		If DateOnly Then
			Return DatePart;
		EndIf;
		Pieces = New Array;
		Pieces.Add(DatePart);
		Pieces.Add(TextLiteral(" ", Context));
		Pieces.Add("CAST(DATEPART(HOUR, " + Moment + ") AS "
			+ TextTypeName("(2)", Context) + ")");
		Pieces.Add(TextLiteral(":", Context));
		Pieces.Add(TwoDigits("DATEPART(MINUTE, " + Moment + ")", Context));
		Pieces.Add(TextLiteral(":", Context));
		Pieces.Add(TwoDigits("DATEPART(SECOND, " + Moment + ")", Context));
		Return "(" + StrConcat(Pieces, " + ") + ")";
	EndIf;

	If Pattern = "M/d/yyyy h:mm:ss tt" Then
		If Postgres Then
			Return "to_char(" + Moment + ?(DateOnly, ", 'FMMM/FMDD/YYYY')",
				", 'FMMM/FMDD/YYYY FMHH12:MI:SS AM')");
		EndIf;
		Hour12 = "((DATEPART(HOUR, " + Moment + ") + 11) % 12 + 1)";
		Pieces = New Array;
		Pieces.Add("CAST(MONTH(" + Moment + ") AS " + TextTypeName("(2)", Context) + ")");
		Pieces.Add(TextLiteral("/", Context));
		Pieces.Add("CAST(DAY(" + Moment + ") AS " + TextTypeName("(2)", Context) + ")");
		Pieces.Add(TextLiteral("/", Context));
		Pieces.Add("CAST(YEAR(" + Moment + ") AS " + TextTypeName("(4)", Context) + ")");
		If DateOnly Then
			Return "(" + StrConcat(Pieces, " + ") + ")";
		EndIf;
		Pieces.Add(TextLiteral(" ", Context));
		Pieces.Add("CAST(" + Hour12 + " AS " + TextTypeName("(2)", Context) + ")");
		Pieces.Add(TextLiteral(":", Context));
		Pieces.Add(TwoDigits("DATEPART(MINUTE, " + Moment + ")", Context));
		Pieces.Add(TextLiteral(":", Context));
		Pieces.Add(TwoDigits("DATEPART(SECOND, " + Moment + ")", Context));
		Pieces.Add(TextLiteral(" ", Context));
		Pieces.Add("(CASE WHEN DATEPART(HOUR, " + Moment + ") < 12 THEN "
			+ TextLiteral("AM", Context) + " ELSE " + TextLiteral("PM", Context) + " END)");
		Return "(" + StrConcat(Pieces, " + ") + ")";
	EndIf;

	Raise StrTemplate("The date format %1 of this session has no expression yet.", Pattern);

EndFunction

// Две цифры с ведущим нулём.
Function TwoDigits(Expression, Context)

	Return "RIGHT(" + TextLiteral("0", Context) + " + CAST(" + Expression + " AS "
		+ TextTypeName("(2)", Context) + "), 2)";

EndFunction

// На какой объект метаданных смотрит поле. Undefined - поле не ссылочное.
Function ReferenceTargetOf(Resolved)

	If Resolved.Descriptor.IsDerived Then
		Origin = Undefined;
		If Resolved.Descriptor.Property("ColumnSources") And Resolved.Descriptor.ColumnSources <> Undefined Then
			Origin = Resolved.Descriptor.ColumnSources.Get(Upper(TrimAll(Resolved.FieldName)));
		EndIf;
		If Origin = Undefined Then
			Return Undefined;
		EndIf;
		If Origin.Property("Type") And Origin.Type <> Undefined Then
			Types = Origin.Type.Types();
			Return ?(Types.Count() = 1, Metadata.FindByType(Types[0]), Undefined);
		EndIf;
		Substitute = New Structure;
		Substitute.Insert("FieldName", Origin.FieldName);
		Try
			Substitute.Insert("Descriptor", TableDescriptor(Origin.LogicalName));
		Except
			// Происхождение указывает на виртуальную таблицу - метаданных за ней нет.
			Return Undefined;
		EndTry;
		Return ReferenceTargetOf(Substitute);
	EndIf;

	Owner = MetadataOf(Resolved.Descriptor.LogicalName);
	If Owner = Undefined Then
		Return Undefined;
	EndIf;

	Special = Undefined;
	Try
		Special = SpecialReferenceTarget(Owner, Resolved.FieldName, Resolved.Descriptor.LogicalName);
	Except
		Special = Undefined;
	EndTry;
	If Special <> Undefined Then
		Return Metadata.FindByFullName(Special);
	EndIf;

	FieldType = FieldTypeDescription(Owner, Resolved.FieldName);
	If FieldType = Undefined Then
		Return Undefined;
	EndIf;

	Types = FieldType.Types();
	If Types.Count() <> 1 Then
		Return Undefined;
	EndIf;
	Return Metadata.FindByType(Types[0]);

EndFunction

// В ИЕРАРХИИ. Платформа считает иерархию заранее: заводит временную таблицу, спускается
// по уровням отдельными операторами и подставляет в основной запрос готовый список ссылок
// литералами. Одним оператором это не повторить, но рекурсивный CTE даёт ровно тот же
// набор ссылок и есть в MS SQL с 2005 года. Затравка повторяет платформенную: сам узел
// плюс его непосредственные потомки - за счёт второй ветви пустая ссылка означает
// "весь верхний уровень и всё под ним", как и у платформы.
Function HierarchyCondition(LeftPath, Arguments, Context)

	If IsBlankString(LeftPath) Then
		Raise "IN HIERARCHY needs a field on the left.";
	EndIf;

	Resolved = ResolveField(LeftPath, Context);
	Target = Undefined;
	TailKinds = 0;
	If IsBlankString(Resolved.CompositeSegment) Then
		Target = ReferenceTargetOf(Resolved);
	Else
		// Поле за составной ссылкой (Т.Распоряжение.Склад): платформа читает его ВЫБОРом по видам
		// ссылки, и если у всех видов это ссылка одного типа, иерархия обычная (замер inh_we ih1,
		// ERP WE, 19.11.2026: CASE … THEN T2._Fld3327RRef … THEN T3._Fld9972RRef END IN (@P4, …)).
		Origin = CompositeTailOrigin(Resolved);
		If Origin <> Undefined Then
			TailKinds = Origin.Type.Types().Count();
			If TailKinds = 1 Then
				Target = Metadata.FindByType(Origin.Type.Types()[0]);
			EndIf;
		EndIf;
	EndIf;
	If Target = Undefined Then
		// Поле может быть и ссылочным - просто составного типа. Составное с байтом типа и
		// колонкой таблицы разбирает CompositeHierarchySql; сюда доходят формы без замера -
		// ссылка одного типа среди примитивов, регистратор, переход через составную ссылку к
		// полям разных типов. Сказать об этом надо точно: «не ссылка» - неверный диагноз.
		Kinds = TailKinds;
		If IsBlankString(Resolved.CompositeSegment) Then
			Try
				Kinds = FieldTypeDescription(MetadataOf(Resolved.Descriptor.LogicalName),
					Resolved.FieldName).Types().Count();
			Except
				Kinds = 0;
			EndTry;
		EndIf;
		If Kinds > 1 Then
			Raise StrTemplate(
				"IN HIERARCHY is applied to %1, a reference of a composite type (%2 types)."
				+ " Each type has its own hierarchy, so one recursive expression is not enough;"
				+ " this is not supported yet. Narrow the field to a single type in the query"
				+ " itself - for example select it into a temporary table with CAST - and"
				+ " apply IN HIERARCHY there.", LeftPath, Format(Kinds, "NG=0"));
		EndIf;
		Raise StrTemplate("IN HIERARCHY is applied to %1, which is not a reference.", LeftPath);
	EndIf;

	Return HierarchyOfTable(Target.FullName(), Arguments, Context);

EndFunction

// В ИЕРАРХИИ, слева от которого выражение: ВЫРАЗИТЬ к ссылочному типу, в том числе с полем после
// точки, ЕСТЬNULL, ВЫБОР. SQL операнда уже выдан общим разбором, иерархию задаёт таблица, которую
// даёт выражение. Замер hcp8 (УХ, 20.11.2026): ВЫРАЗИТЬ(составное КАК Справочник.Организации) -
// CASE ... THEN _RRRef END IN (список иерархии Организаций), ВЫРАЗИТЬ(...).ГоловнаяОрганизация -
// колонка соединённой таблицы IN (тот же список).
Function ExpressionHierarchyCondition(Tokens, LeftEnd, Arguments, Context)

	Start = -1;
	If LeftEnd > 0 Then
		Start = OperandStartBackward(Tokens, LeftEnd - 1);
	EndIf;
	If Start < 0 Then
		Raise "IN HIERARCHY needs a field or a reference expression on the left.";
	EndIf;
	Operand = TokensText(Tokens, Start, LeftEnd - 1);
	Target = ExpressionReferenceTarget(Operand, Context);
	If IsBlankString(Target) And Context.Options.Dialect <> "PostgreSQL"
		And Not IsNotKeywordToken(Tokens[LeftEnd]) And Not (Start > 0 And IsNotKeywordToken(Tokens[Start - 1])) Then
		Mixed = MixedHierarchyCondition(Operand, Arguments, Context);
		If Not IsBlankString(Mixed) Then
			Return Mixed;
		EndIf;
	EndIf;
	If IsBlankString(Target) Or Target = "*" Then
		Raise StrTemplate("IN HIERARCHY is applied to %1, an expression whose reference table is not"
			+ " known at translation, so the hierarchy to descend is not known either. Select the value"
			+ " into a temporary table with CAST to one reference type first, then apply IN HIERARCHY"
			+ " to its field.", Operand);
	EndIf;
	Return HierarchyOfTable(Target, Arguments, Context);

EndFunction

// В ИЕРАРХИИ над выражением со ссылками нескольких таблиц (замер ih01): иерархия - таблицы значения узла, и значение
// выражения обязано быть ссылкой этой таблицы. Пустая строка - узлы не дают одной таблицы или части выражения не
// разбираются (тогда прежний отказ); узел-параметр без значения - отказ «нет значения параметра».
Function MixedHierarchyCondition(Operand, Arguments, Context)

	Table = "";
	For Each Argument In Arguments Do
		Trimmed = TrimAll(Argument);
		If IsBlankString(Trimmed) Then
			Continue;
		EndIf;
		Own = "";
		If StrStartsWith(Trimmed, "&") Then
			Name = TrimAll(Mid(Trimmed, 2));
			Value = HierarchyParameterValue(Name, Context);
			If Value = Undefined Then
				Raise StrTemplate("IN HIERARCHY is applied to %1, an expression with references of several tables: the"
					+ " platform descends the hierarchy of the table of the value of &%2, and no value is supplied."
					+ " Supply the value of &%2.", Operand, Name);
			EndIf;
			Items = ParameterListItems(Value);
			If Items = Undefined Then
				Items = New Array;
				Items.Add(Value);
			EndIf;
			For Each Item In Items Do
				Found = Undefined;
				Try
					Found = Metadata.FindByType(TypeOf(Item));
				Except
					Found = Undefined;
				EndTry;
				If Found = Undefined Then
					Return "";
				EndIf;
				If Not IsBlankString(Own) And Upper(Own) <> Upper(Found.FullName()) Then
					Return "";
				EndIf;
				Own = Found.FullName();
			EndDo;
		Else
			Inside = PredefinedValueArgument(Trimmed);
			Origin = ?(IsBlankString(Inside), Undefined, TypeOrigin(Inside, True));
			If Origin = Undefined Then
				Return "";
			EndIf;
			Own = Origin.LogicalName;
		EndIf;
		If IsBlankString(Own) Or (Not IsBlankString(Table) And Upper(Table) <> Upper(Own)) Then
			Return "";
		EndIf;
		Table = Own;
	EndDo;
	If IsBlankString(Table) Then
		Return "";
	EndIf;
	Parts = Undefined;
	Try
		Parts = BranchedCompositeParts(Operand, Context);
	Except
		Parts = Undefined;
	EndTry;
	If Parts = Undefined Or Parts.Get("_TYPE") = Undefined Or Parts.Get("_RTRef") = Undefined Then
		Return "";
	EndIf;
	Return HierarchyOfTable(Table, Arguments, Context) + " AND (" + Parts.Get("_TYPE") + " = "
		+ BinaryLiteral("08", Context) + " AND " + Parts.Get("_RTRef") + " = " + ReferenceTypeIdLiteral(Table, Context) + ")";

EndFunction

// Иерархия одной таблицы. Узлы - значения; параметр-список даёт по литералу на элемент.
Function HierarchyOfTable(TableName, Arguments, Context)

	Descriptor = TableDescriptor(TableName);

	Nodes = New Array;
	Listed = False;
	For Index = 0 To Arguments.Count() - 1 Do
		If IsBlankString(Arguments[Index]) Then
			Continue;
		EndIf;
		Items = HierarchyParameterItems(Arguments[Index], Context);
		If Items = Undefined Then
			Nodes.Add(TranslateValue(Arguments[Index], Context));
			Continue;
		EndIf;
		For Each Item In Items Do
			Nodes.Add(ValueLiteral(Item, Context));
		EndDo;
		Listed = True;
	EndDo;
	If Nodes.Count() = 0 And Listed Then
		// Узлы - пустые списки: у платформы (0x00) = 0x01, у отрицания условия нет вовсе (h1, h2).
		Return "IN (" + EmptyListSql(Context) + ")";
	ElsIf Nodes.Count() = 0 Then
		Raise "IN HIERARCHY needs at least one node.";
	EndIf;
	Return HierarchyMembership(Descriptor, Nodes, Context);

EndFunction

// Значение параметра в узлах В ИЕРАРХИИ, если это список: элементы массива или списка значений.
// Целый список одним литералом не выражается, поэтому каждый элемент - свой узел; пустой список
// узлов не даёт, и условие ложно (замер h1-h4). Undefined - аргумент не параметр, значения нет
// или это не список.
Function HierarchyParameterItems(Argument, Context)

	Trimmed = TrimAll(Argument);
	If Not StrStartsWith(Trimmed, "&") Then
		Return Undefined;
	EndIf;
	Name = TrimAll(Mid(Trimmed, 2));
	Value = HierarchyParameterValue(Name, Context);
	Items = ParameterListItems(Value);
	Return Items;

EndFunction

Function HierarchyParameterValue(Name, Context)

	If Not Context.Options.Property("ParameterValues")
		Or TypeOf(Context.Options.ParameterValues) <> Type("Map") Then
		Return Undefined;
	EndIf;
	Return Context.Options.ParameterValues.Get(TrimAll(Name));

EndFunction

Function IsNotKeywordToken(Token)
	Return Token.Kind = "Name" And (Upper(Token.Value) = "NOT" Or Upper(Token.Value) = Upper("Не"));
EndFunction

// Составное поле [НЕ] В ИЕРАРХИИ (узлы). Иерархию платформа строит до запроса и отбирает поле по
// типу: (_TYPE = 0x08 AND _RTRef = <таблица> AND _RRRef IN (список)) - ветвь на каждую таблицу, у
// отрицания NOT от всего (замеры hcp1-hcp7, УХ, 20.11.2026, condplan\probes_hier.json, поле
// Справочник.КлючиАналитикиУчетаПоПартнерам.Контрагент). Список - объединение по узлам таблиц из
// состава поля: у иерархической таблицы - узел, если он есть в таблице, и все потомки (у пустой
// ссылки - вся таблица); у прочей - узел, если он есть в таблице, поэтому пустая ссылка выпадает.
// Узел таблицы вне состава в список не входит. Пустой список - отбор по самим узлам, как они
// заданы, и вне состава тоже (замеры hier\probes_nh, probes_mix, probes_dang, 21.11.2026: пустой
// Контрагент один - 24 строки, вместе с пустой Организацией - 16, рядом с Контрагентом X - только
// X; несуществующая Организация - IN (@P); пустой Контрагент рядом с пустым Складом - 24). Список
// иерархической таблицы даёт то же рекурсивное выражение, что у ссылки одного типа. Поле без
// колонки таблицы или без байта типа (ссылка одного типа среди примитивов, регистратор) не
// замерено и остаётся прежнему разбору. Undefined - образец не этот.
Function CompositeHierarchySql(Tokens, Index, Context, Consumed)

	Count = Tokens.Count();
	If Index + 3 > Count - 1 Or Tokens[Index].Kind <> "Name" Then
		Return Undefined;
	EndIf;
	Position = Index + 1;
	Negated = IsNotKeywordToken(Tokens[Position]);
	If Negated Then
		Position = Position + 1;
	EndIf;
	If Position + 2 > Count - 1 Or Tokens[Position].Kind <> "Name"
		Or (Upper(Tokens[Position].Value) <> "IN" And Upper(Tokens[Position].Value) <> Upper("В"))
		Or Tokens[Position + 1].Kind <> "Name"
		Or (Upper(Tokens[Position + 1].Value) <> "HIERARCHY"
			And Upper(Tokens[Position + 1].Value) <> Upper("Иерархии"))
		Or Tokens[Position + 2].Value <> "(" Then
		Return Undefined;
	EndIf;
	If Not LeftIsBoundary(Tokens, Index) Then
		Return Undefined;
	EndIf;
	Operand = CompositeComparisonOperand(Tokens[Index], Context);
	If Operand = Undefined Or IsBlankString(Operand.Info.TypeColumn)
		Or IsBlankString(Operand.Info.RefTypeColumn) Or IsBlankString(Operand.Info.RefColumn) Then
		Return Undefined;
	EndIf;

	Taken = 0;
	Arguments = CollectArguments(Tokens, Position + 1, Taken);
	Closing = Position + 1 + Taken;
	If Not RightIsBoundary(Tokens, Closing) Then
		Return Undefined;
	EndIf;
	Composition = CompositeHierarchyComposition(Operand.Path, Context);
	Groups = CompositeHierarchyNodes(Operand.Path, Arguments, Context);

	Resolved = Operand.Resolved;
	Info = Operand.Info;
	RefColumn = FieldColumn(Resolved.Descriptor, Resolved.Alias, Info.RefColumn, Context);
	RegisterDeterminedColumns(Context, RefColumn,
		CompositeDeterminants(Resolved.Descriptor, Resolved.Alias, Info, Context));
	Listed = New Array;
	Empty = New Array;
	Literal = New Array;
	Column = QuoteIdentifier("Ref", Context);
	For Each Group In Groups Do
		TypeTest = CompositeTypeTest(Resolved.Descriptor, Resolved.Alias, Info,
			ReferenceTypeIdLiteral(Group.Table, Context), Context);
		Literal.Add("(" + TypeTest + " AND " + RefColumn + " IN (" + StrConcat(Group.Nodes, ", ") + "))");
		If Composition.Get(Upper(Group.Table)) = Undefined Then
			Continue;
		EndIf;
		Name = HierarchyList(TableDescriptor(Group.Table), Group.Nodes, Context);
		Listed.Add("(" + TypeTest + " AND " + RefColumn + " IN (SELECT " + Column + " FROM " + Name + "))");
		Empty.Add("NOT EXISTS (SELECT 1 FROM " + Name + ")");
	EndDo;
	If Groups.Count() = 0 Then
		// Узлы - пустые списки (замер h3, h4).
		Sql = "(1 = 0)";
	ElsIf Listed.Count() = 0 Then
		Sql = "(" + StrConcat(Literal, " OR ") + ")";
	Else
		Sql = "(" + StrConcat(Listed, " OR ") + " OR (" + StrConcat(Empty, " AND ") + " AND ("
			+ StrConcat(Literal, " OR ") + ")))";
	EndIf;
	Consumed = Closing + 1 - Index;
	Return ?(Negated, "(NOT " + Sql + ")", Sql);

EndFunction

// Узлы В ИЕРАРХИИ над составным полем по таблицам: массив структур TableKey, Table (полное имя),
// Nodes (тексты SQL). Таблицу даёт сам узел: ЗНАЧЕНИЕ(...) - путь, параметр - тип значения,
// вложенный запрос - тип его колонки. Узел, таблица которого из текста не выводится, - отказ.
Function CompositeHierarchyNodes(Path, Arguments, Context)

	Meaningful = New Array;
	For Each Argument In Arguments Do
		If Not IsBlankString(Argument) Then
			Meaningful.Add(Argument);
		EndIf;
	EndDo;
	If Meaningful.Count() = 0 Then
		Raise "IN HIERARCHY needs at least one node.";
	EndIf;

	Groups = New Array;
	For Each Argument In Meaningful Do
		ArgumentTokens = Tokenize(Argument);
		Word = Upper(ArgumentTokens[0].Value);
		If ArgumentTokens[0].Kind = "Name" And (Word = "SELECT" Or Word = Upper("Выбрать")) Then
			If Meaningful.Count() > 1 Then
				Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: a subquery stands"
					+ " among other nodes, and that form has not been measured. Put all the nodes into"
					+ " the subquery.", Path);
			EndIf;
			AddSubqueryHierarchyNodes(Groups, Path, Argument, Context);
			Continue;
		EndIf;
		Taken = ValueCallPath(ArgumentTokens, 0);
		If Taken <> Undefined And Taken.Next = ArgumentTokens.Count() Then
			AddHierarchyNode(Groups, ValuePathTable(Path, Taken.Path), TranslateValue(Argument, Context));
			Continue;
		EndIf;
		If ArgumentTokens.Count() = 1 And ArgumentTokens[0].Kind = "Parameter"
			And Not IsOuterColumnStub(ArgumentTokens[0].Value, Context) Then
			AddParameterHierarchyNodes(Groups, Path, ArgumentTokens[0].Value, Argument, Context);
			Continue;
		EndIf;
		Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: node %2 is not VALUE(...),"
			+ " a parameter or a subquery, so its table - and the hierarchy to descend - is not known at"
			+ " translation. Select the field into a temporary table with CAST to one reference type"
			+ " first, then apply IN HIERARCHY there.", Path, Argument);
	EndDo;
	Return Groups;

EndFunction

Procedure AddHierarchyNode(Groups, Table, NodeSql)

	TableKey = Upper(TableDescriptor(Table).PhysicalName);
	For Each Group In Groups Do
		If Group.TableKey = TableKey Then
			Group.Nodes.Add(NodeSql);
			Return;
		EndIf;
	EndDo;
	Group = New Structure("TableKey, Table, Nodes", TableKey, Table, New Array);
	Group.Nodes.Add(NodeSql);
	Groups.Add(Group);

EndProcedure

Function ValuePathTable(Path, ValuePath)

	Parts = StrSplit(TrimAll(ValuePath), ".", False);
	Found = Undefined;
	If Parts.Count() > 2 Then
		Found = Metadata.FindByFullName(Parts[0] + "." + Parts[1]);
	EndIf;
	If Found = Undefined Then
		Raise StrTemplate("IN HIERARCHY over %1: the table of node VALUE(%2) is not found in the"
			+ " configuration.", Path, ValuePath);
	EndIf;
	Return Found.FullName();

EndFunction

// Узел - параметр. Без значения таблица неизвестна: в составном поле лежат ссылки разных таблиц,
// у каждой своя иерархия, а у пустой ссылки иерархия - вся таблица её типа.
Procedure AddParameterHierarchyNodes(Groups, Path, Name, Argument, Context)

	Value = HierarchyParameterValue(Name, Context);
	If Value = Undefined Then
		Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: parameter &%2 has no value."
			+ " The platform descends the hierarchy of the table the value belongs to and keeps only the"
			+ " field's values of that table, so without the value neither the hierarchy nor the type"
			+ " test is known. Supply the value of &%2, or narrow the field to one reference type with"
			+ " CAST in a temporary table.", Path, Name);
	EndIf;
	Items = HierarchyParameterItems(Argument, Context);
	If Items = Undefined Then
		AddHierarchyNode(Groups, ParameterValueTable(Path, Name, Value), TranslateValue(Argument, Context));
		Return;
	EndIf;
	For Each Item In Items Do
		AddHierarchyNode(Groups, ParameterValueTable(Path, Name, Item), ValueLiteral(Item, Context));
	EndDo;

EndProcedure

Function ParameterValueTable(Path, Name, Value)

	Found = Undefined;
	Try
		Found = Metadata.FindByType(TypeOf(Value));
	Except
		Found = Undefined;
	EndTry;
	If Found = Undefined Then
		Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: parameter &%2 holds a value"
			+ " of type %3, not a reference of a known table, so the hierarchy to descend is not known.",
			Path, Name, String(TypeOf(Value)));
	EndIf;
	Return Found.FullName();

EndFunction

// Узел - вложенный запрос: таблица узлов - тип его колонки. У объединения ветвей разных таблиц
// узлы каждой таблицы - свой запрос из её ветвей: платформа делит готовый список по типу значения
// (замер hcp3 - по ветви на таблицу).
Procedure AddSubqueryHierarchyNodes(Groups, Path, Argument, Context)

	Text = WithoutOuterReferences(Argument, Context);
	Schema = New QuerySchema;
	Try
		Schema.SetQueryText(Text);
	Except
		Raise StrTemplate("The platform could not parse the subquery: %1", ErrorDescription());
	EndTry;
	If Schema.QueryBatch.Count() <> 1 Then
		Raise "A subquery inside an expression cannot be a batch.";
	EndIf;
	Query = Schema.QueryBatch[0];
	Tables = SubqueryReferenceTables(Query, Path);
	If Tables.Count() = 1 Then
		AddHierarchyNode(Groups, Tables[0], TranslateValue(Argument, Context));
		Return;
	EndIf;
	If Text <> Argument Or Query.Order.Count() > 0 Or Query.Operators.Count() < 2 Then
		Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: the node subquery returns"
			+ " references of several tables (%2), and only a union whose every branch returns one table,"
			+ " without ORDER BY and without references to the outer query, is split by table. Select the"
			+ " nodes into a temporary table first.", Path, StrConcat(Tables, ", "));
	EndIf;

	Branches = New Map;
	Order = New Array;
	For Position = 0 To Query.Operators.Count() - 1 Do
		Branch = New QuerySchema;
		Branch.SetQueryText(Argument);
		Kept = New Array;
		Kept.Add(Position);
		KeepOnlyOperators(Branch.QueryBatch[0], Kept);
		BranchTables = SubqueryReferenceTables(Branch.QueryBatch[0], Path);
		If BranchTables.Count() <> 1 Then
			Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: a branch of the node"
				+ " subquery returns references of several tables (%2), so its nodes are not split by"
				+ " table. Select the nodes into a temporary table first.", Path,
				StrConcat(BranchTables, ", "));
		EndIf;
		TableKey = Upper(BranchTables[0]);
		If Branches.Get(TableKey) = Undefined Then
			Branches.Insert(TableKey, New Array);
			Order.Add(BranchTables[0]);
		EndIf;
		Branches.Get(TableKey).Add(Position);
	EndDo;
	For Each Table In Order Do
		Part = New QuerySchema;
		Part.SetQueryText(Argument);
		KeepOnlyOperators(Part.QueryBatch[0], Branches.Get(Upper(Table)));
		AddHierarchyNode(Groups, Table, TranslateValue(Part.GetQueryText(), Context));
	EndDo;

EndProcedure

Procedure KeepOnlyOperators(Query, Kept)

	Position = Query.Operators.Count() - 1;
	While Position >= 0 Do
		If Kept.Find(Position) = Undefined Then
			Query.Operators.Delete(Position);
		EndIf;
		Position = Position - 1;
	EndDo;

EndProcedure

// Таблицы ссылок в колонке вложенного запроса-узла. Не ссылка или тип неизвестен - отказ.
Function SubqueryReferenceTables(Query, Path)

	If Query.Columns.Count() <> 1 Then
		Raise StrTemplate("IN HIERARCHY over %1: the node subquery must select exactly one column.", Path);
	EndIf;
	Description = Undefined;
	Try
		Description = Query.Columns[0].ValueType;
	Except
		Description = Undefined;
	EndTry;
	Tables = New Array;
	If Description <> Undefined Then
		For Each Item In Description.Types() Do
			If Item = Type("Null") Then
				Continue;
			EndIf;
			Found = Metadata.FindByType(Item);
			If Found = Undefined Then
				Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: the node subquery"
					+ " returns values of type %2, not references, so the hierarchy to descend is not"
					+ " known.", Path, String(Item));
			EndIf;
			Tables.Add(Found.FullName());
		EndDo;
	EndIf;
	If Tables.Count() = 0 Then
		Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: the type of the node"
			+ " subquery's column is not known, so the hierarchy to descend is not known.", Path);
	EndIf;
	Return Tables;

EndFunction

// Вхождение в иерархию таблицы: "IN (SELECT Ref FROM Hn)" над рекурсивным выражением с узлами
// Nodes (тексты SQL), у таблицы без родителя - простое вхождение в список узлов.
// Список платформы у ссылки одного типа - как у составной (CompositeHierarchySql): узлы, которые
// есть в таблице, у иерархической таблицы ещё и все их потомки; пустой список - сами узлы, как
// заданы, кроме NULL (замеры hier\probes_step2, probes_step3, УХ, 21.11.2026: неиерархическая
// таблица, [X, пустая ссылка] - только X, 1С 19 против 43 у простого вхождения; одна пустая или
// несуществующая ссылка - IN (узел); иерархическая, несуществующий узел - IN (@P), пустая ссылка -
// вся таблица без самой пустой ссылки; NULL - (1=0)). Узлы - одни пустые ссылки неиерархической
// таблицы: список заведомо пуст, и вхождение - простое.
Function HierarchyMembership(Descriptor, Nodes, Context)

	If HierarchyParentField(Descriptor) = Undefined And AllEmptyReferenceLiterals(Nodes, Context) Then
		Return "IN (" + StrConcat(Nodes, ", ") + ")";
	EndIf;
	Name = HierarchyList(Descriptor, Nodes, Context);
	Return "IN (SELECT " + QuoteIdentifier("Ref", Context) + " FROM " + Name
		+ HierarchyFallbackRows(Nodes, Name, Context) + ")";

EndFunction

Function AllEmptyReferenceLiterals(Nodes, Context)

	EmptyReference = BinaryLiteral("00000000000000000000000000000000", Context);
	For Each Node In Nodes Do
		If TrimAll(Node) <> EmptyReference Then
			Return False;
		EndIf;
	EndDo;
	Return True;

EndFunction

// Узлы списком на случай пустого Hn: " UNION ALL SELECT ... WHERE NOT EXISTS (SELECT 1 FROM Hn)".
// Подзапрос - своей ветвью, литералы и параметры - строками VALUES; NULL узлом не становится.
Function HierarchyFallbackRows(Nodes, Name, Context)

	Column = QuoteIdentifier("Ref", Context);
	Guard = "NOT EXISTS (SELECT 1 FROM " + Name + ")";
	Rows = New Array;
	Subqueries = "";
	For Each Node In Nodes Do
		Trimmed = TrimAll(Node);
		If StrStartsWith(Upper(Trimmed), "SELECT") Then
			Subqueries = Subqueries + " UNION ALL SELECT HS." + Column + " FROM (" + Node + ") AS HS("
				+ Column + ") WHERE HS." + Column + " IS NOT NULL AND " + Guard;
		ElsIf Upper(Trimmed) <> "NULL" Then
			Rows.Add("(" + Trimmed + ")");
		EndIf;
	EndDo;
	If Rows.Count() = 0 Then
		Return Subqueries;
	EndIf;
	Return " UNION ALL SELECT HV." + Column + " FROM (VALUES " + StrConcat(Rows, ", ") + ") AS HV("
		+ Column + ") WHERE " + Guard + Subqueries;

EndFunction

Function HierarchyParentField(Descriptor)

	ParentField = Descriptor.Fields.Get("PARENT");
	If ParentField = Undefined Then
		ParentField = Descriptor.Fields.Get(Upper("Родитель"));
	EndIf;
	Return ParentField;

EndFunction

// Список иерархии таблицы - общее табличное выражение Hn с колонкой Ref; результат - его имя. В
// списке узлы, которые есть в таблице, а у иерархической таблицы ещё и все их потомки.
Function HierarchyList(Descriptor, Nodes, Context)

	KeyColumn = PhysicalName(PrimaryKeyColumn(Descriptor), Context);
	NodeList = "(" + StrConcat(Nodes, ", ") + ")";
	ParentField = HierarchyParentField(Descriptor);

	Registry = HierarchyRegistry(Context);
	Name = "H" + Format(Registry.Count() + 1, "NG=0; NZ=0");
	Table = QualifiedTableName(Descriptor.PhysicalName, Context);
	Column = QuoteIdentifier("Ref", Context);

	Lines = New Array;
	Lines.Add("  SELECT HA." + KeyColumn + " AS " + Column + " FROM " + Table + " AS HA");
	Lines.Add("    WHERE HA." + KeyColumn + " IN " + NodeList);
	If ParentField <> Undefined Then
		ParentColumn = PhysicalName(ParentField, Context);
		Lines.Add("  UNION ALL");
		Lines.Add("  SELECT HB." + KeyColumn + " FROM " + Table + " AS HB");
		Lines.Add("    WHERE HB." + ParentColumn + " IN " + NodeList);
		Lines.Add("  UNION ALL");
		Lines.Add("  SELECT HC." + KeyColumn + " FROM " + Table + " AS HC");
		Lines.Add("    INNER JOIN " + Name + " AS HP ON HC." + ParentColumn + " = HP." + Column);
	EndIf;

	Definition = New Structure;
	Definition.Insert("Name", Name);
	Definition.Insert("Body", StrConcat(Lines, Chars.LF));
	Definition.Insert("Recursive", ParentField <> Undefined);
	Registry.Add(Definition);

	Return Name;

EndFunction

// Таблицы ссылок из состава составного поля: соответствие полное имя (в верхнем регистре) -> Истина.
// Иерархию платформа строит только по узлам этих таблиц, поэтому без состава перевода нет.
Function CompositeHierarchyComposition(Path, Context)

	Exact = True;
	Description = NumericFieldType(Path, Context, Exact);
	If Description = Undefined Then
		Raise StrTemplate("IN HIERARCHY over %1, a field of a composite type: the types the field can"
			+ " hold are not known here, and the platform builds the hierarchy only from nodes of those"
			+ " types. Select the field into a temporary table with CAST to one reference type first.",
			Path);
	EndIf;
	Tables = New Map;
	For Each Item In Description.Types() Do
		Found = Metadata.FindByType(Item);
		If Found <> Undefined Then
			Tables.Insert(Upper(Found.FullName()), True);
		EndIf;
	EndDo;
	Return Tables;

EndFunction

// Общее табличное выражение пакета. Питающий запрос виртуальной таблицы нужен
// несколько раз, и повторять его текстом - значит заставить СУБД читать регистр заново.
Function RegisterCommonTable(Body, Context, Prefix = "VT", Recursive = False)

	Registry = HierarchyRegistry(Context);
	Name = Prefix + Format(Registry.Count() + 1, "NG=0; NZ=0");

	Definition = New Structure;
	Definition.Insert("Name", Name);
	Definition.Insert("Body", Body);
	Definition.Insert("Recursive", Recursive);
	Registry.Add(Definition);

	Return Name;

EndFunction

// Общий список рекурсивных выражений пакета. Он живёт рядом с временными таблицами,
// потому что эта карта - единственное, что разделяют все контексты пакета.
Function HierarchyRegistry(Context)

	Registry = Context.TempTables.Get(HierarchyRegistryKey());
	If Registry = Undefined Then
		Registry = New Array;
		Context.TempTables.Insert(HierarchyRegistryKey(), Registry);
	EndIf;
	Return Registry;

EndFunction

// Решётка недопустима в имени таблицы 1С, поэтому ключ не столкнётся с временной таблицей.
Function HierarchyRegistryKey()
	Return "#HIERARCHY";
EndFunction

#EndRegion

#Region Lexer

Function Tokenize(Text)

	Tokens = New Array;
	Position = 1;
	Length = StrLen(Text);

	While Position <= Length Do
		Char = Mid(Text, Position, 1);

		If Char = " " Or Char = Chars.Tab Or Char = Chars.LF Or Char = Chars.CR Then
			Position = Position + 1;
			Continue;
		EndIf;

		If Char = """" Then
			Start = Position;
			Position = Position + 1;
			While Position <= Length Do
				If Mid(Text, Position, 1) = """" Then
					If Mid(Text, Position + 1, 1) = """" Then
						Position = Position + 2;
						Continue;
					EndIf;
					Position = Position + 1;
					Break;
				EndIf;
				Position = Position + 1;
			EndDo;
			Tokens.Add(NewToken("String", Mid(Text, Start, Position - Start)));
			Continue;
		EndIf;

		If Char = "&" Then
			Start = Position + 1;
			Position = Position + 1;
			While Position <= Length
				And (IsNameChar(Mid(Text, Position, 1)) Or IsDigit(Mid(Text, Position, 1))) Do
				Position = Position + 1;
			EndDo;
			Tokens.Add(NewToken("Parameter", Mid(Text, Start, Position - Start)));
			Continue;
		EndIf;

		If IsDigit(Char) Then
			Start = Position;
			While Position <= Length And (IsDigit(Mid(Text, Position, 1)) Or Mid(Text, Position, 1) = ".") Do
				Position = Position + 1;
			EndDo;
			Tokens.Add(NewToken("Number", Mid(Text, Start, Position - Start)));
			Continue;
		EndIf;

		If IsNameChar(Char) Then
			Start = Position;
			While Position <= Length Do
				NextChar = Mid(Text, Position, 1);
				If IsNameChar(NextChar) Or IsDigit(NextChar) Or NextChar = "." Then
					Position = Position + 1;
				Else
					Break;
				EndIf;
			EndDo;
			Tokens.Add(NewToken("Name", Mid(Text, Start, Position - Start)));
			Continue;
		EndIf;

		Pair = Mid(Text, Position, 2);
		If Pair = "<=" Or Pair = ">=" Or Pair = "<>" Then
			Tokens.Add(NewToken("Symbol", Pair));
			Position = Position + 2;
			Continue;
		EndIf;

		Tokens.Add(NewToken("Symbol", Char));
		Position = Position + 1;
	EndDo;

	Return Tokens;

EndFunction

Function NewToken(Kind, Value)
	Token = New Structure;
	Token.Insert("Kind", Kind);
	Token.Insert("Value", Value);
	Return Token;
EndFunction

Function IsDigit(Char)
	Code = CharCode(Char);
	Return Code >= 48 And Code <= 57;
EndFunction

Function IsNameChar(Char)
	Code = CharCode(Char);
	Return (Code >= 65 And Code <= 90)
		Or (Code >= 97 And Code <= 122)
		Or (Code >= 1040 And Code <= 1103)
		Or Code = 1025 Or Code = 1105
		Or Char = "_";
EndFunction

#EndRegion

#Region Identifiers

Function QualifiedTableName(PhysicalName, Context)

	If Context.Options.Dialect = "PostgreSQL" Then
		Return Lower(PhysicalName);
	EndIf;
	Prefix = TrimAll(Context.Options.SchemaName);
	Return ?(IsBlankString(Prefix), PhysicalName, Prefix + "." + PhysicalName);

EndFunction

Function PhysicalName(Name, Context)
	Return ?(Context.Options.Dialect = "PostgreSQL", Lower(Name), Name);
EndFunction

Function QuoteIdentifier(Name, Context)

	Clean = StrReplace(TrimAll(Name), """", "");
	If Context.Options.Dialect = "PostgreSQL" Then
		Return """" + Clean + """";
	EndIf;
	Return "[" + Clean + "]";

EndFunction

Function TransliterateName(Name)

	Source = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	Target = New Array;
	Target.Add("a");  Target.Add("b");  Target.Add("v");  Target.Add("g");  Target.Add("d");
	Target.Add("e");  Target.Add("e");  Target.Add("zh"); Target.Add("z");  Target.Add("i");
	Target.Add("y");  Target.Add("k");  Target.Add("l");  Target.Add("m");  Target.Add("n");
	Target.Add("o");  Target.Add("p");  Target.Add("r");  Target.Add("s");  Target.Add("t");
	Target.Add("u");  Target.Add("f");  Target.Add("h");  Target.Add("c");  Target.Add("ch");
	Target.Add("sh"); Target.Add("sch");Target.Add("");   Target.Add("y");  Target.Add("");
	Target.Add("e");  Target.Add("yu"); Target.Add("ya");

	Result = New Array;
	For Index = 1 To StrLen(Name) Do
		Char = Mid(Name, Index, 1);
		Position = StrFind(Source, Lower(Char));
		If Position = 0 Then
			Result.Add(Char);
			Continue;
		EndIf;
		Replacement = Target[Position - 1];
		Result.Add(?(Char = Lower(Char), Replacement, Title(Replacement)));
	EndDo;

	Return StrConcat(Result, "");

EndFunction

